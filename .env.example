PORT=3000
NODE_ENV=production
SESSION_SECRET=replace_with_a_long_random_string

# Profils personnels (multi-profil). Le site n'a plus de mot de passe
# unique : le wiki (texte) est public, tout le reste (galerie, BD, quizz,
# images) demande d'etre connecte a l'un de ces profils via l'icone cle.
# Sans mot de passe renseigne ici, le profil correspondant n'est pas cree
# au demarrage (voir avertissement dans les logs).
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=replace_with_the_admin_password
MANON_USERNAME=manon
MANON_DISPLAY_NAME=Manon
MANON_PASSWORD=replace_with_manons_password

# Mettre à 1 si l'app est derrière un reverse proxy (Nginx Proxy Manager,
# nginx, Caddy...) qui gère le TLS et transmet X-Forwarded-Proto.
# Permet au cookie de session d'être "secure" même si Node reçoit du HTTP.
# Laisser vide ou 0 si l'app est exposée directement sans proxy.
TRUST_PROXY=1

# Optionnel : active le HTTPS directement dans Node (sans proxy).
# Inutile si TRUST_PROXY=1 et qu'un reverse proxy gère le TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
