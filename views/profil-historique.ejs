<%- include('partials/head', { title: 'Profil : Historique' }) %>
<main class="container wide profil-page gallery-has-sidebar">
  <%- include('partials/top-nav', { config: config }) %>

  <%- include('partials/profil-nav', { roleHue: roleHue }) %>

  <div class="profil-subpage">

    <% if (feed.length) { %>
      <div class="profil-history-grid">
        <% feed.forEach(function (f) { %>
          <% var href = f.type === 'wiki' ? '/wiki/' + f.id : f.type === 'bd' ? '/bd/' + f.id : '/galerie'; %>
          <a href="<%= href %>" class="profil-history-card profil-history-card--<%= f.type %>">
            <% if (f.type === 'wiki') { %>
              <% var cat = categories.find(function (c) { return c.key === f.category; }); %>
              <div class="profil-history-cover" style="--ch-hue: <%= cat ? cat.hue : 220 %>">
                <svg class="profil-history-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9a2 2 0 0 1 2 2v16l-6.5-4.2L4 21V5a2 2 0 0 1 2-2Z"/></svg>
              </div>
              <div class="profil-history-caption">
                <span class="profil-history-badge">Codex</span>
                <span class="profil-history-title"><%= f.title %></span>
              </div>
            <% } else { %>
              <div class="profil-history-cover">
                <% if (f.coverImg) { %>
                  <img src="<%= thumbUrl(f.coverImg) %>" alt="" class="profil-history-img" loading="lazy" />
                <% } else { %>
                  <span class="profil-history-placeholder"><%- f.type === 'bd' ? '&#128214;' : '&#128247;' %></span>
                <% } %>
              </div>
              <div class="profil-history-caption">
                <span class="profil-history-badge"><%= f.type === 'bd' ? 'BD' : 'Images' %></span>
                <span class="profil-history-title"><%= f.title %></span>
              </div>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="profil-empty">
        <div class="profil-empty-icon">&#10024;</div>
        <p>Vous retrouverez ici les pages, images et BD que vous avez consult&eacute;es r&eacute;cemment.</p>
      </div>
    <% } %>

  </div>

</main>
<%- include('partials/foot') %>
