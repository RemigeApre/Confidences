<%- include('partials/head', { title: 'Mon profil — ' + config.title }) %>
<main class="container wide">
  <%- include('partials/top-nav', { config: config }) %>

  <!-- Volet droit fixe -->
  <aside class="profil-right">
    <div class="profil-right-name"><%= currentUser.displayName %></div>

    <div class="profil-right-settings">
      <div class="profil-right-settings-title">Go&ucirc;ts</div>
      <label class="profil-setting-label" for="pref-orientation">Orientation sexuelle</label>
      <select class="profil-setting-select" id="pref-orientation" data-pref="orientation">
        <option value="" <%= currentUser.orientation === '' ? 'selected' : '' %>>Non pr&eacute;cis&eacute;</option>
        <option value="hetero" <%= currentUser.orientation === 'hetero' ? 'selected' : '' %>>H&eacute;t&eacute;ro</option>
        <option value="gay" <%= currentUser.orientation === 'gay' ? 'selected' : '' %>>Gay</option>
        <option value="bi" <%= currentUser.orientation === 'bi' ? 'selected' : '' %>>Bi</option>
      </select>
    </div>

    <div class="profil-right-settings">
      <div class="profil-right-settings-title">Param&egrave;tres</div>

      <div class="profil-setting-label">Ultra</div>
      <div class="user-setting-options" id="ultra-mode-options">
        <label class="user-setting-radio" data-val="hidden">
          <input type="radio" name="ultra-mode" value="hidden" />
          Masqu&eacute; (bascule)
        </label>
        <label class="user-setting-radio" data-val="visible">
          <input type="radio" name="ultra-mode" value="visible" />
          Visible
        </label>
        <label class="user-setting-radio" data-val="off">
          <input type="radio" name="ultra-mode" value="off" />
          D&eacute;sactiv&eacute;
        </label>
      </div>

      <div class="profil-setting-label">Irr&eacute;aliste</div>
      <div class="user-setting-options" id="irrealiste-mode-options">
        <label class="user-setting-radio" data-val="hidden">
          <input type="radio" name="irrealiste-mode" value="hidden" />
          Masqu&eacute; (bascule)
        </label>
        <label class="user-setting-radio" data-val="visible">
          <input type="radio" name="irrealiste-mode" value="visible" />
          Visible
        </label>
        <label class="user-setting-radio" data-val="off">
          <input type="radio" name="irrealiste-mode" value="off" />
          D&eacute;sactiv&eacute;
        </label>
      </div>
    </div>
  </aside>

  <% if (!wikiPages.length && !galleryImages.length && !bdBooks.length) { %>
    <p class="intro">Aucun favori pour l&apos;instant. Utilise le bouton favori sur une page wiki, une image de la galerie ou une BD pour l&apos;ajouter ici.</p>
  <% } %>

  <!-- Section Mes Fantasmes : favoris wiki de la catégorie "fantasmes" -->
  <% if (fantasyPages.length) { %>
    <h2 class="profil-section-title">Mes fantasmes (<%= fantasyPages.length %>)</h2>
    <div class="wiki-grid">
      <% fantasyPages.forEach(function (page) { %>
        <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
      <% }) %>
    </div>
  <% } %>

  <!-- Section pages wiki favorites -->
  <% if (wikiPages.length) { %>
    <h2 class="profil-section-title">Pages favorites (<%= wikiPages.length %>)</h2>
    <div class="wiki-grid">
      <% wikiPages.forEach(function (page) { %>
        <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
      <% }) %>
    </div>
  <% } %>

  <!-- Section images favorites -->
  <% if (galleryImages.length) { %>
    <h2 class="profil-section-title">Images favorites (<%= galleryImages.length %>)</h2>
    <div class="profil-fav-grid">
      <% galleryImages.forEach(function (img) { %>
        <a href="/galerie/<%= img.id %>/edit"
           class="profil-fav-card"
           data-fav-item data-item-type="gallery" data-item-id="<%= img.id %>">
          <% if (img.imagePaths && img.imagePaths[0]) { %>
            <img src="<%= thumbUrl(img.imagePaths[0]) %>" alt="<%= img.title || 'Sans titre' %>" class="profil-fav-card-img" loading="lazy" />
          <% } else { %>
            <div class="profil-fav-card-placeholder">&#128247;</div>
          <% } %>
          <span class="profil-fav-card-title"><%= img.title || 'Sans titre' %></span>
          <button type="button" class="wiki-pl-remove" title="Retirer des favoris">&#215;</button>
        </a>
      <% }) %>
    </div>
  <% } %>

  <!-- Section BD favorites -->
  <% if (bdBooks.length) { %>
    <h2 class="profil-section-title">BD favorites (<%= bdBooks.length %>)</h2>
    <div class="profil-fav-grid">
      <% bdBooks.forEach(function (book) { %>
        <a href="/bd/<%= book.id %>"
           class="profil-fav-card"
           data-fav-item data-item-type="bd" data-item-id="<%= book.id %>">
          <% if (book.imagePaths && book.imagePaths[0]) { %>
            <img src="<%= thumbUrl(book.imagePaths[0]) %>" alt="<%= book.title %>" class="profil-fav-card-img" loading="lazy" />
          <% } else if (book.filename) { %>
            <img src="<%= thumbUrl(book.filename) %>" alt="<%= book.title %>" class="profil-fav-card-img" loading="lazy" />
          <% } else { %>
            <div class="profil-fav-card-placeholder">&#128218;</div>
          <% } %>
          <span class="profil-fav-card-title"><%= book.title %></span>
          <button type="button" class="wiki-pl-remove" title="Retirer des favoris">&#215;</button>
        </a>
      <% }) %>
    </div>
  <% } %>

  <!-- Boutons CTA -->
  <div class="profil-notes-btns">
    <a href="/favoris/notes/images" class="profil-notes-btn">Images not&eacute;es</a>
    <a href="/favoris/notes/wiki" class="profil-notes-btn">Pages wiki not&eacute;es</a>
    <a href="/favoris/notes/bd" class="profil-notes-btn">BD not&eacute;es</a>
  </div>

</main>
<script>
// ── Paramètres de profil (Goûts + Ultra/Irréaliste) ────────────────────────
// Sauvegarde instantanée côté serveur (voir POST /favoris/parametres).
(function() {
  function savePref(field, value) {
    var body = {};
    body[field] = value;
    fetch("/favoris/parametres", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    }).catch(function() {});
  }

  function wireRadioGroup(containerId, field, initial) {
    var container = document.getElementById(containerId);
    if (!container) return;
    var labels = Array.prototype.slice.call(container.querySelectorAll(".user-setting-radio"));
    var current = initial;
    function syncLabels() {
      labels.forEach(function(lbl) { lbl.classList.toggle("active", lbl.dataset.val === current); });
    }
    syncLabels();
    labels.forEach(function(lbl) {
      var radio = lbl.querySelector("input");
      if (radio.value === current) radio.checked = true;
      radio.addEventListener("change", function() {
        if (!radio.checked) return;
        current = radio.value;
        syncLabels();
        savePref(field, current);
      });
    });
  }

  wireRadioGroup("ultra-mode-options", "ultraMode", window.ULTRA_MODE || "hidden");
  wireRadioGroup("irrealiste-mode-options", "irrealisteMode", window.IRREALISTE_MODE || "visible");

  var orientationSelect = document.getElementById("pref-orientation");
  if (orientationSelect) {
    orientationSelect.addEventListener("change", function() {
      savePref("orientation", orientationSelect.value);
    });
  }
})();

// ── Favoris ───────────────────────────────────────────────────────────────
document.querySelectorAll("[data-fav-item] .wiki-pl-remove").forEach(function (btn) {
  btn.addEventListener("click", function (e) {
    e.preventDefault();
    var card = btn.closest("[data-fav-item]");
    fetch("/favoris/toggle", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ itemType: card.dataset.itemType, itemId: Number(card.dataset.itemId) }),
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d.ok && !d.active) card.remove();
      });
  });
});
</script>
<%- include('partials/foot') %>
