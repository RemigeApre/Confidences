<%- include('partials/head', { title: 'Profil' }) %>
<main class="container wide profil-page gallery-has-sidebar">
  <%- include('partials/top-nav', { config: config }) %>
  <%- include('partials/profil-nav', { roleHue: roleHue }) %>

  <div class="profil-home">

    <%# ── 1. Coffre ── %>
    <div class="ph-coffre-section">

      <%# Lootbox flottante, hors encart %>
      <div class="ph-lootbox-wrap">
        <button type="button" class="ph-lootbox-btn<%= lootboxCount === 0 ? ' ph-lootbox-btn--empty' : '' %>" id="ph-lootbox-btn" aria-label="Ouvrir une lootbox" <%= lootboxCount === 0 ? 'disabled' : '' %>>
          <svg class="ph-lootbox-svg" viewBox="0 0 100 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="5" y="38" width="90" height="37" rx="6" fill="<%= lootboxCount > 0 ? 'hsl(36,80%,30%)' : 'hsl(240,8%,18%)' %>" stroke="<%= lootboxCount > 0 ? 'hsl(36,70%,50%)' : 'hsl(240,8%,30%)' %>" stroke-width="2"/>
            <rect x="5" y="38" width="90" height="12" rx="3" fill="<%= lootboxCount > 0 ? 'hsl(36,80%,40%)' : 'hsl(240,8%,22%)' %>" stroke="<%= lootboxCount > 0 ? 'hsl(36,70%,50%)' : 'hsl(240,8%,30%)' %>" stroke-width="2"/>
            <path d="M50 38 Q50 20 35 20 Q20 20 20 34 Q20 44 50 38Z" fill="<%= lootboxCount > 0 ? 'hsl(36,80%,35%)' : 'hsl(240,8%,20%)' %>" stroke="<%= lootboxCount > 0 ? 'hsl(36,70%,50%)' : 'hsl(240,8%,30%)' %>" stroke-width="1.5"/>
            <path d="M50 38 Q50 20 65 20 Q80 20 80 34 Q80 44 50 38Z" fill="<%= lootboxCount > 0 ? 'hsl(36,80%,35%)' : 'hsl(240,8%,20%)' %>" stroke="<%= lootboxCount > 0 ? 'hsl(36,70%,50%)' : 'hsl(240,8%,30%)' %>" stroke-width="1.5"/>
            <rect x="44" y="38" width="12" height="12" rx="2" fill="<%= lootboxCount > 0 ? 'hsl(44,95%,55%)' : 'hsl(240,8%,26%)' %>" stroke="<%= lootboxCount > 0 ? 'hsl(44,70%,40%)' : 'hsl(240,8%,32%)' %>" stroke-width="1.5"/>
          </svg>
          <span class="ph-lootbox-count" id="ph-lootbox-count"><%= lootboxCount %></span>
          <span class="ph-lootbox-label">
            <% if (lootboxCount === 0) { %>aucun coffre<% } else if (lootboxCount === 1) { %>1 à ouvrir<% } else { %><%= lootboxCount %> à ouvrir<% } %>
          </span>
        </button>
      </div>

      <%# Items sans encart — grille pleine largeur %>
      <% var unlockPrev = (unlocks || []).slice(0, 8); %>
      <% if (unlockPrev.length) { %>
        <div class="ph-items-grid">
          <% unlockPrev.forEach(function(u) { %>
            <div class="ph-item-thumb">
              <% if (u.thumb) { %><img src="<%= u.thumb %>" alt="" loading="lazy" /><% } else { %><span>&#127873;</span><% } %>
            </div>
          <% }) %>
          <% if (unlocks.length > 8) { %>
            <div class="ph-item-thumb ph-item-thumb--more">+<%= unlocks.length - 8 %></div>
          <% } %>
        </div>
      <% } else { %>
        <p class="ph-empty-hint">Coffre vide</p>
      <% } %>

      <a href="/favoris/coffre" class="ph-coffre-link">Mon coffre</a>
    </div>

    <%# ── 2. Activité ── %>
    <%
      var actWiki    = notesCounts.wiki    || 0;
      var actGallery = notesCounts.gallery || 0;
      var actBd      = notesCounts.bd      || 0;
      var actFav     = (wikiPages.length || 0) + (galleryImages.length || 0) + (bdBooks.length || 0);
    %>
    <div class="ph-card">
      <div class="ph-card-header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Activit&eacute;
      </div>
      <div class="ph-card-body ph-card-body--activity">
        <a href="/favoris/notes/wiki" class="ph-act-cell">
          <span class="ph-act-num"><%= actWiki %></span>
          <span class="ph-act-lbl">Codex</span>
        </a>
        <a href="/favoris/notes/images" class="ph-act-cell">
          <span class="ph-act-num"><%= actGallery %></span>
          <span class="ph-act-lbl">Images</span>
        </a>
        <a href="/favoris/notes/bd" class="ph-act-cell">
          <span class="ph-act-num"><%= actBd %></span>
          <span class="ph-act-lbl">BD</span>
        </a>
        <a href="/favoris" class="ph-act-cell">
          <span class="ph-act-num"><%= actFav %></span>
          <span class="ph-act-lbl">Favoris</span>
        </a>
      </div>
      <a href="/favoris/historique" class="ph-card-sublink">Historique</a>
    </div>

    <%# ── 3. Gestion ── %>
    <div class="ph-card">
      <div class="ph-card-header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
        Gestion
      </div>
      <div class="ph-card-body ph-card-body--gestion">
        <a href="/favoris/parametres" class="ph-gest-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><circle cx="14" cy="7" r="2"/><line x1="4" y1="12" x2="20" y2="12"/><circle cx="8" cy="12" r="2"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="16" cy="17" r="2"/></svg>
          Param&egrave;tres
        </a>
        <a href="/favoris/identite" class="ph-gest-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          Identit&eacute;
        </a>
        <a href="/favoris/masques" class="ph-gest-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
          Masqu&eacute;s
        </a>
        <a href="/favoris/mot-de-passe" class="ph-gest-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Mot de passe
        </a>
        <% if (currentUser.isAdmin) { %>
        <a href="/favoris/journal" class="ph-gest-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16h16V8Z"/><polyline points="14 2 14 8 20 8"/></svg>
          Journal
        </a>
        <% } %>
      </div>
    </div>

    <%# ── 4. Partenaire (si concerné) ── %>
    <% if (locals.partner && partner) { %>
    <div class="ph-card ph-card--partner">
      <div class="ph-card-header ph-card-header--partner">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        Partenaire
      </div>
      <div class="ph-card-body ph-card-body--partner">
        <% if (partner.profileImagePath) { %>
          <img src="<%= partner.profileImagePath %>" alt="" class="ph-partner-avatar" />
        <% } else { %>
          <div class="ph-partner-avatar ph-partner-avatar--placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          </div>
        <% } %>
        <span class="ph-partner-name"><%= partner.displayName %></span>
        <a href="/couple" class="ph-card-link ph-card-link--partner">Profil commun</a>
      </div>
    </div>
    <% } %>

    <%# ── Favoris (fantasmes + bd uniquement) ── %>
    <% if (fantasyPages.length || bdBooks.length) { %>
    <div class="ph-fav-section">
      <% if (fantasyPages.length) { %>
        <h3 class="profil-section-title" id="profil-fantasy-title">Mes fantasmes (<%= fantasyPages.length %>)</h3>
        <div class="wiki-grid" id="profil-fantasy-grid">
          <% fantasyPages.forEach(function(page) { %>
            <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
          <% }) %>
        </div>
      <% } %>

      <% if (bdBooks.length) { %>
        <h3 class="profil-section-title" id="profil-bd-title">BD favorites (<%= bdBooks.length %>)</h3>
        <div class="profil-fav-grid" id="profil-bd-grid">
          <% bdBooks.forEach(function(book) { %>
            <a href="/bd/<%= book.id %>"
               class="profil-fav-card"
               data-fav-item data-item-type="bd" data-item-id="<%= book.id %>"
               data-ultra="<%= book.tags.indexOf('ultra') !== -1 ? '1' : '0' %>">
              <% if (book.imagePaths && book.imagePaths[0]) { %>
                <img src="<%= thumbUrl(book.imagePaths[0]) %>" alt="<%= book.title %>" class="profil-fav-card-img" loading="lazy" />
              <% } else { %>
                <div class="profil-fav-card-placeholder">&#128218;</div>
              <% } %>
              <span class="profil-fav-card-title"><%= book.title %></span>
              <button type="button" class="wiki-pl-remove" title="Retirer des favoris">&#215;</button>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
    <% } %>

    <%# ── Bouton "Extraire mes goûts" ── %>
    <div class="ph-export-wrap">
      <p class="ph-export-hint">T&eacute;l&eacute;chargez une synth&egrave;se de vos go&ucirc;ts (codex), class&eacute;e par degr&eacute; d&rsquo;appr&eacute;ciation.</p>
      <button type="button" id="wiki-export-gouts-btn" class="ph-export-btn">Extraire mes go&ucirc;ts</button>
    </div>
    <%- include('partials/export-gouts-modal') %>

  </div><%# /profil-home %>

</main>

<script nonce="<%= nonce %>">
(function () {
  // Bouton lootbox
  var phBtn = document.getElementById("ph-lootbox-btn");
  if (phBtn) {
    phBtn.addEventListener("click", function () {
      if (typeof window._lbTrigger === "function") window._lbTrigger();
    });
  }

  // Retirer des favoris (BD)
  document.querySelectorAll("[data-fav-item] .wiki-pl-remove").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.preventDefault();
      var card = btn.closest("[data-fav-item]");
      fetch("/favoris/toggle", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ itemType: card.dataset.itemType, itemId: Number(card.dataset.itemId) }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) { if (d.ok && !d.active) card.remove(); });
    });
  });

  // Masquer Ultra
  var ultraCards = document.querySelectorAll('[data-ultra="1"]');
  var sections = [
    { title: document.getElementById("profil-fantasy-title"), grid: document.getElementById("profil-fantasy-grid"), sel: ".wiki-card" },
    { title: document.getElementById("profil-pf-title"),      grid: document.getElementById("profil-pf-grid"),      sel: ".wiki-card", relabel: "Pages favorites", relabelSingle: "Page favorite" },
    { title: document.getElementById("profil-images-title"),  grid: document.getElementById("profil-images-grid"),  sel: ".profil-fav-card" },
    { title: document.getElementById("profil-bd-title"),      grid: document.getElementById("profil-bd-grid"),      sel: ".profil-fav-card" },
  ];
  function applyUltraHide() {
    var on = localStorage.getItem("profil-hide-ultra") === "1";
    ultraCards.forEach(function (el) { el.hidden = on; });
    sections.forEach(function (s) {
      if (!s.title || !s.grid) return;
      var visible = s.grid.querySelectorAll(s.sel + ":not([hidden])").length;
      s.title.hidden = visible === 0;
      s.grid.hidden = visible === 0;
      if (s.relabel && visible > 0) s.title.textContent = visible > 1 ? s.relabel : s.relabelSingle;
    });
  }
  applyUltraHide();
  document.addEventListener("profil-ultra-toggle-change", applyUltraHide);

  // "Extraire mes goûts"
  var exportBtn = document.getElementById("wiki-export-gouts-btn");
  var exportModal = document.getElementById("export-gouts-modal");
  if (exportBtn && exportModal) {
    var exportUltraCheck = document.getElementById("export-gouts-ultra");
    var exportIrrealisteCheck = document.getElementById("export-gouts-irrealiste");
    var exportConfirmBtn = document.getElementById("export-gouts-confirm");
    var exportCancelBtn = document.getElementById("export-gouts-cancel");
    function openExportModal() { exportModal.hidden = false; }
    function closeExportModal() { exportModal.hidden = true; }
    exportBtn.addEventListener("click", openExportModal);
    if (exportCancelBtn) exportCancelBtn.addEventListener("click", closeExportModal);
    exportModal.addEventListener("click", function (e) { if (e.target === exportModal) closeExportModal(); });
    if (exportConfirmBtn) {
      exportConfirmBtn.addEventListener("click", function () {
        var min = "all";
        exportModal.querySelectorAll('input[name="export-gouts-min"]').forEach(function (r) {
          if (r.checked) min = r.value;
        });
        var params = new URLSearchParams({
          ultra: exportUltraCheck && exportUltraCheck.checked ? "1" : "0",
          irrealiste: exportIrrealisteCheck && exportIrrealisteCheck.checked ? "1" : "0",
          min: min
        });
        window.location.href = "/wiki/export-gouts?" + params.toString();
        closeExportModal();
      });
    }
  }
})();
</script>

<%- include('partials/foot') %>
