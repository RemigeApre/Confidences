<%
  var SEXE_LABEL  = { femme: 'Femme', homme: 'Homme', autre: 'Autre', '': '' };
  var SEXE_SYMBOL = { femme: '♀', homme: '♂', autre: '⚧', '': '' };
  var SEXE_COLOR  = { femme: '#e0699f', homme: '#4a90d9', autre: '#9b59b6', '': '#888' };

  var _themeHue = themeDef && themeDef.hue;
  var _themeSat = (themeDef && themeDef.sat) || 55;
  var _sidebarBg, _sidebarBorder, _sidebarAccent;
  if (_themeHue) {
    _sidebarBg     = 'hsl(' + _themeHue + ',' + _themeSat + '%,10%)';
    _sidebarBorder = 'hsl(' + _themeHue + ',' + _themeSat + '%,22%)';
    _sidebarAccent = 'hsl(' + _themeHue + ',' + _themeSat + '%,52%)';
  } else if (themeDef && themeDef.key === 'blanc') {
    _sidebarBg = 'hsl(220,8%,16%)'; _sidebarBorder = 'hsl(220,8%,28%)'; _sidebarAccent = 'hsl(220,8%,70%)';
  } else {
    _sidebarBg = 'hsl(220,10%,11%)'; _sidebarBorder = 'hsl(220,10%,20%)'; _sidebarAccent = 'hsl(220,8%,55%)';
  }

  var _crop = avatarCrop;
  var _cx = (_crop && _crop.x  != null) ? _crop.x  : 50;
  var _cy = (_crop && _crop.y  != null) ? _crop.y  : 50;
  var _cs = (_crop && _crop.scale != null && _crop.scale >= 1) ? _crop.scale : 1;
  var _imgStyle = 'object-position:' + _cx + '% ' + _cy + '%;transform:scale(' + _cs + ');transform-origin:' + _cx + '% ' + _cy + '%;';
%>
<%- include('partials/head', { title: profileUser.displayName + ' — Profil' }) %>
<main class="container wide pp-standalone">
  <%- include('partials/top-nav', { config: config }) %>

  <%# ── Flux central ── %>
  <div class="pp-content">

    <% if (featuredImages.length) { %>
      <section class="pp-section">
        <h2 class="pp-section-title">Images en vedette</h2>
        <div class="pp-featured-strip">
          <% featuredImages.forEach(function(img) { %>
            <a href="/galerie/<%= img.id %>" class="pp-featured-item" title="<%= img.title || '' %>">
              <img src="<%= thumbUrl(img.imagePaths[0]) %>" alt="<%= img.title || '' %>" loading="lazy" />
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (wikiFavorites.length) { %>
      <section class="pp-section">
        <h2 class="pp-section-title">Favoris Codex<% if (wikiFavTotal > 12) { %> <span class="pp-section-count"><%= wikiFavTotal %></span><% } %></h2>
        <div class="pp-wiki-strip">
          <% wikiFavorites.forEach(function(page) { %>
            <% var _cover = page.imagePaths && page.imagePaths[0]; %>
            <a href="/wiki/<%= page.slug || page.id %>" class="pp-wiki-card">
              <% if (_cover) { %>
                <div class="pp-wiki-card-img"><img src="<%= thumbUrl(_cover) %>" alt="" loading="lazy" /></div>
              <% } else { %>
                <div class="pp-wiki-card-img pp-wiki-card-img--ph"><svg viewBox="0 0 60 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="30" cy="18" r="10" fill="none" stroke="hsl(220,55%,50%)" stroke-width="0.8" opacity="0.5"/></svg></div>
              <% } %>
              <div class="pp-wiki-card-title"><%= page.title %></div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (pub.showWikiStatus && wikiStatusItems && wikiStatusItems.length) { %>
      <%
        var _posséde = wikiStatusItems.filter(function(i){ return i.status === 'posséde'; });
        var _souhaite = wikiStatusItems.filter(function(i){ return i.status === 'souhaite'; });
      %>
      <section class="pp-section">
        <h2 class="pp-section-title">Objets &amp; tenues</h2>
        <div class="pp-status-cols">
          <% if (_posséde.length) { %>
          <div class="pp-status-col">
            <div class="pp-status-col-head">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Je poss&egrave;de <span class="pp-status-count"><%= _posséde.length %></span>
            </div>
            <div class="pp-status-list">
              <% _posséde.forEach(function(item) { %>
                <a href="/wiki/<%= item.slug %>" class="pp-status-item pp-status-item--posséde"><%= item.title %></a>
              <% }); %>
            </div>
          </div>
          <% } %>
          <% if (_souhaite.length) { %>
          <div class="pp-status-col">
            <div class="pp-status-col-head">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              Je souhaite <span class="pp-status-count"><%= _souhaite.length %></span>
            </div>
            <div class="pp-status-list">
              <% _souhaite.forEach(function(item) { %>
                <a href="/wiki/<%= item.slug %>" class="pp-status-item pp-status-item--souhaite"><%= item.title %></a>
              <% }); %>
            </div>
          </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <% if (pub.showTopRatings && topRatedWiki && topRatedWiki.length) { %>
      <section class="pp-section">
        <h2 class="pp-section-title">Coups de coeur <span class="pp-section-count"><%= topRatedWiki.length %></span></h2>
        <div class="pp-wiki-strip">
          <% topRatedWiki.forEach(function(page) { %>
            <% var _cover = page.imagePaths && page.imagePaths[0]; %>
            <a href="/wiki/<%= page.slug || page.id %>" class="pp-wiki-card pp-wiki-card--rated" title="<%= page.userRating === 5 ? 'Note 5' : 'Note 4' %>">
              <% if (_cover) { %>
                <div class="pp-wiki-card-img"><img src="<%= thumbUrl(_cover) %>" alt="" loading="lazy" /></div>
              <% } else { %>
                <div class="pp-wiki-card-img pp-wiki-card-img--ph"><svg viewBox="0 0 60 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="30" cy="18" r="10" fill="none" stroke="hsl(220,55%,50%)" stroke-width="0.8" opacity="0.5"/></svg></div>
              <% } %>
              <div class="pp-wiki-card-title"><%= page.title %></div>
              <div class="pp-wiki-card-rating" aria-label="Note <%= page.userRating %>"><% for(var s=0;s<page.userRating;s++){ %><span class="pp-star pp-star--on"></span><% } %></div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (!featuredImages.length && !wikiFavorites.length && !(pub.showWikiStatus && wikiStatusItems && wikiStatusItems.length) && !(pub.showTopRatings && topRatedWiki && topRatedWiki.length)) { %>
      <p class="pp-empty">Ce profil est encore vide.</p>
    <% } %>

  </div>

</main>

<%# ── Volet droit — hors du flux, dans la gouttière droite ── %>
<aside class="pp-right-panel" style="--pp-bg:<%= _sidebarBg %>;--pp-border:<%= _sidebarBorder %>;--pp-accent:<%= _sidebarAccent %>">

  <% if (avatarThumb) { %>
    <div class="pp-rp-avatar pp-rp-avatar--img">
      <img src="<%= avatarThumb %>" alt="" class="pp-rp-avatar-img" style="<%= _imgStyle %>" />
    </div>
  <% } else { %>
    <div class="pp-rp-avatar pp-rp-avatar--shape" style="--avatar-color:<%= profileUser.profileColor || '#6b7280' %>">
      <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polygon points="24,4 44,24 24,44 4,24" fill="var(--avatar-color)" /></svg>
    </div>
  <% } %>

  <p class="pp-rp-name"><%= profileUser.displayName %></p>

  <% if (pub.showStreak && streak > 0) { %>
    <div class="pp-rp-streak"><span class="pp-rp-streak-flame">🔥</span><span class="pp-rp-streak-count"><%= streak %></span><span class="pp-rp-streak-label">jour<%= streak > 1 ? 's' : '' %></span></div>
  <% } %>

  <% if (pub.showCoffre) { %>
  <div class="pp-rp-coffre">
    <div class="pp-rp-coffre-stat"><span class="pp-rp-coffre-num"><%= coffreStats.images %></span><span class="pp-rp-coffre-lbl">images</span></div>
    <div class="pp-rp-coffre-sep"></div>
    <div class="pp-rp-coffre-stat"><span class="pp-rp-coffre-num"><%= coffreStats.charms %></span><span class="pp-rp-coffre-lbl">charmes</span></div>
    <div class="pp-rp-coffre-sep"></div>
    <div class="pp-rp-coffre-stat"><span class="pp-rp-coffre-num"><%= coffreStats.themes %></span><span class="pp-rp-coffre-lbl">thèmes</span></div>
  </div>
  <% } %>

  <% if (pub.showSexe && profileUser.sexe) { %>
    <span class="pp-rp-sexe" style="color:<%= SEXE_COLOR[profileUser.sexe] || '#888' %>">
      <span aria-hidden="true"><%= SEXE_SYMBOL[profileUser.sexe] %></span>
      <%= SEXE_LABEL[profileUser.sexe] %>
    </span>
  <% } %>

  <% if (pub.showArchetype && quizResult) { %>
    <div class="pp-rp-archetype" style="--arch-hue:<%= quizResult.worldHue %>">
      <div class="pp-rp-arch-world"><%= quizResult.world %><% if (quizResult.worldTagline) { %><span class="pp-rp-arch-world-tag"> &middot; <%= quizResult.worldTagline %></span><% } %></div>
      <div class="pp-rp-arch-name"><%= quizResult.archetypeName %></div>
      <% if (quizResult.archetypeDesc) { %>
        <p class="pp-rp-arch-desc"><%=
          (function(t){ var i=t.indexOf('. '); return i>0?t.slice(0,i+1):t.slice(0,110); })(quizResult.archetypeDesc)
        %></p>
      <% } %>
      <div class="pp-rp-arch-code"><%= quizResult.code %><% if (quizResult.position) { %> &middot; <%= quizResult.position %><% } %></div>
    </div>
  <% } %>

</aside>

<%- include('partials/foot') %>
