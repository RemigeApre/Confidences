<%- include('partials/head', { title: 'Coffre' }) %>
<main class="container wide profil-page gallery-has-sidebar">
  <%- include('partials/top-nav', { config: config, navTitle: 'Coffre', navBack: '/favoris' }) %>
  <%- include('partials/profil-nav', { roleHue: roleHue }) %>

  <div class="profil-subpage coffre-page">

    <span id="coffre-coins-value" hidden><%= currentUser.coins %></span>

    <% if (!view) { %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# ── VUE D'ENSEMBLE ── %>
    <%# ════════════════════════════════════════════════════════════════ %>

    <%# ── Section images (aperçu 2 lignes × 4) ── %>
    <section class="coffre-section">
      <div class="coffre-section-header">
        <h2 class="coffre-section-title">Images de profil <span class="coffre-section-count">(<%= unlocks.length %>)</span></h2>
        <a href="/favoris/coffre?view=images" class="coffre-voir-plus">Voir tout &rarr;</a>
      </div>
      <% if (!unlocks.length) { %>
        <p class="coffre-empty">Ouvrez des lootboxes depuis la <a href="/jeu">page Jeu</a> pour débloquer des images.</p>
      <% } else { %>
        <div class="coffre-preview-grid">
          <% unlocks.slice(0, 8).forEach(function(u) { %>
            <div class="coffre-preview-item coffre-preview-item--<%= u.rarity %>"
                 title="<%= u.title || 'Sans titre' %>">
              <% if (u.thumb) { %>
                <img src="<%= thumbUrl(u.thumb) %>" alt="<%= u.title %>" loading="lazy" />
              <% } else { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <% } %>
              <% if (currentUser.profileImageId === u.refId) { %>
                <span class="coffre-preview-active-dot" title="Photo active"></span>
              <% } %>
            </div>
          <% }) %>
          <% if (unlocks.length > 8) { %>
            <a href="/favoris/coffre?view=images" class="coffre-preview-more">+<%= unlocks.length - 8 %></a>
          <% } %>
        </div>
      <% } %>
    </section>

    <%# ── Section charmes (aperçu 1 ligne) ── %>
    <section class="coffre-section">
      <div class="coffre-section-header">
        <h2 class="coffre-section-title">Charmes</h2>
        <a href="/favoris/coffre?view=charms" class="coffre-voir-plus">Voir tout &rarr;</a>
      </div>
      <% var ownedCharms = charms.filter(function(c) { return c.owned; }); %>
      <% if (!ownedCharms.length) { %>
        <p class="coffre-empty">Aucun charme obtenu — ouvrez une lootbox charme pour en débloquer.</p>
      <% } else { %>
        <div class="coffre-charms-strip">
          <% ownedCharms.forEach(function(c) { %>
            <%
              var rarityColor = c.rarity === 'mythic' ? '#f87171' : c.rarity === 'legendary' ? '#fbbf24' : c.rarity === 'epic' ? '#a78bfa' : c.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
              var isActive = currentUser.ratingCharm === c.key;
            %>
            <div class="coffre-charm-pill<%= isActive ? ' coffre-charm-pill--active' : '' %>"
                 style="--charm-color:<%= rarityColor %>"
                 title="<%= c.label %><%= isActive ? ' (actif)' : '' %>">
              <span class="coffre-charm-symbol"><%= c.symbol %></span>
              <span class="coffre-charm-label"><%= c.label %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <%# ── Section thèmes ── %>
    <section class="coffre-section">
      <div class="coffre-section-header">
        <h2 class="coffre-section-title">Th&egrave;mes</h2>
      </div>
      <div class="coffre-themes-grid">
        <% (userThemes || []).forEach(function(t) { %>
          <%
            var themeColors = { rouge:'hsl(355,55%,32%)', vert:'hsl(148,42%,28%)', violet:'hsl(270,58%,32%)', bleu:'hsl(212,65%,32%)', rose:'hsl(330,58%,32%)', blanc:'hsl(0,0%,90%)', default:'hsl(240,6%,20%)' };
            var swatchColor = themeColors[t.key] || '#333';
          %>
          <button type="button"
                  class="coffre-theme-card<%= t.active ? ' coffre-theme-card--active' : '' %><%= !t.owned ? ' coffre-theme-card--locked' : '' %>"
                  data-theme-key="<%= t.key %>"
                  <%= !t.owned ? 'disabled' : '' %>
                  title="<%= t.label %><%= t.active ? ' (actif)' : '' %><%= !t.owned ? ' (verrouillé)' : '' %>">
            <span class="coffre-theme-swatch" style="background:<%= swatchColor %>"></span>
            <span class="coffre-theme-name"><%= t.label %></span>
            <% if (t.active) { %><span class="coffre-theme-active-dot"></span><% } %>
            <% if (!t.owned && !t.always) { %><span class="coffre-theme-lock">&#128274;</span><% } %>
          </button>
        <% }); %>
      </div>
    </section>

    <% } else if (view === 'images') { %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# ── VUE IMAGES COMPLÈTE ── %>
    <%# ════════════════════════════════════════════════════════════════ %>

    <section class="coffre-section">
      <div class="coffre-section-header">
        <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
          <% if (currentUser.profileImageId) { %>
            <button class="coffre-btn coffre-btn--ghost js-set-avatar js-header-remove-avatar"
                    id="coffre-header-remove-btn"
                    data-ref-id="<%= currentUser.profileImageId %>"
                    title="Retirer la photo de profil">
              Image par d&eacute;faut
            </button>
          <% } %>
          <% if (unlocks.length) { %>
            <button class="coffre-btn coffre-btn--sell-multi js-sell-multi-open" id="coffre-sell-multi-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:14px;height:14px"><polyline points="20 12 20 22 4 22 4 12"/><polyline points="22 7 12 2 2 7"/><line x1="12" y1="22" x2="12" y2="2"/></svg>
              Vendre
            </button>
          <% } %>
        </div>
      </div>

      <%# ── Filtres : rareté / possession / favoris ── %>
      <div class="coffre-filters-group">
        <div class="coffre-filter-bar" id="coffre-f-rarity">
          <button class="coffre-filter-btn active" data-rarity="all">Tout</button>
          <button class="coffre-filter-btn" data-rarity="common">Commun</button>
          <button class="coffre-filter-btn" data-rarity="rare">Rare</button>
          <button class="coffre-filter-btn" data-rarity="epic">&Eacute;pique</button>
          <button class="coffre-filter-btn" data-rarity="legendary">L&eacute;g.</button>
          <button class="coffre-filter-btn" data-rarity="mythic">Mythique</button>
        </div>
        <div class="coffre-filter-bar coffre-filter-bar--sm" id="coffre-f-possession">
          <button class="coffre-filter-btn active" data-possession="all">Tout</button>
          <button class="coffre-filter-btn" data-possession="owned">Obtenues</button>
          <button class="coffre-filter-btn" data-possession="shop">&Agrave; d&eacute;bloquer</button>
        </div>
        <div class="coffre-filter-bar coffre-filter-bar--sm" id="coffre-f-fav">
          <button class="coffre-filter-btn active" data-favf="all">Tout</button>
          <button class="coffre-filter-btn" data-favf="yes">&#9829; Favoris</button>
        </div>
      </div>

      <div class="coffre-grid" id="coffre-img-grid">
        <% unlocks.forEach(function(u) { %>
          <div class="coffre-item coffre-item--owned<%= currentUser.profileImageId === u.refId ? ' coffre-item--active' : '' %>"
               data-unlock-id="<%= u.id %>"
               data-ref-id="<%= u.refId %>"
               data-rarity="<%= u.rarity %>"
               data-owned="1"
               data-fav="<%= u.isFavorite ? '1' : '0' %>"
               data-sell-price="<%= RARITY_SELL_PRICE[u.rarity] || 1 %>">
            <div class="coffre-item-img-wrap">
              <% if (u.thumb) { %>
                <img src="<%= thumbUrl(u.thumb) %>" alt="<%= u.title %>" class="coffre-item-img" loading="lazy" />
              <% } else { %>
                <div class="coffre-item-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              <% } %>
              <div class="coffre-item-rarity coffre-item-rarity--<%= u.rarity %>"><%= { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[u.rarity] || u.rarity %></div>
              <button class="coffre-fav-btn js-fav-toggle<%= u.isFavorite ? ' coffre-fav-btn--active' : '' %>"
                      data-unlock-id="<%= u.id %>"
                      title="<%= u.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                      aria-label="<%= u.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>">
                <%= u.isFavorite ? '♥' : '♡' %>
              </button>
            </div>
            <p class="coffre-item-title"><%= u.title || 'Sans titre' %></p>
            <div class="coffre-item-actions js-item-normal-actions">
              <% if (currentUser.profileImageId !== u.refId) { %>
                <button class="coffre-btn coffre-btn--avatar js-set-avatar"
                        data-ref-id="<%= u.refId %>"
                        title="Définir comme photo de profil">
                  &#9733; Utiliser
                </button>
              <% } else { %>
                <button class="coffre-btn coffre-btn--crop js-crop-edit"
                        data-ref-id="<%= u.refId %>"
                        data-thumb="<%= u.thumb ? thumbUrl(u.thumb) : '' %>"
                        title="Recadrer la zone affichée">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 1v8h8"/><path d="M1 4h8v8"/></svg>
                  Recadrer
                </button>
              <% } %>
            </div>
          </div>
        <% }) %>
        <% shopItems.forEach(function(item) { %>
          <div class="coffre-item coffre-item--locked"
               data-ref-id="<%= item.id %>"
               data-rarity="<%= item.rarity %>"
               data-owned="0"
               data-fav="0"
               data-buy-price="<%= item.buyPrice %>">
            <div class="coffre-item-img-wrap">
              <% if (item.thumb) { %>
                <img src="<%= thumbUrl(item.thumb) %>" alt="<%= item.title %>" class="coffre-item-img coffre-item-img--blurred" loading="lazy" />
              <% } else { %>
                <div class="coffre-item-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
              <% } %>
              <div class="coffre-item-lock-overlay">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              </div>
              <div class="coffre-item-rarity coffre-item-rarity--<%= item.rarity %>"><%= { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[item.rarity] || item.rarity %></div>
            </div>
            <p class="coffre-item-title coffre-item-title--muted"><%= item.title || 'Sans titre' %></p>
            <p class="coffre-item-shop-hint">revente&nbsp;<%= RARITY_SELL_PRICE.common %>&ndash;<%= RARITY_SELL_PRICE.mythic %>&thinsp;P</p>
            <button class="coffre-btn coffre-btn--buy js-buy"
                    data-ref-id="<%= item.id %>"
                    data-price="<%= item.buyPrice %>">
              Acheter &bull; <%= item.buyPrice %>&thinsp;P
            </button>
          </div>
        <% }) %>
      </div>
    </section>

    <% } else if (view === 'charms') { %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# ── VUE CHARMES COMPLÈTE ── %>
    <%# ════════════════════════════════════════════════════════════════ %>

    <%
      var _ownedCharms  = charms.filter(function(c){ return c.owned; });
      var _lockedCharms = charms.filter(function(c){ return !c.owned; });
    %>

    <% if (_ownedCharms.length) { %>
    <section class="coffre-section">
      <div class="coffre-charms-grid">
        <% _ownedCharms.forEach(function(c) { %>
          <%
            var rarityColor = c.rarity === 'mythic' ? '#f87171' : c.rarity === 'legendary' ? '#fbbf24' : c.rarity === 'epic' ? '#a78bfa' : c.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
            var rarityLabel = { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[c.rarity] || c.rarity;
            var isActive = currentUser.ratingCharm === c.key;
          %>
          <div class="coffre-charm-card coffre-charm-card--owned<%= isActive ? ' coffre-charm-card--active' : '' %>"
               data-rarity="<%= c.rarity %>"
               style="--charm-color:<%= rarityColor %>">
            <div class="coffre-charm-card-symbols">
              <span class="coffre-charm-card-sym coffre-charm-card-sym--filled"><%= c.symbol %></span>
              <% if (c.symbol_empty) { %><span class="coffre-charm-card-sym coffre-charm-card-sym--empty"><%= c.symbol_empty %></span><% } %>
            </div>
            <strong class="coffre-charm-card-label"><%= c.label %></strong>
            <span class="coffre-charm-card-rarity" style="color:<%= rarityColor %>"><%= rarityLabel %></span>
            <% if (isActive) { %>
              <button class="coffre-btn coffre-charm-btn coffre-charm-btn--active js-charm-equip" data-charm-key="star">Retirer</button>
            <% } else { %>
              <button class="coffre-btn coffre-charm-btn js-charm-equip" data-charm-key="<%= c.key %>">&Eacute;quiper</button>
            <% } %>
            <% if (c.unlockId) { %>
              <button class="coffre-fav-btn js-charm-fav<%= c.isFavorite ? ' coffre-fav-btn--active' : '' %>"
                      data-unlock-id="<%= c.unlockId %>"
                      title="<%= c.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                      style="position:static;width:auto;height:auto;border-radius:20px;padding:.2rem .55rem;font-size:.78rem;display:inline-flex;align-items:center">
                <%= c.isFavorite ? '♥' : '♡' %>
              </button>
            <% } %>
          </div>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (_lockedCharms.length) { %>
    <section class="coffre-section coffre-section--locked-group">
      <p class="coffre-locked-group-label">&Agrave; d&eacute;bloquer</p>
      <div class="coffre-charms-grid">
        <% _lockedCharms.forEach(function(c) { %>
          <%
            var rarityColor = c.rarity === 'mythic' ? '#f87171' : c.rarity === 'legendary' ? '#fbbf24' : c.rarity === 'epic' ? '#a78bfa' : c.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
            var rarityLabel = { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[c.rarity] || c.rarity;
          %>
          <div class="coffre-charm-card coffre-charm-card--locked"
               data-rarity="<%= c.rarity %>"
               style="--charm-color:<%= rarityColor %>">
            <div class="coffre-charm-card-symbols">
              <span class="coffre-charm-card-sym coffre-charm-card-sym--filled"><%= c.symbol %></span>
              <% if (c.symbol_empty) { %><span class="coffre-charm-card-sym coffre-charm-card-sym--empty"><%= c.symbol_empty %></span><% } %>
            </div>
            <strong class="coffre-charm-card-label"><%= c.label %></strong>
            <span class="coffre-charm-card-rarity" style="color:<%= rarityColor %>"><%= rarityLabel %></span>
            <button class="coffre-btn coffre-charm-btn coffre-charm-btn--buy js-buy-charm"
                    data-charm-id="<%= c.id %>"
                    data-price="<%= CHARM_BUY_PRICE[c.rarity] || 100 %>">
              Acheter &bull; <%= CHARM_BUY_PRICE[c.rarity] || 100 %>&thinsp;P
            </button>
          </div>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% } else if (view === 'themes') { %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# ── VUE THÈMES ── %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%
      var _ownedThemes  = (userThemes || []).filter(function(t){ return t.owned; });
      var _lockedThemes = (userThemes || []).filter(function(t){ return !t.owned && !t.always; });
      var _themeColors  = { rouge:'hsl(355,55%,32%)', vert:'hsl(148,42%,28%)', violet:'hsl(270,58%,32%)', bleu:'hsl(212,65%,32%)', rose:'hsl(330,58%,32%)', blanc:'hsl(0,0%,90%)', default:'hsl(240,6%,20%)' };
    %>

    <section class="coffre-section">
      <div class="coffre-themes-full">
        <% _ownedThemes.forEach(function(t) { %>
          <%
            var swatchColor = _themeColors[t.key] || '#333';
            var rarityColor = !t.always && t.rarity ? (t.rarity === 'mythic' ? '#f87171' : t.rarity === 'legendary' ? '#fbbf24' : t.rarity === 'epic' ? '#a78bfa' : t.rarity === 'rare' ? '#60a5fa' : '#94a3b8') : '#475569';
            var rarityLabel = t.always ? 'Toujours disponible' : ({ common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[t.rarity] || '—');
          %>
          <button type="button"
                  class="coffre-theme-card coffre-theme-card--full<%= t.active ? ' coffre-theme-card--active' : '' %>"
                  data-theme-key="<%= t.key %>"
                  title="<%= t.label %>">
            <span class="coffre-theme-swatch coffre-theme-swatch--lg" style="background:<%= swatchColor %>"></span>
            <div class="coffre-theme-info">
              <span class="coffre-theme-name"><%= t.label %></span>
              <span class="coffre-theme-rarity-label" style="color:<%= rarityColor %>"><%= rarityLabel %></span>
            </div>
            <% if (t.active) { %><span class="coffre-theme-active-dot" title="Actif"></span><% } %>
          </button>
        <% }); %>
      </div>
    </section>

    <% if (_lockedThemes.length) { %>
    <section class="coffre-section coffre-section--locked-group">
      <p class="coffre-locked-group-label">&Agrave; d&eacute;bloquer</p>
      <div class="coffre-themes-full">
        <% _lockedThemes.forEach(function(t) { %>
          <%
            var swatchColor = _themeColors[t.key] || '#333';
            var rarityColor = t.rarity ? (t.rarity === 'mythic' ? '#f87171' : t.rarity === 'legendary' ? '#fbbf24' : t.rarity === 'epic' ? '#a78bfa' : t.rarity === 'rare' ? '#60a5fa' : '#94a3b8') : '#94a3b8';
            var rarityLabel = { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[t.rarity] || '—';
            var themePrice = THEME_BUY_PRICE[t.rarity] || 100;
          %>
          <div class="coffre-theme-card coffre-theme-card--full coffre-theme-card--locked">
            <span class="coffre-theme-swatch coffre-theme-swatch--lg" style="background:<%= swatchColor %>"></span>
            <div class="coffre-theme-info">
              <span class="coffre-theme-name"><%= t.label %></span>
              <span class="coffre-theme-rarity-label" style="color:<%= rarityColor %>"><%= rarityLabel %></span>
              <button class="coffre-btn coffre-btn--buy js-buy-theme"
                      data-theme-key="<%= t.key %>"
                      data-price="<%= themePrice %>"
                      style="margin-top:.35rem;font-size:.72rem;padding:.25rem .6rem">
                Acheter &bull; <%= themePrice %>&thinsp;P
              </button>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
    <% } %>
    <% } %>

  </div>

<%# ── Modal recadrage (vue images seulement) ── %>
<% if (view === 'images') { %>
<div class="crop-modal-backdrop" id="crop-modal" role="dialog" aria-modal="true" style="display:none">
  <div class="crop-modal-dialog">
    <div class="crop-modal-header">
      <span class="crop-modal-title">Recadrer la photo de profil</span>
      <button class="coffre-sell-close js-crop-close" aria-label="Fermer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p class="crop-modal-hint">Faites glisser pour déplacer &bull; Molette pour zoomer</p>
    <div class="crop-preview-wrap" id="crop-preview-wrap">
      <div class="crop-preview-circle" id="crop-preview-circle">
        <img class="crop-preview-img" id="crop-preview-img" src="" alt="" draggable="false" />
      </div>
    </div>
    <div class="crop-zoom-row">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="width:16px;height:16px;flex-shrink:0"><circle cx="8" cy="8" r="5"/><line x1="13" y1="13" x2="18" y2="18"/><line x1="6" y1="8" x2="10" y2="8"/></svg>
      <input type="range" id="crop-zoom-slider" min="100" max="400" step="5" value="100" class="crop-zoom-slider" />
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="width:16px;height:16px;flex-shrink:0"><circle cx="8" cy="8" r="5"/><line x1="13" y1="13" x2="18" y2="18"/><line x1="6" y1="8" x2="10" y2="8"/><line x1="8" y1="6" x2="8" y2="10"/></svg>
    </div>
    <div class="crop-modal-actions">
      <button class="coffre-btn coffre-btn--ghost js-crop-close">Annuler</button>
      <button class="coffre-btn coffre-btn--sell-confirm" id="crop-save-btn" style="border-color:hsl(120,50%,38%);color:hsl(120,60%,65%);background:rgba(40,160,40,.12)">Enregistrer</button>
    </div>
  </div>
</div>
</main>

<%# ── Modal de vente ── %>
<div class="coffre-sell-backdrop" id="coffre-sell-modal" role="dialog" aria-modal="true" aria-labelledby="coffre-sell-modal-title" style="display:none">
  <div class="coffre-sell-dialog">
    <div class="coffre-sell-dialog-header">
      <h2 class="coffre-sell-dialog-title" id="coffre-sell-modal-title">Vendre des images</h2>
      <button class="coffre-sell-close js-sell-modal-close" aria-label="Fermer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p class="coffre-sell-hint">Cliquez sur les images à vendre, puis confirmez.</p>
    <div class="coffre-sell-grid" id="coffre-sell-grid"></div>
    <div class="coffre-sell-footer">
      <div class="coffre-sell-summary" id="coffre-sell-summary">
        <span class="coffre-sell-count" id="coffre-sell-count">0 image</span>
        <span class="coffre-sell-total">
          &rarr;
          <svg viewBox="0 0 16 16" aria-hidden="true" style="width:13px;height:13px;vertical-align:middle"><circle cx="8" cy="8" r="7" fill="hsl(44,95%,55%)" stroke="hsl(44,70%,35%)" stroke-width="1"/><text x="8" y="11.5" text-anchor="middle" font-size="7" font-weight="bold" fill="hsl(44,40%,20%)">P</text></svg>
          <strong id="coffre-sell-total-value">0</strong>&thinsp;P
        </span>
      </div>
      <div class="coffre-sell-actions">
        <button class="coffre-btn coffre-btn--ghost js-sell-modal-close">Annuler</button>
        <button class="coffre-btn coffre-btn--sell-confirm js-sell-confirm" disabled id="coffre-sell-confirm-btn">
          Vendre la sélection
        </button>
      </div>
    </div>
  </div>
</div>

<template id="tpl-img-placeholder">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
</template>
<template id="tpl-sell-tick">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
</template>

<%- include('partials/foot') %>

<script>
(function () {
  var coinsEl = document.getElementById('coffre-coins-value');
  function cloneTpl(id) { var tpl = document.getElementById(id); return tpl ? tpl.content.cloneNode(true) : null; }
  function updateCoins(n) { if (coinsEl) coinsEl.textContent = n; }

  // ── Achat ─────────────────────────────────────────────────────────────
  document.querySelectorAll('.js-buy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var refId = btn.dataset.refId;
      var price = btn.dataset.price;
      var balance = parseInt(coinsEl ? coinsEl.textContent : '0', 10);
      if (balance < parseInt(price)) { alert('Pas assez de pièces (il vous en faut ' + price + ', vous en avez ' + balance + ').'); return; }
      if (!confirm('Acheter cette image pour ' + price + ' pièce(s) ?')) return;
      fetch('/favoris/coffre/buy', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ itemType: 'profile_image', refId: parseInt(refId) }),
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d.ok) { alert(d.error || 'Erreur'); return; }
        updateCoins(d.newBalance); window.location.reload();
      });
    });
  });

  // ── Choix avatar ─────────────────────────────────────────────────────
  function bindSetAvatar(btn) {
    btn.addEventListener('click', function () {
      var refId = parseInt(btn.dataset.refId, 10);
      var card = btn.closest('.coffre-item');
      var isActive = card && card.classList.contains('coffre-item--active');
      var sending = isActive || btn.classList.contains('js-header-remove-avatar');
      fetch('/favoris/coffre/set-avatar', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ imageId: sending ? null : refId }),
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d.ok) { alert('Erreur'); return; }
        // Clear all active states
        document.querySelectorAll('#coffre-img-grid .coffre-item').forEach(function (c) {
          c.classList.remove('coffre-item--active');
          var sb = c.querySelector('.js-set-avatar');
          if (sb && !sb.classList.contains('js-header-remove-avatar')) {
            sb.innerHTML = '&#9733; Utiliser'; sb.title = 'Définir comme photo de profil';
          }
          // Swap crop→utiliser or utiliser stays
          var actions = c.querySelector('.js-item-normal-actions');
          if (actions) {
            var crop = actions.querySelector('.js-crop-edit');
            if (crop) {
              var util = document.createElement('button');
              util.className = 'coffre-btn coffre-btn--avatar js-set-avatar';
              util.dataset.refId = crop.dataset.refId;
              util.title = 'Définir comme photo de profil';
              util.innerHTML = '&#9733; Utiliser';
              bindSetAvatar(util);
              crop.replaceWith(util);
            }
          }
        });
        // Update header remove button visibility
        var headerBtn = document.getElementById('coffre-header-remove-btn');
        if (!sending) {
          // Activate new card
          if (card) {
            card.classList.add('coffre-item--active');
            var actions = card.querySelector('.js-item-normal-actions');
            if (actions) {
              var util = actions.querySelector('.js-set-avatar');
              if (util) {
                var imgEl = card.querySelector('.coffre-item-img');
                var thumbSrc = imgEl ? imgEl.src : '';
                var cropBtn = document.createElement('button');
                cropBtn.className = 'coffre-btn coffre-btn--crop js-crop-edit';
                cropBtn.dataset.refId = String(refId); cropBtn.dataset.thumb = thumbSrc;
                cropBtn.title = 'Recadrer la zone affichée';
                cropBtn.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 1v8h8"/><path d="M1 4h8v8"/></svg> Recadrer';
                cropBtn.addEventListener('click', function () {
                  if (!thumbSrc) return;
                  cropX = 50; cropY = 50; cropScale = 1; if (cropSlider) cropSlider.value = 100;
                  cropImg.src = thumbSrc; applyCrop(); cropModal.style.display = 'flex'; document.body.style.overflow = 'hidden';
                });
                util.replaceWith(cropBtn);
              }
            }
          }
          // Show header remove btn
          if (!headerBtn) {
            var hdr = document.querySelector('.coffre-section-header > div');
            if (hdr) {
              var nb = document.createElement('button');
              nb.id = 'coffre-header-remove-btn';
              nb.className = 'coffre-btn coffre-btn--ghost js-set-avatar js-header-remove-avatar';
              nb.dataset.refId = String(refId);
              nb.title = 'Retirer la photo de profil';
              nb.textContent = 'Image par défaut';
              bindSetAvatar(nb);
              hdr.insertBefore(nb, hdr.firstChild);
            }
          } else {
            headerBtn.dataset.refId = String(refId);
          }
        } else {
          // Remove header btn
          if (headerBtn) headerBtn.remove();
        }
      });
    });
  }
  document.querySelectorAll('.js-set-avatar').forEach(bindSetAvatar);

  // ── Modal de vente ────────────────────────────────────────────────────
  var modal = document.getElementById('coffre-sell-modal');
  var sellGrid = document.getElementById('coffre-sell-grid');
  var countEl = document.getElementById('coffre-sell-count');
  var totalEl = document.getElementById('coffre-sell-total-value');
  var confirmBtn = document.getElementById('coffre-sell-confirm-btn');
  var selected = {};

  function updateSummary() {
    var ids = Object.keys(selected);
    var total = ids.reduce(function(s, id) { return s + selected[id]; }, 0);
    countEl.textContent = ids.length + ' image' + (ids.length > 1 ? 's' : '');
    totalEl.textContent = total;
    confirmBtn.disabled = ids.length === 0;
    sellGrid.querySelectorAll('.coffre-sell-card').forEach(function(card) {
      card.classList.toggle('coffre-sell-card--selected', !!selected[card.dataset.unlockId]);
    });
  }

  function buildSellGrid() {
    selected = {}; sellGrid.innerHTML = '';
    document.querySelectorAll('#coffre-img-grid .coffre-item[data-owned="1"]').forEach(function(item) {
      var unlockId = item.dataset.unlockId;
      var rarity   = item.dataset.rarity;
      var price    = parseInt(item.dataset.sellPrice, 10) || 1;
      var imgEl    = item.querySelector('.coffre-item-img');
      var title    = (item.querySelector('.coffre-item-title') || {}).textContent || '';
      var isActive = item.classList.contains('coffre-item--active');

      var card = document.createElement('div');
      card.className = 'coffre-sell-card'; card.dataset.unlockId = unlockId;
      var imgWrap = document.createElement('div'); imgWrap.className = 'coffre-sell-card-img';
      if (imgEl) { var img = document.createElement('img'); img.src = imgEl.src; img.alt = ''; img.loading = 'lazy'; imgWrap.appendChild(img); }
      else { var ph = cloneTpl('tpl-img-placeholder'); if (ph) imgWrap.appendChild(ph); }
      var badge = document.createElement('span'); badge.className = 'coffre-item-rarity coffre-item-rarity--' + rarity;
      badge.textContent = ({common:'Commun',rare:'Rare',epic:'Épique',legendary:'Légendaire',mythic:'Mythique'})[rarity] || rarity;
      imgWrap.appendChild(badge);
      var tick = document.createElement('span'); tick.className = 'coffre-sell-card-tick';
      var tickSvg = cloneTpl('tpl-sell-tick'); if (tickSvg) tick.appendChild(tickSvg);
      imgWrap.appendChild(tick);
      var info = document.createElement('div'); info.className = 'coffre-sell-card-info';
      var titleEl = document.createElement('span'); titleEl.className = 'coffre-sell-card-title'; titleEl.textContent = title.trim() || 'Sans titre'; info.appendChild(titleEl);
      var priceEl = document.createElement('span'); priceEl.className = 'coffre-sell-card-price'; priceEl.textContent = price + '\u202fP'; info.appendChild(priceEl);
      if (isActive) { var warn = document.createElement('span'); warn.className = 'coffre-sell-card-warn'; warn.textContent = 'Photo active'; info.appendChild(warn); }
      card.appendChild(imgWrap); card.appendChild(info);
      card.addEventListener('click', function() {
        if (selected[unlockId]) delete selected[unlockId]; else selected[unlockId] = price;
        updateSummary();
      });
      sellGrid.appendChild(card);
    });
    updateSummary();
  }

  var sellOpenBtn = document.getElementById('coffre-sell-multi-btn');
  sellOpenBtn && sellOpenBtn.addEventListener('click', function() {
    buildSellGrid(); modal.style.display = 'flex'; document.body.style.overflow = 'hidden';
    setTimeout(function() { if(confirmBtn) confirmBtn.focus(); }, 50);
  });
  function closeModal() { modal.style.display = 'none'; document.body.style.overflow = ''; selected = {}; }
  document.querySelectorAll('.js-sell-modal-close').forEach(function(btn) { btn.addEventListener('click', closeModal); });
  modal && modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && modal && modal.style.display !== 'none') closeModal(); });

  confirmBtn && confirmBtn.addEventListener('click', function() {
    var ids = Object.keys(selected).map(Number);
    if (!ids.length) return;
    confirmBtn.disabled = true; confirmBtn.textContent = 'Vente en cours…';
    fetch('/favoris/coffre/sell', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ unlockIds: ids }),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (!d.ok) { alert(d.error || 'Erreur'); confirmBtn.disabled = false; confirmBtn.textContent = 'Vendre la sélection'; return; }
      updateCoins(d.newBalance); closeModal();
      ids.forEach(function(unlockId) {
        var card = document.querySelector('#coffre-img-grid .coffre-item[data-unlock-id="' + unlockId + '"]');
        if (card) { card.style.transition = 'opacity .25s, transform .25s'; card.style.opacity = '0'; card.style.transform = 'scale(.9)'; setTimeout(function() { card.remove(); }, 270); }
      });
    });
  });

  // ── Recadrage ─────────────────────────────────────────────────────────
  var cropModal = document.getElementById('crop-modal');
  var cropCircle = document.getElementById('crop-preview-circle');
  var cropImg    = document.getElementById('crop-preview-img');
  var cropSlider = document.getElementById('crop-zoom-slider');
  var cropSaveBtn= document.getElementById('crop-save-btn');
  var cropX = 50, cropY = 50, cropScale = 1;
  var cropDragging = false, cropDragSX, cropDragSY, cropDragX0, cropDragY0;
  function applyCrop() { cropImg.style.objectPosition = cropX + '% ' + cropY + '%'; cropImg.style.transform = 'scale(' + cropScale + ')'; cropImg.style.transformOrigin = cropX + '% ' + cropY + '%'; }
  document.querySelectorAll('.js-crop-edit').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var thumb = btn.dataset.thumb; if (!thumb) return;
      cropX = 50; cropY = 50; cropScale = 1; if (cropSlider) cropSlider.value = 100;
      cropImg.src = thumb; applyCrop(); cropModal.style.display = 'flex'; document.body.style.overflow = 'hidden';
    });
  });
  function closeCropModal() { cropModal.style.display = 'none'; document.body.style.overflow = ''; }
  document.querySelectorAll('.js-crop-close').forEach(function(b) { b.addEventListener('click', closeCropModal); });
  cropModal && cropModal.addEventListener('click', function(e) { if (e.target === cropModal) closeCropModal(); });
  cropCircle && cropCircle.addEventListener('mousedown', function(e) { cropDragging = true; cropDragSX = e.clientX; cropDragSY = e.clientY; cropDragX0 = cropX; cropDragY0 = cropY; e.preventDefault(); });
  cropCircle && cropCircle.addEventListener('touchstart', function(e) { if (!e.touches[0]) return; cropDragging = true; cropDragSX = e.touches[0].clientX; cropDragSY = e.touches[0].clientY; cropDragX0 = cropX; cropDragY0 = cropY; }, { passive: true });
  document.addEventListener('mousemove', function(e) { if (!cropDragging || !cropCircle) return; var rect = cropCircle.getBoundingClientRect(); var dx = (e.clientX - cropDragSX) / rect.width * 100 / cropScale; var dy = (e.clientY - cropDragSY) / rect.height * 100 / cropScale; cropX = Math.max(0, Math.min(100, cropDragX0 - dx)); cropY = Math.max(0, Math.min(100, cropDragY0 - dy)); applyCrop(); });
  document.addEventListener('touchmove', function(e) { if (!cropDragging || !e.touches[0] || !cropCircle) return; var rect = cropCircle.getBoundingClientRect(); var dx = (e.touches[0].clientX - cropDragSX) / rect.width * 100 / cropScale; var dy = (e.touches[0].clientY - cropDragSY) / rect.height * 100 / cropScale; cropX = Math.max(0, Math.min(100, cropDragX0 - dx)); cropY = Math.max(0, Math.min(100, cropDragY0 - dy)); applyCrop(); }, { passive: true });
  document.addEventListener('mouseup', function() { cropDragging = false; });
  document.addEventListener('touchend', function() { cropDragging = false; });
  cropCircle && cropCircle.addEventListener('wheel', function(e) { e.preventDefault(); cropScale = Math.max(1, Math.min(4, cropScale - e.deltaY * 0.003)); if (cropSlider) cropSlider.value = Math.round(cropScale * 100); applyCrop(); }, { passive: false });
  cropSlider && cropSlider.addEventListener('input', function() { cropScale = parseInt(cropSlider.value, 10) / 100; applyCrop(); });
  cropSaveBtn && cropSaveBtn.addEventListener('click', function() {
    cropSaveBtn.disabled = true;
    fetch('/favoris/coffre/set-avatar-crop', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ x: Math.round(cropX * 10) / 10, y: Math.round(cropY * 10) / 10, scale: Math.round(cropScale * 100) / 100 }),
    }).then(function(r) { return r.json(); }).then(function(d) { cropSaveBtn.disabled = false; if (d.ok) { closeCropModal(); window.location.reload(); } }).catch(function() { cropSaveBtn.disabled = false; });
  });

  // ── Filtres images (rareté × possession × favoris) ───────────────────
  var _fRarity = 'all', _fPossession = 'all', _fFav = 'all';
  function applyImgFilters() {
    document.querySelectorAll('#coffre-img-grid .coffre-item').forEach(function(card) {
      var ok = (_fRarity === 'all' || card.dataset.rarity === _fRarity) &&
               (_fPossession === 'all' || (_fPossession === 'owned' && card.dataset.owned === '1') || (_fPossession === 'shop' && card.dataset.owned === '0')) &&
               (_fFav === 'all' || card.dataset.fav === '1');
      card.hidden = !ok;
    });
  }
  function bindFilterBar(barId, prop, setter) {
    var bar = document.getElementById(barId); if (!bar) return;
    bar.addEventListener('click', function(e) {
      var btn = e.target.closest('.coffre-filter-btn'); if (!btn) return;
      bar.querySelectorAll('.coffre-filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      setter(btn.dataset[prop]);
      applyImgFilters();
    });
  }
  bindFilterBar('coffre-f-rarity',    'rarity',     function(v) { _fRarity = v; });
  bindFilterBar('coffre-f-possession','possession', function(v) { _fPossession = v; });
  bindFilterBar('coffre-f-fav',       'favf',        function(v) { _fFav = v; });

  // ── Favori images ─────────────────────────────────────────────────────
  document.querySelectorAll('.js-fav-toggle').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      fetch('/favoris/coffre/favorite', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ unlockId: parseInt(btn.dataset.unlockId) }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) return;
        btn.classList.toggle('coffre-fav-btn--active', !!d.isFavorite);
        btn.textContent = d.isFavorite ? '♥' : '♡';
        btn.title = d.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris';
        var card = btn.closest('.coffre-item');
        if (card) card.dataset.fav = d.isFavorite ? '1' : '0';
        applyImgFilters();
      });
    });
  });
})();
</script>

<% } else if (view === 'charms') { %>
</main>

<%- include('partials/foot') %>

<script>
(function() {
  var coinsEl = document.getElementById('coffre-coins-value');

  // ── Équiper charme ────────────────────────────────────────────────────
  document.querySelectorAll('.js-charm-equip').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var key = btn.dataset.charmKey;
      fetch('/lootbox/set-charm', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ charmKey: key }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) window.location.reload();
        else alert(d.error || 'Erreur');
      });
    });
  });

  // ── Filtre rareté charmes ─────────────────────────────────────────────
  var charmFilter = document.getElementById('coffre-charm-filter');
  charmFilter && charmFilter.addEventListener('click', function(e) {
    var btn = e.target.closest('.coffre-filter-btn'); if (!btn) return;
    charmFilter.querySelectorAll('.coffre-filter-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    var f = btn.dataset.filter;
    document.querySelectorAll('.coffre-charm-card').forEach(function(card) {
      card.hidden = f !== 'all' && card.dataset.rarity !== f;
    });
  });

  // ── Favori charmes ────────────────────────────────────────────────────
  document.querySelectorAll('.js-charm-fav').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      fetch('/favoris/coffre/favorite', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ unlockId: parseInt(btn.dataset.unlockId) }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) return;
        btn.classList.toggle('coffre-fav-btn--active', !!d.isFavorite);
        btn.textContent = d.isFavorite ? '♥' : '♡';
        btn.title = d.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris';
      });
    });
  });

  // ── Achat charme ──────────────────────────────────────────────────────
  document.querySelectorAll('.js-buy-charm').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var price = btn.dataset.price;
      var balance = parseInt(coinsEl ? coinsEl.textContent : '0', 10);
      if (balance < parseInt(price, 10)) {
        alert('Pas assez de pièces (il vous en faut ' + price + ', vous en avez ' + balance + ').');
        return;
      }
      if (!confirm('Acheter ce charme pour ' + price + ' pièce(s) ?')) return;
      btn.disabled = true;
      fetch('/favoris/coffre/buy-charm', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ charmId: parseInt(btn.dataset.charmId) }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) { alert(d.error || 'Erreur'); btn.disabled = false; return; }
        if (coinsEl) coinsEl.textContent = d.newBalance;
        window.location.reload();
      }).catch(function() { btn.disabled = false; });
    });
  });

  // ── Achat thème ───────────────────────────────────────────────────────
  document.querySelectorAll('.js-buy-theme').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var price = btn.dataset.price;
      var balance = parseInt(coinsEl ? coinsEl.textContent : '0', 10);
      if (balance < parseInt(price, 10)) {
        alert('Pas assez de pièces (il vous en faut ' + price + ', vous en avez ' + balance + ').');
        return;
      }
      if (!confirm('Acheter ce thème pour ' + price + ' pièce(s) ?')) return;
      btn.disabled = true;
      fetch('/favoris/coffre/buy-theme', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ themeKey: btn.dataset.themeKey }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) { alert(d.error || 'Erreur'); btn.disabled = false; return; }
        if (coinsEl) coinsEl.textContent = d.newBalance;
        window.location.reload();
      }).catch(function() { btn.disabled = false; });
    });
  });

})();
</script>

