  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
</template>

<%- include('partials/foot') %>

<script>
(function () {
  var coinsEl = document.getElementById('coffre-coins-value');
  function cloneTpl(id) { var tpl = document.getElementById(id); return tpl ? tpl.content.cloneNode(true) : null; }
  function updateCoins(n) { if (coinsEl) coinsEl.textContent = n; }

  // ── Achat ─────────────────────────────────────────────────────────────
  document.querySelectorAll('.js-buy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var refId = btn.dataset.refId;
      var price = btn.dataset.price;
      var balance = parseInt(coinsEl ? coinsEl.textContent : '0', 10);
      if (balance < parseInt(price)) { alert('Pas assez de pièces (il vous en faut ' + price + ', vous en avez ' + balance + ').'); return; }
      if (!confirm('Acheter cette image pour ' + price + ' pièce(s) ?')) return;
      fetch('/favoris/coffre/buy', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ itemType: 'profile_image', refId: parseInt(refId) }),
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d.ok) { alert(d.error || 'Erreur'); return; }
        updateCoins(d.newBalance); window.location.reload();
      });
    });
  });

  // ── Choix avatar ─────────────────────────────────────────────────────
  function bindSetAvatar(btn) {
    btn.addEventListener('click', function () {
      var refId = parseInt(btn.dataset.refId, 10);
      var card = btn.closest('.coffre-item');
      var isActive = card && card.classList.contains('coffre-item--active');
      var sending = isActive || btn.classList.contains('js-header-remove-avatar');
      fetch('/favoris/coffre/set-avatar', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ imageId: sending ? null : refId }),
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d.ok) { alert('Erreur'); return; }
        // Clear all active states
        document.querySelectorAll('#coffre-img-grid .coffre-item').forEach(function (c) {
          c.classList.remove('coffre-item--active');
          var sb = c.querySelector('.js-set-avatar');
          if (sb && !sb.classList.contains('js-header-remove-avatar')) {
            sb.innerHTML = '&#9733; Utiliser'; sb.title = 'Définir comme photo de profil';
          }
          // Swap crop→utiliser or utiliser stays
          var actions = c.querySelector('.js-item-normal-actions');
          if (actions) {
            var crop = actions.querySelector('.js-crop-edit');
            if (crop) {
              var util = document.createElement('button');
              util.className = 'coffre-btn coffre-btn--avatar js-set-avatar';
              util.dataset.refId = crop.dataset.refId;
              util.title = 'Définir comme photo de profil';
              util.innerHTML = '&#9733; Utiliser';
              bindSetAvatar(util);
              crop.replaceWith(util);
            }
          }
        });
        // Update header remove button visibility
        var headerBtn = document.getElementById('coffre-header-remove-btn');
        if (!sending) {
          // Activate new card
          if (card) {
            card.classList.add('coffre-item--active');
            var actions = card.querySelector('.js-item-normal-actions');
            if (actions) {
              var util = actions.querySelector('.js-set-avatar');
              if (util) {
                var imgEl = card.querySelector('.coffre-item-img');
                var thumbSrc = imgEl ? imgEl.src : '';
                var cropBtn = document.createElement('button');
                cropBtn.className = 'coffre-btn coffre-btn--crop js-crop-edit';
                cropBtn.dataset.refId = String(refId); cropBtn.dataset.thumb = thumbSrc;
                cropBtn.title = 'Recadrer la zone affichée';
                cropBtn.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 1v8h8"/><path d="M1 4h8v8"/></svg> Recadrer';
                cropBtn.addEventListener('click', function () {
                  if (!thumbSrc) return;
                  cropX = 50; cropY = 50; cropScale = 1; if (cropSlider) cropSlider.value = 100;
                  cropImg.src = thumbSrc; applyCrop(); cropModal.style.display = 'flex'; document.body.style.overflow = 'hidden';
                });
                util.replaceWith(cropBtn);
              }
            }
          }
          // Show header remove btn
          if (!headerBtn) {
            var hdr = document.getElementById('coffre-gutter-actions');
            if (hdr) {
              var nb = document.createElement('button');
              nb.id = 'coffre-header-remove-btn';
              nb.className = 'coffre-btn coffre-btn--default coffre-gutter-btn js-set-avatar js-header-remove-avatar';
              nb.dataset.refId = String(refId);
              nb.title = 'Retirer la photo de profil';
              nb.textContent = 'Par défaut';
              bindSetAvatar(nb);
              hdr.insertBefore(nb, hdr.firstChild);
            }
          } else {
            headerBtn.dataset.refId = String(refId);
          }
        } else {
          // Remove header btn
          if (headerBtn) headerBtn.remove();
        }
      });
    });
  }
  document.querySelectorAll('.js-set-avatar').forEach(bindSetAvatar);

  // ── Mode vente images ─────────────────────────────────────────────────
  var _imgSellMode = false;
  var sellBar     = document.getElementById('coffre-sell-bar');
  var sellBarInfo = document.getElementById('coffre-sell-bar-info');
  var sellBarConfirm = document.getElementById('coffre-sell-bar-confirm');
  var sellBarCancel  = document.getElementById('coffre-sell-bar-cancel');
  var sellToggle     = document.getElementById('coffre-img-sell-toggle');
  var sellGrid       = document.getElementById('coffre-img-grid');

  function getImgSelected() {
    return Array.from(document.querySelectorAll('#coffre-img-grid .coffre-item--sell-sel'));
  }
  function updateImgSellBar() {
    var sel = getImgSelected();
    var total = sel.reduce(function(s, c) { return s + (parseInt(c.dataset.sellPrice, 10) || 1); }, 0);
    if (sellBarInfo) sellBarInfo.innerHTML = '<strong>' + sel.length + '</strong> sélectionné(s) &mdash; <strong>' + total + '</strong>&thinsp;P';
    if (sellBarConfirm) sellBarConfirm.disabled = sel.length === 0;
  }
  function enterImgSellMode() {
    _imgSellMode = true;
    if (sellToggle) sellToggle.classList.add('active');
    if (sellGrid) sellGrid.classList.add('coffre-sell-mode');
    if (sellBar) sellBar.hidden = false;
    updateImgSellBar();
  }
  function exitImgSellMode() {
    _imgSellMode = false;
    document.querySelectorAll('#coffre-img-grid .coffre-item--sell-sel').forEach(function(c) { c.classList.remove('coffre-item--sell-sel'); });
    if (sellToggle) sellToggle.classList.remove('active');
    if (sellGrid) sellGrid.classList.remove('coffre-sell-mode');
    if (sellBar) sellBar.hidden = true;
  }

  sellToggle && sellToggle.addEventListener('click', function() {
    if (_imgSellMode) exitImgSellMode(); else enterImgSellMode();
  });
  sellBarCancel && sellBarCancel.addEventListener('click', exitImgSellMode);

  sellGrid && sellGrid.addEventListener('click', function(e) {
    if (!_imgSellMode) return;
    var card = e.target.closest('.coffre-item--owned');
    if (!card) return;
    // Prevent fav button from triggering sell selection
    if (e.target.closest('.coffre-fav-btn')) return;
    card.classList.toggle('coffre-item--sell-sel');
    updateImgSellBar();
  });

  sellBarConfirm && sellBarConfirm.addEventListener('click', function() {
    var sel = getImgSelected();
    if (!sel.length) return;
    var unlockIds = sel.map(function(c) { return parseInt(c.dataset.unlockId, 10); });
    var hasActive = sel.some(function(c) { return c.classList.contains('coffre-item--active'); });
    if (hasActive && !confirm('Une ou plusieurs images sélectionnées sont votre photo de profil. Continuer ?')) return;
    sellBarConfirm.disabled = true;
    fetch('/favoris/coffre/sell', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ unlockIds: unlockIds }),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (!d.ok) { alert(d.error || 'Erreur'); sellBarConfirm.disabled = false; return; }
      updateCoins(d.newBalance);
      sel.forEach(function(c) { c.style.transition = 'opacity .25s, transform .25s'; c.style.opacity = '0'; c.style.transform = 'scale(.9)'; setTimeout(function() { c.remove(); }, 270); });
      exitImgSellMode();
    }).catch(function() { sellBarConfirm.disabled = false; });
  });

  // ── Recadrage ─────────────────────────────────────────────────────────
  var cropModal = document.getElementById('crop-modal');
  var cropCircle = document.getElementById('crop-preview-circle');
  var cropImg    = document.getElementById('crop-preview-img');
  var cropSlider = document.getElementById('crop-zoom-slider');
  var cropSaveBtn= document.getElementById('crop-save-btn');
  var cropX = 50, cropY = 50, cropScale = 1;
  var cropDragging = false, cropDragSX, cropDragSY, cropDragX0, cropDragY0;
  function applyCrop() { cropImg.style.objectPosition = cropX + '% ' + cropY + '%'; cropImg.style.transform = 'scale(' + cropScale + ')'; cropImg.style.transformOrigin = cropX + '% ' + cropY + '%'; }
  document.querySelectorAll('.js-crop-edit').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var thumb = btn.dataset.thumb; if (!thumb) return;
      cropX = 50; cropY = 50; cropScale = 1; if (cropSlider) cropSlider.value = 100;
      cropImg.src = thumb; applyCrop(); cropModal.style.display = 'flex'; document.body.style.overflow = 'hidden';
    });
  });
  function closeCropModal() { cropModal.style.display = 'none'; document.body.style.overflow = ''; }
  document.querySelectorAll('.js-crop-close').forEach(function(b) { b.addEventListener('click', closeCropModal); });
  cropModal && cropModal.addEventListener('click', function(e) { if (e.target === cropModal) closeCropModal(); });
  cropCircle && cropCircle.addEventListener('mousedown', function(e) { cropDragging = true; cropDragSX = e.clientX; cropDragSY = e.clientY; cropDragX0 = cropX; cropDragY0 = cropY; e.preventDefault(); });
  cropCircle && cropCircle.addEventListener('touchstart', function(e) { if (!e.touches[0]) return; cropDragging = true; cropDragSX = e.touches[0].clientX; cropDragSY = e.touches[0].clientY; cropDragX0 = cropX; cropDragY0 = cropY; }, { passive: true });
  document.addEventListener('mousemove', function(e) { if (!cropDragging || !cropCircle) return; var rect = cropCircle.getBoundingClientRect(); var dx = (e.clientX - cropDragSX) / rect.width * 100 / cropScale; var dy = (e.clientY - cropDragSY) / rect.height * 100 / cropScale; cropX = Math.max(0, Math.min(100, cropDragX0 - dx)); cropY = Math.max(0, Math.min(100, cropDragY0 - dy)); applyCrop(); });
  document.addEventListener('touchmove', function(e) { if (!cropDragging || !e.touches[0] || !cropCircle) return; var rect = cropCircle.getBoundingClientRect(); var dx = (e.touches[0].clientX - cropDragSX) / rect.width * 100 / cropScale; var dy = (e.touches[0].clientY - cropDragSY) / rect.height * 100 / cropScale; cropX = Math.max(0, Math.min(100, cropDragX0 - dx)); cropY = Math.max(0, Math.min(100, cropDragY0 - dy)); applyCrop(); }, { passive: true });
  document.addEventListener('mouseup', function() { cropDragging = false; });
  document.addEventListener('touchend', function() { cropDragging = false; });
  cropCircle && cropCircle.addEventListener('wheel', function(e) { e.preventDefault(); cropScale = Math.max(1, Math.min(4, cropScale - e.deltaY * 0.003)); if (cropSlider) cropSlider.value = Math.round(cropScale * 100); applyCrop(); }, { passive: false });
  cropSlider && cropSlider.addEventListener('input', function() { cropScale = parseInt(cropSlider.value, 10) / 100; applyCrop(); });
  cropSaveBtn && cropSaveBtn.addEventListener('click', function() {
    cropSaveBtn.disabled = true;
    fetch('/favoris/coffre/set-avatar-crop', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ x: Math.round(cropX * 10) / 10, y: Math.round(cropY * 10) / 10, scale: Math.round(cropScale * 100) / 100 }),
    }).then(function(r) { return r.json(); }).then(function(d) { cropSaveBtn.disabled = false; if (d.ok) { closeCropModal(); window.location.reload(); } }).catch(function() { cropSaveBtn.disabled = false; });
  });

  // ── Filtres images (rareté × possession × favoris) ───────────────────
  var _fRarity = 'all', _fPossession = 'all', _fFav = 'all';
  function applyImgFilters() {
    document.querySelectorAll('#coffre-img-grid .coffre-item').forEach(function(card) {
      var ok = (_fRarity === 'all' || card.dataset.rarity === _fRarity) &&
               (_fPossession === 'all' || (_fPossession === 'owned' && card.dataset.owned === '1') || (_fPossession === 'shop' && card.dataset.owned === '0')) &&
               (_fFav === 'all' || card.dataset.fav === '1');
      card.hidden = !ok;
    });
  }
  function bindFilterBar(barId, prop, setter) {
    var bar = document.getElementById(barId); if (!bar) return;
    bar.addEventListener('click', function(e) {
      var btn = e.target.closest('.coffre-filter-btn'); if (!btn) return;
      bar.querySelectorAll('.coffre-filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      setter(btn.dataset[prop]);
      applyImgFilters();
    });
  }
  bindFilterBar('coffre-f-rarity',    'rarity',     function(v) { _fRarity = v; });
  bindFilterBar('coffre-f-possession','possession', function(v) { _fPossession = v; });
  bindFilterBar('coffre-f-fav',       'favf',        function(v) { _fFav = v; });

  // ── Favori images ─────────────────────────────────────────────────────
  document.querySelectorAll('.js-fav-toggle').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      fetch('/favoris/coffre/favorite', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ unlockId: parseInt(btn.dataset.unlockId) }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) return;
        btn.classList.toggle('coffre-fav-btn--active', !!d.isFavorite);
        btn.textContent = d.isFavorite ? '♥' : '♡';
        btn.title = d.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris';
        var card = btn.closest('.coffre-item');
        if (card) card.dataset.fav = d.isFavorite ? '1' : '0';
        applyImgFilters();
      });
    });
  });

  // ── Jokers depuis le coffre ───────────────────────────────────────────
  document.querySelectorAll('.js-use-coffre-joker').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var type = btn.dataset.jokerType;
      if (type === 'charm') { if (window._openJokerCharmPicker) window._openJokerCharmPicker(); }
      else { if (window._openJokerImagePicker) window._openJokerImagePicker(); }
    });
  });
  window._onJokerUsed = function(type) {
    // Remove one joker card of matching type from the DOM
    var card = document.querySelector('.js-use-coffre-joker[data-joker-type="' + type + '"]');
    if (card) {
      var strip = card.closest('.coffre-jokers-strip');
      card.remove();
      if (strip && !strip.querySelector('.coffre-joker-card')) {
        var section = strip.closest('.coffre-jokers-section');
        if (section) section.remove();
      }
    }
  };
})();
</script>

<% } else if (view === 'charms') { %>

<div class="coffre-sell-bar" id="coffre-sell-bar" hidden>
  <span class="coffre-sell-bar-info" id="coffre-sell-bar-info">0 sélectionné(s) &mdash; 0&thinsp;P</span>
  <button class="coffre-sell-bar-cancel" id="coffre-sell-bar-cancel">Annuler</button>
  <button class="coffre-sell-bar-confirm" id="coffre-sell-bar-confirm" disabled>Vendre</button>
