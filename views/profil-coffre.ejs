<%- include('partials/head', { title: 'Coffre' }) %>
<main class="container wide profil-page gallery-has-sidebar">
  <%- include('partials/top-nav', { config: config, navTitle: 'Coffre', navBack: '/favoris' }) %>
  <%- include('partials/profil-nav', { roleHue: roleHue }) %>

  <div class="profil-subpage coffre-page">

    <span id="coffre-coins-value" hidden><%= currentUser.coins %></span>

    <% if (!view) { %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# ── VUE D'ENSEMBLE ── %>
    <%# ════════════════════════════════════════════════════════════════ %>

    <%# ── Section images (aperçu 2 lignes × 4) ── %>
    <section class="coffre-section">
      <div class="coffre-section-header">
        <h2 class="coffre-section-title">Images de profil <span class="coffre-section-count">(<%= unlocks.length %>)</span></h2>
        <a href="/favoris/coffre?view=images" class="coffre-voir-plus">Voir tout &rarr;</a>
      </div>
      <% if (!unlocks.length) { %>
        <p class="coffre-empty">Ouvrez des lootboxes depuis la <a href="/jeu">page Jeu</a> pour débloquer des images.</p>
      <% } else { %>
        <div class="coffre-preview-grid">
          <% unlocks.slice(0, 8).forEach(function(u) { %>
            <div class="coffre-preview-item coffre-preview-item--<%= u.rarity %>"
                 title="<%= u.title || 'Sans titre' %>">
              <% if (u.thumb) { %>
                <img src="<%= thumbUrl(u.thumb) %>" alt="<%= u.title %>" loading="lazy" />
              <% } else { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <% } %>
              <% if (currentUser.profileImageId === u.refId) { %>
                <span class="coffre-preview-active-dot" title="Photo active"></span>
              <% } %>
            </div>
          <% }) %>
          <% if (unlocks.length > 8) { %>
            <a href="/favoris/coffre?view=images" class="coffre-preview-more">+<%= unlocks.length - 8 %></a>
          <% } %>
        </div>
      <% } %>
    </section>

    <%# ── Section charmes (aperçu 1 ligne) ── %>
    <section class="coffre-section">
      <div class="coffre-section-header">
        <h2 class="coffre-section-title">Charmes</h2>
        <a href="/favoris/coffre?view=charms" class="coffre-voir-plus">Voir tout &rarr;</a>
      </div>
      <% var ownedCharms = charms.filter(function(c) { return c.owned; }); %>
      <% if (!ownedCharms.length) { %>
        <p class="coffre-empty">Aucun charme obtenu — ouvrez une lootbox charme pour en débloquer.</p>
      <% } else { %>
        <div class="coffre-charms-strip">
          <% ownedCharms.forEach(function(c) { %>
            <%
              var rarityColor = c.rarity === 'mythic' ? '#f87171' : c.rarity === 'legendary' ? '#fbbf24' : c.rarity === 'epic' ? '#a78bfa' : c.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
              var isActive = currentUser.ratingCharm === c.key;
            %>
            <div class="coffre-charm-pill<%= isActive ? ' coffre-charm-pill--active' : '' %>"
                 style="--charm-color:<%= rarityColor %>"
                 title="<%= c.label %><%= isActive ? ' (actif)' : '' %>">
              <span class="coffre-charm-symbol"><%= c.symbol %></span>
              <span class="coffre-charm-label"><%= c.label %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <%# ── Section thèmes ── %>
    <section class="coffre-section">
      <div class="coffre-section-header">
        <h2 class="coffre-section-title">Th&egrave;mes</h2>
      </div>
      <div class="coffre-themes-grid">
        <% (userThemes || []).forEach(function(t) { %>
          <%
            var themeColors = { rouge:'hsl(355,55%,32%)', vert:'hsl(148,42%,28%)', violet:'hsl(270,58%,32%)', bleu:'hsl(212,65%,32%)', rose:'hsl(330,58%,32%)', blanc:'hsl(0,0%,90%)', default:'hsl(240,6%,20%)' };
            var swatchColor = themeColors[t.key] || '#333';
          %>
          <button type="button"
                  class="coffre-theme-card js-theme-apply<%= t.active ? ' coffre-theme-card--active' : '' %><%= !t.owned ? ' coffre-theme-card--locked' : '' %>"
                  data-theme-key="<%= t.key %>"
                  <%= !t.owned ? 'disabled' : '' %>
                  title="<%= t.label %><%= t.active ? ' (actif)' : '' %><%= !t.owned ? ' (verrouillé)' : '' %>">
            <span class="coffre-theme-swatch" style="background:<%= swatchColor %>"></span>
            <span class="coffre-theme-name"><%= t.label %></span>
            <% if (t.active) { %><span class="coffre-theme-active-dot"></span><% } %>
            <% if (!t.owned && !t.always) { %><span class="coffre-theme-lock">&#128274;</span><% } %>
          </button>
        <% }); %>
      </div>
    </section>

    <% } else if (view === 'images') { %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# ── VUE IMAGES COMPLÈTE ── %>
    <%# ════════════════════════════════════════════════════════════════ %>

    <div class="coffre-view-wrap">
    <div class="coffre-view-main">
    <% if (userJokers && userJokers.length) { %>
    <section class="coffre-section coffre-jokers-section">
      <p class="coffre-jokers-label">&#9824; Jokers disponibles</p>
      <div class="coffre-jokers-strip">
        <% userJokers.forEach(function(j) { %>
        <button class="coffre-joker-card js-use-coffre-joker"
                data-joker-type="<%= j.type %>"
                data-joker-unlock-id="<%= j.id %>">
          <span class="coffre-joker-card-icon">&#9824;</span>
          <span class="coffre-joker-card-label"><%= j.type === 'charm' ? 'Joker Charme' : 'Joker Image' %></span>
        </button>
        <% }) %>
      </div>
    </section>
    <% } %>
    <section class="coffre-section">
      <div class="coffre-grid" id="coffre-img-grid">
        <% unlocks.forEach(function(u) { %>
          <div class="coffre-item coffre-item--owned<%= currentUser.profileImageId === u.refId ? ' coffre-item--active' : '' %>"
               data-unlock-id="<%= u.id %>"
               data-ref-id="<%= u.refId %>"
               data-rarity="<%= u.rarity %>"
               data-owned="1"
               data-fav="<%= u.isFavorite ? '1' : '0' %>"
               data-sell-price="<%= RARITY_SELL_PRICE[u.rarity] || 1 %>">
            <div class="coffre-item-img-wrap">
              <% if (u.thumb) { %>
                <img src="<%= thumbUrl(u.thumb) %>" alt="<%= u.title %>" class="coffre-item-img" loading="lazy" />
              <% } else { %>
                <div class="coffre-item-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              <% } %>
              <div class="coffre-item-rarity coffre-item-rarity--<%= u.rarity %>"><%= { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[u.rarity] || u.rarity %></div>
              <button class="coffre-fav-btn js-fav-toggle<%= u.isFavorite ? ' coffre-fav-btn--active' : '' %>"
                      data-unlock-id="<%= u.id %>"
                      title="<%= u.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                      aria-label="<%= u.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>">
                <%= u.isFavorite ? '♥' : '♡' %>
              </button>
            </div>
            <p class="coffre-item-title"><%= u.title || 'Sans titre' %></p>
            <div class="coffre-item-actions js-item-normal-actions">
              <% if (currentUser.profileImageId !== u.refId) { %>
                <button class="coffre-btn coffre-btn--avatar js-set-avatar"
                        data-ref-id="<%= u.refId %>"
                        title="Définir comme photo de profil">
                  &#9733; Utiliser
                </button>
              <% } else { %>
                <button class="coffre-btn coffre-btn--crop js-crop-edit"
                        data-ref-id="<%= u.refId %>"
                        data-thumb="<%= u.thumb ? thumbUrl(u.thumb) : '' %>"
                        title="Recadrer la zone affichée">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 1v8h8"/><path d="M1 4h8v8"/></svg>
                  Recadrer
                </button>
              <% } %>
            </div>
          </div>
        <% }) %>
        <% shopItems.forEach(function(item) { %>
          <div class="coffre-item coffre-item--locked"
               data-ref-id="<%= item.id %>"
               data-rarity="<%= item.rarity %>"
               data-owned="0"
               data-fav="0"
               data-buy-price="<%= item.buyPrice %>">
            <div class="coffre-item-img-wrap">
              <% if (item.thumb) { %>
                <img src="<%= thumbUrl(item.thumb) %>" alt="<%= item.title %>" class="coffre-item-img coffre-item-img--blurred" loading="lazy" />
              <% } else { %>
                <div class="coffre-item-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
              <% } %>
              <div class="coffre-item-lock-overlay">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              </div>
              <div class="coffre-item-rarity coffre-item-rarity--<%= item.rarity %>"><%= { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[item.rarity] || item.rarity %></div>
            </div>
            <p class="coffre-item-title coffre-item-title--muted"><%= item.title || 'Sans titre' %></p>
            <p class="coffre-item-shop-hint">revente&nbsp;<%= RARITY_SELL_PRICE.common %>&ndash;<%= RARITY_SELL_PRICE.mythic %>&thinsp;P</p>
            <button class="coffre-btn coffre-btn--buy js-buy"
                    data-ref-id="<%= item.id %>"
                    data-price="<%= item.buyPrice %>">
              Acheter &bull; <%= item.buyPrice %>&thinsp;P
            </button>
          </div>
        <% }) %>
      </div>
    </section>
    </div><%# /coffre-view-main %>
    <div class="coffre-gutter-slot"><div class="coffre-gutter-panel">
      <div id="coffre-gutter-actions">
        <% if (currentUser.profileImageId) { %>
          <button class="coffre-btn coffre-btn--default coffre-gutter-btn js-set-avatar js-header-remove-avatar"
                  id="coffre-header-remove-btn"
                  data-ref-id="<%= currentUser.profileImageId %>"
                  title="Retirer la photo de profil">Par d&eacute;faut</button>
        <% } %>
      </div>
      <% if (currentUser.profileImageId || unlocks.length) { %><div class="coffre-gutter-divider"></div><% } %>
      <div class="coffre-filter-bar coffre-filter-bar--vert" id="coffre-f-rarity">
        <button class="coffre-filter-btn active" data-rarity="all">Tout</button>
        <button class="coffre-filter-btn" data-rarity="common">Commun</button>
        <button class="coffre-filter-btn" data-rarity="rare">Rare</button>
        <button class="coffre-filter-btn" data-rarity="epic">&Eacute;pique</button>
        <button class="coffre-filter-btn" data-rarity="legendary">L&eacute;g.</button>
        <button class="coffre-filter-btn" data-rarity="mythic">Mythique</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <div class="coffre-filter-bar coffre-filter-bar--vert coffre-filter-bar--sm" id="coffre-f-possession">
        <button class="coffre-filter-btn active" data-possession="all">Tout</button>
        <button class="coffre-filter-btn" data-possession="owned">Obtenues</button>
        <button class="coffre-filter-btn" data-possession="shop">&Agrave; d&eacute;bloquer</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <div class="coffre-filter-bar coffre-filter-bar--vert coffre-filter-bar--sm" id="coffre-f-fav">
        <button class="coffre-filter-btn active" data-favf="all">Tout</button>
        <button class="coffre-filter-btn" data-favf="yes">&#9829; Favoris</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <button class="coffre-sell-mode-btn" id="coffre-img-sell-toggle">Vendre</button>
    </div></div><%# /coffre-gutter-slot %>
    </div><%# /coffre-view-wrap %>

    <% } else if (view === 'charms') { %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# ── VUE CHARMES COMPLÈTE ── %>
    <%# ════════════════════════════════════════════════════════════════ %>

    <%
      var _ownedCharms  = charms.filter(function(c){ return c.owned; });
      var _lockedCharms = charms.filter(function(c){ return !c.owned; });
    %>

    <div class="coffre-view-wrap">
    <div class="coffre-view-main">
    <% if (_ownedCharms.length) { %>
    <section class="coffre-section">
      <div class="coffre-charms-grid">
        <% _ownedCharms.forEach(function(c) { %>
          <%
            var rarityColor = c.rarity === 'mythic' ? '#f87171' : c.rarity === 'legendary' ? '#fbbf24' : c.rarity === 'epic' ? '#a78bfa' : c.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
            var rarityLabel = { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[c.rarity] || c.rarity;
            var isActive = currentUser.ratingCharm === c.key;
          %>
          <div class="coffre-charm-card coffre-charm-card--owned<%= isActive ? ' coffre-charm-card--active' : '' %>"
               data-rarity="<%= c.rarity %>"
               data-owned="1"
               data-fav="<%= c.isFavorite ? '1' : '0' %>"
               data-unlock-id="<%= c.unlockId %>"
               data-sell-price="<%= RARITY_SELL_PRICE[c.rarity] || 1 %>"
               style="--charm-color:<%= rarityColor %>">
            <div class="coffre-charm-card-symbols">
              <span class="coffre-charm-card-sym coffre-charm-card-sym--filled"><%= c.symbol %></span>
              <% if (c.symbol_empty) { %><span class="coffre-charm-card-sym coffre-charm-card-sym--empty"><%= c.symbol_empty %></span><% } %>
            </div>
            <strong class="coffre-charm-card-label"><%= c.label %></strong>
            <span class="coffre-charm-card-rarity" style="color:<%= rarityColor %>"><%= rarityLabel %></span>
            <% if (isActive) { %>
              <button class="coffre-btn coffre-charm-btn coffre-charm-btn--active js-charm-equip" data-charm-key="star">Retirer</button>
            <% } else { %>
              <button class="coffre-btn coffre-charm-btn js-charm-equip" data-charm-key="<%= c.key %>">&Eacute;quiper</button>
            <% } %>
            <% if (c.unlockId) { %>
              <button class="coffre-fav-btn js-charm-fav<%= c.isFavorite ? ' coffre-fav-btn--active' : '' %>"
                      data-unlock-id="<%= c.unlockId %>"
                      title="<%= c.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
                      style="position:static;width:auto;height:auto;border-radius:20px;padding:.2rem .55rem;font-size:.78rem;display:inline-flex;align-items:center">
                <%= c.isFavorite ? '♥' : '♡' %>
              </button>
            <% } %>
          </div>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (_lockedCharms.length) { %>
    <section class="coffre-section coffre-section--locked-group">
      <p class="coffre-locked-group-label">&Agrave; d&eacute;bloquer</p>
      <div class="coffre-charms-grid">
        <% _lockedCharms.forEach(function(c) { %>
          <%
            var rarityColor = c.rarity === 'mythic' ? '#f87171' : c.rarity === 'legendary' ? '#fbbf24' : c.rarity === 'epic' ? '#a78bfa' : c.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
            var rarityLabel = { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[c.rarity] || c.rarity;
          %>
          <div class="coffre-charm-card coffre-charm-card--locked"
               data-rarity="<%= c.rarity %>"
               data-owned="0"
               style="--charm-color:<%= rarityColor %>">
            <div class="coffre-charm-card-symbols">
              <span class="coffre-charm-card-sym coffre-charm-card-sym--filled"><%= c.symbol %></span>
              <% if (c.symbol_empty) { %><span class="coffre-charm-card-sym coffre-charm-card-sym--empty"><%= c.symbol_empty %></span><% } %>
            </div>
            <strong class="coffre-charm-card-label"><%= c.label %></strong>
            <span class="coffre-charm-card-rarity" style="color:<%= rarityColor %>"><%= rarityLabel %></span>
            <button class="coffre-btn coffre-charm-btn coffre-charm-btn--buy js-buy-charm"
                    data-charm-id="<%= c.id %>"
                    data-price="<%= CHARM_BUY_PRICE[c.rarity] || 100 %>">
              Acheter &bull; <%= CHARM_BUY_PRICE[c.rarity] || 100 %>&thinsp;P
            </button>
          </div>
        <% }) %>
      </div>
    </section>
    <% } %>
    </div><%# /coffre-view-main %>
    <div class="coffre-gutter-slot"><div class="coffre-gutter-panel">
      <div class="coffre-gutter-actions" id="coffre-cf-actions">
        <button class="coffre-btn coffre-btn--default coffre-gutter-btn" id="coffre-cf-default-btn">Par d&eacute;faut</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <div class="coffre-filter-bar coffre-filter-bar--vert" id="coffre-cf-rarity">
        <button class="coffre-filter-btn active" data-rarity="all">Tout</button>
        <button class="coffre-filter-btn" data-rarity="common">Commun</button>
        <button class="coffre-filter-btn" data-rarity="rare">Rare</button>
        <button class="coffre-filter-btn" data-rarity="epic">&Eacute;pique</button>
        <button class="coffre-filter-btn" data-rarity="legendary">L&eacute;g.</button>
        <button class="coffre-filter-btn" data-rarity="mythic">Mythique</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <div class="coffre-filter-bar coffre-filter-bar--vert coffre-filter-bar--sm" id="coffre-cf-owned">
        <button class="coffre-filter-btn active" data-owned="all">Tout</button>
        <button class="coffre-filter-btn" data-owned="owned">Obtenu</button>
        <button class="coffre-filter-btn" data-owned="locked">&Agrave; d&eacute;bloquer</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <div class="coffre-filter-bar coffre-filter-bar--vert coffre-filter-bar--sm" id="coffre-cf-fav">
        <button class="coffre-filter-btn active" data-favf="all">Tout</button>
        <button class="coffre-filter-btn" data-favf="yes">&#9829; Favoris</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <button class="coffre-sell-mode-btn" id="coffre-charm-sell-toggle">Vendre</button>
    </div></div><%# /coffre-gutter-slot %>
    </div><%# /coffre-view-wrap %>

    <% } else if (view === 'themes') { %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# ── VUE THÈMES ── %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%
      var _ownedThemes  = (userThemes || []).filter(function(t){ return t.owned; });
      var _lockedThemes = (userThemes || []).filter(function(t){ return !t.owned && !t.always; });
      var _themeColors  = { rouge:'hsl(355,55%,32%)', vert:'hsl(148,42%,28%)', violet:'hsl(270,58%,32%)', bleu:'hsl(212,65%,32%)', rose:'hsl(330,58%,32%)', blanc:'hsl(0,0%,90%)', default:'hsl(240,6%,20%)' };
    %>

    <div class="coffre-view-wrap">
    <div class="coffre-view-main">
    <section class="coffre-section">
      <div class="coffre-themes-full">
        <% _ownedThemes.forEach(function(t) { %>
          <%
            var swatchColor = _themeColors[t.key] || '#333';
            var rarityColor = !t.always && t.rarity ? (t.rarity === 'mythic' ? '#f87171' : t.rarity === 'legendary' ? '#fbbf24' : t.rarity === 'epic' ? '#a78bfa' : t.rarity === 'rare' ? '#60a5fa' : '#94a3b8') : '#475569';
            var rarityLabel = t.always ? 'Toujours disponible' : ({ common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[t.rarity] || '—');
          %>
          <div class="coffre-theme-card coffre-theme-card--full<%= t.active ? ' coffre-theme-card--active' : '' %>"
               data-theme-key="<%= t.key %>"
               data-rarity="<%= t.rarity || '' %>"
               data-owned="1"
               data-always="<%= t.always ? '1' : '0' %>"
               data-sell-price="<%= t.always ? 0 : (RARITY_SELL_PRICE[t.rarity] || 1) %>">
            <button type="button" class="coffre-theme-apply-btn js-theme-apply"
                    data-theme-key="<%= t.key %>"
                    title="<%= t.label %>">
              <span class="coffre-theme-swatch coffre-theme-swatch--lg" style="background:<%= swatchColor %>"></span>
              <div class="coffre-theme-info">
                <span class="coffre-theme-name"><%= t.label %></span>
                <span class="coffre-theme-rarity-label" style="color:<%= rarityColor %>"><%= rarityLabel %></span>
              </div>
              <% if (t.active) { %><span class="coffre-theme-active-dot" title="Actif"></span><% } %>
            </button>
          </div>
        <% }); %>
      </div>
    </section>

    <% if (_lockedThemes.length) { %>
    <section class="coffre-section coffre-section--locked-group">
      <p class="coffre-locked-group-label">&Agrave; d&eacute;bloquer</p>
      <div class="coffre-themes-full">
        <% _lockedThemes.forEach(function(t) { %>
          <%
            var swatchColor = _themeColors[t.key] || '#333';
            var rarityColor = t.rarity ? (t.rarity === 'mythic' ? '#f87171' : t.rarity === 'legendary' ? '#fbbf24' : t.rarity === 'epic' ? '#a78bfa' : t.rarity === 'rare' ? '#60a5fa' : '#94a3b8') : '#94a3b8';
            var rarityLabel = { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[t.rarity] || '—';
            var themePrice = THEME_BUY_PRICE[t.rarity] || 100;
          %>
          <div class="coffre-theme-card coffre-theme-card--full coffre-theme-card--locked"
               data-rarity="<%= t.rarity || '' %>"
               data-owned="0">
            <span class="coffre-theme-swatch coffre-theme-swatch--lg" style="background:<%= swatchColor %>"></span>
            <div class="coffre-theme-info">
              <span class="coffre-theme-name"><%= t.label %></span>
              <span class="coffre-theme-rarity-label" style="color:<%= rarityColor %>"><%= rarityLabel %></span>
              <button class="coffre-btn coffre-btn--buy js-buy-theme"
                      data-theme-key="<%= t.key %>"
                      data-price="<%= themePrice %>"
                      style="margin-top:.35rem;font-size:.72rem;padding:.25rem .6rem">
                Acheter &bull; <%= themePrice %>&thinsp;P
              </button>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
    <% } %>
    </div><%# /coffre-view-main %>
    <div class="coffre-gutter-slot"><div class="coffre-gutter-panel">
      <div class="coffre-gutter-actions" id="coffre-tf-actions">
        <button class="coffre-btn coffre-btn--default coffre-gutter-btn" id="coffre-tf-default-btn">Par d&eacute;faut</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <div class="coffre-filter-bar coffre-filter-bar--vert" id="coffre-tf-rarity">
        <button class="coffre-filter-btn active" data-rarity="all">Tout</button>
        <button class="coffre-filter-btn" data-rarity="common">Commun</button>
        <button class="coffre-filter-btn" data-rarity="rare">Rare</button>
        <button class="coffre-filter-btn" data-rarity="epic">&Eacute;pique</button>
        <button class="coffre-filter-btn" data-rarity="legendary">L&eacute;g.</button>
        <button class="coffre-filter-btn" data-rarity="mythic">Mythique</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <div class="coffre-filter-bar coffre-filter-bar--vert coffre-filter-bar--sm" id="coffre-tf-owned">
        <button class="coffre-filter-btn active" data-owned="all">Tout</button>
        <button class="coffre-filter-btn" data-owned="owned">Obtenu</button>
        <button class="coffre-filter-btn" data-owned="locked">&Agrave; d&eacute;bloquer</button>
      </div>
      <div class="coffre-gutter-divider"></div>
      <button class="coffre-sell-mode-btn" id="coffre-theme-sell-toggle">Vendre</button>
