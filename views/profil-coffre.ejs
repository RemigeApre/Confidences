<%- include('partials/foot') %>

<script>
(function() {
  var coinsEl = document.getElementById('coffre-coins-value');

  // ── Équiper charme ────────────────────────────────────────────────────
  document.querySelectorAll('.js-charm-equip').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var key = btn.dataset.charmKey;
      fetch('/lootbox/set-charm', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ charmKey: key }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) window.location.reload();
        else alert(d.error || 'Erreur');
      });
    });
  });

  // ── Filtres charmes (rareté × obtenu/à débloquer × favoris) ─────────
  var _cfRarity = 'all', _cfOwned = 'all', _cfFav = 'all';
  function applyCharmFilters() {
    document.querySelectorAll('.coffre-charm-card').forEach(function(card) {
      var ok = (_cfRarity === 'all' || card.dataset.rarity === _cfRarity) &&
               (_cfOwned === 'all' || (_cfOwned === 'owned' && card.dataset.owned === '1') || (_cfOwned === 'locked' && card.dataset.owned === '0')) &&
               (_cfFav === 'all' || card.dataset.fav === '1');
      card.hidden = !ok;
    });
  }
  function bindCharmFilterBar(barId, prop, setter) {
    var bar = document.getElementById(barId); if (!bar) return;
    bar.addEventListener('click', function(e) {
      var btn = e.target.closest('.coffre-filter-btn'); if (!btn) return;
      bar.querySelectorAll('.coffre-filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      setter(btn.dataset[prop]);
      applyCharmFilters();
    });
  }
  bindCharmFilterBar('coffre-cf-rarity', 'rarity',    function(v) { _cfRarity = v; });
  bindCharmFilterBar('coffre-cf-owned',  'owned',     function(v) { _cfOwned  = v; });
  bindCharmFilterBar('coffre-cf-fav',    'favf',      function(v) { _cfFav    = v; });

  // ── Favori charmes ────────────────────────────────────────────────────
  document.querySelectorAll('.js-charm-fav').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      fetch('/favoris/coffre/favorite', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ unlockId: parseInt(btn.dataset.unlockId) }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) return;
        btn.classList.toggle('coffre-fav-btn--active', !!d.isFavorite);
        btn.textContent = d.isFavorite ? '♥' : '♡';
        btn.title = d.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris';
        var card = btn.closest('.coffre-charm-card');
        if (card) { card.dataset.fav = d.isFavorite ? '1' : '0'; applyCharmFilters(); }
      });
    });
  });

  // ── Charme par défaut ────────────────────────────────────────────────
  var cfDefaultBtn = document.getElementById('coffre-cf-default-btn');
  cfDefaultBtn && cfDefaultBtn.addEventListener('click', function() {
    fetch('/lootbox/set-charm', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ charmKey: 'star' }),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) window.location.reload();
    });
  });

  // ── Mode vente charmes ────────────────────────────────────────────────
  var _charmSellMode = false;
  var cSellBar     = document.getElementById('coffre-sell-bar');
  var cSellBarInfo = document.getElementById('coffre-sell-bar-info');
  var cSellBarConfirm = document.getElementById('coffre-sell-bar-confirm');
  var cSellBarCancel  = document.getElementById('coffre-sell-bar-cancel');
  var cSellToggle     = document.getElementById('coffre-charm-sell-toggle');
  var cCharmGrid      = document.querySelector('.coffre-charms-grid');

  function getCharmSelected() {
    return Array.from(document.querySelectorAll('.coffre-charm-card--sell-sel'));
  }
  function updateCharmSellBar() {
    var sel = getCharmSelected();
    var total = sel.reduce(function(s, c) { return s + (parseInt(c.dataset.sellPrice, 10) || 1); }, 0);
    if (cSellBarInfo) cSellBarInfo.innerHTML = '<strong>' + sel.length + '</strong> sélectionné(s) &mdash; <strong>' + total + '</strong>&thinsp;P';
    if (cSellBarConfirm) cSellBarConfirm.disabled = sel.length === 0;
  }
  function enterCharmSellMode() {
    _charmSellMode = true;
    if (cSellToggle) cSellToggle.classList.add('active');
    document.querySelector('.coffre-charms-grid') && document.querySelectorAll('.coffre-charms-grid').forEach(function(g) { g.classList.add('coffre-sell-mode'); });
    if (cSellBar) cSellBar.hidden = false;
    updateCharmSellBar();
  }
  function exitCharmSellMode() {
    _charmSellMode = false;
    document.querySelectorAll('.coffre-charm-card--sell-sel').forEach(function(c) { c.classList.remove('coffre-charm-card--sell-sel'); });
    if (cSellToggle) cSellToggle.classList.remove('active');
    document.querySelectorAll('.coffre-charms-grid').forEach(function(g) { g.classList.remove('coffre-sell-mode'); });
    if (cSellBar) cSellBar.hidden = true;
  }

  cSellToggle && cSellToggle.addEventListener('click', function() {
    if (_charmSellMode) exitCharmSellMode(); else enterCharmSellMode();
  });
  cSellBarCancel && cSellBarCancel.addEventListener('click', exitCharmSellMode);

  document.querySelectorAll('.coffre-charms-grid').forEach(function(grid) {
    grid.addEventListener('click', function(e) {
      if (!_charmSellMode) return;
      var card = e.target.closest('.coffre-charm-card--owned');
      if (!card || !card.dataset.unlockId || card.querySelector('.coffre-charm-card-sym')?.textContent === '\u2605') return;
      // Ne pas sélectionner l'étoile par défaut (star charm sans unlockId)
      if (!card.dataset.unlockId) return;
      // Éviter clics sur les boutons internes (équiper, favori)
      if (e.target.closest('button')) return;
      card.classList.toggle('coffre-charm-card--sell-sel');
      updateCharmSellBar();
    });
  });

  cSellBarConfirm && cSellBarConfirm.addEventListener('click', function() {
    var sel = getCharmSelected();
    if (!sel.length) return;
    var unlockIds = sel.map(function(c) { return parseInt(c.dataset.unlockId, 10); });
    var hasActive = sel.some(function(c) { return c.classList.contains('coffre-charm-card--active'); });
    if (hasActive && !confirm('Un charme sélectionné est actuellement équipé. Continuer ?')) return;
    cSellBarConfirm.disabled = true;
    fetch('/favoris/coffre/sell-charm', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ unlockIds: unlockIds }),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (!d.ok) { alert(d.error || 'Erreur'); cSellBarConfirm.disabled = false; return; }
      if (coinsEl) coinsEl.textContent = d.newBalance;
      sel.forEach(function(c) { c.style.transition = 'opacity .25s, transform .25s'; c.style.opacity = '0'; c.style.transform = 'scale(.9)'; setTimeout(function() { c.remove(); }, 270); });
      exitCharmSellMode();
    }).catch(function() { cSellBarConfirm.disabled = false; });
  });

  // ── Achat charme ──────────────────────────────────────────────────────
  document.querySelectorAll('.js-buy-charm').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var price = btn.dataset.price;
      var balance = parseInt(coinsEl ? coinsEl.textContent : '0', 10);
      if (balance < parseInt(price, 10)) {
        alert('Pas assez de pièces (il vous en faut ' + price + ', vous en avez ' + balance + ').');
        return;
      }
      if (!confirm('Acheter ce charme pour ' + price + ' pièce(s) ?')) return;
      btn.disabled = true;
      fetch('/favoris/coffre/buy-charm', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ charmId: parseInt(btn.dataset.charmId) }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) { alert(d.error || 'Erreur'); btn.disabled = false; return; }
        if (coinsEl) coinsEl.textContent = d.newBalance;
        window.location.reload();
      }).catch(function() { btn.disabled = false; });
    });
  });

  // ── Achat thème ───────────────────────────────────────────────────────
  document.querySelectorAll('.js-buy-theme').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var price = btn.dataset.price;
      var balance = parseInt(coinsEl ? coinsEl.textContent : '0', 10);
      if (balance < parseInt(price, 10)) {
        alert('Pas assez de pièces (il vous en faut ' + price + ', vous en avez ' + balance + ').');
        return;
      }
      if (!confirm('Acheter ce thème pour ' + price + ' pièce(s) ?')) return;
      btn.disabled = true;
      fetch('/favoris/coffre/buy-theme', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ themeKey: btn.dataset.themeKey }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) { alert(d.error || 'Erreur'); btn.disabled = false; return; }
        if (coinsEl) coinsEl.textContent = d.newBalance;
        window.location.reload();
      }).catch(function() { btn.disabled = false; });
    });
  });

})();
</script>

<% } else { %>

<div class="coffre-sell-bar" id="coffre-sell-bar" hidden>
  <span class="coffre-sell-bar-info" id="coffre-sell-bar-info">0 sélectionné(s) &mdash; 0&thinsp;P</span>
  <button class="coffre-sell-bar-cancel" id="coffre-sell-bar-cancel">Annuler</button>
  <button class="coffre-sell-bar-confirm" id="coffre-sell-bar-confirm" disabled>Vendre</button>
</div>
</main>
<%- include('partials/foot') %>
<% } %>

<%# ── Thèmes : handler universel (overview + vue thèmes) ── %>
<% if (!view || view === 'themes') { %>
<script>
(function() {
  document.querySelectorAll('.js-theme-apply').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var key = btn.dataset.themeKey;
      fetch('/favoris/coffre/set-theme', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ themeKey: key }),
      })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.ok) return;
          document.querySelectorAll('.coffre-theme-card--active').forEach(function(c) { c.classList.remove('coffre-theme-card--active'); });
          // Card is either the button itself (overview) or its closest .coffre-theme-card wrapper (themes view)
          var card = btn.classList.contains('coffre-theme-card') ? btn : btn.closest('.coffre-theme-card');
          if (card) card.classList.add('coffre-theme-card--active');
          if (key === 'default') document.documentElement.removeAttribute('data-theme');
          else document.documentElement.setAttribute('data-theme', key);
        });
    });
  });

  // ── Filtres thèmes (rareté × obtenu/à débloquer) ──────────────────
  var _tfRarity = 'all', _tfOwned = 'all';
  function applyThemeFilters() {
    document.querySelectorAll('.coffre-theme-card--full').forEach(function(card) {
      var ok = (_tfRarity === 'all' || card.dataset.rarity === _tfRarity) &&
               (_tfOwned === 'all' || (_tfOwned === 'owned' && card.dataset.owned === '1') || (_tfOwned === 'locked' && card.dataset.owned === '0'));
      card.hidden = !ok;
    });
  }
  function bindThemeFilterBar(barId, prop, setter) {
    var bar = document.getElementById(barId); if (!bar) return;
    bar.addEventListener('click', function(e) {
      var btn = e.target.closest('.coffre-filter-btn'); if (!btn) return;
      bar.querySelectorAll('.coffre-filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      setter(btn.dataset[prop]);
      applyThemeFilters();
    });
  }
  bindThemeFilterBar('coffre-tf-rarity', 'rarity', function(v) { _tfRarity = v; });
  bindThemeFilterBar('coffre-tf-owned',  'owned',  function(v) { _tfOwned  = v; });

  // ── Thème par défaut ──────────────────────────────────────────────────
  var tfDefaultBtn = document.getElementById('coffre-tf-default-btn');
  tfDefaultBtn && tfDefaultBtn.addEventListener('click', function() {
    fetch('/favoris/coffre/set-theme', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ themeKey: 'default' }),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) window.location.reload();
    });
  });

  // ── Mode vente thèmes ─────────────────────────────────────────────────
  var _themeSellMode = false;
  var tSellBar     = document.getElementById('coffre-sell-bar');
  var tSellBarInfo = document.getElementById('coffre-sell-bar-info');
  var tSellBarConfirm = document.getElementById('coffre-sell-bar-confirm');
  var tSellBarCancel  = document.getElementById('coffre-sell-bar-cancel');
  var tSellToggle     = document.getElementById('coffre-theme-sell-toggle');
  var tThemeFull      = document.querySelector('.coffre-themes-full');

  function getThemeSelected() {
    return Array.from(document.querySelectorAll('.coffre-theme-card--sell-sel'));
  }
  function updateThemeSellBar() {
    var sel = getThemeSelected();
    var total = sel.reduce(function(s, c) { return s + (parseInt(c.dataset.sellPrice, 10) || 1); }, 0);
    if (tSellBarInfo) tSellBarInfo.innerHTML = '<strong>' + sel.length + '</strong> sélectionné(s) &mdash; <strong>' + total + '</strong>&thinsp;P';
    if (tSellBarConfirm) tSellBarConfirm.disabled = sel.length === 0;
  }
  function enterThemeSellMode() {
    _themeSellMode = true;
    if (tSellToggle) tSellToggle.classList.add('active');
    document.querySelectorAll('.coffre-themes-full').forEach(function(g) { g.classList.add('coffre-sell-mode'); });
    if (tSellBar) tSellBar.hidden = false;
    updateThemeSellBar();
  }
  function exitThemeSellMode() {
    _themeSellMode = false;
    document.querySelectorAll('.coffre-theme-card--sell-sel').forEach(function(c) { c.classList.remove('coffre-theme-card--sell-sel'); });
    if (tSellToggle) tSellToggle.classList.remove('active');
    document.querySelectorAll('.coffre-themes-full').forEach(function(g) { g.classList.remove('coffre-sell-mode'); });
    if (tSellBar) tSellBar.hidden = true;
  }

  tSellToggle && tSellToggle.addEventListener('click', function() {
    if (_themeSellMode) exitThemeSellMode(); else enterThemeSellMode();
  });
  tSellBarCancel && tSellBarCancel.addEventListener('click', exitThemeSellMode);

  document.querySelectorAll('.coffre-themes-full').forEach(function(grid) {
    grid.addEventListener('click', function(e) {
      if (!_themeSellMode) return;
      var card = e.target.closest('.coffre-theme-card--full[data-owned="1"]');
      if (!card || card.dataset.always === '1') return;
      if (e.target.closest('button')) return;
      card.classList.toggle('coffre-theme-card--sell-sel');
      updateThemeSellBar();
    });
  });

  tSellBarConfirm && tSellBarConfirm.addEventListener('click', function() {
    var sel = getThemeSelected();
    if (!sel.length) return;
    var themeKeys = sel.map(function(c) { return c.dataset.themeKey; });
    var hasActive = sel.some(function(c) { return c.classList.contains('coffre-theme-card--active'); });
    if (hasActive && !confirm('Un thème sélectionné est actuellement actif. Continuer ?')) return;
    tSellBarConfirm.disabled = true;
    fetch('/favoris/coffre/sell-theme', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ themeKeys: themeKeys }),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (!d.ok) { alert(d.error || 'Erreur'); tSellBarConfirm.disabled = false; return; }
      var coinsEl = document.getElementById('coffre-coins-value');
      if (coinsEl) coinsEl.textContent = d.newBalance;
      if (hasActive) document.documentElement.removeAttribute('data-theme');
      sel.forEach(function(c) { c.style.transition = 'opacity .25s, transform .25s'; c.style.opacity = '0'; c.style.transform = 'scale(.9)'; setTimeout(function() { c.remove(); }, 270); });
      exitThemeSellMode();
    }).catch(function() { tSellBarConfirm.disabled = false; });
  });
})();
</script>

<% } %>
