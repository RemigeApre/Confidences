<%- include('partials/head', { title: 'Quizz' }) %>
<main class="container wide wiki-locked" style="--ch-hue: 260">
  <%- include('partials/top-nav', { config: config, navTitle: 'Quizz', navBack: '/' }) %>

  <%- include('partials/mobile-filter-toggle') %>

  <%# ─── SIDEBAR GAUCHE ────────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer">&times;</button>

    <div class="wiki-chapter-hero">
      <div class="wiki-chapter-hero-top">
        <span class="wiki-chapter-hero-back"></span>
        <h1 class="wiki-chapter-hero-title">Quizz</h1>
      </div>
    </div>

    <div class="wiki-sidebar-body">
      <%# Filtres à venir %>
    </div>
  </aside>

  <%# ─── CONTENU PRINCIPAL ─────────────────────────────────────────────── %>
  <div class="quiz-hub">

    <%
      /* Helper EJS pour rendre une strip de cartes */
      function quizStrip(title, list) {
        if (!list.length) return '';
        var out = '<section class="quiz-hub-strip">';
        out += '<h2 class="quiz-hub-strip-title">' + title + '</h2>';
        out += '<div class="quiz-hub-cards">';
        list.forEach(function(q) {
          var prog = progressMap[q.id];
          var pct  = prog ? prog.pct : 0;
          var done = completedIds.has(q.id);
          out += '<button type="button" class="qhc' + (done ? ' qhc--done' : '') + '"'
              + ' data-qid="' + q.id + '"'
              + ' data-title="' + q.title.replace(/"/g, '&quot;') + '"'
              + ' data-desc="' + (q.description || '').replace(/"/g, '&quot;') + '"'
              + ' data-questions="' + q.question_count + '"'
              + ' data-parts="' + q.parts_count + '"'
              + ' data-duration="' + (q.duration || '') + '"'
              + ' data-pct="' + pct + '"'
              + ' data-done="' + (done ? '1' : '0') + '"'
              + ' data-completed-at="' + (prog && prog.completedAt ? prog.completedAt : '') + '"'
              + '>';
          // SVG placeholder header
          out += '<div class="qhc-img">';
          out += '<svg viewBox="0 0 200 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="xMidYMid slice" class="qhc-svg">';
          out += '<defs><radialGradient id="qg' + q.id + '" cx="50%" cy="50%" r="65%">';
          out += '<stop offset="0%" stop-color="hsl(260,42%,26%)"/>';
          out += '<stop offset="100%" stop-color="hsl(260,32%,11%)"/>';
          out += '</radialGradient></defs>';
          out += '<rect width="200" height="110" fill="url(#qg' + q.id + ')"/>';
          out += '<circle cx="100" cy="55" r="34" fill="none" stroke="hsl(270,58%,60%)" stroke-width="1.4" opacity="0.45"/>';
          out += '<circle cx="100" cy="55" r="18" fill="hsl(265,52%,34%)" opacity="0.35"/>';
          out += '<polygon points="100,30 122,68 78,68" fill="none" stroke="hsl(280,62%,66%)" stroke-width="1.1" opacity="0.5"/>';
          out += '<line x1="10" y1="55" x2="60" y2="55" stroke="hsl(260,38%,55%)" stroke-width="0.8" opacity="0.4"/>';
          out += '<line x1="140" y1="55" x2="190" y2="55" stroke="hsl(260,38%,55%)" stroke-width="0.8" opacity="0.4"/>';
          out += '<circle cx="100" cy="55" r="4" fill="hsl(270,70%,70%)" opacity="0.65"/>';
          out += '</svg>';
          // Progress ring or done badge
          if (done) {
            out += '<span class="qhc-done-badge">&#10003;</span>';
          } else if (pct > 0) {
            out += '<div class="qhc-progress-ring" style="--pct:' + pct + '" title="' + pct + '% complété"></div>';
          }
          out += '</div>';
          out += '<div class="qhc-body">';
          out += '<p class="qhc-title">' + q.title + '</p>';
          out += '<p class="qhc-meta">' + q.question_count + ' question' + (q.question_count !== 1 ? 's' : '');
          if (q.parts_count > 0) out += ' · ' + q.parts_count + ' partie' + (q.parts_count !== 1 ? 's' : '');
          if (q.duration) out += ' · ~' + q.duration + ' min';
          out += '</p>';
          out += '</div>';
          out += '<div class="qhc-accent"></div>';
          out += '</button>';
        });
        out += '</div></section>';
        return out;
      }
    %>
    <%- quizStrip('Mis en avant', featured) %>
    <%- quizStrip('Nouveaux quizz', newest) %>
    <%- quizStrip('Mis à jour', updated) %>
    <%- quizStrip('Non encore complétés', notDone) %>

    <% if (!featured.length && !newest.length && !updated.length && !notDone.length) { %>
      <p class="quiz-hub-empty">Aucun quizz disponible pour le moment.</p>
    <% } %>

  </div>

  <%# ─── POPUP ─────────────────────────────────────────────────────────── %>
  <div class="qhp-overlay" id="qhp-overlay" hidden></div>
  <div class="qhp-modal" id="qhp-modal" hidden role="dialog" aria-modal="true">
    <button type="button" class="qhp-close" id="qhp-close" aria-label="Fermer">&#215;</button>
    <div class="qhp-img-wrap" id="qhp-img-wrap"></div>
    <div class="qhp-body">
      <h2 class="qhp-title" id="qhp-title"></h2>
      <p class="qhp-desc" id="qhp-desc"></p>
      <div class="qhp-stats" id="qhp-stats"></div>
      <div class="qhp-progress-wrap" id="qhp-progress-wrap" hidden>
        <div class="qhp-progress-bar"><div class="qhp-progress-fill" id="qhp-progress-fill"></div></div>
        <span class="qhp-progress-label" id="qhp-progress-label"></span>
      </div>
      <div class="qhp-actions">
        <a class="qhp-start-btn" id="qhp-start-btn" href="#">Commencer</a>
      </div>
    </div>
  </div>

  <% if (currentUser && currentUser.isAdmin) { %>
    <button type="button" class="wiki-fab-list" id="quiz-todo-btn" title="Quizz à créer">&#9776;</button>
    <a href="/quizz/new" class="wiki-fab-add" title="Nouveau quizz">+</a>

    <div class="wiki-todo-overlay" id="quiz-todo-overlay" hidden></div>
    <aside class="wiki-todo-drawer" id="quiz-todo-drawer" hidden aria-label="Quizz à créer">
      <div class="wiki-todo-header">
        <span class="wiki-todo-title">Quizz à créer</span>
        <button type="button" class="wiki-todo-close" id="quiz-todo-close" aria-label="Fermer">&#215;</button>
      </div>
      <div class="wiki-todo-body" id="quiz-todo-body"></div>
    </aside>
  <% } %>

  <script>
  (function() {
    var overlay = document.getElementById('qhp-overlay');
    var modal   = document.getElementById('qhp-modal');
    var closeBtn = document.getElementById('qhp-close');
    var titleEl = document.getElementById('qhp-title');
    var descEl  = document.getElementById('qhp-desc');
    var statsEl = document.getElementById('qhp-stats');
    var progressWrap = document.getElementById('qhp-progress-wrap');
    var progressFill = document.getElementById('qhp-progress-fill');
    var progressLabel = document.getElementById('qhp-progress-label');
    var startBtn = document.getElementById('qhp-start-btn');
    var imgWrap = document.getElementById('qhp-img-wrap');

    function openPopup(btn) {
      var qid = btn.dataset.qid;
      var title = btn.dataset.title;
      var desc  = btn.dataset.desc;
      var questions = btn.dataset.questions;
      var parts = btn.dataset.parts;
      var duration = btn.dataset.duration;
      var pct  = parseInt(btn.dataset.pct, 10) || 0;
      var done = btn.dataset.done === '1';
      var completedAt = btn.dataset.completedAt;

      titleEl.textContent = title;
      descEl.textContent = desc;
      descEl.hidden = !desc;

      // Stats
      var statsHTML = '<span class="qhp-stat">' + questions + ' question' + (questions != 1 ? 's' : '') + '</span>';
      if (parseInt(parts) > 0) statsHTML += '<span class="qhp-stat">' + parts + ' partie' + (parts != 1 ? 's' : '') + '</span>';
      if (duration) statsHTML += '<span class="qhp-stat">~' + duration + ' min</span>';
      statsEl.innerHTML = statsHTML;

      // Progress
      if (done) {
        progressWrap.hidden = false;
        progressFill.style.width = '100%';
        if (completedAt) {
          var d = new Date(parseInt(completedAt) * 1000);
          progressLabel.textContent = 'Terminé le ' + d.toLocaleDateString('fr-FR');
        } else {
          progressLabel.textContent = 'Terminé ✓';
        }
        startBtn.textContent = 'Reprendre / Voir les résultats';
      } else if (pct > 0) {
        progressWrap.hidden = false;
        progressFill.style.width = pct + '%';
        progressLabel.textContent = pct + '% complété';
        startBtn.textContent = 'Continuer';
      } else {
        progressWrap.hidden = true;
        startBtn.textContent = 'Commencer';
      }

      startBtn.href = '/quizz/' + qid;

      // SVG header clone
      imgWrap.innerHTML = '';
      var svg = btn.querySelector('.qhc-svg');
      if (svg) {
        var clone = svg.cloneNode(true);
        clone.removeAttribute('class');
        clone.style.cssText = 'width:100%;height:100%;display:block';
        imgWrap.appendChild(clone);
      }

      overlay.hidden = false;
      modal.hidden = false;
    }

    function closePopup() { overlay.hidden = true; modal.hidden = true; }

    document.querySelectorAll('.qhc').forEach(function(btn) {
      btn.addEventListener('click', function() { openPopup(btn); });
    });
    closeBtn.addEventListener('click', closePopup);
    overlay.addEventListener('click', closePopup);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !modal.hidden) closePopup(); });
  })();
  </script>

  <% if (currentUser && currentUser.isAdmin) { %>
  <script>
  (function() {
    var btn     = document.getElementById('quiz-todo-btn');
    var overlay = document.getElementById('quiz-todo-overlay');
    var drawer  = document.getElementById('quiz-todo-drawer');
    var closeBtn = document.getElementById('quiz-todo-close');
    var bodyEl  = document.getElementById('quiz-todo-body');
    if (!btn || !drawer) return;

    var TODO_KEY = 'quiz-todo-list';

    function load() { try { return JSON.parse(localStorage.getItem(TODO_KEY) || '[]'); } catch(e) { return []; } }
    function save(d) { localStorage.setItem(TODO_KEY, JSON.stringify(d)); }

    function render() {
      var items = load();
      bodyEl.innerHTML = '';

      var addBlock = document.createElement('div');
      addBlock.className = 'qtodo-add-block';

      var titleInp = document.createElement('input');
      titleInp.type = 'text';
      titleInp.placeholder = 'Titre du quizz…';
      titleInp.className = 'wiki-todo-add-input';
      titleInp.style.marginBottom = '.3rem';

      var descInp = document.createElement('textarea');
      descInp.placeholder = 'Description (optionnelle)…';
      descInp.className = 'wiki-todo-add-input qtodo-desc-inp';
      descInp.rows = 2;

      var addBtn = document.createElement('button');
      addBtn.type = 'button';
      addBtn.className = 'wiki-todo-add-btn qtodo-add-full-btn';
      addBtn.textContent = '+ Ajouter';

      function doAdd() {
        var title = titleInp.value.trim();
        if (!title) return;
        var desc = descInp.value.trim();
        var d = load();
        d.push({ title: title, desc: desc });
        save(d);
        titleInp.value = '';
        descInp.value = '';
        render();
      }
      addBtn.addEventListener('click', doAdd);
      titleInp.addEventListener('keydown', function(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); doAdd(); } });

      addBlock.appendChild(titleInp);
      addBlock.appendChild(descInp);
      addBlock.appendChild(addBtn);
      bodyEl.appendChild(addBlock);

      if (!items.length) {
        var empty = document.createElement('p');
        empty.className = 'qtodo-empty';
        empty.textContent = 'Aucun quizz prévu pour l\'instant.';
        bodyEl.appendChild(empty);
        return;
      }

      var ul = document.createElement('ul');
      ul.className = 'wiki-todo-list qtodo-list';

      items.forEach(function(item, idx) {
        var li = document.createElement('li');
        li.className = 'wiki-todo-item qtodo-item';

        var info = document.createElement('div');
        info.className = 'qtodo-item-info';

        var titleEl = document.createElement('span');
        titleEl.className = 'wiki-todo-item-text qtodo-item-title';
        titleEl.textContent = item.title;
        info.appendChild(titleEl);

        if (item.desc) {
          var descEl = document.createElement('span');
          descEl.className = 'qtodo-item-desc';
          descEl.textContent = item.desc;
          info.appendChild(descEl);
        }

        var actions = document.createElement('div');
        actions.className = 'wiki-todo-item-actions';

        var goBtn = document.createElement('a');
        goBtn.href = '/quizz/new?title=' + encodeURIComponent(item.title) + '&desc=' + encodeURIComponent(item.desc || '');
        goBtn.className = 'wiki-todo-go-btn';
        goBtn.title = 'Créer ce quizz';
        goBtn.textContent = '→';
        (function(i) {
          goBtn.addEventListener('click', function() {
            var d = load();
            d.splice(i, 1);
            save(d);
          });
        })(idx);

        var delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'wiki-todo-del-btn';
        delBtn.title = 'Supprimer';
        delBtn.textContent = '×';
        (function(i) {
          delBtn.addEventListener('click', function() {
            var d = load();
            d.splice(i, 1);
            save(d);
            render();
          });
        })(idx);

        actions.appendChild(goBtn);
        actions.appendChild(delBtn);
        li.appendChild(info);
        li.appendChild(actions);
        ul.appendChild(li);
      });

      bodyEl.appendChild(ul);
    }

    function open() { render(); overlay.hidden = false; drawer.hidden = false; }
    function close() { overlay.hidden = true; drawer.hidden = true; }

    btn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !drawer.hidden) close(); });
  })();
  </script>
  <% } %>

</main>
<%- include('partials/foot') %>
