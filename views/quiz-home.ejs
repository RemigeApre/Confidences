<%- include('partials/head', { title: 'Quizz' }) %>
<main class="container wide wiki-locked" style="--ch-hue: 260">
  <%- include('partials/top-nav', { config: config, navTitle: 'Quizz', navBack: '/' }) %>

  <%- include('partials/mobile-filter-toggle') %>

  <%# ─── SIDEBAR GAUCHE ────────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer">&times;</button>

    <div class="wiki-chapter-hero">
      <div class="wiki-chapter-hero-top">
        <a href="/" class="wiki-chapter-hero-back" title="Accueil" aria-label="Accueil">&larr;</a>
        <h1 class="wiki-chapter-hero-title">Quizz</h1>
        <span class="wiki-chapter-hero-count"><%= all.length %></span>
      </div>
    </div>

    <div class="wiki-sidebar-body">
      <%# Filtres à venir %>
    </div>
  </aside>

  <%# ─── CONTENU PRINCIPAL ─────────────────────────────────────────────── %>
  <div class="quiz-hub">

    <% if (featured.length) { %>
    <section class="quiz-hub-strip">
      <h2 class="quiz-hub-strip-title">Mis en avant</h2>
      <div class="quiz-hub-cards">
        <% featured.forEach(function(q) { %>
          <a href="/quizz/<%= q.id %>" class="quiz-hub-card<%= completedIds.has(q.id) ? ' quiz-hub-card--done' : '' %>">
            <p class="quiz-hub-card-title"><%= q.title %></p>
            <% if (q.description) { %><p class="quiz-hub-card-desc"><%= q.description %></p><% } %>
            <span class="quiz-hub-card-meta"><%= q.question_count %> question<%= q.question_count !== 1 ? 's' : '' %></span>
            <% if (completedIds.has(q.id)) { %><span class="quiz-hub-card-done">&#10003;</span><% } %>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (newest.length) { %>
    <section class="quiz-hub-strip">
      <h2 class="quiz-hub-strip-title">Nouveaux quizz</h2>
      <div class="quiz-hub-cards">
        <% newest.forEach(function(q) { %>
          <a href="/quizz/<%= q.id %>" class="quiz-hub-card<%= completedIds.has(q.id) ? ' quiz-hub-card--done' : '' %>">
            <p class="quiz-hub-card-title"><%= q.title %></p>
            <% if (q.description) { %><p class="quiz-hub-card-desc"><%= q.description %></p><% } %>
            <span class="quiz-hub-card-meta"><%= q.question_count %> question<%= q.question_count !== 1 ? 's' : '' %></span>
            <% if (completedIds.has(q.id)) { %><span class="quiz-hub-card-done">&#10003;</span><% } %>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (updated.length) { %>
    <section class="quiz-hub-strip">
      <h2 class="quiz-hub-strip-title">Mis à jour</h2>
      <div class="quiz-hub-cards">
        <% updated.forEach(function(q) { %>
          <a href="/quizz/<%= q.id %>" class="quiz-hub-card<%= completedIds.has(q.id) ? ' quiz-hub-card--done' : '' %>">
            <p class="quiz-hub-card-title"><%= q.title %></p>
            <% if (q.description) { %><p class="quiz-hub-card-desc"><%= q.description %></p><% } %>
            <span class="quiz-hub-card-meta"><%= q.question_count %> question<%= q.question_count !== 1 ? 's' : '' %></span>
            <% if (completedIds.has(q.id)) { %><span class="quiz-hub-card-done">&#10003;</span><% } %>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (notDone.length) { %>
    <section class="quiz-hub-strip">
      <h2 class="quiz-hub-strip-title">Non encore complétés</h2>
      <div class="quiz-hub-cards">
        <% notDone.forEach(function(q) { %>
          <a href="/quizz/<%= q.id %>" class="quiz-hub-card<%= completedIds.has(q.id) ? ' quiz-hub-card--done' : '' %>">
            <p class="quiz-hub-card-title"><%= q.title %></p>
            <% if (q.description) { %><p class="quiz-hub-card-desc"><%= q.description %></p><% } %>
            <span class="quiz-hub-card-meta"><%= q.question_count %> question<%= q.question_count !== 1 ? 's' : '' %></span>
            <% if (completedIds.has(q.id)) { %><span class="quiz-hub-card-done">&#10003;</span><% } %>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (!featured.length && !newest.length && !updated.length && !notDone.length) { %>
      <p class="quiz-hub-empty">Aucun quizz disponible pour le moment.</p>
    <% } %>

  </div>

  <% if (currentUser && currentUser.isAdmin) { %>
    <a href="/quizz/new" class="wiki-fab-add" title="Nouveau quizz">+</a>
  <% } %>

</main>
<%- include('partials/foot') %>
