<script nonce="<%= nonce %>">
(function () {
  if (window.innerWidth > 640) return; // mobile uniquement
  var MIN_HOLD = 320; // ms de maintien pour déclencher la navigation

  document.querySelectorAll('.wiki-wave').forEach(function (wave) {
    var holdStart = 0;
    var readyTimer = null;

    function reset(navigate) {
      clearTimeout(readyTimer);
      wave.classList.remove('wiki-wave--active', 'wiki-wave--ready');
      if (navigate) {
        var href = wave.dataset.href;
        if (href) window.location.href = href;
      }
    }

    wave.addEventListener('pointerdown', function (e) {
      e.preventDefault();
      wave.setPointerCapture(e.pointerId);
      holdStart = Date.now();
      wave.classList.add('wiki-wave--active');
      readyTimer = setTimeout(function () {
        wave.classList.add('wiki-wave--ready');
      }, MIN_HOLD);
    });

    wave.addEventListener('pointerup', function () {
      reset(Date.now() - holdStart >= MIN_HOLD);
    });

    wave.addEventListener('pointercancel', function () {
      reset(false);
    });

    // Accessibilité clavier
    wave.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        var href = wave.dataset.href;
        if (href) window.location.href = href;
      }
    });
  });
})();
</script>

<script nonce="<%= nonce %>">
(function () {
  var block   = document.getElementById('wiki-poll-block');
  if (!block) return;
  var form    = document.getElementById('wiki-poll-form');
  var results = document.getElementById('wiki-poll-results');
  var submitBtn = document.getElementById('wiki-poll-submit');
  var slug    = block.dataset.slug;
  var needSex = !!document.getElementById('wiki-poll-sex-row');
  var userSexFixed = <%- JSON.stringify(userSex || '') %>;

  var answers = { sex: userSexFixed || null, age_range: null, fantasme: null, pratique: null, pratique_recoit: null, pratique_donne: null };

  function checkComplete() {
    if (!submitBtn) return;
    if (needSex && !answers.sex) { submitBtn.disabled = true; return; }
    if (answers.fantasme === null || answers.pratique === null) { submitBtn.disabled = true; return; }
    if (answers.pratique === '1' && (answers.pratique_recoit === null || answers.pratique_donne === null)) { submitBtn.disabled = true; return; }
    submitBtn.disabled = false;
  }

  // Sex buttons
  document.querySelectorAll('.wiki-poll-sex-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.wiki-poll-sex-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      answers.sex = btn.dataset.val;
      checkComplete();
    });
  });

  // Age select
  var ageSelect = document.getElementById('wiki-poll-age');
  if (ageSelect) ageSelect.addEventListener('change', function () { answers.age_range = ageSelect.value || null; });

  // Answer buttons
  document.querySelectorAll('.wiki-poll-ans-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var q = btn.dataset.q;
      document.querySelectorAll('.wiki-poll-ans-btn[data-q="' + q + '"]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      answers[q] = btn.dataset.val;
      // Afficher/cacher reçu+donné selon la réponse à pratique
      if (q === 'pratique') {
        var dirQ = document.querySelectorAll('.wiki-poll-q--direction');
        dirQ.forEach(function (el) { el.hidden = btn.dataset.val !== '1'; });
        if (btn.dataset.val !== '1') { answers.pratique_recoit = null; answers.pratique_donne = null; }
      }
      checkComplete();
    });
  });

  // Submit
  submitBtn && submitBtn.addEventListener('click', function () {
    submitBtn.disabled = true;
    submitBtn.textContent = '…';
    var payload = {
      fantasme:        answers.fantasme,
      pratique:        answers.pratique,
      pratique_recoit: answers.pratique_recoit,
      pratique_donne:  answers.pratique_donne,
    };
    if (needSex)                 payload.sex = answers.sex;
    if (answers.age_range)       payload.age_range = answers.age_range;

    fetch('/wiki/' + slug + '/poll', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error === 'incomplete') { submitBtn.disabled = false; submitBtn.textContent = 'Répondre'; return; }
      if (form)    form.hidden    = true;
      renderResults(data.aggregate);
      if (results) results.hidden = false;
    })
    .catch(function () { submitBtn.disabled = false; submitBtn.textContent = 'Répondre'; });
  });

  function bar(label, pct, clr) {
    if (pct === null || pct === undefined) return '';
    return '<div class="wiki-poll-bar-row">'
      + '<span class="wiki-poll-bar-lbl">' + label + '</span>'
      + '<div class="wiki-poll-bar-track"><div class="wiki-poll-bar-fill" style="width:' + pct + '%;background:' + clr + '"></div></div>'
      + '<span class="wiki-poll-bar-pct">' + pct + '%</span>'
      + '</div>';
  }

  function colHtml(g, label) {
    if (!g) return '';
    var html = '<div class="wiki-poll-bysex-col">';
    html += '<p class="wiki-poll-bysex-head">' + label + ' (' + g.total + ')</p>';
    html += bar('Fantasmé', g.pct_fantasme, 'hsl(260,55%,52%)');
    html += bar('Pratiqué', g.pct_pratique, 'hsl(200,60%,46%)');
    if (g.pct_recoit !== null && g.pct_recoit !== undefined) html += bar('Reçu',  g.pct_recoit, 'hsl(340,55%,52%)');
    if (g.pct_donne  !== null && g.pct_donne  !== undefined) html += bar('Donné', g.pct_donne,  'hsl(340,45%,42%)');
    return html + '</div>';
  }

  function renderResults(agg) {
    if (!results) return;
    var totalEl = results.querySelector('.wiki-poll-total');
    if (totalEl) {
      if (!agg || agg.total === 0) totalEl.textContent = 'Soyez le premier à répondre !';
      else if (!agg.hasEnough)     totalEl.textContent = agg.total + ' réponse' + (agg.total > 1 ? 's' : '') + ' — résultats dès 5 réponses';
      else                          totalEl.textContent = agg.total + ' réponses';
    }
    var barsEl = document.getElementById('wiki-poll-bars');
    if (!barsEl || !agg || !agg.hasEnough || !agg.global) return;
    var g = agg.global;
    var html = bar('Ont fantasmé', g.pct_fantasme, 'hsl(260,55%,52%)') + bar('Ont pratiqué', g.pct_pratique, 'hsl(200,60%,46%)');
    if (g.pct_recoit !== null || g.pct_donne !== null) {
      html += '<p class="wiki-poll-bars-sub">Parmi ceux qui ont pratiqué</p>';
      html += bar('Ont reçu',  g.pct_recoit, 'hsl(340,55%,52%)') + bar('Ont donné', g.pct_donne, 'hsl(340,45%,42%)');
    }
    if (agg.femmes || agg.hommes) {
      html += '<div class="wiki-poll-bysex">' + colHtml(agg.femmes, 'Femmes') + colHtml(agg.hommes, 'Hommes') + '</div>';
    }
    barsEl.innerHTML = html;
  }
})();
</script>

