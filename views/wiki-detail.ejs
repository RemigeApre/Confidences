<%
  var _wdCatEN = {
    position:'Positions', lieux:'Places', partenaires:'Partners',
    jeu_de_role:'Scenarios', tenues:'Outfits', objets:'Objects',
    pratique:'Practices', fantasmes:'Fantasies'
  };
  var _wdSiteUrl = locals.siteUrl || '';
  var _wdJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    'name': page.title,
    'description': _wdMetaDesc,
    'inDefinedTermSet': {
      '@type': 'DefinedTermSet',
      'name': 'Codex Confidence',
      'url': _wdSiteUrl + '/wiki'
    },
    'url': _wdSiteUrl + '/wiki/' + (page.slug || page.id),
    'author': locals.pageAuthorMain
      ? {
          '@type': 'Person',
          'name':  pageAuthorMain.name,
          'url':   _wdSiteUrl + '/auteurs/' + pageAuthorMain.slug,
          'jobTitle': pageAuthorMain.credentials || undefined,
        }
      : { '@type': 'Organization', 'name': 'Codex Confidence', 'url': _wdSiteUrl },
    'publisher': { '@type': 'Organization', 'name': 'Codex Confidence', 'url': _wdSiteUrl },
    'inLanguage': 'fr',
    'isAccessibleForFree': true
  };
  if (page.createdAt) _wdJsonLd.datePublished = new Date(page.createdAt).toISOString().slice(0, 10);
  if (page.updatedAt) _wdJsonLd.dateModified = new Date(page.updatedAt).toISOString().slice(0, 10);
  if (cat) {
    _wdJsonLd.termCode = page.category;
    _wdJsonLd.additionalType = 'https://schema.org/Thing';
  }
  if (page.tags && page.tags.length) {
    _wdJsonLd.keywords = page.tags.join(', ');
    // GEO Primitive IV — Entity Relationship Structure : lister les tags comme
    // entités nommées améliore la détection de relations par les pipelines RAG.
    _wdJsonLd.mentions = page.tags.map(function(t) {
      return { '@type': 'DefinedTerm', 'name': t, 'inDefinedTermSet': _wdSiteUrl + '/wiki' };
    });
  }
  // E-E-A-T : contributeurs secondaires dans le JSON-LD
  if (locals.pageAuthorsSecondary && pageAuthorsSecondary.length) {
    _wdJsonLd.contributor = pageAuthorsSecondary.map(function(a) {
      return { '@type': 'Person', 'name': a.name, 'url': _wdSiteUrl + '/auteurs/' + a.slug };
    });
  }
  // GEO Primitive IV — relatedLink : connexions inter-articles explicites pour
  // les graphes de connaissances des crawlers IA (ChatGPT Search, Claude Search).
  if (suggestions && suggestions.length) {
    _wdJsonLd.relatedLink = suggestions.map(function(s) {
      return _wdSiteUrl + '/wiki/' + (s.slug || s.id);
    });
  }
  // GEO Primitive IV — sameAs : ancrage sur une ressource d'autorité externe
  // (Wikipedia / Wikidata) pour prouver l'identité de l'entité aux LLMs.
  if (pm.wikipedia_url) {
    _wdJsonLd.sameAs = Array.isArray(pm.wikipedia_url) ? pm.wikipedia_url : [pm.wikipedia_url];
  }
  if (pm.sources && pm.sources.length) {
    _wdJsonLd.citation = pm.sources.map(function(s) {
      var c = { '@type': 'CreativeWork', 'name': s.label || s.url };
      if (s.url) c.url = s.url;
      if (s.authors) c.author = s.authors;
      if (s.year) c.datePublished = s.year;
      return c;
    });
  }
  // BreadcrumbList pour Google (fil d'Ariane dans les résultats)
  var _wdBreadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Codex', 'item': _wdSiteUrl + '/wiki' },
      { '@type': 'ListItem', 'position': 2, 'name': cat ? cat.label : page.category, 'item': _wdSiteUrl + '/wiki/categorie/' + page.category },
      { '@type': 'ListItem', 'position': 3, 'name': page.title, 'item': _wdSiteUrl + '/wiki/' + (page.slug || page.id) }
    ]
  };
%>
<script type="application/ld+json"><%- JSON.stringify(_wdJsonLd) %></script>
<script type="application/ld+json"><%- JSON.stringify(_wdBreadcrumb) %></script>
