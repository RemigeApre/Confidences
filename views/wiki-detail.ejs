<script nonce="<%= nonce %>" src="/wiki.js?v=<%= assetVersion %>"></script>
<script nonce="<%= nonce %>">
(function () {
  var PAGE_ID   = <%= page.id %>;
  var PAGE_TITLE = <%- JSON.stringify(page.title) %>;
  var PAGE_CAT  = <%- JSON.stringify((cat && cat.label) || page.category) %>;
  var PAGE_TAGS = <%- JSON.stringify(page.tags || []) %>;
  var PAGE_URL  = window.location.origin + '/wiki/' + PAGE_ID;
  var PAGE_MD_URL = window.location.origin + '/wiki/' + PAGE_ID + '.md';

  // Convertit un bloc potentiellement en HTML (contenu collé avec sa mise en
  // forme au lieu du markdown attendu) en texte brut lisible, en gardant un
  // saut de ligne entre les blocs (p/h1-6/li/br) plutôt que de tout recoller.
  function htmlToPlainText(html) {
    var withBreaks = String(html)
      .replace(/<(p|div|h[1-6]|li|tr)[^>]*>/gi, '')
      .replace(/<\/(p|div|h[1-6]|li|tr)>/gi, '\n')
      .replace(/<br\s*\/?>/gi, '\n');
    var div = document.createElement('div');
    div.innerHTML = withBreaks;
    return (div.textContent || div.innerText || '').replace(/\n{3,}/g, '\n\n').trim();
  }

  function buildCopyText() {
    var wc = window.WIKI_CONTENT || {};
    var lang = (typeof localStorage !== 'undefined' && localStorage.getItem('slang') === 'en') ? 'en' : 'fr';
    var content = (wc.content && (wc.content[lang] || wc.content.fr)) || '';
    // Si le champ contient en réalité du HTML (collé avec sa mise en forme
    // au lieu du markdown attendu), on le nettoie d'abord via le DOM —
    // garantit un texte copié toujours propre, quel que soit l'état réel du champ.
    if (/<[a-z][\s\S]*>/i.test(content)) content = htmlToPlainText(content);
    // Texte brut sans markdown
    var plain = content
      .replace(/^#+\s+/gm, '').replace(/\*\*?|__?/g, '')
      .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
      .replace(/\n{3,}/g, '\n\n').trim()
      .slice(0, 1500);

    var lines = [
      'Fiche Codex Confidence — ' + PAGE_TITLE,
      'Catégorie : ' + PAGE_CAT,
      PAGE_TAGS.length ? 'Tags : ' + PAGE_TAGS.join(', ') : null,
      '',
      plain,
      '',
      'Source : ' + PAGE_URL,
      'Version Markdown : ' + PAGE_MD_URL,
    ].filter(function(l){ return l !== null; });

    return lines.join('\n');
  }

  function flashBtn(btn, labelFr, labelEn) {
    var lbl = btn.querySelector('.wiki-copy-ai-label');
    var lblM = btn.querySelector('.wiki-copy-ai-label-mobile');
    var origFr = 'Copier pour une IA', origEn = 'Copy for AI';
    var origFrM = 'Copier', origEnM = 'Copy';
    btn.disabled = true;
    if (lbl) { lbl.dataset.fr = labelFr; lbl.dataset.en = labelEn; lbl.textContent = labelFr; }
    if (lblM) { lblM.dataset.fr = labelFr; lblM.dataset.en = labelEn; lblM.textContent = labelFr; }
    if (!lbl && !lblM) { btn.title = labelFr; }
    setTimeout(function () {
      btn.disabled = false;
      if (lbl) { lbl.dataset.fr = origFr; lbl.dataset.en = origEn; lbl.textContent = origFr; }
      if (lblM) { lblM.dataset.fr = origFrM; lblM.dataset.en = origEnM; lblM.textContent = origFrM; }
      if (!lbl && !lblM) { btn.title = 'Copier pour une IA'; }
    }, 2000);
  }

  function doCopy(btn) {
    var text = buildCopyText();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        flashBtn(btn, 'Copié !', 'Copied!');
      }).catch(function () {
        flashBtn(btn, 'Erreur', 'Error');
      });
    } else {
      // Fallback ancien navigateur
      try {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.cssText = 'position:fixed;opacity:0;left:-9999px';
        document.body.appendChild(ta); ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        flashBtn(btn, 'Copié !', 'Copied!');
      } catch(_) { flashBtn(btn, 'Erreur', 'Error'); }
    }
  }

  var btn = document.getElementById('wiki-copy-ai-btn');
  if (btn) btn.addEventListener('click', function () { doCopy(this); });
  var btnM = document.getElementById('wiki-copy-ai-btn-mobile');
  if (btnM) btnM.addEventListener('click', function () { doCopy(this); });
})();
</script>
<script nonce="<%= nonce %>">
(function() {
  function wikiRenderMd(text) {
    if (!text) return '';
    function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    var pagesEl = document.getElementById('wiki-existing-pages');
    var pm = {};
    if (pagesEl) { try { JSON.parse(pagesEl.textContent).forEach(function(p){ pm[String(p.title).toLowerCase().trim()] = p.id; }); } catch(e){} }
    function inl(s) {
      return s.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
              .replace(/\*(.+?)\*/g,'<em>$1</em>')
              .replace(/`(.+?)`/g,'<code>$1</code>')
              .replace(/\[\[(.+?)\]\]/g,function(m,t){ var id=pm[t.toLowerCase().trim()]; return id?'<a class="wiki-inline-link" href="/wiki/'+id+'">'+t+'</a>':t; });
    }
    function renderLines(arr) {
      var out=[], ul=false;
      function cu(){if(ul){out.push('</ul>');ul=false;}}
      arr.forEach(function(l){
        if(/^### /.test(l)){cu();out.push('<h3>'+inl(l.slice(4))+'</h3>');}
        else if(/^---+\s*$/.test(l)){cu();out.push('<hr />');}
        else if(/^- /.test(l)){if(!ul){out.push('<ul>');ul=true;}out.push('<li>'+inl(l.slice(2))+'</li>');}
        else if(l.trim()===''){cu();}
        else{cu();out.push('<p>'+inl(l)+'</p>');}
      });
      cu(); return out.join('\n');
    }
    if(/^\s*<[a-zA-Z]/.test(text)||/<(?:h[1-6]|p|div|ul|ol|li|strong|em|a\s|hr|br)\b/i.test(text)) return text;
    var ls=text.split('\n'), sects=[{h:null,ls:[]}];
    ls.forEach(function(l){ var el=esc(l); if(/^## /.test(el)){sects.push({h:inl(el.slice(3)),ls:[]});}else{sects[sects.length-1].ls.push(el);} });
    return sects.map(function(s,i){ var b=renderLines(s.ls); return i===0?b:'<details class="wiki-section"><summary class="wiki-section-summary">'+s.h+'</summary><div class="wiki-section-body">'+b+'</div></details>'; }).join('\n');
  }

  function reinsertHero(container, heroEl) {
    // heroEl passé directement car un élément détaché du DOM n'est pas trouvable par getElementById
    var hero = heroEl || document.getElementById('wiki-mobile-hero');
    if (!hero || !container) return;
    var firstSection = container.querySelector(':scope > details.wiki-section');
    if (firstSection) {
      container.insertBefore(hero, firstSection);
    } else {
      // Pas de H2 : insérer après le premier paragraphe
      var firstP = container.querySelector(':scope > p');
      var after = firstP ? firstP.nextSibling : null;
      after ? container.insertBefore(hero, after) : container.appendChild(hero);
    }
  }

  function applyWikiLang(lang) {
    var data = window.WIKI_CONTENT;
    if (!data) return;
    document.querySelectorAll('[data-wiki-field]').forEach(function(el) {
      var field = el.getAttribute('data-wiki-field');
      var texts = data[field];
      if (!texts) return;
      var raw = (lang === 'en' && texts.en) ? texts.en : texts.fr;
      if (el.classList.contains('wiki-md')) {
        // Sauvegarder le hero avant que innerHTML ne le détache du DOM
        var hero = el.querySelector('#wiki-mobile-hero');
        if (hero) el.removeChild(hero);
        el.innerHTML = wikiRenderMd(raw);
        // Pour le contenu HTML, wikiRenderMd retourne le HTML tel quel (pas de Xi()).
        // Appliquer la conversion h2→details ici, comme wiki.js le fait au premier rendu.
        Array.prototype.slice.call(el.querySelectorAll('h2')).forEach(function(h2) {
          var det = document.createElement('details');
          det.className = 'wiki-section';
          var sum = document.createElement('summary');
          sum.className = 'wiki-section-summary';
          sum.innerHTML = h2.innerHTML;
          det.appendChild(sum);
          var body = document.createElement('div');
          body.className = 'wiki-section-body';
          var nx = h2.nextSibling;
          while (nx && nx.nodeName !== 'H2') { var nx2 = nx.nextSibling; body.appendChild(nx); nx = nx2; }
          det.appendChild(body);
          h2.parentNode.replaceChild(det, h2);
        });
        el.querySelectorAll('details.wiki-section').forEach(function(d){ d.open = false; });
        // Passer hero directement : getElementById ne trouve pas les éléments détachés
        reinsertHero(el, hero);
      } else {
        el.textContent = raw;
      }
    });
  }

  if (localStorage.getItem('slang') === 'en') applyWikiLang('en');

  new MutationObserver(function(mutations) {
    mutations.forEach(function(m) {
      if (m.attributeName === 'data-lang') {
        applyWikiLang(document.documentElement.getAttribute('data-lang') || 'fr');
      }
    });
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });
})();
</script>
