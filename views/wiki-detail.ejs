<%- include('partials/head', { title: 'Codex : ' + page.title, preloadImage: preloadImage }) %>
<main class="container wide">
  <%- include('partials/top-nav', { config: config, navTitle: 'Wiki', navBack: '/wiki/categorie/' + page.category }) %>

  <% var cat = categories.find(function (c) { return c.key === page.category; }); %>
  <%
    // "Possédé" (bouton "Nos objets" + étoile) : réservé à l'admin et aux
    // profils que l'admin a explicitement autorisés (voir /admin, fiche
    // profil > "Peut voir 'Nos objets'").
    var wdCanSeeOwned = !!(currentUser && (currentUser.isAdmin || currentUser.canSeeOwned));
    var pm = page.meta || {};

    var FSUBS = { jeux_role: 'Jeux de rôle et comportement', hardcore: 'Hardcore', bdsm: 'BDSM', classique: 'Classique', fantaisie: 'Fantaisie', sperme: 'Sperme', autre: 'Autre' };
    var nbTotal   = pm.nb_total    || '';
    var nbFem     = pm.nb_feminin  || pm.nb_femmes || '';
    var nbMasc    = pm.nb_masculin || pm.nb_hommes || '';
    var pmTypes   = Array.isArray(pm.types) ? pm.types : [];
    var TYPES_PART = { nombre: 'Nombre', fetichisme: 'Fétichisme', monstre: 'Monstre', animaux: 'Animaux', autre: 'Autre' };
    var hasPartMeta = page.category === 'partenaires' && (nbTotal || nbFem || nbMasc || pmTypes.length);
    var LIEU = { prive: 'Privé', public: 'Public', cache: 'Caché' };
    var OBJETS_SOUS = { substance: 'Substance', gode: 'Gode', bdsm: 'BDSM', fantaisie: 'Fantaisie', tatouage: 'Tatouage', autre: 'Autre' };
    var QUI    = { femme: 'Femme', homme: 'Homme', variable: 'Variable', aucun: 'Debout / aucun' };
    var CAN    = { vagin: 'Vagin', anus: 'Anus', bouche: 'Bouche', mains: 'Mains', autre: 'Autre' };
    var ORI    = { face_a_face: 'Face à face', face_contre_dos: 'Face contre dos', cote_a_cote: 'Côte à côte', acrobatique: 'Acrobatique', autre: 'Autre' };
    var POSCAT = { penetration: 'Pénétration', fellation_cunnilingus: 'Fellation / Cunnilingus', anilingus: 'Anilingus', stimulation_manuelle: 'Stimulation manuelle', double_penetration: 'Double pénétration', position_69: 'Position 69', autre: 'Autre' };
    var NBPART = { '2': '2', '3': '3', '4plus': '4+', variable: 'Variable' };
    var ACTIF  = { femme: 'Femme', homme: 'Homme', les_deux: 'Les deux', variable: 'Variable' };
    var SUP    = { lit: 'Lit', sol: 'Sol', chaise: 'Chaise', canape: 'Canapé / Bord de lit', mur: 'Contre un mur', table: 'Table / Plan', bain: 'Bain / Douche', autre: 'Autre' };
    var pmOri  = Array.isArray(pm.orientation) ? pm.orientation : (pm.orientation ? [pm.orientation] : []);
    var pmSup  = Array.isArray(pm.supports) ? pm.supports : (pm.supports ? [pm.supports] : []);
    var hasPosMeta = page.category === 'position' && (pm.categorie || pm.qui_dessus || (pm.canal && pm.canal.length) || pmOri.length || pm.nb_partenaires || pm.partenaire_actif || pmSup.length);

    var hasImages = page.imagePaths && page.imagePaths.length;
    var derivedTerms = (pm.termes_derives || []).map(function (t) {
      return typeof t === 'string' ? { term: t, en: false } : t;
    });
    var hasAnyTags = page.tags.length || derivedTerms.length;
    // ── Maps de labels partenaires ──
    var SOUS_CAT_PART    = { nombre: 'Nombre', monstre: 'Monstre', animaux: 'Animal', fetichisme: 'Fétichisme', autre: 'Autre' };
    var NATURE_ACTE_LBL  = { possible: 'Possible', improbable: 'Improbable', impossible: 'Impossible', fictif: 'Fictif\u00a0/\u00a0Fantastique', inconnu: 'Inconnu' };
    var CADRE_LEGAL_LBL  = { legal: 'L\u00e9gal', flou: 'Flou', illegal: 'Ill\u00e9gal', inconnu: 'Inconnu' };
    var RISQUE_LBL       = { inconnu: 'Inconnu', nul: 'Nul', faible: 'Faible', modere: 'Mod\u00e9r\u00e9', eleve: '\u00c9lev\u00e9', extreme: 'Extr\u00eame' };
    var ACCES_LBL        = { tres_rare: 'Tr\u00e8s rare', rare: 'Rare', occasionnel: 'Occasionnel', frequent: 'Fr\u00e9quent', inconnu: 'Inconnu' };
    var TYPE_CREATURE_LBL= { machine: 'Machine', sang_froid: 'Sang froid', mammifere: 'Mammif\u00e8re', insectoide: 'Insecto\u00efde', amorphe: 'Amorphe', elementaire: '\u00c9l\u00e9mentaire', autre: 'Autre' };
    var TYPE_ACTE_LBL    = { penetration: 'P\u00e9n\u00e9tration', absorption: 'Absorption', constriction: 'Constriction', pondaison: 'Pondaison', investation: 'Investation', possession: 'Possession', fusion: 'Fusion', parasitage: 'Parasitage', transformation: 'Transformation', insemination: 'Ins\u00e9mination', aucun_variable: 'Aucun\u00a0/\u00a0variable', autre: 'Autre' };
    var INTEL_LBL        = { bestiale: 'Bestiale', faible: 'Faible', correcte: 'Correcte', forte: 'Forte', inconnu: 'Inconnu' };
    var PAROLE_LBL       = { impossible: 'Impossible', possible: 'Possible', oui: 'Oui', frequente: 'Fr\u00e9quente', inconnu: 'Inconnu' };
    var COMPAT_LBL       = { oui: 'Oui', non: 'Non', partielle: 'Partielle', inconnu: 'Inconnu' };
    var ORIGINE_LBL      = { fantaisie: 'Fantaisie', science_fiction: 'Science-fiction', imaginaire: 'Imaginaire', autre: 'Autre' };
    var FAMILLE_ZOO_LBL  = { canide: 'Canid\u00e9', equide: '\u00c9quid\u00e9', felin: 'F\u00e9lin', bovin: 'Bovin', reptile: 'Reptile', aviaire: 'Aviaire', cetace: 'C\u00e9tac\u00e9', autre: 'Autre' };
    var TAILLE_ANIM_LBL  = { petit: 'Petit', egal: '\u00c9gal', grand: 'Grand', tres_grand: 'Tr\u00e8s grand' };
    var NATURE_ESP_LBL   = { domestique: 'Domestique', sauvage: 'Sauvage', inconnu: 'Inconnu' };
    var QUAL_LBL         = { faible: 'Faible', modere: 'Mod\u00e9r\u00e9(e)', grand: 'Grand(e)', tres_grand: 'Tr\u00e8s grand(e)' };
    var VERR_LBL         = { aucun: 'Aucun', noeud: 'N\u0153ud', epines: '\u00c9pines', ventouses: 'Ventouses', partiel: 'Partiel', autre: 'Autre', inconnu: 'Inconnu' };
    var SENS_LBL         = { pression: 'Pression', remplissage: 'Remplissage', frottement: 'Frottement', elongation: '\u00c9longation', vibration: 'Vibration', chaleur: 'Chaleur', secousse: 'Secousse', autre: 'Autre' };
    var MILIEU_LBL       = { terrestre: 'Terrestre', aerien: 'A\u00e9rien', aquatique_mer: 'Aquatique (mer)', dulcaquicole: 'Dul\u00e7aquicole', semi_aquatique: 'Semi-aquatique', souterrain: 'Souterrain', inconnu: 'Inconnu' };
    var STRUCT_LBL       = { monogame: 'Monogame', polygame: 'Polygame', polyandrie: 'Polyandrie', promiscuite: 'Promiscuit\u00e9', sans_lien: 'Sans lien', harem: 'Harem', coloniale: 'Coloniale', saisonniere: 'Saisonni\u00e8re', variable: 'Variable', inconnu: 'Inconnu' };
  %>

  <script id="wiki-existing-pages" type="application/json"><%- JSON.stringify(pages.map(function(p){ return { id: p.id, title: p.title, category: p.category, extraCats: p.extraCategories || [], rating: p.rating || 0, date: new Date(p.updatedAt).getTime() }; })) %></script>
  <script id="wiki-current-page-meta" type="application/json"><%- JSON.stringify({ id: page.id, category: page.category }) %></script>

  <article class="wiki-detail" style="--ch-hue: <%= cat ? cat.hue : 220 %>">

    <%# ─ Bandeau : retour + titre (mobile / fallback) ─ %>
    <div class="wiki-detail-banner">
      <a href="<%= backHref %>" class="wiki-detail-banner-back" title="<%= backLabel %>" aria-label="<%= backLabel %>">&#8592;</a>
      <h1 class="wiki-detail-banner-title"><%= page.title %></h1>
      <% if ((page.extraCategories && page.extraCategories.length) || (wdCanSeeOwned && page.owned)) { %>
        <div class="wiki-detail-banner-sub">
          <% if (wdCanSeeOwned && page.owned) { %><span>&#9733; Poss&eacute;d&eacute;</span><% } %>
          <% (page.extraCategories || []).forEach(function (eck) { var ecat = categories.find(function (c) { return c.key === eck; }); %>
            <span><%= ecat ? ecat.label : eck %></span>
          <% }) %>
        </div>
      <% } %>
    </div>

    <%# ─ Bandeau "Explorer l'inconnu" (voir wiki.js) : uniquement quand on
        arrive ici via le bouton du volet filtre codex (?explore=1). ─ %>
    <% if (locals.exploreMode) { %>
      <div class="wiki-explore-banner" id="wiki-explore-banner" data-page-id="<%= page.id %>">
        <span class="wiki-explore-banner-label">Mode exploration</span>
        <div class="wiki-explore-banner-actions">
          <button type="button" id="wiki-explore-prev" class="wiki-explore-nav-btn" title="Page pr&eacute;c&eacute;dente" aria-label="Page pr&eacute;c&eacute;dente" disabled>&#8592; Pr&eacute;c&eacute;dent</button>
          <button type="button" id="wiki-explore-next" class="wiki-explore-nav-btn" title="Page suivante" aria-label="Page suivante">Suivant &#8594;</button>
        </div>
        <a href="/wiki/<%= page.id %>" class="wiki-explore-banner-close" title="Quitter le mode exploration" aria-label="Quitter le mode exploration">&times;</a>
      </div>
    <% } %>

    <%# ─ Navigation prev/next (mobile — cachée sur PC, remplacée par celle du volet droit) ─ %>
    <nav class="wiki-page-nav wiki-page-nav--mobile" aria-label="Navigation entre pages">
      <a href="<%= prevPage ? '/wiki/' + prevPage.id : '#' %>" class="wiki-page-nav-btn wiki-page-nav-prev<%= prevPage ? '' : ' wiki-page-nav-disabled' %>" title="<%= prevPage ? prevPage.title : '' %>">
        <span class="wiki-page-nav-arrow">&#8592;</span>
        <span class="wiki-page-nav-label"><%= prevPage ? prevPage.title : '' %></span>
      </a>
      <a href="<%= nextPage ? '/wiki/' + nextPage.id : '#' %>" class="wiki-page-nav-btn wiki-page-nav-next<%= nextPage ? '' : ' wiki-page-nav-disabled' %>" title="<%= nextPage ? nextPage.title : '' %>">
        <span class="wiki-page-nav-label"><%= nextPage ? nextPage.title : '' %></span>
        <span class="wiki-page-nav-arrow">&#8594;</span>
      </a>
    </nav>

    <%# ═══ LAYOUT 2 COLONNES (PC) ══════════════════════════════════════════ %>
    <div class="wiki-detail-layout">
      <%
        var hasMetaRows = hasPartMeta || hasPosMeta
          || (page.category === 'objets' && pm.sous_cat && OBJETS_SOUS[pm.sous_cat])
          || (page.category === 'lieux'  && pm.type_lieu  && LIEU[pm.type_lieu])
          || (page.category === 'fantasmes' && pm.sous_cat && FSUBS[pm.sous_cat]);
      %>

      <%# ─ VOLET GAUCHE : métadonnées page (PC) ─ %>
      <aside class="wiki-detail-left">

        <%# Ligne du haut : catégorie + icône éditoriale en face %>
        <div class="wiki-left-top-row">
          <% if (cat) { %>
            <a href="/wiki/categorie/<%= page.category %>" class="wiki-left-cat-link"><%= cat.label %></a>
          <% } %>
          <% if (page.category === 'partenaires' && (pm.sous_cat === 'monstre' || pm.sous_cat === 'animaux')) { %>
            <details class="wiki-editorial-note">
              <summary class="wiki-editorial-icon" title="Note &eacute;ditoriale">!</summary>
              <div class="wiki-editorial-body">
                <p class="wiki-editorial-body-title">Note &eacute;ditoriale</p>
                <p>La zoophilie comme fantasme n&rsquo;est trait&eacute;e que sur l&rsquo;id&eacute;e femme&ndash;animal, idem pour les monstres, femme&ndash;monstre, sauf cas particulier. C&rsquo;est un choix &eacute;ditorial, et une volont&eacute;.</p>
                <% if (currentUser) { %>
                  <p>Le rapport femme&ndash;autre esp&egrave;ce part du postulat o&ugrave; l&rsquo;animal est consentant, ce que le rapport homme&ndash;animal ne permet pas du tout. De plus, c&rsquo;est aussi un choix esth&eacute;tique&nbsp;: le site et sa ligne &eacute;ditoriale ont go&ucirc;t de l&rsquo;&eacute;l&eacute;gance, que ne poss&egrave;derait en rien l&rsquo;homme en ce contexte de fantasme.</p>
                <% } %>
              </div>
            </details>
          <% } %>
        </div>

        <% if (wdCanSeeOwned && page.owned) { %>
          <span class="wiki-left-owned">&#9733;&nbsp;Poss&eacute;d&eacute;</span>
        <% } %>

        <%# ─ Partenaires : affichage riche complet ─ %>
        <% if (page.category === 'partenaires') { %>
          <%
            var hasCommuns  = pm.nature_acte || pm.cadre_legal || pm.risque_physique || pm.risque_mst || pm.accessibilite;
            var hasMonstre  = pm.type_creature || (pm.type_acte_sexuel && pm.type_acte_sexuel.length) || pm.niveau_intelligence || pm.capacite_parole || pm.compat_anatomique || pm.origine_conceptuelle;
            var tailleStr   = pm.taille_penis_qual ? (QUAL_LBL[pm.taille_penis_qual] || pm.taille_penis_qual) : ((pm.taille_penis_min || pm.taille_penis_max) ? (pm.taille_penis_min||'?')+'\u2013'+(pm.taille_penis_max||'?')+'\u00a0cm' : '');
            var circStr     = pm.circ_penis_qual   ? (QUAL_LBL[pm.circ_penis_qual]   || pm.circ_penis_qual)   : ((pm.circ_penis_min   || pm.circ_penis_max)   ? (pm.circ_penis_min||'?')+'\u2013'+(pm.circ_penis_max||'?')+'\u00a0cm' : '');
            var ejacStr     = pm.vol_ejac_qual     ? (QUAL_LBL[pm.vol_ejac_qual]     || pm.vol_ejac_qual)     : ((pm.vol_ejac_min     || pm.vol_ejac_max)     ? (pm.vol_ejac_min||'?')+'\u2013'+(pm.vol_ejac_max||'?')+'\u00a0ml' : '');
            var hasSperme   = pm.sperme_texture || pm.sperme_odeur || pm.sperme_gout;
            var hasBioData  = pm.nature_espece || tailleStr || circStr || ejacStr || hasSperme || pm.type_verrouillage || (pm.sensations && pm.sensations.length) || pm.milieu_vie || pm.structure_sociale;
          %>
          <div class="wiki-left-part wiki-left-part--<%= pm.sous_cat || 'autre' %>">

            <%# Badge type %>
            <% if (pm.sous_cat && SOUS_CAT_PART[pm.sous_cat]) { %>
              <div class="wiki-lp-type-badge"><%= SOUS_CAT_PART[pm.sous_cat] %></div>
            <% } %>

            <%# Général %>
            <% if (hasCommuns) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title">G&eacute;n&eacute;ral</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.nature_acte && NATURE_ACTE_LBL[pm.nature_acte]) { %>
                    <div class="wiki-lp-row"><dt>Nature</dt><dd><%= NATURE_ACTE_LBL[pm.nature_acte] %></dd></div>
                  <% } %>
                  <% if (pm.cadre_legal && CADRE_LEGAL_LBL[pm.cadre_legal]) { %>
                    <div class="wiki-lp-row"><dt>L&eacute;galit&eacute;</dt><dd class="wiki-lp-legal wiki-lp-legal--<%= pm.cadre_legal %>"><%= CADRE_LEGAL_LBL[pm.cadre_legal] %></dd></div>
                  <% } %>
                  <% if (pm.risque_physique && RISQUE_LBL[pm.risque_physique]) { %>
                    <div class="wiki-lp-row"><dt>Risque phys.</dt><dd><span class="wiki-lp-risk wiki-lp-risk--<%= pm.risque_physique %>"><%= RISQUE_LBL[pm.risque_physique] %></span></dd></div>
                  <% } %>
                  <% if (pm.risque_mst && RISQUE_LBL[pm.risque_mst]) { %>
                    <div class="wiki-lp-row"><dt>Risque MST</dt><dd><span class="wiki-lp-risk wiki-lp-risk--<%= pm.risque_mst %>"><%= RISQUE_LBL[pm.risque_mst] %></span></dd></div>
                  <% } %>
                  <% if (pm.accessibilite && ACCES_LBL[pm.accessibilite]) { %>
                    <div class="wiki-lp-row"><dt>Acc&egrave;s</dt><dd><%= ACCES_LBL[pm.accessibilite] %></dd></div>
                  <% } %>
                </dl>
              </div>
            <% } %>

            <%# Nombre %>
            <% if (pm.sous_cat === 'nombre' && (pm.nb_total || pm.nb_feminin || pm.nb_masculin)) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title">Composition</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.nb_total)    { %><div class="wiki-lp-row"><dt>Total</dt><dd><%= pm.nb_total    === '5plus' ? '5+' : pm.nb_total    %></dd></div><% } %>
                  <% if (pm.nb_feminin)  { %><div class="wiki-lp-row"><dt>F&eacute;minin</dt><dd><%= pm.nb_feminin  === '3plus' ? '3+' : pm.nb_feminin  %></dd></div><% } %>
                  <% if (pm.nb_masculin) { %><div class="wiki-lp-row"><dt>Masculin</dt><dd><%= pm.nb_masculin === '3plus' ? '3+' : pm.nb_masculin %></dd></div><% } %>
                </dl>
              </div>
            <% } %>

            <%# Monstre %>
            <% if (pm.sous_cat === 'monstre' && hasMonstre) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title">Caract&eacute;ristiques</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.type_creature && TYPE_CREATURE_LBL[pm.type_creature]) { %>
                    <div class="wiki-lp-row"><dt>Cr&eacute;ature</dt><dd><%= TYPE_CREATURE_LBL[pm.type_creature] %></dd></div>
                  <% } %>
                  <% if (pm.type_acte_sexuel && pm.type_acte_sexuel.length) { %>
                    <div class="wiki-lp-row wiki-lp-row--chips">
                      <dt>Acte(s)</dt>
                      <dd><div class="wiki-lp-chips"><% pm.type_acte_sexuel.forEach(function(v){ %><span class="wiki-lp-chip"><%= TYPE_ACTE_LBL[v] || v %></span><% }) %></div></dd>
                    </div>
                  <% } %>
                  <% if (pm.niveau_intelligence && INTEL_LBL[pm.niveau_intelligence]) { %>
                    <div class="wiki-lp-row"><dt>Intelligence</dt><dd><%= INTEL_LBL[pm.niveau_intelligence] %></dd></div>
                  <% } %>
                  <% if (pm.capacite_parole && PAROLE_LBL[pm.capacite_parole]) { %>
                    <div class="wiki-lp-row"><dt>Parole</dt><dd><%= PAROLE_LBL[pm.capacite_parole] %></dd></div>
                  <% } %>
                  <% if (pm.compat_anatomique && COMPAT_LBL[pm.compat_anatomique]) { %>
                    <div class="wiki-lp-row"><dt>Anatomie</dt><dd><%= COMPAT_LBL[pm.compat_anatomique] %></dd></div>
                  <% } %>
                  <% if (pm.origine_conceptuelle && ORIGINE_LBL[pm.origine_conceptuelle]) { %>
                    <div class="wiki-lp-row"><dt>Origine</dt><dd><%= ORIGINE_LBL[pm.origine_conceptuelle] %></dd></div>
                  <% } %>
                </dl>
              </div>
            <% } %>

            <%# Animal %>
            <% if (pm.sous_cat === 'animaux' && (pm.famille_zoologique || pm.taille_animal)) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title">Zoologie</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.famille_zoologique && FAMILLE_ZOO_LBL[pm.famille_zoologique]) { %>
                    <div class="wiki-lp-row"><dt>Famille</dt><dd><%= FAMILLE_ZOO_LBL[pm.famille_zoologique] %></dd></div>
                  <% } %>
                  <% if (pm.taille_animal && TAILLE_ANIM_LBL[pm.taille_animal]) { %>
                    <div class="wiki-lp-row"><dt>Taille</dt><dd><%= TAILLE_ANIM_LBL[pm.taille_animal] %></dd></div>
                  <% } %>
                </dl>
              </div>
            <% } %>

            <%# Biologie %>
            <% if ((pm.sous_cat === 'monstre' || pm.sous_cat === 'animaux') && hasBioData) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title">Biologie</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.nature_espece && NATURE_ESP_LBL[pm.nature_espece]) { %>
                    <div class="wiki-lp-row"><dt>Esp&egrave;ce</dt><dd><%= NATURE_ESP_LBL[pm.nature_espece] %></dd></div>
                  <% } %>
                  <% if (tailleStr) { %><div class="wiki-lp-row"><dt>P&eacute;nis</dt><dd><%= tailleStr %></dd></div><% } %>
                  <% if (circStr)   { %><div class="wiki-lp-row"><dt>Circonf.</dt><dd><%= circStr %></dd></div><% } %>
                  <% if (ejacStr)   { %><div class="wiki-lp-row"><dt>&Eacute;jac.</dt><dd><%= ejacStr %></dd></div><% } %>
                  <% if (hasSperme) { %>
                    <div class="wiki-lp-row"><dt>Sperme</dt><dd><%= [pm.sperme_texture, pm.sperme_odeur, pm.sperme_gout].filter(Boolean).join(' \u00b7 ') %></dd></div>
                  <% } %>
                  <% if (pm.type_verrouillage && VERR_LBL[pm.type_verrouillage]) { %>
                    <div class="wiki-lp-row"><dt>Verr.</dt><dd><%= VERR_LBL[pm.type_verrouillage] %></dd></div>
                  <% } %>
                  <% if (pm.sensations && pm.sensations.length) { %>
                    <div class="wiki-lp-row wiki-lp-row--chips">
                      <dt>Sensations</dt>
                      <dd><div class="wiki-lp-chips"><% pm.sensations.forEach(function(v){ %><span class="wiki-lp-chip"><%= SENS_LBL[v] || v %></span><% }) %></div></dd>
                    </div>
                  <% } %>
                  <% if (pm.milieu_vie && MILIEU_LBL[pm.milieu_vie]) { %>
                    <div class="wiki-lp-row"><dt>Milieu</dt><dd><%= MILIEU_LBL[pm.milieu_vie] %></dd></div>
                  <% } %>
                  <% if (pm.structure_sociale && STRUCT_LBL[pm.structure_sociale]) { %>
                    <div class="wiki-lp-row"><dt>Structure</dt><dd><%= STRUCT_LBL[pm.structure_sociale] %></dd></div>
                  <% } %>
                </dl>
              </div>
            <% } %>

          </div><%# /wiki-left-part %>

        <% } else if (hasMetaRows) { %>
          <%# Autres catégories : dl existant %>
          <dl class="wiki-left-meta">
            <% if (page.category === 'fantasmes' && pm.sous_cat && FSUBS[pm.sous_cat]) { %>
              <div class="wiki-left-meta-row"><dt>Sous-cat&eacute;gorie</dt><dd><%= FSUBS[pm.sous_cat] %></dd></div>
            <% } %>
            <% if (page.category === 'objets' && pm.sous_cat && OBJETS_SOUS[pm.sous_cat]) { %>
              <div class="wiki-left-meta-row"><dt>Cat&eacute;gorie</dt><dd><%= OBJETS_SOUS[pm.sous_cat] %></dd></div>
            <% } %>
            <% if (page.category === 'lieux' && pm.type_lieu && LIEU[pm.type_lieu]) { %>
              <div class="wiki-left-meta-row"><dt>Type de lieu</dt><dd><%= LIEU[pm.type_lieu] %></dd></div>
            <% } %>
            <% if (hasPosMeta) { %>
              <% if (pm.categorie && POSCAT[pm.categorie]) { %><div class="wiki-left-meta-row"><dt>Cat&eacute;gorie</dt><dd><%= POSCAT[pm.categorie] %></dd></div><% } %>
              <% if (pm.qui_dessus && QUI[pm.qui_dessus]) { %><div class="wiki-left-meta-row"><dt>Au-dessus</dt><dd><%= QUI[pm.qui_dessus] %></dd></div><% } %>
              <% if (pm.canal && pm.canal.length) { %><div class="wiki-left-meta-row"><dt>Canal</dt><dd><%= pm.canal.map(function(c){ return CAN[c] || c; }).join(' &middot; ') %></dd></div><% } %>
              <% if (pmOri.length) { %><div class="wiki-left-meta-row"><dt>Orientation</dt><dd><%= pmOri.map(function(o){ return ORI[o] || o; }).join(' &middot; ') %></dd></div><% } %>
              <% if (pm.nb_partenaires && NBPART[pm.nb_partenaires]) { %><div class="wiki-left-meta-row"><dt>Partenaires</dt><dd><%= NBPART[pm.nb_partenaires] %></dd></div><% } %>
              <% if (pm.partenaire_actif && ACTIF[pm.partenaire_actif]) { %><div class="wiki-left-meta-row"><dt>Partenaire actif</dt><dd><%= ACTIF[pm.partenaire_actif] %></dd></div><% } %>
              <% if (pmSup.length) { %><div class="wiki-left-meta-row"><dt>Supports</dt><dd><%= pmSup.map(function(s){ return SUP[s] || s; }).join(' &middot; ') %></dd></div><% } %>
            <% } %>
          </dl>
        <% } %>

        <p class="wiki-left-updated">Derni&egrave;re modification&nbsp;: <%= new Date(page.updatedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>

      </aside>

      <%# ─ COLONNE GAUCHE : contenu texte ─ %>
      <div class="wiki-detail-body">

        <%# Description markdown ─ %>
        <% if (page.content) { %>
          <div class="wiki-md"><span class="wiki-md-raw" hidden><%= page.content %></span></div>
        <% } %>

        <%# Image principale — mobile uniquement, glissée par JS avant le 1er h2 ─ %>
        <% if (hasImages && currentUser) { %>
          <div class="wiki-mobile-hero" id="wiki-mobile-hero" aria-hidden="true">
            <img src="<%= thumbUrl(page.imagePaths[0]) %>" alt="" class="wiki-mobile-hero-img" loading="lazy" />
          </div>
        <% } %>

        <%# Variantes (positions) ─ %>
        <% if (page.category === 'position' && pm.variantes && pm.variantes.length) { %>
          <div class="wiki-pos-section wiki-pos-variantes">
            <h3 class="wiki-pos-section-heading">Variantes</h3>
            <% pm.variantes.forEach(function(v) { %>
              <% if (!v.nom) return; %>
              <details class="wiki-var-detail">
                <summary class="wiki-var-summary"><%= v.nom %></summary>
                <div class="wiki-var-body">
                  <% if (v.description) { %><div class="wiki-md"><span class="wiki-md-raw" hidden><%= v.description %></span></div><% } %>
                  <% if (currentUser && v.images && v.images.length) { %>
                    <div class="wiki-var-images"><% v.images.forEach(function(src) { %><img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-var-img" loading="lazy" /><% }) %></div>
                  <% } %>
                  <% if (v.variantes && v.variantes.length) { %>
                    <% v.variantes.forEach(function(sv) { %>
                      <% if (!sv.nom) return; %>
                      <details class="wiki-var-detail wiki-var-sub-detail">
                        <summary class="wiki-var-summary"><%= sv.nom %></summary>
                        <div class="wiki-var-body">
                          <% if (sv.description) { %><div class="wiki-md"><span class="wiki-md-raw" hidden><%= sv.description %></span></div><% } %>
                          <% if (currentUser && sv.images && sv.images.length) { %>
                            <div class="wiki-var-images"><% sv.images.forEach(function(src) { %><img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-var-img" loading="lazy" /><% }) %></div>
                          <% } %>
                        </div>
                      </details>
                    <% }) %>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>

        <%# Scénario (partenaires) ─ %>
        <% if (page.category === 'partenaires' && pm.scenario) { %>
          <details class="wiki-pos-section wiki-pos-nouvelles wiki-scenario-details">
            <summary class="wiki-pos-section-heading wiki-scenario-summary">
              Sc&eacute;nario
              <% if (pm.scenario_human) { %>
                <span class="wiki-scenario-human-badge" data-tooltip="Ce sc&#233;nario a &#233;t&#233; enti&#232;rement &#233;crit par un humain, sans IA.">&#9998;&nbsp;100&nbsp;% humain</span>
              <% } else { %>
                <span class="wiki-scenario-info" data-tooltip="Les sc&#233;narios sont &#233;crits en premier jet par une IA, corrig&#233;s et am&#233;lior&#233;s &#224; la main. Le choix de l&#8217;IA est pour illustrer litt&#233;rairement chaque page du wiki.&#10;&#10;Pour du contenu original parfaitement humain, cela se passera dans une future page d&#233;di&#233;e.">!</span>
              <% } %>
            </summary>
            <% if (pm.scenario_image) { %>
              <img src="<%= thumbUrl(pm.scenario_image) %>" data-src="<%= pm.scenario_image %>" alt="" class="wiki-scenario-img" loading="lazy" />
            <% } %>
            <div class="wiki-pos-nouvelles-text"><%= pm.scenario %></div>
          </details>
        <% } %>

        <%# Orce (toutes catégories) ─ %>
        <% if (pm.orce_content) { %>
          <details class="wiki-pos-section wiki-orce-section">
            <summary class="wiki-pos-section-heading wiki-orce-summary">
              <span class="wiki-orce-logo">Orce</span>
            </summary>
            <p class="wiki-orce-pastille">Orce est un univers de fiction, de dark fantasy. Les cr&eacute;atures list&eacute;es ont leurs pendants, avec des noms l&eacute;g&egrave;rement diff&eacute;rents, et des caract&eacute;ristiques diff&eacute;rentes. Nous int&eacute;grons ici alors le contenu descriptif li&eacute;.</p>
            <% if (pm.orce_name) { %><p class="wiki-orce-name">Nom en Orce&nbsp;: <strong><%= pm.orce_name %></strong></p><% } %>
            <div class="wiki-md wiki-orce-content"><span class="wiki-md-raw" hidden><%= pm.orce_content %></span></div>
          </details>
        <% } %>

        <%# Statistiques pratique / fantasme (transversal) ─ %>
        <% if (pm.stats_type) {
             var stPctG = pm.stats_pct_general != null && pm.stats_pct_general !== '' ? pm.stats_pct_general : null;
             var stPctH = pm.stats_pct_hommes  != null && pm.stats_pct_hommes  !== '' ? pm.stats_pct_hommes  : null;
             var stPctF = pm.stats_pct_femmes  != null && pm.stats_pct_femmes  !== '' ? pm.stats_pct_femmes  : null;
             var hasAny = stPctG !== null || stPctH !== null || stPctF !== null;
        %>
        <div class="wiki-stats-block">
          <h3 class="wiki-stats-title">Statistiques</h3>
          <p class="wiki-stats-subtitle"><%= pm.stats_type === 'pratique' ? 'Pourcentage de personnes ayant réalisé ce fantasme' : 'Pourcentage de personnes ayant particulièrement ce fantasme' %></p>
          <% if (!hasAny) { %>
            <p class="wiki-stats-empty">Aucune donn&eacute;e disponible pour le moment.</p>
          <% } else { %>
            <ul class="wiki-stats-list">
              <% if (stPctG !== null) { %>
                <li class="wiki-stats-item">
                  <div class="wiki-stats-item-header">
                    <span class="wiki-stats-lbl">G&eacute;n&eacute;ral</span>
                    <span class="wiki-stats-pct"><%= stPctG %>&nbsp;%</span>
                  </div>
                  <span class="wiki-stats-bar-wrap"><span class="wiki-stats-bar" style="width:<%= stPctG %>%"></span></span>
                </li>
              <% } %>
              <% if (stPctF !== null) { %>
                <% var stDirF = pm.stats_type === 'pratique' ? (pm.stats_dir_femmes === 'donne' ? 'ont donn\u00e9' : 'ont re\u00e7u') : null; %>
                <li class="wiki-stats-item">
                  <div class="wiki-stats-item-header">
                    <span class="wiki-stats-lbl">Femmes<% if (stDirF) { %> <span class="wiki-stats-dir-badge"><%= stDirF %></span><% } %></span>
                    <span class="wiki-stats-pct"><%= stPctF %>&nbsp;%</span>
                  </div>
                  <span class="wiki-stats-bar-wrap"><span class="wiki-stats-bar wiki-stats-bar--f" style="width:<%= stPctF %>%"></span></span>
                </li>
              <% } %>
              <% if (stPctH !== null) { %>
                <% var stDirH = pm.stats_type === 'pratique' ? (pm.stats_dir_hommes === 'donne' ? 'ont donn\u00e9' : 'ont re\u00e7u') : null; %>
                <li class="wiki-stats-item">
                  <div class="wiki-stats-item-header">
                    <span class="wiki-stats-lbl">Hommes<% if (stDirH) { %> <span class="wiki-stats-dir-badge"><%= stDirH %></span><% } %></span>
                    <span class="wiki-stats-pct"><%= stPctH %>&nbsp;%</span>
                  </div>
                  <span class="wiki-stats-bar-wrap"><span class="wiki-stats-bar wiki-stats-bar--h" style="width:<%= stPctH %>%"></span></span>
                </li>
              <% } %>
            </ul>
          <% } %>
          <% if (pm.stats_source) { %>
            <a href="<%= pm.stats_source %>" class="wiki-stats-source" target="_blank" rel="noopener noreferrer">Source</a>
          <% } %>
          <% if (pm.stats_note) { %>
            <p class="wiki-stats-ctx-note"><%= pm.stats_note %></p>
          <% } %>
          <p class="wiki-stats-note">Ces &eacute;tudes ont &eacute;t&eacute; faites sur la population commune, int&eacute;grant donc la majorit&eacute; ne s&rsquo;int&eacute;ressant pas au domaine. Les chiffres des personnes int&eacute;ress&eacute;es &agrave; la sexualit&eacute; sont bien plus hauts, en g&eacute;n&eacute;ral.</p>
        </div>
        <% } %>

        <%# Informations utiles (positions) ─ %>
        <% if (page.category === 'position' && pm.infos_utiles) { %>
          <div class="wiki-pos-section wiki-pos-infos">
            <h3 class="wiki-pos-section-heading">Informations utiles</h3>
            <div class="wiki-md"><span class="wiki-md-raw" hidden><%= pm.infos_utiles %></span></div>
          </div>
        <% } %>

        <%# Nouvelles (positions) ─ %>
        <% if (page.category === 'position' && pm.nouvelles) { %>
          <div class="wiki-pos-section wiki-pos-nouvelles">
            <h3 class="wiki-pos-section-heading">Nouvelles</h3>
            <div class="wiki-pos-nouvelles-text"><%= pm.nouvelles %></div>
          </div>
        <% } %>

        <%# Images secondaires — galerie dans le texte ─ %>
        <%
          var secImages = pm.secondary_configured
            ? (pm.secondary_image_paths || [])
            : page.imagePaths.slice(1);
          // Ajoute les images positionnelles (intégrées dans le texte) si pas déjà présentes
          var posPaths = (pm.positional_images || []).map(function(pi){ return pi.path; });
          posPaths.forEach(function(p) {
            if (secImages.indexOf(p) === -1) secImages.push(p);
          });
          var secDisplay = secImages.slice(0, 16);   // affiche jusqu'à 16
          var isCollapsible = secImages.length > 8;  // collapse si > 8
          var hasMoreSec = secImages.length > 16;    // galerie si > 16
          var galleryTag = encodeURIComponent(page.title.toLowerCase());
        %>
        <% if (hasImages && secDisplay.length && currentUser) { %>
          <div class="wiki-secondary-section">
            <div class="wiki-secondary-header">
              <span class="wiki-secondary-title">Images</span>
              <% if (hasMoreSec) { %>
                <a href="/galerie?tag=<%= galleryTag %>" class="wiki-secondary-gallery-link">
                  Voir toutes les images &#8594;
                </a>
              <% } %>
            </div>
            <div class="wiki-secondary-imgs<%= isCollapsible ? ' wiki-secondary-imgs--collapsible' : '' %>"
                 id="wiki-secondary-grid">
              <% secDisplay.forEach(function(src) { %>
                <div class="wiki-secondary-img-wrap">
                  <img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-secondary-img" loading="lazy" />
                </div>
              <% }) %>
            </div>
            <% if (isCollapsible) { %>
              <button type="button" class="wiki-secondary-expand-btn" id="wiki-secondary-expand"
                      aria-expanded="false">Voir plus &#8964;</button>
            <% } %>
          </div>
        <% } %>

        <%# Pages liées ─ %>
        <div class="wiki-page-links-view" data-page-id="<%= page.id %>" hidden>
          <h3 class="wiki-pl-heading">Pages li&eacute;es</h3>
          <div class="wiki-pl-cards" data-role="links"></div>
        </div>

        <%# Questions du quizz liées ─ %>
        <% if (currentUser) { %>
          <div class="wiki-question-links-view" data-page-id="<%= page.id %>" hidden>
            <h3 class="wiki-ql-heading">Questions du quizz li&eacute;es</h3>
            <ul class="wiki-ql-list"></ul>
          </div>
        <% } %>

      </div><%# /wiki-detail-body %>

      <%# ─ COLONNE DROITE : panneau info (PC) ─ %>
      <aside class="wiki-detail-right">

        <%# ─ Header : retour + catégories ─ %>
        <div class="wiki-right-header">
          <a href="<%= backHref %>" class="wiki-right-back" title="<%= backLabel %>">&#8592;</a>
          <div class="wiki-right-header-cats">
            <% if (cat) { %>
              <a href="/wiki/categorie/<%= page.category %>" class="wiki-right-cat-text"><%= cat.label %></a>
            <% } %>
            <% (page.extraCategories || []).forEach(function (eck) { var ecat = categories.find(function (c) { return c.key === eck; }); if (ecat) { %>
              <span class="wiki-right-cat-sep">&middot;</span>
              <a href="/wiki/categorie/<%= eck %>" class="wiki-right-cat-text"><%= ecat.label %></a>
            <% } }) %>
            <% if (wdCanSeeOwned && page.owned) { %><span class="wiki-right-owned-tag">&#9733;</span><% } %>
          </div>
        </div>

        <%# ─ Navigation PC : titre encadré par prev/next ─ %>
        <div class="wiki-right-nav">
          <a href="<%= prevPage ? '/wiki/' + prevPage.id : '#' %>" class="wiki-right-nav-btn<%= prevPage ? '' : ' disabled' %>" title="<%= prevPage ? prevPage.title : '' %>">&#8249;</a>
          <span class="wiki-right-nav-title"><%= page.title %></span>
          <a href="<%= nextPage ? '/wiki/' + nextPage.id : '#' %>" class="wiki-right-nav-btn<%= nextPage ? '' : ' disabled' %>" title="<%= nextPage ? nextPage.title : '' %>">&#8250;</a>
        </div>

        <%# c) Image principale ─ %>
        <% if (hasImages && currentUser) { %>
          <div class="wiki-right-img-wrap">
            <img src="<%= thumbUrl(page.imagePaths[0]) %>" data-src="<%= page.imagePaths[0] %>" alt="" class="wiki-right-img" />
          </div>
        <% } %>

        <%# Noms de variantes (tags cliquables sous l'image) ─ %>
        <%
          var variantNames = [];
          if (pm.variantes && Array.isArray(pm.variantes)) {
            pm.variantes.forEach(function(v) {
              if (v.nom) variantNames.push(v.nom);
              if (Array.isArray(v.variantes)) {
                v.variantes.forEach(function(sv) { if (sv.nom) variantNames.push(sv.nom); });
              }
            });
          }
        %>
        <% if (variantNames.length) { %>
          <div class="wiki-right-variants">
            <% variantNames.forEach(function(nom) { %>
              <a href="/wiki?tag=<%= encodeURIComponent(nom.toLowerCase()) %>" class="wiki-right-variant-chip"><%= nom %></a>
            <% }) %>
          </div>
        <% } %>

        <div class="wiki-right-body">
        <%# d) Notation ─ %>
        <% if (currentUser) { %>
          <div class="wiki-detail-rating wiki-right-rating" data-id="<%= page.id %>" data-rating="<%= page.rating %>">
            <% for (var i = 1; i <= 5; i++) { %>
              <button type="button" class="wiki-star wiki-star-lg" data-value="<%= i %>"><%- i <= page.rating ? '&#9733;' : '&#9734;' %></button>
            <% } %>
          </div>
          <%# Mode couple : révélé seulement une fois que le visiteur a
              lui-même noté la page — voir mergePartnerReaction. %>
          <% if (page.rating > 0 && page.partnerReaction) { %>
            <div class="wiki-partner-reveal">
              <span class="wiki-partner-reveal-label">&#127800; <%= partnerUser.displayName %>&nbsp;:</span>
              <% if (page.partnerReaction.rating > 0) { %>
                <span class="wiki-partner-reveal-stars">
                  <% for (var pi = 1; pi <= 5; pi++) { %><span class="wiki-card-star<%= pi <= page.partnerReaction.rating ? ' filled' : '' %>">&#9733;</span><% } %>
                </span>
              <% } %>
              <% if (page.partnerReaction.flame) { %><span class="wiki-react-icon" title="J&apos;adore">&#128293;</span><% } %>
              <% if (page.partnerReaction.interested) { %><span class="wiki-react-icon" title="&Ccedil;a l&apos;int&eacute;resse">&#10024;</span><% } %>
            </div>
          <% } %>
        <% } %>

        <%# f) Tags : badge unifié (couleur ultra/irréaliste/page dédiée/terme
               dérivé/normal), clic = popup — voir partials/tag-badge.ejs.
               Un terme dérivé (ex. "chevaux" dérivé de la page "Cheval") est
               déjà inclus dans page.tags (voir autoEnrichTags côté serveur),
               donc rendu une seule fois ici, en jaune. ─ %>
        <% if (hasAnyTags) { %>
          <div class="wiki-right-tags">
            <% page.tags.forEach(function (t) { %>
              <%- include('partials/tag-badge', { tag: t }) %>
            <% }) %>
          </div>
        <% } %>

        <%# Carrousel images secondaires (mobile uniquement, entre tags et réactions) ─ %>
        <% if (hasImages && page.imagePaths.length > 1 && currentUser) { %>
          <% var secCount = page.imagePaths.length - 1; %>
          <div class="wiki-mobile-sec-wrap">
            <div class="wiki-mobile-sec-heading">
              <span>Autres images</span>
              <span class="wiki-mobile-sec-counter" id="wiki-sec-counter"><%= secCount > 1 ? '1\u00a0/\u00a0' + secCount : '' %></span>
            </div>
            <div class="wiki-mobile-sec-carousel" id="wiki-sec-carousel">
              <% page.imagePaths.slice(1).forEach(function (src) { %>
                <div class="wiki-mobile-sec-item">
                  <img src="<%= thumbUrl(src) %>" alt="" class="wiki-mobile-sec-img" loading="lazy" />
                </div>
              <% }) %>
            </div>
          </div>
          <% if (secCount > 1) { %>
          <script>
          (function () {
            var carousel = document.getElementById("wiki-sec-carousel");
            var counter  = document.getElementById("wiki-sec-counter");
            var total    = <%= secCount %>;
            if (!carousel || !counter) return;
            var items = carousel.querySelectorAll(".wiki-mobile-sec-item");
            function update() {
              if (!items.length) return;
              var gap  = parseFloat(getComputedStyle(carousel).gap) || 10;
              var itemW = items[0].offsetWidth + gap;
              var idx  = Math.min(Math.round(carousel.scrollLeft / itemW), total - 1);
              counter.textContent = (idx + 1) + "\u00a0/\u00a0" + total;
            }
            carousel.addEventListener("scroll", update, { passive: true });
          })();
          </script>
          <% } %>
        <% } %>

        <%# e) Réactions côte à côte ─ %>
        <% if (currentUser) { %>
          <div class="wiki-react wiki-right-reactions"
               data-id="<%= page.id %>"
               data-flame="<%= (page.flame || isFavorite) ? '1' : '0' %>"
               data-interested="<%= page.interested ? '1' : '0' %>"
               data-readlater="<%= page.readLater ? '1' : '0' %>"
               data-practiced="<%= page.practiced ? '1' : '0' %>"
               data-hidden="<%= page.hidden ? '1' : '0' %>">
            <div class="wiki-react-square">
              <button type="button" class="wiki-react-btn wiki-react-flame<%= (page.flame || isFavorite) ? ' active' : '' %>" data-key="flame">
                <span class="wiki-react-icon">&#128293;</span><span class="wiki-react-label">J&apos;adore</span>
              </button>
              <button type="button" class="wiki-react-btn wiki-react-interest<%= page.interested ? ' active' : '' %>" data-key="interested">
                <span class="wiki-react-icon">&#10024;</span><span class="wiki-react-label"><%= interestedLabel %></span>
              </button>
              <button type="button" class="wiki-react-btn wiki-react-readlater<%= page.readLater ? ' active' : '' %>" data-key="readlater">
                <span class="wiki-react-icon">&#9203;</span><span class="wiki-react-label">&Agrave; lire plus tard</span>
              </button>
              <button type="button" class="wiki-react-btn wiki-react-practiced<%= page.practiced ? ' active' : '' %>" data-key="practiced">
                <span class="wiki-react-icon">&#9989;</span><span class="wiki-react-label">D&eacute;j&agrave; pratiqu&eacute;</span>
              </button>
            </div>
            <button type="button" class="wiki-react-btn wiki-react-hidden wiki-react-standalone<%= page.hidden ? ' active' : '' %>" data-key="hidden" title="<%= page.hidden ? 'Réafficher cette page' : 'Masquer cette page' %>">
              <span class="wiki-react-icon">&#128065;</span><span class="wiki-react-label"><%= page.hidden ? 'Masquée' : 'Masquer' %></span>
            </button>
          </div>
        <% } %>

        <%# Actions : modifier ─ %>
        <% if (currentUser && currentUser.isAdmin) { %>
          <div class="wiki-right-actions">
            <a href="/wiki/<%= page.id %>/edit" class="wiki-edit-icon-btn" title="Modifier" aria-label="Modifier">&#9998;</a>
          </div>
          <div class="wiki-maturity-widget" id="wiki-maturity-widget" data-id="<%= page.id %>" data-level="<%= page.maturity || 0 %>">
            <span class="wiki-maturity-label">Maturit&eacute;</span>
            <div class="wiki-maturity-levels">
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 0 ? ' active' : '' %>" data-level="0">Brouillon</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 1 ? ' active' : '' %>" data-level="1">&Eacute;crite</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 2 ? ' active' : '' %>" data-level="2">2</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 3 ? ' active' : '' %>" data-level="3">3</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 4 ? ' active' : '' %>" data-level="4">4</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 5 ? ' active' : '' %>" data-level="5">5&nbsp;&#9201;</button>
            </div>
          </div>
        <% } %>

        </div><%# /wiki-right-body %>

      </aside><%# /wiki-detail-right %>

    </div><%# /wiki-detail-layout %>

    <%# ─ Suggestions ─ %>
    <% if (suggestions && suggestions.length) { %>
      <div class="wiki-suggestions">
        <h3 class="wiki-sugg-heading">Pages similaires</h3>
        <div class="wiki-sugg-row">
          <% suggestions.forEach(function (s) { %>
            <% var scat = categories.find(function (c) { return c.key === s.category; }); %>
            <a href="/wiki/<%= s.id %>" class="wiki-sugg-card">
              <% if (s.imagePaths && s.imagePaths.length && currentUser) { %>
                <div class="wiki-sugg-img-wrap"><img src="<%= thumbUrl(s.imagePaths[0]) %>" alt="" class="wiki-sugg-img" loading="lazy" /></div>
              <% } %>
              <span class="wiki-sugg-badge" style="background: hsl(<%= scat ? scat.hue : 220 %>, 55%, 45%)"><%= scat ? scat.label : s.category %></span>
              <span class="wiki-sugg-title"><%= s.title %></span>
              <% if (s.rating) { %><span class="wiki-sugg-stars"><% for (var si2=1;si2<=s.rating;si2++){ %>&#9733;<% } %></span><% } %>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <%# ─ Notes personnelles ─ %>
    <% if (currentUser) { %>
      <div class="wiki-user-note" data-page-id="<%= page.id %>">
        <h3 class="wiki-pos-section-heading wiki-user-note-heading">Mes notes</h3>
        <textarea class="wiki-user-note-area" placeholder="Vos notes personnelles sur cette page…" rows="4"><%= locals.userNote || '' %></textarea>
        <p class="wiki-user-note-status" aria-live="polite"></p>
      </div>
    <% } %>

    <%# Actions mobile (fav + edit) — masquées sur PC où elles sont dans la sidebar droite ─ %>
    <% if (currentUser) { %>
      <div class="wiki-detail-actions wiki-detail-actions-mobile">
        <button type="button" class="wiki-edit-icon-btn wiki-fav-icon-btn<%= isFavorite ? ' active' : '' %>" id="wiki-fav-btn-mobile" data-item-id="<%= page.id %>" title="Favori" aria-label="Favori">&#128278;</button>
        <% if (currentUser.isAdmin) { %>
          <a href="/wiki/<%= page.id %>/edit" class="wiki-edit-icon-btn" title="Modifier" aria-label="Modifier">&#9998;</a>
        <% } %>
      </div>
    <% } %>

  </article>
</main>
<% if (!currentUser) { %>
<div class="age-gate" id="age-gate">
  <div class="age-gate-card">
    <p class="age-gate-title">Contenu pour adultes</p>
    <p class="age-gate-msg">Cette page contient du contenu pornographique. Souhaitez-vous continuer&nbsp;?</p>
    <div class="age-gate-actions">
      <button type="button" class="age-gate-yes" id="age-gate-yes">Oui, j&rsquo;ai plus de 18&nbsp;ans</button>
      <a href="/wiki" class="age-gate-no">Non</a>
    </div>
  </div>
</div>
<% } %>
<script>window.GALLERY_CAN_EDIT = <%= (currentUser && currentUser.isAdmin) ? 'true' : 'false' %>;</script>
<script id="wiki-pos-images-data" type="application/json"><%- JSON.stringify(pm.positional_images || []) %></script>
<script>
(function () {
  try {
    var backInfo = JSON.parse(sessionStorage.getItem("wikiNavBack") || "null");
    if (backInfo && backInfo.href) {
      var btn = document.querySelector(".nav-back-btn");
      if (btn) btn.href = backInfo.href;
    }
  } catch (_) {}
})();
</script>
<script src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/codex-offline') %>
<%- include('partials/foot') %>
