      </aside>

      <%# ─ COLONNE GAUCHE : contenu texte ─ %>
      <div class="wiki-detail-body">

        <%# Introduction thématique : partenaires non-humains (monstres / animaux) ─ %>
        <% if (page.category === 'partenaires' && (pm.sous_cat === 'monstre' || pm.sous_cat === 'animaux')) { %>
        <details class="wiki-thematic-intro">
          <summary class="wiki-thematic-intro-summary" data-fr="Introduction" data-en="Introduction">Introduction</summary>
          <div class="wiki-thematic-intro-body">
            <p data-fr="La femme, sujet de convoitise, d'admiration ou de vénération, devient l'objet d'attention de ce qui n'est pas humain. Si belle, si sensuelle, si désirable que ces qualités dépassent l'espèce : elle devient nature et divine par cela." data-en="The woman, subject of desire, admiration or veneration, becomes the object of attention of what is not human. So beautiful, so sensual, so desirable that these qualities transcend species: she becomes nature itself, and divine because of it.">La femme, sujet de convoitise, d&rsquo;admiration ou de v&eacute;n&eacute;ration, devient l&rsquo;objet d&rsquo;attention de ce qui n&rsquo;est pas humain. Si belle, si sensuelle, si d&eacute;sirable que ces qualit&eacute;s d&eacute;passent l&rsquo;esp&egrave;ce&nbsp;: elle devient nature et divine par cela.</p>
            <p data-fr="Ces fantasmes placent la femme au centre d'un regard absolu ; un désir sans langage commun, sans conventions sociales, sans retenue culturelle. Ce qui ne peut pas parler ne peut pas mentir. Ce qui ne connaît pas les codes humains ne peut qu'obéir à l'instinct : celui d'être attiré, irrésistiblement, par elle." data-en="These fantasies place the woman at the centre of an absolute gaze: a desire with no common language, no social conventions, no cultural restraint. What cannot speak cannot lie. What does not know human codes can only obey instinct: to be drawn, irresistibly, to her.">Ces fantasmes placent la femme au centre d&rsquo;un regard absolu&nbsp;; un d&eacute;sir sans langage commun, sans conventions sociales, sans retenue culturelle. Ce qui ne peut pas parler ne peut pas mentir. Ce qui ne conna&icirc;t pas les codes humains ne peut qu&rsquo;ob&eacute;ir &agrave; l&rsquo;instinct&nbsp;: celui d&rsquo;&ecirc;tre attir&eacute;, irr&eacute;sistiblement, par elle.</p>
          </div>
        </details>
        <% } %>

        <%# Description markdown ─ %>
        <% var _wdContent = t(page.content, 'wiki', page.id, 'content'); %>
        <% if (_wdContent) { %>
          <div class="wiki-md" data-wiki-field="content"><span class="wiki-md-raw" hidden><%= _wdContent %></span></div>
        <% } %>

        <%# Image principale — mobile uniquement, glissée par JS avant le 1er h2 ─ %>
        <% if (hasImages && currentUser) { %>
          <div class="wiki-mobile-hero" id="wiki-mobile-hero" aria-hidden="true">
            <img src="<%= thumbUrl(page.imagePaths[0]) %>" alt="" class="wiki-mobile-hero-img" loading="lazy" />
          </div>
        <% } %>

        <%# Variantes (positions) ─ %>
        <% if (page.category === 'position' && pm.variantes && pm.variantes.length) { %>
          <div class="wiki-pos-section wiki-pos-variantes">
            <h3 class="wiki-pos-section-heading" data-fr="Variantes" data-en="Variants">Variantes</h3>
            <% pm.variantes.forEach(function(v) { %>
              <% if (!v.nom) return; %>
              <details class="wiki-var-detail">
                <summary class="wiki-var-summary"><%= v.nom %></summary>
                <div class="wiki-var-body">
                  <% if (v.description) { %><div class="wiki-md"><span class="wiki-md-raw" hidden><%= v.description %></span></div><% } %>
                  <% if (currentUser && v.images && v.images.length) { %>
                    <div class="wiki-var-images"><% v.images.forEach(function(src) { %><img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-var-img" loading="lazy" /><% }) %></div>
                  <% } %>
                  <% if (v.variantes && v.variantes.length) { %>
                    <% v.variantes.forEach(function(sv) { %>
                      <% if (!sv.nom) return; %>
                      <details class="wiki-var-detail wiki-var-sub-detail">
                        <summary class="wiki-var-summary"><%= sv.nom %></summary>
                        <div class="wiki-var-body">
                          <% if (sv.description) { %><div class="wiki-md"><span class="wiki-md-raw" hidden><%= sv.description %></span></div><% } %>
                          <% if (currentUser && sv.images && sv.images.length) { %>
                            <div class="wiki-var-images"><% sv.images.forEach(function(src) { %><img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-var-img" loading="lazy" /><% }) %></div>
                          <% } %>
                        </div>
                      </details>
                    <% }) %>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>

        <%# Scénario (partenaires) ─ %>
        <% var _pmScenario = t(pm.scenario, 'wiki', page.id, 'meta_scenario'); %>
        <% if (page.category === 'partenaires' && _pmScenario) { %>
          <details class="wiki-pos-section wiki-pos-nouvelles wiki-scenario-details">
            <summary class="wiki-pos-section-heading wiki-scenario-summary">
              <span data-fr="Scénario" data-en="Scenario">Sc&eacute;nario</span>
              <% if (pm.scenario_human) { %>
                <span class="wiki-scenario-human-badge" data-fr="✎ 100 % humain" data-en="✎ 100% human" data-tooltip="Ce sc&#233;nario a &#233;t&#233; enti&#232;rement &#233;crit par un humain, sans IA.">&#9998;&nbsp;100&nbsp;% humain</span>
              <% } else { %>
                <span class="wiki-scenario-info" data-tooltip="Les sc&#233;narios sont &#233;crits en premier jet par une IA, corrig&#233;s et am&#233;lior&#233;s &#224; la main. Le choix de l&#8217;IA est pour illustrer litt&#233;rairement chaque page du wiki.&#10;&#10;Pour du contenu original parfaitement humain, cela se passera dans une future page d&#233;di&#233;e.">!</span>
              <% } %>
            </summary>
            <% if (pm.scenario_image) { %>
              <img src="<%= thumbUrl(pm.scenario_image) %>" data-src="<%= pm.scenario_image %>" alt="" class="wiki-scenario-img" loading="lazy" />
            <% } %>
            <div class="wiki-pos-nouvelles-text" data-wiki-field="meta_scenario"><%= _pmScenario %></div>
          </details>
        <% } %>

        <%# Orce (toutes catégories) ─ %>
        <% var _pmOrce = t(pm.orce_content, 'wiki', page.id, 'meta_orce_content'); %>
        <% if (_pmOrce) { %>
          <details class="wiki-pos-section wiki-orce-section">
            <summary class="wiki-pos-section-heading wiki-orce-summary">
              <span class="wiki-orce-logo">Orce</span>
            </summary>
            <p class="wiki-orce-pastille" data-fr="Orce est un univers de fiction, de dark fantasy. Les créatures listées ont leurs pendants, avec des noms légèrement différents, et des caractéristiques différentes. Nous intégrons ici alors le contenu descriptif lié." data-en="Orce is a fictional dark fantasy universe. The creatures listed here have counterparts with slightly different names and characteristics. We include the related descriptive content here.">Orce est un univers de fiction, de dark fantasy. Les cr&eacute;atures list&eacute;es ont leurs pendants, avec des noms l&eacute;g&egrave;rement diff&eacute;rents, et des caract&eacute;ristiques diff&eacute;rentes. Nous int&eacute;grons ici alors le contenu descriptif li&eacute;.</p>
            <% if (pm.orce_name) { %><p class="wiki-orce-name"><span data-fr="Nom en Orce\u00a0:" data-en="Name in Orce:">Nom en Orce&nbsp;:</span> <strong><%= pm.orce_name %></strong></p><% } %>
            <div class="wiki-md wiki-orce-content" data-wiki-field="meta_orce_content"><span class="wiki-md-raw" hidden><%= _pmOrce %></span></div>
          </details>
        <% } %>

        <%# Statistiques pratique / fantasme (transversal) ─ %>
        <% if (pm.stats_type) {
             var stPctG = pm.stats_pct_general != null && pm.stats_pct_general !== '' ? pm.stats_pct_general : null;
             var stPctH = pm.stats_pct_hommes  != null && pm.stats_pct_hommes  !== '' ? pm.stats_pct_hommes  : null;
             var stPctF = pm.stats_pct_femmes  != null && pm.stats_pct_femmes  !== '' ? pm.stats_pct_femmes  : null;
             var hasAny = stPctG !== null || stPctH !== null || stPctF !== null;
        %>
        <div class="wiki-stats-block">
          <h3 class="wiki-stats-title" data-fr="Statistiques" data-en="Statistics">Statistiques</h3>
          <%
            var _statSubFr = pm.stats_type === 'pratique' ? 'Pourcentage de personnes ayant r\u00e9alis\u00e9 ce fantasme' : 'Pourcentage de personnes ayant particuli\u00e8rement ce fantasme';
            var _statSubEn = pm.stats_type === 'pratique' ? 'Percentage of people who have fulfilled this fantasy' : 'Percentage of people who particularly have this fantasy';
          %>
          <p class="wiki-stats-subtitle" data-fr="<%= _statSubFr %>" data-en="<%= _statSubEn %>"><%= _statSubFr %></p>
          <% if (!hasAny) { %>
            <p class="wiki-stats-empty" data-fr="Aucune donnée disponible pour le moment." data-en="No data available yet.">Aucune donn&eacute;e disponible pour le moment.</p>
          <% } else { %>
            <div class="wiki-stats-donuts">
              <% if (stPctG !== null) { %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= stPctG %>;--clr:hsl(220,70%,62%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(220,80%,76%)"><%= stPctG %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl" data-fr="Général" data-en="General">G&eacute;n&eacute;ral</span>
                </div>
              <% } %>
              <% if (stPctF !== null) { %>
                <%
                  var stDirF    = pm.stats_type === 'pratique' ? (pm.stats_dir_femmes === 'donne' ? 'ont donn\u00e9' : 'ont re\u00e7u') : null;
                  var stDirF_En = pm.stats_type === 'pratique' ? (pm.stats_dir_femmes === 'donne' ? 'gave' : 'received') : null;
                %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= stPctF %>;--clr:hsl(340,65%,62%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(340,75%,78%)"><%= stPctF %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl"><span data-fr="Femmes" data-en="Women">Femmes</span><% if (stDirF) { %><br><span class="wiki-stats-dir-badge" data-fr="<%= stDirF %>" data-en="<%= stDirF_En %>"><%= stDirF %></span><% } %></span>
                </div>
              <% } %>
              <% if (stPctH !== null) { %>
                <%
                  var stDirH    = pm.stats_type === 'pratique' ? (pm.stats_dir_hommes === 'donne' ? 'ont donn\u00e9' : 'ont re\u00e7u') : null;
                  var stDirH_En = pm.stats_type === 'pratique' ? (pm.stats_dir_hommes === 'donne' ? 'gave' : 'received') : null;
                %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= stPctH %>;--clr:hsl(200,70%,56%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(200,80%,74%)"><%= stPctH %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl"><span data-fr="Hommes" data-en="Men">Hommes</span><% if (stDirH) { %><br><span class="wiki-stats-dir-badge" data-fr="<%= stDirH %>" data-en="<%= stDirH_En %>"><%= stDirH %></span><% } %></span>
                </div>
              <% } %>
            </div>
          <% } %>
          <% if (pm.stats_source) { %>
            <a href="<%= pm.stats_source %>" class="wiki-stats-source" target="_blank" rel="noopener noreferrer">Source</a>
          <% } %>
          <% if (pm.stats_note) { %>
            <p class="wiki-stats-ctx-note"><%= pm.stats_note %></p>
          <% } %>
          <p class="wiki-stats-note" data-fr="Ces études ont été faites sur la population commune, intégrant donc la majorité ne s'intéressant pas au domaine. Les chiffres des personnes intéressées à la sexualité sont bien plus hauts, en général." data-en="These studies were conducted on the general population, which includes the majority who are not interested in the subject. Figures for people interested in sexuality are generally much higher.">Ces &eacute;tudes ont &eacute;t&eacute; faites sur la population commune, int&eacute;grant donc la majorit&eacute; ne s&rsquo;int&eacute;ressant pas au domaine. Les chiffres des personnes int&eacute;ress&eacute;es &agrave; la sexualit&eacute; sont bien plus hauts, en g&eacute;n&eacute;ral.</p>
        </div>
        <% } %>

        <%# Informations utiles (positions) ─ %>
        <% var _pmInfos = t(pm.infos_utiles, 'wiki', page.id, 'meta_infos_utiles'); %>
        <% if (page.category === 'position' && _pmInfos) { %>
          <div class="wiki-pos-section wiki-pos-infos">
            <h3 class="wiki-pos-section-heading" data-fr="Informations utiles" data-en="Useful information">Informations utiles</h3>
            <div class="wiki-md" data-wiki-field="meta_infos_utiles"><span class="wiki-md-raw" hidden><%= _pmInfos %></span></div>
          </div>
        <% } %>

        <%# Nouvelles (positions) ─ %>
        <% if (page.category === 'position' && pm.nouvelles) { %>
          <div class="wiki-pos-section wiki-pos-nouvelles">
            <h3 class="wiki-pos-section-heading" data-fr="Nouvelles" data-en="Stories">Nouvelles</h3>
            <div class="wiki-pos-nouvelles-text"><%= pm.nouvelles %></div>
          </div>
        <% } %>

        <%# Images secondaires — galerie dans le texte ─ %>
        <%
          var secImages = pm.secondary_configured
            ? (pm.secondary_image_paths || [])
            : page.imagePaths.slice(1);
          // Ajoute les images positionnelles (intégrées dans le texte) si pas déjà présentes
          var posPaths = (pm.positional_images || []).map(function(pi){ return pi.path; });
          posPaths.forEach(function(p) {
            if (secImages.indexOf(p) === -1) secImages.push(p);
          });
          var secDisplay = secImages.slice(0, 16);   // affiche jusqu'à 16
          var isCollapsible = secImages.length > 8;  // collapse si > 8
          var hasMoreSec = secImages.length > 16;    // galerie si > 16
          var galleryTag = encodeURIComponent(page.title.toLowerCase());
        %>
        <% if (hasImages && secDisplay.length && currentUser) { %>
          <div class="wiki-secondary-section">
            <div class="wiki-secondary-header">
              <span class="wiki-secondary-title" data-fr="Images" data-en="Images">Images</span>
              <% if (hasMoreSec) { %>
                <a href="/galerie?tag=<%= galleryTag %>" class="wiki-secondary-gallery-link" data-fr="Voir toutes les images →" data-en="View all images →">
                  Voir toutes les images &#8594;
                </a>
              <% } %>
            </div>
            <div class="wiki-secondary-imgs<%= isCollapsible ? ' wiki-secondary-imgs--collapsible' : '' %>"
                 id="wiki-secondary-grid">
              <% secDisplay.forEach(function(src) { %>
                <div class="wiki-secondary-img-wrap">
                  <img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-secondary-img" loading="lazy" />
                </div>
              <% }) %>
            </div>
            <% if (isCollapsible) { %>
              <button type="button" class="wiki-secondary-expand-btn" id="wiki-secondary-expand"
                      aria-expanded="false" data-fr="Voir plus ⌄" data-en="Show more ⌄">Voir plus &#8964;</button>
            <% } %>
          </div>
        <% } %>

        <%# Pages liées ─ %>
        <div class="wiki-page-links-view" data-page-id="<%= page.id %>" hidden>
          <h3 class="wiki-pl-heading" data-fr="Pages liées" data-en="Related pages">Pages li&eacute;es</h3>
          <div class="wiki-pl-cards" data-role="links"></div>
        </div>

        <%# Questions du quizz liées ─ %>
        <% if (currentUser) { %>
          <div class="wiki-question-links-view" data-page-id="<%= page.id %>" hidden>
            <h3 class="wiki-ql-heading" data-fr="Questions du quizz liées" data-en="Related quiz questions">Questions du quizz li&eacute;es</h3>
            <ul class="wiki-ql-list"></ul>
          </div>
        <% } %>

      </div><%# /wiki-detail-body %>

      <%# ─ COLONNE DROITE : panneau info (PC) ─ %>
      <aside class="wiki-detail-right">

        <%# ─ Header : retour + catégories ─ %>
        <div class="wiki-right-header">
          <a href="<%= backHref %>" class="wiki-right-back" title="<%= backLabel %>">&#8592;</a>
          <div class="wiki-right-header-cats">
            <% if (cat) { %>
              <a href="/wiki/categorie/<%= page.category %>" class="wiki-right-cat-text" data-fr="<%= cat.label %>" data-en="<%= WD_CAT_EN[page.category] || cat.label %>"><%= cat.label %></a>
            <% } %>
            <% (page.extraCategories || []).forEach(function (eck) { var ecat = categories.find(function (c) { return c.key === eck; }); if (ecat) { %>
              <span class="wiki-right-cat-sep">&middot;</span>
              <a href="/wiki/categorie/<%= eck %>" class="wiki-right-cat-text" data-fr="<%= ecat.label %>" data-en="<%= WD_CAT_EN[eck] || ecat.label %>"><%= ecat.label %></a>
            <% } }) %>
            <% if (wdCanSeeOwned && page.owned) { %><span class="wiki-right-owned-tag">&#9733;</span><% } %>
          </div>
        </div>

        <%# ─ Navigation PC : titre encadré par prev/next ─ %>
        <div class="wiki-right-nav">
          <a href="<%= prevPage ? '/wiki/' + prevPage.id : '#' %>" class="wiki-right-nav-btn<%= prevPage ? '' : ' disabled' %>" title="<%= _prevTitle %>">&#8249;</a>
          <span class="wiki-right-nav-title" data-fr="<%= page.title %>" data-en="<%= (translationsEn && translationsEn.title) || page.title %>"><%= t(page.title, 'wiki', page.id, 'title') %></span>
          <a href="<%= nextPage ? '/wiki/' + nextPage.id : '#' %>" class="wiki-right-nav-btn<%= nextPage ? '' : ' disabled' %>" title="<%= _nextTitle %>">&#8250;</a>
        </div>

        <%# c) Image principale ─ %>
        <% if (hasImages && currentUser) { %>
          <div class="wiki-right-img-wrap">
            <img src="<%= thumbUrl(page.imagePaths[0]) %>" data-src="<%= page.imagePaths[0] %>" alt="" class="wiki-right-img" />
          </div>
        <% } %>

        <%# Noms de variantes (tags cliquables sous l'image) ─ %>
        <%
          var variantNames = [];
          if (pm.variantes && Array.isArray(pm.variantes)) {
            pm.variantes.forEach(function(v) {
              if (v.nom) variantNames.push(v.nom);
              if (Array.isArray(v.variantes)) {
                v.variantes.forEach(function(sv) { if (sv.nom) variantNames.push(sv.nom); });
              }
            });
          }
        %>
        <% if (variantNames.length) { %>
          <div class="wiki-right-variants">
            <% variantNames.forEach(function(nom) { %>
              <a href="/wiki?tag=<%= encodeURIComponent(nom.toLowerCase()) %>" class="wiki-right-variant-chip"><%= nom %></a>
            <% }) %>
          </div>
        <% } %>

        <div class="wiki-right-body">
        <%# d) Notation ─ %>
        <% if (currentUser) { %>
          <div class="wiki-detail-rating wiki-right-rating" data-id="<%= page.id %>" data-rating="<%= page.rating %>">
            <% for (var i = 1; i <= 5; i++) { %>
              <button type="button" class="wiki-star wiki-star-lg<%= i <= page.rating ? ' filled' : '' %>" data-value="<%= i %>"><%- i <= page.rating ? '&#9733;' : '&#9734;' %></button>
            <% } %>
          </div>
          <%# Mode couple : révélé seulement une fois que le visiteur a
              lui-même noté la page — voir mergePartnerReaction. %>
          <% if (page.rating > 0 && page.partnerReaction) { %>
            <div class="wiki-partner-reveal">
              <span class="wiki-partner-reveal-label">&#127800; <%= partnerUser.displayName %>&nbsp;:</span>
              <% if (page.partnerReaction.rating > 0) { %>
                <span class="wiki-partner-reveal-stars">
                  <% for (var pi = 1; pi <= 5; pi++) { %><span class="wiki-card-star<%= pi <= page.partnerReaction.rating ? ' filled' : '' %>">&#9733;</span><% } %>
                </span>
              <% } %>
              <% if (page.partnerReaction.flame) { %><span class="wiki-react-icon" title="J&apos;adore">&#128293;</span><% } %>
              <% if (page.partnerReaction.interested) { %><span class="wiki-react-icon" title="&Ccedil;a l&apos;int&eacute;resse">&#10024;</span><% } %>
            </div>
          <% } %>
        <% } %>

        <%# f) Tags : badge unifié (couleur ultra/irréaliste/page dédiée/terme
               dérivé/normal), clic = popup — voir partials/tag-badge.ejs.
               Un terme dérivé (ex. "chevaux" dérivé de la page "Cheval") est
               déjà inclus dans page.tags (voir autoEnrichTags côté serveur),
               donc rendu une seule fois ici, en jaune. ─ %>
        <% if (hasAnyTags) { %>
          <div class="wiki-right-tags">
            <% page.tags.forEach(function (t) { %>
              <%- include('partials/tag-badge', { tag: t }) %>
            <% }) %>
          </div>
        <% } %>

        <%# Carrousel images secondaires (mobile uniquement, entre tags et réactions) ─ %>
        <% if (hasImages && page.imagePaths.length > 1 && currentUser) { %>
          <% var secCount = page.imagePaths.length - 1; %>
          <div class="wiki-mobile-sec-wrap">
            <div class="wiki-mobile-sec-heading">
              <span data-fr="Autres images" data-en="More images">Autres images</span>
              <span class="wiki-mobile-sec-counter" id="wiki-sec-counter"><%= secCount > 1 ? '1\u00a0/\u00a0' + secCount : '' %></span>
            </div>
            <div class="wiki-mobile-sec-carousel" id="wiki-sec-carousel">
              <% page.imagePaths.slice(1).forEach(function (src) { %>
                <div class="wiki-mobile-sec-item">
                  <img src="<%= thumbUrl(src) %>" alt="" class="wiki-mobile-sec-img" loading="lazy" />
                </div>
              <% }) %>
            </div>
          </div>
          <% if (secCount > 1) { %>
          <script nonce="<%= nonce %>">
          (function () {
            var carousel = document.getElementById("wiki-sec-carousel");
            var counter  = document.getElementById("wiki-sec-counter");
            var total    = <%= secCount %>;
            if (!carousel || !counter) return;
            var items = carousel.querySelectorAll(".wiki-mobile-sec-item");
            function update() {
              if (!items.length) return;
              var gap  = parseFloat(getComputedStyle(carousel).gap) || 10;
              var itemW = items[0].offsetWidth + gap;
              var idx  = Math.min(Math.round(carousel.scrollLeft / itemW), total - 1);
              counter.textContent = (idx + 1) + "\u00a0/\u00a0" + total;
            }
            carousel.addEventListener("scroll", update, { passive: true });
          })();
          </script>
          <% } %>
        <% } %>

        <%# e) Réactions côte à côte ─ %>
        <% if (currentUser) { %>
          <div class="wiki-react wiki-right-reactions"
               data-id="<%= page.id %>"
               data-flame="<%= (page.flame || isFavorite) ? '1' : '0' %>"
               data-interested="<%= page.interested ? '1' : '0' %>"
               data-readlater="<%= page.readLater ? '1' : '0' %>"
               data-practiced="<%= page.practiced ? '1' : '0' %>"
               data-hidden="<%= page.hidden ? '1' : '0' %>">
            <div class="wiki-react-square">
              <button type="button" class="wiki-react-btn wiki-react-flame<%= (page.flame || isFavorite) ? ' active' : '' %>" data-key="flame">
                <span class="wiki-react-icon">&#128293;</span><span class="wiki-react-label" data-fr="J'adore" data-en="Love it">J&apos;adore</span>
              </button>
              <button type="button" class="wiki-react-btn wiki-react-interest<%= page.interested ? ' active' : '' %>" data-key="interested">
                <span class="wiki-react-icon">&#10024;</span><span class="wiki-react-label"><%= interestedLabel %></span>
              </button>
              <button type="button" class="wiki-react-btn wiki-react-readlater<%= page.readLater ? ' active' : '' %>" data-key="readlater">
                <span class="wiki-react-icon">&#9203;</span><span class="wiki-react-label" data-fr="À lire plus tard" data-en="Read later">&Agrave; lire plus tard</span>
              </button>
              <button type="button" class="wiki-react-btn wiki-react-practiced<%= page.practiced ? ' active' : '' %>" data-key="practiced">
                <span class="wiki-react-icon">&#9989;</span><span class="wiki-react-label" data-fr="Déjà pratiqué" data-en="Already tried">D&eacute;j&agrave; pratiqu&eacute;</span>
              </button>
            </div>
            <button type="button" class="wiki-react-btn wiki-react-hidden wiki-react-standalone<%= page.hidden ? ' active' : '' %>" data-key="hidden" title="<%= page.hidden ? 'Réafficher cette page' : 'Masquer cette page' %>">
              <span class="wiki-react-icon">&#128065;</span><span class="wiki-react-label" data-fr="<%= page.hidden ? 'Masqu\u00e9e' : 'Masquer' %>" data-en="<%= page.hidden ? 'Hidden' : 'Hide' %>"><%= page.hidden ? 'Masquée' : 'Masquer' %></span>
            </button>
          </div>
        <% } %>

        <%# Actions : modifier ─ %>
        <% if (currentUser && currentUser.isAdmin) { %>
          <div class="wiki-right-actions">
            <a href="/wiki/<%= page.id %>/edit" class="wiki-edit-icon-btn" title="Modifier" aria-label="Modifier">&#9998;</a>
          </div>
          <div class="wiki-maturity-widget" id="wiki-maturity-widget" data-id="<%= page.id %>" data-level="<%= page.maturity || 0 %>">
            <span class="wiki-maturity-label" data-fr="Maturité" data-en="Maturity">Maturit&eacute;</span>
            <div class="wiki-maturity-levels">
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 0 ? ' active' : '' %>" data-level="0" data-fr="Brouillon" data-en="Draft">Brouillon</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 1 ? ' active' : '' %>" data-level="1" data-fr="Écrite" data-en="Written">&Eacute;crite</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 2 ? ' active' : '' %>" data-level="2">2</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 3 ? ' active' : '' %>" data-level="3">3</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 4 ? ' active' : '' %>" data-level="4">4</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity || 0) === 5 ? ' active' : '' %>" data-level="5">5&nbsp;&#9201;</button>
            </div>
          </div>
        <% } %>

        </div><%# /wiki-right-body %>

      </aside><%# /wiki-detail-right %>

    </div><%# /wiki-detail-layout %>

    <%# ─ Suggestions ─ %>
    <% if (suggestions && suggestions.length) { %>
      <div class="wiki-suggestions">
        <h3 class="wiki-sugg-heading" data-fr="Pages similaires" data-en="Similar pages">Pages similaires</h3>
        <div class="wiki-sugg-row">
          <% suggestions.forEach(function (s) { %>
            <% var scat = categories.find(function (c) { return c.key === s.category; }); %>
            <a href="/wiki/<%= s.id %>" class="wiki-sugg-card">
              <% if (s.imagePaths && s.imagePaths.length && currentUser) { %>
                <div class="wiki-sugg-img-wrap"><img src="<%= thumbUrl(s.imagePaths[0]) %>" alt="" class="wiki-sugg-img" loading="lazy" /></div>
              <% } %>
              <span class="wiki-sugg-badge" style="background: hsl(<%= scat ? scat.hue : 220 %>, 55%, 45%)" data-fr="<%= scat ? scat.label : s.category %>" data-en="<%= scat ? (WD_CAT_EN[scat.key] || scat.label) : s.category %>"><%= scat ? scat.label : s.category %></span>
              <span class="wiki-sugg-title"><%= s.title %></span>
              <% if (s.rating) { %><span class="wiki-sugg-stars"><% for (var si2=1;si2<=s.rating;si2++){ %>&#9733;<% } %></span><% } %>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

