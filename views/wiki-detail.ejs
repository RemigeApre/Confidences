            <a href="<%= backHref %>" class="wiki-chapter-hero-back wiki-left-back-btn" title="<%= backLabel %>" aria-label="<%= backLabel %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <% if (cat) { %>
              <a href="/wiki/categorie/<%= page.category %>" class="wiki-chapter-hero-title wiki-left-cat-hero-title" data-fr="<%= cat.label %>" data-en="<%= WD_CAT_EN[page.category] || cat.label %>"><%= cat.label %></a>
            <% } else { %>
              <span class="wiki-chapter-hero-title wiki-left-cat-hero-title"></span>
            <% } %>
            <% if (page.category === 'partenaires' && (pm.sous_cat === 'monstre' || pm.sous_cat === 'animaux')) { %>
              <details class="wiki-editorial-note">
                <summary class="wiki-editorial-icon" title="Note &eacute;ditoriale" data-fr="Note éditoriale" data-en="Editorial note">!</summary>
                <div class="wiki-editorial-body">
                  <p class="wiki-editorial-body-title" data-fr="Note éditoriale" data-en="Editorial note">Note &eacute;ditoriale</p>
                  <p data-fr="La zoophilie comme fantasme n'est traitée que sur l'idée femme–animal, idem pour les monstres, femme–monstre, sauf cas particulier. C'est un choix éditorial, et une volonté." data-en="Zoophilia as a fantasy is only covered from the woman–animal perspective, same for monsters (woman–monster), except in specific cases. This is an editorial choice, and a deliberate one.">La zoophilie comme fantasme n&rsquo;est trait&eacute;e que sur l&rsquo;id&eacute;e femme&ndash;animal, idem pour les monstres, femme&ndash;monstre, sauf cas particulier. C&rsquo;est un choix &eacute;ditorial, et une volont&eacute;.</p>
                  <% if (currentUser) { %>
                    <p data-fr="Le rapport femme–autre espèce part du postulat où l'animal est consentant, ce que le rapport homme–animal ne permet pas du tout. De plus, c'est aussi un choix esthétique : le site et sa ligne éditoriale ont goût de l'élégance, que ne posséderait en rien l'homme en ce contexte de fantasme." data-en="The woman–other species dynamic rests on the premise that the animal is willing, which the man–animal dynamic simply does not allow. It is also an aesthetic choice: the site and its editorial line favour elegance, something a male perspective would entirely lack in this fantasy context.">Le rapport femme&ndash;autre esp&egrave;ce part du postulat o&ugrave; l&rsquo;animal est consentant, ce que le rapport homme&ndash;animal ne permet pas du tout. De plus, c&rsquo;est aussi un choix esth&eacute;tique&nbsp;: le site et sa ligne &eacute;ditoriale ont go&ucirc;t de l&rsquo;&eacute;l&eacute;gance, que ne poss&egrave;derait en rien l&rsquo;homme en ce contexte de fantasme.</p>
                  <% } %>
                </div>
              </details>
            <% } else { %>
              <span></span>
            <% } %>
          </div>
        </div>

        <% if (currentUser && ['objets','tenues'].indexOf(page.category) !== -1) { %>
          <div class="wiki-left-status" data-page-id="<%= page.id %>">
            <button type="button" class="wiki-left-status-btn<%= userWikiStatus === 'posséde' ? ' active' : '' %>" data-status="posséde">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Je poss&egrave;de
            </button>
            <button type="button" class="wiki-left-status-btn<%= userWikiStatus === 'souhaite' ? ' active' : '' %>" data-status="souhaite">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              Je souhaite
            </button>
          </div>
        <% } %>

        <%# ─ Partenaires : affichage riche complet ─ %>
        <% if (page.category === 'partenaires') { %>
          <%
            var hasCommuns  = pm.nature_acte || pm.cadre_legal || pm.risque_physique || pm.risque_mst || pm.accessibilite;
            var hasMonstre  = pm.type_creature || (pm.type_acte_sexuel && pm.type_acte_sexuel.length) || pm.niveau_intelligence || pm.capacite_parole || pm.compat_anatomique || pm.origine_conceptuelle;
            var tailleStr   = pm.taille_penis_qual ? (QUAL_LBL[pm.taille_penis_qual] || pm.taille_penis_qual) : ((pm.taille_penis_min || pm.taille_penis_max) ? (pm.taille_penis_min||'?')+'\u2013'+(pm.taille_penis_max||'?')+'\u00a0cm' : '');
            var circStr     = pm.circ_penis_qual   ? (QUAL_LBL[pm.circ_penis_qual]   || pm.circ_penis_qual)   : ((pm.circ_penis_min   || pm.circ_penis_max)   ? (pm.circ_penis_min||'?')+'\u2013'+(pm.circ_penis_max||'?')+'\u00a0cm' : '');
            var ejacStr     = pm.vol_ejac_qual     ? (QUAL_LBL[pm.vol_ejac_qual]     || pm.vol_ejac_qual)     : ((pm.vol_ejac_min     || pm.vol_ejac_max)     ? (pm.vol_ejac_min||'?')+'\u2013'+(pm.vol_ejac_max||'?')+'\u00a0ml' : '');
            var hasSperme   = pm.sperme_texture || pm.sperme_odeur || pm.sperme_gout;
            var hasBioData  = pm.nature_espece || tailleStr || circStr || ejacStr || hasSperme || pm.type_verrouillage || (pm.sensations && pm.sensations.length) || pm.milieu_vie || pm.structure_sociale;
          %>
          <div class="wiki-left-part wiki-left-part--<%= pm.sous_cat || 'autre' %>">

            <%# Badge type %>
            <% if (pm.sous_cat && SOUS_CAT_PART[pm.sous_cat]) { %>
              <div class="wiki-lp-type-badge" data-fr="<%= SOUS_CAT_PART[pm.sous_cat] %>" data-en="<%= SOUS_CAT_PART_EN[pm.sous_cat] || SOUS_CAT_PART[pm.sous_cat] %>"><%= SOUS_CAT_PART[pm.sous_cat] %></div>
            <% } %>

            <%# Genre / switch de variante %>
            <%
              var GENRE_LBL    = { male: 'Mâle', female: 'Femelle', neutre: 'Neutre / Autre', les_deux: 'Les deux' };
              var GENRE_LBL_EN = { male: 'Male', female: 'Female', neutre: 'Neutral / Other', les_deux: 'Both' };
              var GENRE_SYM = { male: '♂', female: '♀', neutre: '⚬', les_deux: '⚥' };
              var genreVal = pm.genre_partenaire || '';
            %>
            <% if (variantePage) { %>
              <%
                var vmGenre = (variantePage.meta || {}).genre_partenaire || '';
                var myLabel   = GENRE_LBL[genreVal] || genreVal;
                var myLabelEn = GENRE_LBL_EN[genreVal] || myLabel;
                var vmLabel   = GENRE_LBL[vmGenre] || vmGenre;
                var vmLabelEn = GENRE_LBL_EN[vmGenre] || vmLabel;
                var mySym   = GENRE_SYM[genreVal] || '';
                var vmSym   = GENRE_SYM[vmGenre] || '';
              %>
              <div class="wiki-lp-genre-switch">
                <span class="wiki-lp-genre-btn wiki-lp-genre-btn--active" data-fr="<%= mySym %> <%= myLabel %>" data-en="<%= mySym %> <%= myLabelEn %>"><%= mySym %> <%= myLabel %></span>
                <a href="/wiki/<%= variantePage.id %>" class="wiki-lp-genre-btn wiki-lp-genre-btn--other" data-fr="<%= vmSym %> <%= vmLabel %>" data-en="<%= vmSym %> <%= vmLabelEn %>"><%= vmSym %> <%= vmLabel %></a>
              </div>
            <% } else if (genreVal && genreVal !== 'les_deux') { %>
              <div class="wiki-lp-genre-badge">
                <span data-fr="<%= GENRE_SYM[genreVal] || '' %> <%= GENRE_LBL[genreVal] || '' %>" data-en="<%= GENRE_SYM[genreVal] || '' %> <%= GENRE_LBL_EN[genreVal] || '' %>"><%= GENRE_SYM[genreVal] || '' %> <%= GENRE_LBL[genreVal] || '' %></span>
              </div>
            <% } %>

            <%# Général %>
            <% if (hasCommuns) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title" data-fr="Général" data-en="General">G&eacute;n&eacute;ral</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.nature_acte && NATURE_ACTE_LBL[pm.nature_acte]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Nature" data-en="Nature">Nature</dt><dd data-fr="<%= NATURE_ACTE_LBL[pm.nature_acte] %>" data-en="<%= NATURE_ACTE_LBL_EN[pm.nature_acte] || NATURE_ACTE_LBL[pm.nature_acte] %>"><%= NATURE_ACTE_LBL[pm.nature_acte] %></dd></div>
                  <% } %>
                  <% if (pm.cadre_legal && CADRE_LEGAL_LBL[pm.cadre_legal]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Légalité" data-en="Legality">L&eacute;galit&eacute;</dt><dd class="wiki-lp-legal wiki-lp-legal--<%= pm.cadre_legal %>" data-fr="<%= CADRE_LEGAL_LBL[pm.cadre_legal] %>" data-en="<%= CADRE_LEGAL_LBL_EN[pm.cadre_legal] || CADRE_LEGAL_LBL[pm.cadre_legal] %>"><%= CADRE_LEGAL_LBL[pm.cadre_legal] %></dd></div>
                  <% } %>
                  <% if (pm.risque_physique && RISQUE_LBL[pm.risque_physique]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Risque phys." data-en="Phys. risk">Risque phys.</dt><dd><span class="wiki-lp-risk wiki-lp-risk--<%= pm.risque_physique %>" data-fr="<%= RISQUE_LBL[pm.risque_physique] %>" data-en="<%= RISQUE_LBL_EN[pm.risque_physique] || RISQUE_LBL[pm.risque_physique] %>"><%= RISQUE_LBL[pm.risque_physique] %></span></dd></div>
                  <% } %>
                  <% if (pm.risque_mst && RISQUE_LBL[pm.risque_mst]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Risque MST" data-en="STI risk">Risque MST</dt><dd><span class="wiki-lp-risk wiki-lp-risk--<%= pm.risque_mst %>" data-fr="<%= RISQUE_LBL[pm.risque_mst] %>" data-en="<%= RISQUE_LBL_EN[pm.risque_mst] || RISQUE_LBL[pm.risque_mst] %>"><%= RISQUE_LBL[pm.risque_mst] %></span></dd></div>
                  <% } %>
                  <% if (pm.accessibilite && ACCES_LBL[pm.accessibilite]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Accès" data-en="Access">Acc&egrave;s</dt><dd data-fr="<%= ACCES_LBL[pm.accessibilite] %>" data-en="<%= ACCES_LBL_EN[pm.accessibilite] || ACCES_LBL[pm.accessibilite] %>"><%= ACCES_LBL[pm.accessibilite] %></dd></div>
                  <% } %>
                </dl>
              </div>
            <% } %>

            <%# Nombre %>
            <% if (pm.sous_cat === 'nombre' && (pm.nb_total || pm.nb_feminin || pm.nb_masculin)) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title" data-fr="Composition" data-en="Composition">Composition</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.nb_total)    { %><div class="wiki-lp-row"><dt data-fr="Total" data-en="Total">Total</dt><dd><%= pm.nb_total    === '5plus' ? '5+' : pm.nb_total    %></dd></div><% } %>
                  <% if (pm.nb_feminin)  { %><div class="wiki-lp-row"><dt data-fr="Féminin" data-en="Female">F&eacute;minin</dt><dd><%= pm.nb_feminin  === '3plus' ? '3+' : pm.nb_feminin  %></dd></div><% } %>
                  <% if (pm.nb_masculin) { %><div class="wiki-lp-row"><dt data-fr="Masculin" data-en="Male">Masculin</dt><dd><%= pm.nb_masculin === '3plus' ? '3+' : pm.nb_masculin %></dd></div><% } %>
                </dl>
              </div>
            <% } %>

            <%# Monstre %>
            <% if (pm.sous_cat === 'monstre' && hasMonstre) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title" data-fr="Caractéristiques" data-en="Characteristics">Caract&eacute;ristiques</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.type_creature && TYPE_CREATURE_LBL[pm.type_creature]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Créature" data-en="Creature">Cr&eacute;ature</dt><dd data-fr="<%= TYPE_CREATURE_LBL[pm.type_creature] %>" data-en="<%= TYPE_CREATURE_LBL_EN[pm.type_creature] || TYPE_CREATURE_LBL[pm.type_creature] %>"><%= TYPE_CREATURE_LBL[pm.type_creature] %></dd></div>
                  <% } %>
                  <% if (pm.type_acte_sexuel && pm.type_acte_sexuel.length) { %>
                    <div class="wiki-lp-row wiki-lp-row--chips">
                      <dt data-fr="Acte(s)" data-en="Act(s)">Acte(s)</dt>
                      <dd><div class="wiki-lp-chips"><% pm.type_acte_sexuel.forEach(function(v){ %><span class="wiki-lp-chip" data-fr="<%= TYPE_ACTE_LBL[v] || v %>" data-en="<%= TYPE_ACTE_LBL_EN[v] || TYPE_ACTE_LBL[v] || v %>"><%= TYPE_ACTE_LBL[v] || v %></span><% }) %></div></dd>
                    </div>
                  <% } %>
                  <% if (pm.niveau_intelligence && INTEL_LBL[pm.niveau_intelligence]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Intelligence" data-en="Intelligence">Intelligence</dt><dd data-fr="<%= INTEL_LBL[pm.niveau_intelligence] %>" data-en="<%= INTEL_LBL_EN[pm.niveau_intelligence] || INTEL_LBL[pm.niveau_intelligence] %>"><%= INTEL_LBL[pm.niveau_intelligence] %></dd></div>
                  <% } %>
                  <% if (pm.capacite_parole && PAROLE_LBL[pm.capacite_parole]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Parole" data-en="Speech">Parole</dt><dd data-fr="<%= PAROLE_LBL[pm.capacite_parole] %>" data-en="<%= PAROLE_LBL_EN[pm.capacite_parole] || PAROLE_LBL[pm.capacite_parole] %>"><%= PAROLE_LBL[pm.capacite_parole] %></dd></div>
                  <% } %>
                  <% if (pm.compat_anatomique && COMPAT_LBL[pm.compat_anatomique]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Anatomie" data-en="Anatomy">Anatomie</dt><dd data-fr="<%= COMPAT_LBL[pm.compat_anatomique] %>" data-en="<%= COMPAT_LBL_EN[pm.compat_anatomique] || COMPAT_LBL[pm.compat_anatomique] %>"><%= COMPAT_LBL[pm.compat_anatomique] %></dd></div>
                  <% } %>
                  <% if (pm.origine_conceptuelle && ORIGINE_LBL[pm.origine_conceptuelle]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Origine" data-en="Origin">Origine</dt><dd data-fr="<%= ORIGINE_LBL[pm.origine_conceptuelle] %>" data-en="<%= ORIGINE_LBL_EN[pm.origine_conceptuelle] || ORIGINE_LBL[pm.origine_conceptuelle] %>"><%= ORIGINE_LBL[pm.origine_conceptuelle] %></dd></div>
                  <% } %>
                </dl>
              </div>
            <% } %>

            <%# Animal %>
            <% if (pm.sous_cat === 'animaux' && (pm.famille_zoologique || pm.taille_animal)) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title" data-fr="Zoologie" data-en="Zoology">Zoologie</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.famille_zoologique && FAMILLE_ZOO_LBL[pm.famille_zoologique]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Famille" data-en="Family">Famille</dt><dd data-fr="<%= FAMILLE_ZOO_LBL[pm.famille_zoologique] %>" data-en="<%= FAMILLE_ZOO_LBL_EN[pm.famille_zoologique] || FAMILLE_ZOO_LBL[pm.famille_zoologique] %>"><%= FAMILLE_ZOO_LBL[pm.famille_zoologique] %></dd></div>
                  <% } %>
                  <% if (pm.taille_animal && TAILLE_ANIM_LBL[pm.taille_animal]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Taille" data-en="Size">Taille</dt><dd data-fr="<%= TAILLE_ANIM_LBL[pm.taille_animal] %>" data-en="<%= TAILLE_ANIM_LBL_EN[pm.taille_animal] || TAILLE_ANIM_LBL[pm.taille_animal] %>"><%= TAILLE_ANIM_LBL[pm.taille_animal] %></dd></div>
                  <% } %>
                </dl>
              </div>
            <% } %>

            <%# Biologie %>
            <% if ((pm.sous_cat === 'monstre' || pm.sous_cat === 'animaux') && hasBioData) { %>
              <div class="wiki-lp-group">
                <p class="wiki-lp-group-title" data-fr="Biologie" data-en="Biology">Biologie</p>
                <dl class="wiki-lp-dl">
                  <% if (pm.nature_espece && NATURE_ESP_LBL[pm.nature_espece]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Espèce" data-en="Species">Esp&egrave;ce</dt><dd data-fr="<%= NATURE_ESP_LBL[pm.nature_espece] %>" data-en="<%= NATURE_ESP_LBL_EN[pm.nature_espece] || NATURE_ESP_LBL[pm.nature_espece] %>"><%= NATURE_ESP_LBL[pm.nature_espece] %></dd></div>
                  <% } %>
                  <% if (tailleStr) { %><div class="wiki-lp-row"><dt data-fr="Pénis" data-en="Penis">P&eacute;nis</dt><dd><%= tailleStr %></dd></div><% } %>
                  <% if (circStr)   { %><div class="wiki-lp-row"><dt data-fr="Circonf." data-en="Circumf.">Circonf.</dt><dd><%= circStr %></dd></div><% } %>
                  <% if (ejacStr)   { %><div class="wiki-lp-row"><dt data-fr="Éjac." data-en="Ejac.">&Eacute;jac.</dt><dd><%= ejacStr %></dd></div><% } %>
                  <% if (hasSperme) { %>
                    <div class="wiki-lp-row"><dt data-fr="Sperme" data-en="Cum">Sperme</dt><dd><%= [pm.sperme_texture, pm.sperme_odeur, pm.sperme_gout].filter(Boolean).join(' \u00b7 ') %></dd></div>
                  <% } %>
                  <% if (pm.type_verrouillage && VERR_LBL[pm.type_verrouillage]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Verr." data-en="Lock">Verr.</dt><dd data-fr="<%= VERR_LBL[pm.type_verrouillage] %>" data-en="<%= VERR_LBL_EN[pm.type_verrouillage] || VERR_LBL[pm.type_verrouillage] %>"><%= VERR_LBL[pm.type_verrouillage] %></dd></div>
                  <% } %>
                  <% if (pm.sensations && pm.sensations.length) { %>
                    <div class="wiki-lp-row wiki-lp-row--chips">
                      <dt data-fr="Sensations" data-en="Sensations">Sensations</dt>
                      <dd><div class="wiki-lp-chips"><% pm.sensations.forEach(function(v){ %><span class="wiki-lp-chip" data-fr="<%= SENS_LBL[v] || v %>" data-en="<%= SENS_LBL_EN[v] || SENS_LBL[v] || v %>"><%= SENS_LBL[v] || v %></span><% }) %></div></dd>
                    </div>
                  <% } %>
                  <% if (pm.milieu_vie && MILIEU_LBL[pm.milieu_vie]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Milieu" data-en="Habitat">Milieu</dt><dd data-fr="<%= MILIEU_LBL[pm.milieu_vie] %>" data-en="<%= MILIEU_LBL_EN[pm.milieu_vie] || MILIEU_LBL[pm.milieu_vie] %>"><%= MILIEU_LBL[pm.milieu_vie] %></dd></div>
                  <% } %>
                  <% if (pm.structure_sociale && STRUCT_LBL[pm.structure_sociale]) { %>
                    <div class="wiki-lp-row"><dt data-fr="Structure" data-en="Structure">Structure</dt><dd data-fr="<%= STRUCT_LBL[pm.structure_sociale] %>" data-en="<%= STRUCT_LBL_EN[pm.structure_sociale] || STRUCT_LBL[pm.structure_sociale] %>"><%= STRUCT_LBL[pm.structure_sociale] %></dd></div>
                  <% } %>
                </dl>
              </div>
            <% } %>

          </div><%# /wiki-left-part %>

        <% } else if (hasMetaRows) { %>
          <%# Autres catégories : dl existant %>
          <dl class="wiki-left-meta">
            <% if (page.category === 'pratique' && pm.sous_cat && PRATIQUES_SOUS[pm.sous_cat]) { %>
              <div class="wiki-left-meta-row"><dt data-fr="Sous-catégorie" data-en="Sub-category">Sous-cat&eacute;gorie</dt><dd data-fr="<%= PRATIQUES_SOUS[pm.sous_cat] %>" data-en="<%= PRATIQUES_SOUS_EN[pm.sous_cat] || PRATIQUES_SOUS[pm.sous_cat] %>"><%= PRATIQUES_SOUS[pm.sous_cat] %></dd></div>
            <% } %>
            <% if (page.category === 'tenues' && pm.sous_cat && TENUES_SOUS[pm.sous_cat]) { %>
              <div class="wiki-left-meta-row"><dt data-fr="Sous-catégorie" data-en="Sub-category">Sous-cat&eacute;gorie</dt><dd data-fr="<%= TENUES_SOUS[pm.sous_cat] %>" data-en="<%= TENUES_SOUS_EN[pm.sous_cat] || TENUES_SOUS[pm.sous_cat] %>"><%= TENUES_SOUS[pm.sous_cat] %></dd></div>
            <% } %>
            <% if (page.category === 'fantasmes' && pm.sous_cat && FSUBS[pm.sous_cat]) { %>
              <div class="wiki-left-meta-row"><dt data-fr="Sous-catégorie" data-en="Sub-category">Sous-cat&eacute;gorie</dt><dd data-fr="<%= FSUBS[pm.sous_cat] %>" data-en="<%= FSUBS_EN[pm.sous_cat] || FSUBS[pm.sous_cat] %>"><%= FSUBS[pm.sous_cat] %></dd></div>
            <% } %>
            <% if (page.category === 'objets' && pm.sous_cat && OBJETS_SOUS[pm.sous_cat]) { %>
              <div class="wiki-left-meta-row"><dt data-fr="Catégorie" data-en="Category">Cat&eacute;gorie</dt><dd data-fr="<%= OBJETS_SOUS[pm.sous_cat] %>" data-en="<%= OBJETS_SOUS_EN[pm.sous_cat] || OBJETS_SOUS[pm.sous_cat] %>"><%= OBJETS_SOUS[pm.sous_cat] %></dd></div>
            <% } %>
            <% if (page.category === 'lieux' && pm.type_lieu && LIEU[pm.type_lieu]) { %>
              <div class="wiki-left-meta-row"><dt data-fr="Type de lieu" data-en="Venue type">Type de lieu</dt><dd data-fr="<%= LIEU[pm.type_lieu] %>" data-en="<%= LIEU_EN[pm.type_lieu] || LIEU[pm.type_lieu] %>"><%= LIEU[pm.type_lieu] %></dd></div>
            <% } %>
            <% if (hasPosMeta) { %>
              <% if (pm.categorie && POSCAT[pm.categorie]) { %><div class="wiki-left-meta-row"><dt data-fr="Catégorie" data-en="Category">Cat&eacute;gorie</dt><dd data-fr="<%= POSCAT[pm.categorie] %>" data-en="<%= POSCAT_EN[pm.categorie] || POSCAT[pm.categorie] %>"><%= POSCAT[pm.categorie] %></dd></div><% } %>
              <% if (pm.qui_dessus && QUI[pm.qui_dessus]) { %><div class="wiki-left-meta-row"><dt data-fr="Au-dessus" data-en="On top">Au-dessus</dt><dd data-fr="<%= QUI[pm.qui_dessus] %>" data-en="<%= QUI_EN[pm.qui_dessus] || QUI[pm.qui_dessus] %>"><%= QUI[pm.qui_dessus] %></dd></div><% } %>
              <% if (pm.canal && pm.canal.length) { %>
                <%
                  var _canalFr = pm.canal.map(function(c){ return CAN[c] || c; }).join(' · ');
                  var _canalEn = pm.canal.map(function(c){ return CAN_EN[c] || CAN[c] || c; }).join(' · ');
                %>
                <div class="wiki-left-meta-row"><dt data-fr="Canal" data-en="Channel">Canal</dt><dd data-fr="<%= _canalFr %>" data-en="<%= _canalEn %>"><%= pm.canal.map(function(c){ return CAN[c] || c; }).join(' &middot; ') %></dd></div>
              <% } %>
              <% if (pmOri.length) { %>
                <%
                  var _oriFr = pmOri.map(function(o){ return ORI[o] || o; }).join(' · ');
                  var _oriEn = pmOri.map(function(o){ return ORI_EN[o] || ORI[o] || o; }).join(' · ');
                %>
                <div class="wiki-left-meta-row"><dt data-fr="Orientation" data-en="Orientation">Orientation</dt><dd data-fr="<%= _oriFr %>" data-en="<%= _oriEn %>"><%= pmOri.map(function(o){ return ORI[o] || o; }).join(' &middot; ') %></dd></div>
              <% } %>
              <% if (pm.nb_partenaires && NBPART[pm.nb_partenaires]) { %><div class="wiki-left-meta-row"><dt data-fr="Partenaires" data-en="Partners">Partenaires</dt><dd data-fr="<%= NBPART[pm.nb_partenaires] %>" data-en="<%= NBPART_EN[pm.nb_partenaires] || NBPART[pm.nb_partenaires] %>"><%= NBPART[pm.nb_partenaires] %></dd></div><% } %>
              <% if (pm.partenaire_actif && ACTIF[pm.partenaire_actif]) { %><div class="wiki-left-meta-row"><dt data-fr="Partenaire actif" data-en="Active partner">Partenaire actif</dt><dd data-fr="<%= ACTIF[pm.partenaire_actif] %>" data-en="<%= ACTIF_EN[pm.partenaire_actif] || ACTIF[pm.partenaire_actif] %>"><%= ACTIF[pm.partenaire_actif] %></dd></div><% } %>
              <% if (pmSup.length) { %>
                <%
                  var _supFr = pmSup.map(function(s){ return SUP[s] || s; }).join(' · ');
                  var _supEn = pmSup.map(function(s){ return SUP_EN[s] || SUP[s] || s; }).join(' · ');
                %>
                <div class="wiki-left-meta-row"><dt data-fr="Supports" data-en="Surfaces">Supports</dt><dd data-fr="<%= _supFr %>" data-en="<%= _supEn %>"><%= pmSup.map(function(s){ return SUP[s] || s; }).join(' &middot; ') %></dd></div>
              <% } %>
            <% } %>
          </dl>
        <% } %>

        <% if (page.parody) { %>
          <div class="wiki-left-parody">
            <span class="wiki-left-parody-label" data-fr="Parodie" data-en="Parody">Parodie</span>
            <a href="/parodies/<%= encodeURIComponent(page.parody) %>" class="wiki-left-parody-link"><%= page.parody %></a>
            <% if (page.subParody) { %>
              <span class="wiki-left-parody-sep">›</span>
              <a href="/parodies/<%= encodeURIComponent(page.parody) %>/<%= encodeURIComponent(page.subParody) %>" class="wiki-left-parody-link wiki-left-parody-sub"><%= page.subParody %></a>
            <% } %>
          </div>
        <% } %>

        <%
          var _updDateFr = new Date(page.updatedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
          var _updDateEn = new Date(page.updatedAt).toLocaleDateString('en-GB',  { day: 'numeric', month: 'long', year: 'numeric' });
        %>

        <%# ── Auteur(s) (E-E-A-T) ── %>
        <% if (locals.pageAuthorMain) { %>
          <div class="wiki-authors-block">
            <a href="/auteurs/<%= pageAuthorMain.slug %>" class="wiki-author-main" title="<%= pageAuthorMain.credentials %>">
              <% if (pageAuthorMain.avatar_url) { %>
                <img src="<%= pageAuthorMain.avatar_url %>" alt="" class="wiki-author-avatar" />
              <% } else { %>
                <span class="wiki-author-avatar wiki-author-avatar-placeholder" aria-hidden="true">&#x1F464;</span>
              <% } %>
              <span class="wiki-author-info">
                <span class="wiki-author-name"><%= pageAuthorMain.name %></span>
                <% if (pageAuthorMain.credentials) { %><span class="wiki-author-creds"><%= pageAuthorMain.credentials %></span><% } %>
              </span>
            </a>
            <% if (locals.pageAuthorsSecondary && pageAuthorsSecondary.length) { %>
              <div class="wiki-authors-secondary">
                <% pageAuthorsSecondary.forEach(function(a) { %>
                  <a href="/auteurs/<%= a.slug %>" class="wiki-author-secondary-item">
                    <span class="wiki-author-secondary-name"><%= a.name %></span>
                    <span class="wiki-author-secondary-role"><%= a.role %></span>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% } %>

        <%# Pied du volet gauche — fusionné %>
        <div class="wiki-left-footer">
          <%# Ligne date + copier %>
          <button type="button" class="wiki-left-copy-row" id="wiki-copy-ai-btn"
                  title="Copier un résumé textuel de cette fiche" aria-label="Copier">
            <svg class="wiki-left-copy-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
            <span class="wiki-left-updated" data-fr="Derni&egrave;re modif.&nbsp;: <%= _updDateFr %>" data-en="Updated: <%= _updDateEn %>">Derni&egrave;re modif.&nbsp;: <%= _updDateFr %></span>
          </button>

          <%# Bloc admin : édition + maturité (fusionné) ─ %>
          <% if (currentUser && currentUser.isAdmin) { %>
          <div class="wiki-left-admin-block" id="wiki-maturity-widget" data-id="<%= page.id %>" data-level="<%= page.maturity || 0 %>">
            <a href="/wiki/<%= page.slug || page.id %>/edit" class="wiki-left-edit-btn" title="Modifier" aria-label="Modifier">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="15" height="15" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
              <span>Modifier</span>
            </a>
            <div class="wiki-left-maturity">
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity||0)===0?' active':'' %>" data-level="0" title="Brouillon">B</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity||0)===1?' active':'' %>" data-level="1" title="Écrite">1</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity||0)===2?' active':'' %>" data-level="2" title="Relue">2</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity||0)===3?' active':'' %>" data-level="3" title="Illustrée">3</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity||0)===4?' active':'' %>" data-level="4" title="Validée">4</button>
              <button type="button" class="wiki-maturity-lvl<%= (page.maturity||0)===5?' active':'' %>" data-level="5" title="Publiée">&#10003;</button>
            </div>
          </div>
          <% } %>
        </div>

      </aside>

      <%# ─ COLONNE GAUCHE : contenu texte ─ %>
      <div class="wiki-detail-body">

        <%# Introduction thématique : partenaires non-humains (monstres / animaux) ─ %>
        <% if (page.category === 'partenaires' && (pm.sous_cat === 'monstre' || pm.sous_cat === 'animaux')) { %>
        <details class="wiki-thematic-intro">
          <summary class="wiki-thematic-intro-summary" data-fr="Introduction" data-en="Introduction">Introduction</summary>
          <div class="wiki-thematic-intro-body">
            <p data-fr="La femme, sujet de convoitise, d'admiration ou de vénération, devient l'objet d'attention de ce qui n'est pas humain. Si belle, si sensuelle, si désirable que ces qualités dépassent l'espèce : elle devient nature et divine par cela." data-en="The woman, subject of desire, admiration or veneration, becomes the object of attention of what is not human. So beautiful, so sensual, so desirable that these qualities transcend species: she becomes nature itself, and divine because of it.">La femme, sujet de convoitise, d&rsquo;admiration ou de v&eacute;n&eacute;ration, devient l&rsquo;objet d&rsquo;attention de ce qui n&rsquo;est pas humain. Si belle, si sensuelle, si d&eacute;sirable que ces qualit&eacute;s d&eacute;passent l&rsquo;esp&egrave;ce&nbsp;: elle devient nature et divine par cela.</p>
            <p data-fr="Ces fantasmes placent la femme au centre d'un regard absolu ; un désir sans langage commun, sans conventions sociales, sans retenue culturelle. Ce qui ne peut pas parler ne peut pas mentir. Ce qui ne connaît pas les codes humains ne peut qu'obéir à l'instinct : celui d'être attiré, irrésistiblement, par elle." data-en="These fantasies place the woman at the centre of an absolute gaze: a desire with no common language, no social conventions, no cultural restraint. What cannot speak cannot lie. What does not know human codes can only obey instinct: to be drawn, irresistibly, to her.">Ces fantasmes placent la femme au centre d&rsquo;un regard absolu&nbsp;; un d&eacute;sir sans langage commun, sans conventions sociales, sans retenue culturelle. Ce qui ne peut pas parler ne peut pas mentir. Ce qui ne conna&icirc;t pas les codes humains ne peut qu&rsquo;ob&eacute;ir &agrave; l&rsquo;instinct&nbsp;: celui d&rsquo;&ecirc;tre attir&eacute;, irr&eacute;sistiblement, par elle.</p>
          </div>
        </details>
        <% } %>

        <%# Description markdown ─ %>
        <% var _wdContent = t(page.content, 'wiki', page.id, 'content'); %>
        <% if (_wdContent) { %>
          <div class="wiki-md" data-wiki-field="content"><span class="wiki-md-raw" hidden><%= _wdContent %></span></div>
          <%# Fallback pour agents IA/navigateurs sans JS : contenu brut visible dans l'arbre d'accessibilité %>
          <noscript><div class="wiki-noscript-content"><%- _wdContent %></div></noscript>
        <% } %>

        <%# Image principale — mobile uniquement, glissée par JS avant le 1er h2 ─ %>
        <% if (hasImages) { %>
          <div class="wiki-mobile-hero" id="wiki-mobile-hero" aria-hidden="true">
            <img src="<%= thumbUrl(visibleImagePaths[0]) %>" data-src="<%= visibleImagePaths[0] %>" alt="<%= page.title %>" class="wiki-mobile-hero-img" loading="lazy" data-lb-bound="1" style="cursor:zoom-in" />
          </div>
        <% } %>

        <%# Variantes (positions) ─ %>
        <% if (page.category === 'position' && pm.variantes && pm.variantes.length) { %>
          <div class="wiki-pos-section wiki-pos-variantes">
            <h3 class="wiki-pos-section-heading" data-fr="Variantes" data-en="Variants">Variantes</h3>
            <% pm.variantes.forEach(function(v) { %>
              <% if (!v.nom) return; %>
              <details class="wiki-var-detail">
                <summary class="wiki-var-summary"><%= v.nom %></summary>
                <div class="wiki-var-body">
                  <% if (v.description) { %><div class="wiki-md"><span class="wiki-md-raw" hidden><%= v.description %></span></div><% } %>
                  <% if ((currentUser || !isFrenchVisitor) && v.images && v.images.length) { %>
                    <div class="wiki-var-images"><% v.images.forEach(function(src) { %><img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-var-img" loading="lazy" /><% }) %></div>
                  <% } %>
                  <% if (v.variantes && v.variantes.length) { %>
                    <% v.variantes.forEach(function(sv) { %>
                      <% if (!sv.nom) return; %>
                      <details class="wiki-var-detail wiki-var-sub-detail">
                        <summary class="wiki-var-summary"><%= sv.nom %></summary>
                        <div class="wiki-var-body">
                          <% if (sv.description) { %><div class="wiki-md"><span class="wiki-md-raw" hidden><%= sv.description %></span></div><% } %>
                          <% if ((currentUser || !isFrenchVisitor) && sv.images && sv.images.length) { %>
                            <div class="wiki-var-images"><% sv.images.forEach(function(src) { %><img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-var-img" loading="lazy" /><% }) %></div>
                          <% } %>
                        </div>
                      </details>
                    <% }) %>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>

        <%# Scénario (partenaires) ─ %>
        <% var _pmScenario = t(pm.scenario, 'wiki', page.id, 'meta_scenario'); %>
        <% if (page.category === 'partenaires' && _pmScenario) { %>
          <details class="wiki-pos-section wiki-pos-nouvelles wiki-scenario-details">
            <summary class="wiki-pos-section-heading wiki-scenario-summary">
              <span data-fr="Scénario" data-en="Scenario">Sc&eacute;nario</span>
              <% if (pm.scenario_human) { %>
                <span class="wiki-scenario-human-badge" data-fr="✎ 100 % humain" data-en="✎ 100% human" data-tooltip="Ce sc&#233;nario a &#233;t&#233; enti&#232;rement &#233;crit par un humain, sans IA.">&#9998;&nbsp;100&nbsp;% humain</span>
              <% } else { %>
                <span class="wiki-scenario-info" data-tooltip="Les sc&#233;narios sont &#233;crits en premier jet par une IA, corrig&#233;s et am&#233;lior&#233;s &#224; la main. Le choix de l&#8217;IA est pour illustrer litt&#233;rairement chaque page du wiki.&#10;&#10;Pour du contenu original parfaitement humain, cela se passera dans une future page d&#233;di&#233;e.">!</span>
              <% } %>
            </summary>
            <% if (pm.scenario_image) { %>
              <img src="<%= thumbUrl(pm.scenario_image) %>" data-src="<%= pm.scenario_image %>" alt="" class="wiki-scenario-img" loading="lazy" />
            <% } %>
            <div class="wiki-pos-nouvelles-text" data-wiki-field="meta_scenario"><%= _pmScenario %></div>
          </details>
        <% } %>

        <%# Orce (toutes catégories) ─ %>
        <% var _pmOrce = t(pm.orce_content, 'wiki', page.id, 'meta_orce_content'); %>
        <% if (_pmOrce) { %>
          <details class="wiki-pos-section wiki-orce-section">
            <summary class="wiki-pos-section-heading wiki-orce-summary">
              <span class="wiki-orce-logo">Orce</span>
            </summary>
            <p class="wiki-orce-pastille" data-fr="Orce est un univers de fiction, de dark fantasy. Les créatures listées ont leurs pendants, avec des noms légèrement différents, et des caractéristiques différentes. Nous intégrons ici alors le contenu descriptif lié." data-en="Orce is a fictional dark fantasy universe. The creatures listed here have counterparts with slightly different names and characteristics. We include the related descriptive content here.">Orce est un univers de fiction, de dark fantasy. Les cr&eacute;atures list&eacute;es ont leurs pendants, avec des noms l&eacute;g&egrave;rement diff&eacute;rents, et des caract&eacute;ristiques diff&eacute;rentes. Nous int&eacute;grons ici alors le contenu descriptif li&eacute;.</p>
            <% if (pm.orce_name) { %><p class="wiki-orce-name"><span data-fr="Nom en Orce\u00a0:" data-en="Name in Orce:">Nom en Orce&nbsp;:</span> <strong><%= pm.orce_name %></strong></p><% } %>
            <div class="wiki-md wiki-orce-content" data-wiki-field="meta_orce_content"><span class="wiki-md-raw" hidden><%= _pmOrce %></span></div>
          </details>
        <% } %>

        <%# Statistiques pratique / fantasme (transversal) ─ %>
        <%
          var _stType     = pm.stats_type || '';
          var _hasPratique = _stType === 'pratique' || _stType === 'both';
          var _hasFantasme = _stType === 'fantasme' || _stType === 'both';
          // Données pratiqué
          var _prPctG  = pm.stats_pct_general  != null && pm.stats_pct_general  !== '' ? pm.stats_pct_general  : null;
          var _prPctFR = pm.stats_pct_femmes   != null && pm.stats_pct_femmes   !== '' ? pm.stats_pct_femmes   : null;
          var _prPctFD = pm.stats_pct_femmes_donne != null && pm.stats_pct_femmes_donne !== '' ? pm.stats_pct_femmes_donne : null;
          var _prPctHR = pm.stats_pct_hommes   != null && pm.stats_pct_hommes   !== '' ? pm.stats_pct_hommes   : null;
          var _prPctHD = pm.stats_pct_hommes_donne != null && pm.stats_pct_hommes_donne !== '' ? pm.stats_pct_hommes_donne : null;
          // Rétro-compat : si aucun champ _donne, utiliser l'ancien stats_dir
          if (_prPctFD === null && _prPctFR !== null && pm.stats_dir_femmes === 'donne') { _prPctFD = _prPctFR; _prPctFR = null; }
          if (_prPctHD === null && _prPctHR !== null && pm.stats_dir_hommes === 'donne') { _prPctHD = _prPctHR; _prPctHR = null; }
          var _hasPrAny = _prPctG !== null || _prPctFR !== null || _prPctFD !== null || _prPctHR !== null || _prPctHD !== null;
          // Données fantasmé
          var _faPctG  = pm.stats_f_pct_general != null && pm.stats_f_pct_general !== '' ? pm.stats_f_pct_general : null;
          var _faPctF  = pm.stats_f_pct_femmes  != null && pm.stats_f_pct_femmes  !== '' ? pm.stats_f_pct_femmes  : null;
          var _faPctH  = pm.stats_f_pct_hommes  != null && pm.stats_f_pct_hommes  !== '' ? pm.stats_f_pct_hommes  : null;
          var _hasFaAny = _faPctG !== null || _faPctF !== null || _faPctH !== null;
          // Rétro-compat : ancien format 'fantasme' stockait les % dans stats_pct_* (pas stats_f_pct_*)
          if (_stType === 'fantasme' && !_hasFaAny && _hasPrAny) {
            _faPctG = _prPctG; _faPctF = _prPctFR || _prPctFD; _faPctH = _prPctHR || _prPctHD;
            _hasFaAny = _faPctG !== null || _faPctF !== null || _faPctH !== null;
            _hasPrAny = false; // évite d'afficher les mêmes données deux fois
          }
          var _showBlock = (_hasPratique && _hasPrAny) || (_hasFantasme && _hasFaAny);
        %>
        <% if (_showBlock) { %>
        <div class="wiki-stats-block">
          <h3 class="wiki-stats-title" data-fr="Statistiques" data-en="Statistics">Statistiques</h3>
          <div class="wiki-stats-title-sep"></div>

          <%# ── Pratiqué ── %>
          <% if (_hasPratique && _hasPrAny) { %>
          <div class="wiki-stats-section">
            <% if (_hasFantasme && _hasFaAny) { %><p class="wiki-stats-subhead" data-fr="Pratiqué" data-en="Practiced">Pratiqu&eacute;</p><% } %>
            <p class="wiki-stats-subtitle" data-fr="Pourcentage de personnes ayant réalisé cela" data-en="Percentage of people who have done this">Pourcentage de personnes ayant r&eacute;alis&eacute; cela</p>
            <div class="wiki-stats-donuts">
              <% if (_prPctG !== null) { %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= _prPctG %>;--clr:hsl(220,70%,62%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(220,80%,76%)"><%= _prPctG %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl" data-fr="Général" data-en="General">G&eacute;n&eacute;ral</span>
                </div>
              <% } %>
              <% if (_prPctFR !== null) { %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= _prPctFR %>;--clr:hsl(340,65%,62%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(340,75%,78%)"><%= _prPctFR %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl"><span data-fr="Femmes" data-en="Women">Femmes</span><br><span class="wiki-stats-dir-badge" data-fr="ont reçu" data-en="received">ont re&ccedil;u</span></span>
                </div>
              <% } %>
              <% if (_prPctFD !== null) { %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= _prPctFD %>;--clr:hsl(340,55%,52%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(340,65%,70%)"><%= _prPctFD %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl"><span data-fr="Femmes" data-en="Women">Femmes</span><br><span class="wiki-stats-dir-badge" data-fr="ont donné" data-en="gave">ont donn&eacute;</span></span>
                </div>
              <% } %>
              <% if (_prPctHR !== null) { %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= _prPctHR %>;--clr:hsl(200,70%,56%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(200,80%,74%)"><%= _prPctHR %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl"><span data-fr="Hommes" data-en="Men">Hommes</span><br><span class="wiki-stats-dir-badge" data-fr="ont reçu" data-en="received">ont re&ccedil;u</span></span>
                </div>
              <% } %>
              <% if (_prPctHD !== null) { %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= _prPctHD %>;--clr:hsl(200,60%,46%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(200,70%,64%)"><%= _prPctHD %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl"><span data-fr="Hommes" data-en="Men">Hommes</span><br><span class="wiki-stats-dir-badge" data-fr="ont donné" data-en="gave">ont donn&eacute;</span></span>
                </div>
              <% } %>
            </div>
            <% if (pm.stats_source) { %><a href="<%= pm.stats_source %>" class="wiki-stats-source" target="_blank" rel="noopener noreferrer">Source</a><% } %>
            <% if (pm.stats_note) { %><p class="wiki-stats-ctx-note"><%= pm.stats_note %></p><% } %>
          </div>
          <% } %>

          <%# ── Fantasmé ── %>
          <% if (_hasFantasme && _hasFaAny) { %>
          <div class="wiki-stats-section<%= (_hasPratique && _hasPrAny) ? ' wiki-stats-section--sep' : '' %>">
            <% if (_hasPratique && _hasPrAny) { %><p class="wiki-stats-subhead" data-fr="Fantasmé" data-en="Fantasized">Fantasm&eacute;</p><% } %>
            <p class="wiki-stats-subtitle" data-fr="Pourcentage de personnes ayant particulièrement ce fantasme" data-en="Percentage of people who particularly have this fantasy">Pourcentage de personnes ayant particuli&egrave;rement ce fantasme</p>
            <div class="wiki-stats-donuts">
              <% if (_faPctG !== null) { %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= _faPctG %>;--clr:hsl(220,70%,62%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(220,80%,76%)"><%= _faPctG %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl" data-fr="Général" data-en="General">G&eacute;n&eacute;ral</span>
                </div>
              <% } %>
              <% if (_faPctF !== null) { %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= _faPctF %>;--clr:hsl(340,65%,62%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(340,75%,78%)"><%= _faPctF %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl" data-fr="Femmes" data-en="Women">Femmes</span>
                </div>
              <% } %>
              <% if (_faPctH !== null) { %>
                <div class="wiki-stats-donut-wrap">
                  <div class="wiki-stats-donut" style="--pct:<%= _faPctH %>;--clr:hsl(200,70%,56%)">
                    <span class="wiki-stats-donut-val" style="color:hsl(200,80%,74%)"><%= _faPctH %><span class="wiki-stats-donut-sym">%</span></span>
                  </div>
                  <span class="wiki-stats-donut-lbl" data-fr="Hommes" data-en="Men">Hommes</span>
                </div>
              <% } %>
            </div>
            <% if (pm.stats_f_source) { %><a href="<%= pm.stats_f_source %>" class="wiki-stats-source" target="_blank" rel="noopener noreferrer">Source</a><% } %>
            <% if (pm.stats_f_note) { %><p class="wiki-stats-ctx-note"><%= pm.stats_f_note %></p><% } %>
          </div>
          <% } %>

          <p class="wiki-stats-note" data-fr="Ces études ont été faites sur la population commune, intégrant donc la majorité ne s'intéressant pas au domaine. Les chiffres des personnes intéressées à la sexualité sont bien plus hauts, en général." data-en="These studies were conducted on the general population, which includes the majority who are not interested in the subject. Figures for people interested in sexuality are generally much higher.">Ces &eacute;tudes ont &eacute;t&eacute; faites sur la population commune, int&eacute;grant donc la majorit&eacute; ne s&rsquo;int&eacute;ressant pas au domaine. Les chiffres des personnes int&eacute;ress&eacute;es &agrave; la sexualit&eacute; sont bien plus hauts, en g&eacute;n&eacute;ral.</p>
        </div>
        <% } %>

        <%# ── Sondage communautaire ── %>
        <%
          var _pollAlreadyVoted = userPollVote || anonAlreadyVoted;
          var _pollNeedSex      = !currentUser || !userSex || userSex === '';
          var _pollUserSexVal   = userSex || '';
        %>
        <div class="wiki-poll-block" id="wiki-poll-block" data-page-id="<%= page.id %>" data-slug="<%= page.slug || page.id %>">
          <h3 class="wiki-poll-title" data-fr="Et vous ?" data-en="And you?">Et vous&nbsp;?</h3>
          <div class="wiki-poll-title-sep"></div>

          <%# Form (caché si déjà voté) %>
          <div class="wiki-poll-form" id="wiki-poll-form"<% if (_pollAlreadyVoted) { %> hidden<% } %>>

            <% if (_pollNeedSex) { %>
            <div class="wiki-poll-sex-row" id="wiki-poll-sex-row">
              <span class="wiki-poll-sex-label" data-fr="Vous êtes" data-en="You are">Vous &ecirc;tes</span>
              <div class="wiki-poll-sex-choices">
                <button type="button" class="wiki-poll-sex-btn" data-val="femme" data-fr="Femme" data-en="Woman">Femme</button>
                <button type="button" class="wiki-poll-sex-btn" data-val="homme" data-fr="Homme" data-en="Man">Homme</button>
                <button type="button" class="wiki-poll-sex-btn" data-val="autre" data-fr="Autre" data-en="Other">Autre</button>
                <button type="button" class="wiki-poll-sex-btn" data-val="nr" data-fr="Préfère ne pas dire" data-en="Prefer not to say">NSP</button>
              </div>
            </div>
            <% } %>

            <% if (!currentUser) { %>
            <div class="wiki-poll-age-row">
              <label class="wiki-poll-age-label" data-fr="Tranche d'âge" data-en="Age range">Tranche d&rsquo;&acirc;ge</label>
              <select class="wiki-poll-age-select" id="wiki-poll-age">
                <option value="">—</option>
                <option value="18-24">18&ndash;24</option>
                <option value="25-34">25&ndash;34</option>
                <option value="35-44">35&ndash;44</option>
                <option value="45-54">45&ndash;54</option>
                <option value="55+">55+</option>
              </select>
            </div>
            <% } %>

            <div class="wiki-poll-questions">
              <div class="wiki-poll-q" data-q="fantasme">
                <span class="wiki-poll-q-label" data-fr="Avez-vous déjà fantasmé sur cela ?" data-en="Have you ever fantasized about this?">Avez-vous d&eacute;j&agrave; fantasm&eacute; sur cela&nbsp;?</span>
                <div class="wiki-poll-q-choices">
                  <button type="button" class="wiki-poll-ans-btn" data-q="fantasme" data-val="1" data-fr="Oui" data-en="Yes">Oui</button>
                  <button type="button" class="wiki-poll-ans-btn" data-q="fantasme" data-val="0" data-fr="Non" data-en="No">Non</button>
                </div>
              </div>
              <div class="wiki-poll-q" data-q="pratique">
                <span class="wiki-poll-q-label" data-fr="L'avez-vous déjà pratiqué ?" data-en="Have you ever practiced it?">L&rsquo;avez-vous d&eacute;j&agrave; pratiqu&eacute;&nbsp;?</span>
                <div class="wiki-poll-q-choices">
                  <button type="button" class="wiki-poll-ans-btn" data-q="pratique" data-val="1" data-fr="Oui" data-en="Yes">Oui</button>
                  <button type="button" class="wiki-poll-ans-btn" data-q="pratique" data-val="0" data-fr="Non" data-en="No">Non</button>
                </div>
              </div>
              <div class="wiki-poll-q wiki-poll-q--direction" id="wiki-poll-direction" hidden>
                <span class="wiki-poll-q-label" data-fr="En le pratiquant, avez-vous reçu ?" data-en="When practicing, did you receive?">En le pratiquant, avez-vous re&ccedil;u&nbsp;?</span>
                <div class="wiki-poll-q-choices">
                  <button type="button" class="wiki-poll-ans-btn" data-q="pratique_recoit" data-val="1" data-fr="Oui" data-en="Yes">Oui</button>
                  <button type="button" class="wiki-poll-ans-btn" data-q="pratique_recoit" data-val="0" data-fr="Non" data-en="No">Non</button>
                </div>
              </div>
              <div class="wiki-poll-q wiki-poll-q--direction" id="wiki-poll-donne" hidden>
                <span class="wiki-poll-q-label" data-fr="Et avez-vous donné ?" data-en="And did you give?">Et avez-vous donn&eacute;&nbsp;?</span>
                <div class="wiki-poll-q-choices">
                  <button type="button" class="wiki-poll-ans-btn" data-q="pratique_donne" data-val="1" data-fr="Oui" data-en="Yes">Oui</button>
                  <button type="button" class="wiki-poll-ans-btn" data-q="pratique_donne" data-val="0" data-fr="Non" data-en="No">Non</button>
                </div>
              </div>
            </div>

            <button type="button" class="wiki-poll-submit" id="wiki-poll-submit" disabled
              data-fr="Répondre" data-en="Submit">R&eacute;pondre</button>
          </div>

          <%# Résultats %>
          <div class="wiki-poll-results" id="wiki-poll-results"<% if (!_pollAlreadyVoted) { %> hidden<% } %>>
            <%
              var _pa = pollAggregate || { total: 0, hasEnough: false };
            %>
            <p class="wiki-poll-total">
              <% if (_pa.total === 0) { %>
                <span data-fr="Soyez le premier à répondre !" data-en="Be the first to answer!">Soyez le premier &agrave; r&eacute;pondre&nbsp;!</span>
              <% } else if (!_pa.hasEnough) { %>
                <span data-fr="<%= _pa.total %> réponse<%= _pa.total > 1 ? 's' : '' %> — résultats dès 5 réponses" data-en="<%= _pa.total %> answer<%= _pa.total > 1 ? 's' : '' %> — results from 5 answers"><%= _pa.total %> r&eacute;ponse<%= _pa.total > 1 ? 's' : '' %> &mdash; r&eacute;sultats d&egrave;s 5 r&eacute;ponses</span>
              <% } else { %>
                <span data-fr="<%= _pa.total %> réponses" data-en="<%= _pa.total %> answers"><%= _pa.total %> r&eacute;ponses</span>
              <% } %>
            </p>
            <% if (_pa.hasEnough && _pa.global) { %>
            <div class="wiki-poll-bars" id="wiki-poll-bars">
              <%
                function pollBar(label, labelEn, pct, clr) {
                  if (pct === null) return '';
                  return '<div class="wiki-poll-bar-row">'
                    + '<span class="wiki-poll-bar-lbl" data-fr="' + label + '" data-en="' + labelEn + '">' + label + '</span>'
                    + '<div class="wiki-poll-bar-track"><div class="wiki-poll-bar-fill" style="width:' + pct + '%;background:' + clr + '"></div></div>'
                    + '<span class="wiki-poll-bar-pct">' + pct + '%</span>'
                    + '</div>';
                }
              %>
              <%- pollBar('Ont fantasmé', 'Fantasized', _pa.global.pct_fantasme, 'hsl(260,55%,52%)') %>
              <%- pollBar('Ont pratiqué', 'Practiced',  _pa.global.pct_pratique, 'hsl(200,60%,46%)') %>
              <% if (_pa.global.pct_recoit !== null || _pa.global.pct_donne !== null) { %>
              <p class="wiki-poll-bars-sub" data-fr="Parmi ceux qui ont pratiqué" data-en="Among those who practiced">Parmi ceux qui ont pratiqu&eacute;</p>
              <%- pollBar('Ont reçu',  'Received', _pa.global.pct_recoit, 'hsl(340,55%,52%)') %>
              <%- pollBar('Ont donné', 'Gave',     _pa.global.pct_donne,  'hsl(340,45%,42%)') %>
              <% } %>
              <% if (_pa.femmes || _pa.hommes) { %>
              <div class="wiki-poll-bysex">
                <% if (_pa.femmes) { %>
                <div class="wiki-poll-bysex-col">
                  <p class="wiki-poll-bysex-head" data-fr="Femmes (<%= _pa.femmes.total %>)" data-en="Women (<%= _pa.femmes.total %>)">Femmes (<%= _pa.femmes.total %>)</p>
                  <%- pollBar('Fantasmé', 'Fantasized', _pa.femmes.pct_fantasme, 'hsl(260,55%,52%)') %>
                  <%- pollBar('Pratiqué', 'Practiced',  _pa.femmes.pct_pratique, 'hsl(200,60%,46%)') %>
                  <%- pollBar('Reçu', 'Received', _pa.femmes.pct_recoit, 'hsl(340,55%,52%)') %>
                  <%- pollBar('Donné', 'Gave', _pa.femmes.pct_donne, 'hsl(340,45%,42%)') %>
                </div>
                <% } %>
                <% if (_pa.hommes) { %>
                <div class="wiki-poll-bysex-col">
                  <p class="wiki-poll-bysex-head" data-fr="Hommes (<%= _pa.hommes.total %>)" data-en="Men (<%= _pa.hommes.total %>)">Hommes (<%= _pa.hommes.total %>)</p>
                  <%- pollBar('Fantasmé', 'Fantasized', _pa.hommes.pct_fantasme, 'hsl(260,55%,52%)') %>
                  <%- pollBar('Pratiqué', 'Practiced',  _pa.hommes.pct_pratique, 'hsl(200,60%,46%)') %>
                  <%- pollBar('Reçu', 'Received', _pa.hommes.pct_recoit, 'hsl(340,55%,52%)') %>
                  <%- pollBar('Donné', 'Gave', _pa.hommes.pct_donne, 'hsl(340,45%,42%)') %>
                </div>
                <% } %>
              </div>
              <% } %>
            </div>
            <% } %>
          </div>
        </div>

        <%# Informations utiles (positions) ─ %>
        <% var _pmInfos = t(pm.infos_utiles, 'wiki', page.id, 'meta_infos_utiles'); %>
        <% if (page.category === 'position' && _pmInfos) { %>
          <div class="wiki-pos-section wiki-pos-infos">
            <h3 class="wiki-pos-section-heading" data-fr="Informations utiles" data-en="Useful information">Informations utiles</h3>
            <div class="wiki-md" data-wiki-field="meta_infos_utiles"><span class="wiki-md-raw" hidden><%= _pmInfos %></span></div>
          </div>
        <% } %>

        <%# Nouvelles (positions) ─ %>
        <% if (page.category === 'position' && pm.nouvelles) { %>
          <div class="wiki-pos-section wiki-pos-nouvelles">
            <h3 class="wiki-pos-section-heading" data-fr="Nouvelles" data-en="Stories">Nouvelles</h3>
            <div class="wiki-pos-nouvelles-text"><%= pm.nouvelles %></div>
          </div>
        <% } %>

        <%# ── YMYL : Note médicale ── %>
        <% if (pm.medical) { %>
          <div class="wiki-pos-section wiki-ymyl-section">
            <h2 class="wiki-pos-section-heading" style="text-align:center" data-fr="Note médicale" data-en="Medical note">Note médicale</h2>
            <div class="wiki-md"><span class="wiki-md-raw" hidden><%= pm.medical %></span></div>
            <% if (pm.medical_sources && pm.medical_sources.length) { %>
              <ol class="wiki-sources-list wiki-ymyl-sources">
                <% pm.medical_sources.forEach(function(src) { %>
                  <li class="wiki-sources-item">
                    <% if (src.url) { %><a href="<%= src.url %>" class="wiki-sources-link" target="_blank" rel="noopener noreferrer"><%- src.label || src.url %></a><% } else { %><span class="wiki-sources-label"><%- src.label %></span><% } %>
                    <% if (src.authors || src.year) { %><span class="wiki-sources-meta"><% if (src.authors) { %><span class="wiki-sources-authors"><%= src.authors %></span><% } %><% if (src.year) { %><span class="wiki-sources-year">(<%= src.year %>)</span><% } %></span><% } %>
                  </li>
                <% }) %>
              </ol>
            <% } %>
          </div>
        <% } %>

        <%# ── YMYL : Note psychologique ── %>
        <% if (pm.psychologique) { %>
          <div class="wiki-pos-section wiki-ymyl-section">
            <h2 class="wiki-pos-section-heading" style="text-align:center" data-fr="Note psychologique" data-en="Psychological note">Note psychologique</h2>
            <div class="wiki-md"><span class="wiki-md-raw" hidden><%= pm.psychologique %></span></div>
            <% if (pm.psychologique_sources && pm.psychologique_sources.length) { %>
              <ol class="wiki-sources-list wiki-ymyl-sources">
                <% pm.psychologique_sources.forEach(function(src) { %>
                  <li class="wiki-sources-item">
                    <% if (src.url) { %><a href="<%= src.url %>" class="wiki-sources-link" target="_blank" rel="noopener noreferrer"><%- src.label || src.url %></a><% } else { %><span class="wiki-sources-label"><%- src.label %></span><% } %>
                    <% if (src.authors || src.year) { %><span class="wiki-sources-meta"><% if (src.authors) { %><span class="wiki-sources-authors"><%= src.authors %></span><% } %><% if (src.year) { %><span class="wiki-sources-year">(<%= src.year %>)</span><% } %></span><% } %>
                  </li>
                <% }) %>
              </ol>
            <% } %>
          </div>
        <% } %>

        <%# ── Sources / Citations ── %>
        <% if (pm.sources && pm.sources.length) { %>
          <div class="wiki-sources-section">
            <h3 class="wiki-sources-heading" data-fr="Sources" data-en="Sources">Sources</h3>
            <ol class="wiki-sources-list">
              <% pm.sources.forEach(function(src, i) { %>
                <li class="wiki-sources-item">
                  <% if (src.url) { %>
                    <a href="<%= src.url %>" class="wiki-sources-link" target="_blank" rel="noopener noreferrer"><%- src.label || src.url %></a>
                  <% } else { %>
                    <span class="wiki-sources-label"><%- src.label %></span>
                  <% } %>
                  <% if (src.authors || src.year) { %>
                    <span class="wiki-sources-meta">
                      <% if (src.authors) { %><span class="wiki-sources-authors"><%= src.authors %></span><% } %>
                      <% if (src.year) { %><span class="wiki-sources-year">(<%= src.year %>)</span><% } %>
                    </span>
                  <% } %>
                </li>
              <% }) %>
            </ol>
          </div>
        <% } %>

        <%# Images secondaires — galerie dans le texte ─ %>
        <%
          var secImages = pm.secondary_configured
            ? (pm.secondary_image_paths || [])
            : page.imagePaths.slice(1);
          if (!currentUser) {
            var _sfwSet = new Set(visibleImagePaths);
            secImages = secImages.filter(function(p) { return _sfwSet.has(p); });
          }
          // Ajoute les images positionnelles (intégrées dans le texte) si pas déjà présentes
          var posPaths = (pm.positional_images || []).map(function(pi){ return pi.path; });
          posPaths.forEach(function(p) {
            if (secImages.indexOf(p) === -1) secImages.push(p);
          });
          var secDisplay = secImages.slice(0, 16);   // affiche jusqu'à 16
          var isCollapsible = secImages.length > 8;  // collapse si > 8
          var hasMoreSec = secImages.length > 16;    // galerie si > 16
          var galleryTag = encodeURIComponent(page.title.toLowerCase());
        %>
        <% if (hasImages && secDisplay.length) { %>
          <div class="wiki-secondary-section">
            <div class="wiki-secondary-header">
              <span class="wiki-secondary-title" data-fr="Images" data-en="Images">Images</span>
              <% if (hasMoreSec) { %>
                <a href="/galerie?tag=<%= galleryTag %>" class="wiki-secondary-gallery-link" data-fr="Voir toutes les images →" data-en="View all images →">
                  Voir toutes les images &#8594;
                </a>
              <% } %>
            </div>
            <div class="wiki-secondary-imgs<%= isCollapsible ? ' wiki-secondary-imgs--collapsible' : '' %>"
                 id="wiki-secondary-grid">
              <% secDisplay.forEach(function(src) { %>
                <div class="wiki-secondary-img-wrap">
                  <img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-secondary-img" loading="lazy" data-lb-bound="1" />
                </div>
              <% }) %>
            </div>
            <% if (isCollapsible) { %>
              <button type="button" class="wiki-secondary-expand-btn" id="wiki-secondary-expand"
                      aria-expanded="false" data-fr="Voir plus ⌄" data-en="Show more ⌄">Voir plus &#8964;</button>
            <% } %>
          </div>
        <% } %>

        <%# Pages liées ─ %>
        <div class="wiki-page-links-view" data-page-id="<%= page.id %>" hidden>
          <h3 class="wiki-pl-heading" data-fr="Pages liées" data-en="Related pages">Pages li&eacute;es</h3>
          <div class="wiki-pl-cards" data-role="links"></div>
        </div>

        <%# Questions du quizz liées ─ %>
        <% if (currentUser) { %>
          <div class="wiki-question-links-view" data-page-id="<%= page.id %>" hidden>
            <h3 class="wiki-ql-heading" data-fr="Questions du quizz liées" data-en="Related quiz questions">Questions du quizz li&eacute;es</h3>
            <ul class="wiki-ql-list"></ul>
          </div>
        <% } %>

      </div><%# /wiki-detail-body %>

      <%# ─ COLONNE DROITE : panneau info (PC) ─ %>
      <aside class="wiki-detail-right">

        <%# ─ Navigation PC : titre encadré par prev/next ─ %>
        <div class="wiki-right-nav">
          <a href="<%= prevPage ? '/wiki/' + (prevPage.slug || prevPage.id) : '#' %>" class="wiki-right-nav-btn<%= prevPage ? '' : ' disabled' %>" title="<%= _prevTitle %>"><svg width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8 2L2 8L8 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <span class="wiki-right-nav-title" data-fr="<%= page.title %>" data-en="<%= (translationsEn && translationsEn.title) || page.title %>"><%= t(page.title, 'wiki', page.id, 'title') %></span>
          <a href="<%= nextPage ? '/wiki/' + (nextPage.slug || nextPage.id) : '#' %>" class="wiki-right-nav-btn<%= nextPage ? '' : ' disabled' %>" title="<%= _nextTitle %>"><svg width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2 2L8 8L2 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>

        <%# c) Image principale ─ %>
        <% if (hasImages) { %>
          <div class="wiki-right-img-wrap">
            <img src="<%= thumbUrl(visibleImagePaths[0]) %>" data-src="<%= visibleImagePaths[0] %>" alt="<%= page.title %>" class="wiki-right-img" data-lb-bound="1" style="cursor:zoom-in" />
          </div>
        <% } %>

        <%# Noms de variantes (tags cliquables sous l'image) ─ %>
        <%
          var variantNames = [];
          if (pm.variantes && Array.isArray(pm.variantes)) {
            pm.variantes.forEach(function(v) {
              if (v.nom) variantNames.push(v.nom);
              if (Array.isArray(v.variantes)) {
                v.variantes.forEach(function(sv) { if (sv.nom) variantNames.push(sv.nom); });
              }
            });
          }
        %>
        <% if (variantNames.length) { %>
          <div class="wiki-right-variants">
            <% variantNames.forEach(function(nom) { %>
              <a href="/wiki?tag=<%= encodeURIComponent(nom.toLowerCase()) %>" class="wiki-right-variant-chip"><%= nom %></a>
            <% }) %>
          </div>
        <% } %>

        <div class="wiki-right-body">
        <%# d+e) Notation + réactions ─ %>
        <% if (currentUser) { %>

        <%# Carrousel images secondaires (mobile uniquement, entre tags et réactions) ─ %>
        <% if (hasImages && visibleImagePaths.length > 1) { %>
          <% var secCount = visibleImagePaths.length - 1; %>
          <div class="wiki-mobile-sec-wrap">
            <div class="wiki-mobile-sec-heading">
              <span data-fr="Images" data-en="Images">Images</span>
              <span class="wiki-mobile-sec-counter" id="wiki-sec-counter"><%= secCount > 1 ? '1\u00a0/\u00a0' + secCount : '' %></span>
            </div>
            <div class="wiki-mobile-sec-carousel" id="wiki-sec-carousel">
              <% visibleImagePaths.slice(1).forEach(function (src) { %>
                <div class="wiki-mobile-sec-item">
                  <img src="<%= thumbUrl(src) %>" data-src="<%= src %>" alt="" class="wiki-mobile-sec-img" loading="lazy" style="cursor:zoom-in" />
                </div>
              <% }) %>
            </div>
          </div>
          <% if (secCount > 1) { %>
          <script nonce="<%= nonce %>">
          (function () {
            var carousel = document.getElementById("wiki-sec-carousel");
            var counter  = document.getElementById("wiki-sec-counter");
            var total    = <%= secCount %>;
            if (!carousel || !counter) return;
            var items = carousel.querySelectorAll(".wiki-mobile-sec-item");
            function update() {
              if (!items.length) return;
              var gap  = parseFloat(getComputedStyle(carousel).gap) || 10;
              var itemW = items[0].offsetWidth + gap;
              var idx  = Math.min(Math.round(carousel.scrollLeft / itemW), total - 1);
              counter.textContent = (idx + 1) + "\u00a0/\u00a0" + total;
            }
            carousel.addEventListener("scroll", update, { passive: true });
          })();
          </script>
          <% } %>
