    <style>
    @media(max-width:640px) {
      /* Masquer le mobile-topbar générique sur cette page */
      .mobile-topbar--hidden { display: none !important; }
      /* Banner devient le header fixe coloré */
      .wiki-detail-banner {
        display: grid;
        position: fixed; top: 0; left: 0; right: 0; z-index: 20;
        height: var(--topnav-height);
        grid-template-columns: 2.5rem 1fr 2.5rem;
        align-items: center; gap: .5rem;
        padding: 0 .75rem;
        margin: 0;
        border-radius: 0;
        border-top: none;
        border-bottom: 2px solid color-mix(in srgb, var(--wiki-gold) 55%, transparent);
      }
      .wiki-detail-banner-title { font-size: 1rem; }
      /* Drapeau dans le banner — visible seulement sur mobile */
      .wiki-detail-banner-lang {
        display: flex; align-items: center; justify-content: flex-end;
        background: none; border: none; padding: 0; cursor: pointer; color: #fff;
      }
      /* Compenser le header fixe sur le contenu */
      .wiki-detail { padding-top: calc(var(--topnav-height) + 1.05rem); }

      /* ── Vagues de navigation ── */
      /* display:contents : ses enfants .wiki-wave sont déjà position:fixed,
         donc ce conteneur ne peint rien, mais restait un élément flex à part
         entière dans .wiki-detail (gap:1.1rem) — un "gap fantôme" invisible
         qui poussait tout le contenu vers le bas sans raison visible. */
      .wiki-wave-nav { pointer-events: none; display: contents; }
      .wiki-wave {
        position: fixed;
        top: var(--topnav-height);
        bottom: 0;
        z-index: 8;
        border: none;
        background: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        pointer-events: auto;
        touch-action: none;
        -webkit-tap-highlight-color: transparent;
        outline: none;
      }
      .wiki-wave svg {
        height: 100%;
        width: 28px;
        display: block;
      }
      .wiki-wave svg path {
        fill: hsl(var(--ch-hue, 220), 42%, 62%);
        transition: opacity .35s ease;
      }
      .wiki-wave--left  { left: 0; }
      .wiki-wave--right { right: 0; }
      .wiki-wave--left svg {
        transform-origin: left center;
        transform: scaleX(.1);
        opacity: .22;
        transition: transform .5s cubic-bezier(.34,1.1,.64,1), opacity .4s ease;
      }
      .wiki-wave--right svg {
        transform-origin: right center;
        transform: scaleX(.1);
        opacity: .22;
        transition: transform .5s cubic-bezier(.34,1.1,.64,1), opacity .4s ease;
      }
      .wiki-wave--active.wiki-wave--left svg,
      .wiki-wave--active.wiki-wave--right svg {
        transform: scaleX(1);
        opacity: .5;
      }
      .wiki-wave--ready.wiki-wave--left svg,
      .wiki-wave--ready.wiki-wave--right svg {
        opacity: .72;
      }
    }
    @media(min-width:641px) {
      .wiki-detail-banner-lang { display: none; }
      .wiki-wave-nav { display: none; }
    }
    @media(max-width:640px) {
      .wiki-detail .wiki-section {
        border-top: 1px solid rgba(255,255,255,.1);
        margin-top: .9rem;
        padding-top: 0;
      }
      .wiki-detail .wiki-section-summary {
        display: flex !important;
        align-items: center;
        justify-content: center;
        gap: .65rem;
        width: 100%;
        padding: .6rem .5rem;
        font-size: 1.1rem;
      }
      .wiki-detail .wiki-section-summary:before,
      .wiki-detail .wiki-section-summary:after {
        content: '▾';
        font-size: .85em;
        color: hsl(var(--ch-hue, 220), 55%, 55%);
        display: inline-block;
        transition: transform .2s ease;
      }
      .wiki-detail .wiki-section[open] > .wiki-section-summary:before,
      .wiki-detail .wiki-section[open] > .wiki-section-summary:after {
        transform: rotate(-180deg);
      }
    }
