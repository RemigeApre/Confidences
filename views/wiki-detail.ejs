<script nonce="<%= nonce %>">
(function () {
  var _sfwPaths = <%- JSON.stringify(page.sfwImagePaths || []) %>;

  // Ouvre le lightbox galerie complet (favoris, note, infos…) pour n'importe quelle src.
  function openGalleryLightbox(src) {
    if (!src) return;
    // Non-connecté ET France : lightbox simple, images SFW uniquement (pas
    // de fetch). Non-connecté hors de France : plein accès, même chemin que
    // les comptes connectés (voir req.isFrenchVisitor, src/geo.js).
    <% if (!currentUser && isFrenchVisitor) { %>
    (function() {
      var ghost = document.getElementById('wiki-gallery-ghost');
      if (!ghost || !_sfwPaths.length) return;
      var card = document.createElement('div');
      card.className = 'gallery-card';
      // On met l'image cliquée en premier, puis les autres SFW
      card.dataset.images = [src].concat(_sfwPaths.filter(function(p) { return p !== src; })).join('|');
      card.dataset.filtered = '1';
      ['galleryId','displayTitle','title','titleVisible','tags','author','parody','subParody','series'].forEach(function(k) { card.dataset[k] = ''; });
      card.dataset.rating = '0'; card.dataset.fav = '0';
      card.dataset.wikiId = ''; card.dataset.protagonists = ''; card.dataset.processed = '0'; card.dataset.ai = '0';
      ghost.appendChild(card);
      if (window._galleryOpenCard) {
        window._galleryOpenCard(card);
        var lb = document.getElementById('gallery-lightbox');
        if (lb) lb.addEventListener('gallery:closed', function cleanup() {
          lb.removeEventListener('gallery:closed', cleanup);
          if (ghost.contains(card)) ghost.removeChild(card);
        });
      }
    })();
    return;
    <% } %>
    fetch('/galerie/by-path?src=' + encodeURIComponent(src))
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var ghost = document.getElementById('wiki-gallery-ghost');
        if (!ghost) return;
        var card = document.createElement('div');
        card.className = 'gallery-card';
        card.dataset.idx = '0';
        card.dataset.images = d.ok ? (d.imagePaths || [src]).join('|') : src;
        card.dataset.galleryId = d.ok ? String(d.id) : '';
        card.dataset.displayTitle = d.ok ? (d.title || '') : '';
        card.dataset.title = d.ok ? (d.title || '').toLowerCase() : '';
        card.dataset.titleVisible = (d.ok && d.titleVisible) ? '1' : '0';
        card.dataset.tags = d.ok ? (d.tags || []).join('|').toLowerCase() : '';
        card.dataset.author = d.ok ? (d.author || '') : '';
        card.dataset.parody = d.ok ? (d.parody || '') : '';
        card.dataset.subParody = d.ok ? (d.subParody || '') : '';
        card.dataset.rating = d.ok ? String(d.rating || 0) : '0';
        card.dataset.fav = '0';
        card.dataset.filtered = '1';
        card.dataset.wikiId = d.ok && d.wikiPageId ? String(d.wikiPageId) : '';
        card.dataset.protagonists = '';
        card.dataset.processed = '0';
        card.dataset.ai = '0';
        card.dataset.series = '';
        ghost.appendChild(card);
        if (window._galleryOpenCard) {
          window._galleryOpenCard(card);
          var lb = document.getElementById('gallery-lightbox');
          if (lb) {
            lb.addEventListener('gallery:closed', function cleanup() {
              lb.removeEventListener('gallery:closed', cleanup);
              if (ghost.contains(card)) ghost.removeChild(card);
            });
          }
        }
      });
  }

  // Bouton SFW dans la lightbox (admin uniquement)
  var sfwBtn = document.getElementById('gallery-lb-sfw-btn');
  if (sfwBtn) {
    var _wikiMeta = null;
    try { _wikiMeta = JSON.parse(document.getElementById('wiki-current-page-meta').textContent); } catch(_) {}
    var _wikiId = _wikiMeta && _wikiMeta.id;
    var _sfwSet = new Set(_sfwPaths);
    // Met à jour l'état du bouton quand la lightbox change d'image
    var _lbImg = document.querySelector('.gallery-lb-img');
    function _updateSfwBtn() {
      var src = _lbImg && (_lbImg.dataset.targetSrc || _lbImg.getAttribute('src'));
      if (!src) { sfwBtn.setAttribute('hidden', ''); return; }
      sfwBtn._currentSrc = src;
      sfwBtn.classList.toggle('on', _sfwSet.has(src));
      sfwBtn.removeAttribute('hidden');
    }
    if (_lbImg) {
      new MutationObserver(_updateSfwBtn).observe(_lbImg, { attributes: true, attributeFilter: ['src', 'data-target-src'] });
    }
    document.addEventListener('gallery:closed', function() { sfwBtn.setAttribute('hidden', ''); });
    sfwBtn.addEventListener('click', function() {
      var src = sfwBtn._currentSrc;
      if (!src || !_wikiId) return;
      fetch('/wiki/' + _wikiId + '/sfw-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ src: src })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) return;
        if (d.sfw) { _sfwSet.add(src); if (_sfwPaths.indexOf(src) === -1) _sfwPaths.push(src); }
        else { _sfwSet.delete(src); var _i = _sfwPaths.indexOf(src); if (_i !== -1) _sfwPaths.splice(_i, 1); }
        sfwBtn.classList.toggle('on', d.sfw);
      });
    });
  }

  // Tap sur une image (hero mobile, image principale PC, image secondaire,
  // carrousel mobile) → ouvre le lightbox. Détection par pointerdown/move/up
  // avec seuil de déplacement plutôt qu'un simple "click" : sur mobile, un
  // "click" se fait très souvent avaler par le navigateur dès que le doigt a
  // un peu bougé pendant l'appui (confondu avec un début de scroll), même
  // hors d'un carrousel — c'est ce qui empêchait l'image principale de
  // s'ouvrir alors que le code semblait correct.
  var tapStartX = 0, tapStartY = 0, tapMoved = false;
  document.addEventListener('pointerdown', function (e) {
    tapStartX = e.clientX; tapStartY = e.clientY; tapMoved = false;
  });
  document.addEventListener('pointermove', function (e) {
    if (Math.abs(e.clientX - tapStartX) > 10 || Math.abs(e.clientY - tapStartY) > 10) tapMoved = true;
  });
  document.addEventListener('pointerup', function (e) {
    if (tapMoved) return;
    // Image hero mobile
    var hero = e.target.closest('.wiki-mobile-hero');
    if (hero) {
      var img = hero.querySelector('.wiki-mobile-hero-img');
      if (img) openGalleryLightbox(img.dataset.src || img.src);
      return;
    }
    // Image principale colonne droite (PC/tablette)
    var rightWrap = e.target.closest('.wiki-right-img-wrap');
    if (rightWrap) {
      var rImg = rightWrap.querySelector('.wiki-right-img');
      if (rImg) openGalleryLightbox(rImg.dataset.src || rImg.src);
      return;
    }
    // Image secondaire
    var wrap = e.target.closest('.wiki-secondary-img-wrap');
    if (wrap) {
      var imgEl = wrap.querySelector('.wiki-secondary-img');
      if (imgEl) openGalleryLightbox(imgEl.dataset.src || imgEl.src);
      return;
    }
    // Image du carrousel mobile ("Images", sous les tags)
    var secItem = e.target.closest('.wiki-mobile-sec-item');
    if (secItem) {
      var secImg = secItem.querySelector('.wiki-mobile-sec-img');
      if (secImg) openGalleryLightbox(secImg.dataset.src || secImg.src);
      return;
    }
  });
})();
</script>
<script nonce="<%= nonce %>" src="/gallery.js?v=<%= assetVersion %>"></script>
<% } %>

<script nonce="<%= nonce %>">
// ── Fix : note + réactions perdues quand l'utilisateur clique sur Éditer ──
(function() {
  // 1) Réactions : patch fetch pour ajouter keepalive sur /react
  //    → le navigateur complète la requête même si la page se décharge
  var _origFetch = window.fetch;
  window.fetch = function(url, opts) {
    if (typeof url === 'string' && /\/wiki\/\d+\/react$/.test(url)) {
      return _origFetch(url, Object.assign({}, opts || {}, { keepalive: true }));
    }
    return _origFetch.apply(this, arguments);
  };

  // 2) Note : sur le clic des boutons "Éditer", flush immédiat avec keepalive
  //    (contourne le debounce 1.2s de wiki.js sans bloquer la navigation)
  function flushNote() {
    var noteEl = document.querySelector('.wiki-user-note');
    var ta  = noteEl && noteEl.querySelector('.wiki-user-note-area');
    var pid = noteEl && noteEl.dataset.pageId;
    if (!ta || !pid) return;
    fetch('/wiki/' + pid + '/note', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      keepalive: true,
      body: JSON.stringify({ content: ta.value })
    });
  }

  document.querySelectorAll('a.wiki-edit-icon-btn').forEach(function(link) {
    if (link.href && link.href.indexOf('/edit') !== -1) {
      link.addEventListener('click', flushNote);
    }
  });
})();

// ── Statut possède / souhaite (objets & tenues) ──
(function() {
  var wrap = document.querySelector('.wiki-left-status');
  if (!wrap) return;
  var pageId = wrap.dataset.pageId;
  wrap.querySelectorAll('.wiki-left-status-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var status = btn.dataset.status;
      var isActive = btn.classList.contains('active');
      var newStatus = isActive ? '' : status;
      wrap.querySelectorAll('.wiki-left-status-btn').forEach(function(b) { b.classList.remove('active'); });
      if (!isActive) btn.classList.add('active');
      fetch('/wiki/' + pageId + '/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      });
    });
  });
})();
</script>

