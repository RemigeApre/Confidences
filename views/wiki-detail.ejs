            <% var _tierOrder={wiki:0,normal:1,parent:2}; function _trank(t){var r=_tierOrder[(tagRegistry[t.toLowerCase()]||{}).tier];return r!==undefined?r:1;} %>
            <% page.tags.slice().sort(function(a,b){return _trank(a)-_trank(b);}).forEach(function(t){ %>
              <%- include('partials/tag-badge', { tag: t }) %>
            <% }) %>
