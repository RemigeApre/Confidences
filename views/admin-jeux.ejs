<%- include('partials/head', { title: 'Admin : Jeux', extraCss: ['admin.css'] }) %>

<div class="admin-topbar">
  <a href="/admin" class="admin-topbar-back">&#8592; Retour</a>
  <span class="admin-topbar-title"><%= config.title %> &mdash; Jeux</span>
  <form method="POST" action="/admin/logout" style="margin:0">
    <button type="submit" class="admin-topbar-logout">D&eacute;connexion</button>
  </form>
</div>

<div style="padding:1.5rem 1.5rem 3rem;">

  <% if (locals.success) { %>
    <p class="admin-error-msg" style="color:#86efac;background:hsl(142,30%,10%);border-color:hsl(142,35%,22%);">
      Op&eacute;ration r&eacute;ussie<% if(locals.compat_warn){ %> &mdash; des avertissements de compatibilit&eacute; ont &eacute;t&eacute; d&eacute;tect&eacute;s<% } %>.
    </p>
  <% } %>
  <% if (locals.error) { %>
    <p class="admin-error-msg"><%= error %></p>
  <% } %>

  <%# ── Grille de cartes ── %>
  <div class="admin-user-lib">

    <%# Carte "+" — ajouter un jeu %>
    <button type="button" class="admin-utile admin-utile--create" id="jeux-add-btn" aria-label="Ajouter un jeu">
      <span class="admin-utile-plus">+</span>
      <span class="admin-utile-create-label">Nouveau jeu</span>
    </button>

    <% games.forEach(function(game) { %>
      <%
        var hasWarnings = game.warnings && game.warnings.length > 0;
        var hasErrors   = hasWarnings && game.warnings.some(function(w){ return w.severity === 'error'; });
        var cardVariant = game.disabled ? 'game-hs' : 'game';
      %>
      <div class="admin-utile admin-utile--<%= cardVariant %>"
        data-game-slug="<%= game.slug %>"
        data-game-title="<%= game.title %>"
        data-game-desc="<%= game.description || '' %>"
        data-game-entrypoint="<%= game.entrypoint %>"
        data-game-online-url="<%= game.online_url || '' %>"
        data-game-disabled="<%= game.disabled ? '1' : '0' %>"
        data-game-parody="<%= game.parody || '' %>"
        data-game-sub-parody="<%= game.sub_parody || '' %>"
        data-game-tags="<%= (game.tags || []).join(', ') %>"
        data-game-protagonist-ids="<%= JSON.stringify(game.protagonist_ids || []) %>"
        data-game-warnings="<%= hasWarnings ? JSON.stringify(game.warnings).replace(/"/g,'&quot;') : '' %>">

        <div class="admin-utile-top">
          <div class="admin-utile-avatar"><%= game.title.charAt(0).toUpperCase() %></div>
          <% if (hasWarnings) { %>
            <span class="admin-game-compat-badge" title="<%= hasErrors ? 'Problèmes de compatibilité Electron' : 'Avertissements de compatibilité' %>">
              <%= hasErrors ? '⚠' : '⚠' %>
            </span>
          <% } %>
        </div>

        <button type="button" class="admin-utile-body-link admin-game-edit-btn">
          <div class="admin-utile-name">
            <%= game.title %>
            <% if (game.disabled) { %>
              <span class="admin-game-hs-badge">HS</span>
            <% } %>
          </div>
          <div class="admin-utile-login" style="font-family:monospace;font-size:.72rem;"><%= game.entrypoint %></div>
        </button>

        <div class="admin-utile-stats">
          <div class="admin-utile-stat">
            <span class="admin-utile-stat-val" style="color:<%= game.disabled ? '#f87171' : '#4ade80' %>">
              <%= game.disabled ? 'HS' : 'Actif' %>
            </span>
            <span class="admin-utile-stat-key">Statut</span>
          </div>
          <div class="admin-utile-stat">
            <span class="admin-utile-stat-val"><%= game.slug %></span>
            <span class="admin-utile-stat-key">Slug</span>
          </div>
          <div class="admin-utile-stat">
            <span class="admin-utile-stat-val" style="color:<%= hasErrors ? '#f87171' : (hasWarnings ? '#fbbf24' : '#4ade80') %>">
              <%= hasErrors ? '⚠ err' : (hasWarnings ? '⚠ warn' : '✓') %>
            </span>
            <span class="admin-utile-stat-key">Compat.</span>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

</div>

<%# ══════════════════════════════════════════════════════════
    Modal — Ajouter un jeu
══════════════════════════════════════════════════════════ %>
<div class="admin-modal-overlay" id="jeux-add-modal" hidden>
  <div class="admin-modal">
    <button type="button" class="admin-modal-close" id="jeux-add-modal-close" aria-label="Fermer">&#215;</button>
    <h2 class="admin-modal-title">Nouveau jeu</h2>

    <div class="admin-modal-form" id="jeux-add-form-wrap">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;">
        <label class="admin-modal-field">
          <span>Titre *</span>
          <input type="text" id="add-title" placeholder="Mon jeu" autocomplete="off">
        </label>
        <label class="admin-modal-field">
          <span>Slug <small style="color:#475569;">(auto si vide)</small></span>
          <input type="text" id="add-slug" placeholder="mon-jeu" autocomplete="off" style="font-family:monospace;">
        </label>
      </div>
      <label class="admin-modal-field">
        <span>Description</span>
        <input type="text" id="add-desc" placeholder="Courte description…" autocomplete="off">
      </label>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;">
        <label class="admin-modal-field">
          <span>Fichier d&rsquo;entr&eacute;e</span>
          <input type="text" id="add-entrypoint" value="index.html" style="font-family:monospace;" autocomplete="off">
        </label>
        <label class="admin-modal-field">
          <span>URL online <small style="color:#475569;">(optionnel)</small></span>
          <input type="url" id="add-online-url" placeholder="https://…" autocomplete="off">
        </label>
      </div>

      <div id="add-dropzone" class="admin-game-dropzone">
        <input type="file" id="add-zipfile" accept=".zip" style="display:none">
        <label for="add-zipfile" style="cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:.4rem;">
          <span style="font-size:1.6rem;">&#128230;</span>
          <span id="add-zip-label" style="font-size:.82rem;color:#64748b;">Choisir un fichier .zip *</span>
        </label>
      </div>

      <div id="add-progress" hidden>
        <div style="height:5px;background:rgba(255,255,255,.08);border-radius:99px;overflow:hidden;margin-bottom:.35rem;">
          <div id="add-progress-bar" style="height:100%;width:0%;background:#60a5fa;border-radius:99px;transition:width .2s;"></div>
        </div>
        <p id="add-progress-status" style="font-size:.75rem;color:#64748b;margin:0;"></p>
      </div>

      <button type="button" id="jeux-add-submit" class="admin-btn-primary" disabled style="opacity:.5;">
        Installer
      </button>
    </div>
  </div>
</div>

<%# ══════════════════════════════════════════════════════════
    Modal — Modifier un jeu
══════════════════════════════════════════════════════════ %>
<div class="admin-modal-overlay" id="jeux-edit-modal" hidden>
  <div class="admin-modal">
    <button type="button" class="admin-modal-close" id="jeux-edit-modal-close" aria-label="Fermer">&#215;</button>
    <h2 class="admin-modal-title" id="jeux-edit-modal-title">Configurer</h2>

    <%# Métadonnées %>
    <form method="POST" id="jeux-edit-form" action="/admin/jeux/__SLUG__/edit" class="admin-modal-form">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;">
        <label class="admin-modal-field">
          <span>Titre *</span>
          <input type="text" name="title" id="edit-title" required autocomplete="off">
        </label>
        <label class="admin-modal-field">
          <span>Slug <small style="color:#475569;">(non modifiable)</small></span>
          <input type="text" id="edit-slug-display" disabled style="font-family:monospace;opacity:.5;">
        </label>
      </div>
      <label class="admin-modal-field">
        <span>Description</span>
        <input type="text" name="description" id="edit-desc" autocomplete="off">
      </label>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;">
        <label class="admin-modal-field">
          <span>Fichier d&rsquo;entr&eacute;e</span>
          <input type="text" name="entrypoint" id="edit-entrypoint" style="font-family:monospace;" autocomplete="off">
        </label>
        <label class="admin-modal-field">
          <span>URL online <small style="color:#475569;">(optionnel)</small></span>
          <input type="url" name="online_url" id="edit-online-url" placeholder="https://…" autocomplete="off">
        </label>
      </div>

      <%# Parodie %>
      <div class="admin-modal-field">
        <span>Parodie / Sous-parodie</span>
        <%- include('partials/parody-input', {
          idPrefix:   'edit',
          mainValue:  '',
          subValue:   '',
          mainName:   'parody',
          subName:    'sub_parody',
        }) %>
      </div>

      <%# Tags %>
      <div class="admin-modal-field">
        <span>Tags</span>
        <div class="wiki-tags-widget" id="edit-tags-widget">
          <div class="wiki-tags-board" id="edit-tags-board">
            <input type="text" class="wiki-tags-typing" id="edit-tags-typing" placeholder="Ajouter un tag…" autocomplete="off">
          </div>
          <input type="hidden" name="tags" id="edit-tags-hidden" value="">
          <% if (allTags && allTags.length) { %>
            <div class="wiki-tag-suggestions" id="edit-tag-suggestions">
              <% allTags.slice(0, 20).forEach(function(t) { %>
                <button type="button" class="wiki-tag-suggest-chip" data-tag="<%= t %>"><%= t %></button>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <%# Personnages %>
      <div class="admin-modal-field">
        <span>Personnages</span>
        <div class="gf-prot-widget" id="edit-prot-widget" style="position:relative;">
          <div class="gf-prot-chips wiki-tags-board" id="edit-prot-chips">
            <input type="text" id="edit-prot-input" class="wiki-tags-typing" placeholder="Chercher un personnage…" autocomplete="off" style="min-width:140px;">
          </div>
          <ul class="parody-ac-drop" id="edit-prot-drop" hidden></ul>
        </div>
      </div>

      <%# Toggle HS %>
      <div style="display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:.65rem 1rem;margin:.25rem 0;">
        <div>
          <p style="margin:0;font-size:.88rem;font-weight:600;">Hors service</p>
          <p style="margin:.15rem 0 0;font-size:.75rem;color:#64748b;">Le jeu reste visible en card mais ne peut pas &ecirc;tre lanc&eacute;</p>
        </div>
        <label class="admin-toggle">
          <input type="checkbox" name="disabled" id="edit-disabled" value="1">
          <span class="admin-toggle-track"></span>
        </label>
      </div>

      <button type="submit" class="admin-btn-primary">Enregistrer</button>
    </form>

    <%# Re-upload zip (optionnel) %>
    <details class="admin-modal-extra-details" style="margin-top:.5rem;">
      <summary class="admin-modal-extra-summary">Mettre &agrave; jour les fichiers &rsaquo;</summary>
      <div class="admin-modal-extra-body" style="padding-top:.75rem;">
        <div id="edit-dropzone" class="admin-game-dropzone">
          <input type="file" id="edit-zipfile" accept=".zip" style="display:none">
          <label for="edit-zipfile" style="cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:.4rem;">
            <span style="font-size:1.4rem;">&#128230;</span>
            <span id="edit-zip-label" style="font-size:.8rem;color:#64748b;">Choisir un .zip</span>
          </label>
        </div>
        <div id="edit-progress" hidden style="margin-top:.5rem;">
          <div style="height:5px;background:rgba(255,255,255,.08);border-radius:99px;overflow:hidden;margin-bottom:.3rem;">
            <div id="edit-progress-bar" style="height:100%;width:0%;background:#60a5fa;border-radius:99px;transition:width .2s;"></div>
          </div>
          <p id="edit-progress-status" style="font-size:.75rem;color:#64748b;margin:0;"></p>
        </div>
        <button type="button" id="jeux-edit-upload" class="admin-btn-primary" disabled style="opacity:.5;margin-top:.75rem;">
          Mettre &agrave; jour les fichiers
        </button>
      </div>
    </details>

    <%# Danger zone %>
    <div style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.07);">
      <button type="button" id="jeux-edit-delete" class="admin-utile-menu-item admin-utile-menu-item--danger" style="width:100%;text-align:center;padding:.5rem;">
        Retirer ce jeu de la liste
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  /* ── Helpers ── */
  function qs(sel) { return document.querySelector(sel); }
  function show(el) { el.hidden = false; }
  function hide(el) { el.hidden = true; }

  /* ── Modals ── */
  var addModal  = qs('#jeux-add-modal');
  var editModal = qs('#jeux-edit-modal');

  function openModal(m)  { show(m); }
  function closeModal(m) { hide(m); }

  qs('#jeux-add-btn').addEventListener('click', function () { openModal(addModal); });
  qs('#jeux-add-modal-close').addEventListener('click', function () { closeModal(addModal); });
  qs('#jeux-edit-modal-close').addEventListener('click', function () { closeModal(editModal); });

  addModal.addEventListener('click', function (e) { if (e.target === addModal) closeModal(addModal); });
  editModal.addEventListener('click', function (e) { if (e.target === editModal) closeModal(editModal); });

  /* ── Données protagonistes (pour widget) ── */
  var ALL_PROTS = <%- JSON.stringify((allProtagonistes || []).map(function(p){ return { id: p.id, name: p.name }; })) %>;

  /* ── Widget Tags ── */
  (function () {
    var board   = qs('#edit-tags-board');
    var typing  = qs('#edit-tags-typing');
    var hidden  = qs('#edit-tags-hidden');
    var sugWrap = qs('#edit-tag-suggestions');
    if (!board || !typing) return;

    function currentTags() {
      return Array.from(board.querySelectorAll('.wiki-chip')).map(function (c) { return c.dataset.tag; });
    }
    function syncHidden() { hidden.value = currentTags().join(', '); }

    function addChip(tag) {
      tag = tag.trim();
      if (!tag) return;
      if (currentTags().indexOf(tag) !== -1) return;
      var span = document.createElement('span');
      span.className = 'wiki-chip';
      span.dataset.tag = tag;
      span.appendChild(document.createTextNode(tag));
      var x = document.createElement('button');
      x.type = 'button'; x.className = 'wiki-chip-remove'; x.textContent = '×';
      x.addEventListener('click', function () { span.remove(); syncHidden(); updateSuggestions(); });
      span.appendChild(x);
      board.insertBefore(span, typing);
      syncHidden();
      updateSuggestions();
    }

    function updateSuggestions() {
      if (!sugWrap) return;
      var active = currentTags();
      sugWrap.querySelectorAll('.wiki-tag-suggest-chip').forEach(function (btn) {
        btn.classList.toggle('active', active.indexOf(btn.dataset.tag) !== -1);
      });
    }

    function resetTags(tagList) {
      board.querySelectorAll('.wiki-chip').forEach(function (c) { c.remove(); });
      tagList.forEach(addChip);
      syncHidden();
      updateSuggestions();
    }

    typing.addEventListener('keydown', function (e) {
      if ((e.key === 'Enter' || e.key === ',') && typing.value.trim()) {
        e.preventDefault();
        addChip(typing.value);
        typing.value = '';
      } else if (e.key === 'Backspace' && typing.value === '') {
        var chips = board.querySelectorAll('.wiki-chip');
        if (chips.length) { chips[chips.length - 1].remove(); syncHidden(); updateSuggestions(); }
      }
    });

    if (sugWrap) {
      sugWrap.addEventListener('click', function (e) {
        var btn = e.target.closest('.wiki-tag-suggest-chip');
        if (!btn) return;
        var tag = btn.dataset.tag;
        if (currentTags().indexOf(tag) !== -1) {
          board.querySelectorAll('.wiki-chip').forEach(function (c) { if (c.dataset.tag === tag) c.remove(); });
          syncHidden(); updateSuggestions();
        } else {
          addChip(tag);
        }
      });
    }

    /* expose pour le handler de carte */
    window._editTagsReset = resetTags;
  })();

  /* ── Widget Protagonistes ── */
  (function () {
    var chips = qs('#edit-prot-chips');
    var inp   = qs('#edit-prot-input');
    var drop  = qs('#edit-prot-drop');
    if (!chips || !inp) return;

    function selectedIds() {
      return Array.from(chips.querySelectorAll('[name="protagonist_ids"]')).map(function (c) { return Number(c.value); });
    }
    function closeDrop() { drop.innerHTML = ''; drop.hidden = true; }

    function addChip(id, name) {
      if (selectedIds().indexOf(Number(id)) !== -1) return;
      var span = document.createElement('span');
      span.className = 'gf-prot-chip';
      var label = document.createTextNode(name + ' ');
      span.appendChild(label);
      var hid = document.createElement('input');
      hid.type = 'hidden'; hid.name = 'protagonist_ids'; hid.value = id;
      span.appendChild(hid);
      var x = document.createElement('button');
      x.type = 'button'; x.textContent = '×';
      x.style.cssText = 'background:none;border:none;cursor:pointer;color:inherit;padding:0 0 0 .2rem;font-size:.9em;';
      x.addEventListener('click', function (e) { e.stopPropagation(); span.remove(); });
      span.appendChild(x);
      chips.insertBefore(span, inp);
    }

    function resetProts(ids) {
      chips.querySelectorAll('.gf-prot-chip').forEach(function (c) { c.remove(); });
      ids.forEach(function (id) {
        var prot = ALL_PROTS.find(function (p) { return p.id === Number(id); });
        if (prot) addChip(prot.id, prot.name);
      });
    }

    inp.addEventListener('input', function () {
      var q = inp.value.toLowerCase().trim();
      drop.innerHTML = ''; drop.hidden = true;
      if (!q) return;
      var matches = ALL_PROTS.filter(function (p) { return p.name.toLowerCase().indexOf(q) !== -1 && selectedIds().indexOf(p.id) === -1; }).slice(0, 8);
      if (!matches.length) return;
      matches.forEach(function (p) {
        var li = document.createElement('li');
        li.className = 'parody-ac-item';
        li.textContent = p.name;
        li.addEventListener('mousedown', function (e) { e.preventDefault(); addChip(p.id, p.name); inp.value = ''; closeDrop(); });
        drop.appendChild(li);
      });
      drop.hidden = false;
    });

    inp.addEventListener('blur', function () { setTimeout(closeDrop, 200); });

    /* expose pour le handler de carte */
    window._editProtsReset = resetProts;
  })();

  /* ── Cartes → modal modifier ── */
  document.querySelectorAll('.admin-utile[data-game-slug]').forEach(function (card) {
    card.addEventListener('click', function () {
      var slug       = card.dataset.gameSlug;
      var title      = card.dataset.gameTitle;
      var desc       = card.dataset.gameDesc;
      var entry      = card.dataset.gameEntrypoint;
      var onlineUrl  = card.dataset.gameOnlineUrl;
      var disabled   = card.dataset.gameDisabled === '1';
      var parody     = card.dataset.gameParody || '';
      var subParody  = card.dataset.gameSubParody || '';
      var tagsStr    = card.dataset.gameTags || '';
      var protIds    = JSON.parse(card.dataset.gameProtagonistIds || '[]');

      qs('#jeux-edit-modal-title').textContent = title;
      qs('#edit-title').value       = title;
      qs('#edit-slug-display').value = slug;
      qs('#edit-desc').value        = desc;
      qs('#edit-entrypoint').value  = entry;
      qs('#edit-online-url').value  = onlineUrl;
      qs('#edit-disabled').checked  = disabled;

      /* Parodie */
      qs('#edit-parody').value     = parody;
      qs('#edit-sub-parody').value = subParody;

      /* Tags */
      if (window._editTagsReset) {
        window._editTagsReset(tagsStr ? tagsStr.split(',').map(function(t){ return t.trim(); }).filter(Boolean) : []);
      }

      /* Protagonistes */
      if (window._editProtsReset) window._editProtsReset(protIds);

      var form = qs('#jeux-edit-form');
      form.action = '/admin/jeux/' + slug + '/edit';

      // Delete
      qs('#jeux-edit-delete').dataset.slug = slug;

      // Reset upload
      qs('#edit-zip-label').textContent = 'Choisir un .zip';
      qs('#edit-zipfile').value = '';
      qs('#jeux-edit-upload').disabled = true;
      qs('#jeux-edit-upload').style.opacity = '.5';
      hide(qs('#edit-progress'));
      qs('#edit-progress-bar').style.width = '0%';

      openModal(editModal);
    });
  });

  /* ── Dropzone "Ajouter" ── */
  var addInput  = qs('#add-zipfile');
  var addLabel  = qs('#add-zip-label');
  var addSubmit = qs('#jeux-add-submit');

  addInput.addEventListener('change', function () {
    if (this.files && this.files[0]) {
      addLabel.textContent = this.files[0].name + ' (' + (this.files[0].size/1024/1024).toFixed(1) + ' Mo)';
      addSubmit.disabled = false;
      addSubmit.style.opacity = '1';
    }
  });

  /* ── Dropzone "Modifier — re-upload" ── */
  var editZipInput  = qs('#edit-zipfile');
  var editZipLabel  = qs('#edit-zip-label');
  var editUploadBtn = qs('#jeux-edit-upload');

  editZipInput.addEventListener('change', function () {
    if (this.files && this.files[0]) {
      editZipLabel.textContent = this.files[0].name + ' (' + (this.files[0].size/1024/1024).toFixed(1) + ' Mo)';
      editUploadBtn.disabled = false;
      editUploadBtn.style.opacity = '1';
    }
  });

  /* ── XHR helper pour upload avec progress ── */
  function xhrUpload(url, formData, barEl, statusEl, progressWrap, submitBtn, onDone) {
    show(progressWrap);
    submitBtn.disabled = true;
    submitBtn.textContent = 'Installation\u2026';
    var xhr = new XMLHttpRequest();
    xhr.open('POST', url);
    xhr.upload.addEventListener('progress', function (ev) {
      if (!ev.lengthComputable) return;
      var pct = Math.round(ev.loaded / ev.total * 100);
      barEl.style.width = pct + '%';
      statusEl.textContent = pct === 100 ? 'Extraction\u2026' : 'Upload\u00a0: ' + pct + '%';
    });
    xhr.addEventListener('load', function () {
      if (xhr.status >= 400) {
        statusEl.textContent = xhr.status === 413
          ? 'Fichier trop volumineux.'
          : 'Erreur\u00a0' + xhr.status + '.';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Installer';
        return;
      }
      onDone(xhr);
    });
    xhr.addEventListener('error', function () {
      statusEl.textContent = 'Erreur r\u00e9seau.';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Installer';
    });
    xhr.send(formData);
  }

  /* ── Submit : ajouter un jeu ── */
  addSubmit.addEventListener('click', function () {
    var title    = qs('#add-title').value.trim();
    var slug     = qs('#add-slug').value.trim();
    var desc     = qs('#add-desc').value.trim();
    var entry    = qs('#add-entrypoint').value.trim() || 'index.html';
    var onlineUrl= qs('#add-online-url').value.trim();
    var file     = addInput.files[0];
    if (!title) { alert('Le titre est requis.'); return; }
    if (!file)  { alert('Veuillez choisir un .zip.'); return; }
    var fd = new FormData();
    fd.append('title', title);
    fd.append('slug', slug);
    fd.append('description', desc);
    fd.append('entrypoint', entry);
    fd.append('online_url', onlineUrl);
    fd.append('zipfile', file);
    xhrUpload('/admin/jeux/add', fd,
      qs('#add-progress-bar'), qs('#add-progress-status'), qs('#add-progress'), addSubmit,
      function (xhr) { window.location.href = xhr.responseURL || '/admin/jeux'; });
  });

  /* ── Submit : re-upload zip jeu existant ── */
  editUploadBtn.addEventListener('click', function () {
    var form  = qs('#jeux-edit-form');
    var slug  = qs('#edit-slug-display').value;
    var entry = qs('#edit-entrypoint').value.trim() || 'index.html';
    var file  = editZipInput.files[0];
    if (!file) return;
    var fd = new FormData();
    fd.append('entrypoint', entry);
    fd.append('zipfile', file);
    xhrUpload('/admin/jeux/' + slug + '/upload', fd,
      qs('#edit-progress-bar'), qs('#edit-progress-status'), qs('#edit-progress'), editUploadBtn,
      function (xhr) { window.location.href = xhr.responseURL || '/admin/jeux'; });
  });

  /* ── Supprimer un jeu ── */
  qs('#jeux-edit-delete').addEventListener('click', function () {
    var slug = this.dataset.slug;
    var name = qs('#jeux-edit-modal-title').textContent;
    if (!confirm('Retirer "' + name + '" de la liste\u00a0? (les fichiers ne sont pas supprim\u00e9s)')) return;
    var fd = new FormData();
    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/admin/jeux/' + slug + '/delete');
    xhr.addEventListener('load', function () { window.location.href = '/admin/jeux'; });
    xhr.send(fd);
  });
})();
</script>

