<%- include('partials/head', { title: 'Admin : ' + (isLive ? 'Etat actuel' : 'Reponse #' + submission.id), extraCss: ['admin.css'] }) %>
<main class="container wide">
  <a class="link" href="/admin">&larr; Retour</a>
  <h1><%= isLive ? ("Etat actuel" + (typeof liveUser !== "undefined" && liveUser ? " — " + liveUser.displayName : "")) : "Reponse #" + submission.id %></h1>
  <p>
    <% if (!isLive && submission.userDisplayName) { %><strong><%= submission.userDisplayName %></strong> &mdash; <% } %>
    <%= isLive ? "Derniere modification : " : "" %><%= new Date(submission.createdAt).toLocaleString("fr-FR") %>
  </p>

  <% config.sections.forEach(function (section) { %>
    <% var data = submission.answers[section.key] || {}; %>
    <div class="result-section">
      <h2><%= section.title %></h2>

      <% if (section.type === "matrix") { %>
        <% var s = submission.scores.sections[section.key]; %>
        <div class="result-row">
          <div class="result-label">
            <span>Score global</span>
            <span><%= s.percentage %>%</span>
          </div>
          <div class="bar"><div class="bar-fill" style="width: <%= s.percentage %>%"></div></div>
        </div>

        <% var matrix = data.matrix || {}; %>
        <% section.groups.forEach(function (group) { %>
          <fieldset class="matrix-group">
            <% if (group.title) { %><legend><%= group.title %></legend><% } %>
            <div class="table-scroll">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th class="item-col">Pratique</th>
                    <% config.levels.forEach(function (lvl) { %>
                      <th title="<%= lvl.label %>"><%= lvl.key %></th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% group.items.forEach(function (item) { %>
                    <% if (item.variants) { %>
                      <% item.variants.forEach(function (variantLabel) { %>
                        <% var vKey = slugify(variantLabel); %>
                        <% var levels = (matrix[item.id] && matrix[item.id][vKey]) || {}; %>
                        <tr>
                          <td class="item-col"><%= item.text %> (<%= variantLabel %>)</td>
                          <% config.levels.forEach(function (lvl) { %>
                            <% var v = Number(levels[lvl.key]) || 1; %>
                            <% var scale = lvl.scaleLabels || config.scaleLabels; %>
                            <td><%= scale[v - 1] %></td>
                          <% }) %>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <% var levels = matrix[item.id] || {}; %>
                      <tr>
                        <td class="item-col"><%= item.text %></td>
                        <% config.levels.forEach(function (lvl) { %>
                          <% var v = Number(levels[lvl.key]) || 1; %>
                          <% var scale = lvl.scaleLabels || config.scaleLabels; %>
                          <td><%= scale[v - 1] %></td>
                        <% }) %>
                      </tr>
                    <% } %>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </fieldset>
        <% }) %>

        <% Object.keys(s.rankings || {}).forEach(function (rid) { %>
          <% if (s.rankings[rid].length) { %>
            <p class="ranking-result"><strong>Classement :</strong> <%= s.rankings[rid].join(" > ") %></p>
          <% } %>
        <% }) %>
        <% Object.keys(s.spectrums || {}).forEach(function (spid) { %>
          <% var sp = section.spectrums.find(function (x) { return x.id === spid; }); %>
          <p class="ranking-result"><strong><%= sp ? sp.label : spid %> :</strong> <%= s.spectrums[spid] %></p>
        <% }) %>
        <% Object.keys(s.multiselects || {}).forEach(function (msid) { %>
          <% if (s.multiselects[msid].length) { %>
            <% var ms = section.multiselects.find(function (x) { return x.id === msid; }); %>
            <p class="ranking-result"><strong><%= ms ? ms.label : msid %> :</strong> <%= s.multiselects[msid].join(", ") %></p>
          <% } %>
        <% }) %>
      <% } else if (section.type === "profile") { %>
        <% var s = submission.scores.sections[section.key]; %>
        <ul class="answer-list">
          <% section.fields.forEach(function (f) { %>
            <li><strong><%= f.label %></strong><br /><span><%= s.fields[f.id] %></span></li>
          <% }) %>
          <% Object.keys(s.rankings || {}).forEach(function (rid) { %>
            <li><strong>Classement</strong><br /><span><%= s.rankings[rid].join(" > ") %></span></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  <% }) %>

  <%
    var bookmarks = (submission.answers && submission.answers.__bookmarks) || { favorite: {} };
    var favoriteRows = [];
    Object.keys(bookmarks.favorite || {}).forEach(function (key) {
      if (!bookmarks.favorite[key]) return;
      var sepIdx = key.indexOf(":");
      var sectionKey = key.slice(0, sepIdx);
      var itemId = key.slice(sepIdx + 1);
      var sec = config.sections.find(function (s) { return s.key === sectionKey; });
      if (!sec) return;
      var match = flattenItemsRaw(sec).find(function (it) { return it.id === itemId; });
      if (!match) return;
      favoriteRows.push({ label: match.text, sectionTitle: sec.title });
    });
  %>
  <% if (favoriteRows.length) { %>
    <div class="result-section">
      <h2>Favoris (<%= favoriteRows.length %>)</h2>
      <ul class="answer-list">
        <% favoriteRows.forEach(function (row) { %>
          <li><span><%= row.label %> <em>(<%= row.sectionTitle %>)</em></span></li>
        <% }) %>
      </ul>
    </div>
  <% } %>
</main>
<%- include('partials/foot') %>
