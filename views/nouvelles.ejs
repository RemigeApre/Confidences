<%- include('partials/head', { title: 'Nouvelles' }) %>
<main class="container wide wiki-locked" style="--ch-hue: 340">
  <%- include('partials/top-nav', { config: config, navTitle: 'Nouvelles', navBack: '/' }) %>
  <%- include('partials/mobile-filter-toggle') %>

  <%# ── Sidebar ─────────────────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer">&times;</button>
    <div class="wiki-chapter-hero">
      <div class="wiki-chapter-hero-top">
        <span class="wiki-chapter-hero-back"></span>
        <h1 class="wiki-chapter-hero-title">Nouvelles</h1>
      </div>
    </div>

    <div class="wiki-sidebar-body filter-sidebar">
      <%- include('partials/filters/filter-base', {
            searchId:    'nv-search',
            showSort:    true,
            sortOptions: [
              { value: 'date-desc',  label: 'Plus récent'  },
              { value: 'date-asc',   label: 'Plus ancien'  },
              { value: 'alpha-asc',  label: 'Alphabétique' },
              { value: 'length-desc',label: 'Plus long'    },
              { value: 'random',     label: 'Aléatoire'    }
            ],
            defaultSort: 'date-desc',
            showType:    true
          }) %>

      <%- include('partials/filters/filter-categories', {
            filterId:   'nv-cat-filter',
            categories: categories,
            label:      'Catégorie'
          }) %>

      <% if (allTags && allTags.length) { %>
        <%- include('partials/filters/filter-tags', {
              filterId: 'nv-tag-filter',
              tags:     allTags,
              label:    'Tags'
            }) %>
      <% } %>

      <%- include('partials/filters/filter-reset', { filterId: 'nv', showExplore: true }) %>
    </div>
  </aside>

  <%# ── Contenu principal ───────────────────────────────────────────────── %>
  <div class="nv-hub">

    <% if (series && series.length) { %>
    <section class="nv-strip">
      <h2 class="nv-strip-title nv-strip-title--center">Séries</h2>
      <div class="nv-serie-cards">
        <% series.forEach(function(s) { %>
          <a href="/nouvelles/series/<%= s.id %>" class="nv-serie-card">
            <div class="nv-serie-card-title"><%= s.title %></div>
            <div class="nv-serie-card-meta">
              <%= s.chapter_count %> chapitre<%= s.chapter_count !== 1 ? 's' : '' %>
              · ~<%= Math.max(1, Math.round((s.total_words || 0) / 200)) %> min
            </div>
            <% if (s.description) { %><div class="nv-serie-card-desc"><%= s.description %></div><% } %>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (recent && recent.length) { %>
    <section class="nv-strip" id="nv-section-recent">
      <h2 class="nv-strip-title nv-strip-title--center">Nouveautés</h2>
      <div class="nv-cards" id="nv-cards-recent">
        <% recent.forEach(function(n) { %>
          <%- include('partials/nouvelle-card', { n: n, categories: categories }) %>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (featured.length) { %>
    <section class="nv-strip" id="nv-section-featured">
      <h2 class="nv-strip-title nv-strip-title--center">Recommandations</h2>
      <div class="nv-cards" id="nv-cards-featured">
        <% featured.forEach(function(n) { %>
          <%- include('partials/nouvelle-card', { n: n, categories: categories }) %>
        <% }) %>
      </div>
    </section>
    <% } %>

    <section class="nv-strip" id="nv-section-all">
      <h2 class="nv-strip-title nv-strip-title--center">Toutes les nouvelles</h2>
      <div class="nv-cards" id="nv-cards-all">
        <% standalone.forEach(function(n) { %>
          <%- include('partials/nouvelle-card', { n: n, categories: categories }) %>
        <% }) %>
      </div>
      <% if (!standalone.length) { %>
        <p class="nv-empty">Aucune nouvelle pour le moment.</p>
      <% } %>
    </section>

  </div>

  <% if (currentUser && currentUser.isAdmin) { %>
    <div class="nv-fab-group" id="nv-fab-group">
      <button type="button" class="wiki-fab-add nv-fab-main" id="nv-fab-main" title="Créer…" aria-expanded="false">+</button>
      <div class="nv-fab-menu" id="nv-fab-menu" hidden>
        <a href="/nouvelles/series/new" class="nv-fab-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          Nouvelle série
        </a>
        <a href="/nouvelles/new" class="nv-fab-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Nouvelle histoire
        </a>
      </div>
    </div>
  <% } %>
</main>

<%# ── Popup modale ────────────────────────────────────────────────────────── %>
<div class="nv-popup-overlay" id="nv-popup-overlay" hidden>
  <div class="nv-popup" id="nv-popup" role="dialog" aria-modal="true">
    <button type="button" class="nv-popup-close" id="nv-popup-close" aria-label="Fermer">&times;</button>
    <div class="nv-popup-header" id="nv-popup-header">
      <span class="nv-popup-cat" id="nv-popup-cat"></span>
      <h2 class="nv-popup-title" id="nv-popup-title"></h2>
      <p class="nv-popup-author" id="nv-popup-author"></p>
      <p class="nv-popup-meta" id="nv-popup-meta"></p>
    </div>
    <p class="nv-popup-summary" id="nv-popup-summary"></p>
    <div class="nv-popup-footer">
      <a href="#" class="nv-card-read-btn" id="nv-popup-read">Lire</a>
    </div>
  </div>
</div>

<script>
(function () {
  var sidebar  = document.getElementById('mobile-filter-sidebar');
  var allCards = Array.from(document.querySelectorAll('.nv-card'));

  // ── État des filtres ──────────────────────────────────────────────────────
  // Les types reprennent les préférences compte (même logique que filter-base)
  var state = {
    search:      '',
    sort:        'date-desc',
    types: {
      ultra:      (window.ULTRA_MODE      === 'hidden') ? 2 : 0,
      irrealiste: (window.IRREALISTE_MODE === 'hidden') ? 2 : 0,
      objet:      0
    },
    catIncluded: [],
    catExcluded: [],
    tagIncluded: [],
    tagExcluded: []
  };

  // Normalise un texte pour la recherche
  function norm(s) {
    return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  // ── Filtre ────────────────────────────────────────────────────────────────
  function applyFilters() {
    var sq = norm(state.search);
    allCards.forEach(function (card) {
      var cat  = card.dataset.category || '';
      var tags = card.dataset.tags ? card.dataset.tags.split(',') : [];
      var hide = false;

      // Recherche
      if (sq && norm(card.dataset.searchText || '').indexOf(sq) === -1) hide = true;

      // Catégories
      if (!hide && state.catIncluded.length && state.catIncluded.indexOf(cat) === -1) hide = true;
      if (!hide && state.catExcluded.length && state.catExcluded.indexOf(cat) !== -1) hide = true;

      // Tags (tous les inclus doivent matcher, aucun exclu)
      if (!hide && state.tagIncluded.length) {
        hide = !state.tagIncluded.every(function (t) { return tags.indexOf(t) !== -1; });
      }
      if (!hide && state.tagExcluded.length) {
        hide = state.tagExcluded.some(function (t) { return tags.indexOf(t) !== -1; });
      }

      // Types : 0=neutre, 1=inclure seulement, 2=exclure
      if (!hide) {
        var isUltra = card.dataset.ultra === '1';
        var isIrr   = card.dataset.irrealiste === '1';
        if (state.types.ultra === 1 && !isUltra)           hide = true;
        if (state.types.ultra === 2 && isUltra)            hide = true;
        if (state.types.irrealiste === 1 && !isIrr)        hide = true;
        if (state.types.irrealiste === 2 && isIrr)         hide = true;
      }

      card.hidden = hide;
    });

    // Masquer les sections entières si toutes leurs cartes sont cachées
    document.querySelectorAll('.nv-strip').forEach(function (section) {
      var cards = section.querySelectorAll('.nv-card');
      if (!cards.length) return;
      section.hidden = Array.from(cards).every(function (c) { return c.hidden; });
    });

    // Trier la section "Toutes"
    sortCards();
  }

  // ── Tri (uniquement la section "Toutes") ─────────────────────────────────
  var _randomSeeds = null;
  function sortCards() {
    var container = document.getElementById('nv-cards-all');
    if (!container) return;
    var cards = Array.from(container.querySelectorAll('.nv-card'));
    if (!cards.length) return;

    if (state.sort === 'random') {
      if (!_randomSeeds) {
        _randomSeeds = new Map();
        cards.forEach(function (c) { _randomSeeds.set(c, Math.random()); });
      }
      cards.sort(function (a, b) { return _randomSeeds.get(a) - _randomSeeds.get(b); });
    } else {
      _randomSeeds = null;
      cards.sort(function (a, b) {
        switch (state.sort) {
          case 'alpha-asc':   return norm(a.dataset.title || '').localeCompare(norm(b.dataset.title || ''));
          case 'date-asc':    return Number(a.dataset.created || 0) - Number(b.dataset.created || 0);
          case 'length-desc': return Number(b.dataset.wc || 0) - Number(a.dataset.wc || 0);
          default:            return Number(b.dataset.created || 0) - Number(a.dataset.created || 0);
        }
      });
    }
    cards.forEach(function (c, i) { c.style.order = i; });
  }

  // ── Listeners sur les événements des partials ─────────────────────────────
  sidebar.addEventListener('filterbase:change', function (e) {
    state.search = e.detail.search || '';
    if (e.detail.sort)    state.sort  = e.detail.sort;
    if (e.detail.types)   state.types = e.detail.types;
    applyFilters();
  });

  sidebar.addEventListener('filtercats:change', function (e) {
    state.catIncluded = e.detail.included || [];
    state.catExcluded = e.detail.excluded || [];
    applyFilters();
  });

  sidebar.addEventListener('tagfilter:change', function (e) {
    state.tagIncluded = e.detail.included || [];
    state.tagExcluded = e.detail.excluded || [];
    applyFilters();
  });

  sidebar.addEventListener('filterreset:reset', function () {
    // Réinitialise l'état
    state = { search: '', sort: 'date-desc', types: { ultra: 0, irrealiste: 0, objet: 0 },
              catIncluded: [], catExcluded: [], tagIncluded: [], tagExcluded: [] };
    // Demande à chaque bloc de réinitialiser son UI
    // Note : les _reset() des blocs re-dispatchent leurs propres événements,
    // ce qui met à jour state une seconde fois — c'est redondant mais sans effet de bord.
    var resetting = true;
    sidebar.querySelectorAll('.filter-block').forEach(function (b) {
      if (typeof b._reset === 'function') b._reset();
    });
    resetting = false; // eslint-disable-line no-unused-vars
    applyFilters();
  });

  sidebar.addEventListener('filterreset:explore', function () {
    var visible = allCards.filter(function (c) { return !c.hidden; });
    if (!visible.length) return;
    openPopup(visible[Math.floor(Math.random() * visible.length)]);
  });

  // Lancer les filtres après init (les partials dispatch au chargement)
  // Le filterbase dispatch automatiquement au load, ça suffit.

  // ── Popup ─────────────────────────────────────────────────────────────────
  var overlay   = document.getElementById('nv-popup-overlay');
  var popHeader = document.getElementById('nv-popup-header');
  var popCat    = document.getElementById('nv-popup-cat');
  var popTitle  = document.getElementById('nv-popup-title');
  var popAuthor = document.getElementById('nv-popup-author');
  var popMeta   = document.getElementById('nv-popup-meta');
  var popSum    = document.getElementById('nv-popup-summary');
  var popRead   = document.getElementById('nv-popup-read');
  var closeBtn  = document.getElementById('nv-popup-close');

  function openPopup(card) {
    var hue = card.dataset.hue || '340';
    popCat.textContent    = card.dataset.cat    || '';
    popTitle.textContent  = card.dataset.title  || '';
    popAuthor.textContent = card.dataset.author ? 'par ' + card.dataset.author : '';
    popMeta.textContent   = card.dataset.meta   || '';
    popSum.textContent    = card.dataset.summary || '';
    popSum.hidden         = !card.dataset.summary;
    popRead.href          = '/nouvelles/' + card.dataset.id;
    popHeader.style.setProperty('--nv-hue', hue);
    popCat.style.setProperty('--nv-hue', hue);
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }
  function closePopup() { overlay.hidden = true; document.body.style.overflow = ''; }

  allCards.forEach(function (card) {
    card.style.cursor = 'pointer';
    card.addEventListener('click', function (e) {
      if (e.target.closest('a, button')) return;
      openPopup(card);
    });
  });
  closeBtn.addEventListener('click', closePopup);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closePopup(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !overlay.hidden) closePopup(); });

  // ── FAB speed-dial ───────────────────────────────────────────────────────
  var fabMain = document.getElementById('nv-fab-main');
  var fabMenu = document.getElementById('nv-fab-menu');
  if (fabMain && fabMenu) {
    fabMain.addEventListener('click', function () {
      var open = !fabMenu.hidden;
      fabMenu.hidden = open;
      fabMain.setAttribute('aria-expanded', String(!open));
      fabMain.textContent = open ? '+' : '×';
    });
    document.addEventListener('click', function (e) {
      if (!fabMain.contains(e.target) && !fabMenu.contains(e.target)) {
        fabMenu.hidden = true;
        fabMain.setAttribute('aria-expanded', 'false');
        fabMain.textContent = '+';
      }
    });
  }
})();
</script>

<%- include('partials/foot') %>
