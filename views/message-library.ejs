<%- include('partials/head', { title: navTitle }) %>
<main class="msg-library-page">
  <%- include('partials/top-nav', { config: config, navBack: '/messages/' + partner.id, navTitle: navTitle }) %>

  <div class="msg-library-header">
    <a href="/messages/<%= partner.id %>" class="msg-thread-back" aria-label="Retour à la discussion">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </a>
    <h1 class="msg-library-title">Partag&eacute; avec <%= partner.displayName %></h1>
  </div>

  <% var libImages = items.filter(function (it) { return it.type === 'image'; }); %>
  <% var libPages  = items.filter(function (it) { return it.type !== 'image'; }); %>

  <% if (!items.length) { %>
    <p class="msg-list-empty">Rien de partag&eacute; pour l&rsquo;instant.</p>
  <% } else { %>

    <% if (libImages.length) { %>
      <h2 class="msg-library-section-title">Images</h2>
      <div class="msg-library-grid msg-library-grid--images">
        <% libImages.forEach(function (it) { %>
          <div class="msg-library-item" data-id="<%= it.id %>">
            <a class="msg-ref-img msg-library-img" href="<%= it.href %>" target="_blank" rel="noopener">
              <% if (it.thumb) { %><img src="<%= it.thumb %>" alt="" loading="lazy" /><% } %>
            </a>
            <button type="button" class="msg-library-remove" data-id="<%= it.id %>" aria-label="Retirer" title="Retirer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (libPages.length) { %>
      <h2 class="msg-library-section-title">Pages Codex &amp; BD</h2>
      <div class="msg-library-grid msg-library-grid--pages">
        <% libPages.forEach(function (it) { %>
          <div class="msg-library-item" data-id="<%= it.id %>">
            <a class="msg-ref-card msg-library-card" href="<%= it.href %>">
              <% if (it.thumb) { %>
                <img class="msg-ref-thumb" src="<%= it.thumb %>" alt="" loading="lazy" />
              <% } else { %>
                <span class="msg-ref-thumb--icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </span>
              <% } %>
              <span class="msg-ref-title"><%= it.title %></span>
            </a>
            <button type="button" class="msg-library-remove" data-id="<%= it.id %>" aria-label="Retirer" title="Retirer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        <% }) %>
      </div>
    <% } %>

  <% } %>
</main>

<script nonce="<%= nonce %>">
(function () {
  document.querySelectorAll('.msg-library-remove').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var id = parseInt(btn.dataset.id, 10);
      if (!id) return;
      try {
        var r = await fetch('/messages/shared/' + id, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
        var data = await r.json();
        if (data.ok) {
          var item = btn.closest('.msg-library-item');
          if (item) item.remove();
        }
      } catch (_) {}
    });
  });
})();
</script>

<style>
.msg-library-page{max-width:720px;margin:0 auto;padding:1rem 1.25rem 3rem}
.msg-library-header{display:flex;align-items:center;gap:.6rem;margin-bottom:1.2rem}
.msg-library-title{font-size:1.1rem;font-weight:700;margin:0}
.msg-library-section-title{font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:1.6rem 0 .75rem}
.msg-library-section-title:first-of-type{margin-top:0}
.msg-library-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1.1rem}
.msg-library-item{position:relative}
.msg-library-img{max-width:none;margin-top:0}
.msg-library-img img{height:140px}
.msg-library-card{max-width:none;margin-top:0}
/* Croix rouge nue : pas de cercle, pas de fond, pas de contour. */
.msg-library-remove{position:absolute;top:.35rem;right:.35rem;width:24px;height:24px;border:none;background:none;padding:0;color:hsl(0,80%,62%);cursor:pointer;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 1px 2px rgba(0,0,0,.7))}
.msg-library-remove svg{width:15px;height:15px}
.msg-library-remove:hover{color:hsl(0,85%,70%)}
@media(max-width:640px){
  .msg-library-page{padding:.85rem .9rem 2.5rem}
  .msg-library-grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:.8rem}
  /* Cible agrandie (pas de hover tactile) pour une action irréversible. */
  .msg-library-remove{width:32px;height:32px;top:.25rem;right:.25rem}
  .msg-library-remove svg{width:17px;height:17px}
}
</style>

<%- include('partials/foot') %>
