<%- include('partials/head', { title: 'Tags : Masqués' }) %>
<main class="container wide wiki-locked tags-page-locked" style="--ch-hue: 270">
  <%- include('partials/top-nav', { config: config }) %>

  <%# ─── SIDEBAR (même bandeau que /tags, juste épuré des filtres) ────────── %>
  <aside class="wiki-cat-sidebar tags-sidebar">
    <div class="wiki-chapter-hero">
      <div class="wiki-chapter-hero-top">
        <a href="/tags" class="wiki-chapter-hero-back" title="Retour à tous les tags">&larr;</a>
        <h1 class="wiki-chapter-hero-title">Masqu&eacute;s</h1>
        <span class="wiki-chapter-hero-count" id="tags-masked-count"><%= blacklist.length %></span>
      </div>
    </div>
  </aside>

  <%# ─── LISTE DES TAGS MASQUÉS ─────────────────────────────────────────── %>
  <div class="tags-blacklist-grid" id="tags-blacklist-grid">
    <% blacklist.forEach(function (item) { %>
      <div class="tags-blacklist-item" data-tag="<%= item.tag %>">
        <span class="tags-blacklist-name"><%= item.tag %></span>
        <button type="button" class="tags-blacklist-remove" title="Retirer de la liste" aria-label="Retirer &laquo;&nbsp;<%= item.tag %>&nbsp;&raquo; de la liste">&times;</button>
      </div>
    <% }) %>
  </div>
  <p class="tags-blacklist-empty" id="tags-blacklist-empty" <%= blacklist.length ? 'hidden' : '' %>>Aucun tag masqu&eacute; pour l&rsquo;instant.</p>

</main>

<script>
(function () {
  var grid  = document.getElementById("tags-blacklist-grid");
  var empty = document.getElementById("tags-blacklist-empty");
  var countEl = document.getElementById("tags-masked-count");
  if (!grid) return;

  grid.addEventListener("click", function (e) {
    var btn = e.target.closest(".tags-blacklist-remove");
    if (!btn) return;
    var item = btn.closest(".tags-blacklist-item");
    var tag = item.dataset.tag;
    btn.disabled = true;
    fetch("/api/tags/blacklist", {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ tag: tag }),
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) { btn.disabled = false; return; }
        item.remove();
        if (window.TAG_BLACKLIST) {
          var idx = window.TAG_BLACKLIST.indexOf(tag);
          if (idx !== -1) window.TAG_BLACKLIST.splice(idx, 1);
        }
        var remaining = grid.querySelectorAll(".tags-blacklist-item").length;
        if (countEl) countEl.textContent = remaining;
        if (empty && remaining === 0) empty.hidden = false;
      })
      .catch(function () { btn.disabled = false; });
  });
})();
</script>

<%- include('partials/foot') %>
