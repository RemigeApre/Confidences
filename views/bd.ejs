<%- include('partials/head', { title: 'BD' }) %>
<main class="container wide gallery-has-sidebar">
  <%- include('partials/top-nav', { config: config, navTitle: 'BD', navBack: '/' }) %>

  <%- include('partials/mobile-filter-toggle') %>

  <%# ── SIDEBAR GAUCHE ──────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar gallery-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer les filtres">&times;</button>
    <%- include('partials/sidebar-hero', { title: 'BD', hue: 28, count: books.length, countId: 'bd-count-hero' }) %>

    <div class="wiki-sidebar-body">

      <%- include('partials/search-bar', { searchId: 'bd-search' }) %>

      <%# ── Filtres : toujours visible ── %>
      <details class="wiki-sidebar-filter-details" open>
        <summary class="wiki-sidebar-filter-summary" data-fr="Filtres" data-en="Filters">Filtres</summary>
        <div class="wiki-sidebar-filters">

          <%# 1. Ultra / Irréaliste %>
          <%- include('partials/filters/filter-base', {
                searchId: 'bd-search',
                showType: true
              }) %>

          <%# Couleur + Langue — toggles groupés %>
          <div class="wiki-filter-section wiki-filter-toggles">
            <button type="button" id="bd-couleur-toggle" class="wiki-ultra-btn" data-fr="✧ Couleur" data-en="✧ Color">&#127775; Couleur</button>
          </div>
          <div class="bd-langue-filter" id="bd-langue-filter">
            <button type="button" class="bd-langue-chip" data-langue="francais"><img src="https://flagcdn.com/40x30/fr.png" alt="Français" class="bd-flag-lg" /></button>
            <button type="button" class="bd-langue-chip" data-langue="anglais"><img src="https://flagcdn.com/40x30/gb.png" alt="Anglais" class="bd-flag-lg" /></button>
            <button type="button" class="bd-langue-chip" data-langue="japonais"><img src="https://flagcdn.com/40x30/jp.png" alt="Japonais" class="bd-flag-lg" /></button>
            <button type="button" class="bd-langue-chip" data-langue="autre"><span class="bd-flag-globe">🌐</span></button>
          </div>

          <%# 3. Catégories %>
          <details class="wiki-subpanel-details" open>
            <summary class="wiki-subpanel-summary">Cat&eacute;gories</summary>
            <div class="wiki-filter-section wiki-filter-toggles bd-cat-filter-grid" id="bd-cat-filter">
              <% [['inconnu','#6b7280'],['groupe','#7c3aed'],['monstre','#b45309'],['pokémon','#dc2626'],['animaux','#16a34a'],['bdsm','#db2777']].forEach(function(c) { %>
                <button type="button" class="bd-cat-chip" data-cat="<%= c[0] %>" style="--cat-color:<%= c[1] %>">
                  <%= c[0].charAt(0).toUpperCase() + c[0].slice(1) %>
                </button>
              <% }) %>
            </div>
          </details>

          <%# 4. Parodie %>
          <% if (allParodies && allParodies.length) { %>
            <%- include('partials/filters/filter-parodies', {
                  filterId:  'bd-parody-filter',
                  parodies:  allParodies,
                  label:     'Parodies',
                  labelEn:   'Parodies'
                }) %>
          <% } %>

          <%# 4. Personnages %>
          <% if (allProtagonists && allProtagonists.length) { %>
          <details class="wiki-subpanel-details">
            <summary class="wiki-subpanel-summary" data-fr="Personnages" data-en="Characters">Personnages</summary>
            <input type="search" id="bd-prot-search" class="wiki-tag-search-input"
              placeholder="Chercher un personnage" autocomplete="off" />
            <div class="wiki-tag-cloud" id="bd-prot-filter">
              <% allProtagonists.forEach(function(p) { %>
                <button type="button" class="wiki-tag-chip bd-prot-chip" data-prot-id="<%= p.id %>">
                  <span class="wtc-label"><%= p.name %></span>
                </button>
              <% }) %>
            </div>
          </details>
          <% } %>

          <%# 5. Tags %>
          <% if (allTags && allTags.length) { %>
            <%- include('partials/filters/filter-tags', {
                  filterId:      'bd-tag-filter',
                  tags:          allTags,
                  label:         'Tags',
                  labelEn:       'Tags',
                  openByDefault: true
                }) %>
          <% } %>

          <%# 6. Notation %>
          <%- include('partials/filters/filter-rating', {
                filterId:        'bd-rating',
                label:           'Notation',
                labelEn:         'Rating',
                showFlame:       true,
                showInterested:  true,
                interestedLabel: 'Intéressé',
                showNotRated:    true
              }) %>

        </div>
      </details>

      <%- include('partials/filters/filter-reset', { filterId: 'bd', showExplore: true, resetLabel: 'Réinitialiser les filtres' }) %>

    </div>
  </aside>

  <% if (currentUser && currentUser.isAdmin) { %>
  <div class="gallery-fab-wrap">
    <a href="/bd/new" class="wiki-fab-add" title="Nouvelle BD">+</a>
  </div>
  <% } %>

  <% if (!books.length) { %>
    <p class="intro">Aucune BD pour l&apos;instant.</p>
  <% } else { %>
    <div class="bd-grid" id="bd-grid">
      <% books.forEach(function(book) { %>
        <a href="/bd/<%= book.id %>" class="bd-card"
          data-bd-id="<%= book.id %>"
          data-ultra="<%= book.tags.indexOf('ultra') !== -1 ? '1' : '0' %>"
          data-irrealiste="<%= (book.tags.indexOf('irréaliste') !== -1 || book.tags.indexOf('fantaisie') !== -1) ? '1' : '0' %>"
          data-tags="<%= book.tags.join(',') %>"
          data-title="<%= t(book.title, 'bd', book.id, 'title').toLowerCase() %>"
          data-langue="<%= book.langue || '' %>"
          data-couleur="<%= book.tags.indexOf('en couleur') !== -1 ? '1' : '0' %>"
          data-rating="<%= book.rating || 0 %>"
          data-flame="<%= book.flame ? '1' : '0' %>"
          data-interested="<%= book.interested ? '1' : '0' %>"
          data-parody="<%= (book.parody || '').replace(/"/g, '') %>"
          data-protagonists="<%= (book.protagonistIds || []).join(',') %>"
          data-categories="<%= (book.categories || []).join(',') %>">
          <% if (book.imagePaths && book.imagePaths.length) { %>
            <div class="bd-card-cover">
              <img src="<%= thumbUrl(book.imagePaths[0]) %>" alt="" class="bd-card-img" loading="lazy" />
              <% if (book.langue === 'francais') { %><span class="bd-card-flag"><img src="https://flagcdn.com/20x15/fr.png" alt="FR" class="bd-flag-img" /></span>
              <% } else if (book.langue === 'anglais') { %><span class="bd-card-flag"><img src="https://flagcdn.com/20x15/gb.png" alt="EN" class="bd-flag-img" /></span>
              <% } else if (book.langue === 'japonais') { %><span class="bd-card-flag"><img src="https://flagcdn.com/20x15/jp.png" alt="JP" class="bd-flag-img" /></span>
              <% } else if (book.langue === 'autre') { %><span class="bd-card-flag">🌐</span><% } %>
            </div>
          <% } else { %>
            <div class="bd-card-cover bd-card-cover-empty">
              <span class="bd-card-empty-icon">&#128214;</span>
            </div>
          <% } %>
          <div class="bd-card-body">
            <p class="bd-card-title"><%= t(book.title, 'bd', book.id, 'title') %></p>
            <p class="bd-card-meta">
              <% if (book.chapters && book.chapters.length) { %><%= book.chapters.length %>&nbsp;chapitre<%= book.chapters.length > 1 ? 's' : '' %>&nbsp;&#183;&nbsp;<% } %><%= book.imagePaths.length %>&nbsp;page<%= book.imagePaths.length > 1 ? 's' : '' %>
            </p>
            <div class="bd-card-reactions">
              <% if (book.flame) { %><span class="bd-card-react-badge" title="J&rsquo;adore">&#128293;</span><% } %>
              <% if (book.interested) { %><span class="bd-card-react-badge" title="Ça m&rsquo;int&eacute;resse">&#10024;</span><% } %>
              <% if (book.rating > 0) { %>
                <span class="bd-card-rating"><%= book.rating %><span class="bd-card-star">&#9733;</span></span>
              <% } %>
              <% if (book.partnerReaction) { %><span class="bd-card-react-badge" title="Votre partenaire a noté cette BD">&#127800;</span><% } %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>

<%# ── Données BD pour le modal (JSON embarqué) ── %>
<script type="application/json" id="bd-data-json"><%- JSON.stringify(books.map(function(b) {
  return {
    id: b.id, title: b.title, description: b.description, tags: b.tags,
    imagePaths: b.imagePaths.slice(0, 11).map(function(p){ return thumbUrl(p); }),
    totalPages: b.imagePaths.length,
    flame: b.flame, interested: b.interested, rating: b.rating,
    parody: b.parody || '', subParody: b.subParody || '',
    categories: b.categories || [],
    langue: b.langue || '',
    chaptersCount: (b.chapters || []).length
  };
})) %></script>

<%# ── Modal BD ── %>
<div class="bd-modal-overlay" id="bd-modal" hidden aria-modal="true" role="dialog">
  <div class="bd-modal">
    <button type="button" class="bd-modal-close" id="bd-modal-close" aria-label="Fermer">&#215;</button>

    <div class="bd-modal-top">
      <div class="bd-modal-cover-wrap">
        <img id="bd-modal-cover" src="" alt="" class="bd-modal-cover-img" />
      </div>
      <div class="bd-modal-info">
        <h2 class="bd-modal-title" id="bd-modal-title"></h2>
        <div class="bd-modal-meta" id="bd-modal-meta"></div>
        <div class="bd-modal-cats" id="bd-modal-cats"></div>
        <div class="bd-modal-parody" id="bd-modal-parody" hidden></div>
        <p class="bd-modal-desc" id="bd-modal-desc"></p>
        <div class="bd-modal-tags" id="bd-modal-tags"></div>
        <div class="bd-modal-reactions" id="bd-modal-reactions"></div>
      </div>
    </div>

    <div class="bd-modal-preview-wrap" id="bd-modal-preview-wrap">
      <p class="bd-modal-preview-label">Aper&ccedil;u</p>
      <div class="bd-modal-preview" id="bd-modal-preview"></div>
    </div>

    <div class="bd-modal-footer">
      <a href="#" id="bd-modal-read-btn" class="bd-modal-read-btn">Lire &rarr;</a>
    </div>
  </div>
</div>

<script nonce="<%= nonce %>">
window.BD_PROTAGONISTS = <%- JSON.stringify((allProtagonists || []).reduce(function(m, p) { m[p.id] = p.name; return m; }, {})) %>;
</script>
<script nonce="<%= nonce %>" src="/bd.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
