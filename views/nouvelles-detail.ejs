<%
  var cat     = categories.find(function(c) { return c.key === nouvelle.category; });
  var hue     = cat ? cat.hue : 340;
  var wc      = nouvelle.word_count || 0;
  var readMin = Math.max(1, Math.round(wc / 200));
  var stageObj = (stages || []).find(function(s){ return s.key === nouvelle.stage; });
  var userRating = (userReaction && userReaction.rating) || 0;
  var userFlame  = !!(userReaction && userReaction.flame);
%>
<%- include('partials/head', { title: nouvelle.title }) %>
<main class="container wide" style="--ch-hue: <%= hue %>">
  <%- include('partials/top-nav', { config: config, navTitle: nouvelle.title, navBack: serie ? '/nouvelles/series/' + serie.id : '/nouvelles' }) %>

  <%# ── Colonne gauche fixe : retour + actions admin (desktop) ─────────── %>
  <div class="nv-reader-left">
    <a href="<%= serie ? '/nouvelles/series/' + serie.id : '/nouvelles' %>" class="nv-reader-back" aria-label="Retour">
      <span class="nv-reader-back-arrow">&#8592;</span>
      <span class="nv-reader-back-label">Retour</span>
    </a>
    <% if (currentUser && currentUser.isAdmin) { %>
      <div class="nv-reader-left-admin">
        <a href="/nouvelles/<%= nouvelle.id %>/edit" class="nv-reader-left-btn" title="Modifier">&#9998;</a>
        <form method="POST" action="/nouvelles/<%= nouvelle.id %>/delete" style="margin:0"
          onsubmit="return confirm('Supprimer cette nouvelle définitivement ?')">
          <button type="submit" class="nv-reader-left-btn nv-reader-left-del" title="Supprimer">&#128465;</button>
        </form>
      </div>
    <% } %>
  </div>

  <div class="wiki-detail-layout">

    <%# ── Corps : UNIQUEMENT le texte ─────────────────────────────────────── %>
    <div class="wiki-detail-body nv-reader-body">

      <% if (nouvelle.summary) { %>
        <p class="nv-reader-accroche"><em><%= nouvelle.summary %></em></p>
      <% } %>

      <div class="nv-reader-content"><%- contentHtml %></div>

      <% if (serie && (prev || next)) { %>
        <nav class="nv-chapter-nav">
          <% if (prev) { %>
            <a href="/nouvelles/<%= prev.id %>" class="nv-chapter-nav-btn nv-chapter-nav-prev">
              <span class="nv-chapter-nav-arrow">&#8592;</span>
              <span class="nv-chapter-nav-label">
                <span class="nv-chapter-nav-hint">Chapitre précédent</span>
                <span class="nv-chapter-nav-title"><%= prev.title %></span>
              </span>
            </a>
          <% } else { %><span></span><% } %>
          <% if (next) { %>
            <a href="/nouvelles/<%= next.id %>" class="nv-chapter-nav-btn nv-chapter-nav-next">
              <span class="nv-chapter-nav-label">
                <span class="nv-chapter-nav-hint">Chapitre suivant</span>
                <span class="nv-chapter-nav-title"><%= next.title %></span>
              </span>
              <span class="nv-chapter-nav-arrow">&#8594;</span>
            </a>
          <% } %>
        </nav>
      <% } %>
    </div><%# /wiki-detail-body %>

    <%# ── Volet droit (PC) ─────────────────────────────────────────────────── %>
    <aside class="wiki-detail-right" style="--ch-hue: <%= hue %>">

      <%# Titre centré %>
      <div class="nv-right-title-block">
        <h1 class="nv-right-title"><%= nouvelle.title %></h1>
        <% if (stageObj && (stageObj.key !== 'stade_1' || nouvelle.hidden)) { %>
          <span class="nv-right-stage-badge<%= nouvelle.hidden ? ' nv-right-stage-hidden' : '' %>"><%= stageObj.label %><%= nouvelle.hidden ? ' · Masqué' : '' %></span>
        <% } %>
      </div>

      <%# Protagonistes %>
      <% if (protagonistes && protagonistes.length) { %>
        <div class="nv-right-section">
          <p class="nv-right-section-label">Personnages</p>
          <div class="nv-right-prot-list">
            <% protagonistes.forEach(function(p) { %>
              <a href="/protagonistes/<%= p.id %>" class="nv-right-prot-link"><%= p.name %></a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <%# Tags (avec classification ultra/irréaliste via tagRegistry) %>
      <% if (nouvelle.tags && nouvelle.tags.length) { %>
        <div class="nv-right-tags">
          <% nouvelle.tags.forEach(function(t) { %><%- include('partials/tag-badge', { tag: t }) %><% }) %>
        </div>
      <% } %>

      <%# Parodie %>
      <% if (nouvelle.parody) { %>
        <div class="nv-right-section nv-right-parody">
          <p class="nv-right-section-label">Parodie</p>
          <a href="/parodies/<%= encodeURIComponent(nouvelle.parody) %>" class="nv-right-parody-link"><%= nouvelle.parody %></a>
          <% if (nouvelle.subParody) { %>
            <span class="nv-right-parody-sep"> › </span>
            <a href="/parodies/<%= encodeURIComponent(nouvelle.parody) %>/<%= encodeURIComponent(nouvelle.subParody) %>" class="nv-right-parody-link nv-right-parody-sub"><%= nouvelle.subParody %></a>
          <% } %>
        </div>
      <% } %>

      <%# Réactions (étoiles + J'adore) — collées en bas du volet %>
      <% if (currentUser) { %>
        <div class="nv-right-reactions" data-id="<%= nouvelle.id %>" data-rating="<%= userRating %>" data-flame="<%= userFlame ? '1' : '0' %>">
          <div class="wiki-detail-rating nv-right-rating">
            <% for (var i = 1; i <= 5; i++) { %>
              <button type="button" class="wiki-star wiki-star-lg<%= i <= userRating ? ' filled' : '' %>" data-value="<%= i %>"><%- i <= userRating ? '&#9733;' : '&#9734;' %></button>
            <% } %>
          </div>
          <button type="button" class="wiki-react-btn wiki-react-flame nv-right-flame<%= userFlame ? ' active' : '' %>" data-key="flame">
            <span class="wiki-react-icon">&#128293;</span><span class="wiki-react-label">J&apos;adore</span>
          </button>
        </div>
      <% } %>

    </aside><%# /wiki-detail-right %>

  </div><%# /wiki-detail-layout %>

</main>

<% if (currentUser) { %>
<script>
(function() {
  var widget = document.querySelector('.nv-right-reactions');
  if (!widget) return;
  var nvId      = widget.dataset.id;
  var nvRating  = Number(widget.dataset.rating) || 0;
  var nvFlame   = widget.dataset.flame === '1';
  var starBtns  = widget.querySelectorAll('.wiki-star');
  var flamBtn   = widget.querySelector('.nv-right-flame');

  function save() {
    fetch('/nouvelles/' + nvId + '/react', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ rating: nvRating, flame: nvFlame }),
    });
  }

  function renderStars() {
    starBtns.forEach(function(btn) {
      var v = Number(btn.dataset.value);
      btn.classList.toggle('filled', v <= nvRating);
    });
    if (typeof patchStars === 'function') patchStars();
  }
  renderStars();

  starBtns.forEach(function(btn) {
    var v = Number(btn.dataset.value);
    btn.addEventListener('mouseenter', function() {
      starBtns.forEach(function(b) {
        b.classList.toggle('filled', Number(b.dataset.value) <= v);
      });
      if (typeof patchStars === 'function') patchStars();
    });
    btn.addEventListener('mouseleave', renderStars);
    btn.addEventListener('click', function() {
      nvRating = (nvRating === v) ? 0 : v;
      renderStars();
      save();
    });
  });

  if (flamBtn) {
    flamBtn.addEventListener('click', function() {
      nvFlame = !nvFlame;
      flamBtn.classList.toggle('active', nvFlame);
      save();
    });
  }
})();
</script>
<% } %>

<%- include('partials/foot') %>
