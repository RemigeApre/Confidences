<%- include('partials/head', { title: config.title }) %>
<main class="container wide">
  <%- include('partials/top-nav', { config: config }) %>

  <section class="home-hero">
    <h1 class="home-hero-title">Explorer et d&eacute;couvrir</h1>
    <div class="home-hero-rule"></div>
  </section>

  <section class="home-carousel" aria-roledescription="carrousel" aria-label="Les quatre cat&eacute;gories de fantasmes">
    <button type="button" class="home-carousel-arrow home-carousel-arrow--prev" id="home-carousel-prev" aria-label="Cat&eacute;gories pr&eacute;c&eacute;dentes">&#10094;</button>

    <div class="home-carousel-viewport">
      <div class="home-carousel-track" id="home-carousel-track">

        <div class="home-carousel-page">
          <div class="home-cat home-cat--i">
            <div class="home-cat-header">
              <span class="home-cat-num">I</span>
              <span class="home-cat-subtitle">Le possible et le consenti</span>
            </div>
            <p class="home-cat-body">Les fantasmes que vous aimez, que vous avez d&eacute;j&agrave; pratiqu&eacute;s ou que vous pourriez souhaiter pratiquer. Ils appartiennent au domaine du possible, du consenti et du r&eacute;alisable.</p>
          </div>
          <div class="home-cat home-cat--ii">
            <div class="home-cat-header">
              <span class="home-cat-num">II</span>
              <span class="home-cat-subtitle">L&rsquo;imaginaire pr&eacute;f&eacute;r&eacute;</span>
            </div>
            <p class="home-cat-body">Les fantasmes que vous pr&eacute;f&eacute;rez conserver dans l&rsquo;imaginaire. Vous pouvez les appr&eacute;cier, les explorer ou les comprendre sans souhaiter les r&eacute;aliser. Certains peuvent &ecirc;tre simplement incompatibles avec vos envies r&eacute;elles&nbsp;; d&rsquo;autres peuvent &ecirc;tre dangereux, immoraux ou interdits par la loi. Fantasmer n&rsquo;oblige jamais &agrave; agir.</p>
          </div>
        </div>

        <div class="home-carousel-page">
          <div class="home-cat home-cat--iii">
            <div class="home-cat-header">
              <span class="home-cat-num">III</span>
              <span class="home-cat-subtitle">L&rsquo;impossible</span>
            </div>
            <p class="home-cat-body">Ils rel&egrave;vent de la fiction, de la magie, de cr&eacute;atures, de transformations ou de situations qui ne peuvent pas exister dans la r&eacute;alit&eacute;. Ils appartiennent pleinement &agrave; l&rsquo;imaginaire.</p>
          </div>
          <div class="home-cat home-cat--iv">
            <div class="home-cat-header">
              <span class="home-cat-num">IV</span>
              <span class="home-cat-subtitle">Ce qui ne vous attire pas</span>
            </div>
            <p class="home-cat-body">Certaines pratiques, situations ou fantasmes peuvent vous laisser indiff&eacute;rent ou vous d&eacute;go&ucirc;ter. Les conna&icirc;tre ou les explorer intellectuellement ne signifie pas les d&eacute;sirer.</p>
          </div>
        </div>

      </div>
    </div>

    <button type="button" class="home-carousel-arrow home-carousel-arrow--next" id="home-carousel-next" aria-label="Cat&eacute;gories suivantes">&#10095;</button>
  </section>

  <div class="home-carousel-dots" id="home-carousel-dots">
    <button type="button" class="home-carousel-dot active" aria-label="Cat&eacute;gories I et II"></button>
    <button type="button" class="home-carousel-dot" aria-label="Cat&eacute;gories III et IV"></button>
  </div>
  <!-- Les points restent hors de la balise section (largeur pleine, centrés
       indépendamment des flèches) : voir .home-carousel-dots en CSS. -->

  <section class="home-actions">
    <a href="/wiki" class="home-action home-action--wiki">Codex</a>
    <a href="/section/<%= quizIdx %>" class="home-action home-action--quizz">Quizz</a>
    <a href="/galerie" class="home-action home-action--galerie">Galerie</a>
  </section>
</main>

<% if (currentUser) { %>
<div id="quiz-warning-popup" class="quiz-warning-overlay" hidden>
  <div class="quiz-warning-box">
    <p class="quiz-warning-text">Le quizz n&apos;a pas &eacute;t&eacute; retravill&eacute;. Actuellement seul codex et galerie l&apos;ont &eacute;t&eacute;. Vous &ecirc;tes alors sur un espace du site ancien et non &agrave; jour.</p>
    <button type="button" id="quiz-warning-ok" class="quiz-warning-btn">OK</button>
  </div>
</div>
<script>
(function() {
  if (!sessionStorage.getItem("quiz-warning-seen")) {
    var popup = document.getElementById("quiz-warning-popup");
    if (popup) popup.hidden = false;
    var btn = document.getElementById("quiz-warning-ok");
    if (btn) btn.addEventListener("click", function() {
      popup.hidden = true;
      sessionStorage.setItem("quiz-warning-seen", "1");
    });
  }
})();
</script>
<% } %>

<%- include('partials/foot') %>
