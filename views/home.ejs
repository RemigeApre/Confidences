<%- include('partials/head', { title: 'Confidence : encyclopédie de sexologie illustrée FR/EN', allowIndex: true, metaDescription: config.description || 'Confidence, encyclopédie de sexologie bilingue FR/EN. Positions, pratiques, fantasmes, tenues, objets, BDSM et plus. Contenu illustré, sans photos réelles.' }) %>

<div class="home-wrap">

  <%# ── Sidebar gauche : catégories de fantasmes ──────────────────────── %>
  <aside class="home-sidebar" aria-label="Catégories de fantasmes">
    <p class="home-sidebar-label">Catégories de fantasmes</p>
    <div class="home-sidebar-cats">

      <div class="home-cat home-cat--i">
        <div class="home-cat-header">
          <span class="home-cat-num">I</span>
          <span class="home-cat-subtitle" data-fr="Possible et consenti" data-en="Possible and consensual">Possible et consenti</span>
        </div>
        <p class="home-cat-body" data-fr="Les fantasmes que vous aimez, déjà pratiqués ou que vous pourriez souhaiter pratiquer. Ils appartiennent au domaine du possible, du consenti et du réalisable." data-en="Fantasies you enjoy, have already experienced, or might wish to try. They belong to the realm of the possible, consensual, and achievable.">Les fantasmes que vous aimez, d&eacute;j&agrave; pratiqu&eacute;s ou que vous pourriez souhaiter pratiquer. Ils appartiennent au domaine du possible, du consenti et du r&eacute;alisable.</p>
      </div>

      <div class="home-cat home-cat--ii">
        <div class="home-cat-header">
          <span class="home-cat-num">II</span>
          <span class="home-cat-subtitle" data-fr="Imaginaire" data-en="Imaginary">Imaginaire</span>
        </div>
        <p class="home-cat-body" data-fr="Les fantasmes que vous préférez conserver dans l'imaginaire. Certains sont incompatibles avec vos envies réelles ; d'autres peuvent être dangereux, immoraux ou interdits par la loi. Fantasmer n'oblige jamais à agir." data-en="Fantasies you prefer to keep in imagination. Some may be incompatible with your actual desires; others may be dangerous, immoral, or illegal. Fantasizing never obliges you to act.">Les fantasmes que vous pr&eacute;f&eacute;rez conserver dans l&rsquo;imaginaire. Certains sont incompatibles avec vos envies r&eacute;elles&nbsp;; d&rsquo;autres peuvent &ecirc;tre dangereux, immoraux ou interdits par la loi. Fantasmer n&rsquo;oblige jamais &agrave; agir.</p>
      </div>

      <div class="home-cat home-cat--iii">
        <div class="home-cat-header">
          <span class="home-cat-num">III</span>
          <span class="home-cat-subtitle" data-fr="Impossible" data-en="Impossible">Impossible</span>
        </div>
        <p class="home-cat-body" data-fr="Ils relèvent de la fiction, de créatures, de transformations ou de situations qui ne peuvent pas exister dans la réalité. Ils appartiennent pleinement à l'imaginaire." data-en="They belong to fiction, creatures, transformations, or situations that cannot exist in reality. They belong entirely to imagination.">Ils rel&egrave;vent de la fiction, de cr&eacute;atures, de transformations ou de situations qui ne peuvent pas exister dans la r&eacute;alit&eacute;. Ils appartiennent pleinement &agrave; l&rsquo;imaginaire.</p>
      </div>

      <div class="home-cat home-cat--iv">
        <div class="home-cat-header">
          <span class="home-cat-num">IV</span>
          <span class="home-cat-subtitle" data-fr="Désintérêt" data-en="Disinterest">D&eacute;sint&eacute;r&ecirc;t</span>
        </div>
        <p class="home-cat-body" data-fr="Certaines pratiques ou fantasmes peuvent vous laisser indifférent ou vous dégoûter. Les connaître intellectuellement ne signifie pas les désirer." data-en="Some practices or fantasies may leave you indifferent or repulse you. Knowing them intellectually does not mean desiring them.">Certaines pratiques ou fantasmes peuvent vous laisser indiff&eacute;rent ou vous d&eacute;go&ucirc;ter. Les conna&icirc;tre intellectuellement ne signifie pas les d&eacute;sirer.</p>
      </div>

    </div>
  </aside>

  <%# ── Colonne principale ──────────────────────────────────────────────── %>
  <main class="home-col">
    <div class="container wide">
      <%- include('partials/top-nav', { config: config }) %>

      <%# ── Slogan ──────────────────────────────────────────────────────── %>
      <section class="home-slogan" aria-label="Slogan">
        <p class="home-slogan-text" data-fr="Votre espace d'exploration sexuelle : illustré, sans jugement, en toute confidentialité." data-en="Your space for sexual exploration: illustrated, non-judgmental, fully confidential.">Votre espace d&rsquo;exploration sexuelle&nbsp;: illustr&eacute;, sans jugement, en toute confidentialit&eacute;.</p>
      </section>

      <%# ── Changelog ──────────────────────────────────────────────────── %>
      <% if (changelogs && changelogs.length) { %>
      <section class="home-changelog">
        <h2 class="home-changelog-title">Notes de version</h2>
        <div class="home-cl-cards">
          <%
            var CL_TAG_META = {
              nouveaute:     { label: 'Nouveauté',      cls: 'tag--new'  },
              fonctionnalite:{ label: 'Fonctionnalité', cls: 'tag--feat' },
              structure:     { label: 'Structure',      cls: 'tag--struct'},
              securite:      { label: 'Sécurité',       cls: 'tag--sec'  }
            };
          %>
          <% changelogs.forEach(function(cl) { %>
            <%
              var imp = cl.importance || 0;
              var clTags = Array.isArray(cl.tags) ? cl.tags : [];
              var versionMatch = cl.title.match(/\b(alpha|b[eê]ta)\s*([\d.]+)/i);
              var versionTag  = versionMatch ? versionMatch[0] : null;
              var vtLetter    = versionTag ? versionTag.charAt(0).toUpperCase() : null;
              var vtNum       = versionMatch ? versionMatch[2] : null;
              var vtNumParts  = vtNum ? vtNum.split('.') : [];
              var vtMajor     = vtNumParts[0] || '';
              var vtMinorChars = vtNumParts[1] ? vtNumParts[1].split('') : [];
              var displayTitle = versionTag
                ? cl.title.replace(versionMatch[0], '').replace(/^\s*[-:·]\s*/, '').trim()
                : cl.title;
              var excerpt = cl.body ? cl.body.replace(/<[^>]+>/g,'').slice(0,100) + (cl.body.length > 100 ? '\u2026' : '') : '';
              var impKey = ['','major','crit'][imp] || '';
            %>
            <button class="home-cl-card home-cl-card--imp<%= imp %>" data-cl-id="<%= cl.id %>" type="button" aria-haspopup="dialog">
              <% if (versionTag) { %>
              <div class="home-cl-vtag" aria-hidden="true">
                <span class="home-cl-vtag-letter"><%= vtLetter %></span>
                <% if (vtMajor) { %><span class="home-cl-vtag-major"><%= vtMajor %></span><% } %>
                <% if (vtMinorChars.length) { %><span class="home-cl-vtag-sep"></span><% vtMinorChars.forEach(function(d){ %><span class="home-cl-vtag-digit"><%= d %></span><% }); %><% } %>
              </div>
              <% } %>
              <div class="home-cl-content">
                <div class="home-cl-card-top">
                  <% if (imp > 0) { %><span class="home-cl-imp-pill home-cl-imp-pill--<%= impKey %>"><%= imp===2?'Critique':'Majeur' %></span><% } %>
                  <time class="home-cl-card-date" datetime="<%= cl.published_at.slice(0,10) %>"><%= new Date(cl.published_at).toLocaleDateString('fr-FR', { month: 'short', day: 'numeric' }) %></time>
                </div>
                <% if (displayTitle) { %><span class="home-cl-card-title"><%= displayTitle %></span><% } %>
                <% if (!displayTitle && versionTag) { %><span class="home-cl-card-title"><%= versionTag %></span><% } %>
                <% if (excerpt) { %><span class="home-cl-card-excerpt"><%= excerpt %></span><% } %>
                <% if (clTags.length) { %>
                <div class="home-cl-card-tags">
                  <% clTags.forEach(function(t){ var m=CL_TAG_META[t]; if(m){ %><span class="home-cl-tag <%= m.cls %>"><%= m.label %></span><% } }); %>
                </div>
                <% } %>
              </div>
            </button>

            <dialog class="home-cl-dialog" id="cl-dialog-<%= cl.id %>">
              <div class="home-cl-dialog-inner">
                <div class="home-cl-dialog-head">
                  <div class="home-cl-dialog-meta">
                    <% if (imp > 0) { %><span class="home-cl-imp-pill home-cl-imp-pill--<%= impKey %>"><%= imp===2?'Critique':'Majeur' %></span><% } %>
                    <% if (versionTag) { %><span class="home-cl-badge"><%= versionTag %></span><% } %>
                    <time class="home-cl-card-date" datetime="<%= cl.published_at.slice(0,10) %>"><%= new Date(cl.published_at).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
                  </div>
                  <button class="home-cl-close" aria-label="Fermer">&#x2715;</button>
                </div>
                <h3 class="home-cl-dialog-title"><%= cl.title %></h3>
                <% if (clTags.length) { %>
                <div class="home-cl-dialog-tags">
                  <% clTags.forEach(function(t){ var m=CL_TAG_META[t]; if(m){ %><span class="home-cl-tag <%= m.cls %>"><%= m.label %></span><% } }); %>
                </div>
                <% } %>
                <% if (cl.body) { %><div class="home-cl-dialog-body"><%- cl.body.replace(/\n/g,'<br>') %></div><% } %>
              </div>
            </dialog>
          <% }); %>
        </div>
      </section>

      <script nonce="<%= nonce %>">
      (function(){
        document.querySelectorAll('.home-cl-card').forEach(function(btn){
          btn.addEventListener('click',function(){
            var dlg=document.getElementById('cl-dialog-'+btn.dataset.clId);
            if(dlg) dlg.showModal();
          });
        });
        document.querySelectorAll('.home-cl-dialog').forEach(function(dlg){
          dlg.querySelector('.home-cl-close').addEventListener('click',function(){dlg.close();});
          dlg.addEventListener('click',function(e){if(e.target===dlg)dlg.close();});
        });
      })();
      </script>
      <% } %>

