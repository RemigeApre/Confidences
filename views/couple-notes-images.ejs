<%- include('partials/head', { title: 'Couple : Images de ' + partner.displayName }) %>
<main class="container wide gallery-has-sidebar profil-page">
  <%- include('partials/top-nav', { config: config, navTitle: 'Images de ' + partner.displayName, navBack: '/couple' }) %>

  <%- include('partials/couple-nav', { partner: partner }) %>

  <div class="profil-subpage">

    <div class="profil-empty"<%= items.length ? ' hidden' : '' %>>
      <div class="profil-empty-icon">&#10024;</div>
      <p><%= partner.displayName %> n&rsquo;a encore rien not&eacute; dans la galerie.</p>
    </div>

    <div class="gallery-grid"<%= items.length ? '' : ' hidden' %>>
      <% items.forEach(function(item) { %>
        <% var ctype = item.contentType || (item.type === 'bd' ? 'bd' : 'image'); %>
        <div class="gallery-card">
          <% if (item.imagePaths && item.imagePaths[0]) { %>
            <a href="/galerie/<%= item.id %>/edit">
              <img src="<%= thumbUrl(item.imagePaths[0]) %>" alt="<%= item.title || '' %>" class="gallery-img" loading="lazy" />
            </a>
          <% } else if (item.filename) { %>
            <a href="/galerie/<%= item.id %>/edit">
              <img src="<%= thumbUrl(item.filename) %>" alt="<%= item.title || '' %>" class="gallery-img" loading="lazy" />
            </a>
          <% } %>

          <% if (ctype === 'bd' && item.title) { %>
            <div class="gallery-bd-title"><%= item.title %></div>
          <% } %>

          <div class="gallery-card-overlay">
            <span class="wiki-card-badges">
              <% if (item.flame) { %><span class="wiki-card-react-badge" title="J'adore">&#128293;</span><% } %>
              <% if (item.rating > 0) { %>
                <span class="wiki-card-react-badge" title="Note : <%= item.rating %>/5">
                  <% for (var si = 1; si <= item.rating; si++) { %>&#9733;<% } %>
                </span>
              <% } %>
            </span>
          </div>
        </div>
      <% }) %>
    </div>

  </div>

</main>
<%- include('partials/foot') %>
