<%- include('partials/head', { title: lockedCategory ? ('Codex : ' + lockedCategory.label) : 'Codex : Recherche' }) %>
<main class="container wide<%= lockedCategory ? ' wiki-locked' : '' %>"<% if (lockedCategory) { %> style="--ch-hue: <%= lockedCategory.hue %>"<% } %>>
  <%- include('partials/top-nav', { config: config, navTitle: lockedCategory ? lockedCategory.label : 'Codex', navBack: lockedCategory ? '/wiki' : '/' }) %>

  <% if (lockedCategory) { %>

    <%- include('partials/mobile-filter-toggle') %>

    <%# ─── SIDEBAR CATÉGORIE ────────────────────────────────────────────── %>
    <%# Sur desktop : panneau fixe à gauche, pleine hauteur, sans pousser  %>
    <%# la grille centrale. Sur mobile : tiroir rétracté depuis la gauche. %>
    <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
      <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer les filtres">&times;</button>

      <%# ─ En-tête : flèche retour + nom + nombre ─ %>
      <div class="wiki-chapter-hero">
        <div class="wiki-chapter-hero-top">
          <a href="/wiki" class="wiki-chapter-hero-back" title="Retour au sommaire" aria-label="Retour au sommaire">&larr;</a>
          <h1 class="wiki-chapter-hero-title"><%= lockedCategory.label %></h1>
          <span class="wiki-chapter-hero-count"><%= pages.length %></span>
        </div>
      </div>

      <%# ─ Corps scrollable : recherche + filtres ─ %>
      <div class="wiki-sidebar-body">

        <div class="wiki-search-wrap">
          <div class="wiki-search-bar">
            <input type="search" id="wiki-search-input" class="wiki-search-input"
                   placeholder="Recherche"
                   autocomplete="off" />
            <button type="button" id="wiki-search-clear" class="wiki-search-clear" hidden>&#215;</button>
          </div>
          <span id="wiki-result-count" class="wiki-result-count" hidden></span>
        </div>

        <details class="wiki-sidebar-filter-details">
        <summary class="wiki-sidebar-filter-summary">Filtres</summary>
        <div class="wiki-sidebar-filters">

          <div class="wiki-filter-section wiki-sort-cols-row">
            <select id="wiki-cols-select" class="wiki-sort-select wiki-cols-select">
              <option value="1">1 colonne</option>
              <option value="2">2 colonnes</option>
              <option value="3" selected>3 colonnes</option>
              <option value="4">4 colonnes</option>
              <option value="5">5 colonnes</option>
            </select>
            <select id="wiki-sort-select" class="wiki-sort-select">
              <option value="alpha-asc">Ordre alphab&eacute;tique</option>
              <option value="alpha-desc">Ordre alphab&eacute;tique inverse</option>
              <option value="date-desc">Plus r&eacute;cent</option>
              <option value="date-asc">Plus ancien</option>
              <option value="rating-desc">Mieux not&eacute;</option>
            </select>
          </div>

          <div class="wiki-filter-section wiki-filter-toggles">
            <button type="button" id="wiki-ultra-toggle" class="wiki-ultra-btn">Ultra</button>
            <button type="button" id="wiki-irrealiste-toggle" class="wiki-ultra-btn">Irr&eacute;aliste</button>
          </div>

          <%
            var availExtraCats = [];
            pages.forEach(function(p) {
              (p.extraCategories || []).forEach(function(ec) {
                if (ec !== lockedCategory.key && availExtraCats.indexOf(ec) === -1) {
                  availExtraCats.push(ec);
                }
              });
            });
            var availExtraCatObjs = availExtraCats.map(function(ec) {
              return categories.find(function(c) { return c.key === ec; });
            }).filter(Boolean);
          %>
          <% if (lockedCategory.key === 'objets' && objetsSubs && objetsSubs.length) { %>
            <div class="wiki-filter-section">
              <span class="wiki-filter-label">Sous-cat&eacute;gorie</span>
              <div class="wiki-sous-cat-filter" id="wiki-sous-cat-filter">
                <% objetsSubs.forEach(function(s) { %>
                  <button type="button" class="tag-chip wiki-sous-cat-chip" data-sous-cat="<%= s.key %>"><%= s.label %></button>
                <% }); %>
              </div>
            </div>
          <% } %>

          <% if (availExtraCatObjs.length) { %>
            <div class="wiki-filter-section">
              <span class="wiki-filter-label">Cat&eacute;gories li&eacute;es</span>
<div class="wiki-extra-cat-filter" id="wiki-extra-cat-filter">
                <% availExtraCatObjs.forEach(function(ec) { %>
                  <button type="button" class="tag-chip wiki-extra-cat-chip" data-cat="<%= ec.key %>" style="--ec-hue: <%= ec.hue %>"><%= ec.label %></button>
                <% }); %>
              </div>
            </div>
          <% } %>

          <details class="wiki-subpanel-details">
            <summary class="wiki-subpanel-summary">Notation</summary>
            <div class="wiki-filter-label-row">
              <span class="wiki-filter-label">Note minimale</span>
              <button type="button" class="wiki-adv-star-reset" id="wiki-adv-star-reset">&#10006;</button>
            </div>
            <div class="wiki-adv-stars" id="wiki-adv-stars">
              <% for (var si = 1; si <= 5; si++) { %>
                <button type="button" class="wiki-adv-star" data-value="<%= si %>">&#9734;</button>
              <% } %>
            </div>
            <%# "Possédé" retiré : doublon avec la bascule "Nos objets". %>
            <div class="wiki-prop-grid" id="wiki-prop-grid">
              <button type="button" class="wiki-prop-btn" data-prop="not-rated" data-state="0">Pas encore not&eacute;</button>
              <button type="button" class="wiki-prop-btn" data-prop="flame" data-state="0">J&apos;adore</button>
              <button type="button" class="wiki-prop-btn" data-prop="interested" data-state="0"><%= interestedLabel %></button>
            </div>
          </details>

          <% if (currentUser && currentUser.isAdmin) { %>
          <div class="wiki-filter-section">
            <span class="wiki-filter-label">Maturit&eacute;</span>
            <div class="wiki-maturity-filter" id="wiki-maturity-filter">
              <button type="button" class="wiki-maturity-filter-btn" data-level="0">0&nbsp;Brouillon</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="1">1&nbsp;&Eacute;crite</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="2">2</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="3">3</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="4">4</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="5">5&nbsp;&#9201;</button>
            </div>
          </div>
          <% } %>

          <% if (allTags.length) { %>
            <div class="wiki-filter-section">
              <input type="search" id="wiki-tag-search" class="wiki-tag-search-input" placeholder="Chercher un tag" autocomplete="off" />
              <div class="wiki-tag-cloud" id="wiki-tag-filter">
                <% allTags.forEach(function (tag) { %>
                  <button type="button" class="wiki-tag-chip" data-tag="<%= tag %>" data-state="0">
                    <span class="wtc-label"><%= tag %></span><% if (typeof tagCounts !== 'undefined' && tagCounts[tag]) { %><span class="wtc-count"><%= tagCounts[tag] %></span><% } %>
                  </button>
                <% }) %>
              </div>
              <div class="wiki-tag-footer">
                <button type="button" id="wiki-tag-expand-btn" class="wiki-tag-expand-btn" hidden>&#9660; Plus</button>
                <a href="/tags" class="wiki-tag-all-link" id="wiki-tag-all-link" hidden>Tous les tags</a>
              </div>
            </div>
          <% } %>

          <details class="wiki-subpanel-details">
            <summary class="wiki-subpanel-summary">Affichage des cartes</summary>
            <div class="wiki-display-opts" id="wiki-display-opts">
              <label class="wiki-display-opt-label">
                <input type="checkbox" id="wiki-opt-stat-femme" checked />
                <span>Indicateur statistique femmes</span>
              </label>
              <% if (currentUser && currentUser.isAdmin) { %>
              <label class="wiki-display-opt-label">
                <input type="checkbox" id="wiki-opt-maturity" checked />
                <span>Pastille de version</span>
              </label>
              <% } %>
            </div>
          </details>

          <% if (currentUser) { %>
            <%- include('partials/filter-profiles', { section: 'wiki', profiles: locals.wikiFilterProfiles || [] }) %>
          <% } %>

        </div><%# /wiki-sidebar-filters %>
        </details>

        <div class="wiki-filter-section wiki-filter-bottom-actions">
          <% if (currentUser) { %>
            <button type="button" id="wiki-save-filter-btn" class="wiki-filter-reset-btn filter-profile-save-btn" hidden>Enregistrer le filtre</button>
          <% } %>
          <button type="button" id="wiki-reset-filters" class="wiki-filter-reset-btn wiki-filter-reset-btn--danger">R&eacute;initialiser les filtres</button>
          <% if (currentUser) { %>
            <button type="button" id="wiki-explore-btn" class="wiki-filter-reset-btn wiki-explore-btn">Explorer l&rsquo;inconnu</button>
          <% } %>
        </div>

      </div><%# /wiki-sidebar-body %>
    </aside>

  <% } else { %>

    <%# ─── EN-TÊTE "TOUTES LES PAGES" ───────────────────────────────────── %>
    <div class="wiki-page-header">
      <a href="/wiki" class="link-button">&larr; Sommaire</a>
      <h1 class="section-title-h1">Toutes les pages</h1>
    </div>

    <%# ─── RECHERCHE : toujours visible ──────────────────────────────────── %>
    <div class="wiki-search-wrap">
      <div class="wiki-search-bar">
        <input type="search" id="wiki-search-input" class="wiki-search-input"
               placeholder="Recherche" autocomplete="off" />
        <button type="button" id="wiki-search-clear" class="wiki-search-clear" hidden>&#215;</button>
      </div>
      <span id="wiki-result-count" class="wiki-result-count" hidden></span>
    </div>

    <%# ─── FILTRES + TRI ─────────────────────────────────────────────────── %>
    <details class="wiki-filters-panel" id="wiki-filters-panel">
      <summary class="wiki-filters-summary">Filtres &amp; tri</summary>
      <div class="wiki-filters-body">
        <button type="button" id="wiki-adv-toggle" class="wiki-adv-toggle">Filtres avancés &#9662;</button>
        <div id="wiki-adv-panel" class="wiki-adv-panel" hidden>
          <div class="wiki-adv-row">
            <label class="wiki-adv-label">Note min.</label>
            <div class="wiki-adv-stars" id="wiki-adv-stars">
              <% for (var si = 1; si <= 5; si++) { %>
                <button type="button" class="wiki-adv-star" data-value="<%= si %>">&#9734;</button>
              <% } %>
              <button type="button" class="wiki-adv-star-reset" id="wiki-adv-star-reset">&#10006;</button>
            </div>
          </div>
          <div class="wiki-prop-grid" id="wiki-prop-grid">
            <button type="button" class="wiki-prop-btn" data-prop="not-rated" data-state="0">Pas encore not&eacute;</button>
            <button type="button" class="wiki-prop-btn" data-prop="flame" data-state="0">J&apos;adore</button>
            <button type="button" class="wiki-prop-btn" data-prop="interested" data-state="0"><%= interestedLabel %></button>
          </div>
        </div>

        <div class="wiki-controls">
          <div class="links-filter" id="wiki-category-filter">
            <% categories.forEach(function (c) { %>
              <button type="button" class="tag-chip" data-category="<%= c.key %>" data-label="<%= c.label %>"<% if (c.desc) { %> data-desc="<%= c.desc %>"<% } %>><%= c.label %></button>
            <% }) %>
            <% if (hasOwnedItems && currentUser && (currentUser.isAdmin || currentUser.canSeeOwned)) { %>
              <button type="button" class="tag-chip tag-chip-owned" data-category="__owned__" data-label="Nos objets">Nos objets</button>
            <% } %>
          </div>

          <% if (allTags.length) { %>
            <div class="wiki-tag-cloud" id="wiki-tag-filter">
              <% allTags.forEach(function (tag) { %>
                <button type="button" class="wiki-tag-chip" data-tag="<%= tag %>" data-state="0">
                  <span class="wtc-label"><%= tag %></span><% if (typeof tagCounts !== 'undefined' && tagCounts[tag]) { %><span class="wtc-count"><%= tagCounts[tag] %></span><% } %>
                </button>
              <% }) %>
            </div>
          <% } %>

          <div class="wiki-display-opts" id="wiki-display-opts">
            <label class="wiki-display-opt-label">
              <input type="checkbox" id="wiki-opt-stat-femme" checked />
              <span>Indicateur statistique femmes</span>
            </label>
            <% if (currentUser && currentUser.isAdmin) { %>
            <label class="wiki-display-opt-label">
              <input type="checkbox" id="wiki-opt-maturity" checked />
              <span>Pastille de version</span>
            </label>
            <% } %>
          </div>

          <div class="wiki-sort-row">
            <button type="button" id="wiki-ultra-toggle" class="wiki-ultra-btn">Ultra</button>
            <button type="button" id="wiki-irrealiste-toggle" class="wiki-ultra-btn">Irr&eacute;aliste</button>
            <select id="wiki-cols-select" class="wiki-sort-select wiki-cols-select">
              <option value="1">1 col</option>
              <option value="2">2 col</option>
              <option value="3" selected>3 col</option>
              <option value="4">4 col</option>
              <option value="5">5 col</option>
            </select>
            <select id="wiki-sort-select" class="wiki-sort-select">
              <option value="alpha-asc" selected>A &rarr; Z</option>
              <option value="alpha-desc">Z &rarr; A</option>
              <option value="date-desc">Plus r&eacute;cent</option>
              <option value="date-asc">Plus ancien</option>
              <option value="rating-desc">Mieux not&eacute;</option>
              <option value="category">Cat&eacute;gorie</option>
            </select>
          </div>
        </div>

      </div>
    </details>

  <% } %>

  <%# ─── GRILLE ────────────────────────────────────────────────────────── %>
  <div class="wiki-pagination" id="wiki-pagination-top" hidden></div>
  <div class="wiki-grid" id="wiki-list">
    <% if (!pages.length) { %>
      <p class="intro">Aucune page pour l&apos;instant.</p>
    <% } %>
    <% pages.forEach(function (page) { %>
      <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: !lockedCategory }) %>
    <% }) %>
  </div>
  <div class="wiki-pagination" id="wiki-pagination" hidden></div>
  <% if (currentUser && currentUser.isAdmin && lockedCategory) { %>
    <script id="wiki-existing-pages" type="application/json"><%- JSON.stringify(allPagesMin) %></script>

    <%
      var TODO_CAT_ORDER = ['position','lieux','partenaires','jeu_de_role','tenues','objets','pratique','fantasmes','autre'];
      var todoCategories = TODO_CAT_ORDER.map(function(k) {
        return categories.find(function(c){ return c.key === k; });
      }).filter(Boolean);
    %>
    <script id="wiki-todo-cats" type="application/json"><%- JSON.stringify(todoCategories.map(function(c){
      return { key: c.key, label: c.label, hue: c.hue };
    })) %></script>

    <button type="button" class="wiki-fab-list" id="wiki-fab-list-btn" title="Pages à créer">&#9776;</button>
    <a href="/wiki/ajouter?category=<%= lockedCategory.key %>" class="wiki-fab-add" title="Ajouter une page">+</a>

    <div class="wiki-todo-overlay" id="wiki-todo-overlay" hidden></div>
    <aside class="wiki-todo-drawer" id="wiki-todo-drawer" hidden aria-label="Pages à créer">
      <div class="wiki-todo-header">
        <span class="wiki-todo-title">Pages à créer</span>
        <button type="button" class="wiki-todo-close" id="wiki-todo-close" aria-label="Fermer">&#215;</button>
      </div>
      <div class="wiki-todo-body" id="wiki-todo-body"></div>
    </aside>
  <% } %>
</main>
<script>window.GALLERY_CAN_EDIT = <%= (currentUser && currentUser.isAdmin) ? 'true' : 'false' %>;</script>
<script src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/codex-offline') %>
<%- include('partials/foot') %>
