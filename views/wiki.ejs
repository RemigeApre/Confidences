<%- include('partials/head', { title: lockedCategory ? ('Codex : ' + lockedCategory.label) : 'Codex : Recherche' }) %>
<%
  var WK_CAT_EN = {
    partenaires: 'Partners', position: 'Position', fantasmes: 'Fantasies',
    pratique: 'Practice', objets: 'Objects', lieux: 'Places',
    classique: 'Classic', hardcore: 'Hardcore', bdsm: 'BDSM',
    jeux_role: 'Role-play', fantaisie: 'Fantasy'
  };
  var WK_OBJSUB_EN = {
    substance: 'Substance', gode: 'Dildo', bdsm: 'BDSM',
    fantaisie: 'Fantasy', tatouage: 'Tattoo', autre: 'Other'
  };
%>
<main class="container wide<%= lockedCategory ? ' wiki-locked' : '' %>"<% if (lockedCategory) { %> style="--ch-hue: <%= lockedCategory.hue %>"<% } %>>
  <%- include('partials/top-nav', { config: config, navTitle: lockedCategory ? lockedCategory.label : 'Codex', navTitleEn: lockedCategory ? (WK_CAT_EN[lockedCategory.key] || lockedCategory.label) : 'Codex', navBack: lockedCategory ? '/wiki' : '/' }) %>

  <% if (lockedCategory) { %>

    <%- include('partials/mobile-filter-toggle') %>

    <%# ─── SIDEBAR CATÉGORIE ────────────────────────────────────────────── %>
    <%# Sur desktop : panneau fixe à gauche, pleine hauteur, sans pousser  %>
    <%# la grille centrale. Sur mobile : tiroir rétracté depuis la gauche. %>
    <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
      <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer les filtres">&times;</button>

      <%# ─ En-tête : flèche retour + nom + nombre ─ %>
      <%- include('partials/sidebar-hero', {
            title:     lockedCategory.label,
            titleEn:   WK_CAT_EN[lockedCategory.key] || lockedCategory.label,
            backHref:  '/wiki',
            backLabel: 'Retour au sommaire',
            count:     pages.length
          }) %>

      <%# ─ Corps scrollable : recherche + filtres ─ %>
      <div class="wiki-sidebar-body">

        <%- include('partials/search-bar', { searchId: 'wiki-search-input', showCount: true }) %>

        <details class="wiki-sidebar-filter-details">
        <summary class="wiki-sidebar-filter-summary" data-fr="Filtres" data-en="Filters">Filtres</summary>
        <div class="wiki-sidebar-filters">

          <div class="wiki-filter-section wiki-sort-cols-row">
            <select id="wiki-cols-select" class="wiki-sort-select wiki-cols-select">
              <option value="1" data-fr="1 colonne" data-en="1 column">1 colonne</option>
              <option value="2" data-fr="2 colonnes" data-en="2 columns">2 colonnes</option>
              <option value="3" selected data-fr="3 colonnes" data-en="3 columns">3 colonnes</option>
              <option value="4" data-fr="4 colonnes" data-en="4 columns">4 colonnes</option>
              <option value="5" data-fr="5 colonnes" data-en="5 columns">5 colonnes</option>
            </select>
            <select id="wiki-sort-select" class="wiki-sort-select">
              <option value="alpha-asc" data-fr="Ordre alphabétique" data-en="Alphabetical">Ordre alphab&eacute;tique</option>
              <option value="alpha-desc" data-fr="Ordre alphabétique inverse" data-en="Reverse alphabetical">Ordre alphab&eacute;tique inverse</option>
              <option value="date-desc" data-fr="Plus récent" data-en="Most recent">Plus r&eacute;cent</option>
              <option value="date-asc" data-fr="Plus ancien" data-en="Oldest">Plus ancien</option>
              <option value="rating-desc" data-fr="Mieux noté" data-en="Top rated">Mieux not&eacute;</option>
            </select>
          </div>

          <div class="wiki-filter-section wiki-filter-toggles">
            <button type="button" id="wiki-ultra-toggle" class="wiki-ultra-btn" data-fr="Ultra" data-en="Ultra">Ultra</button>
            <button type="button" id="wiki-irrealiste-toggle" class="wiki-ultra-btn" data-fr="Irréaliste" data-en="Unrealistic">Irr&eacute;aliste</button>
          </div>

          <%
            var availExtraCats = [];
            pages.forEach(function(p) {
              (p.extraCategories || []).forEach(function(ec) {
                if (ec !== lockedCategory.key && availExtraCats.indexOf(ec) === -1) {
                  availExtraCats.push(ec);
                }
              });
            });
            var availExtraCatObjs = availExtraCats.map(function(ec) {
              return categories.find(function(c) { return c.key === ec; });
            }).filter(Boolean);
          %>
          <% if (lockedCategory.key === 'objets' && objetsSubs && objetsSubs.length) { %>
            <div class="wiki-filter-section">
              <span class="wiki-filter-label" data-fr="Sous-catégorie" data-en="Sub-category">Sous-cat&eacute;gorie</span>
              <div class="wiki-sous-cat-filter" id="wiki-sous-cat-filter">
                <% objetsSubs.forEach(function(s) { %>
                  <button type="button" class="tag-chip wiki-sous-cat-chip" data-sous-cat="<%= s.key %>" data-fr="<%= s.label %>" data-en="<%= WK_OBJSUB_EN[s.key] || s.label %>"><%= s.label %></button>
                <% }); %>
              </div>
            </div>
          <% } %>

          <% if (availExtraCatObjs.length) { %>
            <div class="wiki-filter-section">
              <span class="wiki-filter-label" data-fr="Catégories liées" data-en="Related categories">Cat&eacute;gories li&eacute;es</span>
<div class="wiki-extra-cat-filter" id="wiki-extra-cat-filter">
                <% availExtraCatObjs.forEach(function(ec) { %>
                  <button type="button" class="tag-chip wiki-extra-cat-chip" data-cat="<%= ec.key %>" style="--ec-hue: <%= ec.hue %>" data-fr="<%= ec.label %>" data-en="<%= WK_CAT_EN[ec.key] || ec.label %>"><%= ec.label %></button>
                <% }); %>
              </div>
            </div>
          <% } %>

          <%- include('partials/filters/filter-wiki-rating', { interestedLabel: interestedLabel }) %>

          <% if (currentUser && currentUser.isAdmin) { %>
          <div class="wiki-filter-section">
            <span class="wiki-filter-label" data-fr="Maturité" data-en="Maturity">Maturit&eacute;</span>
            <div class="wiki-maturity-filter" id="wiki-maturity-filter">
              <button type="button" class="wiki-maturity-filter-btn" data-level="0" data-fr="0 Brouillon" data-en="0 Draft">0&nbsp;Brouillon</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="1" data-fr="1 Écrite" data-en="1 Written">1&nbsp;&Eacute;crite</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="2">2</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="3">3</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="4">4</button>
              <button type="button" class="wiki-maturity-filter-btn" data-level="5">5&nbsp;&#9201;</button>
            </div>
          </div>
          <% } %>

          <%- include('partials/filters/filter-wiki-tags', { tags: allTags, counts: (typeof tagCounts !== 'undefined' ? tagCounts : null) }) %>

          <details class="wiki-subpanel-details">
            <summary class="wiki-subpanel-summary" data-fr="Affichage des cartes" data-en="Card display">Affichage des cartes</summary>
            <div class="wiki-display-opts" id="wiki-display-opts">
              <label class="wiki-display-opt-label">
                <input type="checkbox" id="wiki-opt-stat-femme" checked hidden />
                <span class="wiki-display-opt-track"></span>
                <span class="wiki-display-opt-text" data-fr="Stat femmes" data-en="Female stats">Stat femmes</span>
              </label>
              <% if (currentUser && currentUser.isAdmin) { %>
              <label class="wiki-display-opt-label">
                <input type="checkbox" id="wiki-opt-maturity" checked hidden />
                <span class="wiki-display-opt-track"></span>
                <span class="wiki-display-opt-text" data-fr="Version" data-en="Version">Version</span>
              </label>
              <% } %>
            </div>
          </details>

          <% if (currentUser) { %>
            <%- include('partials/filter-profiles', { section: 'wiki', profiles: locals.wikiFilterProfiles || [] }) %>
          <% } %>

        </div><%# /wiki-sidebar-filters %>
        </details>

        <div class="wiki-filter-section wiki-filter-bottom-actions">
          <% if (currentUser) { %>
            <button type="button" id="wiki-save-filter-btn" class="wiki-filter-reset-btn filter-profile-save-btn" hidden data-fr="Enregistrer le filtre" data-en="Save filter">Enregistrer le filtre</button>
          <% } %>
          <button type="button" id="wiki-reset-filters" class="wiki-filter-reset-btn wiki-filter-reset-btn--danger" data-fr="Réinitialiser les filtres" data-en="Reset filters">R&eacute;initialiser les filtres</button>
          <% if (currentUser) { %>
            <button type="button" id="wiki-explore-btn" class="wiki-filter-reset-btn wiki-explore-btn" data-fr="Explorer l'inconnu" data-en="Explore the unknown">Explorer l&rsquo;inconnu</button>
          <% } %>
        </div>

      </div><%# /wiki-sidebar-body %>
    </aside>

  <% } else { %>

    <%# ─── EN-TÊTE "TOUTES LES PAGES" ───────────────────────────────────── %>
    <div class="wiki-page-header">
      <a href="/wiki" class="link-button" data-fr="← Sommaire" data-en="← Index">&larr; Sommaire</a>
      <h1 class="section-title-h1" data-fr="Toutes les pages" data-en="All pages">Toutes les pages</h1>
    </div>

    <%# ─── RECHERCHE : toujours visible ──────────────────────────────────── %>
    <%- include('partials/search-bar', { searchId: 'wiki-search-input', showCount: true }) %>

    <%# ─── FILTRES + TRI ─────────────────────────────────────────────────── %>
    <details class="wiki-filters-panel" id="wiki-filters-panel">
      <summary class="wiki-filters-summary" data-fr="Filtres &amp; tri" data-en="Filters &amp; sort">Filtres &amp; tri</summary>
      <div class="wiki-filters-body">
        <button type="button" id="wiki-adv-toggle" class="wiki-adv-toggle" data-fr="Filtres avancés ▾" data-en="Advanced filters ▾">Filtres avancés &#9662;</button>
        <div id="wiki-adv-panel" class="wiki-adv-panel" hidden>
          <div class="wiki-adv-row">
            <label class="wiki-adv-label" data-fr="Note min." data-en="Min. rating">Note min.</label>
            <div class="wiki-adv-stars" id="wiki-adv-stars">
              <% for (var _ri = 1; _ri <= 5; _ri++) { %>
                <button type="button" class="wiki-adv-star" data-value="<%= _ri %>">&#9734;</button>
              <% } %>
              <button type="button" class="wiki-adv-star-reset" id="wiki-adv-star-reset">&#10006;</button>
            </div>
          </div>
          <div class="wiki-prop-grid" id="wiki-prop-grid">
            <button type="button" class="wiki-prop-btn" data-prop="not-rated" data-state="0" data-fr="Pas encore noté" data-en="Not yet rated">Pas encore not&eacute;</button>
            <button type="button" class="wiki-prop-btn" data-prop="flame"     data-state="0" data-fr="J'adore" data-en="Love it">J&apos;adore</button>
            <button type="button" class="wiki-prop-btn" data-prop="interested"data-state="0"><%= interestedLabel %></button>
          </div>
        </div>

        <div class="wiki-controls">
          <div class="links-filter" id="wiki-category-filter">
            <% categories.forEach(function (c) { %>
              <button type="button" class="tag-chip" data-category="<%= c.key %>" data-label="<%= c.label %>"<% if (c.desc) { %> data-desc="<%= c.desc %>"<% } %> data-fr="<%= c.label %>" data-en="<%= WK_CAT_EN[c.key] || c.label %>"><%= c.label %></button>
            <% }) %>
            <% if (hasOwnedItems && currentUser && (currentUser.isAdmin || currentUser.canSeeOwned)) { %>
              <button type="button" class="tag-chip tag-chip-owned" data-category="__owned__" data-label="Nos objets" data-fr="Nos objets" data-en="Our items">Nos objets</button>
            <% } %>
          </div>

          <% if (allTags.length) { %>
            <div class="wiki-tag-cloud" id="wiki-tag-filter">
              <% allTags.forEach(function (t) { %>
                <button type="button" class="wiki-tag-chip" data-tag="<%= t %>" data-state="0">
                  <span class="wtc-label"><%= t %></span><%
                  if (typeof tagCounts !== 'undefined' && tagCounts[t]) { %><span class="wtc-count"><%= tagCounts[t] %></span><% } %>
                </button>
              <% }) %>
            </div>
          <% } %>

          <div class="wiki-display-opts" id="wiki-display-opts">
            <label class="wiki-display-opt-label">
              <input type="checkbox" id="wiki-opt-stat-femme" checked hidden />
              <span class="wiki-display-opt-track"></span>
              <span class="wiki-display-opt-text" data-fr="Stat femmes" data-en="Female stats">Stat femmes</span>
            </label>
            <% if (currentUser && currentUser.isAdmin) { %>
            <label class="wiki-display-opt-label">
              <input type="checkbox" id="wiki-opt-maturity" checked hidden />
              <span class="wiki-display-opt-track"></span>
              <span class="wiki-display-opt-text" data-fr="Version" data-en="Version">Version</span>
            </label>
            <% } %>
          </div>

          <div class="wiki-sort-row">
            <button type="button" id="wiki-ultra-toggle" class="wiki-ultra-btn" data-fr="Ultra" data-en="Ultra">Ultra</button>
            <button type="button" id="wiki-irrealiste-toggle" class="wiki-ultra-btn" data-fr="Irréaliste" data-en="Unrealistic">Irr&eacute;aliste</button>
            <select id="wiki-cols-select" class="wiki-sort-select wiki-cols-select">
              <option value="1" data-fr="1 col" data-en="1 col">1 col</option>
              <option value="2" data-fr="2 col" data-en="2 col">2 col</option>
              <option value="3" selected data-fr="3 col" data-en="3 col">3 col</option>
              <option value="4" data-fr="4 col" data-en="4 col">4 col</option>
              <option value="5" data-fr="5 col" data-en="5 col">5 col</option>
            </select>
            <select id="wiki-sort-select" class="wiki-sort-select">
              <option value="alpha-asc" selected data-fr="A → Z" data-en="A → Z">A &rarr; Z</option>
              <option value="alpha-desc" data-fr="Z → A" data-en="Z → A">Z &rarr; A</option>
              <option value="date-desc" data-fr="Plus récent" data-en="Most recent">Plus r&eacute;cent</option>
              <option value="date-asc" data-fr="Plus ancien" data-en="Oldest">Plus ancien</option>
              <option value="rating-desc" data-fr="Mieux noté" data-en="Top rated">Mieux not&eacute;</option>
              <option value="category" data-fr="Catégorie" data-en="Category">Cat&eacute;gorie</option>
            </select>
          </div>
        </div>

      </div>
    </details>

  <% } %>

  <%# ─── GRILLE ────────────────────────────────────────────────────────── %>
  <div class="wiki-pagination" id="wiki-pagination-top" hidden></div>
  <div class="wiki-grid" id="wiki-list">
    <% if (!pages.length) { %>
      <p class="intro" data-fr="Aucune page pour l'instant." data-en="No pages yet.">Aucune page pour l&apos;instant.</p>
    <% } %>
    <% pages.forEach(function (page) { %>
      <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: !lockedCategory }) %>
    <% }) %>
  </div>
  <div class="wiki-pagination" id="wiki-pagination" hidden></div>
  <% if (currentUser && currentUser.isAdmin && lockedCategory) { %>
    <script id="wiki-existing-pages" type="application/json"><%- JSON.stringify(allPagesMin) %></script>

    <%
      var TODO_CAT_ORDER = ['position','lieux','partenaires','jeu_de_role','tenues','objets','pratique','fantasmes','autre'];
      var todoCategories = TODO_CAT_ORDER.map(function(k) {
        return categories.find(function(c){ return c.key === k; });
      }).filter(Boolean);
    %>
    <script id="wiki-todo-cats" type="application/json"><%- JSON.stringify(todoCategories.map(function(c){
      return { key: c.key, label: c.label, hue: c.hue };
    })) %></script>

    <button type="button" class="wiki-fab-list" id="wiki-fab-list-btn" title="Pages à créer">&#9776;</button>
    <a href="/wiki/ajouter?category=<%= lockedCategory.key %>" class="wiki-fab-add" title="Ajouter une page">+</a>

    <div class="wiki-todo-overlay" id="wiki-todo-overlay" hidden></div>
    <aside class="wiki-todo-drawer" id="wiki-todo-drawer" hidden aria-label="Pages à créer">
      <div class="wiki-todo-header">
        <span class="wiki-todo-title">Pages à créer</span>
        <button type="button" class="wiki-todo-close" id="wiki-todo-close" aria-label="Fermer">&#215;</button>
      </div>
      <div class="wiki-todo-body" id="wiki-todo-body"></div>
    </aside>
  <% } %>
</main>
<script nonce="<%= nonce %>">window.GALLERY_CAN_EDIT = <%= (currentUser && currentUser.isAdmin) ? 'true' : 'false' %>;</script>
<script nonce="<%= nonce %>" src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/codex-offline') %>
<%- include('partials/foot') %>
