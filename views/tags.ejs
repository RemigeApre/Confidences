<%- include('partials/head', { title: 'Tous les tags' }) %>
<%
  // Catégories avec leurs sous-catégories intégrées (depuis la DB)
  var CAT_LABELS        = {};
  var CAT_ORDER         = [];
  var CAT_WITH_SUB      = {};
  var SUBCATS_BY_CAT    = {}; // {catKey: [{key, label}]}
  (dynamicCategoriesWithSubs || []).forEach(function(c) {
    CAT_LABELS[c.key]     = c.label;
    CAT_ORDER.push(c.key);
    if (c.has_subcats)   CAT_WITH_SUB[c.key] = true;
    SUBCATS_BY_CAT[c.key] = c.subcategories || [];
  });
  if (!CAT_ORDER.length) {
    CAT_LABELS   = { femme: 'Femme', homme: 'Homme', rapport: 'Rapport', lieu: 'Lieu', relation: 'Relation', objet: 'Objet', autre: 'Autre' };
    CAT_ORDER    = ['femme', 'homme', 'rapport', 'lieu', 'relation', 'objet', 'autre'];
    CAT_WITH_SUB = { femme: true, homme: true };
    SUBCATS_BY_CAT = { femme: [{key:'physique',label:'Physique'},{key:'ethnie',label:'Ethnie'},{key:'fantastique',label:'Fantastique et impossible'},{key:'vetements',label:'Vêtements'}], homme: [{key:'physique',label:'Physique'},{key:'ethnie',label:'Ethnie'},{key:'fantastique',label:'Fantastique et impossible'},{key:'vetements',label:'Vêtements'}] };
  }
  var CAT_MAX = 20;
  var tagsByCat = {};
  CAT_ORDER.forEach(function(c) { tagsByCat[c] = []; });
  tags.forEach(function(item) {
    var c = item.category || 'autre';
    if (!tagsByCat[c]) { tagsByCat['autre'] = tagsByCat['autre'] || []; tagsByCat['autre'].push(item); }
    else tagsByCat[c].push(item);
  });
%>
<main class="container wide wiki-locked tags-page-locked" style="--ch-hue: 270">
  <%- include('partials/top-nav', { config: config }) %>

  <%- include('partials/mobile-filter-toggle') %>

  <%# ─── SIDEBAR ─────────────────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar tags-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer les filtres">&times;</button>
    <div class="wiki-chapter-hero">
      <div class="wiki-chapter-hero-top">
        <a href="#" class="wiki-chapter-hero-back" id="tags-back-btn" title="Page précédente">&larr;</a>
        <h1 class="wiki-chapter-hero-title">Tags</h1>
        <span class="wiki-chapter-hero-count" id="tags-count-display"><%= tags.length %></span>
      </div>
    </div>

    <div class="wiki-sidebar-body">
      <div class="wiki-search-wrap">
        <div class="wiki-search-bar">
          <input type="search" id="tags-search-input" class="wiki-search-input"
                 placeholder="Recherche" autocomplete="off" />
        </div>
      </div>

      <div class="wiki-sidebar-filters">
        <%# ─ Filtre par catégorie ─ %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label">Catégorie</span>
          <select class="wiki-sort-select" id="tags-cat-filter" style="width:100%">
            <option value="">Toutes</option>
            <% CAT_ORDER.forEach(function(cat) { %>
            <option value="<%= cat %>"><%= CAT_LABELS[cat] %></option>
            <% }) %>
          </select>
        </div>

        <%# ─ Filtre sous-catégorie (femme / homme uniquement, affiché via JS) ─ %>
        <div class="wiki-filter-section" id="tags-subcat-filter-section" hidden>
          <span class="wiki-filter-label" id="tags-subcat-filter-label"></span>
          <div class="links-filter tags-cat-filter-wrap" id="tags-subcat-filter">
            <button type="button" class="tag-chip active" data-subcat-filter="">Toutes</button>
            <button type="button" class="tag-chip" data-subcat-filter="physique">Physique</button>
            <button type="button" class="tag-chip" data-subcat-filter="ethnie">Ethnie</button>
            <button type="button" class="tag-chip" data-subcat-filter="fantastique">Fantastique et impossible</button>
            <button type="button" class="tag-chip" data-subcat-filter="vetements">V&ecirc;tements</button>
          </div>
        </div>

        <%# ─ Filtre déclinaisons ─ %>
        <div class="wiki-filter-section">
          <label class="tags-variant-toggle">
            <input type="checkbox" id="tags-hide-variants" />
            <span>Masquer les d&eacute;clinaisons</span>
          </label>
        </div>

        <%# ─ Filtre par type ─ %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label">Type</span>
          <div class="links-filter" id="tags-type-filter">
            <button type="button" class="tag-chip active" data-type-filter="" data-state="0">Tous</button>
            <button type="button" class="tag-chip" data-type-filter="normal" data-state="0">Normal</button>
            <button type="button" class="tag-chip tags-type-ultra" data-type-filter="ultra" data-state="0">Ultra</button>
            <button type="button" class="tag-chip tags-type-irrealiste" data-type-filter="irrealiste" data-state="0">Irr&eacute;aliste</button>
          </div>
        </div>

        <% if (currentUser) { %>
        <div class="wiki-filter-section">
          <a href="/tags/masques" class="tags-masked-link" id="tags-masked-link">Tags masqu&eacute;s<span id="tags-masked-count"><% if (locals.tagBlacklist && tagBlacklist.length) { %> (<%= tagBlacklist.length %>)<% } %></span></a>
        </div>
        <% } %>

        <% if (currentUser && currentUser.isAdmin) { %>
        <%# ─ Admin : mode sélection multiple ─ %>
        <div class="wiki-filter-section">
          <button type="button" class="tags-select-mode-btn" id="tags-select-mode-btn">Sélectionner</button>
        </div>
        <%# ─ Admin : ajouter des tags par catégorie ─ %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label">Ajouter des tags</span>
          <form id="tags-create-form" class="tags-create-form">
            <select id="tags-create-category" class="wiki-sort-select tags-create-select">
              <% CAT_ORDER.forEach(function(cat) { %>
              <option value="<%= cat %>"><%= CAT_LABELS[cat] %></option>
              <% }) %>
            </select>
            <select id="tags-create-type" class="wiki-sort-select tags-create-select">
              <option value="normal">Normal</option>
              <option value="ultra">Ultra</option>
              <option value="irrealiste">Irr&eacute;aliste</option>
            </select>
            <textarea id="tags-create-input" class="wiki-search-input tags-create-textarea"
                      placeholder="Un tag par ligne&#10;ou séparés par des virgules&hellip;" rows="3"></textarea>
            <button type="submit" class="tags-create-btn">+ Créer</button>
          </form>
          <p class="tags-create-feedback" id="tags-create-feedback" hidden></p>
        </div>
        <div class="wiki-filter-section">
          <button type="button" class="tags-manage-cats-btn" id="tags-manage-cats-btn">&#9881; Gestion catégories</button>
        </div>
        <% } %>
      </div>
    </div>
  </aside>

  <%# ─── GRILLE DES TAGS ─────────────────────────────────────────────────── %>
  <div class="tags-grid" id="tags-grid">

    <%# ── Vue groupée par catégorie (masquée quand un filtre est actif) ── %>
    <div id="tags-grouped-view">
      <% CAT_ORDER.forEach(function(cat) { %>
      <% var catItems = tagsByCat[cat] || []; %>
      <% if (catItems.length > 0) { %>
      <div class="tags-cat-group" data-category="<%= cat %>">
        <div class="tags-cat-header">
          <span class="tags-cat-label"><%= CAT_LABELS[cat] %></span>
          <% if (!CAT_WITH_SUB[cat] && catItems.length > CAT_MAX) { %>
          <button type="button" class="tags-cat-more-btn" data-cat="<%= cat %>">
            +<%= catItems.length - CAT_MAX %> &rarr;
          </button>
          <% } %>
        </div>
        <% if (CAT_WITH_SUB[cat]) { %>
        <%# ── Vue sous-catégorisée ── %>
        <%
          var catSubcats     = SUBCATS_BY_CAT[cat] || [];
          var catSubOrder    = catSubcats.map(function(s){ return s.key; });
          var catSubLabels   = { '': 'Sans sous-catégorie' };
          catSubcats.forEach(function(s){ catSubLabels[s.key] = s.label; });
          catSubOrder.push('');
          var tagsBySubcat = { '': [] };
          catSubcats.forEach(function(s){ tagsBySubcat[s.key] = []; });
          catItems.forEach(function(item){
            var s = item.subcategory || '';
            if (s === 'autre') s = '';
            if (!tagsBySubcat.hasOwnProperty(s)) s = '';
            tagsBySubcat[s].push(item);
          });
        %>
        <% catSubOrder.forEach(function(subcat) { %>
        <%   var subcatItems = tagsBySubcat[subcat] || []; %>
        <%   if (subcatItems.length === 0) { return; } %>
        <div class="tags-subcat-group" data-subcat="<%= subcat %>">
          <span class="tags-subcat-label"><%= catSubLabels[subcat] || subcat %></span>
          <div class="tags-cat-body">
            <% subcatItems.forEach(function(item) { %>
            <% var wikiId = wikiPageByTitle[item.tag.toLowerCase()] || null; %>
            <div class="tags-item tags-item--<%= item.type %><%= wikiId ? ' tags-item--wiki-page' : '' %><%= item.parent ? ' tags-item--variant' : '' %>"
                 data-tag="<%= item.tag %>"
                 data-type="<%= item.type %>"
                 data-category="<%= item.category || 'autre' %>"
                 data-subcategory="<%= item.subcategory || '' %>"
                 data-parent="<%= item.parent || '' %>"
                 data-wiki-id="<%= wikiId || '' %>"
                 data-breakdown='<%= JSON.stringify(item.breakdown).replace(/'/g, "&#39;") %>'
                 style="--tag-pct: <%= item.pct.toFixed(3) %>">
              <span class="tags-item-name"><%= item.tag %></span>
              <span class="tags-item-right">
                <span class="tags-item-count"><%= item.count %></span>
                <% if (wikiId) { %><a href="/wiki/<%= wikiId %>" class="tags-item-wiki-link" title="Voir la page codex" aria-label="Voir la page codex">&#8599;</a><% } %>
              </span>
            </div>
            <% }) %>
          </div>
        </div>
        <% }) %>
        <% } else { %>
        <%# ── Vue plate (autres catégories) ── %>
        <div class="tags-cat-body">
          <% catItems.forEach(function(item, idx) { %>
          <% var wikiId = wikiPageByTitle[item.tag.toLowerCase()] || null; %>
          <div class="tags-item tags-item--<%= item.type %><%= wikiId ? ' tags-item--wiki-page' : '' %><%= item.parent ? ' tags-item--variant' : '' %>"
               data-tag="<%= item.tag %>"
               data-type="<%= item.type %>"
               data-category="<%= item.category || 'autre' %>"
               data-subcategory=""
               data-parent="<%= item.parent || '' %>"
               data-wiki-id="<%= wikiId || '' %>"
               data-breakdown='<%= JSON.stringify(item.breakdown).replace(/'/g, "&#39;") %>'
               <% if (idx >= CAT_MAX) { %>data-cat-overflow="1"<% } %>
               style="--tag-pct: <%= item.pct.toFixed(3) %>">
            <span class="tags-item-name"><%= item.tag %></span>
            <span class="tags-item-right">
              <span class="tags-item-count"><%= item.count %></span>
              <% if (wikiId) { %><a href="/wiki/<%= wikiId %>" class="tags-item-wiki-link" title="Voir la page codex" aria-label="Voir la page codex">&#8599;</a><% } %>
            </span>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
      <% } %>
      <% }) %>
    </div>

    <%# ── Vue filtrée (liste plate, visible quand un filtre est actif) ── %>
    <div id="tags-filtered-view" hidden>
      <% tags.forEach(function(item) { %>
      <% var wikiId = wikiPageByTitle[item.tag.toLowerCase()] || null; %>
      <div class="tags-item tags-item--<%= item.type %><%= wikiId ? ' tags-item--wiki-page' : '' %><%= item.parent ? ' tags-item--variant' : '' %>"
           data-tag="<%= item.tag %>"
           data-type="<%= item.type %>"
           data-category="<%= item.category || 'autre' %>"
           data-subcategory="<%= item.subcategory || '' %>"
           data-parent="<%= item.parent || '' %>"
           data-wiki-id="<%= wikiId || '' %>"
           data-breakdown='<%= JSON.stringify(item.breakdown).replace(/'/g, "&#39;") %>'
           style="--tag-pct: <%= item.pct.toFixed(3) %>">
        <span class="tags-item-name"><%= item.tag %></span>
        <span class="tags-item-right">
          <span class="tags-item-count"><%= item.count %></span>
          <% if (wikiId) { %>
            <a href="/wiki/<%= wikiId %>" class="tags-item-wiki-link" title="Voir la page codex" aria-label="Voir la page codex">&#8599;</a>
          <% } %>
        </span>
      </div>
      <% }) %>
    </div>

    <p class="tags-empty" id="tags-empty" hidden>Aucun tag trouv&eacute;.</p>

    <% if (currentUser && currentUser.isAdmin) { %>
    <div class="tags-bulk-bar" id="tags-bulk-bar" hidden>
      <span class="tags-bulk-count" id="tags-bulk-count">0 sélectionné(s)</span>
      <select class="tags-bulk-select" id="tags-bulk-cat-select">
        <% CAT_ORDER.forEach(function(cat) { %>
        <option value="<%= cat %>"><%= CAT_LABELS[cat] %></option>
        <% }) %>
      </select>
      <%# Options générées en JS selon la catégorie sélectionnée — voir updateSubcatVisibility %>
      <select class="tags-bulk-select" id="tags-bulk-subcat-select" hidden>
        <option value="">Sans sous-catégorie</option>
      </select>
      <button type="button" class="tags-bulk-apply-btn" id="tags-bulk-apply-btn" disabled>Assigner</button>
      <button type="button" class="tags-bulk-cancel-btn" id="tags-bulk-cancel-btn">Annuler</button>
    </div>
    <% } %>
  </div>

  <%# Popup de resultats/admin : voir partials/tag-popup.ejs %>
  <%# ─── Tooltip hover ── %>
  <div class="tags-tooltip" id="tags-tooltip" hidden></div>

  <%# ─── Modal gestion catégories (admin) ─── %>
  <% if (currentUser && currentUser.isAdmin) { %>
  <div class="tags-mgmt-overlay" id="tags-mgmt-overlay" hidden>
    <div class="tags-mgmt-panel">
      <div class="tags-mgmt-header">
        <span class="tags-mgmt-title">Gestion des catégories</span>
        <button type="button" class="tags-mgmt-close" id="tags-mgmt-close">&#10005;</button>
      </div>
      <div class="tags-mgmt-body">
        <ul class="tags-mgmt-list" id="tags-mgmt-cat-list">
          <% (dynamicCategoriesWithSubs || []).forEach(function(c) { %>
          <li class="tags-mgmt-cat-row" data-key="<%= c.key %>" data-has-subcats="<%= c.has_subcats %>">

            <%# Ligne catégorie %>
            <div class="tags-mgmt-row tags-mgmt-row--cat">
              <span class="tags-mgmt-row-label" title="clé&nbsp;: <%= c.key %>"><%= c.label %></span>
              <% if (c.has_subcats) { %>
                <button type="button" class="tags-mgmt-expand-btn" title="Sous-catégories">&#9660;</button>
              <% } %>
              <div class="tags-mgmt-row-actions">
                <button type="button" class="tags-mgmt-edit-btn" title="Renommer">&#9998;</button>
                <button type="button" class="tags-mgmt-toggle-sub-btn" title="<%= c.has_subcats ? 'Désactiver' : 'Activer' %> les sous-catégories">
                  <span class="tags-mgmt-sub-badge<%= c.has_subcats ? ' on' : '' %>">sous-cat</span>
                </button>
                <button type="button" class="tags-mgmt-del-btn" title="Supprimer">&#128465;</button>
              </div>
            </div>

            <%# Zone sous-catégories (inline) %>
            <% if (c.has_subcats) { %>
            <div class="tags-mgmt-subs" data-cat="<%= c.key %>">
              <ul class="tags-mgmt-sub-list">
                <% (c.subcategories || []).forEach(function(s) { %>
                <li class="tags-mgmt-row tags-mgmt-row--sub" data-key="<%= s.key %>" data-cat="<%= c.key %>">
                  <span class="tags-mgmt-row-label" title="clé&nbsp;: <%= s.key %>"><%= s.label %></span>
                  <div class="tags-mgmt-row-actions">
                    <button type="button" class="tags-mgmt-edit-btn" title="Renommer">&#9998;</button>
                    <button type="button" class="tags-mgmt-del-btn" title="Supprimer">&#128465;</button>
                  </div>
                </li>
                <% }) %>
              </ul>
              <form class="tags-mgmt-add-row" data-cat="<%= c.key %>">
                <input type="text" class="tags-mgmt-input" placeholder="Nouvelle sous-catégorie&hellip;" autocomplete="off">
                <button type="submit" class="tags-mgmt-add-btn">+ Ajouter</button>
              </form>
            </div>
            <% } %>

          </li>
          <% }) %>
        </ul>

        <form class="tags-mgmt-add-row tags-mgmt-add-row--cat" id="tags-mgmt-cat-add">
          <input type="text" class="tags-mgmt-input" id="tags-mgmt-cat-label" placeholder="Nouvelle catégorie&hellip;" autocomplete="off">
          <label class="tags-mgmt-checkbox-label"><input type="checkbox" id="tags-mgmt-cat-hassub"> Sous-catégories</label>
          <button type="submit" class="tags-mgmt-add-btn">+ Ajouter</button>
        </form>
      </div>
      <div class="tags-mgmt-feedback" id="tags-mgmt-feedback" hidden></div>
    </div>
  </div>
  <% } %>
</main>

<script nonce="<%= nonce %>">
(function () {
  var isAdmin = <%= currentUser && currentUser.isAdmin ? 'true' : 'false' %>;
  var TOTAL   = <%= tags.length %>;

  /* ── Retour page précédente ── */
  var backBtn = document.getElementById("tags-back-btn");
  if (backBtn) {
    backBtn.addEventListener("click", function (e) {
      e.preventDefault();
      if (history.length > 1 && document.referrer) history.back();
      else window.location.href = "/wiki";
    });
  }

  /* ── Références DOM ── */
  var grid          = document.getElementById("tags-grid");
  var groupedView   = document.getElementById("tags-grouped-view");
  var filteredView  = document.getElementById("tags-filtered-view");
  var emptyMsg      = document.getElementById("tags-empty");
  var countDisplay  = document.getElementById("tags-count-display");
  var searchInput   = document.getElementById("tags-search-input");

  /* ── État des filtres ── */
  var typeStates   = {};   // type → 0 neutre / 1 inclus / 2 exclu
  var activeCat    = "";   // catégorie active (vide = toutes)
  var activeSubcat = "";   // sous-catégorie active (femme/homme uniquement)
  var hideVariants = false;

  var CATS_WITH_SUBCAT = <%- JSON.stringify(CAT_WITH_SUB) %>;
  var CAT_LABELS_JS    = <%- JSON.stringify(CAT_LABELS) %>;
  var subcatSection    = document.getElementById("tags-subcat-filter-section");
  var subcatLabel      = document.getElementById("tags-subcat-filter-label");
  var subcatFilter     = document.getElementById("tags-subcat-filter");

  function syncSubcatPanel() {
    var show = CATS_WITH_SUBCAT[activeCat];
    if (subcatSection) subcatSection.hidden = !show;
    if (show && subcatLabel) subcatLabel.textContent = CAT_LABELS_JS[activeCat] + ' — sous-catégorie';
    if (!show) { activeSubcat = ""; if (subcatFilter) subcatFilter.querySelectorAll(".tag-chip").forEach(function(b){ b.classList.toggle("active", (b.dataset.subcatFilter || "") === ""); }); }
  }

  function applyFilters() {
    var q = searchInput ? searchInput.value.trim().toLowerCase() : "";
    var includedTypes = [], excludedTypes = [];
    Object.keys(typeStates).forEach(function (t) {
      if (typeStates[t] === 1) includedTypes.push(t);
      else if (typeStates[t] === 2) excludedTypes.push(t);
    });
    var hasSearch   = !!q;
    var hasType     = includedTypes.length > 0 || excludedTypes.length > 0;

    if (!hasSearch && !hasType && !hideVariants) {
      // ── Mode groupé : cat/subcat filtrés directement sur les groupes ──
      groupedView.hidden = false;
      filteredView.hidden = true;
      if (emptyMsg) emptyMsg.hidden = true;

      var visibleCount = 0;
      groupedView.querySelectorAll(".tags-cat-group").forEach(function (group) {
        var matchCat = !activeCat || group.dataset.category === activeCat;
        group.hidden = !matchCat;
        if (matchCat) {
          // Filtrer les sous-groupes si présents
          var subcatGroups = group.querySelectorAll(".tags-subcat-group");
          subcatGroups.forEach(function (sg) {
            // sg.dataset.subcat = '' signifie "sans catégorie"
            var matchSub = !activeSubcat || (sg.dataset.subcat || "") === activeSubcat;
            sg.hidden = !matchSub;
          });
          // Compter les items dans les groupes visibles
          group.querySelectorAll(".tags-item").forEach(function (item) {
            // Pour les items hors sous-groupe (catégories plates)
            // vérifier subcat si filtre subcat actif
            var parentSg = item.closest(".tags-subcat-group");
            if (parentSg && parentSg.hidden) return;
            visibleCount++;
          });
        }
      });

      if (countDisplay) countDisplay.textContent = (activeCat || activeSubcat) ? visibleCount : TOTAL;
      return;
    }

    // ── Mode filtré : liste plate (recherche / type / hideVariants) ──
    groupedView.hidden = true;
    filteredView.hidden = false;

    // Réafficher tous les items du grouped view (pour les prochains appels)
    groupedView.querySelectorAll(".tags-cat-group").forEach(function(g){ g.hidden = false; });
    groupedView.querySelectorAll(".tags-subcat-group").forEach(function(g){ g.hidden = false; });

    var visible = 0;
    filteredView.querySelectorAll(".tags-item").forEach(function (item) {
      var matchQ    = !q || item.dataset.tag.toLowerCase().indexOf(q) !== -1;
      var t         = item.dataset.type || "normal";
      var matchType = (includedTypes.length === 0 || includedTypes.indexOf(t) !== -1)
                    && excludedTypes.indexOf(t) === -1;
      var itemSubcat = item.dataset.subcategory || "";
      if (itemSubcat === "autre") itemSubcat = "";
      var matchCat    = !activeCat || item.dataset.category === activeCat;
      var matchSubcat = !activeSubcat || itemSubcat === activeSubcat;
      var matchVariant = !hideVariants || !item.dataset.parent;
      var show = matchQ && matchType && matchCat && matchSubcat && matchVariant;
      item.hidden = !show;
      if (show) visible++;
    });

    if (emptyMsg) emptyMsg.hidden = visible > 0;
    if (countDisplay) countDisplay.textContent = visible;
  }

  /* ── Blacklist ── */
  document.addEventListener("tag-blacklist-change", function () {
    var blacklist = window.TAG_BLACKLIST || [];
    [groupedView, filteredView].forEach(function (view) {
      if (!view) return;
      view.querySelectorAll(".tags-item").forEach(function (item) {
        if (blacklist.indexOf(item.dataset.tag) !== -1) item.remove();
      });
    });
    applyFilters();
    var maskedCount = document.getElementById("tags-masked-count");
    if (maskedCount) maskedCount.textContent = blacklist.length ? " (" + blacklist.length + ")" : "";
  });

  /* ── Recherche ── */
  var searchDebounceTimer = null;
  if (searchInput) searchInput.addEventListener("input", function () {
    clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(applyFilters, 120);
  });

  /* ── Filtre par catégorie : dropdown ── */
  var catFilter = document.getElementById("tags-cat-filter");
  if (catFilter) {
    catFilter.addEventListener("change", function () {
      activeCat = catFilter.value;
      syncSubcatPanel();
      applyFilters();
    });
  }

  /* ── Filtre sous-catégorie ── */
  if (subcatFilter) {
    subcatFilter.querySelectorAll(".tag-chip[data-subcat-filter]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var val = btn.dataset.subcatFilter || "";
        activeSubcat = (activeSubcat === val && val !== "") ? "" : val;
        subcatFilter.querySelectorAll(".tag-chip").forEach(function (b) {
          b.classList.toggle("active", (b.dataset.subcatFilter || "") === activeSubcat);
        });
        applyFilters();
      });
    });
  }

  /* ── Filtre par type : 3 états ── */
  var typeFilter = document.getElementById("tags-type-filter");
  if (typeFilter) {
    var STATE_CLASSES = ["", "active", "tags-type-excluded"];
    function resetTypeChips() {
      typeStates = {};
      typeFilter.querySelectorAll(".tag-chip[data-type-filter]").forEach(function (b) {
        b.dataset.state = "0";
        STATE_CLASSES.forEach(function (c) { if (c) b.classList.remove(c); });
      });
      var allChip = typeFilter.querySelector('[data-type-filter=""]');
      if (allChip) allChip.classList.add("active");
    }
    typeFilter.querySelectorAll(".tag-chip[data-type-filter]").forEach(function (btn) {
      var typeVal = btn.dataset.typeFilter;
      if (!typeVal) {
        btn.addEventListener("click", function () { resetTypeChips(); applyFilters(); });
        return;
      }
      btn.addEventListener("click", function () {
        var s = Number(btn.dataset.state || 0);
        s = (s + 1) % 3;
        btn.dataset.state = String(s);
        STATE_CLASSES.forEach(function (c) { if (c) btn.classList.remove(c); });
        if (s > 0) btn.classList.add(STATE_CLASSES[s]);
        typeStates[typeVal] = s;
        var allChip = typeFilter.querySelector('[data-type-filter=""]');
        var anyActive = Object.values(typeStates).some(function (v) { return v > 0; });
        if (allChip) allChip.classList.toggle("active", !anyActive);
        applyFilters();
      });
    });
  }

  /* ── Filtre : masquer les déclinaisons ── */
  var hideVariantsChk = document.getElementById("tags-hide-variants");
  if (hideVariantsChk) {
    hideVariantsChk.addEventListener("change", function () {
      hideVariants = hideVariantsChk.checked;
      applyFilters();
    });
  }

  /* ── Boutons "voir plus" des groupes ── */
  if (groupedView) {
    groupedView.querySelectorAll(".tags-cat-more-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var cat = btn.dataset.cat;
        // Activer le filtre catégorie correspondant
        activeCat = cat;
        if (catFilter) {
          catFilter.querySelectorAll(".tag-chip").forEach(function (b) {
            b.classList.toggle("active", (b.dataset.catFilter || "") === cat);
          });
        }
        applyFilters();
      });
    });
  }

  /* ── Tooltip répartition ── */
  var tooltip = document.getElementById("tags-tooltip");
  function showTooltip(item, evt) {
    if (!tooltip) return;
    var bk = {};
    try { bk = JSON.parse(item.dataset.breakdown || "{}"); } catch (_) {}
    var entries = [];
    if (bk.wiki)    entries.push(["Codex",   bk.wiki]);
    if (bk.galerie) entries.push(["Galerie", bk.galerie]);
    if (bk.bd)      entries.push(["BD",      bk.bd]);
    if (!entries.length) return;
    while (tooltip.firstChild) tooltip.removeChild(tooltip.firstChild);
    entries.forEach(function (pair, i) {
      if (i > 0) tooltip.appendChild(document.createElement("br"));
      var span = document.createElement("span");
      span.textContent = pair[0] + "\u00a0: ";
      var strong = document.createElement("strong");
      strong.textContent = pair[1];
      tooltip.appendChild(span);
      tooltip.appendChild(strong);
    });
    tooltip.hidden = false;
    positionTooltip(evt);
  }
  function positionTooltip(evt) {
    if (!tooltip || tooltip.hidden) return;
    var x = evt.clientX + 12, y = evt.clientY + 12;
    var tw = tooltip.offsetWidth, th = tooltip.offsetHeight;
    if (x + tw > window.innerWidth  - 8) x = evt.clientX - tw - 12;
    if (y + th > window.innerHeight - 8) y = evt.clientY - th - 12;
    tooltip.style.left = x + "px";
    tooltip.style.top  = y + "px";
  }
  function hideTooltip() { if (tooltip) tooltip.hidden = true; }

  if (grid) {
    grid.addEventListener("mouseover", function (e) {
      var item = e.target.closest(".tags-item");
      if (item) showTooltip(item, e);
    });
    grid.addEventListener("mousemove", positionTooltip);
    grid.addEventListener("mouseout", function (e) {
      if (!e.relatedTarget || !e.relatedTarget.closest(".tags-item")) hideTooltip();
    });
  }

  /* ── Popup résultats/admin ── */
  if (grid) {
    grid.addEventListener("click", function (e) {
      if (e.target.closest(".tags-item-wiki-link")) return;
      if (e.target.closest(".tags-cat-more-btn"))   return;
      var item = e.target.closest(".tags-item");
      if (item && window.openTagPopup) { hideTooltip(); window.openTagPopup(item.dataset.tag); }
    });
  }

  /* ── Groupes : masquer les items overflow par défaut ── */
  if (groupedView) {
    groupedView.querySelectorAll(".tags-item[data-cat-overflow]").forEach(function (item) {
      item.hidden = true;
    });
  }

  /* ── Admin : créer des tags (batch) ── */
  var createForm     = document.getElementById("tags-create-form");
  var createInput    = document.getElementById("tags-create-input");
  var createCategory = document.getElementById("tags-create-category");
  var createType     = document.getElementById("tags-create-type");
  var createFeedback = document.getElementById("tags-create-feedback");

  if (isAdmin && createForm) {
    createForm.addEventListener("submit", function (e) {
      e.preventDefault();
      var raw      = createInput ? createInput.value : "";
      var category = createCategory ? createCategory.value : "autre";
      var type     = createType     ? createType.value     : "normal";
      // Séparer par virgules ET sauts de ligne
      var tagList  = raw.split(/[\n,]+/).map(function (t) { return t.trim().toLowerCase(); }).filter(Boolean);
      if (!tagList.length) return;

      // Dédupliquer contre les tags déjà présents dans la vue filtrée
      tagList = tagList.filter(function (tag) {
        return !filteredView.querySelector('[data-tag="' + tag + '"]');
      });
      if (!tagList.length) {
        if (createFeedback) {
          createFeedback.textContent = "Ces tags existent déjà.";
          createFeedback.style.color = "#e05555";
          createFeedback.hidden = false;
        }
        return;
      }

      var promises = tagList.map(function (tag) {
        var p1 = fetch("/api/tags/create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ tag: tag, category: category })
        }).then(function (r) { return r.json(); });
        var p2 = type !== "normal"
          ? fetch("/api/tags/type", {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ tag: tag, type: type })
            }).then(function (r) { return r.json(); })
          : Promise.resolve({ ok: true });
        return Promise.all([p1, p2]).then(function (res) { return { tag: tag, ok: res[0].ok }; });
      });

      Promise.all(promises).then(function (results) {
        var created = results.filter(function (r) { return r.ok; });
        if (created.length) {
          // Ajouter dans la vue filtrée
          created.forEach(function (r) {
            var div = document.createElement("div");
            div.className = "tags-item tags-item--" + type;
            div.dataset.tag      = r.tag;
            div.dataset.type     = type;
            div.dataset.category = category;
            div.dataset.breakdown = '{"wiki":0,"galerie":0,"bd":0}';
            div.style.setProperty("--tag-pct", "1");
            var nameSpan = document.createElement("span");
            nameSpan.className = "tags-item-name"; nameSpan.textContent = r.tag;
            var rightSpan = document.createElement("span");
            rightSpan.className = "tags-item-right";
            var countSpan = document.createElement("span");
            countSpan.className = "tags-item-count"; countSpan.textContent = "0";
            rightSpan.appendChild(countSpan);
            div.appendChild(nameSpan); div.appendChild(rightSpan);
            filteredView.insertBefore(div, filteredView.firstChild);
          });

          // Passer en vue filtrée par catégorie pour voir les nouveaux tags
          activeCat = category;
          if (catFilter) {
            catFilter.querySelectorAll(".tag-chip").forEach(function (b) {
              b.classList.toggle("active", (b.dataset.catFilter || "") === category);
            });
          }
          applyFilters();

          if (createInput) createInput.value = "";
          if (createFeedback) {
            createFeedback.textContent = created.length + " tag" + (created.length > 1 ? "s créés" : " créé") + " !";
            createFeedback.style.color = "var(--accent)";
            createFeedback.hidden = false;
          }
        } else {
          if (createFeedback) {
            createFeedback.textContent = "Erreur lors de la création.";
            createFeedback.style.color = "#e05555";
            createFeedback.hidden = false;
          }
        }
      }).catch(function () {
        if (createFeedback) {
          createFeedback.textContent = "Erreur réseau.";
          createFeedback.style.color = "#e05555";
          createFeedback.hidden = false;
        }
      });
    });
  }

  /* ── Admin : mode sélection multiple pour réassigner des catégories ── */
  if (isAdmin) {
    var selectModeBtn    = document.getElementById("tags-select-mode-btn");
    var bulkBar          = document.getElementById("tags-bulk-bar");
    var bulkCount        = document.getElementById("tags-bulk-count");
    var bulkCatSelect    = document.getElementById("tags-bulk-cat-select");
    var bulkSubcatSelect = document.getElementById("tags-bulk-subcat-select");
    var bulkApplyBtn     = document.getElementById("tags-bulk-apply-btn");
    var bulkCancelBtn    = document.getElementById("tags-bulk-cancel-btn");
    window._tagCatWithSub   = <%- JSON.stringify(CAT_WITH_SUB) %>;
    window._tagSubcatsByCat = <%- JSON.stringify(SUBCATS_BY_CAT) %>;
    var selectMode     = false;
    var selectedTags   = new Set();

    function updateSubcatVisibility() {
      if (!bulkSubcatSelect) return;
      var cat = bulkCatSelect ? bulkCatSelect.value : "";
      var hasSub = !!window._tagCatWithSub[cat];
      bulkSubcatSelect.hidden = !hasSub;
      if (!hasSub) { bulkSubcatSelect.value = ""; return; }
      // Repeupler les options selon la catégorie (toujours depuis la source live)
      var subs = window._tagSubcatsByCat[cat] || [];
      while (bulkSubcatSelect.options.length > 1) bulkSubcatSelect.remove(1);
      subs.forEach(function(s) {
        var opt = document.createElement("option");
        opt.value = s.key; opt.textContent = s.label;
        bulkSubcatSelect.appendChild(opt);
      });
    }
    if (bulkCatSelect) {
      bulkCatSelect.addEventListener("change", updateSubcatVisibility);
      updateSubcatVisibility();
    }

    function enterSelectMode() {
      selectMode = true;
      selectedTags.clear();
      if (selectModeBtn) { selectModeBtn.classList.add("active"); selectModeBtn.textContent = "Sélection active"; }
      if (bulkBar) bulkBar.hidden = false;
      updateBulkCount();
    }

    function exitSelectMode() {
      selectMode = false;
      selectedTags.clear();
      if (selectModeBtn) { selectModeBtn.classList.remove("active"); selectModeBtn.textContent = "Sélectionner"; }
      if (bulkBar) bulkBar.hidden = true;
      document.querySelectorAll(".tags-item--selected").forEach(function (el) {
        el.classList.remove("tags-item--selected");
      });
    }

    function updateBulkCount() {
      var n = selectedTags.size;
      if (bulkCount) bulkCount.textContent = n + " sélectionné" + (n > 1 ? "s" : "");
      if (bulkApplyBtn) bulkApplyBtn.disabled = n === 0;
    }

    if (selectModeBtn) {
      selectModeBtn.addEventListener("click", function () {
        if (selectMode) exitSelectMode(); else enterSelectMode();
      });
    }
    if (bulkCancelBtn) bulkCancelBtn.addEventListener("click", exitSelectMode);

    // Intercepter les clicks sur les tags quand en mode sélection
    if (grid) {
      grid.addEventListener("click", function (e) {
        if (!selectMode) return;
        if (e.target.closest(".tags-item-wiki-link")) return;
        if (e.target.closest(".tags-cat-more-btn"))   return;
        var item = e.target.closest(".tags-item");
        if (!item) return;
        e.stopImmediatePropagation();
        var tag = item.dataset.tag;
        if (selectedTags.has(tag)) {
          selectedTags.delete(tag);
          item.classList.remove("tags-item--selected");
        } else {
          selectedTags.add(tag);
          item.classList.add("tags-item--selected");
        }
        updateBulkCount();
      }, true); // capture pour prendre la main avant openTagPopup
    }

    if (bulkApplyBtn) {
      bulkApplyBtn.addEventListener("click", function () {
        if (!selectedTags.size) return;
        var cat    = bulkCatSelect    ? bulkCatSelect.value    : "autre";
        var subcat = (bulkSubcatSelect && !bulkSubcatSelect.hidden) ? bulkSubcatSelect.value : "";
        bulkApplyBtn.disabled = true;
        bulkApplyBtn.textContent = "…";

        var promises = Array.from(selectedTags).map(function (tag) {
          var catReq = fetch("/api/tags/category", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ tag: tag, category: cat })
          }).then(function (r) { return r.json(); });

          var subcatReq = catWithSub[cat]
            ? fetch("/api/tags/subcategory", {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ tag: tag, subcategory: subcat })
              }).then(function (r) { return r.json(); })
            : Promise.resolve({ ok: true });

          return Promise.all([catReq, subcatReq]).then(function (results) {
            if (results[0].ok) {
              document.querySelectorAll('.tags-item[data-tag="' + tag + '"]').forEach(function (el) {
                el.dataset.category = cat;
                el.dataset.subcategory = subcat;
              });
            }
            return { tag: tag, ok: !!results[0].ok };
          });
        });

        Promise.all(promises).then(function (results) {
          var n = results.filter(function (r) { return r.ok; }).length;
          bulkApplyBtn.textContent = "Assigner";
          exitSelectMode();
          applyFilters();
          if (createFeedback) {
            createFeedback.textContent = n + " tag" + (n > 1 ? "s" : "") + " réassigné" + (n > 1 ? "s" : "") + " !";
            createFeedback.style.color = "var(--accent)";
            createFeedback.hidden = false;
          }
        }).catch(function () {
          bulkApplyBtn.textContent = "Assigner";
          bulkApplyBtn.disabled = false;
        });
      });
    }
  }

})();
</script>

<% if (currentUser && currentUser.isAdmin) { %>
<script nonce="<%= nonce %>">
(function () {
  var overlay  = document.getElementById("tags-mgmt-overlay");
  var openBtn  = document.getElementById("tags-manage-cats-btn");
  var closeBtn = document.getElementById("tags-mgmt-close");
  var feedback = document.getElementById("tags-mgmt-feedback");
  var catList  = document.getElementById("tags-mgmt-cat-list");
  if (!overlay) return;

  /* ── Ouverture / fermeture ── */
  openBtn  && openBtn .addEventListener("click", function () { overlay.hidden = false; });
  closeBtn && closeBtn.addEventListener("click", function () { overlay.hidden = true;  });
  overlay.addEventListener("click", function (e) { if (e.target === overlay) overlay.hidden = true; });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !overlay.hidden) overlay.hidden = true; });

  /* ── Helpers ── */
  function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
  function showFeedback(msg, ok) {
    if (!feedback) return;
    feedback.textContent = msg;
    feedback.style.color = ok ? "var(--accent)" : "hsl(0,70%,65%)";
    feedback.hidden = false;
    setTimeout(function () { feedback.hidden = true; }, 3000);
  }
  function api(method, url, body) {
    return fetch(url, {
      method: method,
      headers: { "Content-Type": "application/json" },
      body: body ? JSON.stringify(body) : undefined
    }).then(function (r) { return r.json(); });
  }

  /* ── Édition inline d'une ligne ── */
  function enterEditMode(row, currentLabel, onSave) {
    if (row.dataset.editing) return;
    row.dataset.editing = "1";
    var labelEl = row.querySelector(".tags-mgmt-row-label");
    var actEl   = row.querySelector(".tags-mgmt-row-actions");
    if (!labelEl) return;
    labelEl.style.display = "none";
    if (actEl) actEl.style.display = "none";
    var inp = document.createElement("input");
    inp.type = "text";
    inp.className = "tags-mgmt-input tags-mgmt-inline-input";
    inp.value = currentLabel;
    var saveBtn = document.createElement("button");
    saveBtn.type = "button"; saveBtn.className = "tags-mgmt-add-btn"; saveBtn.textContent = "✓";
    var cancelBtn = document.createElement("button");
    cancelBtn.type = "button"; cancelBtn.className = "tags-mgmt-cancel-btn"; cancelBtn.textContent = "✕";
    var wrap = document.createElement("div");
    wrap.className = "tags-mgmt-inline-edit";
    wrap.appendChild(inp); wrap.appendChild(saveBtn); wrap.appendChild(cancelBtn);
    row.insertBefore(wrap, row.querySelector(".tags-mgmt-row-actions") || null);
    inp.focus(); inp.select();
    function cancel() {
      delete row.dataset.editing;
      wrap.remove();
      labelEl.style.display = "";
      if (actEl) actEl.style.display = "";
    }
    function save() {
      var newLabel = inp.value.trim();
      if (!newLabel || newLabel === currentLabel) { cancel(); return; }
      onSave(newLabel, function(ok, updatedLabel) {
        if (ok) {
          labelEl.textContent = updatedLabel || newLabel;
          cancel();
        } else { inp.classList.add("tags-mgmt-input--err"); }
      });
    }
    saveBtn.addEventListener("click", save);
    cancelBtn.addEventListener("click", cancel);
    inp.addEventListener("keydown", function(e) {
      if (e.key === "Enter") { e.preventDefault(); save(); }
      if (e.key === "Escape") { e.preventDefault(); cancel(); }
    });
  }

  /* ── Délégation ── */
  catList && catList.addEventListener("click", function (e) {
    var editBtn     = e.target.closest(".tags-mgmt-edit-btn");
    var delBtn      = e.target.closest(".tags-mgmt-del-btn");
    var expandBtn   = e.target.closest(".tags-mgmt-expand-btn");
    var toggleSubBtn = e.target.closest(".tags-mgmt-toggle-sub-btn");

    /* ── Expand/collapse sous-catégories ── */
    if (expandBtn) {
      var catRow = expandBtn.closest(".tags-mgmt-cat-row");
      var subsEl = catRow ? catRow.querySelector(".tags-mgmt-subs") : null;
      if (subsEl) {
        var open = !subsEl.hidden && !subsEl.classList.contains("collapsed");
        subsEl.classList.toggle("collapsed", open);
        expandBtn.textContent = open ? "▶" : "▼";
      }
      return;
    }

    /* ── Toggle sous-catégories ON/OFF ── */
    if (toggleSubBtn) {
      var catRow = toggleSubBtn.closest(".tags-mgmt-cat-row");
      if (!catRow) return;
      var key     = catRow.dataset.key;
      var current = catRow.dataset.hasSubcats === "1";
      var badge   = toggleSubBtn.querySelector(".tags-mgmt-sub-badge");
      var labelEl = catRow.querySelector(".tags-mgmt-row--cat .tags-mgmt-row-label");
      var label   = labelEl ? labelEl.textContent.trim() : key;
      api("PUT", "/api/tag-categories/" + encodeURIComponent(key), { label: label, has_subcats: current ? 0 : 1 })
        .then(function (r) {
          if (r.ok) {
            catRow.dataset.hasSubcats = current ? "0" : "1";
            if (badge) badge.classList.toggle("on", !current);
            // Affiche/masque la zone subs
            var subsEl = catRow.querySelector(".tags-mgmt-subs");
            if (!current && !subsEl) {
              // Créer la zone subs vide
              var newSubs = document.createElement("div");
              newSubs.className = "tags-mgmt-subs";
              newSubs.dataset.cat = key;
              newSubs.innerHTML = '<ul class="tags-mgmt-sub-list"></ul>' +
                '<form class="tags-mgmt-add-row" data-cat="' + esc(key) + '">' +
                  '<input type="text" class="tags-mgmt-input" placeholder="Nouvelle sous-catégorie\u2026" autocomplete="off">' +
                  '<button type="submit" class="tags-mgmt-add-btn">+ Ajouter</button>' +
                '</form>';
              catRow.appendChild(newSubs);
              // Ajoute expand btn
              var catRowEl = catRow.querySelector(".tags-mgmt-row--cat");
              if (catRowEl && !catRowEl.querySelector(".tags-mgmt-expand-btn")) {
                var eb = document.createElement("button");
                eb.type = "button"; eb.className = "tags-mgmt-expand-btn"; eb.title = "Sous-catégories"; eb.textContent = "▼";
                catRowEl.insertBefore(eb, catRowEl.querySelector(".tags-mgmt-row-actions"));
              }
            } else if (current && subsEl) {
              subsEl.remove();
              var eb = catRow.querySelector(".tags-mgmt-expand-btn");
              if (eb) eb.remove();
            }
            showFeedback("Mise à jour.", true);
          } else { showFeedback(r.error || "Erreur", false); }
        });
      return;
    }

    /* ── Édition ── */
    if (editBtn) {
      var subRow = editBtn.closest(".tags-mgmt-row--sub");
      var catRow = editBtn.closest(".tags-mgmt-cat-row");
      if (subRow) {
        var key    = subRow.dataset.key;
        var catKey = subRow.dataset.cat;
        var labelEl = subRow.querySelector(".tags-mgmt-row-label");
        enterEditMode(subRow, labelEl ? labelEl.textContent.trim() : key, function(newLabel, done) {
          api("PUT", "/api/tag-subcategories/" + encodeURIComponent(catKey) + "/" + encodeURIComponent(key), { label: newLabel })
            .then(function(r) {
              done(r.ok);
              if (r.ok) {
                // Sync bulk bar data
                if (window._tagSubcatsByCat && window._tagSubcatsByCat[catKey]) {
                  var s = window._tagSubcatsByCat[catKey].find(function(s) { return s.key === key; });
                  if (s) s.label = newLabel;
                }
                showFeedback("Sous-catégorie renommée.", true);
              } else { showFeedback(r.error||"Erreur", false); }
            });
        });
      } else if (catRow) {
        var key     = catRow.dataset.key;
        var catRowEl = catRow.querySelector(".tags-mgmt-row--cat");
        var labelEl  = catRowEl ? catRowEl.querySelector(".tags-mgmt-row-label") : null;
        enterEditMode(catRowEl, labelEl ? labelEl.textContent.trim() : key, function(newLabel, done) {
          var hasSub = catRow.dataset.hasSubcats === "1";
          api("PUT", "/api/tag-categories/" + encodeURIComponent(key), { label: newLabel, has_subcats: hasSub })
            .then(function(r) { done(r.ok, newLabel); if (r.ok) showFeedback("Catégorie renommée.", true); else showFeedback(r.error||"Erreur", false); });
        });
      }
      return;
    }

    /* ── Suppression ── */
    if (delBtn) {
      var subRow = delBtn.closest(".tags-mgmt-row--sub");
      var catRow = delBtn.closest(".tags-mgmt-cat-row");
      if (subRow) {
        var key    = subRow.dataset.key;
        var catKey = subRow.dataset.cat;
        var labelEl = subRow.querySelector(".tags-mgmt-row-label");
        var label   = labelEl ? labelEl.textContent.trim() : key;
        if (!subRow.dataset.confirmDel) {
          subRow.dataset.confirmDel = "1";
          delBtn.textContent = "Confirmer ?";
          delBtn.classList.add("tags-mgmt-del-confirm");
          setTimeout(function(){ delete subRow.dataset.confirmDel; delBtn.textContent = "🗑"; delBtn.classList.remove("tags-mgmt-del-confirm"); }, 3000);
          return;
        }
        api("DELETE", "/api/tag-subcategories/" + encodeURIComponent(catKey) + "/" + encodeURIComponent(key))
          .then(function(r) {
            if (r.ok) {
              subRow.remove();
              // Sync bulk bar data
              if (window._tagSubcatsByCat && window._tagSubcatsByCat[catKey]) {
                window._tagSubcatsByCat[catKey] = window._tagSubcatsByCat[catKey].filter(function(s) { return s.key !== key; });
                if (!window._tagSubcatsByCat[catKey].length) window._tagCatWithSub[catKey] = false;
              }
              showFeedback('«\u00a0' + label + '\u00a0» supprimée.', true);
            }
            else { showFeedback(r.error || "Utilisée par des tags", false); delete subRow.dataset.confirmDel; delBtn.textContent = "🗑"; delBtn.classList.remove("tags-mgmt-del-confirm"); }
          });
      } else if (catRow) {
        var key     = catRow.dataset.key;
        var catRowEl = catRow.querySelector(".tags-mgmt-row--cat");
        var labelEl  = catRowEl ? catRowEl.querySelector(".tags-mgmt-row-label") : null;
        var label    = labelEl ? labelEl.textContent.trim() : key;
        if (!catRow.dataset.confirmDel) {
          catRow.dataset.confirmDel = "1";
          delBtn.textContent = "Confirmer ?";
          delBtn.classList.add("tags-mgmt-del-confirm");
          setTimeout(function(){ delete catRow.dataset.confirmDel; delBtn.textContent = "🗑"; delBtn.classList.remove("tags-mgmt-del-confirm"); }, 3000);
          return;
        }
        api("DELETE", "/api/tag-categories/" + encodeURIComponent(key))
          .then(function(r) {
            if (r.ok) { catRow.remove(); showFeedback('«\u00a0' + label + '\u00a0» supprimée.', true); }
            else { showFeedback(r.error || "Utilisée par des tags", false); delete catRow.dataset.confirmDel; delBtn.textContent = "🗑"; delBtn.classList.remove("tags-mgmt-del-confirm"); }
          });
      }
      return;
    }
  });

  /* ── Ajout sous-catégorie ── */
  catList && catList.addEventListener("submit", function (e) {
    var addRow = e.target.closest(".tags-mgmt-add-row[data-cat]");
    if (!addRow) return;
    e.preventDefault();
    var catKey  = addRow.dataset.cat;
    var inp     = addRow.querySelector(".tags-mgmt-input");
    var label   = inp ? inp.value.trim() : "";
    if (!label) return;
    api("POST", "/api/tag-subcategories", { label: label, category_key: catKey })
      .then(function (r) {
        if (r.ok) {
          var ul = addRow.closest(".tags-mgmt-subs").querySelector(".tags-mgmt-sub-list");
          if (ul) {
            var li = document.createElement("li");
            li.className = "tags-mgmt-row tags-mgmt-row--sub";
            li.dataset.key = r.key;
            li.dataset.cat = catKey;
            li.innerHTML = '<span class="tags-mgmt-row-label" title="clé\u00a0: ' + esc(r.key) + '">' + esc(label) + '</span>' +
              '<div class="tags-mgmt-row-actions">' +
                '<button type="button" class="tags-mgmt-edit-btn" title="Renommer">&#9998;</button>' +
                '<button type="button" class="tags-mgmt-del-btn" title="Supprimer">&#128465;</button>' +
              '</div>';
            ul.appendChild(li);
          }
          if (inp) inp.value = "";
          // Sync bulk bar data
          if (window._tagSubcatsByCat) {
            window._tagSubcatsByCat[catKey] = window._tagSubcatsByCat[catKey] || [];
            window._tagSubcatsByCat[catKey].push({ key: r.key, label: label });
            window._tagCatWithSub[catKey] = true;
          }
          showFeedback("Sous-catégorie créée\u00a0: " + r.key, true);
        } else { showFeedback(r.error || "Erreur", false); }
      });
  });

  /* ── Ajout catégorie ── */
  var catAddForm = document.getElementById("tags-mgmt-cat-add");
  catAddForm && catAddForm.addEventListener("submit", function (e) {
    e.preventDefault();
    var labelEl  = document.getElementById("tags-mgmt-cat-label");
    var hasSubEl = document.getElementById("tags-mgmt-cat-hassub");
    var label    = labelEl ? labelEl.value.trim() : "";
    if (!label) return;
    var hasSub = hasSubEl && hasSubEl.checked ? 1 : 0;
    api("POST", "/api/tag-categories", { label: label, has_subcats: hasSub })
      .then(function (r) {
        if (r.ok) {
          var li = document.createElement("li");
          li.className = "tags-mgmt-cat-row";
          li.dataset.key = r.key;
          li.dataset.hasSubcats = hasSub ? "1" : "0";
          var subsHtml = hasSub ? '<div class="tags-mgmt-subs" data-cat="' + esc(r.key) + '"><ul class="tags-mgmt-sub-list"></ul><form class="tags-mgmt-add-row" data-cat="' + esc(r.key) + '"><input type="text" class="tags-mgmt-input" placeholder="Nouvelle sous-catégorie\u2026" autocomplete="off"><button type="submit" class="tags-mgmt-add-btn">+ Ajouter</button></form></div>' : '';
          var expandHtml = hasSub ? '<button type="button" class="tags-mgmt-expand-btn" title="Sous-catégories">&#9660;</button>' : '';
          li.innerHTML = '<div class="tags-mgmt-row tags-mgmt-row--cat">' +
            '<span class="tags-mgmt-row-label" title="clé\u00a0: ' + esc(r.key) + '">' + esc(label) + '</span>' +
            expandHtml +
            '<div class="tags-mgmt-row-actions">' +
              '<button type="button" class="tags-mgmt-edit-btn" title="Renommer">&#9998;</button>' +
              '<button type="button" class="tags-mgmt-toggle-sub-btn" title="' + (hasSub ? 'Désactiver' : 'Activer') + ' les sous-catégories"><span class="tags-mgmt-sub-badge' + (hasSub ? ' on' : '') + '">sous-cat</span></button>' +
              '<button type="button" class="tags-mgmt-del-btn" title="Supprimer">&#128465;</button>' +
            '</div></div>' + subsHtml;
          catList.insertBefore(li, catAddForm.closest(".tags-mgmt-add-row--cat"));
          labelEl.value = "";
          if (hasSubEl) hasSubEl.checked = false;
          showFeedback("Catégorie créée\u00a0: " + r.key, true);
        } else { showFeedback(r.error || "Erreur", false); }
      });
  });
})();
</script>
<% } %>

<%- include('partials/foot') %>
