<%- include('partials/head', { title: 'Admin', extraCss: ['admin.css'] }) %>

<div class="admin-topbar">
  <span class="admin-topbar-title"><%= config.title %></span>
  <form method="POST" action="/admin/logout" style="margin:0">
    <button type="submit" class="admin-topbar-logout">D&eacute;connexion</button>
  </form>
</div>

<nav class="admin-tabs-nav" id="admin-tabs-nav">
  <button class="admin-tab-btn active" data-tab="utilisateurs">Utilisateurs</button>
  <button class="admin-tab-btn" data-tab="wiki">Codex</button>
  <button class="admin-tab-btn" data-tab="galerie">Galerie</button>
  <button class="admin-tab-btn" data-tab="log">Log</button>
  <a href="/" class="admin-tab-home" title="Retour à l&apos;accueil">&#8962; Accueil</a>
</nav>

<main class="admin-main">

  <%# ═══════════════════════════════════════════════
      TAB : UTILISATEURS
  ═══════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="utilisateurs">

    <% if (locals.adminError) { %>
      <p class="admin-error-msg"><%= adminError %></p>
    <% } %>

    <%# ── Bibliothèque de cartes ── %>
    <div class="admin-user-lib">

      <%# Carte "+" — créer un utilisateur %>
      <button type="button" class="admin-utile admin-utile--create" id="admin-create-btn" aria-label="Cr&eacute;er un utilisateur">
        <span class="admin-utile-plus">+</span>
        <span class="admin-utile-create-label">Nouvel utilisateur</span>
      </button>

      <% userStates.forEach(function(state) { %>
        <%
          var uVariant = state.user.isAdmin ? 'admin' : (state.user.isTest ? 'test' : 'normal');
          var uInitial = (state.user.displayName || '?').charAt(0).toUpperCase();
          var uLastLogin = '';
          if (state.user.lastLoginAt) {
            var diff = Date.now() - new Date(state.user.lastLoginAt).getTime();
            var days = Math.floor(diff / 86400000);
            if (days === 0) uLastLogin = 'aujourd\u2019hui';
            else if (days === 1) uLastLogin = 'hier';
            else if (days < 30) uLastLogin = 'il y a ' + days + 'j';
            else uLastLogin = new Date(state.user.lastLoginAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
          } else {
            uLastLogin = 'jamais connect\u00e9';
          }
        %>
        <div class="admin-utile admin-utile--<%= uVariant %>">
          <div class="admin-utile-top">
            <div class="admin-utile-avatar"><%= uInitial %></div>
            <details class="admin-utile-menu" onclick="event.stopPropagation()">
              <summary class="admin-utile-menu-btn" title="Actions">&#8943;</summary>
              <div class="admin-utile-menu-body">
                <a href="/admin/utilisateur/<%= state.user.id %>" class="admin-utile-menu-item">Voir le profil</a>
                <button type="button" class="admin-utile-menu-item"
                  data-edit-id="<%= state.user.id %>"
                  data-edit-nom="<%= state.user.displayName %>"
                  data-edit-role="<%= state.user.isAdmin ? 'admin' : (state.user.isTest ? 'test' : 'normal') %>"
                  data-edit-sexe="<%= state.user.sexe || '' %>"
                  data-edit-birth-year="<%= state.user.birthYear || '' %>"
                  data-edit-orientation="<%= state.user.orientation || '' %>"
                  data-edit-email="<%= state.user.email || '' %>"
                  data-self="<%= state.user.id === currentUser.id ? '1' : '0' %>">Modifier</button>
                <button type="button" class="admin-utile-menu-item"
                  data-pwd-id="<%= state.user.id %>"
                  data-pwd-name="<%= state.user.displayName %>">R&eacute;init. MDP</button>
                <% if (state.user.id !== currentUser.id) { %>
                  <button type="button" class="admin-utile-menu-item admin-utile-menu-item--danger"
                    data-del-id="<%= state.user.id %>"
                    data-del-name="<%= state.user.displayName %>">Supprimer</button>
                <% } %>
              </div>
            </details>
          </div>

          <button type="button" class="admin-utile-body-link" data-profile-id="<%= state.user.id %>">
            <div class="admin-utile-name">
              <%= state.user.displayName %>
              <% if (state.user.shareNotesWithAdmin) { %>
                <span class="admin-share-dot" title="Partage ses notes et favoris avec l'admin" aria-label="Partage ses notes et favoris avec l'admin"></span>
              <% } %>
            </div>
            <div class="admin-utile-login"><%= uLastLogin %></div>
          </button>

          <div class="admin-utile-stats">
            <div class="admin-utile-stat">
              <span class="admin-utile-stat-val"><%= state.livePercentage > 0 ? state.livePercentage + '%' : 'N/A' %></span>
              <span class="admin-utile-stat-key">Quizz</span>
            </div>
            <div class="admin-utile-stat">
              <span class="admin-utile-stat-val"><%= state.reactionStats.ratingCount %></span>
              <span class="admin-utile-stat-key">Notes</span>
            </div>
            <div class="admin-utile-stat">
              <span class="admin-utile-stat-val"><%= state.reactionStats.flameCount %></span>
              <span class="admin-utile-stat-key">J&rsquo;adore</span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <%# ── Modal : créer un utilisateur ── %>
    <div class="admin-modal-overlay" id="admin-create-modal" hidden>
      <div class="admin-modal">
        <button type="button" class="admin-modal-close" id="admin-create-modal-close" aria-label="Fermer">&#215;</button>
        <h2 class="admin-modal-title">Nouvel utilisateur</h2>
        <form method="POST" action="/admin/profils" class="admin-modal-form">
          <label class="admin-modal-field">
            <span>Nom</span>
            <input type="text" name="nom" required autocomplete="off" />
          </label>
          <label class="admin-modal-field">
            <span>Mot de passe</span>
            <input type="password" name="password" required autocomplete="new-password" />
          </label>
          <label class="admin-modal-field">
            <span>R&ocirc;le</span>
            <select name="role" class="admin-modal-select">
              <option value="normal">Normal</option>
              <option value="admin">Admin</option>
              <option value="test">Test</option>
            </select>
          </label>
          <details class="admin-modal-extra-details">
            <summary class="admin-modal-extra-summary">Profil &rsaquo;</summary>
            <div class="admin-modal-extra-body">
              <label class="admin-modal-field">
                <span>Sexe</span>
                <select name="sexe" class="admin-modal-select">
                  <option value="">Non pr&eacute;cis&eacute;</option>
                  <option value="femme">Femme</option>
                  <option value="homme">Homme</option>
                  <option value="autre">Autre</option>
                </select>
              </label>
              <label class="admin-modal-field">
                <span>Ann&eacute;e de naissance</span>
                <input type="number" name="birth_year" min="1940" max="2010" autocomplete="off" />
              </label>
              <label class="admin-modal-field">
                <span>Orientation</span>
                <select name="orientation" class="admin-modal-select">
                  <option value="">Non pr&eacute;cis&eacute;e</option>
                  <option value="hetero">H&eacute;t&eacute;ro</option>
                  <option value="gay">Gay / Lesbienne</option>
                  <option value="bi">Bisexuel·le</option>
                </select>
              </label>
              <label class="admin-modal-field">
                <span>Email</span>
                <input type="email" name="email" autocomplete="off" />
              </label>
            </div>
          </details>
          <button type="submit" class="admin-btn-primary">Cr&eacute;er</button>
        </form>
      </div>
    </div>

    <%# ── Modal : modifier un utilisateur ── %>
    <div class="admin-modal-overlay" id="admin-edit-modal" hidden>
      <div class="admin-modal">
        <button type="button" class="admin-modal-close" id="admin-edit-modal-close" aria-label="Fermer">&#215;</button>
        <h2 class="admin-modal-title">Modifier</h2>
        <form method="POST" id="admin-edit-form" action="/admin/profils/__ID__/edit" class="admin-modal-form">
          <label class="admin-modal-field">
            <span>Nom</span>
            <input type="text" name="nom" id="edit-nom" required autocomplete="off" />
          </label>
          <label class="admin-modal-field">
            <span>R&ocirc;le</span>
            <select name="role" id="edit-role" class="admin-modal-select">
              <option value="normal">Normal</option>
              <option value="admin">Admin</option>
              <option value="test">Test</option>
            </select>
          </label>
          <details class="admin-modal-extra-details" open>
            <summary class="admin-modal-extra-summary">Profil &rsaquo;</summary>
            <div class="admin-modal-extra-body">
              <label class="admin-modal-field">
                <span>Sexe</span>
                <select name="sexe" id="edit-sexe" class="admin-modal-select">
                  <option value="">Non pr&eacute;cis&eacute;</option>
                  <option value="femme">Femme</option>
                  <option value="homme">Homme</option>
                  <option value="autre">Autre</option>
                </select>
              </label>
              <label class="admin-modal-field">
                <span>Ann&eacute;e de naissance</span>
                <input type="number" name="birth_year" id="edit-birth-year" min="1940" max="2010" autocomplete="off" />
              </label>
              <label class="admin-modal-field">
                <span>Orientation</span>
                <select name="orientation" id="edit-orientation" class="admin-modal-select">
                  <option value="">Non pr&eacute;cis&eacute;e</option>
                  <option value="hetero">H&eacute;t&eacute;ro</option>
                  <option value="gay">Gay / Lesbienne</option>
                  <option value="bi">Bisexuel·le</option>
                </select>
              </label>
              <label class="admin-modal-field">
                <span>Email</span>
                <input type="email" name="email" id="edit-email" autocomplete="off" />
              </label>
            </div>
          </details>
          <button type="submit" class="admin-btn-primary">Enregistrer</button>
        </form>
      </div>
    </div>

    <%# ── Modal : réinitialiser mot de passe ── %>
    <div class="admin-modal-overlay" id="admin-pwd-modal" hidden>
      <div class="admin-modal">
        <button type="button" class="admin-modal-close" id="admin-pwd-modal-close" aria-label="Fermer">&#215;</button>
        <h2 class="admin-modal-title" id="admin-pwd-modal-title">R&eacute;init. MDP</h2>
        <form method="POST" id="admin-pwd-form" action="/admin/profils/__ID__/password" class="admin-modal-form">
          <label class="admin-modal-field">
            <span>Nouveau mot de passe</span>
            <input type="password" name="password" required autocomplete="new-password" />
          </label>
          <button type="submit" class="admin-btn-primary">Changer</button>
        </form>
      </div>
    </div>

    <%# ── Formulaire caché : supprimer ── %>
    <form method="POST" id="admin-del-form" action="/admin/profils/__ID__/delete" style="display:none"></form>

  </section>

  <%# ═══════════════════════════════════════════════
      TAB : WIKI
  ═══════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="wiki" hidden>

    <%# ── KPI ── %>
    <div class="admin-kpi-grid">
      <div class="admin-kpi-card">
        <span class="admin-kpi-value"><%= wikiKPIs.totalViews.toLocaleString('fr-FR') %></span>
        <span class="admin-kpi-label">Vues totales</span>
        <span class="admin-kpi-sub">tous temps</span>
      </div>
      <div class="admin-kpi-card">
        <span class="admin-kpi-value"><%= wikiKPIs.monthViews.toLocaleString('fr-FR') %></span>
        <span class="admin-kpi-label">Ce mois</span>
        <span class="admin-kpi-sub">depuis le 1<sup>er</sup></span>
      </div>
      <div class="admin-kpi-card">
        <span class="admin-kpi-value"><%= wikiKPIs.weekViews.toLocaleString('fr-FR') %></span>
        <span class="admin-kpi-label">7 derniers jours</span>
        <span class="admin-kpi-sub">glissants</span>
      </div>
    </div>

    <%# ── Top pages ── %>
    <% if (wikiKPIs.topPages.length) { %>
    <div class="admin-kpi-top-section">
      <div class="admin-kpi-top-header">
        <span class="admin-kpi-top-title">Pages les plus consult&eacute;es</span>
        <div class="admin-kpi-limit-toggle" id="wiki-limit-toggle">
          <button class="active" data-limit="10">10</button>
          <button data-limit="20">20</button>
        </div>
      </div>
      <table class="admin-table admin-kpi-top-table" id="wiki-top-table">
        <thead><tr><th>#</th><th>Page</th><th>Cat&eacute;gorie</th><th style="text-align:right">Vues</th></tr></thead>
        <tbody>
          <% wikiKPIs.topPages.forEach(function(p, i) { %>
          <tr data-rank="<%= i + 1 %>"<%= i >= 10 ? ' class="admin-rank-hidden"' : '' %>>
            <td class="admin-kpi-rank"><%= i + 1 %></td>
            <td><a href="/wiki/<%= p.id %>"><%= p.title %></a></td>
            <td class="admin-muted"><%= p.category %></td>
            <td style="text-align:right;font-variant-numeric:tabular-nums"><%= p.views %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <%# ── Par utilisateur ── %>
    <% if (wikiKPIs.perUser.length) { %>
    <div class="admin-kpi-users">
      <h3 class="admin-kpi-users-title">Par utilisateur</h3>
      <% var wikiMax = wikiKPIs.perUser[0] ? wikiKPIs.perUser[0].views : 1; %>
      <% wikiKPIs.perUser.forEach(function(u) { %>
      <details class="admin-kpi-user-row">
        <summary class="admin-kpi-user-summary">
          <span class="admin-kpi-user-name<%= u.userId === null ? ' admin-kpi-anon' : '' %>"><%= u.displayName %></span>
          <div class="admin-kpi-bar-wrap">
            <div class="admin-kpi-bar" style="width:<%= Math.round((u.views / wikiMax) * 100) %>%"></div>
          </div>
          <span class="admin-kpi-user-count"><%= u.views.toLocaleString('fr-FR') %></span>
        </summary>
        <% if (u.topPages.length) { %>
        <ul class="admin-kpi-top-list">
          <% u.topPages.forEach(function(p) { %>
          <li class="admin-kpi-top-item">
            <a href="/wiki/<%= p.pageId %>" class="admin-btn-link"><%= p.title %></a>
            <span class="admin-kpi-top-count"><%= p.views %> vue<%= p.views > 1 ? 's' : '' %></span>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </details>
      <% }) %>
    </div>
    <% } %>

    <h2 class="admin-section-title">Mise en avant</h2>
    <p class="admin-muted" style="margin-bottom:.75rem">Ces pages apparaissent dans &laquo;&nbsp;Ce qui pourrait t&apos;int&eacute;resser&nbsp;&raquo; sur l&apos;accueil.</p>
    <ul class="admin-featured-list" id="wiki-featured-list">
      <% allWikiPagesSorted.forEach(function(p) { %>
        <li class="admin-featured-item" data-id="<%= p.id %>">
          <button type="button" class="admin-featured-toggle<%= p.featured ? ' active' : '' %>" title="<%= p.featured ? 'Retirer' : 'Mettre en avant' %>">
            <%= p.featured ? '&#9733;' : '&#9734;' %>
          </button>
          <a href="/wiki/<%= p.id %>" class="admin-featured-title"><%= p.title %></a>
          <span class="admin-featured-cat"><%= p.category %></span>
          <span class="admin-featured-views"><%= p.views %> vues</span>
          <a href="/wiki/<%= p.id %>/edit" class="admin-btn-link" style="margin-left:auto">Éditer</a>
        </li>
      <% }) %>
    </ul>

    <h2 class="admin-section-title" style="margin-top:2rem">Top pages (vues)</h2>
    <div class="table-scroll">
      <table class="admin-table">
        <thead><tr><th>Page</th><th>Cat&eacute;gorie</th><th style="text-align:right">Vues</th><th></th></tr></thead>
        <tbody>
          <% wikiPages.slice(0, 30).forEach(function(p) { %>
            <tr>
              <td><a href="/wiki/<%= p.id %>"><%= p.title %></a></td>
              <td><%= p.category %></td>
              <td style="text-align:right;font-variant-numeric:tabular-nums"><%= p.views %></td>
              <td><a href="/wiki/<%= p.id %>/edit" class="admin-btn-link">Éditer</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <%# ═══════════════════════════════════════════════
      TAB : GALERIE
  ═══════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="galerie" hidden>

    <%# ── KPI ── %>
    <div class="admin-kpi-grid">
      <div class="admin-kpi-card">
        <span class="admin-kpi-value"><%= galleryKPIs.totalViews.toLocaleString('fr-FR') %></span>
        <span class="admin-kpi-label">Consultations</span>
        <span class="admin-kpi-sub">depuis le suivi</span>
      </div>
      <div class="admin-kpi-card">
        <span class="admin-kpi-value"><%= galleryKPIs.monthViews.toLocaleString('fr-FR') %></span>
        <span class="admin-kpi-label">Ce mois</span>
        <span class="admin-kpi-sub">depuis le 1<sup>er</sup></span>
      </div>
      <div class="admin-kpi-card">
        <span class="admin-kpi-value"><%= galleryKPIs.weekViews.toLocaleString('fr-FR') %></span>
        <span class="admin-kpi-label">7 derniers jours</span>
        <span class="admin-kpi-sub">glissants</span>
      </div>
    </div>

    <%# ── Top images ── %>
    <% if (galleryKPIs.topImages.length) { %>
    <div class="admin-kpi-top-section">
      <div class="admin-kpi-top-header">
        <span class="admin-kpi-top-title">Images les plus consult&eacute;es<% if (galleryKPIs.topImagesFallback) { %> <span class="admin-kpi-fallback-label">(par note, suivi pas encore actif)</span><% } %></span>
        <div class="admin-kpi-limit-toggle" id="gal-img-limit-toggle">
          <button class="active" data-limit="10">10</button>
          <button data-limit="20">20</button>
        </div>
      </div>
      <table class="admin-table admin-kpi-top-table" id="gal-img-top-table">
        <thead><tr><th>#</th><th>Image</th><th style="text-align:right">Vues</th></tr></thead>
        <tbody>
          <% galleryKPIs.topImages.forEach(function(img, i) { %>
          <tr data-rank="<%= i + 1 %>"<%= i >= 10 ? ' class="admin-rank-hidden"' : '' %>>
            <td class="admin-kpi-rank"><%= i + 1 %></td>
            <td><a href="/galerie/<%= img.id %>/edit"><%= img.title || 'N/A' %></a></td>
            <td style="text-align:right;font-variant-numeric:tabular-nums"><%= img.views %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <%# ── Top BD ── %>
    <% if (galleryKPIs.topBd.length) { %>
    <div class="admin-kpi-top-section">
      <div class="admin-kpi-top-header">
        <span class="admin-kpi-top-title">BD les plus consult&eacute;es<% if (galleryKPIs.topBdFallback) { %> <span class="admin-kpi-fallback-label">(par note, suivi pas encore actif)</span><% } %></span>
        <div class="admin-kpi-limit-toggle" id="gal-bd-limit-toggle">
          <button class="active" data-limit="10">10</button>
          <button data-limit="20">20</button>
        </div>
      </div>
      <table class="admin-table admin-kpi-top-table" id="gal-bd-top-table">
        <thead><tr><th>#</th><th>BD</th><th style="text-align:right">Vues</th></tr></thead>
        <tbody>
          <% galleryKPIs.topBd.forEach(function(img, i) { %>
          <tr data-rank="<%= i + 1 %>"<%= i >= 10 ? ' class="admin-rank-hidden"' : '' %>>
            <td class="admin-kpi-rank"><%= i + 1 %></td>
            <td><a href="/galerie/<%= img.id %>/edit"><%= img.title || 'N/A' %></a></td>
            <td style="text-align:right;font-variant-numeric:tabular-nums"><%= img.views %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <%# ── Par utilisateur ── %>
    <% if (galleryKPIs.perUser.length) { %>
    <div class="admin-kpi-users">
      <h3 class="admin-kpi-users-title">Par utilisateur</h3>
      <% var galMax = galleryKPIs.perUser[0] ? galleryKPIs.perUser[0].views : 1; %>
      <% galleryKPIs.perUser.forEach(function(u) { %>
      <details class="admin-kpi-user-row">
        <summary class="admin-kpi-user-summary">
          <span class="admin-kpi-user-name<%= u.userId === null ? ' admin-kpi-anon' : '' %>"><%= u.displayName %></span>
          <div class="admin-kpi-bar-wrap">
            <div class="admin-kpi-bar" style="width:<%= Math.round((u.views / galMax) * 100) %>%"></div>
          </div>
          <span class="admin-kpi-user-count"><%= u.views.toLocaleString('fr-FR') %></span>
        </summary>
        <% if (u.topImages.length) { %>
        <ul class="admin-kpi-top-list">
          <% u.topImages.forEach(function(img) { %>
          <li class="admin-kpi-top-item">
            <a href="/galerie/<%= img.galleryId %>/edit" class="admin-btn-link"><%= img.title || '#' + img.galleryId %></a>
            <span class="admin-kpi-top-count"><%= img.views %> vue<%= img.views > 1 ? 's' : '' %></span>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </details>
      <% }) %>
    </div>
    <% } %>

    <h2 class="admin-section-title">Top images (note)</h2>
    <div class="admin-gallery-grid" id="admin-gallery-grid">
      <% galleryImages.slice(0, 40).forEach(function(img) { %>
        <div class="admin-gallery-card" data-id="<%= img.id %>">
          <img src="<%= thumbUrl(img.imagePaths[0]) %>" alt="<%= img.title %>" class="admin-gallery-thumb" loading="lazy" />
          <div class="admin-gallery-info">
            <span class="admin-gallery-name"><%= img.title || 'N/A' %></span>
            <span class="admin-gallery-rating">&#9733; <%= img.rating %></span>
            <div class="admin-gallery-row">
              <button type="button" class="admin-gallery-feat-btn<%= img.featured ? ' active' : '' %>" title="<%= img.featured ? 'Retirer' : 'Mettre en avant' %>">
                <%= img.featured ? '&#9733;' : '&#9734;' %>
              </button>
              <a href="/galerie/<%= img.id %>/edit" class="admin-btn-link">Éditer</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <%# ═══════════════════════════════════════════════
      TAB : LOG
  ═══════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="log" hidden>

    <h2 class="admin-section-title">Connexions r&eacute;centes (<%= connectionLogs.length %>)</h2>
    <% if (!connectionLogs.length) { %>
      <p class="admin-muted">Aucune connexion enregistr&eacute;e pour l&apos;instant.</p>
    <% } else { %>
    <div class="table-scroll">
      <table class="admin-table">
        <thead>
          <tr><th>Utilisateur</th><th>IP</th><th>Date</th></tr>
        </thead>
        <tbody>
          <% connectionLogs.forEach(function(log) { %>
            <tr>
              <td><%= log.userDisplayName || 'N/A' %></td>
              <td><%= log.ip %></td>
              <td style="font-variant-numeric:tabular-nums;white-space:nowrap"><%= new Date(log.createdAt).toLocaleString('fr-FR') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>

</main>

<script>
(function () {
  // ── Tab switching ──────────────────────────────────
  var tabBtns = document.querySelectorAll(".admin-tab-btn");
  var tabSections = document.querySelectorAll(".admin-tab-section");

  function activateTab(name) {
    tabBtns.forEach(function(b) { b.classList.toggle("active", b.dataset.tab === name); });
    tabSections.forEach(function(s) { s.hidden = s.dataset.tab !== name; });
    try { history.replaceState(null, "", "#tab-" + name); } catch(_) {}
  }

  tabBtns.forEach(function(btn) {
    btn.addEventListener("click", function() { activateTab(btn.dataset.tab); });
  });

  // Restore tab from URL hash
  var hash = location.hash.replace("#tab-", "");
  if (hash && document.querySelector(".admin-tab-btn[data-tab='" + hash + "']")) {
    activateTab(hash);
  }

  // ── Top 10/20 toggles ────────────────────────────
  document.querySelectorAll(".admin-kpi-limit-toggle").forEach(function(toggle) {
    var tableId = toggle.id.replace("-limit-toggle", "-top-table");
    var table = document.getElementById(tableId);
    toggle.addEventListener("click", function(e) {
      var btn = e.target.closest("button[data-limit]");
      if (!btn || !table) return;
      var limit = Number(btn.dataset.limit);
      toggle.querySelectorAll("button").forEach(function(b) { b.classList.toggle("active", b === btn); });
      table.querySelectorAll("tr[data-rank]").forEach(function(row) {
        row.classList.toggle("admin-rank-hidden", Number(row.dataset.rank) > limit);
      });
    });
  });

  // ── Wiki featured toggle ──────────────────────────
  document.querySelectorAll("#wiki-featured-list .admin-featured-toggle").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var id = btn.closest("[data-id]").dataset.id;
      fetch("/admin/wiki-featured/" + id, { method: "POST" })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.ok) return;
          btn.classList.toggle("active", d.featured);
          btn.innerHTML = d.featured ? "&#9733;" : "&#9734;";
          btn.title = d.featured ? "Retirer" : "Mettre en avant";
        });
    });
  });

  // ── Gallery featured toggle ───────────────────────
  document.querySelectorAll("#admin-gallery-grid .admin-gallery-feat-btn").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var id = btn.closest("[data-id]").dataset.id;
      fetch("/admin/gallery-featured/" + id, { method: "POST" })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.ok) return;
          btn.classList.toggle("active", d.featured);
          btn.innerHTML = d.featured ? "&#9733;" : "&#9734;";
          btn.title = d.featured ? "Retirer" : "Mettre en avant";
        });
    });
  });
  // ── Bibliothèque utilisateurs : modals ──────────────────────────────────
  (function () {
    function openModal(id) { document.getElementById(id).hidden = false; }
    function closeModal(id) { document.getElementById(id).hidden = true; }

    // Créer
    document.getElementById("admin-create-btn").addEventListener("click", function () {
      openModal("admin-create-modal");
    });
    document.getElementById("admin-create-modal-close").addEventListener("click", function () {
      closeModal("admin-create-modal");
    });
    document.getElementById("admin-create-modal").addEventListener("click", function (e) {
      if (e.target === this) closeModal("admin-create-modal");
    });

    // Fermer edit
    document.getElementById("admin-edit-modal-close").addEventListener("click", function () {
      closeModal("admin-edit-modal");
    });
    document.getElementById("admin-edit-modal").addEventListener("click", function (e) {
      if (e.target === this) closeModal("admin-edit-modal");
    });

    // Fermer pwd
    document.getElementById("admin-pwd-modal-close").addEventListener("click", function () {
      closeModal("admin-pwd-modal");
    });
    document.getElementById("admin-pwd-modal").addEventListener("click", function (e) {
      if (e.target === this) closeModal("admin-pwd-modal");
    });

    // Boutons "Modifier" dans le menu contextuel
    document.querySelectorAll("[data-edit-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.dataset.editId;
        document.getElementById("admin-edit-form").action = "/admin/profils/" + id + "/edit";
        document.getElementById("edit-nom").value = btn.dataset.editNom || "";
        var roleSelect = document.getElementById("edit-role");
        roleSelect.value = btn.dataset.editRole || "normal";
        roleSelect.disabled = btn.dataset.self === "1";
        document.getElementById("edit-sexe").value = btn.dataset.editSexe || "";
        document.getElementById("edit-birth-year").value = btn.dataset.editBirthYear || "";
        document.getElementById("edit-orientation").value = btn.dataset.editOrientation || "";
        document.getElementById("edit-email").value = btn.dataset.editEmail || "";
        openModal("admin-edit-modal");
      });
    });

    // Boutons "Réinit. MDP"
    document.querySelectorAll("[data-pwd-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.dataset.pwdId;
        document.getElementById("admin-pwd-form").action = "/admin/profils/" + id + "/password";
        document.getElementById("admin-pwd-modal-title").textContent = "MDP : " + btn.dataset.pwdName;
        openModal("admin-pwd-modal");
      });
    });

    // Boutons "Supprimer"
    document.querySelectorAll("[data-del-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var name = btn.dataset.delName;
        if (!confirm("Supprimer " + name + " ? Cette action est irréversible.")) return;
        document.getElementById("admin-del-form").action = "/admin/profils/" + btn.dataset.delId + "/delete";
        document.getElementById("admin-del-form").submit();
      });
    });

    // Clic sur la carte utilisateur → page dédiée (plus de popup)
    document.querySelectorAll("[data-profile-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        window.location.href = "/admin/utilisateur/" + btn.dataset.profileId;
      });
    });
  })();
})();
</script>
<%- include('partials/foot') %>
