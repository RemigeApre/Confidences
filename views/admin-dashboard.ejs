<%- include('partials/head', { title: 'Admin', extraCss: ['admin.css'] }) %>

<%- include('partials/admin-nav') %>

<main class="admin-main">

  <%# ═══════════════════════════════════════════════
      TAB : UTILISATEURS
  ═══════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="utilisateurs">

    <% if (locals.adminError) { %>
      <p class="admin-error-msg"><%= adminError %></p>
    <% } %>

    <%# ── Volet filtres gauche ── %>
    <aside class="adm-uf-panel" id="adm-uf-panel" aria-label="Filtres utilisateurs">

      <div class="adm-uf-hd">
        <span class="adm-uf-hd-title">Utilisateurs</span>
        <span class="adm-uf-hd-count" id="adm-uf-count"></span>
      </div>

      <div class="adm-uf-body">

        <div class="adm-uf-search-wrap">
          <input type="search" class="adm-uf-search" id="adm-uf-search" placeholder="Rechercher&hellip;" autocomplete="off" />
        </div>

        <div class="adm-uf-section">
          <div class="adm-uf-section-label">Type</div>
          <div class="adm-uf-chips" id="adm-uf-role-chips">
            <button type="button" class="adm-uf-chip active" data-role="">Tous</button>
            <button type="button" class="adm-uf-chip" data-role="normal">Membres</button>
            <button type="button" class="adm-uf-chip" data-role="admin">Admins</button>
            <button type="button" class="adm-uf-chip" data-role="test">Tests</button>
          </div>
        </div>

        <div class="adm-uf-section">
          <div class="adm-uf-section-label">Trier par</div>
          <select class="adm-uf-select" id="adm-uf-sort">
            <option value="activity">Dernière activité</option>
            <option value="created">Date de création</option>
            <option value="alpha">Ordre alphabétique</option>
          </select>
        </div>

        <div class="adm-uf-bottom">
          <button type="button" class="adm-uf-reset" id="adm-uf-reset">Réinitialiser</button>
        </div>

      </div>

    </aside>

    <%# ── Bibliothèque de cartes ── %>
    <div class="admin-user-lib" id="admin-user-lib">

      <%# Carte "+" — créer un utilisateur %>
      <button type="button" class="admin-utile admin-utile--create" id="admin-create-btn" aria-label="Cr&eacute;er un utilisateur">
        <span class="admin-utile-plus">+</span>
        <span class="admin-utile-create-label">Nouvel utilisateur</span>
      </button>

      <% userStates.forEach(function(state) { %>
        <%
          var uVariant  = state.user.isAdmin ? 'admin' : (state.user.isTest ? 'test' : 'normal');
          var uInitial  = (state.user.displayName || '?').charAt(0).toUpperCase();
          var uLoginMs  = state.user.lastLoginAt ? new Date(state.user.lastLoginAt).getTime() : 0;
          var uActiveMs = state.user.lastActiveAt ? new Date(state.user.lastActiveAt).getTime() : uLoginMs;
          var uStatus = state.user.accountStatus || 'actif';
          var uEffectiveStatus = uStatus;
          if (uStatus === 'actif') {
            var _diff90 = uActiveMs ? (Date.now() - uActiveMs) : Infinity;
            if (_diff90 > 90 * 24 * 3600000) uEffectiveStatus = 'inactif';
          }
          // Anneau vert = actif dans les 15 dernières minutes (lastActiveAt)
          var uLoginActive = uActiveMs && (Date.now() - uActiveMs) < 15 * 60 * 1000;
          // Badge inactivité = basé sur lastActiveAt (ou lastLoginAt en fallback)
          var uLoginLabel = '';
          var uRefMs = uActiveMs || uLoginMs;
          if (uRefMs) {
            var diff  = Date.now() - uRefMs;
            var secs  = Math.floor(diff / 1000);
            var mins  = Math.floor(diff / 60000);
            var hours = Math.floor(diff / 3600000);
            var days  = Math.floor(diff / 86400000);
            var weeks = Math.floor(days / 7);
            if (secs < 60)       uLoginLabel = secs + 's';
            else if (mins < 60)  uLoginLabel = mins + 'min';
            else if (hours < 24) uLoginLabel = hours + 'h';
            else if (days < 7)   uLoginLabel = days + 'j';
            else                 uLoginLabel = weeks + 'sem';
          } else {
            uLoginLabel = 'jamais';
          }
        %>
        <div class="admin-utile admin-utile--<%= uVariant %>"
          data-role="<%= uVariant %>"
          data-name="<%= (state.user.displayName || '').toLowerCase() %>"
          data-last-login="<%= uLoginMs %>"
          data-last-active="<%= uActiveMs %>"
          data-created="<%= state.user.createdAt ? new Date(state.user.createdAt).getTime() : 0 %>"
          data-id="<%= state.user.id %>"
          data-display-name="<%= state.user.displayName %>"
          data-login-label="<%= uLoginLabel %>"
          data-login-active="<%= uLoginActive ? '1' : '0' %>"
          data-thumb="<%= state.profileThumb || '' %>"
          data-color="<%= state.user.profileColor || '#6b7280' %>"
          data-initial="<%= uInitial %>"
          data-quizz="<%= state.completedQuizzes %>"
          data-coffre="<%= state.coffreCount %>"
          data-bd="<%= state.bdNotees %>"
          data-histoires="<%= state.histoiresNotees %>"
          data-codex="<%= state.codexNotes %>"
          data-images="<%= state.imagesNotees %>"
          data-self="<%= state.user.id === currentUser.id ? '1' : '0' %>"
          data-share="<%= state.user.shareNotesWithAdmin ? '1' : '0' %>"
          data-edit-nom="<%= state.user.displayName %>"
          data-edit-role="<%= uVariant %>"
          data-edit-sexe="<%= state.user.sexe || '' %>"
          data-edit-birth-year="<%= state.user.birthYear || '' %>"
          data-edit-orientation="<%= state.user.orientation || '' %>"
          data-edit-email="<%= state.user.email || '' %>"
          data-edit-partner="<%= state.user.partnerId || '' %>"
          data-edit-owned="<%= state.user.canSeeOwned ? '1' : '0' %>"
          data-account-status="<%= state.user.accountStatus || 'actif' %>"
          data-invite-count="<%= state.inviteCount %>">

          <%# Corps de carte %>
          <div class="admin-utile-body">

            <%# Avatar rond centré, anneau vert si actif ; icône si restreint/bloqué %>
            <div class="admin-utile-avatar<%= uLoginActive ? ' admin-utile-avatar--online' : '' %><%= uEffectiveStatus === 'restreint' ? ' admin-utile-avatar--restreint' : (uEffectiveStatus === 'bloque' ? ' admin-utile-avatar--bloque' : '') %>">
              <% if (uEffectiveStatus === 'restreint') { %>
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="32" height="32"><path d="M12 3L2 21h20L12 3z" fill="hsl(35,85%,18%)" stroke="hsl(35,90%,60%)" stroke-width="1.5" stroke-linejoin="round"/><line x1="12" y1="10" x2="12" y2="15" stroke="hsl(35,90%,60%)" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="18" r="1" fill="hsl(35,90%,60%)"/></svg>
              <% } else if (uEffectiveStatus === 'bloque') { %>
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="32" height="32"><circle cx="12" cy="12" r="9" fill="hsl(0,60%,14%)" stroke="hsl(0,80%,58%)" stroke-width="1.5"/><line x1="5" y1="12" x2="19" y2="12" stroke="hsl(0,80%,58%)" stroke-width="2" stroke-linecap="round"/></svg>
              <% } else if (state.profileThumb) { %>
                <img src="<%= state.profileThumb %>" alt="" loading="lazy" />
              <% } else { %>
                <span style="--avatar-color: <%= state.user.profileColor || '#6b7280' %>"><%= uInitial %></span>
              <% } %>
            </div>

            <%# Badge inactivité (affiché uniquement si inactif) %>
            <% if (!uLoginActive) { %>
              <span class="admin-utile-badge admin-utile-badge--inactive"><%= uLoginLabel %></span>
            <% } %>

            <%# Pseudo %>
            <div class="admin-utile-name-btn">
              <%= state.user.displayName %>
            </div>

            <%# Dropdown statut de compte %>
            <div class="admin-utile-status-wrap admin-utile-status-wrap--<%= uEffectiveStatus %>">
              <select class="admin-utile-status-sel"
                data-uid="<%= state.user.id %>" data-prev="<%= uStatus %>">
                <option value="actif"<%= uStatus === 'actif' ? ' selected' : '' %>>Actif</option>
                <option value="inactif"<%= uEffectiveStatus === 'inactif' ? ' selected' : '' %>>Inactif</option>
                <option value="restreint"<%= uStatus === 'restreint' ? ' selected' : '' %>>Restreint</option>
                <option value="bloque"<%= uStatus === 'bloque' ? ' selected' : '' %>>Bloqu&eacute;</option>
              </select>
            </div>

            <%# Grille 2×3 de stats %>
            <div class="admin-utile-stats">
              <div class="admin-utile-stat">
                <span class="aust-key">Coffre</span>
                <span class="aust-val"><%= state.coffreCount %></span>
              </div>
              <div class="admin-utile-stat">
                <span class="aust-key">BD</span>
                <span class="aust-val"><%= state.bdNotees %></span>
              </div>
              <div class="admin-utile-stat">
                <span class="aust-key">Histoires</span>
                <span class="aust-val"><%= state.histoiresNotees %></span>
              </div>
              <div class="admin-utile-stat">
                <span class="aust-key">Quizz</span>
                <span class="aust-val"><%= state.completedQuizzes %></span>
              </div>
              <div class="admin-utile-stat">
                <span class="aust-key">Codex</span>
                <span class="aust-val"><%= state.codexNotes %></span>
              </div>
              <div class="admin-utile-stat">
                <span class="aust-key">Images</span>
                <span class="aust-val"><%= state.imagesNotees %></span>
              </div>
            </div>

            <%# Boutons fantômes pour les actions (ciblés par la popup) %>
            <button type="button" class="admin-utile-menu-item" style="display:none"
              data-edit-id="<%= state.user.id %>"
              data-edit-nom="<%= state.user.displayName %>"
              data-edit-role="<%= uVariant %>"
              data-edit-sexe="<%= state.user.sexe || '' %>"
              data-edit-birth-year="<%= state.user.birthYear || '' %>"
              data-edit-orientation="<%= state.user.orientation || '' %>"
              data-edit-email="<%= state.user.email || '' %>"
              data-edit-partner="<%= state.user.partnerId || '' %>"
              data-edit-owned="<%= state.user.canSeeOwned ? '1' : '0' %>"
              data-self="<%= state.user.id === currentUser.id ? '1' : '0' %>">Modifier</button>
            <button type="button" class="admin-utile-menu-item" style="display:none"
              data-pwd-id="<%= state.user.id %>"
              data-pwd-name="<%= state.user.displayName %>">R&eacute;init. MDP</button>
            <button type="button" class="admin-utile-menu-item" style="display:none"
              data-grant-id="<%= state.user.id %>"
              data-grant-name="<%= state.user.displayName %>">Offrir des lootboxes</button>
            <% if (state.user.id !== currentUser.id) { %>
              <button type="button" class="admin-utile-menu-item admin-utile-menu-item--danger" style="display:none"
                data-del-id="<%= state.user.id %>"
                data-del-name="<%= state.user.displayName %>">Supprimer</button>
            <% } %>

          </div>
        </div>
      <% }) %>
    </div>

    <%# ── Drawer droit : fiche utilisateur ── %>
    <div class="adm-drawer" id="adm-drawer" hidden>
      <div class="adm-drawer-inner">

        <%# En-tête : avatar grand format + pseudo en dessous %>
        <div class="adm-dr-header" id="adm-dr-header">
          <button type="button" class="adm-dr-close" id="adm-drawer-close" aria-label="Fermer">&#215;</button>
          <div class="adm-dr-avatar" id="adm-dr-avatar"></div>
          <div class="adm-dr-identity">
            <span class="adm-dr-name" id="adm-dr-name"></span>
            <span class="adm-dr-role" id="adm-dr-role"></span>
          </div>
        </div>

        <%# Actions principales %>
        <div class="adm-dr-section adm-dr-actions" id="adm-dr-actions">
          <a class="adm-dr-action" id="adm-dr-profile-link" href="#">Profil</a>
          <button type="button" class="adm-dr-action" id="adm-dr-reset-pwd">Mot de passe</button>
          <button type="button" class="adm-dr-action adm-dr-action--warn" id="adm-dr-status-btn">
            <span id="adm-dr-status-label">Restreindre</span>
          </button>
          <button type="button" class="adm-dr-action" id="adm-dr-lootbox">Lootboxes</button>
          <button type="button" class="adm-dr-action adm-dr-action--danger" id="adm-dr-delete" style="display:none">Supprimer</button>
        </div>

        <%# Nombre d'invités %>
        <div class="adm-dr-invite-box" id="adm-dr-invite-box">
          <span class="adm-dr-invite-count" id="adm-dr-invite-count">0</span>
          <span class="adm-dr-invite-label">invit&eacute;(s)</span>
        </div>

        <%# Confirmation suppression %>
        <div class="adm-dr-section adm-dr-confirm" id="adm-dr-confirm" hidden>
          <p class="adm-dr-confirm-msg">Supprimer <strong id="adm-dr-confirm-name"></strong> ?<br><span>Cette action est irréversible.</span></p>
          <div class="adm-dr-confirm-row">
            <button type="button" class="adm-dr-action adm-dr-action--danger" id="adm-dr-delete-confirm">Confirmer</button>
            <button type="button" class="adm-dr-action" id="adm-dr-delete-cancel">Annuler</button>
          </div>
        </div>

        <%# Activité récente %>
        <div class="adm-dr-section">
          <div class="adm-dr-activity" id="adm-dr-activity">
            <div class="adm-dr-act-loading">Chargement…</div>
          </div>
        </div>

        <%# Statut / dernière activité — pied du drawer %>
        <div class="adm-dr-footer" id="adm-dr-footer">
          <div class="adm-dr-footer-label" id="adm-dr-footer-label">Derni&egrave;re activit&eacute;</div>
          <div class="adm-dr-footer-time" id="adm-dr-footer-time">—</div>
          <div class="adm-dr-footer-abs" id="adm-dr-footer-abs"></div>
        </div>

      </div>
    </div>

    <%# ── Modal : créer un utilisateur ── %>
    <div class="admin-modal-overlay" id="admin-create-modal" hidden>
      <div class="admin-modal">
        <button type="button" class="admin-modal-close" id="admin-create-modal-close" aria-label="Fermer">&#215;</button>
        <h2 class="admin-modal-title">Nouvel utilisateur</h2>
        <form method="POST" action="/ponhgup/profils" class="admin-modal-form">
          <label class="admin-modal-field">
            <span>Nom</span>
            <input type="text" name="nom" required autocomplete="off" />
          </label>
          <label class="admin-modal-field">
            <span>Mot de passe</span>
            <input type="password" name="password" required autocomplete="new-password" />
          </label>
          <label class="admin-modal-field">
            <span>R&ocirc;le</span>
            <select name="role" class="admin-modal-select">
              <option value="normal">Normal</option>
              <option value="admin">Admin</option>
              <option value="test">Test</option>
            </select>
          </label>
          <details class="admin-modal-extra-details">
            <summary class="admin-modal-extra-summary">Profil &rsaquo;</summary>
            <div class="admin-modal-extra-body">
              <label class="admin-modal-field">
                <span>Sexe</span>
                <select name="sexe" class="admin-modal-select">
                  <option value="">Non pr&eacute;cis&eacute;</option>
                  <option value="femme">Femme</option>
                  <option value="homme">Homme</option>
                  <option value="autre">Autre</option>
                </select>
              </label>
              <label class="admin-modal-field">
                <span>Ann&eacute;e de naissance</span>
                <input type="number" name="birth_year" min="1940" max="2010" autocomplete="off" />
              </label>
              <label class="admin-modal-field">
                <span>Orientation</span>
                <select name="orientation" class="admin-modal-select">
                  <option value="">Non pr&eacute;cis&eacute;e</option>
                  <option value="hetero">H&eacute;t&eacute;ro</option>
                  <option value="gay">Gay / Lesbienne</option>
                  <option value="bi">Bisexuel·le</option>
                </select>
              </label>
              <label class="admin-modal-field">
                <span>Email</span>
                <input type="email" name="email" autocomplete="off" />
              </label>
            </div>
          </details>
          <button type="submit" class="admin-btn-primary">Cr&eacute;er</button>
        </form>
      </div>
    </div>

    <%# ── Modal : modifier un utilisateur ── %>
    <div class="admin-modal-overlay" id="admin-edit-modal" hidden>
      <div class="admin-modal">
        <button type="button" class="admin-modal-close" id="admin-edit-modal-close" aria-label="Fermer">&#215;</button>
        <h2 class="admin-modal-title">Modifier</h2>
        <form method="POST" id="admin-edit-form" action="/ponhgup/profils/__ID__/edit" class="admin-modal-form">
          <label class="admin-modal-field">
            <span>Nom</span>
            <input type="text" name="nom" id="edit-nom" required autocomplete="off" />
          </label>
          <label class="admin-modal-field">
            <span>R&ocirc;le</span>
            <select name="role" id="edit-role" class="admin-modal-select">
              <option value="normal">Normal</option>
              <option value="admin">Admin</option>
              <option value="test">Test</option>
            </select>
          </label>
          <details class="admin-modal-extra-details" open>
            <summary class="admin-modal-extra-summary">Profil &rsaquo;</summary>
            <div class="admin-modal-extra-body">
              <label class="admin-modal-field">
                <span>Sexe</span>
                <select name="sexe" id="edit-sexe" class="admin-modal-select">
                  <option value="">Non pr&eacute;cis&eacute;</option>
                  <option value="femme">Femme</option>
                  <option value="homme">Homme</option>
                  <option value="autre">Autre</option>
                </select>
              </label>
              <label class="admin-modal-field">
                <span>Ann&eacute;e de naissance</span>
                <input type="number" name="birth_year" id="edit-birth-year" min="1940" max="2010" autocomplete="off" />
              </label>
              <label class="admin-modal-field">
                <span>Orientation</span>
                <select name="orientation" id="edit-orientation" class="admin-modal-select">
                  <option value="">Non pr&eacute;cis&eacute;e</option>
                  <option value="hetero">H&eacute;t&eacute;ro</option>
                  <option value="gay">Gay / Lesbienne</option>
                  <option value="bi">Bisexuel·le</option>
                </select>
              </label>
              <label class="admin-modal-field">
                <span>Email</span>
                <input type="email" name="email" id="edit-email" autocomplete="off" />
              </label>
              <label class="admin-modal-field">
                <span>Partenaire (mode couple)</span>
                <select name="partner_id" id="edit-partner" class="admin-modal-select">
                  <option value="">Aucun</option>
                  <% userStates.forEach(function(s) { %>
                    <option value="<%= s.user.id %>"><%= s.user.displayName %></option>
                  <% }) %>
                </select>
              </label>
              <label class="admin-modal-checkbox-field">
                <input type="checkbox" name="can_see_owned" id="edit-owned" />
                <span>Peut voir &laquo;&nbsp;Nos objets&nbsp;&raquo; (Codex)</span>
              </label>
            </div>
          </details>
          <button type="submit" class="admin-btn-primary">Enregistrer</button>
        </form>
      </div>
    </div>

    <%# ── Modal : réinitialiser mot de passe ── %>
    <div class="admin-modal-overlay" id="admin-pwd-modal" hidden>
      <div class="admin-modal">
        <button type="button" class="admin-modal-close" id="admin-pwd-modal-close" aria-label="Fermer">&#215;</button>
        <h2 class="admin-modal-title" id="admin-pwd-modal-title">R&eacute;init. MDP</h2>
        <form method="POST" id="admin-pwd-form" action="/ponhgup/profils/__ID__/password" class="admin-modal-form">
          <label class="admin-modal-field">
            <span>Nouveau mot de passe</span>
            <input type="password" name="password" required autocomplete="new-password" />
          </label>
          <button type="submit" class="admin-btn-primary">Changer</button>
        </form>
      </div>
    </div>

    <%# ── Formulaire caché : supprimer ── %>
    <form method="POST" id="admin-del-form" action="/ponhgup/profils/__ID__/delete" style="display:none"></form>

    <%# ── Modal : offrir des lootboxes ── %>
    <div class="admin-modal-overlay" id="admin-grant-modal" hidden>
      <div class="admin-modal">
        <button type="button" class="admin-modal-close" id="admin-grant-modal-close" aria-label="Fermer">&#215;</button>
        <h2 class="admin-modal-title" id="admin-grant-modal-title">Offrir des lootboxes</h2>
        <p class="admin-muted" id="admin-grant-modal-to"></p>
        <form id="admin-grant-form" method="POST" action="" class="admin-modal-form">
          <label class="admin-modal-field">
            <span class="admin-modal-label">Nombre de lootboxes</span>
            <input type="number" name="count" id="admin-grant-count" value="1" min="1" max="50" class="admin-modal-input" />
          </label>
          <div class="admin-modal-actions">
            <button type="submit" class="admin-btn-primary">Offrir</button>
          </div>
        </form>
      </div>
    </div>

  </section>

  <%# ═══════════════════════════════════════════════
      TAB : DEMANDES DE COMPTE (France — voir src/geo.js)
  ═══════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="demandes-compte" hidden>
    <% if (!accountRequests.length) { %>
      <p class="admin-muted">Aucune demande de compte pour l'instant.</p>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr><th>Mail</th><th>IP</th><th>Date</th><th>Statut</th><th></th></tr>
        </thead>
        <tbody>
          <% accountRequests.forEach(function(r) { %>
            <tr class="<%= r.contacted ? 'admin-row-done' : '' %>">
              <td><a href="mailto:<%= r.email %>"><%= r.email %></a></td>
              <td><%= r.ip %></td>
              <td><%= new Date(r.createdAt).toLocaleString('fr-FR') %></td>
              <td><%= r.contacted ? 'Contacté' : 'En attente' %></td>
              <td>
                <form method="POST" action="/ponhgup/demande-compte/<%= r.id %>/contacted" style="margin:0">
                  <input type="hidden" name="contacted" value="<%= r.contacted ? '0' : '1' %>" />
                  <button type="submit" class="link-button"><%= r.contacted ? 'Marquer non contacté' : 'Marquer contacté' %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <%# ═══════════════════════════════════════════════
      TAB : WIKI
  ═══════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="wiki" hidden>

    <%# ── KPI ── %>
    <div class="admin-kpi-grid">
      <div class="admin-kpi-card">
        <span class="admin-kpi-value"><%= wikiKPIs.totalViews.toLocaleString('fr-FR') %></span>
        <span class="admin-kpi-label">Vues totales</span>
        <span class="admin-kpi-sub">tous temps</span>
      </div>
      <div class="admin-kpi-card">
