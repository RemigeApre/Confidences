  <section class="admin-tab-section" data-tab="ia" hidden>

    <div class="ia-header">
      <h2 class="admin-section-title" style="margin:0">Profils IA <span class="ia-count">(<%= aiProfiles.length %>)</span></h2>
      <button type="button" class="admin-btn-primary" id="ia-create-btn">+ Nouveau profil</button>
    </div>

    <% if (!aiProfiles.length) { %>
      <p class="admin-muted ia-empty">Aucun profil IA cr&eacute;&eacute; pour l&apos;instant.</p>
    <% } %>

    <div class="ia-grid" id="ia-grid">
      <% aiProfiles.forEach(function(p) { %>
        <div class="ia-card"
          data-profile="<%= encodeURIComponent(JSON.stringify({
            id: p.id,
            name: p.name,
            description: p.description || '',
            age: p.age || '',
            sexe: p.sexe || '',
            phys: p.physical_desc,
            relation_type: p.relation_type || '',
            sex_fantasmes: p.sex_fantasmes || '',
            sex_practiced: p.sex_practiced || '',
            sex_details:   p.sex_details   || '',
            fantasmes: p.fantasmes
          })) %>">
          <div class="ia-card-header">
            <span class="ia-card-name"><%= p.name %></span>
            <div class="ia-card-actions">
              <button type="button" class="ia-action-btn ia-copy-btn" title="Copier le prompt">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
              <button type="button" class="ia-action-btn ia-dl-btn" title="T&eacute;l&eacute;charger en .txt">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </button>
              <button type="button" class="ia-action-btn ia-edit-btn" title="Modifier">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>
              <button type="button" class="ia-action-btn ia-del-btn" title="Supprimer">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
              </button>
            </div>
          </div>
          <div class="ia-card-meta">
            <% if (p.sexe) { %><span class="ia-meta-chip"><%= p.sexe %></span><% } %>
            <% if (p.age)  { %><span class="ia-meta-chip"><%= p.age %> ans</span><% } %>
            <% if (p.relation_type) { %><span class="ia-meta-chip ia-meta-rel"><%= p.relation_type %></span><% } %>
          </div>
          <%
            var physParts = [];
            var ph = p.physical_desc || {};
            if (ph.skin) physParts.push(ph.skin);
            var hairParts = [ph.hair_color, ph.hair_length, ph.hair_style].filter(Boolean);
            if (hairParts.length) physParts.push('cheveux ' + hairParts.join(' '));
            var eyeParts = [ph.eyes_color, ph.eyes_style].filter(Boolean);
            if (eyeParts.length) physParts.push('yeux ' + eyeParts.join(', '));
            if (ph.height) physParts.push(ph.height);
            if (ph.body)   physParts.push(ph.body);
            if (ph.extras) physParts.push(ph.extras);
          %>
          <% if (physParts.length) { %>
            <p class="ia-card-desc ia-card-desc--phys"><%= physParts.join(' · ') %></p>
          <% } %>
          <% if (p.description) { %>
            <p class="ia-card-desc"><%= p.description %></p>
          <% } %>
          <% if (p.fantasmes.length) { %>
            <div class="ia-card-tags">
              <% p.fantasmes.forEach(function(f) { %>
                <span class="ia-tag"><%= f %></span>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>

    <%# ── Modal : créer profil IA ── %>
    <div class="admin-modal-overlay" id="ia-create-modal" hidden>
      <div class="admin-modal ia-modal">
        <button type="button" class="admin-modal-close" id="ia-create-modal-close">&#215;</button>
        <h2 class="admin-modal-title">Nouveau profil IA</h2>
        <form method="POST" action="/ponhgup/ia/create" class="admin-modal-form ia-form">
          <%- include('partials/ia-profile-fields', { fantasyWikiPages: fantasyWikiPages }) %>
          <button type="submit" class="admin-btn-primary">Cr&eacute;er</button>
        </form>
      </div>
    </div>

    <%# ── Modal : éditer profil IA ── %>
    <div class="admin-modal-overlay" id="ia-edit-modal" hidden>
      <div class="admin-modal ia-modal">
        <button type="button" class="admin-modal-close" id="ia-edit-modal-close">&#215;</button>
        <h2 class="admin-modal-title">Modifier le profil</h2>
        <form method="POST" action="/ponhgup/ia/__ID__/update" id="ia-edit-form" class="admin-modal-form ia-form">
          <%- include('partials/ia-profile-fields', { fantasyWikiPages: fantasyWikiPages }) %>
          <button type="submit" class="admin-btn-primary">Enregistrer</button>
        </form>
      </div>
    </div>

    <%# ── Formulaire caché : supprimer IA ── %>
    <form method="POST" id="ia-del-form" action="/ponhgup/ia/__ID__/delete" style="display:none"></form>

  </section>

  <%# ═══════════════════════════════════════════════
      TAB : LOG
  ═══════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="log" hidden>

  <div class="log-layout">

    <%# ── Volet gauche : navigation ── %>
    <nav class="log-sidebar-left">
      <button class="log-nav-btn active" data-log="connexions">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
        Connexions
        <span class="log-nav-count"><%= connectionLogs.length %></span>
      </button>
      <button class="log-nav-btn" data-log="anonymes">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/><line x1="18" y1="8" x2="22" y2="8"/><line x1="20" y1="6" x2="20" y2="10"/></svg>
        Visiteurs anonymes
      </button>
      <a href="/ponhgup/ip-logs" class="log-nav-btn log-nav-btn--link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        IP Logger
      </a>
    </nav>

    <%# ── Zone centrale ── %>
    <div class="log-main">

    <%# ── Panneau connexions ── %>
    <div class="log-panel" id="log-panel-connexions">

      <% if (!connectionLogs.length) { %>
        <p class="admin-muted">Aucune connexion enregistr&eacute;e.</p>
      <% } else { %>
      <%
        function parseBrowser(ua) {
          if (!ua) return '';
          if (/Edg\//.test(ua)) return 'Edge';
          if (/OPR\/|Opera/.test(ua)) return 'Opera';
          if (/Chrome\//.test(ua)) return 'Chrome';
          if (/Firefox\//.test(ua)) return 'Firefox';
          if (/Safari\//.test(ua)) return 'Safari';
          return '';
        }
        function parseOS(ua) {
          if (!ua) return '';
          if (/Windows/.test(ua)) return 'Win';
          if (/Mac OS X/.test(ua)) return 'Mac';
          if (/Android/.test(ua)) return 'Android';
          if (/iPhone|iPad/.test(ua)) return 'iOS';
          if (/Linux/.test(ua)) return 'Linux';
          return '';
        }
        function formatIP(ip) {
          if (!ip) return '—';
          if (/^(::1$|::ffff:127\.|127\.|192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.)/i.test(ip)) return 'Réseau local';
          return ip;
        }
        function formatConnTime(iso) {
          var ms = new Date(iso).getTime();
          var diff = Date.now() - ms;
          var rel = '';
          if (diff < 60000) rel = 'à l\'instant';
          else if (diff < 3600000) rel = Math.floor(diff/60000) + 'min';
          else if (diff < 86400000) rel = Math.floor(diff/3600000) + 'h';
          else if (diff < 604800000) rel = Math.floor(diff/86400000) + 'j';
          else rel = Math.floor(diff/604800000) + 'sem';
          var dt = new Date(iso);
          var abs = dt.toLocaleString('fr-FR', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
          return { rel: rel, abs: abs };
        }
        var now = Date.now();
      %>
      <div class="log-conn-list">
        <% connectionLogs.forEach(function(log) {
          var t = formatConnTime(log.createdAt);
          var isRecent = (now - new Date(log.createdAt).getTime()) < 3600000;
          var isToday  = (now - new Date(log.createdAt).getTime()) < 86400000;
          var browser = parseBrowser(log.userAgent);
          var os = parseOS(log.userAgent);
          var ip = formatIP(log.ip);
          var initial = (log.userDisplayName || '?').charAt(0).toUpperCase();
        %>
        <div class="log-conn-card<%= isRecent ? ' log-conn-card--recent' : (isToday ? ' log-conn-card--today' : '') %>">
          <div class="log-conn-avatar"><%= initial %></div>
          <div class="log-conn-info">
            <span class="log-conn-name"><%= log.userDisplayName || 'Compte supprimé' %></span>
            <span class="log-conn-time">
              <span class="log-conn-rel"><%= t.rel %></span>
              <span class="log-conn-abs"><%= t.abs %></span>
            </span>
            <span class="log-conn-meta">
              <%= ip %><% if (browser) { %> &middot; <%= browser %><% } %><% if (os) { %> <%= os %><% } %>
            </span>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>

    </div>

    <%# ── Panneau visiteurs anonymes ── %>
    <div class="log-panel" id="log-panel-anonymes" hidden>

      <div class="log-anon-toolbar">
        <input type="search" class="log-anon-path-filter" id="log-anon-path-filter" placeholder="Filtrer par page&hellip;" autocomplete="off" />
        <button class="log-anon-profiles-btn" id="log-anon-profiles-btn" type="button">Profils visiteurs</button>
      </div>

      <div class="log-anon-table-wrap" id="log-anon-table-wrap">
        <table class="admin-table log-anon-table" id="log-anon-table">
          <thead>
            <tr>
              <th>Page</th>
              <th>Types</th>
              <th>Visiteurs</th>
              <th style="text-align:right">Vues</th>
              <th style="white-space:nowrap">Derni&egrave;re visite</th>
            </tr>
          </thead>
          <tbody id="log-anon-tbody">
            <% (anonStats.rows || []).forEach(function(r) { %>
            <tr class="<%= r.isScan ? 'log-anon-row--scan' : '' %>">
              <td class="log-anon-path">
                <% if (r.isScan) { %><span class="log-anon-scan-badge" title="Chemin suspect (bot/scanner)">&#9888;</span> <% } %>
                <span class="log-anon-label" title="<%= r.path %>"><%= r.label %></span>
                <span class="log-anon-rawpath"><%= r.path %></span>
              </td>
              <td class="log-anon-types">
                <% var t = r.types || {}; %>
                <% if (t.human > 0) { %><span class="log-anon-type-badge log-anon-type-human" title="Humain (<%= t.human %>)">&#129489; <%= t.human %></span><% } %>
                <% if (t.bot_seo > 0) { %><span class="log-anon-type-badge log-anon-type-seo" title="SEO bot (<%= t.bot_seo %>)">&#129302; <%= t.bot_seo %></span><% } %>
                <% if (t.bot_ai > 0) { %><span class="log-anon-type-badge log-anon-type-ai" title="IA bot (<%= t.bot_ai %>)">&#129504; <%= t.bot_ai %></span><% } %>
                <% if (t.bot_sdk > 0) { %><span class="log-anon-type-badge log-anon-type-sdk" title="SDK/prog (<%= t.bot_sdk %>)">&#128230; <%= t.bot_sdk %></span><% } %>
                <% if (t.bot_monitor > 0) { %><span class="log-anon-type-badge log-anon-type-monitor" title="Monitor (<%= t.bot_monitor %>)">&#128270; <%= t.bot_monitor %></span><% } %>
                <% if (t.bot_unknown > 0) { %><span class="log-anon-type-badge log-anon-type-unknown" title="Inconnu (<%= t.bot_unknown %>)">&#10067; <%= t.bot_unknown %></span><% } %>
              </td>
              <td class="log-anon-visitors">
                <% (r.visitor_ids || []).forEach(function(vid) { %>
                  <span class="log-anon-vid" style="background:<%- '#' + vid.slice(0,6) %>" title="Visiteur <%= vid %>"></span>
                <% }); %>
                <% if (r.unique_visitors > (r.visitor_ids||[]).length) { %>
                  <span class="log-anon-vid-more">+<%= r.unique_visitors - (r.visitor_ids||[]).length %></span>
                <% } %>
              </td>
              <td style="text-align:right;font-variant-numeric:tabular-nums"><%= r.views %></td>
              <td class="log-anon-lastseen" style="white-space:nowrap;color:var(--muted)"><%= r.last_seen ? new Date(r.last_seen).toLocaleString('fr-FR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : '&mdash;' %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="log-anon-daily" id="log-anon-daily">
        <h3 class="log-anon-daily-title">Par jour</h3>
        <div class="log-anon-daily-rows" id="log-anon-daily-rows">
          <% (anonStats.daily || []).forEach(function(d) { %>
          <div class="log-anon-day-row">
            <span class="log-anon-day-label"><%= d.day %></span>
            <span class="log-anon-day-val"><%= d.views %> vues</span>
            <span class="log-anon-day-uniq"><%= d.unique_ips %> ip</span>
          </div>
          <% }); %>
        </div>
      </div>

    </div>

    <%# ── Drawer profils visiteurs ── %>
    <div class="log-visitor-drawer" id="log-visitor-drawer" hidden>
      <div class="log-visitor-drawer-header">
        <span class="log-visitor-drawer-title">Profils visiteurs</span>
        <button class="log-visitor-drawer-close" id="log-visitor-drawer-close" type="button" aria-label="Fermer">&#10005;</button>
      </div>
      <div class="log-visitor-drawer-body" id="log-visitor-drawer-body">
        <div class="log-visitor-list" id="log-visitor-list">
          <div style="color:var(--muted);font-size:.8rem">Chargement&hellip;</div>
        </div>
        <div class="log-visitor-profile" id="log-visitor-profile" hidden>
          <button class="log-visitor-back" id="log-visitor-back" type="button">&#8592; Retour</button>
          <div id="log-visitor-profile-content"></div>
        </div>
      </div>
    </div>

    </div><%# /log-main %>

  </div><%# /log-layout %>

  <%# ── Volet droit : contrôles anonymes (fixed hors flux) ── %>
  <aside class="log-sidebar-right" id="log-sidebar-right" hidden>

    <div class="log-sidebar-block">
      <span class="log-sidebar-label">P&eacute;riode</span>
      <div class="log-anon-period" id="log-anon-period">
        <button class="log-anon-period-btn active" data-days="7">7 j</button>
        <button class="log-anon-period-btn" data-days="30">30 j</button>
        <button class="log-anon-period-btn" data-days="90">90 j</button>
      </div>
    </div>

    <div class="log-sidebar-block">
      <span class="log-sidebar-label">R&eacute;sum&eacute;</span>
      <div class="log-anon-summary" id="log-anon-summary"></div>
    </div>

    <div class="log-sidebar-block">
      <span class="log-sidebar-label">Filtrer</span>
      <input type="search" class="log-anon-search" id="log-anon-search" placeholder="Page&hellip;" autocomplete="off" />
    </div>

  </aside>

  <script nonce="<%= nonce %>">
  (function() {
    var SS_KEY = 'log-active-panel';
    var navBtns      = document.querySelectorAll('.log-nav-btn');
    var panels       = document.querySelectorAll('.log-panel');
    var sidebarRight = document.getElementById('log-sidebar-right');

    function activatePanel(name) {
      navBtns.forEach(function(b) { b.classList.toggle('active', b.dataset.log === name); });
      panels.forEach(function(p) { p.hidden = p.id !== 'log-panel-' + name; });
      if (sidebarRight) sidebarRight.hidden = (name !== 'anonymes');
      try { sessionStorage.setItem(SS_KEY, name); } catch(_) {}
    }

    // Restaurer le panneau actif
    var saved = '';
    try { saved = sessionStorage.getItem(SS_KEY) || ''; } catch(_) {}
    if (saved === 'anonymes') activatePanel('anonymes');

    navBtns.forEach(function(btn) {
      btn.addEventListener('click', function() { activatePanel(btn.dataset.log); });
    });

    // Filtre anonymes
    var periodBtns = document.querySelectorAll('.log-anon-period-btn');
    var searchInp  = document.getElementById('log-anon-search');
    var tbody      = document.getElementById('log-anon-tbody');
    var dailyRows  = document.getElementById('log-anon-daily-rows');
    var summary    = document.getElementById('log-anon-summary');
    var currentDays = 7;
    var searchTimer = null;

    function formatAnonTime(iso) {
      if (!iso) return '—';
      return new Date(iso).toLocaleString('fr-FR', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
    }

    var pathFilter    = document.getElementById('log-anon-path-filter');
    var profilesBtn   = document.getElementById('log-anon-profiles-btn');
    var drawer        = document.getElementById('log-visitor-drawer');
    var drawerClose   = document.getElementById('log-visitor-drawer-close');
    var visitorList   = document.getElementById('log-visitor-list');
    var visitorProfile = document.getElementById('log-visitor-profile');
    var visitorBack   = document.getElementById('log-visitor-back');
    var profileContent = document.getElementById('log-visitor-profile-content');

    // -- Type badges helpers --
    var TYPE_INFO = {
      human:       { icon: '\u{1F9D1}', label: 'Humain',   cls: 'log-anon-type-human'   },
      bot_seo:     { icon: '\u{1F916}', label: 'SEO',      cls: 'log-anon-type-seo'     },
      bot_ai:      { icon: '\u{1F9E0}', label: 'IA',       cls: 'log-anon-type-ai'      },
      bot_sdk:     { icon: '\u{1F4E6}', label: 'SDK',      cls: 'log-anon-type-sdk'     },
      bot_monitor: { icon: '\u{1F50D}', label: 'Monitor',  cls: 'log-anon-type-monitor' },
      bot_unknown: { icon: '?',         label: 'Inconnu',  cls: 'log-anon-type-unknown' },
    };

    function makeTypeBadges(types) {
      var frag = document.createDocumentFragment();
      var order = ['human', 'bot_seo', 'bot_ai', 'bot_sdk', 'bot_monitor', 'bot_unknown'];
      order.forEach(function(k) {
        var n = (types && types[k]) || 0;
        if (!n) return;
        var info = TYPE_INFO[k] || { icon: '?', label: k, cls: 'log-anon-type-unknown' };
        var sp = document.createElement('span');
        sp.className = 'log-anon-type-badge ' + info.cls;
        sp.title = info.label + ' (' + n + ')';
        sp.textContent = info.icon + ' ' + n;
        frag.appendChild(sp);
      });
      return frag;
    }

    function visitorBadgesNode(row) {
      var frag = document.createDocumentFragment();
      var ids = row.visitor_ids || [];
      ids.forEach(function(vid) {
        var sp = document.createElement('span');
        sp.className = 'log-anon-vid';
        sp.style.background = '#' + vid.slice(0, 6);
        sp.title = 'Visiteur ' + vid;
        frag.appendChild(sp);
      });
      var extra = (row.unique_visitors || 0) - ids.length;
      if (extra > 0) {
        var sp2 = document.createElement('span');
        sp2.className = 'log-anon-vid-more';
        sp2.textContent = '+' + extra;
        frag.appendChild(sp2);
      }
      return frag;
    }

    function loadAnon() {
      var q = searchInp ? searchInp.value.trim() : '';
      var pathQ = pathFilter ? pathFilter.value.trim() : '';
      var combined = q || pathQ;
      fetch('/ponhgup/log/anon?days=' + currentDays + '&path=' + encodeURIComponent(combined))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          // Table (safe DOM, no innerHTML with data)
          tbody.textContent = '';
          var rows = data.rows || [];
          if (!rows.length) {
            var tr = document.createElement('tr');
            var td = document.createElement('td');
            td.colSpan = 5;
            td.style.cssText = 'color:var(--muted);text-align:center';
            td.textContent = 'Aucune donnée';
            tr.appendChild(td);
            tbody.appendChild(tr);
          }
          rows.forEach(function(r) {
            var tr = document.createElement('tr');
            if (r.isScan) tr.className = 'log-anon-row--scan';
            // Path cell
            var tdPath = document.createElement('td');
            tdPath.className = 'log-anon-path';
            if (r.isScan) {
              var badge = document.createElement('span');
              badge.className = 'log-anon-scan-badge';
              badge.title = 'Chemin suspect';
              badge.textContent = '\u26A0';
              tdPath.appendChild(badge);
              tdPath.appendChild(document.createTextNode(' '));
            }
            var lbl = document.createElement('span');
            lbl.className = 'log-anon-label';
            lbl.title = r.path;
            lbl.textContent = r.label;
            tdPath.appendChild(lbl);
            var raw = document.createElement('span');
            raw.className = 'log-anon-rawpath';
            raw.textContent = r.path;
            tdPath.appendChild(raw);
            tr.appendChild(tdPath);
            // Types cell
            var tdTypes = document.createElement('td');
            tdTypes.className = 'log-anon-types';
            tdTypes.appendChild(makeTypeBadges(r.types));
            tr.appendChild(tdTypes);
            // Visitors cell
            var tdVis = document.createElement('td');
            tdVis.className = 'log-anon-visitors';
            tdVis.appendChild(visitorBadgesNode(r));
            tr.appendChild(tdVis);
            // Views cell
            var tdViews = document.createElement('td');
            tdViews.style.cssText = 'text-align:right;font-variant-numeric:tabular-nums';
            tdViews.textContent = r.views;
            tr.appendChild(tdViews);
            // Last seen cell
            var tdLast = document.createElement('td');
            tdLast.style.cssText = 'white-space:nowrap;color:var(--muted)';
            tdLast.textContent = formatAnonTime(r.last_seen);
            tr.appendChild(tdLast);
            tbody.appendChild(tr);
          });
          // Daily
          dailyRows.textContent = '';
          var drows = data.daily || [];
          if (!drows.length) {
            var div0 = document.createElement('div');
            div0.style.cssText = 'color:var(--muted);font-size:.8rem';
            div0.textContent = 'Aucune donnée';
            dailyRows.appendChild(div0);
          }
          drows.forEach(function(d) {
            var div = document.createElement('div');
            div.className = 'log-anon-day-row';
            var s1 = document.createElement('span'); s1.className = 'log-anon-day-label'; s1.textContent = d.day;
            var s2 = document.createElement('span'); s2.className = 'log-anon-day-val';   s2.textContent = d.views + ' vues';
            var s3 = document.createElement('span'); s3.className = 'log-anon-day-uniq';  s3.textContent = d.unique_ips + ' ip';
            div.appendChild(s1); div.appendChild(s2); div.appendChild(s3);
            dailyRows.appendChild(div);
          });
          // Summary
          var totalViews = rows.reduce(function(s, r) { return s + r.views; }, 0);
          var maxUniq = rows.reduce(function(s, r) { return Math.max(s, r.unique_ips); }, 0);
          summary.textContent = '';
          var kpis = [
            [totalViews, 'vues'],
            [rows.length, 'pages'],
            [maxUniq, 'IP max/page'],
          ];
          kpis.forEach(function(k) {
            var sp = document.createElement('span'); sp.className = 'log-anon-kpi';
            var strong = document.createElement('strong'); strong.textContent = k[0];
            sp.appendChild(strong);
            sp.appendChild(document.createTextNode(' ' + k[1]));
            summary.appendChild(sp);
          });
        }).catch(function() {});
    }

    // -- Drawer: visitor profiles --
    function typeLabel(t) {
      return (TYPE_INFO[t] || { icon: '?', label: t || 'inconnu' }).icon + ' ' + ((TYPE_INFO[t] || {}).label || t || 'inconnu');
    }

    function loadVisitorList() {
      visitorList.textContent = '';
      var loading = document.createElement('div');
      loading.style.cssText = 'color:var(--muted);font-size:.8rem';
      loading.textContent = 'Chargement\u2026';
      visitorList.appendChild(loading);
      fetch('/ponhgup/log/visitors?days=30')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          visitorList.textContent = '';
          var visitors = (data && data.visitors) || [];
          if (!visitors.length) {
            var empty = document.createElement('div');
            empty.style.cssText = 'color:var(--muted);font-size:.8rem';
            empty.textContent = 'Aucun visiteur';
            visitorList.appendChild(empty);
            return;
          }
          visitors.forEach(function(v) {
            var row = document.createElement('div');
            row.className = 'log-visitor-row';
            row.setAttribute('role', 'button');
            row.tabIndex = 0;
            // Visitor ID (truncated)
            var idSpan = document.createElement('span');
            idSpan.className = 'log-visitor-id';
            idSpan.textContent = (v.visitorId || '').slice(0, 8);
            row.appendChild(idSpan);
            // Type badge
            var typSpan = document.createElement('span');
            typSpan.className = 'log-anon-type-badge ' + ((TYPE_INFO[v.visitorType] || {}).cls || 'log-anon-type-unknown');
            typSpan.textContent = typeLabel(v.visitorType);
            row.appendChild(typSpan);
            // Pages count
            var pagesSpan = document.createElement('span');
            pagesSpan.className = 'log-visitor-pages';
            pagesSpan.textContent = v.totalPages + ' p.';
            row.appendChild(pagesSpan);
            // Last seen
            var lastSpan = document.createElement('span');
            lastSpan.className = 'log-visitor-last';
            lastSpan.textContent = formatAnonTime(v.lastSeen);
            row.appendChild(lastSpan);
            function openProfile() { loadVisitorProfile(v.visitorId); }
            row.addEventListener('click', openProfile);
            row.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') openProfile(); });
            visitorList.appendChild(row);
          });
        }).catch(function() {
          visitorList.textContent = '';
          var err = document.createElement('div');
          err.style.cssText = 'color:var(--muted);font-size:.8rem';
          err.textContent = 'Erreur de chargement';
          visitorList.appendChild(err);
        });
    }

    function loadVisitorProfile(visitorId) {
      visitorList.hidden = true;
      visitorProfile.hidden = false;
      profileContent.textContent = '';
      var loading = document.createElement('div');
      loading.style.cssText = 'color:var(--muted);font-size:.8rem';
      loading.textContent = 'Chargement\u2026';
      profileContent.appendChild(loading);
      fetch('/ponhgup/log/visitor/' + encodeURIComponent(visitorId))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          profileContent.textContent = '';
          if (data.error) {
            var err = document.createElement('div');
            err.style.cssText = 'color:var(--muted);font-size:.8rem';
            err.textContent = 'Visiteur introuvable';
            profileContent.appendChild(err);
            return;
          }
          // Header
          var h = document.createElement('div');
          h.className = 'log-visitor-profile-header';
          var idEl = document.createElement('span');
          idEl.className = 'log-visitor-profile-id';
          idEl.textContent = 'ID: ' + data.visitorId;
          h.appendChild(idEl);
          var meta = document.createElement('div');
          meta.className = 'log-visitor-profile-meta';
          meta.textContent = data.totalPages + ' pages, ' + data.uniquePages + ' uniques';
          h.appendChild(meta);
          if (data.userAgent) {
            var ua = document.createElement('div');
            ua.className = 'log-visitor-profile-ua';
            ua.textContent = data.userAgent;
            h.appendChild(ua);
          }
          profileContent.appendChild(h);
          // Timeline
          var tl = document.createElement('div');
          tl.className = 'log-visitor-timeline';
          (data.visits || []).forEach(function(v) {
            var item = document.createElement('div');
            item.className = 'log-visitor-tl-item';
            var time = document.createElement('span');
            time.className = 'log-visitor-tl-time';
            time.textContent = formatAnonTime(v.created_at);
            var pg = document.createElement('span');
            pg.className = 'log-visitor-tl-path';
            pg.textContent = v.path;
            var typBadge = document.createElement('span');
            typBadge.className = 'log-anon-type-badge ' + ((TYPE_INFO[v.visitor_type] || {}).cls || 'log-anon-type-unknown');
            typBadge.textContent = (TYPE_INFO[v.visitor_type] || { icon: '?' }).icon;
            item.appendChild(time);
            item.appendChild(pg);
            item.appendChild(typBadge);
            tl.appendChild(item);
          });
          profileContent.appendChild(tl);
        }).catch(function() {
          profileContent.textContent = '';
          var err = document.createElement('div');
          err.style.cssText = 'color:var(--muted);font-size:.8rem';
          err.textContent = 'Erreur de chargement';
          profileContent.appendChild(err);
        });
    }

    if (profilesBtn) {
      profilesBtn.addEventListener('click', function() {
        if (drawer) {
          drawer.hidden = false;
          visitorList.hidden = false;
          visitorProfile.hidden = true;
          loadVisitorList();
        }
      });
    }
    if (drawerClose) {
      drawerClose.addEventListener('click', function() { if (drawer) drawer.hidden = true; });
    }
    if (visitorBack) {
      visitorBack.addEventListener('click', function() {
        visitorList.hidden = false;
        visitorProfile.hidden = true;
      });
    }

    // Path filter (client-side, live filtering of existing rows)
    if (pathFilter) {
      pathFilter.addEventListener('input', function() {
        var val = pathFilter.value.trim().toLowerCase();
        var rows = tbody.querySelectorAll('tr');
        rows.forEach(function(tr) {
          var rawPath = tr.querySelector('.log-anon-rawpath');
          if (!rawPath) { tr.hidden = false; return; }
          tr.hidden = val !== '' && rawPath.textContent.toLowerCase().indexOf(val) === -1;
        });
      });
    }

    periodBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        periodBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentDays = parseInt(btn.dataset.days);
        loadAnon();
      });
    });

    if (searchInp) {
      searchInp.addEventListener('input', function() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(loadAnon, 350);
      });
    }
  })();
  </script>

  </section>

  <%# ═══════════════════════════════════════════════
      TAB : CHANGELOG
  ════════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="changelog" hidden>

    <div class="cl-layout">

      <%# ── Formulaire nouveau changelog ── %>
      <div class="cl-new-block">
        <h3 class="cl-block-title">Nouvelle entrée</h3>
        <form method="POST" action="/ponhgup/changelogs" class="cl-form">
          <input type="text" name="title" placeholder="Titre (ex : bêta 1.58 : Profil public)" class="cl-input" required maxlength="200" />
          <div class="cl-form-row">
            <input type="date" name="published_at" value="<%= new Date().toISOString().slice(0,10) %>" class="cl-date" />
            <select name="importance" class="cl-select">
              <option value="0">Normal</option>
              <option value="1">Majeur</option>
              <option value="2">Critique</option>
            </select>
            <button type="submit" class="cl-btn-submit">Publier</button>
          </div>
          <div class="cl-tags-row">
            <label class="cl-tag-check"><input type="checkbox" name="tags" value="nouveaute"> Nouveauté</label>
            <label class="cl-tag-check"><input type="checkbox" name="tags" value="fonctionnalite"> Fonctionnalité</label>
            <label class="cl-tag-check"><input type="checkbox" name="tags" value="structure"> Structure</label>
            <label class="cl-tag-check"><input type="checkbox" name="tags" value="securite"> Sécurité</label>
          </div>
          <textarea name="body" placeholder="Contenu de la note (texte brut, les sauts de ligne sont respectés)" class="cl-textarea" rows="6"></textarea>
        </form>
      </div>

      <%# ── Liste des entrées existantes ── %>
      <div class="cl-list-block">
        <h3 class="cl-block-title">Entrées publiées <span class="cl-count"><%= changelogs.length %></span></h3>
        <% if (!changelogs.length) { %>
          <p class="admin-muted">Aucune entr&eacute;e pour l&rsquo;instant.</p>
        <% } else { %>
          <div class="cl-list">
            <% changelogs.forEach(function(cl) { %>
              <%
                var imp = cl.importance || 0;
                var impLabel = ['Normal','Majeur','Critique'][imp] || 'Normal';
                var impClass = ['','cl-imp--major','cl-imp--crit'][imp] || '';
              %>
              <details class="cl-entry <%= impClass %>">
                <summary class="cl-entry-summary">
                  <span class="cl-entry-date"><%= cl.published_at.slice(0,10) %></span>
                  <% if (imp > 0) { %><span class="cl-imp-dot cl-imp-dot--<%= imp %>"></span><% } %>
                  <span class="cl-entry-title"><%= cl.title %></span>
                  <svg class="cl-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="cl-entry-edit">
                  <form method="POST" action="/ponhgup/changelogs/<%= cl.id %>/edit" class="cl-form">
                    <input type="text" name="title" value="<%= cl.title %>" class="cl-input" required maxlength="200" />
                    <div class="cl-form-row">
                      <input type="date" name="published_at" value="<%= cl.published_at.slice(0,10) %>" class="cl-date" />
                      <select name="importance" class="cl-select">
                        <option value="0"<%= imp===0?' selected':'' %>>Normal</option>
                        <option value="1"<%= imp===1?' selected':'' %>>Majeur</option>
                        <option value="2"<%= imp===2?' selected':'' %>>Critique</option>
                      </select>
                      <button type="submit" class="cl-btn-submit cl-btn-submit--edit">Enregistrer</button>
                    </div>
                    <% var clTags = cl.tags || []; %>
                    <div class="cl-tags-row">
                      <label class="cl-tag-check"><input type="checkbox" name="tags" value="nouveaute"<%= clTags.includes('nouveaute')?' checked':'' %>> Nouveauté</label>
                      <label class="cl-tag-check"><input type="checkbox" name="tags" value="fonctionnalite"<%= clTags.includes('fonctionnalite')?' checked':'' %>> Fonctionnalité</label>
                      <label class="cl-tag-check"><input type="checkbox" name="tags" value="structure"<%= clTags.includes('structure')?' checked':'' %>> Structure</label>
                      <label class="cl-tag-check"><input type="checkbox" name="tags" value="securite"<%= clTags.includes('securite')?' checked':'' %>> Sécurité</label>
                    </div>
                    <textarea name="body" class="cl-textarea" rows="6"><%= cl.body %></textarea>
                  </form>
                  <form method="POST" action="/ponhgup/changelogs/<%= cl.id %>/delete" class="cl-delete-form" onsubmit="return confirm('Supprimer cette entrée ?')">
                    <button type="submit" class="cl-btn-delete">Supprimer</button>
                  </form>
                </div>
              </details>
            <% }); %>
          </div>
        <% } %>
      </div>

    </div>

  </section>

  <%# ═══════════════════════════════════════════════
      TAB : ROADMAP
  ════════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="roadmap" hidden>

    <div class="cl-layout">

      <%# ── Formulaire nouveau roadmap ── %>
      <div class="cl-new-block">
        <h3 class="cl-block-title">Nouvelle entrée</h3>
        <form method="POST" action="/ponhgup/roadmap" class="cl-form">
          <input type="text" name="title" placeholder="Fonctionnalité prévue…" class="cl-input" required maxlength="200" />
          <div class="cl-form-row">
            <select name="importance" class="cl-select">
              <option value="0">Normal</option>
              <option value="1">Priorité</option>
              <option value="2">Urgent</option>
            </select>
            <button type="submit" class="cl-btn-submit">Publier</button>
          </div>
          <div class="cl-tags-row">
            <label class="cl-tag-check"><input type="checkbox" name="tags" value="nouveaute"> Nouveauté</label>
            <label class="cl-tag-check"><input type="checkbox" name="tags" value="fonctionnalite"> Fonctionnalité</label>
            <label class="cl-tag-check"><input type="checkbox" name="tags" value="structure"> Structure</label>
            <label class="cl-tag-check"><input type="checkbox" name="tags" value="securite"> Sécurité</label>
          </div>
          <textarea name="body" placeholder="Description détaillée (optionnel)" class="cl-textarea" rows="4"></textarea>
        </form>
      </div>

      <%# ── Liste des entrées existantes ── %>
      <div class="cl-list-block">
        <h3 class="cl-block-title">Entrées <span class="cl-count"><%= roadmapItems.length %></span></h3>
        <% if (!roadmapItems.length) { %>
          <p class="admin-muted">Aucune entr&eacute;e pour l&rsquo;instant.</p>
        <% } else { %>
          <div class="cl-list">
            <% roadmapItems.forEach(function(item) { %>
              <%
                var rdImp = item.importance || 0;
                var rdImpLabel = ['Normal','Priorité','Urgent'][rdImp] || 'Normal';
                var rdImpClass = ['','cl-imp--major','cl-imp--crit'][rdImp] || '';
              %>
              <details class="cl-entry <%= rdImpClass %>">
                <summary class="cl-entry-summary">
                  <% if (rdImp > 0) { %><span class="cl-imp-dot cl-imp-dot--<%= rdImp %>"></span><% } %>
                  <span class="cl-entry-title"><%= item.title %></span>
                  <span class="cl-entry-date" style="margin-left:auto;margin-right:.5rem"><%= item.vote_count %> vote<%= item.vote_count !== 1 ? 's' : '' %></span>
                  <svg class="cl-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="cl-entry-edit">
                  <form method="POST" action="/ponhgup/roadmap/<%= item.id %>/edit" class="cl-form">
                    <input type="text" name="title" value="<%= item.title %>" class="cl-input" required maxlength="200" />
                    <div class="cl-form-row">
                      <select name="importance" class="cl-select">
                        <option value="0"<%= rdImp===0?' selected':'' %>>Normal</option>
                        <option value="1"<%= rdImp===1?' selected':'' %>>Priorité</option>
                        <option value="2"<%= rdImp===2?' selected':'' %>>Urgent</option>
                      </select>
                      <button type="submit" class="cl-btn-submit cl-btn-submit--edit">Enregistrer</button>
                    </div>
                    <% var rdTags = item.tags || []; %>
                    <div class="cl-tags-row">
                      <label class="cl-tag-check"><input type="checkbox" name="tags" value="nouveaute"<%= rdTags.includes('nouveaute')?' checked':'' %>> Nouveauté</label>
                      <label class="cl-tag-check"><input type="checkbox" name="tags" value="fonctionnalite"<%= rdTags.includes('fonctionnalite')?' checked':'' %>> Fonctionnalité</label>
                      <label class="cl-tag-check"><input type="checkbox" name="tags" value="structure"<%= rdTags.includes('structure')?' checked':'' %>> Structure</label>
                      <label class="cl-tag-check"><input type="checkbox" name="tags" value="securite"<%= rdTags.includes('securite')?' checked':'' %>> Sécurité</label>
                    </div>
                    <textarea name="body" class="cl-textarea" rows="4"><%= item.body %></textarea>
                  </form>
                  <form method="POST" action="/ponhgup/roadmap/<%= item.id %>/delete" class="cl-delete-form" onsubmit="return confirm('Supprimer cette entrée ?')">
                    <button type="submit" class="cl-btn-delete">Supprimer</button>
                  </form>
                </div>
              </details>
            <% }); %>
          </div>
        <% } %>
      </div>

    </div>

  </section>

  <%# ═══════════════════════════════════════════════
      TAB : LOG ADMIN
  ════════════════════════════════════════════════ %>
  <section class="admin-tab-section" data-tab="audit" hidden>
    <h2 class="admin-section-title">Journal admin</h2>
    <% if (!adminAudit || !adminAudit.length) { %>
      <p class="admin-muted">Aucune action enregistr&eacute;e.</p>
    <% } else { %>
      <div class="adm-audit-table-wrap">
        <table class="adm-audit-table">
          <thead><tr><th>Date</th><th>Admin</th><th>Action</th><th>Type</th><th>&Eacute;l&eacute;ment</th></tr></thead>
          <tbody>
            <% adminAudit.forEach(function(row) { %>
              <tr>
                <td class="adm-audit-date"><%= new Date(row.created_at).toLocaleString('fr-FR', { day:'2-digit', month:'2-digit', year:'2-digit', hour:'2-digit', minute:'2-digit' }) %></td>
                <td class="adm-audit-admin"><%= row.admin_name %></td>
                <td class="adm-audit-action adm-audit-action--<%= row.action.split(':')[0] %>"><%= row.action %></td>
                <td class="adm-audit-type"><%= row.entity_type %></td>
                <td class="adm-audit-label"><%= row.entity_label || (row.entity_id ? '#'+row.entity_id : '') %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

</main>

<script nonce="<%= nonce %>">
(function () {
  // ── Top 10/20 toggles ────────────────────────────
  document.querySelectorAll(".admin-kpi-limit-toggle").forEach(function(toggle) {
    var tableId = toggle.id.replace("-limit-toggle", "-top-table");
    var table = document.getElementById(tableId);
    toggle.addEventListener("click", function(e) {
      var btn = e.target.closest("button[data-limit]");
      if (!btn || !table) return;
      var limit = Number(btn.dataset.limit);
      toggle.querySelectorAll("button").forEach(function(b) { b.classList.toggle("active", b === btn); });
      table.querySelectorAll("tr[data-rank]").forEach(function(row) {
        row.classList.toggle("admin-rank-hidden", Number(row.dataset.rank) > limit);
      });
    });
  });

  // ── Wiki featured toggle ──────────────────────────
  document.querySelectorAll("#wiki-featured-list .admin-featured-toggle").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var id = btn.closest("[data-id]").dataset.id;
      fetch("/ponhgup/wiki-featured/" + id, { method: "POST" })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.ok) return;
          btn.classList.toggle("active", d.featured);
          btn.innerHTML = d.featured ? "&#9733;" : "&#9734;";
          btn.title = d.featured ? "Retirer" : "Mettre en avant";
        });
    });
  });

  // ── Gallery featured toggle ───────────────────────
  document.querySelectorAll("#admin-gallery-grid .admin-gallery-feat-btn").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var id = btn.closest("[data-id]").dataset.id;
      fetch("/ponhgup/gallery-featured/" + id, { method: "POST" })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.ok) return;
          btn.classList.toggle("active", d.featured);
          btn.innerHTML = d.featured ? "&#9733;" : "&#9734;";
          btn.title = d.featured ? "Retirer" : "Mettre en avant";
        });
    });
  });
  // ── Bibliothèque utilisateurs : filtres ─────────────────────────────────
  (function () {
    var search    = document.getElementById('adm-uf-search');
    var roleChips = document.querySelectorAll('#adm-uf-role-chips .adm-uf-chip');
    var selSort   = document.getElementById('adm-uf-sort');
    var resetBtn  = document.getElementById('adm-uf-reset');
    var countEl   = document.getElementById('adm-uf-count');
    var lib       = document.getElementById('admin-user-lib');

    function activeRole() {
      var active = document.querySelector('#adm-uf-role-chips .adm-uf-chip.active');
      return active ? active.dataset.role : '';
    }

    function applyFilters() {
      var q    = search.value.trim().toLowerCase();
      var role = activeRole();
      var sort = selSort.value;

      var cards = Array.from(lib.querySelectorAll('.admin-utile[data-role]'));

      cards.forEach(function (c) {
        var nameMatch = !q || c.dataset.name.includes(q);
        var roleMatch = !role || c.dataset.role === role;
        c.hidden = !(nameMatch && roleMatch);
      });

      var visible = cards.filter(function (c) { return !c.hidden; });
      visible.sort(function (a, b) {
        if (sort === 'alpha') return a.dataset.name.localeCompare(b.dataset.name, 'fr');
        if (sort === 'created') return Number(b.dataset.created) - Number(a.dataset.created);
        var la = Number(a.dataset.lastActive), lb = Number(b.dataset.lastActive);
        if (lb === 0 && la === 0) return 0;
        if (lb === 0) return -1;
        if (la === 0) return 1;
        return lb - la;
      });

      var now90 = Date.now() - 90 * 24 * 3600000;
      var active   = visible.filter(function(c) {
        var status = c.dataset.accountStatus || 'actif';
        if (status === 'restreint' || status === 'bloque') return true; // séparés mais pas "inactifs"
        var la = Number(c.dataset.lastActive) || 0;
        return la > now90;
      });
      var inactive = visible.filter(function(c) { return !active.includes(c); });

      /* Supprimer l'éventuel séparateur précédent */
      var oldSep = lib.querySelector('.adm-uf-sep');
      if (oldSep) oldSep.remove();

      active.forEach(function(c) { lib.appendChild(c); });

      if (inactive.length) {
        var sep = document.createElement('div');
        sep.className = 'adm-uf-sep';
        sep.textContent = 'Inactifs (' + inactive.length + ')';
        lib.appendChild(sep);
        inactive.forEach(function(c) { lib.appendChild(c); });
      }

      if (countEl) countEl.textContent = visible.length;
    }

    search.addEventListener('input', applyFilters);
    selSort.addEventListener('change', applyFilters);

    roleChips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        roleChips.forEach(function(c) { c.classList.remove('active'); });
        chip.classList.add('active');
        applyFilters();
      });
    });

    resetBtn.addEventListener('click', function () {
      search.value = '';
      roleChips.forEach(function(c) { c.classList.remove('active'); });
      document.querySelector('#adm-uf-role-chips .adm-uf-chip[data-role=""]').classList.add('active');
      selSort.value = 'activity';
      applyFilters();
    });

    applyFilters();
  })();

  // ── Drawer fiche utilisateur ─────────────────────────────────────────────
  (function () {
    var drawer   = document.getElementById('adm-drawer');
    var closeBtn = document.getElementById('adm-drawer-close');
    var lib      = document.getElementById('admin-user-lib');

    var ROLE_COLORS = {
      admin:  { hd: 'hsl(268,42%,30%)', bd: 'hsl(268,38%,22%)' },
      test:   { hd: 'hsl(25,62%,36%)',  bd: 'hsl(25,55%,26%)' },
      normal: { hd: 'hsl(0,52%,20%)',   bd: 'hsl(0,46%,14%)' },
    };
    var ROLE_LABEL = { admin: 'Admin', test: 'Test', normal: 'Membre' };

    var _currentCard = null;

    function relTime(ms) {
      if (!ms) return 'jamais';
      var diff = Date.now() - ms;
      var s = Math.floor(diff / 1000);
      if (s < 60) return s + 's';
      var m = Math.floor(diff / 60000);
      if (m < 60) return m + 'min';
      var h = Math.floor(diff / 3600000);
      if (h < 24) return h + 'h';
      var d = Math.floor(diff / 86400000);
      if (d < 7) return d + 'j';
      return Math.floor(d / 7) + 'sem';
    }

    function absTime(ms) {
      if (!ms) return '';
      var dt = new Date(ms);
      return dt.toLocaleDateString('fr-FR', { day:'2-digit', month:'long', year:'numeric' })
        + ' à ' + dt.toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' });
    }

    function openDrawer(card) {
      _currentCard = card;
      var d = card.dataset;
      var uid = d.id;
      var role = d.role || 'normal';
      var colors = ROLE_COLORS[role] || ROLE_COLORS.normal;
      var isSelf = d.self === '1';
      var status = d.accountStatus || 'actif';

      // Header couleur rôle
      var hdr = document.getElementById('adm-dr-header');
      hdr.style.background = colors.hd;
      hdr.style.borderBottom = '2px solid ' + colors.bd;

      // Avatar
      var avEl = document.getElementById('adm-dr-avatar');
      if (d.thumb) {
        avEl.innerHTML = '<img src="' + d.thumb + '" alt="" />';
      } else {
        avEl.innerHTML = '<span style="--avatar-color:' + (d.color || '#6b7280') + '">' + (d.initial || '?') + '</span>';
      }

      // Pseudo + rôle
      document.getElementById('adm-dr-name').textContent = d.displayName;
      document.getElementById('adm-dr-role').textContent = ROLE_LABEL[role] || role;

      // Lien profil
      document.getElementById('adm-dr-profile-link').href = '/ponhgup/utilisateur/' + uid;

      // Reset pwd btn
      var resetBtn = document.getElementById('adm-dr-reset-pwd');
      resetBtn.dataset.uid = uid;
      resetBtn.dataset.pwd = '';

      // Lootbox btn
      document.getElementById('adm-dr-lootbox').dataset.grantId = uid;
      document.getElementById('adm-dr-lootbox').dataset.grantName = d.displayName;

      // Invite count
      document.getElementById('adm-dr-invite-count').textContent = d.inviteCount || '0';

      // Status btn
      var statusBtn = document.getElementById('adm-dr-status-btn');
      statusBtn.dataset.uid = uid;
      statusBtn.dataset.status = status;
      var isRestreint = status === 'restreint';
      document.getElementById('adm-dr-status-label').textContent = isRestreint ? 'Lever la restriction' : 'Restreindre le compte';
      statusBtn.className = 'adm-dr-action' + (isRestreint ? '' : ' adm-dr-action--warn');

      // Delete btn
      var delBtn = document.getElementById('adm-dr-delete');
      delBtn.style.display = isSelf ? 'none' : '';
      delBtn.dataset.uid = uid;
      delBtn.dataset.name = d.displayName;

      // Masquer confirm
      document.getElementById('adm-dr-confirm').hidden = true;
      document.getElementById('adm-dr-actions').hidden = false;

      // Footer — initialisation rapide depuis les données de la carte
      var lastMs = Number(d.lastActive) || 0;
      var footer = document.getElementById('adm-dr-footer');
      footer.classList.remove('adm-dr-footer--online');
      document.getElementById('adm-dr-footer-label').textContent = 'Dernière activité';
      document.getElementById('adm-dr-footer-time').textContent = lastMs ? relTime(lastMs) : 'Jamais';
      document.getElementById('adm-dr-footer-abs').textContent = absTime(lastMs);

      // Activité récente — fetch
      var actEl = document.getElementById('adm-dr-activity');
      actEl.innerHTML = '<div class="adm-dr-act-loading">Chargement…</div>';
      fetch('/ponhgup/profils/' + uid + '/recent-activity')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var html = '';
          var lastMs2 = data.lastActiveAt ? new Date(data.lastActiveAt).getTime() : 0;
          var isOnline = lastMs2 && (Date.now() - lastMs2) < 15 * 60 * 1000;
          if (isOnline) {
            // En ligne : le footer prend le relais, l'activité montre juste les pages
            footer.classList.add('adm-dr-footer--online');
            document.getElementById('adm-dr-footer-label').textContent = 'En ligne maintenant';
            document.getElementById('adm-dr-footer-time').textContent = '';
            document.getElementById('adm-dr-footer-abs').textContent = '';
            html += '<div class="adm-dr-act-row adm-dr-act-row--online"><span class="adm-dr-online-dot"></span>En ligne maintenant</div>';
          }
          if (data.recentPages && data.recentPages.length) {
            data.recentPages.forEach(function(p) {
              html += '<div class="adm-dr-act-row"><span class="adm-dr-act-path">' + p.path + '</span><span class="adm-dr-act-time">' + relTime(new Date(p.at).getTime()) + '</span></div>';
            });
          } else if (!isOnline) {
            html += '<div class="adm-dr-act-empty">Aucune activité récente</div>';
          }
          actEl.innerHTML = html;
        })
        .catch(function() {
          actEl.innerHTML = '<div class="adm-dr-act-empty">Erreur de chargement</div>';
        });

      drawer.hidden = false;
      drawer.classList.add('adm-drawer--open');
    }

    function closeDrawer() {
      drawer.classList.remove('adm-drawer--open');
      setTimeout(function() { drawer.hidden = true; }, 220);
    }

    // Changement de statut via le dropdown sur la carte
    lib.addEventListener('change', function (e) {
      var sel = e.target.closest('.admin-utile-status-sel');
      if (!sel) return;
      var uid = sel.dataset.uid;
      var newStatus = sel.value;
      if (!uid || newStatus === 'inactif') { sel.value = sel.dataset.prev || 'actif'; return; }
      fetch('/ponhgup/profils/' + uid + '/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus }),
      }).then(function (r) {
        if (!r.ok) { sel.value = sel.dataset.prev || 'actif'; return; }
        sel.dataset.prev = newStatus;
        var wrap = sel.closest('.admin-utile-status-wrap');
        if (wrap) wrap.className = 'admin-utile-status-wrap admin-utile-status-wrap--' + newStatus;
        sel.closest('.admin-utile[data-role]').dataset.accountStatus = newStatus;
      }).catch(function () { sel.value = sel.dataset.prev || 'actif'; });
    });

    // Clic carte → ouvrir drawer
    lib.addEventListener('click', function (e) {
      if (e.target.closest('.admin-utile-status-wrap')) return;
      var card = e.target.closest('.admin-utile[data-role]');
      if (!card) return;
      openDrawer(card);
    });

    closeBtn.addEventListener('click', closeDrawer);

    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).catch(function(){});
      } else {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
        document.body.appendChild(ta); ta.focus(); ta.select();
        try { document.execCommand('copy'); } catch(_) {}
        document.body.removeChild(ta);
      }
    }

    function genPwd() {
      var chars = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
      var pwd = '';
      for (var i = 0; i < 6; i++) pwd += chars[Math.floor(Math.random() * chars.length)];
      return pwd;
    }

    // Reset MDP
    document.getElementById('adm-dr-reset-pwd').addEventListener('click', function() {
      var btn = this;
      if (btn.dataset.pwd) {
        copyText(btn.dataset.pwd);
        var prev = btn.textContent;
        btn.textContent = 'Copié !';
        setTimeout(function() { btn.textContent = prev; }, 1500);
        return;
      }
      var pwd = genPwd();
      btn.textContent = '…'; btn.disabled = true;
      fetch('/ponhgup/profils/' + btn.dataset.uid + '/reset-pwd', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pwd }),
      }).then(function(r) {
        btn.disabled = false;
        if (!r.ok) { btn.textContent = 'Erreur'; return; }
        btn.dataset.pwd = pwd;
        btn.textContent = pwd;
      }).catch(function() { btn.disabled = false; btn.textContent = 'Erreur'; });
    });

    // Lootboxes
    document.getElementById('adm-dr-lootbox').addEventListener('click', function() {
      var uid = this.dataset.grantId;
      var name = this.dataset.grantName;
      closeDrawer();
      var fakeBtn = document.querySelector('[data-grant-id="' + uid + '"]:not(#adm-dr-lootbox)');
      if (fakeBtn) fakeBtn.click();
    });

    // Statut (restreindre / lever)
    document.getElementById('adm-dr-status-btn').addEventListener('click', function() {
      var uid = this.dataset.uid;
      var current = this.dataset.status;
      var newStatus = current === 'restreint' ? 'actif' : 'restreint';
      fetch('/ponhgup/profils/' + uid + '/status', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus }),
      }).then(function(r) {
        if (!r.ok) return;
        // Mettre à jour la carte
        var card = document.querySelector('.admin-utile[data-id="' + uid + '"]');
        if (card) {
          card.dataset.accountStatus = newStatus;
          var sel = card.querySelector('.admin-utile-status-sel');
          if (sel) { sel.value = newStatus; sel.dataset.prev = newStatus; }
          var wrap = card.querySelector('.admin-utile-status-wrap');
          if (wrap) wrap.className = 'admin-utile-status-wrap admin-utile-status-wrap--' + newStatus;
        }
        // Mettre à jour le bouton
        var btn = document.getElementById('adm-dr-status-btn');
        btn.dataset.status = newStatus;
        var isRestreint = newStatus === 'restreint';
        document.getElementById('adm-dr-status-label').textContent = isRestreint ? 'Lever la restriction' : 'Restreindre le compte';
        btn.className = 'adm-dr-action' + (isRestreint ? '' : ' adm-dr-action--warn');
      });
    });

    // Supprimer — afficher confirmation
    document.getElementById('adm-dr-delete').addEventListener('click', function() {
      document.getElementById('adm-dr-confirm-name').textContent = this.dataset.name;
      document.getElementById('adm-dr-actions').hidden = true;
      document.getElementById('adm-dr-confirm').hidden = false;
    });

    document.getElementById('adm-dr-delete-cancel').addEventListener('click', function() {
      document.getElementById('adm-dr-confirm').hidden = true;
      document.getElementById('adm-dr-actions').hidden = false;
    });

    document.getElementById('adm-dr-delete-confirm').addEventListener('click', function() {
      var uid = document.getElementById('adm-dr-delete').dataset.uid;
      closeDrawer();
      var fakeBtn = document.querySelector('[data-del-id="' + uid + '"]');
      if (fakeBtn) fakeBtn.click();
    });
  })();

  // ── Bibliothèque utilisateurs : modals ──────────────────────────────────
  (function () {
    function openModal(id) { document.getElementById(id).hidden = false; }
    function closeModal(id) { document.getElementById(id).hidden = true; }

    // Créer
    document.getElementById("admin-create-btn").addEventListener("click", function () {
      openModal("admin-create-modal");
    });
    document.getElementById("admin-create-modal-close").addEventListener("click", function () {
      closeModal("admin-create-modal");
    });
    document.getElementById("admin-create-modal").addEventListener("click", function (e) {
      if (e.target === this) closeModal("admin-create-modal");
    });

    // Fermer edit
    document.getElementById("admin-edit-modal-close").addEventListener("click", function () {
      closeModal("admin-edit-modal");
    });
    document.getElementById("admin-edit-modal").addEventListener("click", function (e) {
      if (e.target === this) closeModal("admin-edit-modal");
    });

    // Fermer pwd
    document.getElementById("admin-pwd-modal-close").addEventListener("click", function () {
      closeModal("admin-pwd-modal");
    });
    document.getElementById("admin-pwd-modal").addEventListener("click", function (e) {
      if (e.target === this) closeModal("admin-pwd-modal");
    });

    // Boutons "Modifier" dans le menu contextuel
    document.querySelectorAll("[data-edit-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.dataset.editId;
        document.getElementById("admin-edit-form").action = "/ponhgup/profils/" + id + "/edit";
        document.getElementById("edit-nom").value = btn.dataset.editNom || "";
        var roleSelect = document.getElementById("edit-role");
        roleSelect.value = btn.dataset.editRole || "normal";
        roleSelect.disabled = btn.dataset.self === "1";
        document.getElementById("edit-sexe").value = btn.dataset.editSexe || "";
        document.getElementById("edit-birth-year").value = btn.dataset.editBirthYear || "";
        document.getElementById("edit-orientation").value = btn.dataset.editOrientation || "";
        document.getElementById("edit-email").value = btn.dataset.editEmail || "";
        var partnerSelect = document.getElementById("edit-partner");
        if (partnerSelect) {
          // Un profil ne peut pas être son propre partenaire.
          partnerSelect.querySelectorAll("option").forEach(function (opt) {
            opt.hidden = opt.value === id;
          });
          partnerSelect.value = btn.dataset.editPartner || "";
        }
        document.getElementById("edit-owned").checked = btn.dataset.editOwned === "1";
        openModal("admin-edit-modal");
      });
    });

    // Boutons "Réinit. MDP"
    document.querySelectorAll("[data-pwd-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.dataset.pwdId;
        document.getElementById("admin-pwd-form").action = "/ponhgup/profils/" + id + "/password";
        document.getElementById("admin-pwd-modal-title").textContent = "MDP : " + btn.dataset.pwdName;
        openModal("admin-pwd-modal");
      });
    });

    // Boutons "Offrir des lootboxes"
    document.querySelectorAll("[data-grant-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id   = btn.dataset.grantId;
        var name = btn.dataset.grantName;
        document.getElementById("admin-grant-form").action = "/ponhgup/profils/" + id + "/grant-lootbox";
        document.getElementById("admin-grant-modal-title").textContent = "Offrir des lootboxes";
        document.getElementById("admin-grant-modal-to").textContent = "Destinataire : " + name;
        document.getElementById("admin-grant-count").value = "1";
        openModal("admin-grant-modal");
      });
    });
    document.getElementById("admin-grant-modal-close").addEventListener("click", function () {
      closeModal("admin-grant-modal");
    });
    document.getElementById("admin-grant-modal").addEventListener("click", function (e) {
      if (e.target === this) closeModal("admin-grant-modal");
    });

    // Boutons "Supprimer"
    document.querySelectorAll("[data-del-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var name = btn.dataset.delName;
        if (!confirm("Supprimer " + name + " ? Cette action est irréversible.")) return;
        document.getElementById("admin-del-form").action = "/ponhgup/profils/" + btn.dataset.delId + "/delete";
        document.getElementById("admin-del-form").submit();
      });
    });

    // Clic sur la carte utilisateur → page dédiée (plus de popup)
    document.querySelectorAll("[data-profile-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        window.location.href = "/ponhgup/utilisateur/" + btn.dataset.profileId;
      });
    });
  })();

  // ── Profils IA ───────────────────────────────────────────────────────────
  (function () {
    function openModal(id) { document.getElementById(id).hidden = false; }
    function closeModal(id) { document.getElementById(id).hidden = true; }

    var createModal = document.getElementById("ia-create-modal");
    var editModal   = document.getElementById("ia-edit-modal");
    if (!createModal) return;

    // ── Utilitaires ─────────────────────────────────────────────────────────

    function getProfileData(card) {
      try { return JSON.parse(decodeURIComponent(card.dataset.profile)); } catch(_) { return {}; }
    }

    // Collecte les champs d'un formulaire en un objet profil
    function collectFormData(form) {
      function v(n) { var el = form.querySelector('[name=' + n + ']'); return el ? el.value.trim() : ''; }
      return {
        name:          v('name'),
        age:           v('age'),
        sexe:          v('sexe'),
        relation_type: v('relation_type'),
        description:   v('description'),
        sex_fantasmes: v('sex_fantasmes'),
        sex_practiced: v('sex_practiced'),
        sex_details:   v('sex_details'),
        phys: {
          skin:        v('phys_skin'),
          hair_color:  v('phys_hair_color'),
          hair_length: v('phys_hair_length'),
          hair_style:  v('phys_hair_style'),
          eyes_color:  v('phys_eyes_color'),
          eyes_style:  v('phys_eyes_style'),
          height:      v('phys_height'),
          body:        v('phys_body'),
          extras:      v('phys_extras'),
        },
        fantasmes: Array.from(form.querySelectorAll('[name=fantasmes]:checked')).map(function(c){ return c.value; }),
      };
    }

    // Construit le prompt d'incarnation — l'IA doit devenir ce personnage
    function buildPromptText(d) {
      var paragraphs = [];
      var ph = d.phys || {};

      // ── § 1 : Identité + physique fusionnés ───────────────────────────────
      // "Tu es X" ancre l'identité immédiatement. Le physique suit dans la
      // même respiration pour que l'IA ait une image complète dès la 1re ligne.
      if (d.name) {
        var opening = 'Tu es ' + d.name;
        if (d.sexe && d.age)   opening += ', une ' + d.sexe + ' de ' + d.age + '\u00a0ans';
        else if (d.sexe)       opening += ', ' + d.sexe;
        else if (d.age)        opening += ', ' + d.age + '\u00a0ans';
        opening += '.';

        var physParts = [];
        if (ph.skin) physParts.push('la peau ' + ph.skin);
        var hair = [ph.hair_color, ph.hair_length, ph.hair_style].filter(Boolean);
        if (hair.length) physParts.push('les cheveux ' + hair.join(' '));
        var eyes = [ph.eyes_color, ph.eyes_style].filter(Boolean);
        if (eyes.length) physParts.push('les yeux ' + eyes.join(', '));

        var p1 = [opening];
        if (physParts.length) p1.push('Tu as ' + physParts.join(', ') + '.');
        if (ph.height && ph.body)  p1.push('Tu mesures ' + ph.height + ', silhouette ' + ph.body + '.');
        else if (ph.height)        p1.push('Tu mesures ' + ph.height + '.');
        else if (ph.body)          p1.push('Silhouette ' + ph.body + '.');
        if (ph.extras)             p1.push(ph.extras.replace(/\.?\s*$/, '.'));

        paragraphs.push(p1.join(' '));
      }

      // ── § 2 : Personnalité — texte libre inséré tel quel ──────────────────
      if (d.description) paragraphs.push(d.description.replace(/\.?\s*$/, '.'));

      // ── § 3 : Relation — phrase courte et directe ─────────────────────────
      // Court = l'IA l'intègre sans ambiguïté
      if (d.relation_type) paragraphs.push('Tu es ' + d.relation_type + '.');

      // ── § 4 : Vie sexuelle ────────────────────────────────────────────────
      var sexS = [];
      if (d.sex_practiced) sexS.push('Tu as d\u00e9j\u00e0 v\u00e9cu\u00a0: ' + d.sex_practiced.replace(/\.?\s*$/, '.'));
      if (d.sex_details)   sexS.push(d.sex_details.replace(/\.?\s*$/, '.'));
      if (sexS.length) paragraphs.push(sexS.join(' '));

      // ── § 5 : Fantasmes & désirs ──────────────────────────────────────────
      if (d.fantasmes && d.fantasmes.length) {
        paragraphs.push('Tes fantasmes et d\u00e9sirs\u00a0: ' + d.fantasmes.join(', ') + '.');
      }

      // ── § 6 : Instructions de format — toujours présentes ─────────────────
      paragraphs.push(
        '---\n' +
        'Tes r\u00e9ponses respectent toujours cette structure\u00a0:\n' +
        '\u00ab\u00a0Ce que tu dis \u00e0 voix haute.\u00a0\u00bb\n' +
        'Description de tes actions ou expressions.\n' +
        'Pens\u00e9e intime \u2014 tr\u00e8s rare, uniquement dans les moments forts.\n\n' +
        'Reste concise. Une r\u00e9ponse courte et juste vaut mieux qu\u2019une longue.'
      );

      return paragraphs.join('\n\n');
    }

    // ── Copier / télécharger ─────────────────────────────────────────────────

    function copyText(text, btn) {
      function flashOk() {
        var orig = btn.innerHTML; var origC = btn.style.color;
        btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Copié\u00a0!';
        btn.style.color = 'hsl(140,60%,55%)';
        setTimeout(function () { btn.innerHTML = orig; btn.style.color = origC; }, 2000);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(flashOk).catch(function () { fallbackCopy(text); flashOk(); });
      } else {
        fallbackCopy(text); flashOk();
      }
    }

    function downloadText(text, name) {
      var a = document.createElement('a');
      a.href = 'data:text/plain;charset=utf-8,' + encodeURIComponent(text);
      a.download = (name || 'profil').toLowerCase().replace(/\s+/g, '-') + '.txt';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
    }

    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch(_) {}
      document.body.removeChild(ta);
    }

    // ── Formulaire → remplissage ─────────────────────────────────────────────

    var PHYS_MAP = {
      phys_skin:'skin', phys_hair_color:'hair_color', phys_hair_length:'hair_length',
      phys_hair_style:'hair_style', phys_eyes_color:'eyes_color', phys_eyes_style:'eyes_style',
      phys_height:'height', phys_body:'body', phys_extras:'extras'
    };

    function fillForm(modal, d) {
      function set(n, v) { var el = modal.querySelector('[name=' + n + ']'); if (el) el.value = v || ''; }
      set('name',          d.name);
      set('age',           d.age);
      set('sexe',          d.sexe);
      set('relation_type', d.relation_type);
      set('description',   d.description);
      set('sex_practiced', d.sex_practiced);
      set('sex_details',   d.sex_details);
      var ph = d.phys || {};
      Object.keys(PHYS_MAP).forEach(function(f) {
        set(f, ph[PHYS_MAP[f]]);
      });
      var fantasmes = d.fantasmes || [];
      modal.querySelectorAll('.ia-fant-chk').forEach(function(c) {
        c.checked = fantasmes.indexOf(c.value) !== -1;
      });
    }

    function clearForm(modal) { fillForm(modal, {}); }

    // ── Preview live ─────────────────────────────────────────────────────────

    function initPreview(modal) {
      var form    = modal.querySelector('.ia-form');
      var preview = modal.querySelector('.ia-preview-text');
      var copyBtn = modal.querySelector('.ia-preview-copy-btn');
      var dlBtn   = modal.querySelector('.ia-preview-dl-btn');
      if (!preview) return;

      function refresh() {
        var d = collectFormData(form);
        var text = buildPromptText(d);
        preview.textContent = text || 'Remplis les champs ci-dessus\u2026';
      }

      form.addEventListener('input',  refresh);
      form.addEventListener('change', refresh);
      refresh();

      if (copyBtn) copyBtn.addEventListener('click', function() {
        copyText(preview.textContent, copyBtn);
      });
      if (dlBtn) dlBtn.addEventListener('click', function() {
        var name = form.querySelector('[name=name]').value.trim() || 'profil';
        downloadText(preview.textContent, name);
      });
    }

    // ── Filtres checkboxes Codex ─────────────────────────────────────────────

    document.querySelectorAll('.ia-fant-search').forEach(function(input) {
      input.addEventListener('input', function() {
        var q = input.value.trim().toLowerCase();
        input.closest('.ia-details-body').querySelectorAll('.ia-fant-item').forEach(function(lbl) {
          lbl.classList.toggle('ia-fant-item--hidden', q.length > 0 && lbl.textContent.toLowerCase().indexOf(q) === -1);
        });
      });
    });

    // ── Modal Créer ──────────────────────────────────────────────────────────

    document.getElementById('ia-create-btn').addEventListener('click', function() {
      clearForm(createModal);
      openModal('ia-create-modal');
    });
    document.getElementById('ia-create-modal-close').addEventListener('click', function() { closeModal('ia-create-modal'); });
    createModal.addEventListener('click', function(e) { if (e.target === this) closeModal('ia-create-modal'); });
    initPreview(createModal);

    // ── Modal Éditer ─────────────────────────────────────────────────────────

    document.getElementById('ia-edit-modal-close').addEventListener('click', function() { closeModal('ia-edit-modal'); });
    editModal.addEventListener('click', function(e) { if (e.target === this) closeModal('ia-edit-modal'); });
    initPreview(editModal);

    // ── Cartes ───────────────────────────────────────────────────────────────

    document.querySelectorAll('.ia-card').forEach(function(card) {
      var d = getProfileData(card);

      card.querySelector('.ia-edit-btn').addEventListener('click', function() {
        document.getElementById('ia-edit-form').action = '/ponhgup/ia/' + d.id + '/update';
        fillForm(editModal, d);
        // Force refresh de la preview avec les données chargées
        editModal.querySelector('.ia-form').dispatchEvent(new Event('input'));
        openModal('ia-edit-modal');
      });

      card.querySelector('.ia-del-btn').addEventListener('click', function() {
        if (!confirm('Supprimer le profil \u00ab\u00a0' + d.name + '\u00a0\u00bb ?')) return;
        document.getElementById('ia-del-form').action = '/ponhgup/ia/' + d.id + '/delete';
        document.getElementById('ia-del-form').submit();
      });

      card.querySelector('.ia-copy-btn').addEventListener('click', function() {
        copyText(buildPromptText(d), card.querySelector('.ia-copy-btn'));
      });

      card.querySelector('.ia-dl-btn').addEventListener('click', function() {
        downloadText(buildPromptText(d), d.name);
      });
    });
  })();
})();
</script>
<%- include('partials/foot') %>
