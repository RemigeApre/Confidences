<script nonce="<%= nonce %>">
(function() {
  var searchInput  = document.getElementById('wf-variante-search');
  var hiddenId     = document.getElementById('wf-variante-genre-id');
  var resultsList  = document.getElementById('wf-variante-results');
  var currentLabel = document.getElementById('wf-variante-current');
  var clearBtn     = document.getElementById('wf-variante-clear');
  if (!searchInput || !hiddenId) return;

  var allPages = JSON.parse(document.getElementById('wiki-existing-pages').textContent || '[]');
  var _debounce = null;

  searchInput.addEventListener('input', function() {
    clearTimeout(_debounce);
    var q = searchInput.value.trim().toLowerCase();
    if (!q) { resultsList.style.display = 'none'; return; }
    _debounce = setTimeout(function() {
      var matches = allPages.filter(function(p) {
        return p.title.toLowerCase().includes(q);
      }).slice(0, 12);
      resultsList.innerHTML = '';
      if (!matches.length) { resultsList.style.display = 'none'; return; }
      matches.forEach(function(p) {
        var li = document.createElement('li');
        li.textContent = p.title;
        li.style.cssText = 'padding:.35rem .65rem;cursor:pointer;font-size:.82rem;color:#e2e8f0';
        li.addEventListener('mouseenter', function() { li.style.background = 'rgba(255,255,255,.07)'; });
        li.addEventListener('mouseleave', function() { li.style.background = ''; });
        li.addEventListener('click', function() {
          hiddenId.value = p.id;
          searchInput.value = p.title;
          if (currentLabel) {
            currentLabel.textContent = '';
            var pfx = document.createTextNode('Li\u00e9 \u00e0\u00a0: ');
            var strong = document.createElement('strong');
            strong.textContent = p.title;
            currentLabel.appendChild(pfx);
            currentLabel.appendChild(strong);
          }
          resultsList.style.display = 'none';
        });
        resultsList.appendChild(li);
      });
      resultsList.style.display = 'block';
    }, 200);
  });

  clearBtn && clearBtn.addEventListener('click', function() {
    hiddenId.value = '';
    searchInput.value = '';
    if (currentLabel) currentLabel.textContent = '';
    resultsList.style.display = 'none';
  });

  document.addEventListener('click', function(e) {
    if (!resultsList.contains(e.target) && e.target !== searchInput) {
      resultsList.style.display = 'none';
    }
  });
})();
</script>
<script nonce="<%= nonce %>">
// Widget sources générique — utilisé pour sources, medical_sources, psychologique_sources
function initSourcesWidget(listId, hiddenId) {
  var list   = document.getElementById(listId);
  var hidden = document.getElementById(hiddenId);
  if (!list || !hidden) return;

  var sources = [];
  try { sources = JSON.parse(hidden.value) || []; } catch(_) {}

  function sync() {
    hidden.value = JSON.stringify(sources.map(function(s, i) {
      var row = list.children[i];
      if (!row) return s;
      return {
        label:   row.querySelector('.wf-src-label').value,
        url:     row.querySelector('.wf-src-url').value,
        authors: row.querySelector('.wf-src-authors').value,
        year:    row.querySelector('.wf-src-year').value,
      };
    }));
  }

  function renderRow(s, idx) {
    var row = document.createElement('div');
    row.className = 'wf-src-row';
    row.innerHTML =
      '<div class="wf-src-row-top">' +
        '<input class="wf-src-label wf-sb-input" type="text" placeholder="Titre de la source\u2026" value="' + (s.label||'').replace(/"/g,'&quot;') + '" maxlength="500" />' +
        '<button type="button" class="wf-src-remove" title="Supprimer">\u00d7</button>' +
      '</div>' +
      '<input class="wf-src-url wf-sb-input" type="url" placeholder="URL (optionnel)\u2026" value="' + (s.url||'').replace(/"/g,'&quot;') + '" maxlength="500" />' +
      '<div class="wf-src-row-meta">' +
        '<input class="wf-src-authors wf-sb-input" type="text" placeholder="Auteur(s)\u2026" value="' + (s.authors||'').replace(/"/g,'&quot;') + '" maxlength="300" />' +
        '<input class="wf-src-year wf-sb-input wf-src-year-input" type="text" placeholder="Ann\u00e9e" value="' + (s.year||'').replace(/"/g,'&quot;') + '" maxlength="10" />' +
      '</div>';
    row.querySelector('.wf-src-remove').addEventListener('click', function() {
      sources.splice(idx, 1);
      render();
    });
    ['wf-src-label','wf-src-url','wf-src-authors','wf-src-year'].forEach(function(cls) {
      row.querySelector('.' + cls).addEventListener('input', sync);
    });
    return row;
  }

  function render() {
    list.innerHTML = '';
    sources.forEach(function(s, i) { list.appendChild(renderRow(s, i)); });
    sync();
  }

  // Boutons "Ajouter" : soit le bouton legacy #wf-sources-add, soit les boutons
  // génériques avec data-target correspondant au listId.
  var addBtns = [];
  if (listId === 'wf-sources-list') {
    var legacy = document.getElementById('wf-sources-add');
    if (legacy) addBtns.push(legacy);
  }
  document.querySelectorAll('.wf-sources-add-btn[data-target]').forEach(function(btn) {
    if (listId === 'wf-' + btn.dataset.target + '-sources-list') addBtns.push(btn);
  });
  addBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      sources.push({ label: '', url: '', authors: '', year: '' });
      render();
      var last = list.lastElementChild;
      if (last) last.querySelector('.wf-src-label').focus();
    });
  });

  render();
}

initSourcesWidget('wf-sources-list',            'wf-sources-hidden');
initSourcesWidget('wf-medical-sources-list',     'wf-medical-sources-hidden');
initSourcesWidget('wf-psychologique-sources-list','wf-psychologique-sources-hidden');

// Widget auteurs secondaires
(function() {
  var list   = document.getElementById('wf-authors-secondary-list');
  var addBtn = document.getElementById('wf-authors-add');
  var hidden = document.getElementById('wf-authors-secondary-hidden');
  var dataSrc = document.getElementById('wf-codex-authors-data');
  if (!list || !addBtn || !hidden || !dataSrc) return;

  var allAuthors = [];
  try { allAuthors = JSON.parse(dataSrc.textContent) || []; } catch(_) {}
  var entries = [];
  try { entries = JSON.parse(hidden.value) || []; } catch(_) {}

  var ROLES = [
    { v: 'relecteur',   l: 'Relecteur' },
    { v: 'correcteur',  l: 'Correcteur' },
    { v: 'contributeur',l: 'Contributeur' },
    { v: 'traducteur',  l: 'Traducteur' },
  ];

  function sync() {
    hidden.value = JSON.stringify(entries.map(function(e, i) {
      var row = list.children[i];
      if (!row) return e;
      return {
        slug: row.querySelector('.wf-auth-slug').value,
        role: row.querySelector('.wf-auth-role').value,
      };
    }));
  }

  function renderRow(e, idx) {
    var row = document.createElement('div');
    row.className = 'wf-src-row wf-src-row-meta';
    var selOpts = allAuthors.map(function(a) {
      return '<option value="' + a.slug + '"' + (e.slug === a.slug ? ' selected' : '') + '>' + a.name + '</option>';
    }).join('');
    var roleOpts = ROLES.map(function(r) {
      return '<option value="' + r.v + '"' + (e.role === r.v ? ' selected' : '') + '>' + r.l + '</option>';
    }).join('');
    row.innerHTML =
      '<select class="wf-auth-slug wf-sb-input" style="flex:2"><option value="">-- Auteur --</option>' + selOpts + '</select>' +
      '<select class="wf-auth-role wf-sb-input" style="flex:1">' + roleOpts + '</select>' +
      '<button type="button" class="wf-src-remove" title="Supprimer">\u00d7</button>';
    row.querySelector('.wf-src-remove').addEventListener('click', function() {
      entries.splice(idx, 1); render();
    });
    row.querySelector('.wf-auth-slug').addEventListener('change', sync);
    row.querySelector('.wf-auth-role').addEventListener('change', sync);
    return row;
  }

  function render() {
    list.innerHTML = '';
    entries.forEach(function(e, i) { list.appendChild(renderRow(e, i)); });
    sync();
  }

  addBtn.addEventListener('click', function() {
    entries.push({ slug: '', role: 'contributeur' });
    render();
  });

  render();
})();

// Auto-generate slug from title (only when creating, not editing)
(function() {
  var titleInput = document.querySelector('input[name="title"]');
  var slugInput = document.getElementById('wf-slug-input');
  if (!titleInput || !slugInput) return;
  var isNew = !slugInput.value;
  function toSlug(str) {
    return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
      .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);
  }
  titleInput.addEventListener('input', function() {
    if (!isNew) return;
    slugInput.value = toSlug(titleInput.value);
  });
})();

// Sauvegarde via fetch (feedback explicite)
(function() {
  var form = document.getElementById('wiki-edit-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var saveBtn = form.querySelector('.wf-sb-save-btn') || form.querySelector('[type=submit]');
    if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Enregistrement\u2026'; }
    var fd = new FormData(form);
    fetch(form.action, {
      method: 'POST',
      headers: { 'X-Save-Fetch': '1' },
      body: fd
    }).then(function(r) {
      return r.json().then(function(data) { return { status: r.status, data: data }; });
    }).then(function(res) {
      var data = res.data;
      if (data.ok) {
        if (saveBtn) { saveBtn.textContent = '\u2713 Enregistr\u00e9'; }
        setTimeout(function() {
          if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Enregistrer'; }
        }, 2500);
      } else {
        console.error('[wiki-save] erreur serveur (' + res.status + '):', data.error);
        alert('Erreur sauvegarde : ' + (data.error || 'inconnue'));
        if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Erreur'; }
      }
    }).catch(function(err) {
      if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Erreur r\u00e9seau'; }
      console.error('[wiki-save]', err);
    });
  });
})();

// Accordéons volet gauche : parodie, synonymes
(function() {
  document.querySelectorAll('.wf-sb-toggle[data-target]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      btn.classList.toggle('active');
      var target = document.getElementById(btn.dataset.target);
      if (target) target.hidden = !target.hidden;
    });
  });
})();

// Sous-catégorie dynamique
(function() {
  var subcatData = {
    partenaires: [
      {v:'nombre',l:'Nombre'},{v:'monstre',l:'Monstre'},{v:'animaux',l:'Animal'},
      {v:'fetichisme',l:'F\u00e9tichisme'},{v:'autre',l:'Autre'}
    ],
    fantasmes: <%- JSON.stringify(fantasmesSubs.map(function(s){ return {v:s.key,l:s.label}; })) %>,
    pratique:  <%- JSON.stringify(pratiquesSubs.map(function(s){ return {v:s.key,l:s.label}; })) %>,
    objets:    <%- JSON.stringify(objetsSubs.map(function(s){ return {v:s.key,l:s.label}; })) %>,
    tenues:    <%- JSON.stringify(tenuesSubs.map(function(s){ return {v:s.key,l:s.label}; })) %>
  };
  var currentSubcat = <%- JSON.stringify(pm.sous_cat || '') %>;
  var catSel    = document.getElementById('wiki-category-select');
  var subcatSel = document.getElementById('wf-subcat-select');
  var lieuSel   = document.getElementById('wf-type-lieu-select');
  var wrap      = document.getElementById('wf-sb-subcat-wrap');
  if (!catSel || !subcatSel || !lieuSel || !wrap) return;

  function updateSubcat(cat, keepVal) {
    if (cat === 'lieux') {
      subcatSel.hidden = true;
      lieuSel.hidden = false;
      wrap.hidden = false;
      return;
    }
    lieuSel.hidden = true;
    var opts = subcatData[cat];
    if (!opts || !opts.length) { wrap.hidden = true; return; }
    wrap.hidden = false;
    subcatSel.hidden = false;
    while (subcatSel.options.length > 1) subcatSel.remove(1);
    opts.forEach(function(o) {
      var opt = document.createElement('option');
      opt.value = o.v;
      opt.textContent = o.l;
      if (o.v === keepVal) opt.selected = true;
      subcatSel.appendChild(opt);
    });
  }

  updateSubcat(catSel.value, currentSubcat);
  catSel.addEventListener('change', function() {
    updateSubcat(this.value, '');
  });
})();
</script>
