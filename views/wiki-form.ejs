          <% } %>

        </details><%# /wf-advanced-drawer %>

      </div><%# /wf-sidebar-inner %>
    </aside><%# /wf-sidebar-right %>

  </form>

</main>

<script nonce="<%= nonce %>">
(function () {
  var inp    = document.getElementById("wf-stats-type");
  var fields = document.getElementById("wf-stats-fields");
  var btnP   = document.getElementById("wf-stat-pratique");
  var btnF   = document.getElementById("wf-stat-fantasme");
  if (!inp || !btnP || !btnF || !fields) return;

  var dirBtns = document.querySelectorAll(".wf-stats-dir-pratique");

  function sync() {
    var v = inp.value;
    fields.hidden = !v;
    btnP.classList.toggle("active", v === "pratique");
    btnF.classList.toggle("active", v === "fantasme");
    dirBtns.forEach(function(b) { b.hidden = (v !== "pratique"); });
  }

  btnP.addEventListener("click", function () {
    inp.value = inp.value === "pratique" ? "" : "pratique";
    sync();
  });
  btnF.addEventListener("click", function () {
    inp.value = inp.value === "fantasme" ? "" : "fantasme";
    sync();
  });

  dirBtns.forEach(function(btn) {
    btn.addEventListener("click", function() {
      var hidden = document.getElementById(btn.dataset.inp);
      if (!hidden) return;
      var isDonne = hidden.value === "donne";
      hidden.value = isDonne ? "" : "donne";
      btn.textContent = isDonne ? "Re\u00e7u" : "Donn\u00e9";
      btn.classList.toggle("donne", !isDonne);
    });
  });
})();
</script>
