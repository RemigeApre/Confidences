<%- include('partials/head', { title: page.id ? 'Modifier \u2014 ' + page.title : 'Nouvelle page' }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>

  <%# Bouton retour (fixe gauche) %>
  <a href="<%= returnTo || (page.id ? '/wiki/' + page.id : '/wiki') %>" class="wf-back-btn">&#8592; Retour</a>

  <%# Boutons Save + Cancel (fixe droite) %>
  <div class="wf-actions-right">
    <button type="submit" form="wiki-edit-form" class="wf-save-btn">Enregistrer</button>
    <a href="<%= returnTo || (page.id ? '/wiki/' + page.id : '/wiki') %>" class="wf-cancel-link">Annuler</a>
  </div>

  <%# Bouton suppression (fixe gauche, sous le retour) %>
  <% if (page.id) { %>
  <form method="POST" action="/wiki/<%= page.id %>/delete" class="wf-delete-form-fixed">
    <button type="submit" class="wf-delete-btn-fixed" title="Supprimer la page">&#128465;</button>
  </form>
  <% } %>

  <script id="wiki-existing-pages" type="application/json"><%- JSON.stringify(pages.map(function(p){ return { id: p.id, title: p.title }; })) %></script>

  <%
    var pm = page.meta || {};
    var SPECIAL_TAGS = ["ultra", "irréaliste"];
    var allTagsNormal = allTags.filter(function(t){ return SPECIAL_TAGS.indexOf(t) === -1; });
  %>

  <form method="POST" action="<%= page.id ? '/wiki/' + page.id : '/wiki/' %>" enctype="multipart/form-data" class="wiki-form" id="wiki-edit-form">
    <input type="hidden" name="_returnTo" value="<%= returnTo || '' %>" />

    <%# ── 1. Titre + Catégorie ── %>
    <div class="wf-title-row">
      <input type="text" name="title" class="wiki-title-input" required value="<%= page.title %>" placeholder="Titre&hellip;" />
      <select name="category" id="wiki-category-select" class="wiki-cat-inline-select">
        <% categories.forEach(function(c) { %>
          <option value="<%= c.key %>" data-hue="<%= c.hue %>" <%= c.key === page.category ? 'selected' : '' %>><%= c.label %></option>
        <% }) %>
      </select>
    </div>

    <%# On possède (objets / tenues) %>
    <label class="chip-option wiki-owned-chip" id="wiki-owned-field" <%= (page.category === 'objets' || page.category === 'tenues') ? '' : 'hidden' %>>
      <input type="checkbox" name="owned" <%= page.owned ? 'checked' : '' %> />
      <span>On poss&egrave;de</span>
    </label>

    <%# ── Synonymes (sans titre de section) ── %>
    <%
      var pmDerivedValue = (pm.termes_derives || []).map(function (t) {
        if (typeof t === 'string') return t;
        return t.term + (t.en ? '::en' : '');
      }).join(', ');
    %>
    <div class="wiki-derived-row">
      <div class="wiki-tags-widget wiki-derived-widget">
        <div class="wiki-tags-board">
          <input type="text" class="wiki-tags-typing" placeholder="Synonymes, termes d&eacute;riv&eacute;s&hellip;" autocomplete="off" />
        </div>
        <input type="hidden" name="meta_termes_derives" class="wiki-tags-hidden" value="<%= pmDerivedValue %>" />
      </div>
    </div>

    <%# ── Sous-catégorie partenaires (avant extra-cats) ── %>
    <%
      var pmP = page.meta || {};
      function psel(field, val) { return pmP[field] === val ? 'checked' : ''; }
      function pmany(field, val) { return (Array.isArray(pmP[field]) && pmP[field].indexOf(val) !== -1) ? 'checked' : ''; }
      function pval(field) { return pmP[field] || ''; }
    %>
    <div id="wf-partenaires-sous-cat" <%= page.category === 'partenaires' ? '' : 'hidden' %>>
      <div class="wf-partenaires-type-chips">
        <label class="chip-option chip-opt--nombre"><input type="radio" name="meta_sous_cat" value="nombre"    <%= psel('sous_cat','nombre')    %>><span>Nombre</span></label>
        <label class="chip-option chip-opt--monstre"><input type="radio" name="meta_sous_cat" value="monstre"   <%= psel('sous_cat','monstre')   %>><span>Monstre</span></label>
        <label class="chip-option chip-opt--animaux"><input type="radio" name="meta_sous_cat" value="animaux"   <%= psel('sous_cat','animaux')   %>><span>Animal</span></label>
        <label class="chip-option chip-opt--fetichisme"><input type="radio" name="meta_sous_cat" value="fetichisme"<%= psel('sous_cat','fetichisme')%>><span>Fétichisme</span></label>
        <label class="chip-option chip-opt--autre"><input type="radio" name="meta_sous_cat" value="autre"     <%= psel('sous_cat','autre')     %>><span>Autre</span></label>
      </div>
    </div>

    <%# ── Sous-catégories : fantasmes / objets / lieux ── %>
    <div class="wiki-fantasmes-meta" <%= page.category === 'fantasmes' ? '' : 'hidden' %>>
      <div class="wf-section-title">Cat&eacute;gorie</div>
      <div class="wiki-meta-group">
        <div class="wiki-meta-options">
          <% fantasmesSubs.forEach(function(s) { %>
            <label class="chip-option"><input type="radio" name="meta_sous_cat" value="<%= s.key %>" <%= pm.sous_cat === s.key ? 'checked' : '' %>><span><%= s.label %></span></label>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="wiki-objets-meta" <%= page.category === 'objets' ? '' : 'hidden' %>>
      <div class="wf-section-title">Cat&eacute;gorie</div>
      <div class="wiki-meta-group">
        <div class="wiki-meta-options">
          <% objetsSubs.forEach(function(s) { %>
            <label class="chip-option"><input type="radio" name="meta_sous_cat" value="<%= s.key %>" <%= pm.sous_cat === s.key ? 'checked' : '' %>><span><%= s.label %></span></label>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="wiki-lieux-meta" <%= page.category === 'lieux' ? '' : 'hidden' %>>
      <div class="wf-section-title">Type de lieu</div>
      <div class="wiki-meta-group">
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="radio" name="meta_type_lieu" value="prive"  <%= pm.type_lieu === 'prive'  ? 'checked' : '' %>><span>Priv&eacute;</span></label>
          <label class="chip-option"><input type="radio" name="meta_type_lieu" value="public" <%= pm.type_lieu === 'public' ? 'checked' : '' %>><span>Public</span></label>
          <label class="chip-option"><input type="radio" name="meta_type_lieu" value="cache"  <%= pm.type_lieu === 'cache'  ? 'checked' : '' %>><span>Cach&eacute;</span></label>
        </div>
      </div>
    </div>

    <%# ── Séparateur sous-catégories / catégories ── %>
    <div class="wf-subcats-separator"></div>

    <%# ── Aussi dans ── %>
    <div class="wiki-extra-cats-field" id="wiki-edit-extra-cats">
      <div class="wiki-meta-options">
        <% categories.forEach(function(c) { %>
          <label class="chip-option wiki-extra-cat-option" data-cat="<%= c.key %>">
            <input type="checkbox" name="extra_categories" value="<%= c.key %>"
              <%= (page.extraCategories || []).indexOf(c.key) !== -1 ? 'checked' : '' %> />
            <span><%= c.label %></span>
          </label>
        <% }) %>
      </div>
    </div>

    <%# ── Description ── %>
    <div class="wf-section-title">Description</div>
    <div class="wiki-editor" data-rich>
      <div class="md-toolbar">
        <button type="button" class="md-btn" data-cmd="bold" title="Gras (Ctrl+B)"><strong>B</strong></button>
        <button type="button" class="md-btn md-btn-italic" data-cmd="italic" title="Italique (Ctrl+I)"><em>I</em></button>
        <span class="md-sep"></span>
        <button type="button" class="md-btn" data-cmd="h2">H2</button>
        <button type="button" class="md-btn" data-cmd="h3">H3</button>
        <span class="md-sep"></span>
        <button type="button" class="md-btn" data-cmd="list">&#8226;&nbsp;Liste</button>
        <button type="button" class="md-btn" data-cmd="hr">&mdash;</button>
        <span class="md-sep"></span>
        <span class="md-colors">
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#e05c5c" style="background:#e05c5c" title="Rouge"></button>
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#5cb8e0" style="background:#5cb8e0" title="Bleu"></button>
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#6dd68a" style="background:#6dd68a" title="Vert"></button>
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#e0b85c" style="background:#e0b85c" title="Or"></button>
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#c45ce0" style="background:#c45ce0" title="Violet"></button>
          <button type="button" class="md-color-btn md-color-clear" data-cmd="color" data-val="" title="Effacer couleur">&#215;</button>
        </span>
        <span class="md-sep"></span>
        <button type="button" class="md-btn" data-cmd="wikilink" title="Lier une page wiki">&#9679;&nbsp;Wiki</button>
        <button type="button" class="md-btn" data-cmd="extlink" title="Lien externe">&#128279;</button>
      </div>
      <div class="wiki-richtext" contenteditable="true" spellcheck="true"></div>
      <input type="hidden" name="content" class="wiki-richtext-hidden" value="" />
    </div>

    <%# ── Scénario (partenaires seulement) ── %>
    <div id="wf-scenario-field" <%= page.category === 'partenaires' ? '' : 'hidden' %>>
      <div class="wf-section-title">
        Sc&eacute;nario
        <span class="wiki-scenario-info" data-tooltip="Les sc&#233;narios sont &#233;crits en premier jet par une IA, corrig&#233;s et am&#233;lior&#233;s &#224; la main. Le choix de l&#8217;IA est pour illustrer litt&#233;rairement chaque page du wiki.&#10;&#10;Pour du contenu original parfaitement humain, cela se passera dans une future page d&#233;di&#233;e.">!</span>
      </div>
      <div class="wiki-editor">
        <div class="md-toolbar">
          <button type="button" class="md-btn" data-md="bold"><strong>B</strong></button>
          <button type="button" class="md-btn md-btn-italic" data-md="italic"><em>I</em></button>
          <span class="md-sep"></span>
          <button type="button" class="md-btn" data-md="h2">H2</button>
          <button type="button" class="md-btn" data-md="h3">H3</button>
          <span class="md-sep"></span>
          <button type="button" class="md-btn" data-md="list">&#8226;&nbsp;Liste</button>
          <button type="button" class="md-btn" data-md="hr">&mdash;</button>
          <div class="md-toolbar-spacer"></div>
          <button type="button" class="md-btn md-preview-btn">Aper&ccedil;u</button>
        </div>
        <textarea name="meta_scenario" class="wiki-textarea wiki-pos-textarea" rows="6" placeholder="Une courte histoire, un contexte&hellip;"><%= pm.scenario || '' %></textarea>
        <div class="wiki-md-preview wiki-md" hidden></div>
      </div>
      <label class="wf-scenario-human-label">
        <input type="checkbox" name="meta_scenario_human" value="on" <%= pm.scenario_human ? 'checked' : '' %> />
        <span class="wf-scenario-human-check">&#9998;</span>
        Sc&eacute;nario 100&nbsp;% humain <span class="wf-scenario-human-hint">(aucune IA impliqu&eacute;e)</span>
      </label>

      <%# ── Image d'illustration du scénario ── %>
      <div class="wf-scenario-img-section">
        <% if (pm.scenario_image) { %>
          <div class="wf-scenario-img-preview" id="wf-scenario-img-preview">
            <img src="<%= thumbUrl(pm.scenario_image) %>" alt="Illustration sc&eacute;nario" class="wf-scenario-thumb" loading="lazy" />
            <button type="button" class="wf-scenario-img-remove" id="wf-scenario-img-remove" title="Retirer l&rsquo;image">&#215;</button>
          </div>
        <% } else { %>
          <div class="wf-scenario-img-preview" id="wf-scenario-img-preview" hidden></div>
        <% } %>
        <input type="hidden" name="meta_scenario_image" id="wf-scenario-img-path" value="<%= pm.scenario_image || '' %>" />
        <label class="wf-scenario-img-label">
          <input type="file" name="scenario_image" id="wf-scenario-img-input" accept="image/*" style="display:none" />
          <span class="wf-scenario-img-btn">&#128444; Ajouter une image d&rsquo;illustration</span>
        </label>
      </div>
    </div>

    <%# ── Orce ── %>
    <div class="wf-section-title wf-orce-title">Orce <span class="wf-orce-badge">univers</span></div>
    <div class="wf-orce-section">
      <input type="text"
             name="meta_orce_name"
             class="wf-orce-name-input"
             placeholder="Nom en Orce (ajout&eacute; automatiquement en tag)&hellip;"
             value="<%= pm.orce_name || '' %>"
             maxlength="200" />
      <textarea name="meta_orce_content"
                class="wf-orce-content-input wf-md-input"
                rows="6"
                placeholder="Description Orce (laisser vide si non applicable)&hellip;"><%= pm.orce_content || '' %></textarea>
    </div>

    <%# ── Tags ── %>
    <div class="wf-section-title">Tags</div>
    <div class="wf-tags-unified">
      <%# Boutons ultra / irréaliste centrés %>
      <div class="wf-tags-special-row">
        <% SPECIAL_TAGS.forEach(function(t) { %>
          <button type="button" class="wiki-tag-suggest-chip wiki-tag-suggest-chip--special wf-tag-special" data-tag="<%= t %>"><%= t %></button>
        <% }) %>
      </div>
      <%# Widget principal : chips actifs + saisie + suggestions %>
      <div class="wiki-tags-widget">
        <div class="wiki-tags-board">
          <input type="text" class="wiki-tags-typing" placeholder="Ajouter un tag\u2026" autocomplete="off" />
        </div>
        <input type="hidden" name="tags" class="wiki-tags-hidden" value="<%= page.tags.join(', ') %>" />
        <% if (allTags.length) { %>
        <div class="wiki-tag-suggestions">
          <% allTags.forEach(function(t) { %>
            <button type="button" class="wiki-tag-suggest-chip" data-tag="<%= t %>"><%= t %></button>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>

    <%# ── Images (zone unifiée) ── %>
    <div class="wf-section-title">Images</div>
    <div class="wf-img-zone">
      <div class="wf-img-carousel" id="wf-img-carousel">

        <%# Cartes existantes ─ %>
        <% page.imagePaths.forEach(function(src, idx) {
          var isCover     = idx === 0;
          var isSecondary = !!(pm.secondary_image_paths && pm.secondary_image_paths.indexOf(src) !== -1);
          var posEntry    = (pm.positional_images || []).filter(function(pi) { return pi.path === src; })[0];
          var section     = posEntry ? (posEntry.section || '') : '';
        %>
          <div class="wf-img-card"
               data-path="<%= src %>"
               data-cover="<%= isCover ? '1' : '0' %>"
               data-secondary="<%= isSecondary ? '1' : '0' %>"
               data-section="<%= section %>">
            <div class="wf-img-card-photo">
              <img src="<%= thumbUrl(src) %>" class="wf-img-thumb" alt="" loading="lazy" />
              <button type="button" class="wf-img-rm" title="Supprimer">&#215;</button>
            </div>
            <div class="wf-img-card-controls">
              <button type="button" class="wf-img-ctrl wf-img-ctrl--star<%= isCover ? ' on' : '' %>" data-action="cover" title="Image principale (couverture)">&#9733;</button>
              <button type="button" class="wf-img-ctrl wf-img-ctrl--heart<%= isSecondary ? ' on' : '' %>" data-action="secondary" title="Afficher dans les images secondaires">&#10084;</button>
              <select class="wf-img-ctrl wf-img-ctrl--section<%= section ? ' on' : '' %>" data-action="section" title="Int&eacute;grer dans une section du texte">
                <option value="">&#9657;&nbsp;Section</option>
                <% if (section) { %><option value="<%= section %>" selected><%= section.length > 16 ? section.slice(0,14)+'\u2026' : section %></option><% } %>
              </select>
            </div>
          </div>
        <% }) %>

        <%# Carte &laquo;+&raquo; ─ %>
        <label class="wf-img-add-card">
          <span class="wf-img-add-icon">+</span>
          <input type="file" name="images" accept="image/*" multiple hidden class="wiki-image-input" />
        </label>

      </div>
    </div>
    <%# Champ s&eacute;rialis&eacute; envoy&eacute; au serveur ─ %>
    <input type="hidden" name="images_meta" id="wf-images-meta" value="{}" />

    <%# ── Paramètres partenaires (après images) ── %>
    <div id="wf-partenaires-params" <%= page.category === 'partenaires' ? '' : 'hidden' %>>

      <%# Communs à tous %>
      <details class="wf-part-details" open>
        <summary>Param&egrave;tres communs</summary>
        <div class="wf-part-details-body">
          <div class="wiki-meta-group"><p class="wiki-meta-label">Nature de l'acte</p><div class="wiki-meta-options">
            <label class="chip-option"><input type="radio" name="meta_nature_acte" value="possible"   <%= psel('nature_acte','possible')   %>><span>Possible</span></label>
            <label class="chip-option"><input type="radio" name="meta_nature_acte" value="improbable" <%= psel('nature_acte','improbable') %>><span>Improbable</span></label>
            <label class="chip-option"><input type="radio" name="meta_nature_acte" value="impossible" <%= psel('nature_acte','impossible') %>><span>Impossible</span></label>
            <label class="chip-option"><input type="radio" name="meta_nature_acte" value="fictif"     <%= psel('nature_acte','fictif')     %>><span>Fictif / Fantastique</span></label>
            <label class="chip-option"><input type="radio" name="meta_nature_acte" value="inconnu"    <%= psel('nature_acte','inconnu')    %>><span>Inconnu</span></label>
          </div></div>
          <div class="wiki-meta-group"><p class="wiki-meta-label">Cadre l&eacute;gal</p><div class="wiki-meta-options">
            <label class="chip-option"><input type="radio" name="meta_cadre_legal" value="legal"   <%= psel('cadre_legal','legal')   %>><span>L&eacute;gal</span></label>
            <label class="chip-option"><input type="radio" name="meta_cadre_legal" value="flou"    <%= psel('cadre_legal','flou')    %>><span>Flou</span></label>
            <label class="chip-option"><input type="radio" name="meta_cadre_legal" value="illegal" <%= psel('cadre_legal','illegal') %>><span>Ill&eacute;gal</span></label>
            <label class="chip-option"><input type="radio" name="meta_cadre_legal" value="inconnu" <%= psel('cadre_legal','inconnu') %>><span>Inconnu</span></label>
          </div></div>
          <div class="wiki-meta-group"><p class="wiki-meta-label">Risque physique</p><div class="wiki-meta-options">
            <% ['inconnu','nul','faible','modere','eleve','extreme'].forEach(function(v) { var lbl = {inconnu:'Inconnu',nul:'Nul',faible:'Faible',modere:'Mod\u00e9r\u00e9',eleve:'\u00c9lev\u00e9',extreme:'Extr\u00eame'}[v]; %>
              <label class="chip-option"><input type="radio" name="meta_risque_physique" value="<%= v %>" <%= psel('risque_physique',v) %>><span><%= lbl %></span></label>
            <% }) %>
          </div></div>
          <div class="wiki-meta-group"><p class="wiki-meta-label">Risque MST / IST / Zoonose</p><div class="wiki-meta-options">
            <% ['inconnu','nul','faible','modere','eleve','extreme'].forEach(function(v) { var lbl = {inconnu:'Inconnu',nul:'Nul',faible:'Faible',modere:'Mod\u00e9r\u00e9',eleve:'\u00c9lev\u00e9',extreme:'Extr\u00eame'}[v]; %>
              <label class="chip-option"><input type="radio" name="meta_risque_mst" value="<%= v %>" <%= psel('risque_mst',v) %>><span><%= lbl %></span></label>
            <% }) %>
          </div></div>
          <div class="wiki-meta-group"><p class="wiki-meta-label">Accessibilit&eacute;</p><div class="wiki-meta-options">
            <label class="chip-option"><input type="radio" name="meta_accessibilite" value="tres_rare"   <%= psel('accessibilite','tres_rare')   %>><span>Tr&egrave;s rare</span></label>
            <label class="chip-option"><input type="radio" name="meta_accessibilite" value="rare"        <%= psel('accessibilite','rare')        %>><span>Rare</span></label>
            <label class="chip-option"><input type="radio" name="meta_accessibilite" value="occasionnel" <%= psel('accessibilite','occasionnel') %>><span>Occasionnel</span></label>
            <label class="chip-option"><input type="radio" name="meta_accessibilite" value="frequent"    <%= psel('accessibilite','frequent')    %>><span>Fr&eacute;quent</span></label>
            <label class="chip-option"><input type="radio" name="meta_accessibilite" value="inconnu"     <%= psel('accessibilite','inconnu')     %>><span>Inconnu</span></label>
          </div></div>
        </div>
      </details>

      <%# Nombre %>
      <details class="wf-part-details wf-part-sub wf-part-sub--nombre" hidden>
        <summary>Nombre</summary>
        <div class="wf-part-details-body">
          <div class="wiki-meta-group"><p class="wiki-meta-label">Nombre total</p><div class="wiki-meta-options">
            <% ['2','3','4','5plus'].forEach(function(v) { %>
              <label class="chip-option"><input type="radio" name="meta_nb_total" value="<%= v %>" <%= psel('nb_total',v) %>><span><%= v==='5plus'?'5+':v %></span></label>
            <% }) %>
          </div></div>
          <div class="wiki-meta-group"><p class="wiki-meta-label">Nombre de femmes</p><div class="wiki-meta-options">
            <% ['0','1','2','3plus'].forEach(function(v) { %>
              <label class="chip-option"><input type="radio" name="meta_nb_feminin" value="<%= v %>" <%= psel('nb_feminin',v) %>><span><%= v==='3plus'?'3+':v %></span></label>
            <% }) %>
          </div></div>
          <div class="wiki-meta-group"><p class="wiki-meta-label">Nombre d'hommes</p><div class="wiki-meta-options">
            <% ['0','1','2','3plus'].forEach(function(v) { %>
              <label class="chip-option"><input type="radio" name="meta_nb_masculin" value="<%= v %>" <%= psel('nb_masculin',v) %>><span><%= v==='3plus'?'3+':v %></span></label>
            <% }) %>
          </div></div>
        </div>
      </details>

      <%# Monstre %>
      <details class="wf-part-details wf-part-sub wf-part-sub--monstre" hidden>
        <summary>Monstre</summary>
        <div class="wf-part-details-body">
          <div class="wiki-meta-group"><p class="wiki-meta-label">Type de cr&eacute;ature</p><div class="wiki-meta-options">
            <% [['machine','Machine'],['sang_froid','Sang froid'],['mammifere','Mammif\u00e8re'],['insectoide','Insecto\u00efde'],['amorphe','Amorphe'],['elementaire','\u00c9l\u00e9mentaire'],['autre','Autre']].forEach(function(o) { %>
              <label class="chip-option"><input type="radio" name="meta_type_creature" value="<%= o[0] %>" <%= psel('type_creature',o[0]) %>><span><%= o[1] %></span></label>
            <% }) %>
          </div></div>
          <div class="wiki-meta-group"><p class="wiki-meta-label">Type(s) d'acte(s) sexuel(s)</p><div class="wiki-meta-options">
