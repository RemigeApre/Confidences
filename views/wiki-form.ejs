<%- include('partials/head', { title: page.id ? 'Codex : Modifier ' + page.title : 'Codex : Nouvelle page' }) %>
<%
  var pm = page.meta || {};
  var SPECIAL_TAGS = ["ultra", "irréaliste"];
  var allTagsNormal = allTags.filter(function(t){ return SPECIAL_TAGS.indexOf(t) === -1; });

  var pmDerivedValue = (pm.termes_derives || []).map(function(t) {
    if (typeof t === 'string') return t;
    return t.term + (t.en ? '::en' : '');
  }).join(', ');

  function psel(field, val) { return pm[field] === val ? 'checked' : ''; }
  function pmany(field, val) { return (Array.isArray(pm[field]) && pm[field].indexOf(val) !== -1) ? 'checked' : ''; }
  function pval(field) { return pm[field] || ''; }

  var pmCanal = Array.isArray(pm.canal) ? pm.canal : (pm.canal ? [pm.canal] : []);
  var pmOri   = Array.isArray(pm.orientation) ? pm.orientation : (pm.orientation ? [pm.orientation] : []);
  var pmSup   = Array.isArray(pm.supports) ? pm.supports : (pm.supports ? [pm.supports] : []);
  function ck(arr, v) { return arr.indexOf(v) !== -1 ? 'checked' : ''; }
  function ra(val, v)  { return val === v ? 'checked' : ''; }

  var stType = pm.stats_type || '';
  var stPctG = pm.stats_pct_general != null ? pm.stats_pct_general : '';
  var stPctH = pm.stats_pct_hommes  != null ? pm.stats_pct_hommes  : '';
  var stPctF = pm.stats_pct_femmes  != null ? pm.stats_pct_femmes  : '';
  var stSrc  = pm.stats_source || '';
%>

<main class="container wide">
  <%- include('partials/top-nav', { config: config }) %>

  <% if (page.id) { %>
  <form method="POST" action="/wiki/<%= page.slug || page.id %>/delete" id="wiki-delete-form"
    onsubmit="return confirm('Supprimer cette page d\u00e9finitivement ?')"></form>
  <% } %>

  <script id="wiki-existing-pages" type="application/json"><%- JSON.stringify(pages.map(function(p){ return { id: p.id, title: p.title }; })) %></script>

  <form method="POST" action="<%= page.slug ? '/wiki/' + page.id : (page.id ? '/wiki/' + page.id : '/wiki/') %>"
    enctype="multipart/form-data"
    class="wiki-form wiki-form--3col"
    id="wiki-edit-form"
    data-no-enter-submit>

    <input type="hidden" name="_returnTo" value="<%= returnTo || '' %>" />
    <% if (locals.editLang === 'en') { %><input type="hidden" name="_editLang" value="en" /><% } %>

    <%# ═══════════════════════════════════════════════════════ %>
    <%# SIDEBAR GAUCHE : Parodie / Synonymes / Catégories / Tags %>
    <%# ═══════════════════════════════════════════════════════ %>
    <aside class="wf-sidebar-left" id="wf-sidebar-left">

      <%# ── Topbar : hors du scroll — toujours visible ── %>
      <div class="wf-sb-topbar">
        <a href="<%= returnTo || (page.id ? '/wiki/' + (page.slug || page.id) : '/wiki') %>" class="wiki-left-back-btn" title="Retour">&lsaquo;</a>
        <button type="submit" class="wf-sb-save-btn">Enregistrer</button>
        <% if (page.id) { %><%- include('partials/lang-toggle', { editLang: locals.editLang || 'fr', editUrl: '/wiki/' + page.id + '/edit' }) %><% } %>
      </div>

      <div class="wf-sidebar-inner">

        <%# supprimé : wf-sb-toggles — sections devenues accordéons inline, Possède → checkbox %>


        <%# ── Catégorie + Aussi dans ── %>
        <div class="wf-cat-row">
          <div class="wf-cat-col">
            <span class="prot-sb-label">Cat&eacute;gorie</span>
            <select name="category" id="wiki-category-select" class="prot-form-select-elegant prot-form-select-elegant--sm">
              <% categories.forEach(function(c) { %>
                <option value="<%= c.key %>" data-hue="<%= c.hue %>" <%= c.key === page.category ? 'selected' : '' %>><%= c.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="wf-cat-col">
            <span class="prot-sb-label">Aussi dans</span>
            <select name="extra_categories" id="wf-aussi-dans-select" class="prot-form-select-elegant prot-form-select-elegant--sm">
              <option value="">—</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c.key %>" <%= (page.extraCategories || [])[0] === c.key ? 'selected' : '' %>><%= c.label %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <%# ── Sous-catégorie (un seul select, peuplé dynamiquement) ── %>
        <div class="prot-sb-section wf-subcat-section" id="wf-sb-subcat-wrap" hidden>
          <span class="prot-sb-label">Sous-cat&eacute;gorie</span>
          <select name="meta_sous_cat" id="wf-subcat-select" class="prot-form-select-elegant prot-form-select-elegant--sm" style="width:100%">
            <option value="">— Choisir —</option>
          </select>
          <select name="meta_type_lieu" id="wf-type-lieu-select" class="prot-form-select-elegant prot-form-select-elegant--sm" style="width:100%" hidden>
            <option value="">— Choisir —</option>
            <option value="prive"  <%= pm.type_lieu === 'prive'  ? 'selected' : '' %>>Priv&eacute;</option>
            <option value="public" <%= pm.type_lieu === 'public' ? 'selected' : '' %>>Public</option>
            <option value="cache"  <%= pm.type_lieu === 'cache'  ? 'selected' : '' %>>Cach&eacute;</option>
          </select>
        </div>

        <%# ── Synonymes (accordéon) ── %>
        <div class="wf-sb-accordion">
          <button type="button" class="wf-sb-toggle wf-sb-accordion-btn<%= pmDerivedValue ? ' active' : '' %>" data-target="wf-sec-synonymes">
            <span>Synonymes</span><span class="wf-sb-accordion-arrow">&rsaquo;</span>
          </button>
          <div id="wf-sec-synonymes" class="wf-sb-accordion-body"<%= pmDerivedValue ? '' : ' hidden' %>>
            <div class="wf-tagged-box">
              <div class="wiki-tags-widget wiki-derived-widget">
                <div class="wiki-tags-board">
                  <input type="text" class="wiki-tags-typing" placeholder="Synonymes, termes d&eacute;riv&eacute;s&hellip;" autocomplete="off" />
                </div>
                <div class="wiki-tags-chips"></div>
                <input type="hidden" name="meta_termes_derives" class="wiki-tags-hidden" value="<%= pmDerivedValue %>" />
              </div>
            </div>
          </div>
        </div>

        <%# ── Tags ── %>
        <div class="prot-sb-section wf-tags-section">
          <div class="wf-tagged-box">
            <span class="prot-sb-label">Tags</span>
            <div class="wiki-tags-widget">
              <div class="wiki-tags-board">
                <input type="text" class="wiki-tags-typing" placeholder="Ajouter un tag&hellip;" autocomplete="off" />
              </div>
              <div class="wiki-tags-chips"></div>
              <input type="hidden" name="tags" class="wiki-tags-hidden" value="<%= page.tags.join(', ') %>" />
              <%# Suggestions gardées cachées : wiki.js lit les data-tag pour l'autocomplétion %>
              <% if (allTagsNormal.length) { %>
              <div class="wiki-tag-suggestions" hidden>
                <% allTagsNormal.forEach(function(t) { %>
                  <button type="button" class="wiki-tag-suggest-chip" data-tag="<%= t %>"><%= t %></button>
                <% }) %>
              </div>
              <% } %>
            </div>
          </div>
        </div>

        <%# ── Parodie (accordéon) ── %>
        <div class="wf-sb-accordion">
          <button type="button" class="wf-sb-toggle wf-sb-accordion-btn<%= (page.parody || page.subParody) ? ' active' : '' %>" data-target="wf-sec-parodie">
            <span>Parodie</span><span class="wf-sb-accordion-arrow">&rsaquo;</span>
          </button>
          <div id="wf-sec-parodie" class="wf-sb-accordion-body"<%= (page.parody || page.subParody) ? '' : ' hidden' %>>
            <%- include('partials/parody-input', {
                  idPrefix:  'wkf',
                  mainValue: page.parody    || '',
                  subValue:  page.subParody || '',
                  mainPh:    'Parodie (ex\u00a0: Pok\u00e9mon)\u2026'
                }) %>
          </div>
        </div>

        <%# ── Possède : feature toggle utilisateur ── %>
        <label class="wf-possede-toggle">
          <div class="wf-possede-label">
            <span class="wf-possede-label-title">&laquo;&nbsp;Je poss&egrave;de&nbsp;&raquo;</span>
            <span class="wf-possede-label-hint">Active un bouton utilisateur sur la fiche</span>
          </div>
          <div class="wf-possede-switch">
            <input type="checkbox" name="owned" value="on" <%= page.owned ? 'checked' : '' %> />
            <span class="wf-possede-track"></span>
          </div>
        </label>

      </div><%# /wf-sidebar-inner %>

      <% if (page.id) { %>
      <div class="prot-sb-footer">
        <button type="submit" form="wiki-delete-form" class="prot-sb-delete-bottom">&#128465; Supprimer la page</button>
      </div>
      <% } %>
    </aside><%# /wf-sidebar-left %>

    <%# ═══════════════════════════════════════ %>
    <%# CONTENU PRINCIPAL                        %>
    <%# ═══════════════════════════════════════ %>
    <div class="wf-main-content">

      <%# ── Titre ── %>
      <div class="wf-title-row wf-title-row--solo">
        <% var _trTitle = (locals.editLang === 'en') ? ((locals.translations || {}).title || '') : page.title; %>
        <input type="text" name="title" class="wiki-title-input" required value="<%= _trTitle %>"
               placeholder="<%= locals.editLang === 'en' ? page.title : 'Titre\u2026' %>"
               <% if (locals.editLang === 'en') { %>data-fr-placeholder="<%= page.title %>"<% } %> />
      </div>

      <%# ── Slug URL (caché, auto-généré depuis le titre) ── %>
      <% if (locals.editLang !== 'en') { %>
      <input type="hidden" name="meta_slug" id="wf-slug-input" value="<%= page.slug || '' %>" />
      <% } %>

      <%# ── Description ── %>
      <div class="wiki-editor" data-rich>
        <div class="md-toolbar">
          <button type="button" class="md-btn" data-cmd="bold" title="Gras (Ctrl+B)"><strong>B</strong></button>
          <button type="button" class="md-btn md-btn-italic" data-cmd="italic" title="Italique (Ctrl+I)"><em>I</em></button>
          <span class="md-sep"></span>
          <button type="button" class="md-btn" data-cmd="h2">H2</button>
          <button type="button" class="md-btn" data-cmd="h3">H3</button>
          <span class="md-sep"></span>
          <button type="button" class="md-btn" data-cmd="list">&#8226;&nbsp;Liste</button>
          <button type="button" class="md-btn" data-cmd="hr">&mdash;</button>
          <span class="md-sep"></span>
          <span class="md-colors">
            <button type="button" class="md-color-btn" data-cmd="color" data-val="#e05c5c" style="background:#e05c5c" title="Rouge"></button>
            <button type="button" class="md-color-btn" data-cmd="color" data-val="#5cb8e0" style="background:#5cb8e0" title="Bleu"></button>
            <button type="button" class="md-color-btn" data-cmd="color" data-val="#6dd68a" style="background:#6dd68a" title="Vert"></button>
            <button type="button" class="md-color-btn" data-cmd="color" data-val="#e0b85c" style="background:#e0b85c" title="Or"></button>
            <button type="button" class="md-color-btn" data-cmd="color" data-val="#c45ce0" style="background:#c45ce0" title="Violet"></button>
            <button type="button" class="md-color-btn md-color-clear" data-cmd="color" data-val="" title="Effacer couleur">&#215;</button>
          </span>
          <span class="md-sep"></span>
          <button type="button" class="md-btn" data-cmd="wikilink" title="Lier une page codex">&#9679;&nbsp;Codex</button>
          <button type="button" class="md-btn" data-cmd="extlink" title="Lien externe">&#128279;</button>
        </div>
        <div class="wiki-richtext" contenteditable="true" spellcheck="true"></div>
        <input type="hidden" name="content" class="wiki-richtext-hidden" value="" />
      </div>

      <%# ── Scénario (partenaires uniquement) ── %>
      <div id="wf-scenario-field" <%= page.category === 'partenaires' ? '' : 'hidden' %>>
        <div class="wf-section-title">
          Sc&eacute;nario
          <span class="wiki-scenario-info" data-tooltip="Les sc&#233;narios sont &#233;crits en premier jet par une IA, corrig&#233;s et am&#233;lior&#233;s &#224; la main. Le choix de l&#8217;IA est pour illustrer litt&#233;rairement chaque page du wiki.&#10;&#10;Pour du contenu original parfaitement humain, cela se passera dans une future page d&#233;di&#233;e.">!</span>
        </div>
        <div class="wiki-editor">
          <div class="md-toolbar">
            <button type="button" class="md-btn" data-md="bold"><strong>B</strong></button>
            <button type="button" class="md-btn md-btn-italic" data-md="italic"><em>I</em></button>
            <span class="md-sep"></span>
            <button type="button" class="md-btn" data-md="h2">H2</button>
            <button type="button" class="md-btn" data-md="h3">H3</button>
            <span class="md-sep"></span>
            <button type="button" class="md-btn" data-md="list">&#8226;&nbsp;Liste</button>
            <button type="button" class="md-btn" data-md="hr">&mdash;</button>
            <div class="md-toolbar-spacer"></div>
            <button type="button" class="md-btn md-preview-btn">Aper&ccedil;u</button>
          </div>
          <% var _trScenario = (locals.editLang === 'en') ? ((locals.translations || {}).meta_scenario || '') : (pm.scenario || ''); %>
          <textarea name="meta_scenario" class="wiki-textarea wiki-pos-textarea" rows="6"
            placeholder="<%= locals.editLang === 'en' ? (pm.scenario || 'Scénario EN\u2026') : 'Une courte histoire, un contexte\u2026' %>"><%= _trScenario %></textarea>
          <div class="wiki-md-preview wiki-md" hidden></div>
        </div>
        <label class="wf-scenario-human-label">
          <input type="checkbox" name="meta_scenario_human" value="on" <%= pm.scenario_human ? 'checked' : '' %> />
          <span class="wf-scenario-human-check">&#9998;</span>
          Sc&eacute;nario 100&nbsp;% humain <span class="wf-scenario-human-hint">(aucune IA impliqu&eacute;e)</span>
        </label>
        <div class="wf-scenario-img-section">
          <% if (pm.scenario_image) { %>
            <div class="wf-scenario-img-preview" id="wf-scenario-img-preview">
              <img src="<%= thumbUrl(pm.scenario_image) %>" alt="Illustration sc&eacute;nario" class="wf-scenario-thumb" loading="lazy" />
              <button type="button" class="wf-scenario-img-remove" id="wf-scenario-img-remove" title="Retirer l&rsquo;image">&#215;</button>
            </div>
          <% } else { %>
            <div class="wf-scenario-img-preview" id="wf-scenario-img-preview" hidden></div>
          <% } %>
          <input type="hidden" name="meta_scenario_image" id="wf-scenario-img-path" value="<%= pm.scenario_image || '' %>" />
          <label class="wf-scenario-img-label">
            <input type="file" name="scenario_image" id="wf-scenario-img-input" accept="image/*" style="display:none" />
            <span class="wf-scenario-img-btn">&#128444; Ajouter une image d&rsquo;illustration</span>
          </label>
        </div>
      </div><%# /wf-scenario-field %>

      <%# ── Images ── %>
      <div class="wf-section-title">Images</div>
      <div class="wf-img-zone">
        <div class="wf-img-carousel" id="wf-img-carousel">
          <% page.imagePaths.forEach(function(src, idx) {
            var isCover     = idx === 0;
            var isSecondary = pm.secondary_configured
              ? !!(pm.secondary_image_paths && pm.secondary_image_paths.indexOf(src) !== -1)
              : !isCover;
            var posEntry    = (pm.positional_images || []).filter(function(pi) { return pi.path === src; })[0];
            var section     = posEntry ? (posEntry.section || '') : '';
            var isSfw       = !!(page.sfwImagePaths && page.sfwImagePaths.indexOf(src) !== -1);
          %>
            <div class="wf-img-card"
                 data-path="<%= src %>"
                 data-cover="<%= isCover ? '1' : '0' %>"
                 data-secondary="<%= isSecondary ? '1' : '0' %>"
                 data-sfw="<%= isSfw ? '1' : '0' %>"
                 data-section="<%= section %>">
              <div class="wf-img-card-photo">
                <img src="<%= thumbUrl(src) %>" class="wf-img-thumb" alt="" loading="lazy" />
                <button type="button" class="wf-img-rm" title="Supprimer">&#215;</button>
              </div>
              <div class="wf-img-card-controls">
                <button type="button" class="wf-img-ctrl wf-img-ctrl--star<%= isCover ? ' on' : '' %>" data-action="cover" title="Image principale">&#9733;</button>
                <button type="button" class="wf-img-ctrl wf-img-ctrl--heart<%= isSecondary ? ' on' : '' %>" data-action="secondary" title="Images secondaires">&#10084;</button>
                <button type="button" class="wf-img-ctrl wf-img-ctrl--sfw<%= isSfw ? ' on' : '' %>" data-action="sfw" title="Visible sans compte (SFW)">&#9728;</button>
                <select class="wf-img-ctrl wf-img-ctrl--section<%= section ? ' on' : '' %>" data-action="section" title="Int&eacute;grer dans une section">
                  <option value="">&#9657;&nbsp;Section</option>
                  <% if (section) { %><option value="<%= section %>" selected><%= section.length > 16 ? section.slice(0,14)+'\u2026' : section %></option><% } %>
                </select>
              </div>
            </div>
          <% }) %>
          <label class="wf-img-add-card">
            <span class="wf-img-add-icon">+</span>
            <input type="file" name="images" accept="image/*" multiple hidden class="wiki-image-input" />
          </label>
        </div>
      </div>
      <input type="hidden" name="images_meta" id="wf-images-meta" value="{}" />

      <%# ── Résumé carte Codex ── %>
      <div class="wf-section-title">Carte Codex <span style="font-size:.73rem;color:#64748b;font-weight:400;text-transform:none;letter-spacing:0">(optionnel)</span></div>
      <textarea name="card_summary" class="wiki-textarea wiki-pos-textarea" rows="3"
        placeholder="Texte affiché au dos de la carte lootbox (2-4 lignes courtes)&hellip;"><%= page.cardSummary || '' %></textarea>

      <%# ── YMYL : Notes médicale / psychologique ── %>
      <div class="wf-ymyl-block">

        <details class="wf-ymyl-section" id="wf-medical-details"<%= pm.medical ? ' open' : '' %>>
          <summary class="wf-ymyl-summary">
            <span class="wf-ymyl-title">Note m&eacute;dicale</span>
            <span class="wf-orce-badge wf-ymyl-badge" style="background:rgba(251,191,36,.12);color:#fbbf24;border-color:rgba(251,191,36,.25)">YMYL</span>
            <span class="wf-ymyl-arrow">&rsaquo;</span>
          </summary>
          <div class="wf-ymyl-body">
            <textarea name="meta_medical" class="wf-ymyl-textarea" rows="4"
                      placeholder="Risques, pr&eacute;cautions m&eacute;dicales, r&eacute;f&eacute;rences cliniques&hellip;"><%= pm.medical || '' %></textarea>
            <div class="wf-ymyl-sources">
              <div id="wf-medical-sources-list"></div>
              <button type="button" class="wf-sources-add-btn wf-ymyl-add-src" data-target="medical">+ source m&eacute;dicale</button>
            </div>
            <input type="hidden" name="meta_medical_sources" id="wf-medical-sources-hidden" value="<%= JSON.stringify(pm.medical_sources || []) %>" />
          </div>
        </details>

        <details class="wf-ymyl-section" id="wf-psychologique-details"<%= pm.psychologique ? ' open' : '' %>>
          <summary class="wf-ymyl-summary">
            <span class="wf-ymyl-title">Note psychologique</span>
            <span class="wf-orce-badge wf-ymyl-badge" style="background:rgba(251,191,36,.12);color:#fbbf24;border-color:rgba(251,191,36,.25)">YMYL</span>
            <span class="wf-ymyl-arrow">&rsaquo;</span>
          </summary>
          <div class="wf-ymyl-body">
            <textarea name="meta_psychologique" class="wf-ymyl-textarea" rows="4"
                      placeholder="Dynamiques psychologiques, impacts &eacute;motionnels, recommandations&hellip;"><%= pm.psychologique || '' %></textarea>
            <div class="wf-ymyl-sources">
              <div id="wf-psychologique-sources-list"></div>
              <button type="button" class="wf-sources-add-btn wf-ymyl-add-src" data-target="psychologique">+ source psychologique</button>
            </div>
            <input type="hidden" name="meta_psychologique_sources" id="wf-psychologique-sources-hidden" value="<%= JSON.stringify(pm.psychologique_sources || []) %>" />
          </div>
        </details>

      </div><%# /wf-ymyl-block %>

      <%# ── Actions mobile ── %>
      <div class="wiki-form-actions wf-mobile-actions">
        <button type="submit">Enregistrer</button>
      </div>

    </div><%# /wf-main-content %>

    <%# ═══════════════════════════════════════════════ %>
    <%# SIDEBAR DROITE : Save / Stats / Orce / Détails  %>
    <%# ═══════════════════════════════════════════════ %>
    <aside class="wf-sidebar-right" id="wf-sidebar-right">

      <div class="wf-sidebar-inner">

        <%# ── Statistiques ── %>
        <details class="prot-sb-details"<%= stType ? ' open' : '' %>>
          <summary class="prot-sb-details-summary">Statistiques</summary>
          <div class="prot-sb-details-body wf-sb-stats">
            <div class="wf-stats-toggle-wrap">
              <button type="button" class="wf-stats-pill<%= stType === 'pratique'  ? ' active' : '' %>" id="wf-stat-pratique">Pratiqu&eacute;</button>
              <button type="button" class="wf-stats-pill wf-stats-pill--f<%= stType === 'fantasme' ? ' active' : '' %>" id="wf-stat-fantasme">Fantasm&eacute;</button>
              <input type="hidden" name="meta_stats_type" id="wf-stats-type" value="<%= stType %>" />
            </div>
            <div class="wf-stats-fields" id="wf-stats-fields" <%= stType ? '' : 'hidden' %>>
              <div class="wf-stats-pct-row">
                <label class="wf-stats-pct-label">G&eacute;n&eacute;ral</label>
                <input type="number" name="meta_stats_pct_general" class="wf-stats-pct-input" min="0" max="100" step="0.01" value="<%= stPctG %>" placeholder="&mdash;" />
                <span class="wf-stats-pct-unit">%</span>
              </div>
              <div class="wf-stats-pct-row">
                <label class="wf-stats-pct-label">Femmes</label>
                <input type="number" name="meta_stats_pct_femmes"  class="wf-stats-pct-input" min="0" max="100" step="0.01" value="<%= stPctF %>" placeholder="&mdash;" />
                <span class="wf-stats-pct-unit">%</span>
                <button type="button" class="wf-stats-dir-btn<%= pm.stats_dir_femmes === 'donne' ? ' donne' : '' %> wf-stats-dir-pratique" data-inp="wf-dir-femmes"><%= pm.stats_dir_femmes === 'donne' ? 'Donn\u00e9' : 'Re\u00e7u' %></button>
                <input type="hidden" name="meta_stats_dir_femmes" id="wf-dir-femmes" value="<%= pm.stats_dir_femmes || '' %>" />
              </div>
              <div class="wf-stats-pct-row">
                <label class="wf-stats-pct-label">Hommes</label>
