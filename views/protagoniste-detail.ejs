<%- include('partials/head', { title: protagoniste.name }) %>
<%
  var _isFemme = protagoniste.gender === 'femme';
  var _orientationLabel = {
    hetero: { fr: 'Hétéro',                         en: 'Hetero' },
    homo:   { fr: _isFemme ? 'Lesbienne' : 'Gay',   en: _isFemme ? 'Lesbian' : 'Gay' },
    bi:     { fr: _isFemme ? 'Bi & curieuse' : 'Bi & curieux', en: 'Bi & curious' },
    autre:  { fr: 'Autre',                           en: 'Other' }
  };
  var _protDesc     = t(protagoniste.description,         'protagoniste', protagoniste.id, 'description');
  var _protDescPhys = t(protagoniste.description_physique,'protagoniste', protagoniste.id, 'description_physique');
  var _protDescOeuv = t(protagoniste.description_oeuvre,  'protagoniste', protagoniste.id, 'description_oeuvre');
  function fmtDesc(str) {
    var esc = str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    return esc.replace(/\n\n+/g,'</p><p>').replace(/\n/g,'<br>').replace(/^/,'<p>').replace(/$/,'</p>');
  }
  function safeColor(c) {
    return c && /^#[0-9a-fA-F]{3,6}$|^hsl\(|^rgb\(/.test(c) ? c : '';
  }
%>
<main class="prot-detail-page" style="--ch-hue:340">
  <%- include('partials/top-nav', { config: config, navTitle: protagoniste.name, navBack: '/protagonistes' }) %>

  <div class="prot-3col-layout">

    <%# ── Colonne gauche : retour + upload admin ── %>
    <% if (currentUser && currentUser.isAdmin) { %>
    <aside class="prot-left-panel">
      <a href="/protagonistes" class="prot-back-link-panel" data-fr="&#8592; Personnages" data-en="&#8592; Characters">&#8592; Personnages</a>
      <div class="prot-left-panel-title" data-fr="Galerie" data-en="Gallery">Galerie</div>
      <form method="POST" action="/protagonistes/<%= protagoniste.id %>/gallery-upload"
        enctype="multipart/form-data" class="prot-upload-form">
        <label class="prot-upload-dropzone" id="prot-gal-drop">
          <input type="file" name="images" accept="image/*" multiple id="prot-gal-input" style="display:none" />
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <span id="prot-gal-label" data-fr="Ajouter&hellip;" data-en="Add&hellip;">Ajouter&hellip;</span>
        </label>
        <div class="prot-upload-previews" id="prot-gal-previews"></div>
        <button type="submit" class="wf-save-btn" id="prot-gal-submit" disabled style="width:100%;margin-top:.4rem">Envoyer</button>
      </form>
      <script nonce="<%= nonce %>">
      (function() {
        var inp=document.getElementById("prot-gal-input"),lbl=document.getElementById("prot-gal-label"),
            prev=document.getElementById("prot-gal-previews"),btn=document.getElementById("prot-gal-submit"),
            drop=document.getElementById("prot-gal-drop");
        function update(files){
          var _isEn=localStorage.getItem('slang')==='en';
          lbl.textContent=files.length?files.length+" image(s)":(_isEn?"Add\u2026":"Ajouter\u2026");
          btn.disabled=!files.length; prev.innerHTML="";
          Array.from(files).forEach(function(f){var i=document.createElement("img");i.src=URL.createObjectURL(f);i.className="prot-upload-preview-img";prev.appendChild(i);});
        }
        if(inp)inp.addEventListener("change",function(){update(inp.files);});
        ["dragover","dragenter"].forEach(function(ev){drop.addEventListener(ev,function(e){e.preventDefault();drop.classList.add("drag-over");});});
        ["dragleave","dragend"].forEach(function(ev){drop.addEventListener(ev,function(){drop.classList.remove("drag-over");});});
        drop.addEventListener("drop",function(e){
          e.preventDefault();drop.classList.remove("drag-over");
          try{var dt=new DataTransfer();Array.from(e.dataTransfer.files).forEach(function(f){dt.items.add(f);});inp.files=dt.files;}catch(_){}
          update(e.dataTransfer.files);
        });
      })();
      </script>
    </aside>
    <% } else { %>
    <div class="prot-left-panel prot-left-panel--empty">
      <a href="/protagonistes" class="prot-back-link-panel" data-fr="&#8592; Personnages" data-en="&#8592; Characters">&#8592; Personnages</a>
    </div>
    <% } %>

    <%# ── Colonne centrale : contenu ── %>
    <div class="prot-detail-main">

      <%# En-tête : nom %>
      <div class="prot-detail-hero">
        <div class="prot-detail-hero-text">
          <div class="prot-detail-fullname">
            <% if (protagoniste.prenom) { %><span class="prot-detail-prenom"><%= protagoniste.prenom %></span> <% } %><% if (protagoniste.nom) { %><span class="prot-detail-nom"><%= protagoniste.nom %></span><% } else if (!protagoniste.prenom) { %><span class="prot-detail-nom"><%= protagoniste.name %></span><% } %>
          </div>
        </div>
      </div>

      <%# Descriptions rétractables %>
      <%
        var _enDesc     = (translationsEn && translationsEn.description)          || '';
        var _enDescPhys = (translationsEn && translationsEn.description_physique)  || '';
        var _enDescOeuv = (translationsEn && translationsEn.description_oeuvre)    || '';
      %>
      <% if (_protDesc) { %>
        <details class="prot-desc-section" open>
          <summary class="prot-desc-summary" data-fr="Description" data-en="Description">Description</summary>
          <div class="prot-desc-body" data-field="description"><%- fmtDesc(_protDesc) %></div>
        </details>
      <% } %>
      <% if (_protDescPhys) { %>
        <details class="prot-desc-section" open>
          <summary class="prot-desc-summary" data-fr="Apparence physique" data-en="Physical appearance">Apparence physique</summary>
          <div class="prot-desc-body" data-field="description_physique"><%- fmtDesc(_protDescPhys) %></div>
        </details>
      <% } %>
      <% if (_protDescOeuv) { %>
        <details class="prot-desc-section" open>
          <summary class="prot-desc-summary" data-fr="Rôle dans l'œuvre" data-en="Role in the work">R&ocirc;le dans l&rsquo;&oelig;uvre</summary>
          <div class="prot-desc-body" data-field="description_oeuvre"><%- fmtDesc(_protDescOeuv) %></div>
        </details>
      <% } %>

      <%# Lien vers le personnage parent (page enfant) %>
      <% if (parentProtagoniste) { %>
        <section class="prot-section prot-section--versions">
          <h2 class="prot-versions-title">Version</h2>
          <div class="prot-versions-grid">
            <a href="/protagonistes/<%= parentProtagoniste.id %>" class="prot-version-card">
              <% if (parentProtagoniste.image_path) { %>
                <img src="<%= parentProtagoniste.image_path %>" alt="<%= parentProtagoniste.name %>" class="prot-version-card-img" loading="lazy" />
              <% } else { %>
                <div class="prot-version-card-placeholder"></div>
              <% } %>
              <div class="prot-version-card-name"><%= parentProtagoniste.name %></div>
            </a>
          </div>
        </section>
      <% } %>

      <%# Versions %>
      <% if (childEvolutions && childEvolutions.length) { %>
        <section class="prot-section prot-section--versions">
          <h2 class="prot-versions-title">
            <%= childEvolutions.length === 1 ? 'Version' : 'Versions' %>
          </h2>
          <div class="prot-versions-grid">
            <% childEvolutions.forEach(function(child) { %>
              <a href="/protagonistes/<%= child.id %>" class="prot-version-card">
                <% if (child.image_path) { %>
                  <img src="<%= child.image_path %>" alt="<%= child.name %>" class="prot-version-card-img" loading="lazy" />
                <% } else { %>
                  <div class="prot-version-card-placeholder"></div>
                <% } %>
                <div class="prot-version-card-name"><%= child.name %></div>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <%# Images (galerie) %>
      <% if (galleryImages && galleryImages.length) { %>
        <%
          var IRREALISTE_TAGS = ['irréaliste', 'fantaisie'];
          var _protSpecial = protagoniste.special || '';
          function imgSpecial(img) {
            var tg = (img.tags || []).map(function(x){ return String(x).toLowerCase(); });
            if (tg.indexOf('ultra') !== -1) return 'ultra';
            if (IRREALISTE_TAGS.some(function(r){ return tg.indexOf(r) !== -1; })) return 'irrealiste';
            return _protSpecial;
          }
          var hasUltra      = galleryImages.some(function(i){ return imgSpecial(i) === 'ultra'; });
          var hasIrrealiste = galleryImages.some(function(i){ return imgSpecial(i) === 'irrealiste'; });
        %>
        <section class="prot-section">
          <div class="prot-section-header">
            <h2 class="nv-strip-title nv-strip-title--center">Images</h2>
            <div class="prot-gallery-toggles">
              <% if (hasUltra) { %><button type="button" class="wiki-ultra-btn" id="prot-ultra-toggle">Masquer Ultra</button><% } %>
              <% if (hasIrrealiste) { %><button type="button" class="wiki-ultra-btn" id="prot-irrealiste-toggle">Masquer Irr&eacute;aliste</button><% } %>
            </div>
          </div>
          <div class="prot-carousel" id="prot-carousel">
            <button type="button" class="prot-carousel-btn prot-carousel-prev" aria-label="Précédent">&#8249;</button>
            <div class="prot-carousel-track-wrap">
              <div class="prot-carousel-track" id="prot-carousel-track">
                <% galleryImages.forEach(function(img) { %>
                  <% var thumb = (img.imagePaths || [])[0] || ''; %>
                  <% if (thumb) { %>
                    <button type="button" class="prot-carousel-item"
                      title="<%= img.title || '' %>"
                      data-special="<%= imgSpecial(img) %>"
                      data-lightbox="<%= thumb %>"
                      data-image-id="<%= img.id %>"
                      data-rating="<%= img.rating || 0 %>"
                      data-fav="<%= favoriteGalleryIds && favoriteGalleryIds.has(img.id) ? '1' : '0' %>"
                      data-hidden="<%= img.hidden ? '1' : '0' %>">
                      <img src="<%= thumb %>" alt="<%= img.title || protagoniste.name %>" loading="lazy" />
                    </button>
                  <% } %>
                <% }) %>
              </div>
            </div>
            <button type="button" class="prot-carousel-btn prot-carousel-next" aria-label="Suivant">&#8250;</button>
          </div>
        </section>
      <% } %>

      <%# Nouvelles %>
      <% if (nouvelles && nouvelles.length) { %>
        <section class="prot-section">
          <h2 class="nv-strip-title nv-strip-title--center">Nouvelles <span class="prot-section-count">(<%= nouvelles.length %>)</span></h2>
          <div class="prot-nouvelles-list">
            <% nouvelles.forEach(function(n) { %>
              <a href="/nouvelles/<%= n.id %>" class="prot-nouvelle-row">
                <span class="prot-nouvelle-title"><%= n.title %></span>
                <% if (n.summary) { %><span class="prot-nouvelle-summary"><%= n.summary.slice(0,120) %><%= n.summary.length>120?'…':'' %></span><% } %>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <%# Codex %>
      <% if (codexPages && codexPages.length) { %>
        <section class="prot-section">
          <h2 class="nv-strip-title nv-strip-title--center">Codex <span class="prot-section-count">(<%= codexPages.length %>)</span></h2>
          <div class="prot-nouvelles-list">
            <% codexPages.forEach(function(pg) { %>
              <a href="/wiki/<%= pg.id %>" class="prot-nouvelle-row">
                <span class="prot-nouvelle-title"><%= pg.title %></span>
                <% if (pg.category) { %><span class="prot-nouvelle-summary"><%= pg.category %></span><% } %>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if ((!nouvelles || !nouvelles.length) && (!galleryImages || !galleryImages.length) && (!codexPages || !codexPages.length)) { %>
        <p class="nv-empty" style="margin-top:2rem">Ce personnage n&rsquo;appara&icirc;t dans aucun contenu pour le moment.</p>
      <% } %>

    </div><%# /prot-detail-main %>

    <%# ── Colonne droite : paramètres ── %>
    <aside class="prot-detail-sidebar">

      <% if (protagoniste.image_path) { %>
        <div class="prot-ds-img-wrap">
          <img src="<%= protagoniste.image_path %>" alt="<%= protagoniste.name %>"
            class="prot-ds-img prot-lightbox-trigger"
            data-lightbox="<%= protagoniste.image_path %>"
            style="cursor:zoom-in" />
        </div>
      <% } %>

      <% if (protagoniste.gender) { %>
        <div class="prot-ds-gender">
          <span class="prot-ds-gender-icon prot-ds-gender-icon--<%= protagoniste.gender %>">
            <% if (protagoniste.gender === 'femme') { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="5"/><line x1="12" y1="14" x2="12" y2="22"/><line x1="9" y1="19" x2="15" y2="19"/></svg>
            <% } else if (protagoniste.gender === 'homme') { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="14" r="5"/><line x1="14.35" y1="9.65" x2="21" y2="3"/><polyline points="16 3 21 3 21 8"/></svg>
            <% } else { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="17" x2="12" y2="22"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="19" y1="5" x2="16" y2="8"/><polyline points="17 4 20 4 20 7"/></svg>
            <% } %>
          </span>
          <span class="prot-ds-gender-label prot-ds-gender-label--<%= protagoniste.gender %>">
            <%= protagoniste.gender === 'femme' ? 'Femme' : protagoniste.gender === 'homme' ? 'Homme' : 'Autre' %>
          </span>
        </div>
      <% } %>

      <% if (protagoniste.age && protagoniste.age > 0) { %>
        <div class="prot-ds-row">
          <span class="prot-ds-label">&#194;ge</span>
          <span class="prot-ds-value"><%= protagoniste.age %> ans</span>
        </div>
      <% } %>

      <% if (protagoniste.orientation) { %>
        <% var _oriLbl = _orientationLabel[protagoniste.orientation] || { fr: protagoniste.orientation, en: protagoniste.orientation }; %>
        <div class="prot-ds-row">
          <span class="prot-ds-label" data-fr="Orientation" data-en="Orientation">Orientation</span>
          <span class="prot-ds-value" data-fr="<%= _oriLbl.fr %>" data-en="<%= _oriLbl.en %>"><%= _oriLbl.fr %></span>
        </div>
      <% } %>

      <% if (protagoniste.nature && protagoniste.nature !== 'humain') { %>
        <div class="prot-ds-row">
          <span class="prot-ds-label">Nature</span>
          <span class="prot-badge prot-badge--nature"><%= protagoniste.nature === 'pokemon' ? 'Pokémon' : protagoniste.nature %></span>
        </div>
      <% } %>

      <% if (protagoniste.race_name) { %>
        <div class="prot-ds-row prot-ds-row--col">
          <span class="prot-ds-label">Esp&egrave;ce</span>
          <div style="display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.25rem">
            <% var _rc = safeColor(protagoniste.race_color); %>
            <span class="prot-badge prot-badge--race" style="<%= _rc ? 'background:' + _rc + '22;border-color:' + _rc + '55;color:' + _rc : '' %>">
              <%= protagoniste.race_icon ? protagoniste.race_icon + ' ' : '' %><%= protagoniste.race_name %>
            </span>
            <% if (protagoniste.clan_name) { %>
              <% var _cc = safeColor(protagoniste.clan_color); %>
              <span class="prot-badge prot-badge--clan" style="<%= _cc ? 'background:' + _cc + '22;border-color:' + _cc + '55;color:' + _cc : '' %>">
                <%= protagoniste.clan_name %>
              </span>
            <% } %>
          </div>
        </div>
      <% } %>

      <% if (protagoniste.parody) { %>
        <div class="prot-ds-row prot-ds-row--col">
          <span class="prot-ds-label">Univers</span>
          <a href="/parodies/<%= encodeURIComponent(protagoniste.parody) %><% if (protagoniste.sub_parody) { %>/<%= encodeURIComponent(protagoniste.sub_parody) %><% } %>" class="prot-ds-univers">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a14.5 14.5 0 0 0 0 18"/><path d="M12 3a14.5 14.5 0 0 1 0 18"/><line x1="3" y1="12" x2="21" y2="12"/></svg>
            <span><%= protagoniste.parody %><% if (protagoniste.sub_parody) { %><span class="prot-detail-univers-sub"> &rsaquo; <%= protagoniste.sub_parody %></span><% } %></span>
          </a>
        </div>
      <% } %>

      <% if (protagoniste.tags && protagoniste.tags.length) { %>
        <div class="prot-ds-row prot-ds-row--col">
          <span class="prot-ds-label">Tags</span>
          <div class="prot-ds-tags">
            <% protagoniste.tags.forEach(function(tg) { %><span class="tag-badge tag-badge--<%= (tagMeta && tagMeta[tg]) || 'normal' %>"><%= tg %></span><% }) %>
          </div>
        </div>
      <% } %>

    </aside>

  </div><%# /prot-3col-layout %>

  <% if (currentUser && currentUser.isAdmin) { %>
    <a href="/protagonistes/<%= protagoniste.id %>/edit" class="prot-edit-fab" title="Modifier le personnage" aria-label="Modifier le personnage">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    </a>
  <% } %>

</main>

<script nonce="<%= nonce %>">
(function() {
  var track   = document.getElementById('prot-carousel-track');
  if (!track) return;
  var wrap    = track.parentElement;
  var prevBtn = document.querySelector('.prot-carousel-prev');
  var nextBtn = document.querySelector('.prot-carousel-next');
  var pos = 0;

  function visibleItems() { return Array.from(track.querySelectorAll('.prot-carousel-item:not([hidden])')); }

  function update() {
    var items = visibleItems();
    if (!items.length) { track.style.transform='translateX(0)'; if(prevBtn)prevBtn.disabled=true; if(nextBtn)nextBtn.disabled=true; return; }
    var itemW = items[0].offsetWidth + 8;
    var perPage = Math.max(1, Math.floor(wrap.clientWidth / itemW));
    var max = Math.max(0, items.length - perPage);
    pos = Math.min(pos, max);
    var offset = items[pos] ? items[pos].offsetLeft : 0;
    track.style.transform = 'translateX(-' + offset + 'px)';
    if (prevBtn) prevBtn.disabled = pos === 0;
    if (nextBtn) nextBtn.disabled = pos >= max;
  }

  if (prevBtn) prevBtn.addEventListener('click', function() { pos=Math.max(0,pos-1); update(); });
  if (nextBtn) nextBtn.addEventListener('click', function() { pos++; update(); });
  window.addEventListener('resize', function() { pos=0; update(); });

  var hideUltra      = localStorage.getItem('gallery-hide-ultra') === '1';
  var hideIrrealiste = localStorage.getItem('gallery-hide-irrealiste') === '1';

  function applyFilters() {
    Array.from(track.querySelectorAll('.prot-carousel-item')).forEach(function(item) {
      var sp = item.dataset.special || '';
      item.hidden = (hideUltra && sp==='ultra') || (hideIrrealiste && sp==='irrealiste');
    });
    pos = 0; update();
  }

  function syncBtn(btn, hidden, labelHide, labelShow) {
    if (!btn) return;
    btn.textContent = hidden ? labelShow : labelHide;
    btn.classList.toggle('active', hidden);
  }

  var ultraToggle      = document.getElementById('prot-ultra-toggle');
  var irrealisteToggle = document.getElementById('prot-irrealiste-toggle');
  syncBtn(ultraToggle,      hideUltra,      'Masquer Ultra',       'Afficher Ultra');
  syncBtn(irrealisteToggle, hideIrrealiste, 'Masquer Irréaliste',  'Afficher Irréaliste');

  if (ultraToggle) { ultraToggle.addEventListener('click', function() { hideUltra=!hideUltra; localStorage.setItem('gallery-hide-ultra',hideUltra?'1':'0'); syncBtn(ultraToggle,hideUltra,'Masquer Ultra','Afficher Ultra'); applyFilters(); }); }
  if (irrealisteToggle) { irrealisteToggle.addEventListener('click', function() { hideIrrealiste=!hideIrrealiste; localStorage.setItem('gallery-hide-irrealiste',hideIrrealiste?'1':'0'); syncBtn(irrealisteToggle,hideIrrealiste,'Masquer Irréaliste','Afficher Irréaliste'); applyFilters(); }); }
  applyFilters();
})();
</script>

<%# ─── Lightbox galerie ────────────────────────────────────────────────── %>
<div id="prot-lightbox" class="prot-lb" hidden aria-modal="true" role="dialog" aria-label="Image agrandie">
  <div class="prot-lb-image-area">
    <button type="button" class="prot-lb-prev" aria-label="Précédente">&#8249;</button>
    <button type="button" class="prot-lb-next" aria-label="Suivante">&#8250;</button>
    <img class="prot-lb-img" id="prot-lb-img" src="" alt="" />
    <button type="button" class="prot-lb-close-mobile" aria-label="Fermer">&#215;</button>
  </div>
  <aside class="prot-lb-panel">
    <button type="button" class="prot-lb-close" aria-label="Fermer">&#215;</button>
    <% if (locals.currentUser) { %>
    <div class="prot-lb-rating" id="prot-lb-rating">
      <span class="prot-lb-star" data-val="1">&#9733;</span>
      <span class="prot-lb-star" data-val="2">&#9733;</span>
      <span class="prot-lb-star" data-val="3">&#9733;</span>
      <span class="prot-lb-star" data-val="4">&#9733;</span>
      <span class="prot-lb-star" data-val="5">&#9733;</span>
    </div>
    <div class="prot-lb-actions" id="prot-lb-actions">
      <button type="button" class="prot-lb-act-btn" id="prot-lb-collection-btn" title="Ajouter à une collection">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      </button>
      <button type="button" class="prot-lb-act-main" id="prot-lb-fav-btn">J&rsquo;adore</button>
      <button type="button" class="prot-lb-act-btn" id="prot-lb-hide-btn" aria-label="Masquer">
        <svg class="prot-lb-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        <svg class="prot-lb-eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" hidden><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
      </button>
    </div>
    <% } %>
  </aside>
</div>

<%# Collection picker modal %>
<div class="prot-collection-modal-overlay" id="prot-collection-modal" hidden>
  <div class="prot-collection-modal">
    <p class="prot-collection-modal-title">Ajouter &agrave; une collection</p>
    <div class="prot-collection-list" id="prot-collection-list"></div>
    <button type="button" class="link-button" id="prot-collection-new-toggle">+ Nouvelle collection</button>
    <div id="prot-collection-new-form" hidden style="display:flex;flex-direction:column;gap:.4rem;margin-top:.5rem">
      <input type="text" class="filter-profile-modal-input" id="prot-collection-new-title" placeholder="Titre de la collection…" maxlength="80" autocomplete="off" />
      <button type="button" class="filter-profile-modal-confirm" id="prot-collection-new-confirm">Créer et ajouter</button>
    </div>
    <div style="margin-top:.75rem">
      <button type="button" class="filter-profile-modal-cancel" id="prot-collection-close">Fermer</button>
    </div>
  </div>
</div>

<script nonce="<%= nonce %>">
(function() {
  var lb = document.getElementById('prot-lightbox');
  if (!lb) return;

  var lbImg       = document.getElementById('prot-lb-img');
  var ratingBlock = document.getElementById('prot-lb-rating');
  var favBtn      = document.getElementById('prot-lb-fav-btn');
  var hideBtn     = document.getElementById('prot-lb-hide-btn');
  var collBtn     = document.getElementById('prot-lb-collection-btn');
  var collModal   = document.getElementById('prot-collection-modal');
  var collList    = document.getElementById('prot-collection-list');
  var collNewForm = document.getElementById('prot-collection-new-form');
  var collNewTitle= document.getElementById('prot-collection-new-title');
  var collNewConfirm = document.getElementById('prot-collection-new-confirm');
  var collNewToggle = document.getElementById('prot-collection-new-toggle');
  var collClose   = document.getElementById('prot-collection-close');
  var prevBtn     = lb.querySelector('.prot-lb-prev');
  var nextBtn     = lb.querySelector('.prot-lb-next');
  var closeBtn    = lb.querySelector('.prot-lb-close');
  var closeMobile = lb.querySelector('.prot-lb-close-mobile');

  // Items visibles (non masqués par les filtres)
  var items = [];
  var currentIdx = 0;
  var currentGalleryId = 0;
  var collectionGalleryId = 0;

  function getItems() {
    return Array.from(document.querySelectorAll('.prot-carousel-item[data-image-id]:not([hidden])'));
  }

  function updateStars(rating) {
    if (!ratingBlock) return;
    ratingBlock.querySelectorAll('.prot-lb-star').forEach(function(s, i) {
      s.classList.toggle('filled', i < rating);
    });
    ratingBlock.dataset.current = rating;
  }

  function updateFav(active) {
    if (!favBtn) return;
    favBtn.classList.toggle('active', !!active);
  }

  function updateHide(hidden) {
    if (!hideBtn) return;
    var open = hideBtn.querySelector('.prot-lb-eye-open');
    var closed = hideBtn.querySelector('.prot-lb-eye-closed');
    hideBtn.classList.toggle('active', !!hidden);
    if (open) open.hidden = !!hidden;
    if (closed) closed.hidden = !hidden;
  }

  function openAt(idx) {
    items = getItems();
    if (!items.length) return;
    currentIdx = Math.max(0, Math.min(idx, items.length - 1));
    var btn = items[currentIdx];
    var src = btn.dataset.lightbox || '';
    var alt = btn.querySelector('img') ? btn.querySelector('img').alt : '';
    currentGalleryId = Number(btn.dataset.imageId) || 0;

    if (lbImg) { lbImg.src = src; lbImg.alt = alt; }

    if (prevBtn) prevBtn.hidden = items.length <= 1;
    if (nextBtn) nextBtn.hidden = items.length <= 1;

    updateStars(Number(btn.dataset.rating) || 0);
    updateFav(btn.dataset.fav === '1');
    updateHide(btn.dataset.hidden === '1');

    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeLb() {
    lb.hidden = true;
    document.body.style.overflow = '';
    if (lbImg) { lbImg.src = ''; }
  }

  function navigate(dir) {
    items = getItems();
    if (!items.length) return;
    openAt((currentIdx + dir + items.length) % items.length);
  }

  // ─── Ouvrir depuis le carousel (délégation) ──────────────────────────
  var carouselTrack = document.getElementById('prot-carousel-track');
  if (carouselTrack) {
    carouselTrack.style.cursor = 'zoom-in';
    carouselTrack.addEventListener('click', function(e) {
      var btn = e.target.closest('.prot-carousel-item[data-image-id]');
      if (!btn) return;
      items = getItems();
      var idx = items.indexOf(btn);
      openAt(idx >= 0 ? idx : 0);
    });
  }

  // ─── Image de profil (sidebar) ────────────────────────────────────────
  var profileImg = document.querySelector('.prot-lightbox-trigger');
  if (profileImg) {
    profileImg.addEventListener('click', function() {
      if (lbImg) { lbImg.src = profileImg.dataset.lightbox || ''; lbImg.alt = profileImg.alt || ''; }
      currentGalleryId = 0;
      updateStars(0); updateFav(false); updateHide(false);
      if (prevBtn) prevBtn.hidden = true;
      if (nextBtn) nextBtn.hidden = true;
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  }

  // ─── Fermer ───────────────────────────────────────────────────────────
  if (closeBtn) closeBtn.addEventListener('click', closeLb);
  if (closeMobile) closeMobile.addEventListener('click', closeLb);
  lb.querySelector('.prot-lb-image-area').addEventListener('click', function(e) {
    if (e.target === this) closeLb();
  });
  document.addEventListener('keydown', function(e) {
    if (lb.hidden) return;
    if (e.key === 'Escape') closeLb();
    if (e.key === 'ArrowLeft')  { e.preventDefault(); navigate(-1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); navigate(1);  }
  });

  // ─── Prev / Next ──────────────────────────────────────────────────────
  if (prevBtn) prevBtn.addEventListener('click', function() { navigate(-1); });
  if (nextBtn) nextBtn.addEventListener('click', function() { navigate(1);  });

  // ─── Rating ───────────────────────────────────────────────────────────
  if (ratingBlock) {
    var stars = ratingBlock.querySelectorAll('.prot-lb-star');
    // Hover preview
    stars.forEach(function(star) {
      star.addEventListener('mouseenter', function() {
        var val = Number(star.dataset.val);
        stars.forEach(function(s) { s.classList.toggle('hover-preview', Number(s.dataset.val) <= val); });
      });
    });
    ratingBlock.addEventListener('mouseleave', function() {
      stars.forEach(function(s) { s.classList.remove('hover-preview'); });
    });
    ratingBlock.addEventListener('click', function(e) {
      var star = e.target.closest('.prot-lb-star');
      if (!star || !currentGalleryId) return;
      var val = Number(star.dataset.val);
      var cur = Number(ratingBlock.dataset.current) || 0;
      var newRating = cur === val ? 0 : val;
      fetch('/galerie/' + currentGalleryId + '/react', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rating: newRating })
      }).then(function(r) { return r.json(); }).then(function(r) {
        if (!r.ok) return;
        updateStars(newRating);
        var btn = items[currentIdx];
        if (btn) btn.dataset.rating = newRating;
      });
    });
  }

  // ─── J'adore ─────────────────────────────────────────────────────────
  if (favBtn) {
    favBtn.addEventListener('click', function() {
      if (!currentGalleryId) return;
      fetch('/favoris/toggle', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ itemType: 'gallery', itemId: currentGalleryId })
      }).then(function(r) { return r.json(); }).then(function(r) {
        if (!r.ok) return;
        updateFav(r.active);
        var btn = items[currentIdx];
        if (btn) btn.dataset.fav = r.active ? '1' : '0';
      });
    });
  }

  // ─── Masquer ─────────────────────────────────────────────────────────
  if (hideBtn) {
    hideBtn.addEventListener('click', function() {
      if (!currentGalleryId) return;
      var btn = items[currentIdx];
      var nowHidden = btn ? btn.dataset.hidden !== '1' : true;
      fetch('/galerie/' + currentGalleryId + '/react', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hidden: nowHidden })
      }).then(function(r) { return r.json(); }).then(function(r) {
        if (!r.ok) return;
        updateHide(nowHidden);
        if (btn) btn.dataset.hidden = nowHidden ? '1' : '0';
      });
    });
  }

  // ─── Collection ───────────────────────────────────────────────────────
  function renderCollections(collections) {
    if (!collList) return;
    collList.innerHTML = '';
    if (!collections.length) {
      var p = document.createElement('p');
      p.style.cssText = 'color:#999;font-size:.85rem;margin:.5rem 0';
      p.textContent = 'Aucune collection.';
      collList.appendChild(p);
      return;
    }
    collections.forEach(function(col) {
      var row = document.createElement('button');
      row.type = 'button';
      row.className = 'collection-picker-row' + (col.contains ? ' active' : '');
      row.dataset.id = col.id;
      var check = document.createElement('span');
      check.className = 'collection-picker-check';
      check.innerHTML = col.contains ? '&#10003;' : '';
      var label = document.createElement('span');
      label.textContent = col.title;
      row.appendChild(check); row.appendChild(label);
      row.addEventListener('click', function() {
        var add = !row.classList.contains('active');
        fetch('/favoris/collections/' + col.id + '/items', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ galleryId: collectionGalleryId, action: add ? 'add' : 'remove' })
        }).then(function(r) { return r.json(); }).then(function(r) {
          if (!r.ok) return;
          row.classList.toggle('active', add);
          check.innerHTML = add ? '&#10003;' : '';
        });
      });
      collList.appendChild(row);
    });
  }

  if (collBtn) {
    collBtn.addEventListener('click', function() {
      if (!currentGalleryId || !collModal) return;
      collectionGalleryId = currentGalleryId;
      if (collNewForm) collNewForm.hidden = true;
      fetch('/favoris/collections/for-image/' + currentGalleryId)
        .then(function(r) { return r.json(); })
        .then(function(r) { if (r.ok) { renderCollections(r.collections); collModal.hidden = false; } });
    });
  }

  if (collNewToggle) collNewToggle.addEventListener('click', function() {
    if (collNewForm) collNewForm.hidden = !collNewForm.hidden;
  });

  if (collNewConfirm) collNewConfirm.addEventListener('click', function() {
    var title = collNewTitle ? collNewTitle.value.trim() : '';
    if (!title || !collectionGalleryId) return;
    collNewConfirm.disabled = true;
    fetch('/favoris/collections', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title: title, galleryId: collectionGalleryId })
    }).then(function(r) { return r.json(); }).then(function(r) {
      collNewConfirm.disabled = false;
      if (!r.ok) return;
      if (collNewTitle) collNewTitle.value = '';
      if (collNewForm) collNewForm.hidden = true;
      fetch('/favoris/collections/for-image/' + collectionGalleryId)
        .then(function(r2) { return r2.json(); })
        .then(function(r2) { if (r2.ok) renderCollections(r2.collections); });
    }).catch(function() { collNewConfirm.disabled = false; });
  });

  if (collClose) collClose.addEventListener('click', function() { if (collModal) collModal.hidden = true; });
  if (collModal) collModal.addEventListener('click', function(e) { if (e.target === collModal) collModal.hidden = true; });
})();
</script>

<script nonce="<%= nonce %>">
window.PROT_DESC = <%- JSON.stringify({
  description:          { fr: protagoniste.description || '', en: (translationsEn && translationsEn.description) || '' },
  description_physique: { fr: protagoniste.description_physique || '', en: (translationsEn && translationsEn.description_physique) || '' },
  description_oeuvre:   { fr: protagoniste.description_oeuvre || '', en: (translationsEn && translationsEn.description_oeuvre) || '' }
}) %>;
</script>

<script nonce="<%= nonce %>">
(function() {
  function fmtDesc(str) {
    var esc = str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    return '<p>' + esc.replace(/\n\n+/g,'</p><p>').replace(/\n/g,'<br>') + '</p>';
  }
  function applyDescLang(lang) {
    var data = window.PROT_DESC;
    if (!data) return;
    document.querySelectorAll('.prot-desc-body[data-field]').forEach(function(el) {
      var field = el.getAttribute('data-field');
      var texts = data[field];
      if (!texts) return;
      var raw = (lang === 'en' && texts.en) ? texts.en : texts.fr;
      if (raw) el.innerHTML = fmtDesc(raw);
    });
  }
  // Appliquer immédiatement si déjà en anglais
  if (localStorage.getItem('slang') === 'en') applyDescLang('en');

  // Écouter le clic sur le bouton langue (avant que foot.ejs ne le capture aussi)
  var langBtn = document.getElementById('pc-lang-btn');
  if (langBtn) {
    langBtn.addEventListener('click', function() {
      // foot.ejs va toggler localStorage — on lit l'état ACTUEL avant le toggle
      var next = localStorage.getItem('slang') === 'en' ? 'fr' : 'en';
      applyDescLang(next);
    });
  }
})();
</script>

