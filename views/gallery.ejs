<%- include('partials/head', { title: 'Images — ' + config.title }) %>
<main class="container wide gallery-has-sidebar">
  <%- include('partials/top-nav', { config: config, navTitle: 'Galerie', navBack: '/' }) %>

  <%# ─── SIDEBAR GAUCHE ──────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar gallery-sidebar">
    <div class="wiki-chapter-hero" style="--ch-hue: 220">
      <div class="wiki-chapter-hero-top">
        <span></span>
        <h1 class="wiki-chapter-hero-title">Images</h1>
        <span class="wiki-chapter-hero-count" id="gallery-count-hero"><%= items.length %></span>
      </div>
    </div>

    <div class="wiki-sidebar-body">

      <div class="wiki-search-wrap">
        <div class="wiki-search-bar">
          <span class="wiki-search-icon">&#128269;</span>
          <input type="search" id="gallery-search" class="wiki-search-input" placeholder="Rechercher" autocomplete="off" />
          <button type="button" id="gallery-search-clear" class="wiki-search-clear" hidden>&#215;</button>
        </div>
        <span id="gallery-result-count" class="wiki-result-count" hidden></span>
      </div>

      <details class="wiki-sidebar-filter-details">
      <summary class="wiki-sidebar-filter-summary">Filtres</summary>

      <%# Catégories dans un volet réduit %>
      <% if (categories.length) { %>
      <details class="gallery-cat-details">
        <summary class="gallery-cat-summary">Cat&eacute;gories</summary>
        <div class="links-filter" id="gallery-category-filter">
          <% categories.forEach(function (c) { %>
            <button type="button" class="tag-chip" data-category="<%= c.key %>"><%= c.label %></button>
          <% }) %>
        </div>
      </details>
      <% } %>

      <%# Tags avec X|Y (image | BD) %>
      <% if (allTags.length) { %>
      <div class="wiki-filter-section">
        <div class="wiki-tag-cloud" id="gallery-tag-filter">
          <% allTags.forEach(function(t) { %>
            <% var ni = tagImageCounts[t] || 0; var nb = tagBdCounts[t] || 0; %>
            <button type="button" class="wiki-tag-chip" data-tag="<%= t %>" data-state="0">
              <span class="wtc-label"><%= t %></span>
              <% if (ni || nb) { %>
                <span class="wiki-tag-xy">
                  <span class="wiki-tag-xy-pages"><%= ni %></span>|<span class="wiki-tag-xy-imgs"><%= nb %></span>
                </span>
              <% } %>
            </button>
          <% }) %>
        </div>
        <div class="gallery-tag-footer">
          <button type="button" id="gallery-tag-expand-btn" class="wiki-tag-expand-btn" hidden>&#9660; Plus</button>
        </div>
      </div>
      <% } %>

      <%# Toggles %>
      <div class="wiki-filter-section wiki-filter-toggles">
        <button type="button" id="gallery-ultra-toggle" class="wiki-ultra-btn">Ultra</button>
        <button type="button" id="gallery-irrealiste-toggle" class="wiki-ultra-btn">Irr&eacute;aliste</button>
      </div>

      <%# Réinitialiser %>
      <div class="wiki-filter-section">
        <button type="button" id="gallery-reset-filters" class="wiki-filter-reset-btn wiki-filter-reset-btn--danger">R&eacute;initialiser les filtres</button>
      </div>

      <%# Tri %>
      <div class="wiki-filter-section">
        <select id="gallery-sort-select" class="wiki-sort-select">
          <option value="date-desc">Plus r&eacute;cent</option>
          <option value="date-asc">Plus ancien</option>
          <option value="alpha-asc">Ordre alphab&eacute;tique</option>
          <option value="rating-desc">Mieux not&eacute;</option>
          <option value="random">Al&eacute;atoire</option>
        </select>
      </div>

      <%# Taille des cartes %>
      <div class="wiki-filter-section">
        <select id="gallery-size-select" class="wiki-sort-select">
          <option value="small">Petit</option>
          <option value="medium" selected>Moyen</option>
          <option value="large">Grand</option>
          <option value="xlarge">Tr&egrave;s grand</option>
        </select>
      </div>

      <%# Sélection groupée %>
      <% if (currentUser && currentUser.isAdmin) { %>
      <div class="wiki-filter-section">
        <button type="button" class="link-button gallery-select-toggle" id="gallery-select-toggle" hidden>S&eacute;lectionner</button>
      </div>
      <% } %>

      </details>

    </div>
  </aside>

  <%# ─── BARRE SÉLECTION GROUPÉE ──────────────────────────────────────── %>
  <div class="gallery-bulk-bar" id="gallery-bulk-bar" hidden>
    <span class="gallery-bulk-count" id="gallery-bulk-count"></span>
    <button type="button" class="tag-chip" id="gallery-bulk-ultra-on">Marquer Ultra</button>
    <button type="button" class="tag-chip" id="gallery-bulk-ultra-off">Retirer Ultra</button>
    <button type="button" class="tag-chip gallery-bulk-delete" id="gallery-bulk-delete">Supprimer</button>
    <button type="button" class="link-button" id="gallery-bulk-cancel">Annuler</button>
  </div>

  <%# ─── GRILLE ───────────────────────────────────────────────────────── %>
  <div class="gallery-pagination" id="gallery-pagination-top" hidden></div>
  <div class="gallery-grid" id="gallery-grid">
    <% if (!items.length) { %>
      <p class="intro">Aucune image pour l&apos;instant.</p>
    <% } %>
    <% items.forEach(function(item, idx) { %>
      <% var cat = item.category ? categories.find(function (c) { return c.key === item.category; }) : null; %>
      <% var itemSeries = item.id ? (seriesMap[item.id] || []) : []; %>
      <div class="gallery-card"
        data-idx="<%= idx %>"
        data-tags="<%= item.tags.join('|').toLowerCase() %>"
        data-type="<%= item.contentType || 'image' %>"
        data-category="<%= item.category || '' %>"
        data-ultra="<%= item.tags.indexOf('ultra') !== -1 ? '1' : '0' %>"
        data-irrealiste="<%= (item.tags.indexOf('irréaliste') !== -1 || item.tags.indexOf('fantaisie') !== -1) ? '1' : '0' %>"
        data-bd="<%= (item.contentType === 'bd') ? '1' : '0' %>"
        data-title="<%= (item.title || '').toLowerCase() %>"
        data-display-title="<%= (item.title || '').replace(/"/g, '') %>"
        data-images="<%= item.imagePaths.join('|') %>"
        data-wiki-id="<%= item.wikiPageId || '' %>"
        data-gallery-id="<%= item.id || '' %>"
        data-date="<%= item.date || '' %>"
        data-rating="<%= item.rating || 0 %>"
        data-fav="<%= favoriteGalleryIds.indexOf(item.id) !== -1 ? '1' : '0' %>"
        data-processed="<%= (item.processed && item.type === 'gallery') ? '1' : '0' %>"
        data-author="<%= (item.author || '').replace(/"/g, '') %>"
        data-parody="<%= (item.parody || '').replace(/"/g, '') %>"
        data-series="<%= itemSeries.map(function(s){ return s.seriesId; }).join(',') %>">

        <% if (cat) { %><span class="wiki-card-accent" style="background: hsl(<%= cat.hue %>, 55%, 45%)"></span><% } %>

        <% if (item.processed && item.type === 'gallery' && currentUser) { %>
          <span class="gallery-processed-badge" aria-label="Trait&#233;"></span>
        <% } %>

        <% if (item.type === 'gallery' && item.id) { %>
          <label class="gallery-select-check">
            <input type="checkbox" class="gallery-select-input" value="<%= item.id %>" />
            <span class="gallery-select-mark">&#10003;</span>
          </label>
        <% } %>

        <img src="<%= thumbUrl(item.imagePaths[0]) %>" alt="<%= item.title %>" class="gallery-img" loading="lazy" />

        <% if (item.contentType === 'bd' && item.title) { %>
          <div class="gallery-bd-title"><%= item.title %></div>
        <% } %>

        <div class="gallery-card-overlay">
          <span class="wiki-card-badges">
            <% if (item.flame) { %><span class="wiki-card-react-badge" title="J'adore">&#128293;</span><% } %>
            <% if (item.interested) { %><span class="wiki-card-react-badge" title="Ça m'intéresse">&#10024;</span><% } %>
          </span>
          <div class="gallery-card-btns"></div>
        </div>

      </div>
    <% }) %>
  </div>
  <div class="gallery-pagination" id="gallery-pagination-bot" hidden></div>

  <%# ─── FAB + DROPDOWN ───────────────────────────────────────────────── %>
  <% if (currentUser && currentUser.isAdmin) { %>
  <div class="gallery-fab-wrap" id="gallery-fab-wrap">
    <a href="/galerie/series" class="gb-fab-link" title="S&eacute;ries">&#8734;</a>
    <a href="/galerie/batch" class="gb-fab-link" title="Import group&eacute;">&#9776;</a>
    <button type="button" class="wiki-fab-add" id="gallery-fab-main" title="Ajouter une image">+</button>
  </div>

  <%# Modale upload %>
  <div id="gallery-upload-panel" class="gallery-upload-modal" hidden>
    <div class="gallery-upload-modal-back" id="gallery-upload-back"></div>
    <div class="gallery-upload-modal-box">

      <button type="button" id="gallery-upload-cancel" class="gallery-upload-modal-close" title="Fermer">&#215;</button>

      <form method="POST" action="/galerie" enctype="multipart/form-data" class="gallery-upload-form" id="gallery-upload-form">
        <input type="hidden" name="content_type" id="gallery-upload-type" value="image" />

        <%# Titre 3/4 + Catégorie 1/4 %>
        <div class="guf-title-row">
          <input type="text" name="title" class="guf-title-input" placeholder="Titre&hellip;" autocomplete="off" />
          <select name="category" class="wiki-cat-inline-select guf-cat-select">
            <option value="">Cat.</option>
            <% categories.forEach(function (c) { %>
              <option value="<%= c.key %>"><%= c.label %></option>
            <% }) %>
          </select>
        </div>

        <%# Auteur %>
        <div class="guf-ac-wrap">
          <input type="text" name="author" class="guf-author-input" placeholder="Auteur&hellip;" autocomplete="off" />
        </div>

        <%# Parodies (multiple, widget tag + autocomplete) %>
        <div class="guf-ac-wrap">
          <div class="wiki-tags-widget guf-parody-widget">
            <div class="wiki-tags-board">
              <input type="text" class="wiki-tags-typing" placeholder="Parodie d&rsquo;une &oelig;uvre&hellip;" autocomplete="off" />
            </div>
            <input type="hidden" name="parody" class="wiki-tags-hidden" value="" />
          </div>
        </div>

        <%# Tags : ultra/irréaliste en haut, puis saisie + suggestions top tags %>
        <div class="guf-tags-special-row">
          <button type="button" class="wiki-tag-suggest-chip wiki-tag-suggest-chip--special guf-tag-special" data-tag="ultra">ultra</button>
          <button type="button" class="wiki-tag-suggest-chip wiki-tag-suggest-chip--special guf-tag-special" data-tag="irréaliste">irr&eacute;aliste</button>
        </div>
        <div class="wiki-tags-widget">
          <div class="wiki-tags-board">
            <input type="text" class="wiki-tags-typing" placeholder="Tag&hellip;" autocomplete="off" />
          </div>
          <input type="hidden" name="tags" class="wiki-tags-hidden" value="" />
          <% if (topTags && topTags.length) { %>
            <div class="wiki-tag-suggestions guf-tag-suggestions">
              <% topTags.forEach(function(t) { %>
                <button type="button" class="wiki-tag-suggest-chip" data-tag="<%= t %>"><%= t %></button>
              <% }) %>
            </div>
          <% } %>
        </div>

        <%# Zone de dépôt %>
        <div class="guf-drop-zone" id="guf-drop-zone">
          <span class="guf-drop-icon">&#8679;</span>
          <span class="guf-drop-text">D&eacute;posez ici ou</span>
          <label class="guf-browse-btn">
            Parcourir
            <input type="file" name="images" accept="image/*" multiple class="gallery-file-input" required />
          </label>
        </div>

        <%# Prévisualisations %>
        <div class="gallery-upload-previews" id="gallery-upload-previews"></div>
      </form>

      <%# Bouton publier sticky %>
      <div class="guf-sticky-footer">
        <button type="submit" form="gallery-upload-form" class="guf-publish-btn">Publier</button>
      </div>

    </div>
  </div>
  <% } %>

</main>

<%# ─── LIGHTBOX ──────────────────────────────────────────────────────── %>
<div id="gallery-lightbox" class="gallery-lightbox" hidden>

  <%# Zone image : centrée, prend tout l'espace restant %>
  <div class="gallery-lb-image-area">
    <button type="button" class="gallery-lb-prev" title="Pr&eacute;c&eacute;dente">&#8249;</button>
    <button type="button" class="gallery-lb-next" title="Suivante">&#8250;</button>
    <img class="gallery-lb-img" alt="" />
    <div class="gallery-lb-dots" id="gallery-lb-dots" hidden></div>

    <%# Barre de navigation série (superposée en bas) %>
    <div id="gallery-lb-series-nav" class="gallery-lb-series-nav" hidden>
      <button type="button" class="gallery-lb-series-arrow" id="gallery-lb-series-prev" title="Pr&eacute;c&eacute;dent dans la s&eacute;rie">&#8249;</button>
      <span class="gallery-lb-series-info" id="gallery-lb-series-info"></span>
      <button type="button" class="gallery-lb-series-arrow" id="gallery-lb-series-next" title="Suivant dans la s&eacute;rie">&#8250;</button>
    </div>
  </div>

  <%# Volet droit : infos décorrélées de l'image %>
  <aside class="gallery-lb-panel">
    <button type="button" class="gallery-lb-close" title="Fermer">&#215;</button>
    <div class="gallery-lb-tags"></div>
    <a class="gallery-lb-wiki-btn" href="" hidden></a>
    <div class="gallery-lb-notes"></div>
    <div class="gallery-lb-actions" id="gallery-lb-actions" hidden>
      <div class="gallery-lb-react-row">
        <div class="gallery-lb-rating" id="gallery-lb-rating">
          <% for (var lri = 1; lri <= 5; lri++) { %>
            <span class="gallery-star" data-val="<%= lri %>">&#9733;</span>
          <% } %>
        </div>
        <button type="button" class="gallery-lb-fav-btn" id="gallery-lb-fav-btn" title="Favori">&#10084;</button>
      </div>
      <% if (currentUser && currentUser.isAdmin) { %>
        <div class="gallery-lb-admin-row">
          <button type="button" class="gallery-card-btn gallery-lb-edit-btn" id="gallery-lb-edit-btn" title="Modifier">&#9998;</button>
          <button type="button" class="gallery-lb-processed-btn link-button" id="gallery-lb-processed-btn" hidden>Marquer trait&#233;</button>
        </div>
      <% } %>
    </div>
  </aside>

</div>

<script>window.GALLERY_CAN_EDIT = <%= (currentUser && currentUser.isAdmin) ? 'true' : 'false' %>;</script>
<script src="/gallery.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
