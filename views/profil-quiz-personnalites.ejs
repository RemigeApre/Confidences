<%
  var worldMeta = {
    'DL': { name: 'Eau',   tagline: 'Douceur et lien',        hue: 210 },
    'DP': { name: 'Air',   tagline: 'Douceur et sensation',   hue: 160 },
    'BL': { name: 'Terre', tagline: 'Intensité et lien',      hue: 35  },
    'BP': { name: 'Feu',   tagline: 'Intensité et sensation', hue: 15  }
  };
  var worldOrder = ['DL', 'DP', 'BL', 'BP'];
  var normalAxes = axes.filter(function(a) { return !a.is_position; });
%>
<%- include('partials/head', { title: 'Les personnalités — ' + type.name }) %>
<main class="container wide" style="--ch-hue: 270">
  <%- include('partials/top-nav', { config: config, navTitle: 'Les personnalités', navBack: '/quizz/profil' }) %>
  <%- include('partials/mobile-filter-toggle') %>

  <%# ── Sidebar navigation ── %>
  <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer">&times;</button>

    <div class="wiki-chapter-hero">
      <div class="wiki-chapter-hero-top">
        <span class="wiki-chapter-hero-back"></span>
        <h1 class="wiki-chapter-hero-title pqp-sidebar-title" data-fr="Personnalités" data-en="Personalities">Personnalités</h1>
      </div>
    </div>

    <div class="wiki-sidebar-body">
      <a class="pqp-nav-link is-active" data-panel="intro" href="#intro">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><circle cx="6.5" cy="6.5" r="5.5" stroke="currentColor" stroke-width="1.3"/><line x1="6.5" y1="5.5" x2="6.5" y2="9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="6.5" cy="3.8" r=".8" fill="currentColor"/></svg>
        <span data-fr="Introduction" data-en="Introduction">Introduction</span>
      </a>

      <div class="pqp-sidebar-sep"></div>

      <% worldOrder.forEach(function(wk) { %>
      <% var wm = worldMeta[wk]; %>
      <% var wArchs = archetypes.filter(function(a){ return a.code && a.code.slice(0,2) === wk; }); %>
      <div class="pqp-nav-world-group" data-world="<%= wk %>">
        <button class="pqp-nav-world-btn" data-panel="world-<%= wk %>" style="--w-hue:<%= wm.hue %>">
          <span class="pqp-nav-world-dot"></span>
          <span class="pqp-nav-world-label">
            <span class="pqp-nav-world-name">Monde <%= wm.name %></span>
            <span class="pqp-nav-world-tag"><%= wm.tagline %></span>
          </span>
          <svg class="pqp-nav-chevron" width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M2.5 4l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="pqp-nav-archs">
          <% wArchs.forEach(function(a) { %>
          <a class="pqp-nav-arch" data-panel="arch-<%= a.code %>" href="#arch-<%= a.code %>" style="--w-hue:<%= wm.hue %>">
            <span class="pqp-nav-arch-code"><%= a.code %></span>
            <span class="pqp-nav-arch-name"><%= a.name || a.code %></span>
          </a>
          <% }) %>
        </div>
      </div>
      <% }) %>

      <div class="pqp-sidebar-sep" style="margin-top:auto"></div>
      <a href="/quizz/profil/<%= type.slug %>" class="pqp-nav-cta" data-fr="Passer le test" data-en="Take the test">Passer le test</a>
    </div>
  </aside>

  <%# ── Contenu ── %>
  <div class="pqp-content" id="pqpContent">

    <%# Panel : Introduction %>
    <section class="pqp-panel is-active" id="panel-intro">
      <div class="pqp-panel-inner">
        <h1 class="pqp-panel-title">Les 32 personnalités</h1>
        <p class="pqp-panel-lead">
          Chaque profil se lit en cinq lettres&nbsp;: <strong>Rythme · Moteur · Nouveauté · Scénario · Plaisir</strong>,
          suivi d'une position (<strong>D</strong>&nbsp;Dominant · <strong>S</strong>&nbsp;Soumis · <strong>SW</strong>&nbsp;Souple).
        </p>

        <h2 class="pqp-section-heading" data-fr="Les cinq dimensions" data-en="The five dimensions">Les cinq dimensions</h2>
        <div class="pqpers-axes-grid">
          <% normalAxes.forEach(function(axis) { %>
          <div class="pqpers-axis-card">
            <div class="pqpers-axis-card-name"><%= axis.name %></div>
            <div class="pqpers-axis-card-poles">
              <span class="pqpers-axis-card-pole pqpers-axis-card-pole--1"><%= axis.pole1_label || axis.pole1_code %></span>
              <span class="pqpers-axis-card-sep">↔</span>
              <span class="pqpers-axis-card-pole pqpers-axis-card-pole--2"><%= axis.pole2_label || axis.pole2_code %></span>
            </div>
          </div>
          <% }) %>
        </div>

        <h2 class="pqp-section-heading" data-fr="Les quatre familles" data-en="The four families">Les quatre familles</h2>
        <div class="pqp-worlds-overview">
          <% worldOrder.forEach(function(wk) { %>
          <% var wm = worldMeta[wk]; %>
          <% var wArchs = archetypes.filter(function(a){ return a.code && a.code.slice(0,2) === wk; }); %>
          <button class="pqp-world-card" data-panel="world-<%= wk %>" style="--w-hue:<%= wm.hue %>">
            <div class="pqp-world-card-dot"></div>
            <div class="pqp-world-card-body">
              <span class="pqp-world-card-code"><%= wk %></span>
              <span class="pqp-world-card-name">Monde <%= wm.name %></span>
              <span class="pqp-world-card-sep">·</span>
              <span class="pqp-world-card-tag"><%= wm.tagline %></span>
            </div>
            <span class="pqp-world-card-count"><%= wArchs.length %> profils</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 3.5l3.5 3.5-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <% }) %>
        </div>
      </div>
    </section>

    <%# Panels : Familles %>
    <% worldOrder.forEach(function(wk) { %>
    <% var wm = worldMeta[wk]; %>
    <% var wArchs = archetypes.filter(function(a){ return a.code && a.code.slice(0,2) === wk; }); %>
    <section class="pqp-panel" id="panel-world-<%= wk %>" style="--w-hue:<%= wm.hue %>">
      <div class="pqp-panel-inner">
        <div class="pqp-world-hero">
          <div class="pqp-world-hero-glow"></div>
          <span class="pqp-world-hero-code"><%= wk %></span>
          <div class="pqp-world-hero-text">
            <h1 class="pqp-world-hero-name">Monde <%= wm.name %></h1>
            <p class="pqp-world-hero-tagline"><%= wm.tagline %></p>
          </div>
        </div>
        <div class="pqp-archs-list">
          <% wArchs.forEach(function(a) { %>
          <button class="pqp-arch-row" data-panel="arch-<%= a.code %>" style="--w-hue:<%= wm.hue %>">
            <span class="pqp-arch-row-code"><%= a.code %></span>
            <div class="pqp-arch-row-body">
              <span class="pqp-arch-row-name"><%= a.name || a.code %></span>
              <% if (a.description) { %>
              <span class="pqp-arch-row-preview"><%= a.description.slice(0, 100) %><%= a.description.length > 100 ? '…' : '' %></span>
              <% } %>
            </div>
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M4.5 3l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <% }) %>
        </div>
      </div>
    </section>
    <% }) %>

    <%# Panels : Archétypes %>
    <% archetypes.forEach(function(a) { %>
    <% var wk = a.code ? a.code.slice(0,2) : 'DL'; %>
    <% var wm = worldMeta[wk] || worldMeta['DL']; %>
    <section class="pqp-panel" id="panel-arch-<%= a.code %>" style="--w-hue:<%= wm.hue %>">
      <div class="pqp-panel-inner">
        <button class="pqp-back-btn" data-panel="world-<%= wk %>">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M8.5 9.5L5 6.5l3.5-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Monde <%= wm.name %>
        </button>
        <div class="pqp-arch-hero">
          <span class="pqp-arch-hero-code"><%= a.code %></span>
          <div class="pqp-arch-hero-text">
            <h1 class="pqp-arch-hero-name"><%= a.name || a.code %></h1>
            <span class="pqp-arch-hero-world">Monde <%= wm.name %> · <%= wm.tagline %></span>
          </div>
        </div>
        <% if (a.description) { %>
        <p class="pqp-arch-desc"><%= a.description %></p>
        <% } else { %>
        <p class="pqp-arch-desc pqp-arch-desc--empty">Aucune description disponible pour ce profil.</p>
        <% } %>
      </div>
    </section>
    <% }) %>

  </div><%# end .pqp-content %>

  <%- include('partials/foot') %>
</main>

<script nonce="<%= nonce %>">
(function () {
  var allPanels = document.querySelectorAll('.pqp-panel');

  function navigate(panelId, push) {
    allPanels.forEach(function (p) { p.classList.remove('is-active'); });
    var target = document.getElementById('panel-' + panelId);
    if (!target) return;
    target.classList.add('is-active');
    window.scrollTo(0, 0);

    document.querySelectorAll('[data-panel]').forEach(function (el) { el.classList.remove('is-active'); });
    document.querySelectorAll('[data-panel="' + panelId + '"]').forEach(function (el) { el.classList.add('is-active'); });

    var m = panelId.match(/^(world|arch)-([A-Z]{2})/);
    if (m) {
      var group = document.querySelector('.pqp-nav-world-group[data-world="' + m[2] + '"]');
      if (group) group.classList.add('is-expanded');
    }

    if (push !== false) history.pushState(null, '', '#' + panelId);
  }

  document.querySelectorAll('[data-panel]').forEach(function (el) {
    el.addEventListener('click', function (e) {
      e.preventDefault();
      var panelId = el.getAttribute('data-panel');
      if (el.classList.contains('pqp-nav-world-btn')) {
        var group = document.querySelector('.pqp-nav-world-group[data-world="' + panelId.replace('world-', '') + '"]');
        if (group) group.classList.toggle('is-expanded');
      }
      navigate(panelId);
    });
  });

  window.addEventListener('popstate', function () {
    var h = location.hash.replace('#', '');
    if (h && document.getElementById('panel-' + h)) navigate(h, false);
  });

  var hash = location.hash.replace('#', '');
  if (hash && document.getElementById('panel-' + hash)) navigate(hash, false);
  else navigate('intro', false);
})();
</script>
