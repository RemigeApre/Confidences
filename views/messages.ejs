<%- include('partials/head', { title: 'Messages' }) %>
<main class="container narrow msg-list-page">
  <%- include('partials/top-nav', { config: config }) %>

  <div class="msg-list-header">
    <h1 class="msg-list-title">Messages</h1>
  </div>

  <%# Bandeau "+ Nouvelle discussion" %>
  <% if (friends && friends.length) { %>
  <details class="msg-new-conv" id="msg-new-conv">
    <summary class="msg-new-conv-toggle">+ Nouvelle discussion</summary>
    <ul class="msg-new-conv-list">
      <% friends.forEach(function(f) { %>
      <li>
        <a href="/messages/<%= f.id %>" class="msg-new-conv-friend">
          <div class="msg-list-avatar" style="background:<%= f.profile_color || '#6b7280' %>">
            <%= (f.display_name || '?').charAt(0).toUpperCase() %>
          </div>
          <span><%= f.display_name %></span>
        </a>
      </li>
      <% }) %>
    </ul>
  </details>
  <% } %>

  <% if (!convs || !convs.length) { %>
    <p class="msg-list-empty">Aucune conversation pour l'instant.</p>
  <% } else { %>
  <ul class="msg-list">
    <% convs.forEach(function(c) { %>
    <li class="msg-list-item<%= c.unread > 0 ? ' msg-list-item--unread' : '' %>">
      <a href="/messages/<%= c.partnerId %>" class="msg-list-link">
        <div class="msg-list-avatar" style="background:<%= c.partnerColor || '#6b7280' %>">
          <%= (c.partnerName || '?').charAt(0).toUpperCase() %>
        </div>
        <div class="msg-list-info">
          <span class="msg-list-name"><%= c.partnerName %></span>
          <span class="msg-list-date"><%= new Date(c.last_message_at).toLocaleDateString('fr-FR', {day:'numeric',month:'short'}) %></span>
        </div>
        <% if (c.unread > 0) { %>
          <span class="msg-list-unread-badge"><%= c.unread %></span>
        <% } %>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>

</main>
<%- include('partials/foot') %>
