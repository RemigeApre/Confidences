<%- include('partials/head', { title: partner ? 'Message — ' + partner.displayName : 'Messages' }) %>
<main class="msg-app<% if (partner) { %> msg-app--thread-open<% } %>">
  <%- include('partials/top-nav', { config: config }) %>

  <%# ── Panneau droit : fil de discussion ────────────────────────────── %>
  <div class="msg-panel-thread">
    <% if (partner) { %>

      <div id="msg-state"
           data-conv-id="<%= conv.id %>"
           data-partner-id="<%= partner.id %>"
           data-my-id="<%= currentUser.id %>"
           data-partner-is-admin="<%= partner.isAdmin ? '1' : '' %>">
      </div>

      <%
        // "Vu pour la dernière fois" : last_active_at est tantôt une chaîne
        // SQLite naïve "YYYY-MM-DD HH:MM:SS" (sans fuseau, ex. created_at),
        // tantôt un vrai ISO déjà tagué "...Z" (touchLastActive utilise
        // new Date().toISOString()) — lui rajouter un "Z" à l'aveugle donne
        // "...ZZ" et une Invalid Date. On ne retague que si aucun "T" n'est
        // déjà présent (donc format SQLite naïf).
        var _lastActiveLabel = null;
        if (partner.lastActiveAt) {
          var _rawLastActive = partner.lastActiveAt;
          var _isoLastActive = _rawLastActive.indexOf('T') === -1 ? _rawLastActive.replace(' ', 'T') + 'Z' : _rawLastActive;
          var _lastActiveDate = new Date(_isoLastActive);
          if (!isNaN(_lastActiveDate.getTime())) {
            var _lastActiveDiff = Date.now() - _lastActiveDate.getTime();
            if (_lastActiveDiff < 2 * 60 * 1000) {
              _lastActiveLabel = 'En ligne';
            } else {
              var _now = new Date();
              var _sameDay = _lastActiveDate.toDateString() === _now.toDateString();
              _lastActiveLabel = _sameDay
                ? 'Vu à ' + _lastActiveDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })
                : 'Vu le ' + _lastActiveDate.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
            }
          }
        }
      %>
      <div class="msg-thread-header">
        <a href="/messages" class="msg-thread-back" aria-label="Retour aux messages">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <%- include('partials/msg-avatar', { avatarClass: 'msg-thread-avatar', thumb: partnerAvatarThumb, crop: partnerAvatarCrop, color: partner.profileColor, initial: partner.displayName }) %>
        <div class="msg-thread-identity">
          <a href="/profil/<%= partner.displayName || partner.username %>" class="msg-thread-name">
            <%= partner.displayName %>
            <% if (partner.isAdmin) { %><span class="msg-admin-badge">admin</span><% } %>
          </a>
          <% if (_lastActiveLabel) { %><span class="msg-thread-lastseen"><%= _lastActiveLabel %></span><% } %>
        </div>
        <a href="/messages/<%= partner.id %>/library" class="msg-thread-library-btn" title="Bibliothèque partagée" aria-label="Bibliothèque partagée">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/></svg>
        </a>
        <details class="pc-hover-menu msg-thread-options" id="msg-thread-options">
          <summary class="msg-thread-options-btn" title="Options" aria-label="Options">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
          </summary>
          <div class="msg-thread-options-menu">
            <button type="button" class="msg-thread-options-item" id="msg-pin-btn" data-conv-id="<%= conv.id %>" data-pinned="<%= convPinned ? '1' : '0' %>">
              <span class="msg-pin-label"><%= convPinned ? 'Désépingler' : 'Épingler' %></span>
            </button>
            <button type="button" class="msg-thread-options-item" id="msg-mute-btn" data-conv-id="<%= conv.id %>" data-muted="<%= convMuted ? '1' : '0' %>">
              <span class="msg-mute-label"><%= convMuted ? 'Réactiver les notifications' : 'Mettre en sourdine' %></span>
            </button>
            <button type="button" class="msg-thread-options-item" id="msg-unread-btn" data-conv-id="<%= conv.id %>">Marquer comme non lu</button>
            <button type="button" class="msg-thread-options-item msg-thread-options-item--danger" id="msg-delete-conv-btn" data-conv-id="<%= conv.id %>">Supprimer la discussion</button>
          </div>
        </details>
      </div>

      <div class="msg-lightbox" id="msg-lightbox" hidden role="dialog" aria-modal="true" aria-label="Image en grand">
        <button type="button" class="msg-lightbox-close" id="msg-lightbox-close" aria-label="Fermer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <img class="msg-lightbox-img" id="msg-lightbox-img" src="" alt="" />
      </div>

      <div class="msg-thread-body" id="msg-thread-body">
        <div class="msg-reaction-picker" id="msg-reaction-picker" hidden>
          <% ['❤️','😂','👍','😮','😢','🙏'].forEach(function (e) { %>
            <button type="button" class="msg-reaction-picker-opt" data-emoji="<%= e %>"><%= e %></button>
          <% }) %>
        </div>
        <button class="msg-load-more-btn" id="msg-load-more-btn" type="button" hidden>Charger plus</button>
        <div class="msg-thread-messages" id="msg-thread-messages">
          <% if (showAdminNotice) { %>
            <div class="msg-system-banner">&Eacute;vitez le spam ou tout comportement d&eacute;plac&eacute;. Parlez-nous de vos id&eacute;es, de vos critiques et de vos probl&egrave;mes.</div>
          <% } %>
          <% var _prevTs = null; %>
          <% messages.forEach(function(m) { %>
          <% var _ts = new Date(m.created_at).getTime(); %>
          <% if (_prevTs === null || (_ts - _prevTs) >= 2 * 60 * 60 * 1000) { %>
            <div class="msg-time-divider"><%= new Date(m.created_at).toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'}) %></div>
          <% } %>
          <% _prevTs = _ts; %>
          <article class="msg-bubble msg-bubble--<%= m.sender_id === currentUser.id ? 'me' : 'them' %><%= (m.sender_id !== currentUser.id && partner.isAdmin) ? ' msg-bubble--admin' : '' %>"
                   data-id="<%= m.id %>" data-ts="<%= m.created_at %>">
            <div class="msg-bubble-inner">
              <% if (!m.content_ref) { %>
                <div class="msg-bubble-text"><%- m.payload.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>') %></div>
              <% } %>
              <% if (m.content_ref) { %>
                <div class="msg-bubble-ref" data-ref="<%= encodeURIComponent(m.content_ref) %>"></div>
              <% } %>
              <% if (m.reaction) { %><span class="msg-bubble-reaction" data-id="<%= m.id %>"><%= m.reaction %></span><% } %>
            </div>
            <button type="button" class="msg-bubble-react-btn" data-id="<%= m.id %>" aria-label="Réagir" title="Réagir">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M6.5 12c.8 1.2 2 2 3.5 2s2.7-.8 3.5-2"/><circle cx="7.3" cy="8" r=".9" fill="currentColor" stroke="none"/><circle cx="12.7" cy="8" r=".9" fill="currentColor" stroke="none"/></svg>
            </button>
          </article>
          <% }) %>
          <% var _lastMsg = messages.length ? messages[messages.length - 1] : null; %>
          <% var _showSeen = _lastMsg && _lastMsg.sender_id === currentUser.id && _lastMsg.read_at; %>
          <div class="msg-seen-indicator" id="msg-seen-indicator"<%= _showSeen ? '' : ' hidden' %>>Vu</div>
          <div class="msg-typing-indicator" id="msg-typing-indicator" hidden aria-live="polite">
            <div class="msg-typing-dots"><span></span><span></span><span></span></div>
          </div>
        </div>
      </div>

      <form class="msg-compose" id="msg-compose" autocomplete="off">
        <textarea class="msg-compose-input" id="msg-compose-input"
                  placeholder="Votre message…" rows="1" maxlength="4000"
                  aria-label="Votre message"></textarea>
        <button class="msg-compose-send" type="submit" aria-label="Envoyer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </form>

    <% } else { %>
      <div class="msg-panel-empty">
        <span>Choisissez une conversation</span>
      </div>
    <% } %>
  </div>

  <%# ── Panneau gauche : liste des conversations ─────────────────────── %>
  <div class="msg-panel-list">
    <% if (friends && friends.length) { %>
    <details class="msg-new-conv" id="msg-new-conv">
      <summary class="msg-new-conv-toggle">+ Nouvelle discussion</summary>
      <ul class="msg-new-conv-list">
        <% friends.forEach(function(f) { %>
        <li>
          <a href="/messages/<%= f.id %>" class="msg-new-conv-friend">
            <%- include('partials/msg-avatar', { avatarClass: 'msg-list-avatar', thumb: f.avatarThumb, crop: f.avatarCrop, color: f.profile_color, initial: f.display_name }) %>
            <span><%= f.display_name %></span>
          </a>
        </li>
        <% }) %>
      </ul>
    </details>
    <% } %>

    <% var _currentPartnerId = partner ? partner.id : null; %>
    <% var _adminConvs = (convs || []).filter(function (c) { return c.partnerIsAdmin; }); %>
    <% var _normalConvs = (convs || []).filter(function (c) { return !c.partnerIsAdmin; }); %>

    <% if (!convs || !convs.length) { %>
      <p class="msg-list-empty">Aucune conversation pour l'instant.</p>
    <% } else { %>
      <% if (_adminConvs.length) { %>
      <div class="msg-admin-section">
        <div class="msg-admin-section-label">Administration</div>
        <ul class="msg-list">
          <% _adminConvs.forEach(function (c) { %>
            <%- include('partials/msg-conv-item', { c: c, currentPartnerId: _currentPartnerId }) %>
          <% }) %>
        </ul>
      </div>
      <% } %>
      <% if (_normalConvs.length) { %>
      <ul class="msg-list">
        <% _normalConvs.forEach(function (c) { %>
          <%- include('partials/msg-conv-item', { c: c, currentPartnerId: _currentPartnerId }) %>
        <% }) %>
      </ul>
      <% } %>
    <% } %>
  </div>

</main>

<% if (partner) { %>
<script nonce="<%= nonce %>">
(function () {
  'use strict';

  var state          = document.getElementById('msg-state').dataset;
  var convId         = parseInt(state.convId, 10);
  var partnerId      = parseInt(state.partnerId, 10);
  var myId           = parseInt(state.myId, 10);
  var partnerIsAdmin = !!state.partnerIsAdmin;

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Rendu des références de contenu ──────────────────────────────────────
  var _refCache = {};

  var _refIcons = {
    image: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>',
    wiki:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
    bd:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
  };

  async function renderContentRef(el, ref) {
    var href = ref.type === 'image' ? '/galerie/' + ref.id
             : ref.type === 'bd'    ? '/bd/' + ref.id
             : '/wiki/' + ref.id;
    var thumb = null, title = ref.title || '', full = null;
    var cacheKey = ref.type + ':' + ref.id;
    if (_refCache[cacheKey]) {
      thumb = _refCache[cacheKey].thumb;
      title = _refCache[cacheKey].title || title;
      full = _refCache[cacheKey].full || null;
    } else {
      try {
        var r = await fetch('/messages/ref-card/' + ref.type + '/' + ref.id);
        var d = await r.json();
        _refCache[cacheKey] = d;
        if (d.thumb) thumb = d.thumb;
        if (d.title) title = d.title;
        full = d.full || null;
      } catch (_) {}
    }

    if (ref.type === 'image') {
      // Image seule, sans cadre ni titre — clic = visionneuse plein écran
      el.innerHTML = thumb
        ? '<a class="msg-ref-img" href="' + escHtml(full || thumb) + '" data-full="' + escHtml(full || thumb) + '"><img src="' + escHtml(thumb) + '" alt="" loading="lazy"></a>'
        : '<a class="msg-ref-card msg-ref-card--noimg" href="' + href + '">' + _refIcons.image + '</a>';
    } else {
      // Codex / BD : vignette + titre
      var icon = thumb
        ? '<img class="msg-ref-thumb" src="' + escHtml(thumb) + '" alt="" loading="lazy">'
        : '<span class="msg-ref-thumb msg-ref-thumb--icon">' + (_refIcons[ref.type] || '') + '</span>';
      el.innerHTML = '<a class="msg-ref-card" href="' + href + '">' +
        icon +
        '<span class="msg-ref-title">' + escHtml(title) + '</span>' +
        '</a>';
    }
  }

  document.querySelectorAll('.msg-bubble-ref[data-ref]').forEach(function (el) {
    try { renderContentRef(el, JSON.parse(decodeURIComponent(el.dataset.ref))); } catch (_) {}
  });

  // ── Visionneuse d'image (remplace la navigation vers /galerie/:id au clic
  // sur une image partagée) ─────────────────────────────────────────────────
  var lightbox    = document.getElementById('msg-lightbox');
  var lightboxImg = document.getElementById('msg-lightbox-img');
  var lightboxClose = document.getElementById('msg-lightbox-close');

  function openLightbox(src) {
    if (!lightbox || !lightboxImg || !src) return;
    lightboxImg.src = src;
    lightbox.hidden = false;
  }
  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    lightboxImg.src = '';
  }
  if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
  if (lightbox) {
    lightbox.addEventListener('click', function (e) { if (e.target === lightbox) closeLightbox(); });
  }
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLightbox(); });
  document.addEventListener('click', function (e) {
    var imgLink = e.target.closest('.msg-ref-img[data-full]');
    if (!imgLink) return;
    e.preventDefault();
    openLightbox(imgLink.dataset.full);
  });

  // ── Envoi d'un message ───────────────────────────────────────────────────
  var compose = document.getElementById('msg-compose');
  var input   = document.getElementById('msg-compose-input');

  // ── Indicateur de frappe ─────────────────────────────────────────────────
  var typingTimer = null;
  var lastTypingSent = 0;

  function sendTyping() {
    fetch('/messages/' + partnerId + '/typing', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
    }).catch(function () {});
  }

  if (compose) {
    input.addEventListener('input', function () {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 160) + 'px';
      var now = Date.now();
      if (now - lastTypingSent > 2000) {
        sendTyping();
        lastTypingSent = now;
      }
    });

    async function doSend() {
      var text = input.value.trim();
      if (!text) return;
      input.value = '';
      input.style.height = 'auto';
      try {
        var r = await fetch('/messages/' + partnerId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: text }),
        });
        var data = await r.json();
        if (data.ok) {
          if (data.msgId > lastMsgId) lastMsgId = data.msgId;
          appendBubble(data.msgId, text, new Date().toISOString(), true, null, null);
        }
      } catch (_) {}
    }

    compose.addEventListener('submit', function (e) {
      e.preventDefault();
      doSend();
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        doSend();
      }
    });
  }

  // Pas d'heure sur chaque bulle (trop lourd) : juste un séparateur discret
  // quand l'écart avec le message précédent dépasse 5 minutes.
  var lastRenderedTs = null;
  (function () {
    var bubbles = document.querySelectorAll('#msg-thread-messages .msg-bubble');
    if (bubbles.length) {
      var t = Date.parse(bubbles[bubbles.length - 1].dataset.ts);
      if (!isNaN(t)) lastRenderedTs = t;
    }
  })();

  function appendBubble(id, text, ts, isMe, contentRef, reaction) {
    if (document.querySelector('#msg-thread-messages .msg-bubble[data-id="' + id + '"]')) return;
    var container = document.getElementById('msg-thread-messages');
    if (!container) return;
    // insertBefore l'indicateur "Vu" (ou à défaut celui de frappe), qui reste
    // en fin de conteneur (sinon tout ajout ultérieur atterrit au-dessus).
    var seenIndicator = document.getElementById('msg-seen-indicator');
    var anchor = seenIndicator || document.getElementById('msg-typing-indicator') || null;
    // Un nouveau message rend l'état "Vu" précédent obsolète — il ne
    // concernait que l'ancien dernier message. Il réapparaîtra si/quand le
    // nouveau dernier message (le mien) est lu, via l'événement SSE "seen".
    if (seenIndicator) seenIndicator.hidden = true;
    var tsMs = Date.parse(ts);
    if (lastRenderedTs === null || (tsMs - lastRenderedTs) >= 2 * 60 * 60 * 1000) {
      var divider = document.createElement('div');
      divider.className = 'msg-time-divider';
      divider.textContent = new Date(ts).toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'});
      container.insertBefore(divider, anchor);
    }
    lastRenderedTs = tsMs;
    var el = document.createElement('article');
    el.className = 'msg-bubble msg-bubble--' + (isMe ? 'me' : 'them') + (!isMe && partnerIsAdmin ? ' msg-bubble--admin' : '');
    el.dataset.id = id;
    var refHtml = '';
    if (contentRef) {
      refHtml = '<div class="msg-bubble-ref"></div>';
    }
    // Texte masqué si contenu partagé (le payload n'est alors qu'un libellé
    // auto-généré redondant avec le titre déjà affiché par la vignette).
    var textHtml = contentRef ? '' : '<div class="msg-bubble-text">' + escHtml(text).replace(/\n/g, '<br>') + '</div>';
    var reactionHtml = reaction ? '<span class="msg-bubble-reaction" data-id="' + id + '">' + reaction + '</span>' : '';
    el.innerHTML =
      '<div class="msg-bubble-inner">' +
        textHtml +
        refHtml +
        reactionHtml +
      '</div>' +
      '<button type="button" class="msg-bubble-react-btn" data-id="' + id + '" aria-label="Réagir" title="Réagir">' +
        '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M6.5 12c.8 1.2 2 2 3.5 2s2.7-.8 3.5-2"/><circle cx="7.3" cy="8" r=".9" fill="currentColor" stroke="none"/><circle cx="12.7" cy="8" r=".9" fill="currentColor" stroke="none"/></svg>' +
      '</button>';
    if (contentRef) {
      try { renderContentRef(el.querySelector('.msg-bubble-ref'), contentRef); } catch (_) {}
    }
    container.insertBefore(el, anchor);
    scrollToBottom();
  }

  // ── Réactions emoji ──────────────────────────────────────────────────────
  var reactionPicker = document.getElementById('msg-reaction-picker');
  var reactionTargetId = null;

  function closeReactionPicker() {
    if (reactionPicker) reactionPicker.hidden = true;
    reactionTargetId = null;
  }

  function applyReaction(id, emoji) {
    var bubble = document.querySelector('.msg-bubble[data-id="' + id + '"]');
    if (!bubble) return;
    var inner = bubble.querySelector('.msg-bubble-inner');
    var existing = bubble.querySelector('.msg-bubble-reaction');
    if (!emoji) {
      if (existing) existing.remove();
      return;
    }
    if (existing) {
      existing.textContent = emoji;
    } else {
      var span = document.createElement('span');
      span.className = 'msg-bubble-reaction';
      span.dataset.id = id;
      span.textContent = emoji;
      inner.appendChild(span);
    }
  }

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.msg-bubble-react-btn');
    if (btn) {
      var id = parseInt(btn.dataset.id, 10);
      if (reactionTargetId === id && reactionPicker && !reactionPicker.hidden) {
        closeReactionPicker();
        return;
      }
      reactionTargetId = id;
      if (reactionPicker) {
        var rect = btn.getBoundingClientRect();
        reactionPicker.hidden = false;
        // Dimensions réelles connues seulement une fois visible (hidden ne
        // les donne pas) — on les lit après avoir affiché le panneau, pour
        // le recaler avant qu'il ne déborde de l'écran (important en
        // téléphone, où la bulle peut être tout contre un bord).
        var pw = reactionPicker.offsetWidth || 220;
        var ph = reactionPicker.offsetHeight || 44;
        var top = Math.min(Math.max(8, rect.top - ph - 8), window.innerHeight - ph - 8);
        var left = Math.min(Math.max(8, rect.left - pw / 2 + 16), window.innerWidth - pw - 8);
        reactionPicker.style.top = top + 'px';
        reactionPicker.style.left = left + 'px';
      }
      return;
    }
    if (reactionPicker && !reactionPicker.hidden && !reactionPicker.contains(e.target)) {
      closeReactionPicker();
    }
  });

  if (reactionPicker) {
    reactionPicker.querySelectorAll('.msg-reaction-picker-opt').forEach(function (opt) {
      opt.addEventListener('click', async function () {
        var id = reactionTargetId;
        var emoji = opt.dataset.emoji;
        closeReactionPicker();
        if (!id) return;
        var bubble = document.querySelector('.msg-bubble[data-id="' + id + '"]');
        var existing = bubble ? bubble.querySelector('.msg-bubble-reaction') : null;
        var next = (existing && existing.textContent === emoji) ? '' : emoji;
        applyReaction(id, next);
        try {
          await fetch('/messages/msg/' + id + '/react', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ emoji: next }),
          });
        } catch (_) {}
      });
    });
  }

  // ── Suppression de la discussion ──────────────────────────────────────────
  var deleteConvBtn = document.getElementById('msg-delete-conv-btn');
  if (deleteConvBtn) {
    deleteConvBtn.addEventListener('click', async function () {
      if (!confirm('Supprimer toute la discussion ? Cette action est définitive pour vous.')) return;
      var cid = parseInt(this.dataset.convId, 10);
      var r = await fetch('/messages/conv/' + cid, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
      var data = await r.json();
      if (data.ok) window.location.href = '/messages';
    });
  }

  // ── Épingler / sourdine / marquer non lu (menu ⋮) ─────────────────────────
  // Pas de fermeture programmatique ici : le menu ⋮ réutilise le script
  // générique .pc-hover-menu (voir nav.js), qui garde son propre état
  // ouvert/fermé — le ré-ouvrir/fermer nous-mêmes le désynchroniserait.
  // Un clic ailleurs sur la page le referme déjà (comportement générique).
  var pinBtn = document.getElementById('msg-pin-btn');
  if (pinBtn) {
    pinBtn.addEventListener('click', async function () {
      var cid = parseInt(this.dataset.convId, 10);
      var nowPinned = this.dataset.pinned !== '1';
      try {
        await fetch('/messages/conv/' + cid + '/pin', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pinned: nowPinned }),
        });
      } catch (_) {}
      this.dataset.pinned = nowPinned ? '1' : '0';
      this.querySelector('.msg-pin-label').textContent = nowPinned ? 'Désépingler' : 'Épingler';
    });
  }

  var muteBtn = document.getElementById('msg-mute-btn');
  if (muteBtn) {
    muteBtn.addEventListener('click', async function () {
      var cid = parseInt(this.dataset.convId, 10);
      var nowMuted = this.dataset.muted !== '1';
      try {
        await fetch('/messages/conv/' + cid + '/mute', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ muted: nowMuted }),
        });
      } catch (_) {}
      this.dataset.muted = nowMuted ? '1' : '0';
      this.querySelector('.msg-mute-label').textContent = nowMuted ? 'Réactiver les notifications' : 'Mettre en sourdine';
    });
  }

  var unreadBtn = document.getElementById('msg-unread-btn');
  if (unreadBtn) {
    unreadBtn.addEventListener('click', async function () {
      var cid = parseInt(this.dataset.convId, 10);
      try {
        var r = await fetch('/messages/conv/' + cid + '/mark-unread', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
        });
        var data = await r.json();
        if (data.ok) window.location.href = '/messages';
      } catch (_) {}
    });
  }

  // ── SSE ──────────────────────────────────────────────────────────────────
  var lastMsgId = 0;
  (function () {
    // Pas de :last-child ici : le dernier enfant réel de #msg-thread-messages
    // est #msg-typing-indicator (après toutes les bulles), donc ce sélecteur
    // ne matchait jamais et lastMsgId restait bloqué à 0 — cause du doublon
    // de tout l'historique au premier sondage (voir loadNewMessages).
    var bubbles = document.querySelectorAll('#msg-thread-messages .msg-bubble');
    if (bubbles.length) lastMsgId = parseInt(bubbles[bubbles.length - 1].dataset.id, 10) || 0;
  })();

  var typingIndicator = document.getElementById('msg-typing-indicator');

  function showTyping() {
    if (!typingIndicator) return;
    typingIndicator.hidden = false;
    scrollToBottom();
    clearTimeout(typingTimer);
    typingTimer = setTimeout(function () { typingIndicator.hidden = true; }, 3000);
  }

  // Filet de secours : le SSE ci-dessous livre les nouveaux messages quasi
  // instantanément dans l'immense majorité des cas, mais une connexion SSE
  // peut se couper silencieusement (proxy, veille mobile…) — ce polling,
  // bien plus espacé que par le passé, rattrape ce cas sans spammer le serveur.
  setInterval(loadNewMessages, 20000);

  try {
    var evtSource = new EventSource('/messages/events');
    evtSource.addEventListener('typing', function (e) {
      try {
        var d = JSON.parse(e.data);
        if (d.fromId === partnerId) showTyping();
      } catch (_) {}
    });
    // Livraison en direct : le serveur pousse déjà cet événement à l'envoi
    // (voir pushToUser(partnerId, "message", ...) dans routes/messages.js) ;
    // on ne l'utilisait jusqu'ici que pour déclencher l'indicateur de frappe.
    evtSource.addEventListener('message', function (e) {
      try {
        var d = JSON.parse(e.data);
        if (d.convId === convId) loadNewMessages();
      } catch (_) {}
    });
    // "Vu" : le serveur pousse cet événement quand le partenaire ouvre la
    // discussion (markRead), sous réserve que mon dernier message soit
    // bien le mien (sinon rien à confirmer).
    // Réaction posée/retirée par le partenaire sur un de mes messages déjà
    // affichés — mise à jour ciblée de la bulle, pas de rechargement complet.
    evtSource.addEventListener('reaction', function (e) {
      try {
        var d = JSON.parse(e.data);
        if (d.convId === convId) applyReaction(d.msgId, d.emoji);
      } catch (_) {}
    });
    evtSource.addEventListener('seen', function (e) {
      try {
        var d = JSON.parse(e.data);
        if (d.convId !== convId) return;
        var bubbles = document.querySelectorAll('#msg-thread-messages .msg-bubble');
        var last = bubbles[bubbles.length - 1];
        var seenIndicator = document.getElementById('msg-seen-indicator');
        if (last && last.classList.contains('msg-bubble--me') && seenIndicator) {
          seenIndicator.hidden = false;
        }
      } catch (_) {}
    });
  } catch (_) {}

  async function loadNewMessages() {
    try {
      var r = await fetch('/messages/load-new/' + convId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ afterId: lastMsgId }),
      });
      var data = await r.json();
      if (!data.messages || !data.messages.length) return;
      for (var i = 0; i < data.messages.length; i++) {
        var m = data.messages[i];
        if (m.id <= lastMsgId) continue;
        lastMsgId = m.id;
        var ref = null;
        if (m.content_ref) { try { ref = JSON.parse(m.content_ref); } catch (_) {} }
        appendBubble(m.id, m.payload, m.created_at, m.sender_id === myId, ref, m.reaction || null);
      }
    } catch (_) {}
  }

  function scrollToBottom() {
    var body = document.getElementById('msg-thread-body');
    if (body) body.scrollTop = body.scrollHeight;
  }

  scrollToBottom();
})();
</script>
<% } %>

<style>
/* ── Badge admin ── */
.msg-admin-badge{display:inline-block;font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;background:hsl(220,80%,38%);color:#fff;border-radius:4px;padding:.1rem .4rem;margin-left:.45rem;vertical-align:middle;line-height:1.5}

/* ── Bouton supprimer discussion ── */
/* ── Menu ⋮ (options du fil) ── */
.msg-thread-options{position:relative}
.msg-thread-options-btn{background:none;border:none;cursor:pointer;color:var(--muted);padding:.3rem;border-radius:6px;display:flex;align-items:center;line-height:0;list-style:none;transition:color .15s,background .15s}
.msg-thread-options-btn::-webkit-details-marker{display:none}
.msg-thread-options-btn:hover{color:var(--fg);background:#ffffff0f}
.msg-thread-options-btn svg{width:18px;height:18px}
.msg-thread-options-menu{position:absolute;right:0;top:calc(100% + .4rem);min-width:210px;background:var(--surface, #1e1e2e);border:1px solid var(--border);border-radius:10px;padding:.35rem;box-shadow:0 8px 24px #0006;z-index:300;display:flex;flex-direction:column;gap:.1rem}
.msg-thread-options-item{display:block;width:100%;text-align:left;background:none;border:none;color:var(--fg);font-size:.85rem;padding:.55rem .7rem;border-radius:7px;cursor:pointer}
.msg-thread-options-item:hover{background:#ffffff12}
.msg-thread-options-item--danger{color:hsl(0,65%,62%)}
.msg-thread-options-item--danger:hover{background:hsla(0,65%,45%,.14)}
.msg-list-pin-icon{width:12px;height:12px;color:var(--wiki-gold, #c9a227);vertical-align:-1px;margin-right:.2rem}

/* ── Typing animation ── */
.msg-typing-indicator{display:flex;padding:.25rem 1rem .5rem}
.msg-typing-dots{display:flex;gap:5px;align-items:center;padding:.55rem .85rem;background:var(--card-bg,hsl(220,15%,18%));border-radius:1.1rem}
.msg-typing-dots span{display:block;width:7px;height:7px;border-radius:50%;background:var(--text-muted,#6b7280);animation:tbd 1.3s ease-in-out infinite}
.msg-typing-dots span:nth-child(2){animation-delay:.18s}
.msg-typing-dots span:nth-child(3){animation-delay:.36s}
@keyframes tbd{0%,60%,100%{transform:translateY(0);opacity:.5}30%{transform:translateY(-6px);opacity:1}}

/* ── Two-panel layout ── */
.msg-app{
  display:flex;
  height:calc(100dvh - var(--topnav-height));
  max-width:960px;
  margin:0 auto;
  overflow:hidden;
  border-left:1px solid var(--border);
  border-right:1px solid var(--border);
}

/* Left: conversations list (order:1 — avant le fil, visuellement à gauche) */
.msg-panel-list{
  order:1;
  width:260px;
  flex-shrink:0;
  display:flex;
  flex-direction:column;
  border-right:1px solid var(--border);
  overflow-y:auto;
  padding:.85rem .75rem;
  gap:.25rem;
}

/* Right: thread (order:2 — après la liste, visuellement à droite) */
.msg-panel-thread{
  order:2;
  flex:1;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  min-width:0;
  background:var(--bg);
}
.msg-panel-empty{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--muted);
  font-size:.85rem;
  letter-spacing:.01em;
}

/* Better bubble readability */
.msg-bubble-text{font-size:.9rem;line-height:1.6}
.msg-bubble-inner{padding:.6rem .9rem}
/* ── Couleurs des bulles : envoyé / reçu / reçu d'un admin ── */
.msg-bubble--me .msg-bubble-inner{background:hsl(250,55%,32%);border-color:hsl(250,55%,46%)}
.msg-bubble--them .msg-bubble-inner{background:hsl(220,14%,24%);border-color:hsl(220,14%,36%)}
.msg-bubble--admin .msg-bubble-inner{background:hsl(42,55%,22%);border-color:hsl(42,60%,42%)}

/* Active conv highlight */
.msg-list-item--active,.msg-list-item--active:hover{background:hsl(250,30%,16%);border-color:var(--accent)!important}

/* Mobile: single-panel */
@media(max-width:640px){
  .msg-app{max-width:100%;border:none}
  .msg-panel-thread{display:none}
  .msg-panel-list{width:100%;border:none;padding:.75rem .9rem}
  .msg-app--thread-open .msg-panel-thread{display:flex}
  .msg-app--thread-open .msg-panel-list{display:none}
  .msg-thread-header{padding:.5rem .75rem}
  .msg-thread-body{padding:.5rem .75rem}
  /* Fond opaque + au-dessus du reste + marge pour l'encoche (sinon le champ
     de saisie pouvait se retrouver visuellement couvert, ex. par le bouton
     "Inviter" flottant) et toujours entièrement cliquable en bas d'écran. */
  .msg-compose{padding:.5rem .75rem;padding-bottom:calc(.5rem + env(safe-area-inset-bottom));position:relative;z-index:5;background:var(--bg)}
  .msg-bubble{max-width:88%}
}
</style>
<%- include('partials/foot') %>
