<%- include('partials/head', { title: partner ? 'Message — ' + partner.displayName : 'Messages' }) %>
<main class="msg-app<% if (partner) { %> msg-app--thread-open<% } %>">
  <%- include('partials/top-nav', { config: config }) %>

  <%# ── Panneau droit : fil de discussion ────────────────────────────── %>
  <div class="msg-panel-thread">
    <% if (partner) { %>

      <div id="msg-state"
           data-conv-id="<%= conv.id %>"
           data-partner-id="<%= partner.id %>"
           data-my-id="<%= currentUser.id %>">
      </div>

      <div class="msg-thread-header">
        <a href="/messages" class="msg-thread-back" aria-label="Retour aux messages">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <div class="msg-thread-avatar" style="background:<%= partner.profileColor || '#6b7280' %>">
          <%= (partner.displayName || '?').charAt(0).toUpperCase() %>
        </div>
        <a href="/profil/<%= partner.username %>" class="msg-thread-name"><%= partner.displayName %></a>
        <a href="/messages/<%= partner.id %>/library" class="msg-thread-library-btn" title="Bibliothèque partagée" aria-label="Bibliothèque partagée">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/></svg>
        </a>
        <button class="msg-thread-delete-conv-btn" id="msg-delete-conv-btn" data-conv-id="<%= conv.id %>" type="button" title="Supprimer la discussion" aria-label="Supprimer la discussion">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
        </button>
      </div>

      <div class="msg-thread-body" id="msg-thread-body">
        <button class="msg-load-more-btn" id="msg-load-more-btn" type="button" hidden>Charger plus</button>
        <div class="msg-thread-messages" id="msg-thread-messages">
          <% messages.forEach(function(m) { %>
          <article class="msg-bubble msg-bubble--<%= m.sender_id === currentUser.id ? 'me' : 'them' %>"
                   data-id="<%= m.id %>">
            <div class="msg-bubble-inner">
              <div class="msg-bubble-text"><%- m.payload.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>') %></div>
              <% if (m.content_ref) { %>
                <div class="msg-bubble-ref" data-ref="<%= encodeURIComponent(m.content_ref) %>"></div>
              <% } %>
              <div class="msg-bubble-meta">
                <span class="msg-bubble-time"><%= new Date(m.created_at).toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'}) %></span>
                <button class="msg-bubble-delete" data-id="<%= m.id %>" type="button" aria-label="Supprimer" title="Supprimer">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="4" x2="4" y2="12"/><line x1="4" y1="4" x2="12" y2="12"/></svg>
                </button>
              </div>
            </div>
          </article>
          <% }) %>
          <div class="msg-typing-indicator" id="msg-typing-indicator" hidden aria-live="polite">
            <div class="msg-typing-dots"><span></span><span></span><span></span></div>
          </div>
        </div>
      </div>

      <form class="msg-compose" id="msg-compose" autocomplete="off">
        <textarea class="msg-compose-input" id="msg-compose-input"
                  placeholder="Votre message…" rows="1" maxlength="4000"
                  aria-label="Votre message"></textarea>
        <button class="msg-compose-send" type="submit" aria-label="Envoyer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </form>

    <% } else { %>
      <div class="msg-panel-empty">
        <span>Choisissez une conversation</span>
      </div>
    <% } %>
  </div>

  <%# ── Panneau gauche : liste des conversations ─────────────────────── %>
  <div class="msg-panel-list">
    <% if (friends && friends.length) { %>
    <details class="msg-new-conv" id="msg-new-conv">
      <summary class="msg-new-conv-toggle">+ Nouvelle discussion</summary>
      <ul class="msg-new-conv-list">
        <% friends.forEach(function(f) { %>
        <li>
          <a href="/messages/<%= f.id %>" class="msg-new-conv-friend">
            <div class="msg-list-avatar" style="background:<%= f.profile_color || '#6b7280' %>">
              <%= (f.display_name || '?').charAt(0).toUpperCase() %>
            </div>
            <span><%= f.display_name %></span>
          </a>
        </li>
        <% }) %>
      </ul>
    </details>
    <% } %>

    <% if (!convs || !convs.length) { %>
      <p class="msg-list-empty">Aucune conversation pour l'instant.</p>
    <% } else { %>
    <ul class="msg-list">
      <% convs.forEach(function(c) { %>
      <li class="msg-list-item<%= c.unread > 0 ? ' msg-list-item--unread' : '' %><%= (partner && c.partnerId === partner.id) ? ' msg-list-item--active' : '' %>">
        <a href="/messages/<%= c.partnerId %>" class="msg-list-link">
          <div class="msg-list-avatar" style="background:<%= c.partnerColor || '#6b7280' %>">
            <%= (c.partnerName || '?').charAt(0).toUpperCase() %>
          </div>
          <div class="msg-list-info">
            <span class="msg-list-name"><%= c.partnerName %></span>
            <span class="msg-list-date"><%= new Date(c.last_message_at).toLocaleDateString('fr-FR', {day:'numeric',month:'short'}) %></span>
          </div>
          <% if (c.unread > 0) { %>
            <span class="msg-list-unread-badge"><%= c.unread %></span>
          <% } %>
        </a>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>

</main>

<% if (partner) { %>
<script nonce="<%= nonce %>">
(function () {
  'use strict';

  var state     = document.getElementById('msg-state').dataset;
  var convId    = parseInt(state.convId, 10);
  var partnerId = parseInt(state.partnerId, 10);
  var myId      = parseInt(state.myId, 10);

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Rendu des références de contenu ──────────────────────────────────────
  var _refCache = {};

  var _refIcons = {
    image: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>',
    wiki:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
    bd:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
  };

  async function renderContentRef(el, ref) {
    var typeLabel = { image: 'Image', bd: 'BD', wiki: 'Codex' }[ref.type] || ref.type;
    var href = ref.type === 'image' ? '/galerie/' + ref.id
             : ref.type === 'bd'    ? '/bd/' + ref.id
             : '/wiki/' + ref.id;
    var thumb = null, title = ref.title || '';
    var cacheKey = ref.type + ':' + ref.id;
    if (_refCache[cacheKey]) {
      thumb = _refCache[cacheKey].thumb;
      title = _refCache[cacheKey].title || title;
    } else {
      try {
        var r = await fetch('/messages/ref-card/' + ref.type + '/' + ref.id);
        var d = await r.json();
        _refCache[cacheKey] = d;
        if (d.thumb) thumb = d.thumb;
        if (d.title) title = d.title;
      } catch (_) {}
    }
    var visual = thumb
      ? '<img class="msg-ref-thumb" src="' + escHtml(thumb) + '" alt="" loading="lazy">'
      : '<span class="msg-ref-thumb msg-ref-thumb--icon">' + (_refIcons[ref.type] || '') + '</span>';
    el.innerHTML = '<a class="msg-ref-card" href="' + href + '">' +
      visual +
      '<span class="msg-ref-info">' +
        '<span class="msg-ref-type">' + escHtml(typeLabel) + '</span>' +
        '<span class="msg-ref-title">' + escHtml(title) + '</span>' +
      '</span>' +
      '</a>';
  }

  document.querySelectorAll('.msg-bubble-ref[data-ref]').forEach(function (el) {
    try { renderContentRef(el, JSON.parse(decodeURIComponent(el.dataset.ref))); } catch (_) {}
  });

  // ── Envoi d'un message ───────────────────────────────────────────────────
  var compose = document.getElementById('msg-compose');
  var input   = document.getElementById('msg-compose-input');

  // ── Indicateur de frappe ─────────────────────────────────────────────────
  var typingTimer = null;
  var lastTypingSent = 0;

  function sendTyping() {
    fetch('/messages/' + partnerId + '/typing', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
    }).catch(function () {});
  }

  if (compose) {
    input.addEventListener('input', function () {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 160) + 'px';
      var now = Date.now();
      if (now - lastTypingSent > 2000) {
        sendTyping();
        lastTypingSent = now;
      }
    });

    async function doSend() {
      var text = input.value.trim();
      if (!text) return;
      input.value = '';
      input.style.height = 'auto';
      try {
        var r = await fetch('/messages/' + partnerId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: text }),
        });
        var data = await r.json();
        if (data.ok) appendBubble(data.msgId, text, new Date().toISOString(), true);
      } catch (_) {}
    }

    compose.addEventListener('submit', function (e) {
      e.preventDefault();
      doSend();
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        doSend();
      }
    });
  }

  function appendBubble(id, text, ts, isMe, contentRef) {
    var el = document.createElement('article');
    el.className = 'msg-bubble msg-bubble--' + (isMe ? 'me' : 'them');
    el.dataset.id = id;
    var refHtml = '';
    if (contentRef) {
      refHtml = '<div class="msg-bubble-ref"></div>';
    }
    el.innerHTML =
      '<div class="msg-bubble-inner">' +
        '<div class="msg-bubble-text">' + escHtml(text).replace(/\n/g, '<br>') + '</div>' +
        refHtml +
        '<div class="msg-bubble-meta">' +
          '<span class="msg-bubble-time">' + new Date(ts).toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'}) + '</span>' +
          '<button class="msg-bubble-delete" data-id="' + id + '" type="button" aria-label="Supprimer" title="Supprimer">' +
            '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="4" x2="4" y2="12"/><line x1="4" y1="4" x2="12" y2="12"/></svg>' +
          '</button>' +
        '</div>' +
      '</div>';
    if (contentRef) {
      try { renderContentRef(el.querySelector('.msg-bubble-ref'), contentRef); } catch (_) {}
    }
    var container = document.getElementById('msg-thread-messages');
    if (container) { container.appendChild(el); scrollToBottom(); }
  }

  // ── Suppression d'un message ─────────────────────────────────────────────
  document.addEventListener('click', async function (e) {
    var btn = e.target.closest('.msg-bubble-delete');
    if (!btn) return;
    var id = parseInt(btn.dataset.id, 10);
    if (!id) return;
    var r = await fetch('/messages/msg/' + id, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
    var data = await r.json();
    if (data.ok) {
      var bubble = document.querySelector('.msg-bubble[data-id="' + id + '"]');
      if (bubble) bubble.remove();
    }
  });

  // ── Suppression de la discussion ──────────────────────────────────────────
  var deleteConvBtn = document.getElementById('msg-delete-conv-btn');
  if (deleteConvBtn) {
    deleteConvBtn.addEventListener('click', async function () {
      if (!confirm('Supprimer toute la discussion ? Cette action est définitive pour vous.')) return;
      var cid = parseInt(this.dataset.convId, 10);
      var r = await fetch('/messages/conv/' + cid, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
      var data = await r.json();
      if (data.ok) window.location.href = '/messages';
    });
  }

  // ── SSE ──────────────────────────────────────────────────────────────────
  var lastMsgId = 0;
  (function () {
    var last = document.querySelector('#msg-thread-messages .msg-bubble:last-child');
    if (last) lastMsgId = parseInt(last.dataset.id, 10) || 0;
  })();

  var typingIndicator = document.getElementById('msg-typing-indicator');

  function showTyping() {
    if (!typingIndicator) return;
    typingIndicator.hidden = false;
    scrollToBottom();
    clearTimeout(typingTimer);
    typingTimer = setTimeout(function () { typingIndicator.hidden = true; }, 3000);
  }

  // Polling toutes les 2s — simple et fiable
  setInterval(loadNewMessages, 2000);

  // SSE conservé uniquement pour l'indicateur de frappe
  try {
    var evtSource = new EventSource('/messages/events');
    evtSource.addEventListener('typing', function (e) {
      try {
        var d = JSON.parse(e.data);
        if (d.fromId === partnerId) showTyping();
      } catch (_) {}
    });
  } catch (_) {}

  async function loadNewMessages() {
    try {
      var r = await fetch('/messages/load-new/' + convId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ afterId: lastMsgId }),
      });
      var data = await r.json();
      if (!data.messages || !data.messages.length) return;
      for (var i = 0; i < data.messages.length; i++) {
        var m = data.messages[i];
        if (m.id <= lastMsgId) continue;
        lastMsgId = m.id;
        var ref = null;
        if (m.content_ref) { try { ref = JSON.parse(m.content_ref); } catch (_) {} }
        appendBubble(m.id, m.payload, m.created_at, m.sender_id === myId, ref);
      }
    } catch (_) {}
  }

  function scrollToBottom() {
    var body = document.getElementById('msg-thread-body');
    if (body) body.scrollTop = body.scrollHeight;
  }

  scrollToBottom();
})();
</script>
<% } %>

<style>
/* ── Bouton supprimer discussion ── */
.msg-thread-delete-conv-btn{background:none;border:none;cursor:pointer;color:var(--muted);padding:.3rem;border-radius:6px;display:flex;align-items:center;line-height:0;transition:color .15s}
.msg-thread-delete-conv-btn:hover{color:hsl(0,60%,55%)}
.msg-thread-delete-conv-btn svg{width:17px;height:17px}

/* ── Cartes de contenu partagé ── */
.msg-ref-card{display:flex;align-items:center;gap:.55rem;padding:.35rem .5rem;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:9px;text-decoration:none;color:var(--fg);margin-top:.35rem;overflow:hidden;max-width:230px;transition:border-color .15s,background .15s}
.msg-ref-card:hover{border-color:var(--accent);background:rgba(255,255,255,.07)}
.msg-ref-thumb{width:46px;height:46px;object-fit:cover;border-radius:6px;flex-shrink:0;background:var(--card)}
.msg-ref-thumb--icon{width:46px;height:46px;display:flex;align-items:center;justify-content:center;border-radius:6px;flex-shrink:0;background:rgba(255,255,255,.07)}
.msg-ref-thumb--icon svg{width:20px;height:20px;color:var(--muted)}
.msg-ref-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:.12rem}
.msg-ref-type{font-size:.62rem;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;line-height:1}
.msg-ref-title{font-size:.78rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3}

/* ── Typing animation ── */
.msg-typing-indicator{display:flex;padding:.25rem 1rem .5rem}
.msg-typing-dots{display:flex;gap:5px;align-items:center;padding:.55rem .85rem;background:var(--card-bg,hsl(220,15%,18%));border-radius:1.1rem}
.msg-typing-dots span{display:block;width:7px;height:7px;border-radius:50%;background:var(--text-muted,#6b7280);animation:tbd 1.3s ease-in-out infinite}
.msg-typing-dots span:nth-child(2){animation-delay:.18s}
.msg-typing-dots span:nth-child(3){animation-delay:.36s}
@keyframes tbd{0%,60%,100%{transform:translateY(0);opacity:.5}30%{transform:translateY(-6px);opacity:1}}

/* ── Two-panel layout ── */
.msg-app{
  display:flex;
  height:calc(100dvh - var(--topnav-height));
  max-width:960px;
  margin:0 auto;
  overflow:hidden;
  border-left:1px solid var(--border);
  border-right:1px solid var(--border);
}

/* Left: conversations list */
.msg-panel-list{
  width:260px;
  flex-shrink:0;
  display:flex;
  flex-direction:column;
  border-right:1px solid var(--border);
  overflow-y:auto;
  padding:.85rem .75rem;
  gap:.25rem;
}

/* Right: thread */
.msg-panel-thread{
  flex:1;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  min-width:0;
  background:var(--bg);
}
.msg-panel-empty{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--muted);
  font-size:.85rem;
  letter-spacing:.01em;
}

/* Better bubble readability */
.msg-bubble-text{font-size:.9rem;line-height:1.6}
.msg-bubble-inner{padding:.6rem .9rem}
.msg-bubble--me .msg-bubble-inner{background:hsl(250,35%,22%);border-color:hsl(250,35%,32%)}

/* Active conv highlight */
.msg-list-item--active,.msg-list-item--active:hover{background:hsl(250,30%,16%);border-color:var(--accent)!important}

/* Mobile: single-panel */
@media(max-width:640px){
  .msg-app{max-width:100%;border:none}
  .msg-panel-thread{display:none}
  .msg-panel-list{width:100%;border:none;padding:.75rem .9rem}
  .msg-app--thread-open .msg-panel-thread{display:flex}
  .msg-app--thread-open .msg-panel-list{display:none}
  .msg-thread-header{padding:.5rem .75rem}
  .msg-thread-body{padding:.5rem .75rem}
  .msg-compose{padding:.5rem .75rem}
  .msg-bubble{max-width:88%}
}
</style>
<%- include('partials/foot') %>
