<%- include('partials/head', { title: 'Admin : ' + detail.user.displayName + ' : Codex', extraCss: ['admin.css'] }) %>

<%- include('partials/admin-nav') %>

<div class="aud-layout">
  <%- include('partials/admin-user-nav', { detail: detail, roleHue: roleHue }) %>

  <main class="aud-content">

    <%# ── Onglets ── %>
    <div class="aud-tabs" id="aud-codex-tabs">
      <button class="aud-tab active" data-tab="notes">Notes &amp; favoris (<%= items.length %>)</button>
      <button class="aud-tab" data-tab="read-later">&Agrave; lire plus tard (<%= readLater.length %>)</button>
      <button class="aud-tab" data-tab="interested">Int&eacute;ress&eacute; (<%= interested.length %>)</button>
      <button class="aud-tab" data-tab="practiced">D&eacute;j&agrave; fait (<%= practiced.length %>)</button>
      <button class="aud-tab" data-tab="comments">Commentaires (<%= notes.length %>)</button>
      <button class="aud-tab" data-tab="pour-toi" id="tab-pour-toi">Pour toi <% if (featuredIds.size > 0) { %><span class="aud-tab-badge"><%= featuredIds.size %></span><% } %></button>
    </div>

    <%# ── Tab: Notes & favoris ── %>
    <div class="aud-tab-panel active" id="aud-tab-notes">
      <div class="aud-card-grid">
        <% if (!items.length) { %><p class="admin-muted">Aucune note ni favori codex.</p><% } %>
        <% items.forEach(function(p) { %>
          <%- include('partials/admin-content-card', {
            href: '/wiki/' + p.id,
            coverImg: p.imagePaths && p.imagePaths[0],
            title: p.title,
            viewCount: undefined,
            rating: p.rating || 0,
            flame: !!p.flame,
            placeholderIcon: '&#128214;',
          }) %>
        <% }) %>
      </div>
      <% if (topViews.length) { %>
        <div class="aud-section-header" id="aud-codex-views-header" hidden>
          <h2 class="aud-section-title">Pages les plus visit&eacute;es</h2>
        </div>
        <div class="aud-card-grid" id="aud-codex-views" hidden>
          <% topViews.forEach(function(p) { %>
            <%- include('partials/admin-content-card', {
              href: '/wiki/' + p.id,
              coverImg: p.imagePaths && p.imagePaths[0],
              title: p.title,
              viewCount: p.viewCount,
              rating: p.rating || 0,
              flame: !!p.flame,
              placeholderIcon: '&#128214;',
            }) %>
          <% }) %>
        </div>
        <button type="button" class="aud-view-toggle" id="aud-codex-toggle-views">
          <span aria-hidden="true">&#128065;</span>
          <span id="aud-codex-toggle-label">Voir les vues</span>
        </button>
      <% } %>
    </div>

    <%# ── Tab: À lire plus tard ── %>
    <div class="aud-tab-panel" id="aud-tab-read-later" hidden>
      <div class="aud-card-grid">
        <% if (!readLater.length) { %><p class="admin-muted">Aucune page marqu&eacute;e "à lire plus tard".</p><% } %>
        <% readLater.forEach(function(p) { %>
          <%- include('partials/admin-content-card', {
            href: '/wiki/' + p.id,
            coverImg: p.imagePaths && p.imagePaths[0],
            title: p.title,
            viewCount: undefined,
            rating: p.rating || 0,
            flame: !!p.flame,
            placeholderIcon: '&#128214;',
          }) %>
        <% }) %>
      </div>
    </div>

    <%# ── Tab: Intéressé ── %>
    <div class="aud-tab-panel" id="aud-tab-interested" hidden>
      <div class="aud-card-grid">
        <% if (!interested.length) { %><p class="admin-muted">Aucune page marqu&eacute;e "int&eacute;ress&eacute;".</p><% } %>
        <% interested.forEach(function(p) { %>
          <%- include('partials/admin-content-card', {
            href: '/wiki/' + p.id,
            coverImg: p.imagePaths && p.imagePaths[0],
            title: p.title,
            viewCount: undefined,
            rating: p.rating || 0,
            flame: !!p.flame,
            placeholderIcon: '&#128214;',
          }) %>
        <% }) %>
      </div>
    </div>

    <%# ── Tab: Déjà fait ── %>
    <div class="aud-tab-panel" id="aud-tab-practiced" hidden>
      <div class="aud-card-grid">
        <% if (!practiced.length) { %><p class="admin-muted">Aucune page marqu&eacute;e "d&eacute;j&agrave; fait".</p><% } %>
        <% practiced.forEach(function(p) { %>
          <%- include('partials/admin-content-card', {
            href: '/wiki/' + p.id,
            coverImg: p.imagePaths && p.imagePaths[0],
            title: p.title,
            viewCount: undefined,
            rating: p.rating || 0,
            flame: !!p.flame,
            placeholderIcon: '&#128214;',
          }) %>
        <% }) %>
      </div>
    </div>

    <%# ── Tab: Commentaires (notes texte) ── %>
    <div class="aud-tab-panel" id="aud-tab-comments" hidden>
      <% if (!notes.length) { %>
        <p class="admin-muted">Aucun commentaire.</p>
      <% } else { %>
      <ul class="aud-notes-list">
        <% notes.forEach(function(n) { %>
        <li class="aud-note-row">
          <a href="/wiki/<%= n.pageId %>" class="aud-note-title" target="_blank"><%= n.title %></a>
          <p class="aud-note-content"><%= n.content %></p>
          <span class="aud-note-date"><%= new Date(n.updatedAt).toLocaleString('fr-FR') %></span>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>

    <%# ── Tab: Pour toi ── %>
    <div class="aud-tab-panel" id="aud-tab-pour-toi" hidden>

      <% if (featuredIds.size > 0) { %>
        <div class="aud-section-header">
          <h2 class="aud-section-title">Pages promu&eacute;es (<%= featuredIds.size %>)</h2>
        </div>
        <div class="aud-card-grid aud-pour-toi-grid">
          <% allPages.filter(function(p) { return featuredIds.has(p.id); }).forEach(function(p) { %>
            <div class="aud-grant-wrap">
              <%- include('partials/admin-content-card', {
                href: '/wiki/' + p.id,
                coverImg: p.imagePaths && p.imagePaths[0],
                title: p.title,
                viewCount: undefined,
                rating: 0,
                flame: false,
                placeholderIcon: '&#128214;',
              }) %>
              <form method="POST" action="/ponhgup/utilisateur/<%= detail.user.id %>/codex-featured/remove" class="aud-grant-form">
                <input type="hidden" name="pageId" value="<%= p.id %>">
                <button type="submit" class="aud-grant-btn aud-grant-btn--remove">Retirer</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>

      <div class="aud-section-header">
        <h2 class="aud-section-title">Ajouter une page</h2>
        <input type="search" id="aud-pour-toi-search" class="aud-pour-toi-search" placeholder="Rechercher&hellip;" autocomplete="off">
      </div>
      <ul class="aud-pour-toi-list" id="aud-pour-toi-list">
        <% allPages.forEach(function(p) { %>
          <% if (!featuredIds.has(p.id)) { %>
          <li class="aud-pour-toi-row" data-title="<%= (p.title || '').toLowerCase().replace(/"/g,'') %>">
            <span class="aud-pour-toi-title"><%= p.title %></span>
            <form method="POST" action="/ponhgup/utilisateur/<%= detail.user.id %>/codex-featured/add" style="display:inline">
              <input type="hidden" name="pageId" value="<%= p.id %>">
              <button type="submit" class="aud-pour-toi-add-btn">+</button>
            </form>
          </li>
          <% } %>
        <% }) %>
      </ul>
    </div>

<script nonce="<%= nonce %>">
(function () {
  // Onglets
  var tabs    = document.querySelectorAll('.aud-tab');
  var panels  = document.querySelectorAll('.aud-tab-panel');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var target = tab.dataset.tab;
      tabs.forEach(function(t) { t.classList.remove('active'); });
      panels.forEach(function(p) { p.hidden = true; p.classList.remove('active'); });
      tab.classList.add('active');
      var panel = document.getElementById('aud-tab-' + target);
      if (panel) { panel.hidden = false; panel.classList.add('active'); }
    });
  });
  // Toggle vues
  var btn = document.getElementById("aud-codex-toggle-views");
  if (!btn) return;
  var hd  = document.getElementById("aud-codex-views-header");
  var grd = document.getElementById("aud-codex-views");
  var lbl = document.getElementById("aud-codex-toggle-label");
  var open = false;
  btn.addEventListener("click", function () {
    open = !open;
    if (hd)  hd.hidden  = !open;
    if (grd) grd.hidden = !open;
    if (lbl) lbl.textContent = open ? "Masquer les vues" : "Voir les vues";
  });
  // Recherche dans la liste "Pour toi"
  var ptSearch = document.getElementById('aud-pour-toi-search');
  var ptList   = document.getElementById('aud-pour-toi-list');
  if (ptSearch && ptList) {
    ptSearch.addEventListener('input', function() {
      var q = ptSearch.value.toLowerCase().trim();
      ptList.querySelectorAll('.aud-pour-toi-row').forEach(function(row) {
        row.hidden = q && (row.dataset.title || '').indexOf(q) === -1;
      });
    });
  }
})();
</script>

  </main>
</div>
<%- include('partials/foot') %>
