<%- include('partials/head', { title: 'Profil : Paramètres' }) %>
<main class="container wide profil-page gallery-has-sidebar">
  <%- include('partials/top-nav', { config: config }) %>

  <%- include('partials/profil-nav', { roleHue: roleHue }) %>

  <div class="profil-subpage profil-subpage--wide">

    <% if (error) { %><p class="profil-msg profil-msg-error"><%= error %></p><% } %>
    <% if (notice) { %><p class="profil-msg profil-msg-ok"><%= notice %></p><% } %>

    <section class="profil-panel">
      <h2 class="profil-panel-title">Nature des contenus</h2>
      <div class="profil-panel-grid">
        <div class="profil-card">
          <div class="profil-card-head">
            <span>Ultra</span>
          </div>
          <select class="profil-select" id="ultra-mode-select">
            <option value="hidden">Masqu&eacute; (bascule)</option>
            <option value="visible">Visible</option>
            <option value="off">D&eacute;sactiv&eacute;</option>
          </select>
        </div>

        <div class="profil-card">
          <div class="profil-card-head">
            <span>Irr&eacute;aliste</span>
          </div>
          <select class="profil-select" id="irrealiste-mode-select">
            <option value="hidden">Masqu&eacute; (bascule)</option>
            <option value="visible">Visible</option>
            <option value="off">D&eacute;sactiv&eacute;</option>
          </select>
        </div>

        <a href="/favoris/masques" class="profil-card profil-card--plain-btn">Contenus masqu&eacute;s</a>
      </div>
    </section>

    <section class="profil-panel">
      <h2 class="profil-panel-title">Comportement du site</h2>
      <div class="profil-panel-grid">
        <div class="profil-card">
          <div class="profil-card-head">
            <span>Filtrage des tags</span>
          </div>
          <select class="profil-select" id="tag-logic-select">
            <option value="and">ET (tous les tags)</option>
            <option value="or">OU (au moins un)</option>
          </select>
        </div>

        <div class="profil-card">
          <div class="profil-card-head">
            <span>Clic sur un tag</span>
            <span class="profil-info-icon" tabindex="0" data-tip="Choisissez ce qui se passe quand vous cliquez sur un badge de tag : afficher un résumé, ou aller directement à sa page." aria-label="Comment fonctionne le clic sur un tag ?">!</span>
          </div>
          <select class="profil-select" id="tag-click-select">
            <option value="popup">Aper&ccedil;u (popup)</option>
            <option value="direct">Acc&egrave;s direct (codex ou images)</option>
          </select>
        </div>
      </div>
    </section>

    <section class="profil-panel">
      <h2 class="profil-panel-title">Gestion du compte</h2>
      <div class="profil-panel-grid">
        <div class="profil-card">
          <div class="profil-card-head">
            <span>Historique</span>
            <span class="profil-info-icon" tabindex="0" data-tip="Durée pendant laquelle vos consultations récentes (codex, images, BD) restent visibles dans Profil > Historique." aria-label="Que fait ce réglage ?">!</span>
          </div>
          <select class="profil-select" id="history-retention-select">
            <option value="3jours">3 jours</option>
            <option value="1semaine">1 semaine</option>
            <option value="1mois">1 mois</option>
            <option value="3mois">3 mois</option>
          </select>
        </div>

        <div class="profil-card">
          <div class="profil-card-head">
            <span>Partage avec l&rsquo;admin</span>
            <span class="profil-info-icon" tabindex="0" data-tip="Permet à l'administrateur de voir votre activité et de faire du débogage." aria-label="Que fait cette option ?">!</span>
          </div>
          <label class="profil-toggle">
            <input type="checkbox" id="share-notes-checkbox" <%= currentUser.shareNotesWithAdmin ? 'checked' : '' %> />
            <span class="profil-toggle-track"><span class="profil-toggle-thumb"></span></span>
          </label>
        </div>
      </div>

      <div class="profil-danger-zone">
        <form method="POST" action="/favoris/parametres/reinitialiser" id="reset-account-form" class="profil-danger-row">
          <button type="submit" class="wiki-filter-reset-btn wiki-filter-reset-btn--danger">R&eacute;initialiser le compte</button>
        </form>
        <form method="POST" action="/favoris/parametres/supprimer" id="delete-account-form" class="profil-danger-row">
          <button type="submit" class="wiki-filter-reset-btn wiki-filter-reset-btn--danger">Supprimer le compte</button>
        </form>
      </div>
    </section>

  </div>

</main>

<script nonce="<%= nonce %>">
(function () {
  // ── Ultra / Irréaliste / Historique (sauvegarde serveur) ─────────────────
  function savePref(field, value) {
    var body = {};
    body[field] = value;
    fetch("/favoris/parametres", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    }).catch(function () {});
  }

  function wireServerSelect(selectId, field, initial) {
    var select = document.getElementById(selectId);
    if (!select) return;
    select.value = initial;
    select.addEventListener("change", function () {
      savePref(field, select.value);
    });
  }

  wireServerSelect("ultra-mode-select",      "ultraMode",      window.ULTRA_MODE      || "hidden");
  wireServerSelect("irrealiste-mode-select", "irrealisteMode", window.IRREALISTE_MODE || "visible");
  wireServerSelect("history-retention-select", "historyRetention", window.HISTORY_RETENTION || "1mois");

  var shareCheckbox = document.getElementById("share-notes-checkbox");
  if (shareCheckbox) {
    shareCheckbox.addEventListener("change", function () {
      savePref("shareNotesWithAdmin", shareCheckbox.checked);
    });
  }

  // ── Filtrage des tags (localStorage) ─────────────────────────────────────
  function wireLocalSelect(selectId, lsKey, defaultVal) {
    var select = document.getElementById(selectId);
    if (!select) return;
    select.value = localStorage.getItem(lsKey) || defaultVal;
    select.addEventListener("change", function () {
      localStorage.setItem(lsKey, select.value);
    });
  }

  wireLocalSelect("tag-logic-select", "wiki-tag-logic", "and");
  wireLocalSelect("tag-click-select", "tag-click-mode", "popup");

  // ── Zone dangereuse : double confirmation avant envoi, actions irréversibles ──
  var resetForm = document.getElementById("reset-account-form");
  if (resetForm) {
    resetForm.addEventListener("submit", function (e) {
      if (!window.confirm("Réinitialiser le compte ? Vos notes, étoiles, j'adore/intéressé, contenus masqués, commentaires et favoris seront définitivement supprimés.")) {
        e.preventDefault();
      }
    });
  }
  var deleteForm = document.getElementById("delete-account-form");
  if (deleteForm) {
    deleteForm.addEventListener("submit", function (e) {
      if (!window.confirm("Supprimer définitivement ce compte ? Cette action est irréversible.")) {
        e.preventDefault();
        return;
      }
      if (!window.confirm("Dernière confirmation : le compte et tout son contenu seront perdus pour toujours. Continuer ?")) {
        e.preventDefault();
      }
    });
  }
})();
</script>

<%- include('partials/foot') %>
