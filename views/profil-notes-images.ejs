<%- include('partials/head', { title: 'Profil : Images' }) %>
<main class="container wide gallery-has-sidebar profil-notes-page">
  <%- include('partials/top-nav', { config: config, navTitle: 'Images notées', navBack: '/favoris' }) %>

  <%- include('partials/profil-nav', { roleHue: roleHue }) %>

  <%# ─── VOLET FILTRE (à droite : la navigation du profil garde la gauche) ── %>
  <aside class="wiki-cat-sidebar gallery-sidebar profil-notes-filter">
    <div class="wiki-chapter-hero" style="--ch-hue: 220">
      <div class="wiki-chapter-hero-top">
        <span></span>
        <h1 class="wiki-chapter-hero-title">Images not&eacute;es</h1>
        <span></span>
      </div>
    </div>

    <div class="wiki-sidebar-body">

      <div class="wiki-search-wrap">
        <div class="wiki-search-bar">
          <input type="search" id="notes-search" class="wiki-search-input" placeholder="Recherche" autocomplete="off" />
        </div>
      </div>

      <details class="wiki-sidebar-filter-details" open>
      <summary class="wiki-sidebar-filter-summary">Filtres</summary>
      <div class="wiki-sidebar-filters">

        <%# Filtre type %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label">Type</span>
          <div class="links-filter" id="notes-ctype-filter">
            <button type="button" class="tag-chip" data-ctype="image">Images</button>
            <button type="button" class="tag-chip" data-ctype="bd">BD</button>
          </div>
        </div>

        <%# Tags %>
        <% if (allTags.length) { %>
        <div class="wiki-filter-section">
          <input type="search" id="notes-tag-search" class="wiki-tag-search-input" placeholder="Chercher un tag" autocomplete="off" />
          <div class="wiki-tag-cloud" id="notes-tag-filter">
            <% allTags.forEach(function(t) { %>
              <button type="button" class="wiki-tag-chip" data-tag="<%= t %>" data-state="0">
                <span class="wtc-label"><%= t %></span>
              </button>
            <% }) %>
          </div>
        </div>
        <% } %>

      </div>
      </details>

      <button type="button" id="notes-reset-filters" class="wiki-filter-reset-btn wiki-filter-reset-btn--danger">R&eacute;initialiser les filtres</button>

    </div>
  </aside>

  <%# ─── GRILLE ───────────────────────────────────────────────────────── %>
  <div class="profil-empty" id="notes-empty"<%= items.length ? ' hidden' : '' %>>
    <div class="profil-empty-icon">&#10024;</div>
    <p>Aucune donn&eacute;e pour l&apos;instant.<br><a href="/galerie">Commence &agrave; explorer la galerie</a>.</p>
  </div>
  <div class="gallery-grid" id="notes-grid"<%= items.length ? '' : ' hidden' %>>
    <% items.forEach(function(item) { %>
      <% var ctype = item.contentType || (item.type === 'bd' ? 'bd' : 'image'); %>
      <div class="gallery-card"
        data-item
        data-tags="<%= (item.tags || []).join(',').toLowerCase() %>"
        data-ctype="<%= ctype %>"
        data-title="<%= (item.title || '').toLowerCase().replace(/"/g, '') %>"
        data-rating="<%= item.rating || 0 %>">

        <% if (item.imagePaths && item.imagePaths[0]) { %>
          <a href="/galerie/<%= item.id %>/edit">
            <img src="<%= thumbUrl(item.imagePaths[0]) %>" alt="<%= item.title || '' %>" class="gallery-img" loading="lazy" />
          </a>
        <% } else if (item.filename) { %>
          <a href="/galerie/<%= item.id %>/edit">
            <img src="<%= thumbUrl(item.filename) %>" alt="<%= item.title || '' %>" class="gallery-img" loading="lazy" />
          </a>
        <% } %>

        <% if (ctype === 'bd' && item.title) { %>
          <div class="gallery-bd-title"><%= item.title %></div>
        <% } %>

        <div class="gallery-card-overlay">
          <span class="wiki-card-badges">
            <% if (item.flame) { %><span class="wiki-card-react-badge" title="J'adore">&#128293;</span><% } %>
            <% if (item.rating > 0) { %>
              <span class="wiki-card-react-badge" title="Note : <%= item.rating %>/5">
                <% for (var si = 1; si <= item.rating; si++) { %>&#9733;<% } %>
              </span>
            <% } %>
          </span>
        </div>

      </div>
    <% }) %>
  </div>

</main>
<script>
(function() {
  var items = document.querySelectorAll('[data-item]');
  var emptyEl = document.getElementById('notes-empty');
  var gridEl = document.getElementById('notes-grid');
  var activeTags = [];
  var activeCtype = '';
  var search = '';
  var hideUltra = localStorage.getItem('profil-hide-ultra') === '1';
  // Tags masqués (voir bouton "Masquer le tag" de la popup tag) : reste
  // masqué même dans ses propres notes, comme partout ailleurs sur le site.
  var blacklistSet = new Set((window.TAG_BLACKLIST || []).map(function(t) { return String(t).toLowerCase(); }));

  function show(el) { el.style.display = ''; }
  function hide(el) { el.style.display = 'none'; }

  function applyFilters() {
    var visible = 0;
    items.forEach(function(el) {
      var tags = (el.dataset.tags || '').split(',').filter(Boolean);
      var title = (el.dataset.title || '');
      var ctype = (el.dataset.ctype || '');
      var matchesTags = activeTags.length === 0 || activeTags.every(function(t) { return tags.includes(t); });
      var matchesSearch = !search || title.includes(search);
      var matchesCtype = !activeCtype || ctype === activeCtype;
      var matchesUltra = !hideUltra || tags.indexOf('ultra') === -1;
      var matchesBlacklist = blacklistSet.size === 0 || !tags.some(function(t) { return blacklistSet.has(t); });
      if (matchesTags && matchesSearch && matchesCtype && matchesUltra && matchesBlacklist) { show(el); visible++; }
      else { hide(el); }
    });
    if (emptyEl) emptyEl.hidden = visible > 0;
    if (gridEl) gridEl.hidden = visible === 0;
  }

  document.addEventListener('profil-ultra-toggle-change', function() {
    hideUltra = localStorage.getItem('profil-hide-ultra') === '1';
    applyFilters();
  });

  document.querySelectorAll('#notes-tag-filter .wiki-tag-chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      var tag = chip.dataset.tag;
      var idx = activeTags.indexOf(tag);
      if (idx === -1) { activeTags.push(tag); chip.classList.add('active'); chip.dataset.state = '1'; }
      else { activeTags.splice(idx, 1); chip.classList.remove('active'); chip.dataset.state = '0'; }
      applyFilters();
    });
  });

  document.querySelectorAll('#notes-ctype-filter .tag-chip').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var ctype = btn.dataset.ctype;
      if (activeCtype === ctype) {
        activeCtype = '';
        btn.classList.remove('active');
      } else {
        activeCtype = ctype;
        document.querySelectorAll('#notes-ctype-filter .tag-chip').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
      }
      applyFilters();
    });
  });

  var searchInput = document.getElementById('notes-search');
  var searchDebounceTimer = null;
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      search = this.value.toLowerCase().trim();
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(applyFilters, 120);
    });
  }

  var tagSearchInput = document.getElementById('notes-tag-search');
  var tagSearchDebounceTimer = null;
  if (tagSearchInput) {
    tagSearchInput.addEventListener('input', function() {
      clearTimeout(tagSearchDebounceTimer);
      tagSearchDebounceTimer = setTimeout(function() {
        var q = tagSearchInput.value.trim().toLowerCase();
        document.querySelectorAll('#notes-tag-filter .wiki-tag-chip').forEach(function(chip) {
          var tag = (chip.dataset.tag || '').toLowerCase();
          chip.hidden = q.length > 0 && tag.indexOf(q) === -1;
        });
      }, 120);
    });
  }

  var resetBtn = document.getElementById('notes-reset-filters');
  if (resetBtn) {
    resetBtn.addEventListener('click', function() {
      activeTags = [];
      activeCtype = '';
      search = '';
      if (searchInput) searchInput.value = '';
      if (tagSearchInput) tagSearchInput.value = '';
      document.querySelectorAll('#notes-tag-filter .wiki-tag-chip').forEach(function(c) {
        c.classList.remove('active'); c.dataset.state = '0'; c.hidden = false;
      });
      document.querySelectorAll('#notes-ctype-filter .tag-chip').forEach(function(b) { b.classList.remove('active'); });
      applyFilters();
    });
  }

  applyFilters();
})();
</script>
<%- include('partials/foot') %>
