<%- include('partials/head', { title: 'Codex' }) %>
<main class="container wide wiki-locked" style="--ch-hue: 250">
  <%- include('partials/top-nav', { config: config, navTitle: 'Codex', navBack: '/' }) %>

  <%- include('partials/mobile-filter-toggle') %>

  <%# ─── SIDEBAR ──────────────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer les filtres">&times;</button>

    <%# ─ En-tête ─ %>
    <div class="wiki-chapter-hero">
      <div class="wiki-chapter-hero-top">
        <span class="wiki-chapter-hero-back" aria-hidden="true"></span>
        <h1 class="wiki-chapter-hero-title">Codex</h1>
        <span class="wiki-chapter-hero-count"><%= totalCount %></span>
      </div>
    </div>

    <%# ─ Corps scrollable : recherche + filtres ─ %>
    <div class="wiki-sidebar-body">

      <div class="wiki-search-wrap">
        <div class="wiki-search-bar">
          <input type="search" id="wiki-search-input" class="wiki-search-input"
                 placeholder="Recherche" autocomplete="off" />
          <button type="button" id="wiki-search-clear" class="wiki-search-clear" hidden>&#215;</button>
        </div>
        <span id="wiki-result-count" class="wiki-result-count" hidden></span>
      </div>

      <details class="wiki-sidebar-filter-details">
      <summary class="wiki-sidebar-filter-summary">Filtres</summary>
      <div class="wiki-sidebar-filters">

        <div class="wiki-filter-section wiki-sort-cols-row">
          <select id="wiki-cols-select" class="wiki-sort-select wiki-cols-select">
            <option value="1">1 colonne</option>
            <option value="2">2 colonnes</option>
            <option value="3" selected>3 colonnes</option>
            <option value="4">4 colonnes</option>
            <option value="5">5 colonnes</option>
          </select>
          <select id="wiki-sort-select" class="wiki-sort-select">
            <option value="alpha-asc">Ordre alphab&eacute;tique</option>
            <option value="alpha-desc">Ordre alphab&eacute;tique inverse</option>
            <option value="date-desc">Plus r&eacute;cent</option>
            <option value="date-asc">Plus ancien</option>
            <option value="rating-desc">Mieux not&eacute;</option>
            <option value="category">Cat&eacute;gorie</option>
          </select>
        </div>

        <div class="wiki-filter-section wiki-filter-toggles">
          <button type="button" id="wiki-ultra-toggle" class="wiki-ultra-btn">Ultra</button>
          <button type="button" id="wiki-irrealiste-toggle" class="wiki-ultra-btn">Irr&eacute;aliste</button>
          <% if (hasOwnedItems) { %>
            <button type="button" class="tag-chip tag-chip-owned" data-category="__owned__" data-label="Nos objets">Nos objets</button>
          <% } %>
        </div>

        <%# Pas de "Tous" : aucune catégorie cochée = toutes affichées. Volet
            réduit (fermé par défaut) pour limiter l'espace pris par la liste. %>
        <details class="wiki-subpanel-details">
          <summary class="wiki-subpanel-summary">Cat&eacute;gorie</summary>
          <div class="links-filter wiki-index-cat-filter" id="wiki-category-filter">
            <% categories.forEach(function (c) { %>
              <button type="button" class="tag-chip" data-category="<%= c.key %>" data-label="<%= c.label %>"><%= c.label %></button>
            <% }) %>
          </div>
        </details>

        <details class="wiki-subpanel-details">
          <summary class="wiki-subpanel-summary">Notation</summary>
          <div class="wiki-filter-label-row">
            <span class="wiki-filter-label">Note minimale</span>
            <button type="button" class="wiki-adv-star-reset" id="wiki-adv-star-reset">&#10006;</button>
          </div>
          <div class="wiki-adv-stars" id="wiki-adv-stars">
            <% for (var si = 1; si <= 5; si++) { %>
              <button type="button" class="wiki-adv-star" data-value="<%= si %>">&#9734;</button>
            <% } %>
          </div>
          <%# "Possédé" retiré : doublon avec la bascule "Nos objets" ci-dessus. %>
          <div class="wiki-prop-grid" id="wiki-prop-grid">
            <button type="button" class="wiki-prop-btn" data-prop="not-rated" data-state="0">Pas encore not&eacute;</button>
            <button type="button" class="wiki-prop-btn" data-prop="flame" data-state="0">J&apos;adore</button>
            <button type="button" class="wiki-prop-btn" data-prop="interested" data-state="0"><%= interestedLabel %></button>
          </div>
        </details>

        <% if (allTags.length) { %>
          <div class="wiki-filter-section">
            <input type="search" id="wiki-tag-search" class="wiki-tag-search-input" placeholder="Chercher un tag" autocomplete="off" />
            <div class="wiki-tag-cloud" id="wiki-tag-filter">
              <% allTags.forEach(function (tag) { %>
                <button type="button" class="wiki-tag-chip" data-tag="<%= tag %>" data-state="0">
                  <span class="wtc-label"><%= tag %></span><% if (tagCounts && tagCounts[tag]) { %><span class="wtc-count"><%= tagCounts[tag] %></span><% } %>
                </button>
              <% }) %>
            </div>
            <div class="wiki-tag-footer">
              <button type="button" id="wiki-tag-expand-btn" class="wiki-tag-expand-btn" hidden>&#9660; Plus</button>
              <a href="/tags" class="wiki-tag-all-link" id="wiki-tag-all-link" hidden>Tous les tags</a>
            </div>
          </div>
        <% } %>

        <% if (currentUser) { %>
          <%- include('partials/filter-profiles', { section: 'wiki', profiles: locals.wikiFilterProfiles || [] }) %>
        <% } %>

      </div><%# /wiki-sidebar-filters %>
      </details>

      <div class="wiki-filter-section wiki-filter-bottom-actions">
        <% if (currentUser) { %>
          <button type="button" id="wiki-save-filter-btn" class="wiki-filter-reset-btn filter-profile-save-btn" hidden>Enregistrer le filtre</button>
        <% } %>
        <button type="button" id="wiki-reset-filters" class="wiki-filter-reset-btn wiki-filter-reset-btn--danger">R&eacute;initialiser les filtres</button>
        <% if (currentUser) { %>
          <button type="button" id="wiki-explore-btn" class="wiki-filter-reset-btn wiki-explore-btn">Explorer l&rsquo;inconnu</button>
        <% } %>
      </div>

    </div><%# /wiki-sidebar-body %>
  </aside>

  <%# ─── CONTENU PRINCIPAL ─────────────────────────────────────────────── %>

  <%# Native : intro + catégories + strips (masqué si filtre actif) %>
  <div id="wiki-index-native">

    <details class="wiki-intro-details">
      <summary class="wiki-intro-summary">! &Agrave; propos !</summary>
      <div class="wiki-index-intro">
        <p>Le codex de Confidence est un espace d&rsquo;encyclop&eacute;die agr&eacute;ment&eacute; par les administrateurs du site. Il vise &agrave; &ecirc;tre exhaustif sur tout ce qui touche &agrave; la sexualit&eacute;, des pratiques aux fantasmes en passant par les objets et les sc&eacute;narios. Vous pouvez noter, mettre en favoris et explorer &agrave; votre rythme.</p>
        <p>Il existe deux tags sp&eacute;ciaux&nbsp;: <strong>Ultra</strong>, pour les contenus les plus extr&ecirc;mes, et <strong>Irr&eacute;aliste</strong>, pour les sc&eacute;narios qui rel&egrave;vent davantage du fantasme pur. Ces deux tags peuvent &ecirc;tre masqu&eacute;s depuis les filtres.</p>
      </div>
    </details>

    <%# ─ Grille des catégories ─ %>
    <div class="wiki-index-cats">
      <% categories.forEach(function (ch) { %>
        <%
          var chData = chapters.find(function(c) { return c.key === ch.key; });
          var chCount = chData ? chData.count : 0;
        %>
        <a href="/wiki/categorie/<%= ch.key %>" class="wiki-index-cat-card" style="--ch-hue: <%= ch.hue %>">
          <span class="wiki-index-cat-label"><%= ch.label %></span>
          <span class="wiki-index-cat-count"><%= chCount %></span>
        </a>
      <% }) %>
    </div>

    <%# ─ Strips ─ %>
    <% if (recentAdded.length) { %>
      <div class="wiki-index-strip-section">
        <h2 class="wiki-index-strip-title">Derniers ajouts</h2>
        <div class="wiki-chapter-strip-wrap">
          <div class="wiki-chapter-strip">
            <% recentAdded.forEach(function (page) { %>
              <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
            <% }) %>
          </div>
          <div class="wiki-strip-fade" aria-hidden="true"></div>
        </div>
      </div>
    <% } %>

    <% if (recentUpdated.length) { %>
      <div class="wiki-index-strip-section">
        <h2 class="wiki-index-strip-title">Derni&egrave;res mises &agrave; jour</h2>
        <div class="wiki-chapter-strip-wrap">
          <div class="wiki-chapter-strip">
            <% recentUpdated.forEach(function (page) { %>
              <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
            <% }) %>
          </div>
          <div class="wiki-strip-fade" aria-hidden="true"></div>
        </div>
      </div>
    <% } %>

    <% if (popular.length) { %>
      <div class="wiki-index-strip-section">
        <h2 class="wiki-index-strip-title">Mes mieux not&eacute;es</h2>
        <div class="wiki-chapter-strip-wrap">
          <div class="wiki-chapter-strip">
            <% popular.forEach(function (page) { %>
              <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
            <% }) %>
          </div>
          <div class="wiki-strip-fade" aria-hidden="true"></div>
        </div>
      </div>
    <% } %>

  </div><%# /wiki-index-native %>

  <%# ─ Grille filtrée (masquée par défaut, visible si filtre actif) ─ %>
  <div class="wiki-pagination" id="wiki-pagination-top" hidden></div>
  <div class="wiki-grid" id="wiki-list" hidden>
    <% pages.forEach(function (page) { %>
      <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
    <% }) %>
  </div>
  <div class="wiki-pagination" id="wiki-pagination" hidden></div>

  <% if (currentUser && currentUser.isAdmin) { %>
    <button type="button" class="wiki-fab-list" id="wiki-fab-list-btn" title="Pages \u00e0 cr\u00e9er">&#9776;</button>
    <a href="/wiki/ajouter" class="wiki-fab-add" title="Ajouter une page">+</a>
  <% } %>

  <%# Données pour l'autocomplétion des liens wiki dans le formulaire d'ajout %>
  <script id="wiki-existing-pages" type="application/json"><%- JSON.stringify(pages.map(function(p){ return { id: p.id, title: p.title }; })) %></script>

  <%# ── Panneau TODO admin (pages à créer) ── %>
  <% if (currentUser && currentUser.isAdmin) { %>
    <%
      var TODO_CAT_ORDER = ['position','lieux','partenaires','jeu_de_role','tenues','objets','pratique','fantasmes','autre'];
      var todoCategories = TODO_CAT_ORDER.map(function(k) {
        return categories.find(function(c){ return c.key === k; });
      }).filter(Boolean);
    %>
    <script id="wiki-todo-cats" type="application/json"><%- JSON.stringify(todoCategories.map(function(c){
      return { key: c.key, label: c.label, hue: c.hue };
    })) %></script>

    <div class="wiki-todo-overlay" id="wiki-todo-overlay" hidden></div>
    <aside class="wiki-todo-drawer" id="wiki-todo-drawer" hidden aria-label="Pages \u00e0 cr\u00e9er">
      <div class="wiki-todo-header">
        <span class="wiki-todo-title">Pages &agrave; cr&eacute;er</span>
        <button type="button" class="wiki-todo-close" id="wiki-todo-close" aria-label="Fermer">&#215;</button>
      </div>
      <div class="wiki-todo-body" id="wiki-todo-body"></div>
    </aside>
  <% } %>

</main>
<script src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/codex-offline') %>
<%- include('partials/foot') %>
