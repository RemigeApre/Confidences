<%- include('partials/head', { title: 'Codex — Encyclopédie de sexologie illustrée | Confidence' }) %>
<%
  var WI_CAT_EN = {
    partenaires: 'Partners', position: 'Position', fantasmes: 'Fantasies',
    pratique: 'Practice', objets: 'Objects', lieux: 'Places',
    classique: 'Classic', hardcore: 'Hardcore', bdsm: 'BDSM',
    jeux_role: 'Role-play', fantaisie: 'Fantasy'
  };
%>
<main class="container wide wiki-locked" style="--ch-hue: 250">
  <%- include('partials/top-nav', { config: config, navTitle: 'Codex', navBack: '/', navAbout: true }) %>

  <%- include('partials/mobile-filter-toggle') %>

  <%# ─── SIDEBAR ──────────────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer les filtres">&times;</button>

    <%# ─ En-tête ─ %>
    <%- include('partials/sidebar-hero', { title: 'Codex', count: totalCount }) %>

    <%# ─ Corps scrollable : recherche + filtres ─ %>
    <div class="wiki-sidebar-body">

      <%- include('partials/search-bar', { searchId: 'wiki-search-input', showCount: true }) %>

      <details class="wiki-sidebar-filter-details">
      <summary class="wiki-sidebar-filter-summary" data-fr="Filtres" data-en="Filters">Filtres</summary>
      <div class="wiki-sidebar-filters">

        <div class="wiki-filter-section wiki-sort-cols-row">
          <select id="wiki-cols-select" class="wiki-sort-select wiki-cols-select">
            <option value="1" data-fr="1 colonne" data-en="1 column">1 colonne</option>
            <option value="2" data-fr="2 colonnes" data-en="2 columns">2 colonnes</option>
            <option value="3" selected data-fr="3 colonnes" data-en="3 columns">3 colonnes</option>
            <option value="4" data-fr="4 colonnes" data-en="4 columns">4 colonnes</option>
            <option value="5" data-fr="5 colonnes" data-en="5 columns">5 colonnes</option>
          </select>
          <select id="wiki-sort-select" class="wiki-sort-select">
            <option value="alpha-asc" data-fr="Ordre alphabétique" data-en="Alphabetical">Ordre alphab&eacute;tique</option>
            <option value="alpha-desc" data-fr="Ordre alphabétique inverse" data-en="Reverse alphabetical">Ordre alphab&eacute;tique inverse</option>
            <option value="date-desc" data-fr="Plus récent" data-en="Most recent">Plus r&eacute;cent</option>
            <option value="date-asc" data-fr="Plus ancien" data-en="Oldest">Plus ancien</option>
            <option value="rating-desc" data-fr="Mieux noté" data-en="Top rated">Mieux not&eacute;</option>
            <option value="category" data-fr="Catégorie" data-en="Category">Cat&eacute;gorie</option>
          </select>
        </div>

        <div class="wiki-filter-section wiki-filter-toggles">
          <button type="button" id="wiki-ultra-toggle" class="wiki-ultra-btn" data-fr="Ultra" data-en="Ultra">Ultra</button>
          <button type="button" id="wiki-irrealiste-toggle" class="wiki-ultra-btn" data-fr="Irréaliste" data-en="Unrealistic">Irr&eacute;aliste</button>
          <% if (hasOwnedItems && currentUser && (currentUser.isAdmin || currentUser.canSeeOwned)) { %>
            <button type="button" class="tag-chip tag-chip-owned" data-category="__owned__" data-label="Nos objets" data-fr="Nos objets" data-en="Our items">Nos objets</button>
          <% } %>
          <button type="button" id="wiki-complete-toggle" class="wiki-ultra-btn wiki-complete-btn" data-fr="Mise en avant" data-en="Highlight">Mise en avant</button>
          <button type="button" id="wiki-empty-toggle" class="wiki-ultra-btn wiki-empty-btn" data-fr="Griser les vides" data-en="Grey empty">Griser les vides</button>
        </div>

        <%# Pas de "Tous" : aucune catégorie cochée = toutes affichées. Volet
            réduit (fermé par défaut) pour limiter l'espace pris par la liste. %>
        <details class="wiki-subpanel-details">
          <summary class="wiki-subpanel-summary" data-fr="Catégorie" data-en="Category">Cat&eacute;gorie</summary>
          <div class="links-filter wiki-index-cat-filter" id="wiki-category-filter">
            <% categories.forEach(function (c) { %>
              <button type="button" class="tag-chip" data-category="<%= c.key %>" data-label="<%= c.label %>" data-fr="<%= c.label %>" data-en="<%= WI_CAT_EN[c.key] || c.label %>"><%= c.label %></button>
            <% }) %>
          </div>
        </details>

        <%# Filtre sous-catégorie (affiché dynamiquement par JS quand une seule catégorie est incluse) %>
        <div class="wiki-filter-section" id="wiki-sous-cat-section" hidden>
          <span class="wiki-filter-label" data-fr="Sous-catégorie" data-en="Sub-category">Sous-cat&eacute;gorie</span>
          <div class="wiki-sous-cat-filter" id="wiki-sous-cat-filter"></div>
        </div>

        <%- include('partials/filters/filter-wiki-rating', { interestedLabel: interestedLabel }) %>

        <%- include('partials/filters/filter-wiki-tags', { tags: allTags, counts: tagCounts || null }) %>

        <% if (currentUser) { %>
          <%- include('partials/filter-profiles', { section: 'wiki', profiles: locals.wikiFilterProfiles || [] }) %>
        <% } %>

      </div><%# /wiki-sidebar-filters %>
      </details>

      <div class="wiki-filter-section wiki-filter-bottom-actions">
        <% if (currentUser) { %>
          <button type="button" id="wiki-save-filter-btn" class="wiki-filter-reset-btn filter-profile-save-btn" hidden data-fr="Enregistrer le filtre" data-en="Save filter">Enregistrer le filtre</button>
        <% } %>
        <button type="button" id="wiki-reset-filters" class="wiki-filter-reset-btn wiki-filter-reset-btn--danger" data-fr="Réinitialiser les filtres" data-en="Reset filters">R&eacute;initialiser les filtres</button>
        <% if (currentUser) { %>
          <button type="button" id="wiki-explore-btn" class="wiki-filter-reset-btn wiki-explore-btn" data-fr="Explorer l'inconnu" data-en="Explore the unknown">Explorer l&rsquo;inconnu</button>
        <% } %>
      </div>

    </div><%# /wiki-sidebar-body %>
  </aside>

  <%# ─── CONTENU PRINCIPAL ─────────────────────────────────────────────── %>

  <%# Native : intro + catégories + strips (masqué si filtre actif) %>
  <div id="wiki-index-native">

    <details class="wiki-intro-details" id="wiki-intro-details-mobile">
      <summary class="wiki-intro-summary" data-fr="! À propos !" data-en="! About !">! &Agrave; propos !</summary>
      <div class="wiki-index-intro">
        <p data-fr="Le codex de Confidence est un espace d'encyclopédie agrémenté par les administrateurs du site. Il vise à être exhaustif sur tout ce qui touche à la sexualité, des pratiques aux fantasmes en passant par les objets et les scénarios. Vous pouvez noter, mettre en favoris et explorer à votre rythme." data-en="The Confidence codex is an encyclopedia curated by the site administrators. It aims to be exhaustive on everything related to sexuality — from practices to fantasies, objects and scenarios. You can rate, bookmark and explore at your own pace.">Le codex de Confidence est un espace d&rsquo;encyclop&eacute;die agr&eacute;ment&eacute; par les administrateurs du site. Il vise &agrave; &ecirc;tre exhaustif sur tout ce qui touche &agrave; la sexualit&eacute;, des pratiques aux fantasmes en passant par les objets et les sc&eacute;narios. Vous pouvez noter, mettre en favoris et explorer &agrave; votre rythme.</p>
        <p data-fr="Il existe deux tags spéciaux : Ultra, pour les contenus les plus extrêmes, et Irréaliste, pour les scénarios qui relèvent davantage du fantasme pur. Ces deux tags peuvent être masqués depuis les filtres." data-en="There are two special tags: Ultra, for the most extreme content, and Unrealistic, for scenarios that lean more towards pure fantasy. Both tags can be hidden from the filters.">Il existe deux tags sp&eacute;ciaux&nbsp;: <strong>Ultra</strong>, pour les contenus les plus extr&ecirc;mes, et <strong>Irr&eacute;aliste</strong>, pour les sc&eacute;narios qui rel&egrave;vent davantage du fantasme pur. Ces deux tags peuvent &ecirc;tre masqu&eacute;s depuis les filtres.</p>
      </div>
    </details>

    <%# ─ Grille des catégories ─ %>
    <%# Sur mobile : volet rétractable. Sur desktop : grille toujours visible. %>
    <details class="wiki-cats-collapsible">
      <summary class="wiki-cats-collapsible-summary" data-fr="Catégories" data-en="Categories">Cat&eacute;gories</summary>
      <div class="wiki-index-cats">
        <% categories.forEach(function (ch) { %>
          <%
            var chData = chapters.find(function(c) { return c.key === ch.key; });
            var chCount = chData ? chData.count : 0;
          %>
          <a href="/wiki/categorie/<%= ch.key %>" class="wiki-index-cat-card" style="--ch-hue: <%= ch.hue %>">
            <span class="wiki-index-cat-label" data-fr="<%= ch.label %>" data-en="<%= WI_CAT_EN[ch.key] || ch.label %>"><%= ch.label %></span>
            <span class="wiki-index-cat-count"><%= chCount %></span>
          </a>
        <% }) %>
      </div>
    </details>

    <%# ─ Strips ─ %>
    <% if (recentAdded.length) { %>
      <div class="wiki-index-strip-section">
        <h2 class="wiki-index-strip-title" data-fr="Derniers ajouts" data-en="Latest additions">Derniers ajouts</h2>
        <div class="wiki-chapter-strip-wrap">
          <div class="wiki-chapter-strip">
            <% recentAdded.forEach(function (page) { %>
              <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
            <% }) %>
          </div>
          <div class="wiki-strip-fade" aria-hidden="true"></div>
        </div>
      </div>
    <% } %>

    <% if (recentUpdated.length) { %>
      <div class="wiki-index-strip-section">
        <h2 class="wiki-index-strip-title" data-fr="Dernières mises à jour" data-en="Recently updated">Derni&egrave;res mises &agrave; jour</h2>
        <div class="wiki-chapter-strip-wrap">
          <div class="wiki-chapter-strip">
            <% recentUpdated.forEach(function (page) { %>
              <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
            <% }) %>
          </div>
          <div class="wiki-strip-fade" aria-hidden="true"></div>
        </div>
      </div>
    <% } %>

    <% if (popular.length) { %>
      <div class="wiki-index-strip-section">
        <h2 class="wiki-index-strip-title" data-fr="Mes mieux notées" data-en="My top rated">Mes mieux not&eacute;es</h2>
        <div class="wiki-chapter-strip-wrap">
          <div class="wiki-chapter-strip">
            <% popular.forEach(function (page) { %>
              <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
            <% }) %>
          </div>
          <div class="wiki-strip-fade" aria-hidden="true"></div>
        </div>
      </div>
    <% } %>

  </div><%# /wiki-index-native %>

  <%# ─ Grille filtrée (masquée par défaut, visible si filtre actif) ─ %>
  <div class="wiki-pagination" id="wiki-pagination-top" hidden></div>
  <div class="wiki-grid" id="wiki-list" hidden>
    <% pages.forEach(function (page) { %>
      <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
    <% }) %>
  </div>
  <div class="wiki-pagination" id="wiki-pagination" hidden></div>

  <% if (currentUser && currentUser.isAdmin) { %>
    <button type="button" class="wiki-fab-list" id="wiki-fab-list-btn" title="Pages \u00e0 cr\u00e9er">&#9776;</button>
    <a href="/wiki/ajouter" class="wiki-fab-add" title="Ajouter une page">+</a>
  <% } %>

  <%# Données pour l'autocomplétion des liens wiki dans le formulaire d'ajout %>
  <script id="wiki-existing-pages" type="application/json"><%- JSON.stringify(pages.map(function(p){ return { id: p.id, title: p.title }; })) %></script>

  <%# Sous-catégories par catégorie (pour le filtre dynamique JS) %>
  <script id="wiki-subcats-data" type="application/json"><%- JSON.stringify({
    pratique:  (pratiquesSubs  || []).map(function(s){ return { key: s.key, label: s.label }; }),
    objets:    (objetsSubs     || []).map(function(s){ return { key: s.key, label: s.label }; }),
    fantasmes: (fantasmesSubs  || []).map(function(s){ return { key: s.key, label: s.label }; }),
    tenues:    (tenuesSubs     || []).map(function(s){ return { key: s.key, label: s.label }; })
  }) %></script>

  <%# ── Panneau TODO admin (pages à créer) ── %>
  <% if (currentUser && currentUser.isAdmin) { %>
    <%
      var TODO_CAT_ORDER = ['position','lieux','partenaires','jeu_de_role','tenues','objets','pratique','fantasmes','autre'];
      var todoCategories = TODO_CAT_ORDER.map(function(k) {
        return categories.find(function(c){ return c.key === k; });
      }).filter(Boolean);
    %>
    <script id="wiki-todo-cats" type="application/json"><%- JSON.stringify(todoCategories.map(function(c){
      return { key: c.key, label: c.label, hue: c.hue };
    })) %></script>

    <div class="wiki-todo-overlay" id="wiki-todo-overlay" hidden></div>
    <aside class="wiki-todo-drawer" id="wiki-todo-drawer" hidden aria-label="Pages \u00e0 cr\u00e9er">
      <div class="wiki-todo-header">
        <span class="wiki-todo-title">Pages &agrave; cr&eacute;er</span>
        <button type="button" class="wiki-todo-close" id="wiki-todo-close" aria-label="Fermer">&#215;</button>
      </div>
      <div class="wiki-todo-body" id="wiki-todo-body"></div>
    </aside>
  <% } %>

</main>
<script nonce="<%= nonce %>" src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/codex-offline') %>
<style>
/* ── Catégories : volet rétractable sur mobile, grille fixe sur desktop ── */
.wiki-cats-collapsible > summary { display: none; }
.wiki-cats-collapsible { display: contents; }
@media(max-width:640px) {
  .wiki-cats-collapsible { display: block; margin-bottom: 1.1rem; }

  /* Summary — pill centrée élégante */
  .wiki-cats-collapsible > summary {
    display: flex; align-items: center; justify-content: center; gap: .5rem;
    width: fit-content; margin: 0 auto .9rem;
    padding: .45rem 1.2rem;
    border-radius: 999px;
    background: transparent;
    border: 1px solid rgba(255,255,255,.15);
    font-size: .78rem; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: #aaa;
    cursor: pointer; list-style: none; user-select: none;
    transition: border-color .15s, color .15s;
  }
  .wiki-cats-collapsible > summary::-webkit-details-marker { display: none; }
  .wiki-cats-collapsible > summary::after {
    content: "›"; font-size: 1rem; opacity: .6;
    transition: transform .2s; display: inline-block; line-height: 1;
  }
  .wiki-cats-collapsible[open] > summary { color: var(--fg); border-color: rgba(255,255,255,.3); }
  .wiki-cats-collapsible[open] > summary::after { transform: rotate(90deg); }

  /* Cartes catégories : centrées, taille uniforme */
  .wiki-cats-collapsible .wiki-index-cats {
    grid-template-columns: repeat(2, 1fr);
    gap: .55rem;
    margin-bottom: 0;
  }
  .wiki-cats-collapsible .wiki-index-cat-card {
    align-items: center; text-align: center;
    padding: .85rem .6rem;
    border-radius: 12px;
  }
  .wiki-cats-collapsible .wiki-index-cat-label {
    font-size: .85rem;
  }
  .wiki-cats-collapsible .wiki-index-cat-count {
    font-size: .8rem; align-self: center; margin-top: .2rem;
  }

  /* Bouton À propos masqué sur mobile — remplacé par le ? du header */
  .wiki-intro-details > summary.wiki-intro-summary { display: none; }
  .wiki-intro-details { margin-bottom: .5rem; }

  /* Titres de section encore plus discrets sur mobile */
  .wiki-index-strip-title { color: #606070; }
}
</style>
<script nonce="<%= nonce %>">
(function() {
  // Sur desktop : ouvrir le volet catégories (toujours visible)
  if (window.innerWidth > 640) {
    var catDetails = document.querySelector('.wiki-cats-collapsible');
    if (catDetails) catDetails.open = true;
  }

  var aboutBtn = document.getElementById('mobile-about-btn');
  var aboutDetails = document.getElementById('wiki-intro-details-mobile');
  if (!aboutBtn || !aboutDetails) return;
  aboutBtn.addEventListener('click', function() {
    var open = aboutDetails.open;
    aboutDetails.open = !open;
    aboutBtn.setAttribute('aria-expanded', !open ? 'true' : 'false');
  });
})();
</script>
<%- include('partials/ai-nav', { aiNavPages: locals.aiNavPages || [] }) %>
<%- include('partials/foot') %>
