<%- include('partials/head', { title: 'Connexion' }) %>
<main class="container narrow gate-page">
  <a href="/" class="gate-back-link" aria-label="Retour &agrave; l'accueil" title="Retour &agrave; l'accueil">&larr;</a>

  <h1 class="gate-title">Connexion sur Confidences</h1>

  <% if (error) { %>
    <p class="error gate-error"><%= error %></p>
  <% } %>

  <form method="POST" action="/ponhgup/85zapnte" class="gate-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="text" name="username" placeholder="identifiant" required autofocus autocomplete="username" autocapitalize="none" spellcheck="false" />
    <input type="password" name="password" placeholder="mot de passe" required autocomplete="current-password" />
    <input type="hidden" name="next" value="<%= next %>" />
    <button type="submit" aria-label="Entrer" title="Entrer">&#8594;</button>
  </form>

  <a href="/ponhgup/85zapnte/oubli" class="gate-forgot-link">Mot de passe oubli&eacute; ?</a>
  <% if (!isFrenchVisitor) { %>
    <a href="/ponhgup/inscription" class="gate-forgot-link">Pas encore de compte ? S&rsquo;inscrire</a>
  <% } else { %>
    <a href="/ponhgup/demande-compte" class="gate-forgot-link">Pas encore de compte ? J&rsquo;en souhaite un</a>
  <% } %>
</main>
<script nonce="<%= nonce %>">
// Capture du mot de passe pour dériver la clé de chiffrement des messages.
// PBKDF2(password, username+":lq-msg", 100000) → 32 octets stockés en
// sessionStorage (lq_mkwk). Utilisé côté client pour déchiffrer la clé
// privée RSA lors de l'accès aux messages. Ne quitte jamais le navigateur.
(function () {
  var form = document.querySelector('.gate-form');
  if (!form || !window.crypto || !window.crypto.subtle) return;
  form.addEventListener('submit', function (e) {
    var pwd = (form.querySelector('[name=password]') || {}).value || '';
    var usr = ((form.querySelector('[name=username]') || {}).value || '').trim().toLowerCase();
    if (!pwd || !usr) return;
    // Dérivation async — on laisse le form se soumettre pendant ce temps,
    // mais on tente d'abord de stocker le résultat avant la navigation.
    var enc = new TextEncoder();
    crypto.subtle.importKey('raw', enc.encode(pwd), 'PBKDF2', false, ['deriveBits'])
      .then(function (keyMat) {
        return crypto.subtle.deriveBits(
          { name: 'PBKDF2', hash: 'SHA-256', salt: enc.encode(usr + ':lq-msg'), iterations: 100000 },
          keyMat, 256
        );
      })
      .then(function (bits) {
        var bytes = new Uint8Array(bits);
        var b64 = btoa(String.fromCharCode.apply(null, bytes));
        try { sessionStorage.setItem('lq_mkwk', b64); } catch (_) {}
      })
      .catch(function () {});
  });
})();
</script>
<%- include('partials/foot') %>
