<%- include('partials/head', { title: 'Admin : ' + detail.user.displayName + ' : Activité', extraCss: ['admin.css'] }) %>

<div class="admin-topbar">
  <a href="/admin#tab-utilisateurs" class="admin-topbar-back">&#8592; Retour</a>
  <span class="admin-topbar-title"><%= config.title %></span>
</div>

<div class="aud-layout">
  <%- include('partials/admin-user-nav', { detail: detail, roleHue: roleHue }) %>

  <main class="aud-content">

    <%
      var TYPE_META = {
        wiki:    { label: 'Codex',       icon: '📖', cls: 'aud-type--wiki' },
        gallery: { label: 'Image',       icon: '🖼',  cls: 'aud-type--gallery' },
        bd:      { label: 'BD',          icon: '📚', cls: 'aud-type--bd' },
        nav:     { label: 'Navigation',  icon: '🔍', cls: 'aud-type--nav' }
      };
    %>

    <div class="aud-section">
      <h2 class="aud-section-title">Activit&eacute; r&eacute;cente (<%= feed.length %> consultations)</h2>
      <% if (feed.length) { %>
        <ul class="aud-activity-list">
          <% feed.forEach(function(f) { %>
            <% var meta = TYPE_META[f.type] || TYPE_META.nav; %>
            <li class="aud-activity-row">
              <span class="aud-activity-icon"><%- meta.icon %></span>
              <span class="aud-activity-type <%= meta.cls %>"><%= meta.label %></span>
              <% if (f.href) { %>
                <a href="<%= f.href %>" class="aud-activity-title"><%= f.label || '—' %></a>
              <% } else { %>
                <span class="aud-activity-title"><%= f.label || '—' %></span>
              <% } %>
              <span class="aud-activity-date"><%= new Date(f.at).toLocaleString('fr-FR') %></span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="admin-muted">Aucune activit&eacute; enregistr&eacute;e.</p>
      <% } %>
    </div>

  </main>
</div>
<%- include('partials/foot') %>
