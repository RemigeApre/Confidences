            <textarea class="js-card-summary" data-card-id="<%= wc.id %>" rows="2"
              placeholder="Résumé (dos de carte)…"
              style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#cbd5e1;border-radius:5px;padding:.3rem .45rem;font-size:.72rem;resize:vertical;outline:none;font-family:inherit"><%= wc.cardSummary || '' %></textarea>
            <span class="js-card-save-status" style="font-size:.68rem;height:.85em;color:#4ade80;display:block">&nbsp;</span>
            <%/* Déclinaisons */%>
            <div class="js-variants-wrap" style="border-top:1px solid rgba(255,255,255,.07);margin-top:.3rem;padding-top:.3rem">
              <button class="js-variants-toggle" data-card-id="<%= wc.id %>"
                style="background:none;border:none;color:#94a3b8;font-size:.7rem;cursor:pointer;padding:0;display:flex;align-items:center;gap:.3rem;width:100%">
                <span style="font-size:.65rem">&#9654;</span>
                Déclinaisons (<span class="js-variant-count"><%= (wc.variants||[]).length %></span>)
              </button>
              <div class="js-variants-body" style="display:none;margin-top:.4rem;display:none">
                <% (wc.variants || []).forEach(function(v) { %>
                <%
                  var vColor = v.card_rarity === 'mythic' ? '#f87171' : v.card_rarity === 'legendary' ? '#fbbf24' : v.card_rarity === 'epic' ? '#a78bfa' : v.card_rarity === 'rare' ? '#60a5fa' : '#94a3b8';
                %>
                <div class="js-variant-row" data-variant-id="<%= v.id %>"
                  style="background:rgba(0,0,0,.2);border-radius:6px;padding:.4rem .5rem;margin-bottom:.3rem;display:flex;flex-direction:column;gap:.25rem">
                  <input type="text" class="js-variant-title" value="<%= v.title %>"
                    placeholder="Titre…"
                    style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#f1f5f9;border-radius:4px;padding:.25rem .4rem;font-size:.72rem;font-family:inherit;outline:none;width:100%">
                  <select class="charm-rarity-select no-arrow js-variant-rarity" style="border-color:<%= vColor %>;color:<%= vColor %>">
                    <% ['common','rare','epic','legendary','mythic'].forEach(function(r) { %>
                      <option value="<%= r %>"<%= v.card_rarity === r ? ' selected' : '' %>><%= { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[r] %></option>
                    <% }) %>
                  </select>
                  <textarea class="js-variant-summary" rows="2" placeholder="Résumé…"
                    style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#cbd5e1;border-radius:4px;padding:.25rem .4rem;font-size:.72rem;resize:vertical;outline:none;font-family:inherit"><%= v.card_summary || '' %></textarea>
                  <div style="display:flex;gap:.3rem;align-items:center">
                    <button class="js-variant-save" style="background:#1e40af;border:none;color:#fff;font-size:.65rem;padding:.2rem .45rem;border-radius:4px;cursor:pointer">Sauver</button>
                    <button class="js-variant-delete" style="background:#7f1d1d;border:none;color:#fca5a5;font-size:.65rem;padding:.2rem .45rem;border-radius:4px;cursor:pointer">Suppr.</button>
                    <span class="js-variant-status" style="font-size:.65rem;color:#4ade80"></span>
                  </div>
                </div>
                <% }) %>
                <div class="js-add-variant-form" style="margin-top:.25rem;display:flex;flex-direction:column;gap:.2rem">
                  <input type="text" class="js-new-variant-title" placeholder="Nouveau titre…"
                    style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#f1f5f9;border-radius:4px;padding:.25rem .4rem;font-size:.72rem;font-family:inherit;outline:none">
                  <button class="js-add-variant-btn" data-card-id="<%= wc.id %>"
                    style="background:#064e3b;border:1px solid #065f46;color:#6ee7b7;font-size:.68rem;padding:.25rem .5rem;border-radius:4px;cursor:pointer">
