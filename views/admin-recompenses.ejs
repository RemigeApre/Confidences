<%- include('partials/head', { title: 'Admin : Objets', extraCss: ['admin.css'] }) %>

<style>
/* ── Images grid ── */
.ari-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(96px,1fr)); gap:.5rem; margin-top:.75rem; }
.ari-card { position:relative; border-radius:8px; overflow:hidden; cursor:pointer; border:2px solid transparent; transition:border-color .15s, transform .12s; aspect-ratio:1; background:#0f172a; }
.ari-card:hover { transform:scale(1.03); border-color:rgba(255,255,255,.3); }
.ari-card img { width:100%; height:100%; object-fit:cover; display:block; }
.ari-card-rarity { position:absolute; bottom:0; left:0; right:0; font-size:.6rem; font-weight:700; text-align:center; padding:.12rem; letter-spacing:.04em; text-transform:uppercase; }
.ari-card[data-rarity="common"]    .ari-card-rarity { background:rgba(0,0,0,.6); color:#94a3b8; }
.ari-card[data-rarity="rare"]      .ari-card-rarity { background:rgba(37,99,235,.7); color:#bfdbfe; }
.ari-card[data-rarity="epic"]      .ari-card-rarity { background:rgba(109,40,217,.7); color:#ddd6fe; }
.ari-card[data-rarity="legendary"] .ari-card-rarity { background:rgba(180,83,9,.75); color:#fde68a; }
.ari-card[data-rarity="mythic"]    .ari-card-rarity { background:rgba(185,28,28,.75); color:#fca5a5; }

/* ── Zoom overlay ── */
.ari-zoom-overlay { position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.85); display:flex; align-items:center; justify-content:center; }
.ari-zoom-overlay[hidden] { display:none; }
.ari-zoom-box { position:relative; background:#1e293b; border-radius:14px; padding:1.5rem; width:min(95vw,780px); display:flex; gap:1.5rem; flex-wrap:wrap; align-items:flex-start; }
.ari-zoom-img-wrap { flex:1; min-width:200px; max-width:360px; }
.ari-zoom-img-wrap img { width:100%; border-radius:8px; object-fit:contain; max-height:420px; }
.ari-zoom-side { flex:1; min-width:180px; display:flex; flex-direction:column; gap:1rem; }
.ari-zoom-title { font-weight:700; font-size:1rem; color:#f1f5f9; margin:0; }
.ari-zoom-subtitle { font-size:.78rem; color:#64748b; margin:.15rem 0 0; }
.ari-profile-preview { width:72px; height:72px; border-radius:50%; overflow:hidden; border:3px solid rgba(255,255,255,.15); flex-shrink:0; }
.ari-profile-preview img { width:100%; height:100%; object-fit:cover; }
.ari-rarity-btns { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.25rem; }
.ari-rarity-btn { border:2px solid; border-radius:6px; padding:.3rem .65rem; font-size:.75rem; font-weight:700; cursor:pointer; background:transparent; transition:background .12s, color .12s; text-transform:uppercase; letter-spacing:.04em; }
.ari-rarity-btn[data-rarity="common"]    { border-color:#94a3b8; color:#94a3b8; }
.ari-rarity-btn[data-rarity="rare"]      { border-color:#60a5fa; color:#60a5fa; }
.ari-rarity-btn[data-rarity="epic"]      { border-color:#a78bfa; color:#a78bfa; }
.ari-rarity-btn[data-rarity="legendary"]{ border-color:#fbbf24; color:#fbbf24; }
.ari-rarity-btn[data-rarity="mythic"]    { border-color:#f87171; color:#f87171; }
.ari-rarity-btn.active[data-rarity="common"]    { background:#94a3b8; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="rare"]      { background:#60a5fa; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="epic"]      { background:#a78bfa; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="legendary"] { background:#fbbf24; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="mythic"]    { background:#f87171; color:#0f172a; }
.ari-nav-btns { display:flex; gap:.5rem; }
.ari-nav-btn { width:40px; height:40px; border-radius:8px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18); color:#f1f5f9; cursor:pointer; font-size:1.1rem; display:flex; align-items:center; justify-content:center; transition:background .12s; }
.ari-nav-btn:hover { background:rgba(255,255,255,.18); }
.ari-zoom-close { position:absolute; top:.6rem; right:.8rem; background:none; border:none; color:#f87171; cursor:pointer; padding:.25rem; line-height:0; }
.ari-zoom-close:hover { color:#ef4444; }
.ari-save-status { font-size:.78rem; height:1.2em; transition:opacity .3s; }
.ari-filter-bar { display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:.75rem; }
.ari-filter-btn { border:1px solid rgba(255,255,255,.2); background:rgba(255,255,255,.05); color:#94a3b8; border-radius:5px; padding:.3rem .65rem; font-size:.75rem; font-weight:600; cursor:pointer; text-transform:uppercase; transition:background .12s; }
.ari-filter-btn.active, .ari-filter-btn:hover { background:rgba(255,255,255,.15); color:#f1f5f9; }

/* ── Charm / theme rarity select ── */
.charm-rarity-select {
  background:#1e293b; border:1px solid rgba(255,255,255,.2);
  color:#f1f5f9; border-radius:6px; padding:.3rem .5rem; font-size:.75rem;
  font-weight:700; cursor:pointer; width:100%; margin-top:.35rem;
  text-transform:uppercase; letter-spacing:.04em;
  transition:border-color .15s;
}
.charm-rarity-select option { background:#1e293b; color:#f1f5f9; }
.charm-rarity-select:focus { outline:none; border-color:rgba(255,255,255,.4); }
.charm-rarity-select.no-arrow {
  appearance:none; -webkit-appearance:none;
  text-align:center; text-align-last:center;
  padding-left:.5rem;
}

/* General admin select rule */
.obj-section select { background:#1e293b; color:#f1f5f9; }

/* ── Filter select dropdowns ── */
.admin-filter-select {
  background:#1e293b; border:1px solid rgba(255,255,255,.2);
  color:#f1f5f9; border-radius:6px; padding:.3rem .55rem; font-size:.78rem;
  font-weight:600; cursor:pointer; outline:none; font-family:inherit;
  transition:border-color .15s;
}
.admin-filter-select:focus { border-color:rgba(255,255,255,.4); }
.admin-filter-select option { background:#1e293b; color:#f1f5f9; }

/* ── Section switching ── */
.obj-section { display:none; }
.obj-section.active { display:block; }

/* ── Sidebar nav links ── */
.obj-nav-link {
  display:flex; align-items:center; gap:.6rem;
  padding:.5rem .75rem; border-radius:7px; text-decoration:none;
  font-size:.875rem; font-weight:600; transition:background .15s;
  color:#94a3b8; cursor:pointer; border:none; background:none; width:100%;
  text-align:left;
}
.obj-nav-link:hover { background:rgba(255,255,255,.07); }
.obj-nav-link.active { background:rgba(248,113,113,.18); color:#fca5a5; }
.obj-nav-count { margin-left:auto; font-size:.7rem; font-weight:700; opacity:.9; }

/* ── Accueil cards ── */
.obj-home-card { background:rgba(255,255,255,.04); border:1.5px solid rgba(255,255,255,.08); border-radius:12px; padding:1.1rem 1.25rem; margin-bottom:.85rem; }
.obj-home-card-header { display:flex; align-items:center; gap:.6rem; margin-bottom:.65rem; }
.obj-home-card-icon { font-size:1.2rem; }
.obj-home-card-title { font-size:.95rem; font-weight:700; color:#e2e8f0; flex:1; }
.obj-home-card-total { font-size:.8rem; color:#64748b; }
.obj-home-goto { background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.12); color:#94a3b8; border-radius:6px; padding:.25rem .6rem; font-size:.78rem; cursor:pointer; }
.obj-home-goto:hover { background:rgba(255,255,255,.14); color:#f1f5f9; }
.obj-home-rarities { display:flex; flex-wrap:wrap; gap:.5rem; }
.obj-rarity-chip { display:inline-flex; align-items:center; gap:.35rem; font-size:.78rem; padding:.2rem .5rem; border-radius:20px; background:rgba(255,255,255,.05); }
.obj-rarity-chip-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
.obj-rarity-chip[data-rarity="common"] .obj-rarity-chip-dot { background:#94a3b8; }
.obj-rarity-chip[data-rarity="rare"] .obj-rarity-chip-dot { background:#60a5fa; }
.obj-rarity-chip[data-rarity="epic"] .obj-rarity-chip-dot { background:#a78bfa; }
.obj-rarity-chip[data-rarity="legendary"] .obj-rarity-chip-dot { background:#fbbf24; }
.obj-rarity-chip[data-rarity="mythic"] .obj-rarity-chip-dot { background:#f87171; }
.obj-rarity-chip strong { color:#f1f5f9; }
.obj-always-badge { font-size:.7rem; color:#64748b; background:rgba(255,255,255,.05); border-radius:4px; padding:.15rem .45rem; text-transform:uppercase; letter-spacing:.05em; margin-top:.35rem; display:inline-block; }

/* ── Selection mode ── */
.obj-section.obj-sel-mode .ari-filter-bar { display:none; }
.obj-section.obj-sel-mode .ari-card { cursor:pointer; position:relative; }
.obj-section.obj-sel-mode .ari-card.obj-selected { outline:3px solid #60a5fa; outline-offset:2px; }
.obj-section.obj-sel-mode .ari-charm-card { cursor:pointer; }
.obj-section.obj-sel-mode .ari-charm-card.obj-selected { border-color:#60a5fa !important; background:rgba(96,165,250,.1) !important; }
.obj-section.obj-sel-mode .obj-theme-selcard { cursor:pointer; }
.obj-section.obj-sel-mode .obj-theme-selcard.obj-selected { outline:3px solid #60a5fa; outline-offset:2px; }
.obj-sel-bar { position:fixed; bottom:0; left:0; right:0; background:#1e293b; border-top:1.5px solid rgba(255,255,255,.12); padding:.65rem 1.5rem; display:flex; align-items:center; gap:.75rem; z-index:400; }
.obj-sel-bar[hidden] { display:none; }
.obj-sel-count { font-size:.85rem; color:#94a3b8; flex:1; }
.obj-sel-cancel { background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.15); color:#94a3b8; border-radius:6px; padding:.35rem .85rem; font-size:.82rem; cursor:pointer; }
.obj-sel-confirm-btn { background:#60a5fa; border:none; color:#0f172a; border-radius:6px; padding:.35rem .85rem; font-size:.82rem; font-weight:700; cursor:pointer; }
.obj-sel-confirm-btn[data-action="delete"] { background:#f87171; }
.obj-tool-btn { background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.12); border-radius:6px; width:30px; height:30px; display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:.95rem; transition:background .12s; }
.obj-tool-btn:hover { background:rgba(255,255,255,.15); }
.obj-tools { display:flex; gap:.4rem; margin-left:auto; }
.obj-section-toolbar { display:flex; align-items:center; flex-wrap:wrap; gap:.5rem; margin-bottom:.75rem; }
.obj-section-toolbar .ari-filter-bar { margin-bottom:0; flex:1; flex-wrap:wrap; }

/* ── Personnages — tuiles visuelles ── */
.pc-cards-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(130px,1fr)); gap:.65rem; margin-top:.75rem; }
.pc-card-tile { border-radius:10px; overflow:hidden; cursor:pointer; border:2px solid rgba(255,255,255,.07); transition:border-color .15s, transform .12s; display:flex; flex-direction:column; background:#0f172a; }
.pc-card-tile:hover { transform:scale(1.03); border-color:rgba(255,255,255,.28); }
.pc-card-tile-img { position:relative; aspect-ratio:3/4; overflow:hidden; flex-shrink:0; }
.pc-card-tile-img img { width:100%; height:100%; object-fit:cover; display:block; }
.pc-card-tile-placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:2.2rem; background:#0f172a; color:#334155; }
.pc-card-tile-rarity { position:absolute; bottom:0; left:0; right:0; font-size:.58rem; font-weight:800; text-align:center; padding:.15rem; letter-spacing:.06em; text-transform:uppercase; background:rgba(0,0,0,.65); }
.pc-card-tile-footer { padding:.35rem .45rem .4rem; display:flex; flex-direction:column; gap:.1rem; }
.pc-card-tile-name { font-size:.72rem; font-weight:700; color:#f1f5f9; line-height:1.25; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.pc-card-tile-parody { font-size:.6rem; color:#475569; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

/* ── Style carte à jouer (admin mirror de style.css) ── */
.lb-codex-flip-front.pc-gwent-front {
  display:flex; flex-direction:column;
  background:#f0ead8;
  border:2px solid #1a1a1a;
  box-shadow:inset 0 0 0 2px #f0ead8, inset 0 0 0 3px #1a1a1a;
  border-radius:7px;
}
.pc-gwent-art { flex:1; overflow:hidden; position:relative; min-height:0; margin:4px 4px 0; border-radius:4px 4px 0 0; }
.pc-gwent-art img { width:100%; height:100%; object-fit:cover; object-position:top center; display:block; }
.pc-gwent-art-placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#e8e0cc; }
.pc-gwent-footer {
  flex-shrink:0; background:#f0ead8; border-top:1.5px solid #1a1a1a;
  margin:0 4px 4px; padding:.32rem .5rem .3rem;
  text-align:center; display:flex; flex-direction:column; gap:.14rem;
}
.pc-gwent-name { color:#1a1a1a; font-size:.8rem; font-weight:800; line-height:1.2; letter-spacing:.01em; display:block; }
.pc-gwent-quote { color:#3d3528; font-size:.6rem; font-style:italic; font-weight:400; line-height:1.3; display:block; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }

/* ── Admin personnage card specifics ── */
.pc-admin-ultra-badge {
  position:absolute; top:.38rem; left:.42rem;
  background:rgba(168,85,247,.85); color:#fff;
  font-size:.52rem; font-weight:800; letter-spacing:.08em;
  text-transform:uppercase; padding:.12rem .35rem; border-radius:3px;
}
.pc-admin-card-back {
  background:rgba(15,23,42,.97);
  display:flex; align-items:center; justify-content:center;
}
.pc-admin-back-edit-btn {
  background:#1e3a5f; border:1px solid #2563eb; color:#93c5fd;
  border-radius:7px; padding:.5rem 1.1rem; font-size:.85rem;
  cursor:pointer; font-family:inherit; transition:background .12s;
}
.pc-admin-back-edit-btn:hover { background:#1e40af; }
/* Flag toggle buttons */
.pc-flag-btn {
  background:rgba(255,255,255,.07); border:1.5px solid rgba(255,255,255,.15);
  color:#94a3b8; border-radius:6px; padding:.3rem .7rem; font-size:.78rem;
  font-weight:600; cursor:pointer; font-family:inherit; transition:all .12s;
}
.pc-flag-btn.active[data-flag="isBaseDeck"] { background:rgba(52,211,153,.15); border-color:#34d399; color:#34d399; }
.pc-flag-btn.active[data-flag="isUltra"]    { background:rgba(168,85,247,.2);  border-color:#a855f7; color:#d8b4fe; }

/* ── Modal personnage ── */
.pc-modal-overlay { position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.82); display:flex; align-items:center; justify-content:center; padding:1rem; }
.pc-modal-overlay[hidden] { display:none; }
.pc-modal-box { background:#1e293b; border-radius:14px; width:min(95vw,680px); max-height:90vh; display:flex; flex-direction:column; overflow:hidden; }
/* Header bandeau */
.pc-modal-header { display:flex; align-items:center; gap:.75rem; padding:.7rem 1rem .65rem; background:#162032; border-bottom:1px solid rgba(255,255,255,.08); flex-shrink:0; }
.pc-modal-header-info { flex:1; min-width:0; }
.pc-modal-header-name { font-size:.95rem; font-weight:700; color:#f1f5f9; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; }
.pc-modal-header-tags { font-size:.72rem; color:#64748b; display:block; }
.pc-modal-close { background:none; border:none; color:#f87171; cursor:pointer; padding:.2rem; line-height:0; flex-shrink:0; }
.pc-modal-close:hover { color:#ef4444; }
/* Corps */
.pc-modal-body { display:flex; flex-direction:row; gap:0; flex:1; min-height:0; overflow:hidden; }
.pc-modal-img-col { width:110px; min-width:110px; flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:.5rem; padding:.85rem .6rem .85rem .8rem; align-self:flex-start; }
.pc-modal-img-wrap { width:90px; height:120px; border-radius:7px; overflow:hidden; background:#0f172a; flex-shrink:0; }
.pc-modal-img-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
.pc-modal-img-ph { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:2rem; color:#334155; }
.pc-modal-right { flex:1; padding:.85rem 1rem .85rem .5rem; overflow-y:auto; display:flex; flex-direction:column; gap:.6rem; }
.pc-modal-section { display:flex; flex-direction:column; gap:.28rem; }
.pc-modal-label { font-size:.68rem; color:#64748b; font-weight:700; text-transform:uppercase; letter-spacing:.06em; margin:0; }
/* Inputs */
.pc-modal-input {
  background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12);
  color:#f1f5f9; border-radius:5px; padding:.28rem .4rem; font-size:.78rem;
  outline:none; font-family:inherit; width:100%; box-sizing:border-box;
  text-align:center;
}
.pc-modal-input:focus { border-color:rgba(255,255,255,.35); background:rgba(255,255,255,.09); }
.pc-modal-input option { background:#1e293b; color:#f1f5f9; }
select.pc-modal-input { background:#1e293b; }
/* Selects colorés */
select#pcSelStatut[value="base"]   { border-color:#34d399; color:#34d399; }
select#pcSelVisibilite[value="ultra"] { border-color:#a855f7; color:#d8b4fe; }
/* Stat inputs colorés */
#pcStatVitesse { border-color:rgba(251,191,36,.35); color:#fbbf24; }
#pcStatDefense { border-color:rgba(96,165,250,.35); color:#60a5fa; }
#pcStatDomSub  { border-color:rgba(167,139,250,.35); color:#a78bfa; }
#pcStatOrientation { border-color:rgba(52,211,153,.3); color:#6ee7b7; }
/* Champ texte action */
.pc-modal-input[id*="_name"] { color:#e2e8f0; text-align:left; }
/* Champ puissance */
.pc-modal-input[id*="_power"] { border-color:rgba(251,191,36,.3); color:#fbbf24; }
/* PV */
#pcStatPv { border-color:rgba(248,113,113,.4); color:#f87171; }
/* Passif */
#pcSelPassif { border-color:rgba(251,191,36,.25); color:#fde68a; }
/* Effet action */
.pc-modal-input[id*="_effet"] { border-color:rgba(52,211,153,.25); color:#6ee7b7; font-size:.72rem; }
/* Label action coloré */
.pc-action-label { font-size:.6rem; font-weight:800; text-transform:uppercase; letter-spacing:.06em; text-align:center; }
/* Affinités */
.pc-affinites-wrap { display:flex; flex-wrap:wrap; gap:.3rem; margin-top:.25rem; }
.pc-affinite-chip { background:rgba(99,102,241,.2); border:1px solid rgba(99,102,241,.4); color:#a5b4fc; border-radius:20px; font-size:.65rem; padding:.15rem .5rem; display:flex; align-items:center; gap:.25rem; }
.pc-affinite-chip-del { background:none; border:none; color:#f87171; cursor:pointer; padding:0; font-size:.7rem; line-height:1; }
/* Genre sur carte gwent */
.pc-gwent-gender { font-size:.6rem; color:rgba(26,26,26,.55); font-style:italic; letter-spacing:.03em; }
</style>

<div class="admin-topbar">
  <span class="admin-topbar-title"><%= config.title %></span>
</div>

<nav class="admin-tabs-nav">
  <div class="admin-tabs-center">
    <a href="/admin#tab-utilisateurs" class="admin-tab-btn admin-tab--sys admin-tab-btn--link">Utilisateurs</a>
    <span class="admin-tab-btn active admin-tab--sys" style="cursor:default">R&eacute;compenses</span>
    <span class="admin-tabs-sep" aria-hidden="true"></span>
    <a href="/admin#tab-wiki" class="admin-tab-btn admin-tab--content admin-tab-btn--link">Codex</a>
    <a href="/admin#tab-galerie" class="admin-tab-btn admin-tab--content admin-tab-btn--link">Galerie</a>
    <a href="/admin#tab-bd" class="admin-tab-btn admin-tab--content admin-tab-btn--link">BD</a>
    <a href="/admin#tab-histoires" class="admin-tab-btn admin-tab--content admin-tab-btn--link">Histoires</a>
    <a href="/admin/jeux" class="admin-tab-btn admin-tab--content admin-tab-btn--link">Jeux</a>
    <span class="admin-tabs-sep" aria-hidden="true"></span>
    <a href="/admin#tab-ia" class="admin-tab-btn admin-tab--sys admin-tab-btn--link">IA</a>
    <a href="/admin#tab-log" class="admin-tab-btn admin-tab--sys admin-tab-btn--link">Log</a>
  </div>
  <a href="/" class="admin-tab-home">&#8617; Site</a>
</nav>

<div style="display:flex;min-height:calc(100vh - 3.25rem - 2.5rem)">

  <%/* ── Sidebar ── */%>
  <nav style="width:200px;min-width:180px;background:rgba(255,255,255,.035);border-right:1px solid rgba(255,255,255,.08);padding:1.5rem .75rem;display:flex;flex-direction:column;gap:.25rem;flex-shrink:0">

    <button class="obj-nav-link" data-section="accueil">
      <span style="font-size:1.1rem">&#127968;</span> Accueil
    </button>

    <button class="obj-nav-link" data-section="images">
      <span style="font-size:1.1rem">&#128247;</span> Images
      <span class="obj-nav-count"><%= images.length %></span>
    </button>

    <button class="obj-nav-link" data-section="charms">
      <span style="font-size:1.1rem">&#10022;</span> Charmes
      <span class="obj-nav-count"><%= charms.length %></span>
    </button>

    <button class="obj-nav-link" data-section="themes">
      <span style="font-size:1.1rem">&#127912;</span> Th&egrave;mes
      <span class="obj-nav-count"><%= (themeDefs || []).length %></span>
    </button>

    <button class="obj-nav-link" data-section="speciaux">
      <span style="font-size:1.1rem">&#9824;</span> Sp&eacute;ciaux
    </button>

    <button class="obj-nav-link" data-section="cartes">
      <span style="font-size:1.1rem">&#127183;</span> Cartes
      <span class="obj-nav-count"><%= (wikiCards || []).length %></span>
    </button>

    <button class="obj-nav-link" data-section="personnages">
      <span style="font-size:1.1rem">&#128100;</span> Personnages
      <span class="obj-nav-count"><%= (personnageCards || []).length %></span>
    </button>

  </nav>

  <%/* ── Main content ── */%>
  <main style="flex:1;padding:2rem;overflow:auto">

    <%/* ── Accueil ── */%>
    <div class="obj-section" data-section="accueil">
      <h2 style="font-size:1rem;font-weight:700;color:#e2e8f0;margin:0 0 1.25rem;text-transform:uppercase;letter-spacing:.06em">Aperçu des objets</h2>

      <%
        var rarityList = ['common','rare','epic','legendary','mythic'];
        var rarityLabels = { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' };
      %>

      <%/* Images card */%>
      <div class="obj-home-card">
        <div class="obj-home-card-header">
          <span class="obj-home-card-icon">&#128247;</span>
          <span class="obj-home-card-title">Images de profil</span>
          <span class="obj-home-card-total"><%= images.length %> au total</span>
          <button class="obj-home-goto js-goto-section" data-section="images">&#8594; Gérer</button>
        </div>
        <div class="obj-home-rarities">
          <% rarityList.forEach(function(r) { %>
          <span class="obj-rarity-chip" data-rarity="<%= r %>">
            <span class="obj-rarity-chip-dot"></span>
            <strong><%= imageStats[r] || 0 %></strong>
            <span style="color:#94a3b8"><%= rarityLabels[r] %></span>
          </span>
          <% }) %>
        </div>
      </div>

      <%/* Charmes card */%>
      <div class="obj-home-card">
        <div class="obj-home-card-header">
          <span class="obj-home-card-icon">&#10022;</span>
          <span class="obj-home-card-title">Charmes</span>
          <span class="obj-home-card-total"><%= charms.length %> au total</span>
          <button class="obj-home-goto js-goto-section" data-section="charms">&#8594; Gérer</button>
        </div>
        <div class="obj-home-rarities">
          <% rarityList.forEach(function(r) { %>
          <span class="obj-rarity-chip" data-rarity="<%= r %>">
            <span class="obj-rarity-chip-dot"></span>
            <strong><%= charmStats[r] || 0 %></strong>
            <span style="color:#94a3b8"><%= rarityLabels[r] %></span>
          </span>
          <% }) %>
        </div>
      </div>

      <%/* Thèmes card */%>
      <div class="obj-home-card">
        <div class="obj-home-card-header">
          <span class="obj-home-card-icon">&#127912;</span>
          <span class="obj-home-card-title">Thèmes</span>
          <span class="obj-home-card-total"><%= (themeDefs || []).length %> au total</span>
          <button class="obj-home-goto js-goto-section" data-section="themes">&#8594; Gérer</button>
        </div>
        <div class="obj-home-rarities">
          <% rarityList.forEach(function(r) { %>
          <span class="obj-rarity-chip" data-rarity="<%= r %>">
            <span class="obj-rarity-chip-dot"></span>
            <strong><%= themeStats[r] || 0 %></strong>
            <span style="color:#94a3b8"><%= rarityLabels[r] %></span>
          </span>
          <% }) %>
          <% if (themeAlways > 0) { %>
          <span class="obj-rarity-chip" data-rarity="">
            <span class="obj-rarity-chip-dot" style="background:#475569"></span>
            <strong><%= themeAlways %></strong>
            <span style="color:#94a3b8">Toujours dispo</span>
          </span>
          <% } %>
        </div>
      </div>

      <%/* Cartes Codex card */%>
      <div class="obj-home-card">
        <div class="obj-home-card-header">
          <span class="obj-home-card-icon">&#127183;</span>
          <span class="obj-home-card-title">Cartes Codex</span>
          <span class="obj-home-card-total"><%= (wikiCards || []).length %> au total</span>
          <button class="obj-home-goto js-goto-section" data-section="cartes">&#8594; Gérer</button>
        </div>
        <div class="obj-home-rarities">
          <% rarityList.forEach(function(r) { %>
          <span class="obj-rarity-chip" data-rarity="<%= r %>">
            <span class="obj-rarity-chip-dot"></span>
            <strong><%= (cardStatsByRarity && cardStatsByRarity[r]) || 0 %></strong>
            <span style="color:#94a3b8"><%= rarityLabels[r] %></span>
          </span>
          <% }) %>
        </div>
      </div>

      <%/* Personnages card */%>
      <div class="obj-home-card">
        <div class="obj-home-card-header">
          <span class="obj-home-card-icon">&#128100;</span>
          <span class="obj-home-card-title">Cartes Personnages</span>
          <span class="obj-home-card-total"><%= (personnageCards || []).length %> au total</span>
          <button class="obj-home-goto js-goto-section" data-section="personnages">&#8594; Gérer</button>
        </div>
        <div class="obj-home-rarities">
          <% rarityList.forEach(function(r) { %>
          <span class="obj-rarity-chip" data-rarity="<%= r %>">
            <span class="obj-rarity-chip-dot"></span>
            <strong><%= (personnageCardStatsByRarity && personnageCardStatsByRarity[r]) || 0 %></strong>
            <span style="color:#94a3b8"><%= rarityLabels[r] %></span>
          </span>
          <% }) %>
        </div>
      </div>

      <%/* Config raretés inline */%>
      <h3 style="font-size:.82rem;font-weight:700;color:#94a3b8;margin:1.5rem 0 .75rem;text-transform:uppercase;letter-spacing:.07em">Configuration des raretés</h3>
      <form method="POST" action="/admin/recompenses/config">
        <div style="overflow-x:auto">
          <table style="width:100%;border-collapse:collapse;font-size:.88rem">
            <thead>
              <tr style="color:#94a3b8;text-align:left">
                <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08)">Rareté</th>
                <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08);text-align:center">% drop</th>
                <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08);text-align:center">Prix achat &#127481;</th>
                <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08);text-align:center">Prix revente &#127481;</th>
              </tr>
            </thead>
            <tbody>
              <%
                var tiers = [
                  { key: 'common',    label: 'Commun',     color: '#94a3b8' },
                  { key: 'rare',      label: 'Rare',        color: '#60a5fa' },
                  { key: 'epic',      label: 'Épique',      color: '#a78bfa' },
                  { key: 'legendary', label: 'Légendaire',  color: '#fbbf24' },
                  { key: 'mythic',    label: 'Mythique',    color: '#f87171' },
                ];
              %>
              <% tiers.forEach(function(tier) { %>
              <tr style="border-bottom:1px solid rgba(255,255,255,.05)">
                <td style="padding:.6rem .75rem">
                  <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:<%= tier.color %>;margin-right:.5rem"></span>
                  <strong style="color:<%= tier.color %>"><%= tier.label %></strong>
                </td>
                <td style="padding:.6rem .75rem;text-align:center">
                  <input type="number" name="weight_<%= tier.key %>" value="<%= lootboxConfig.weights[tier.key] %>" min="0" max="100" step="0.01"
                    style="width:70px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:5px;color:#f1f5f9;padding:.3rem .5rem;text-align:center;font-size:.88rem">
                </td>
                <td style="padding:.6rem .75rem;text-align:center">
                  <input type="number" name="buy_<%= tier.key %>" value="<%= lootboxConfig.buyPrices[tier.key] %>" min="0" step="1"
                    style="width:70px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:5px;color:#f1f5f9;padding:.3rem .5rem;text-align:center;font-size:.88rem">
                </td>
                <td style="padding:.6rem .75rem;text-align:center">
                  <input type="number" name="sell_<%= tier.key %>" value="<%= lootboxConfig.sellPrices[tier.key] %>" min="0" step="1"
                    style="width:70px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:5px;color:#f1f5f9;padding:.3rem .5rem;text-align:center;font-size:.88rem">
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p style="font-size:.78rem;color:#64748b;margin:.75rem 0 1rem">Les % de drop n'ont pas besoin de totaliser 100 — ils sont utilisés comme poids relatifs.</p>
        <button type="submit" style="background:#f87171;border:none;color:#fff;padding:.55rem 1.4rem;border-radius:7px;font-weight:600;font-size:.9rem;cursor:pointer;transition:background .15s"
          onmouseover="this.style.background='#ef4444'"
          onmouseout="this.style.background='#f87171'">
          Enregistrer
        </button>
      </form>
    </div>

    <%/* ── Images de profil ── */%>
    <div class="obj-section" data-section="images">
      <div class="obj-section-toolbar">
        <select id="ari-filter-sel" class="admin-filter-select">
          <option value="all">Toutes raretés</option>
          <option value="common">Commun</option>
          <option value="rare">Rare</option>
          <option value="epic">Épique</option>
          <option value="legendary">Légendaire</option>
          <option value="mythic">Mythique</option>
        </select>
        <div class="obj-tools">
          <button class="obj-tool-btn js-sel-mode" data-action="gift" title="Offrir en lot" data-section="images">&#127873;</button>
          <button class="obj-tool-btn js-sel-mode" data-action="delete" title="Supprimer en lot" data-section="images">&#128465;</button>
        </div>
      </div>

      <div class="ari-grid" id="ari-grid">
        <% images.forEach(function(img, idx) { %>
        <div class="ari-card" data-id="<%= img.id %>" data-rarity="<%= img.rarity %>" data-idx="<%= idx %>" data-title="<%= img.title || '' %>" tabindex="0" role="button" aria-label="<%= img.title || 'Image ' + img.id %>">
          <% if (img.thumb) { %>
            <img src="<%= img.thumb %>" alt="<%= img.title || '' %>" loading="lazy">
          <% } else { %>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#475569;font-size:1.8rem">&#128247;</div>
          <% } %>
          <div class="ari-card-rarity"><%= img.rarity %></div>
        </div>
        <% }) %>
      </div>
    </div>

    <%/* ── Charmes ── */%>
    <div class="obj-section" data-section="charms">
      <div class="obj-section-toolbar">
        <select id="charm-filter-sel" class="admin-filter-select">
          <option value="all">Toutes raretés</option>
          <option value="common">Commun</option>
          <option value="rare">Rare</option>
          <option value="epic">Épique</option>
          <option value="legendary">Légendaire</option>
          <option value="mythic">Mythique</option>
        </select>
        <div class="obj-tools">
          <button class="obj-tool-btn js-sel-mode" data-action="gift" title="Offrir en lot" data-section="charms">&#127873;</button>
          <button class="obj-tool-btn js-sel-mode" data-action="delete" title="Supprimer en lot" data-section="charms">&#128465;</button>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:.65rem" id="charm-grid">
        <% charms.forEach(function(charm) { %>
        <%
          var rarityColor = charm.rarity === 'mythic' ? '#f87171' : charm.rarity === 'legendary' ? '#fbbf24' : charm.rarity === 'epic' ? '#a78bfa' : charm.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
        %>
        <div class="ari-charm-card" data-charm-id="<%= charm.id %>" data-rarity="<%= charm.rarity %>" style="background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);border-radius:10px;padding:.85rem .65rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.3rem">
          <div style="font-size:1.6rem;line-height:1">
            <%= charm.symbol %><% if (charm.symbol_empty) { %><span style="opacity:.35;font-size:1.1rem"> <%= charm.symbol_empty %></span><% } %>
          </div>
          <strong style="font-size:.85rem;color:#f1f5f9"><%= charm.label %></strong>
          <code style="font-size:.65rem;color:#475569"><%= charm.key %></code>
          <select class="charm-rarity-select js-charm-rarity" data-charm-id="<%= charm.id %>"
                  style="border-color:<%= rarityColor %>; color:<%= rarityColor %>">
            <% ['common','rare','epic','legendary','mythic'].forEach(function(r) { %>
              <option value="<%= r %>"<%= charm.rarity === r ? ' selected' : '' %>>
                <%= { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[r] %>
              </option>
            <% }) %>
          </select>
          <span class="ari-charm-save-status" style="font-size:.7rem;height:.9em;color:#4ade80;display:block">&nbsp;</span>
        </div>
        <% }) %>
      </div>
    </div>

    <%/* ── Thèmes ── */%>
    <div class="obj-section" data-section="themes">
      <div class="obj-section-toolbar">
        <select id="theme-filter-sel" class="admin-filter-select">
          <option value="all">Toutes raretés</option>
          <option value="common">Commun</option>
          <option value="rare">Rare</option>
          <option value="epic">Épique</option>
          <option value="legendary">Légendaire</option>
          <option value="mythic">Mythique</option>
        </select>
        <div class="obj-tools">
          <button class="obj-tool-btn js-sel-mode" data-action="gift" title="Offrir en lot" data-section="themes">&#127873;</button>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:.65rem" id="theme-grid">
        <% (themeDefs || []).forEach(function(t) { %>
        <%
          var themeColors = { rouge:'hsl(355,55%,32%)', vert:'hsl(148,42%,28%)', violet:'hsl(270,58%,32%)', bleu:'hsl(212,65%,32%)', rose:'hsl(330,58%,32%)' };
          var swatchColor = themeColors[t.key] || '#333';
          var rarityColor = t.rarity === 'mythic' ? '#f87171' : t.rarity === 'legendary' ? '#fbbf24' : t.rarity === 'epic' ? '#a78bfa' : t.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
        %>
        <div class="obj-theme-selcard" data-theme-key="<%= t.key %>" data-rarity="<%= t.rarity || '' %>" data-always="<%= t.always ? '1' : '0' %>" style="background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);border-radius:10px;padding:.85rem .65rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.35rem">
          <div style="width:3rem;height:3rem;border-radius:50%;background:<%= swatchColor %>;border:2px solid rgba(255,255,255,.2);margin:0 auto"></div>
          <div style="font-size:.85rem;font-weight:700;color:#f1f5f9"><%= t.label %></div>
          <% if (t.always) { %>
            <span class="obj-always-badge">Toujours disponible</span>
          <% } else { %>
            <select class="charm-rarity-select no-arrow js-theme-rarity" data-theme-key="<%= t.key %>"
                    style="border-color:<%= rarityColor %>; color:<%= rarityColor %>">
              <option value="common"    <%= t.rarity === 'common'    ? 'selected' : '' %>>Commun</option>
              <option value="rare"      <%= t.rarity === 'rare'      ? 'selected' : '' %>>Rare</option>
              <option value="epic"      <%= t.rarity === 'epic'      ? 'selected' : '' %>>Épique</option>
              <option value="legendary" <%= t.rarity === 'legendary' ? 'selected' : '' %>>Légendaire</option>
              <option value="mythic"    <%= t.rarity === 'mythic'    ? 'selected' : '' %>>Mythique</option>
            </select>
            <span class="js-theme-save-status" style="font-size:.7rem;height:.9em;color:#4ade80;display:block">&nbsp;</span>
          <% } %>
        </div>
        <% }); %>
      </div>
    </div>

    <%/* ── Spéciaux (Jokers & Pièces) ── */%>
    <div class="obj-section" data-section="speciaux">
      <h3 style="font-size:.82rem;font-weight:700;color:#94a3b8;margin:0 0 1rem;text-transform:uppercase;letter-spacing:.07em">Offrir un joker</h3>
      <div class="obj-home-card" style="max-width:420px">
        <div style="display:flex;flex-direction:column;gap:.65rem">
          <div style="display:flex;gap:.5rem;align-items:center">
            <input type="text" id="joker-user-search" placeholder="Rechercher un utilisateur&hellip;"
              style="flex:1;background:#0f172a;border:1px solid rgba(255,255,255,.18);color:#f1f5f9;border-radius:6px;padding:.35rem .6rem;font-size:.85rem;outline:none">
            <select id="joker-type-select" style="background:#0f172a;border:1px solid rgba(255,255,255,.18);color:#f1f5f9;border-radius:6px;padding:.35rem .5rem;font-size:.82rem">
              <option value="image">Joker Image</option>
              <option value="charm">Joker Charme</option>
            </select>
          </div>
          <div id="joker-user-results" style="display:none;flex-direction:column;gap:.25rem;max-height:180px;overflow-y:auto;background:#0f172a;border:1px solid rgba(255,255,255,.12);border-radius:6px;padding:.3rem"></div>
          <div id="joker-selected-user" style="display:none;font-size:.82rem;color:#94a3b8;padding:.2rem 0"></div>
          <button id="joker-gift-btn" disabled
            style="background:#fbbf24;border:none;color:#0f172a;border-radius:6px;padding:.4rem .9rem;font-size:.82rem;font-weight:700;cursor:pointer;opacity:.5">
            &#9824; Offrir le joker
          </button>
          <p id="joker-gift-status" style="font-size:.75rem;height:.9em;color:#4ade80">&nbsp;</p>
        </div>
      </div>

      <h3 style="font-size:.82rem;font-weight:700;color:#94a3b8;margin:1.5rem 0 1rem;text-transform:uppercase;letter-spacing:.07em">Offrir des pi&egrave;ces</h3>
      <div class="obj-home-card" style="max-width:420px">
        <div style="display:flex;flex-direction:column;gap:.65rem">
          <div style="display:flex;gap:.5rem;align-items:center">
            <input type="text" id="coins-user-search" placeholder="Rechercher un utilisateur&hellip;"
              style="flex:1;background:#0f172a;border:1px solid rgba(255,255,255,.18);color:#f1f5f9;border-radius:6px;padding:.35rem .6rem;font-size:.85rem;outline:none">
            <input type="number" id="coins-amount-input" placeholder="Montant" min="1" value="100"
              style="width:90px;background:#0f172a;border:1px solid rgba(255,255,255,.18);color:#f1f5f9;border-radius:6px;padding:.35rem .5rem;font-size:.82rem;text-align:center">
          </div>
          <div id="coins-user-results" style="display:none;flex-direction:column;gap:.25rem;max-height:180px;overflow-y:auto;background:#0f172a;border:1px solid rgba(255,255,255,.12);border-radius:6px;padding:.3rem"></div>
          <div id="coins-selected-user" style="display:none;font-size:.82rem;color:#94a3b8;padding:.2rem 0"></div>
          <button id="coins-gift-btn" disabled
            style="background:#fbbf24;border:none;color:#0f172a;border-radius:6px;padding:.4rem .9rem;font-size:.82rem;font-weight:700;cursor:pointer;opacity:.5">
            &#127873; Offrir les pi&egrave;ces
          </button>
          <p id="coins-gift-status" style="font-size:.75rem;height:.9em;color:#4ade80">&nbsp;</p>
        </div>
      </div>
    </div>

    <%/* ── Cartes Codex ── */%>
    <div class="obj-section" data-section="cartes">
      <%
        var _wcCatSet = {}; (wikiCards||[]).forEach(function(wc){ if(wc.category) _wcCatSet[wc.category]=1; });
        var _wcCats = Object.keys(_wcCatSet).sort();
        var _wcCatLabels = { position:'Positions', lieux:'Lieux', partenaires:'Partenaires', jeu_de_role:'Scénarios', tenues:'Tenues', objets:'Objets', pratique:'Pratiques', autre:'Autre' };
      %>
      <div class="obj-section-toolbar" style="gap:.5rem;flex-wrap:wrap;align-items:center">
        <select id="card-filter-sel" class="admin-filter-select">
          <option value="all">Toutes raretés</option>
          <option value="common">Commun</option>
          <option value="rare">Rare</option>
          <option value="epic">Épique</option>
          <option value="legendary">Légendaire</option>
          <option value="mythic">Mythique</option>
        </select>
        <select id="card-cat-filter-sel" class="admin-filter-select">
          <option value="all">Toutes catégories</option>
          <% _wcCats.forEach(function(cat) { %>
            <option value="<%= cat %>"><%= _wcCatLabels[cat] || cat %></option>
          <% }) %>
        </select>
        <input type="text" id="card-search-input" placeholder="Chercher&hellip;"
          style="background:#0f172a;border:1px solid rgba(255,255,255,.18);color:#f1f5f9;border-radius:6px;padding:.3rem .6rem;font-size:.82rem;outline:none;width:160px;margin-left:auto">
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:.75rem;margin-top:.75rem" id="card-wiki-grid">
        <% (wikiCards || []).forEach(function(wc) { %>
        <%
          var wcRarityColor = wc.cardRarity === 'mythic' ? '#f87171' : wc.cardRarity === 'legendary' ? '#fbbf24' : wc.cardRarity === 'epic' ? '#a78bfa' : wc.cardRarity === 'rare' ? '#60a5fa' : '#94a3b8';
        %>
        <div class="card-wiki-item" data-card-id="<%= wc.id %>" data-rarity="<%= wc.cardRarity %>" data-cat="<%= wc.category %>"
          style="background:rgba(255,255,255,.04);border:1.5px solid rgba(255,255,255,.08);border-radius:10px;overflow:hidden;display:flex;flex-direction:column">
          <% if (wc.thumb) { %>
          <div style="height:80px;overflow:hidden;flex-shrink:0">
            <img src="<%= wc.thumb %>" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
          </div>
          <% } else { %>
          <div style="height:80px;background:#0f172a;display:flex;align-items:center;justify-content:center;font-size:1.6rem;flex-shrink:0">&#127183;</div>
          <% } %>
          <div style="padding:.55rem .6rem;display:flex;flex-direction:column;gap:.35rem;flex:1">
            <div style="font-size:.8rem;font-weight:700;color:#f1f5f9;line-height:1.3"><%= wc.title %></div>
            <div style="font-size:.65rem;text-transform:uppercase;letter-spacing:.05em;color:#64748b"><%= wc.category %></div>
            <select class="charm-rarity-select no-arrow js-card-rarity" data-card-id="<%= wc.id %>"
                    style="border-color:<%= wcRarityColor %>;color:<%= wcRarityColor %>">
              <% ['common','rare','epic','legendary','mythic'].forEach(function(r) { %>
                <option value="<%= r %>"<%= wc.cardRarity === r ? ' selected' : '' %>>
                  <%= { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[r] %>
                </option>
              <% }) %>
