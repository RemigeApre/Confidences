  function updateSelBar() {
    const selected = document.querySelectorAll('.obj-section[data-section="themes"] .obj-selected');
    const bar = document.getElementById('objSelBar');
    const countEl = document.getElementById('objSelCount');
    if (countEl) countEl.textContent = selected.length + ' sélectionné(s)';
    if (bar) bar.hidden = selected.length === 0;
  }
  window._themesUpdateSelBar = updateSelBar;
})();
</script>

<!-- ── Selection mode JS ── -->
<script>
(function() {
  var _currentSection = null;
  var _currentAction = null;
  var bar = document.getElementById('objSelBar');
  var confirmBtn = document.getElementById('objSelConfirm');
  var cancelBtn = document.getElementById('objSelCancel');
  var countEl = document.getElementById('objSelCount');

  document.querySelectorAll('.js-sel-mode').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var action = btn.dataset.action;
      var sectionKey = btn.dataset.section;
      var section = document.querySelector('.obj-section[data-section="' + sectionKey + '"]');
      if (!section) return;

      // Exit previous sel mode if any
      exitSelMode();

      _currentSection = sectionKey;
      _currentAction = action;
      section.classList.add('obj-sel-mode');
      section.dataset.selAction = action;

      // Configure bar confirm button
      if (confirmBtn) {
        confirmBtn.dataset.action = action;
        confirmBtn.textContent = action === 'delete' ? 'Supprimer' : 'Offrir à\u2026';
      }
      if (bar) bar.hidden = true; // hidden until items selected
    });
  });

  function getSelectedItems() {
    if (!_currentSection) return [];
    var items = [];
    if (_currentSection === 'images') {
      document.querySelectorAll('.obj-section[data-section="images"] .ari-card.obj-selected').forEach(function(c) {
        items.push({ type: 'image', id: Number(c.dataset.id), label: c.getAttribute('aria-label') || ('Image #' + c.dataset.id) });
      });
    } else if (_currentSection === 'charms') {
      document.querySelectorAll('.obj-section[data-section="charms"] .ari-charm-card.obj-selected').forEach(function(c) {
        var label = c.querySelector('strong') ? c.querySelector('strong').textContent : ('Charme #' + c.dataset.charmId);
        items.push({ type: 'charm', id: Number(c.dataset.charmId), label: label });
      });
    } else if (_currentSection === 'themes') {
      document.querySelectorAll('.obj-section[data-section="themes"] .obj-theme-selcard.obj-selected').forEach(function(c) {
        var label = c.querySelector('div[style*="font-size:.85rem"]') ? c.querySelector('div[style*="font-size:.85rem"]').textContent.trim() : c.dataset.themeKey;
        items.push({ type: 'theme', id: c.dataset.themeKey, label: label });
      });
    }
    return items;
  }

  function updateBarCount() {
    var items = getSelectedItems();
    if (countEl) countEl.textContent = items.length + ' sélectionné(s)';
    if (bar) bar.hidden = items.length === 0;
  }
  window._selModeUpdateCount = updateBarCount;

  // Patch the individual section updaters to also update bar count properly
  window._imagesUpdateSelBar = updateBarCount;
  window._charmsUpdateSelBar = updateBarCount;
  window._themesUpdateSelBar = updateBarCount;

  function exitSelMode() {
    if (_currentSection) {
      var s = document.querySelector('.obj-section[data-section="' + _currentSection + '"]');
      if (s) {
        s.classList.remove('obj-sel-mode');
        delete s.dataset.selAction;
        s.querySelectorAll('.obj-selected').forEach(function(el) { el.classList.remove('obj-selected'); });
      }
    }
    _currentSection = null;
    _currentAction = null;
    if (bar) bar.hidden = true;
  }

  cancelBtn && cancelBtn.addEventListener('click', exitSelMode);

  confirmBtn && confirmBtn.addEventListener('click', async function() {
    var items = getSelectedItems();
    if (!items.length) return;
    if (_currentAction === 'delete') {
      if (!confirm('Supprimer ' + items.length + ' élément(s) ? Cette action est irréversible.')) return;
      var ids = items.map(function(i) { return i.id; });
      var endpoint = _currentSection === 'images'
        ? '/admin/recompenses/images-profil/bulk-delete'
        : '/admin/recompenses/charms/bulk-delete';
      try {
        var r = await fetch(endpoint, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: ids }),
        });
        var json = await r.json();
        if (json.ok) {
          // Remove deleted cards from DOM
          if (_currentSection === 'images') {
            document.querySelectorAll('.obj-section[data-section="images"] .ari-card.obj-selected').forEach(function(c) { c.remove(); });
          } else if (_currentSection === 'charms') {
            document.querySelectorAll('.obj-section[data-section="charms"] .ari-charm-card.obj-selected').forEach(function(c) { c.remove(); });
          }
          exitSelMode();
        } else {
          alert('Erreur lors de la suppression.');
        }
      } catch (e) {
        alert('Erreur réseau.');
      }
    } else {
      // Gift action
      if (window._adminOpenGiftModal) {
        window._adminOpenGiftModal({ items: items });
      }
    }
  });
})();
</script>

<!-- ── Modal offrir ── -->
<div id="adminGiftModal" style="position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.85);display:none;align-items:center;justify-content:center">
  <div style="background:#1e293b;border-radius:14px;padding:1.5rem;width:min(95vw,420px);display:flex;flex-direction:column;gap:.85rem;max-height:90vh;overflow:hidden">
    <div style="display:flex;align-items:center;justify-content:space-between">
      <h3 style="margin:0;font-size:.95rem;font-weight:700;color:#f1f5f9">Offrir à un utilisateur</h3>
      <button id="adminGiftClose" style="background:none;border:none;color:#f87171;cursor:pointer;padding:.25rem;line-height:0">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p id="adminGiftItemLabel" style="margin:0;font-size:.82rem;color:#94a3b8;background:rgba(255,255,255,.05);padding:.5rem .75rem;border-radius:6px"></p>
    <input id="adminGiftSearch" type="text" placeholder="Rechercher un utilisateur…" autocomplete="off"
      style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:7px;color:#f1f5f9;padding:.5rem .75rem;font-size:.88rem;outline:none">
    <div id="adminGiftUserList" style="min-height:60px;max-height:200px;overflow-y:auto;display:flex;flex-direction:column;gap:.3rem">
      <p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Tapez pour rechercher un utilisateur…</p>
    </div>
    <div style="display:flex;gap:.5rem;justify-content:flex-end;align-items:center">
      <span id="adminGiftStatus" style="flex:1;font-size:.78rem;color:#4ade80;min-height:1em"></span>
      <button id="adminGiftCancel" style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);color:#94a3b8;border-radius:7px;padding:.4rem .9rem;font-size:.85rem;cursor:pointer">Annuler</button>
      <button id="adminGiftConfirm" disabled style="background:#fbbf24;border:none;color:#0f172a;border-radius:7px;padding:.4rem .9rem;font-size:.85rem;font-weight:700;cursor:pointer;opacity:.45">Offrir</button>
    </div>
  </div>
</div>

<script>
(function() {
  var modal = document.getElementById('adminGiftModal');
  var closeBtn = document.getElementById('adminGiftClose');
  var cancelBtn = document.getElementById('adminGiftCancel');
  var confirmBtn = document.getElementById('adminGiftConfirm');
  var searchInput = document.getElementById('adminGiftSearch');
  var userList = document.getElementById('adminGiftUserList');
  var itemLabel = document.getElementById('adminGiftItemLabel');
  var statusEl = document.getElementById('adminGiftStatus');
  if (!modal) return;

  var _giftTarget = null;
  var _selectedUserId = null;
  var _searchTimeout = null;

  function openModal(target) {
    _giftTarget = target;
    _selectedUserId = null;
    if (target.items) {
      if (itemLabel) itemLabel.textContent = '\uD83C\uDF81 ' + target.items.length + ' objet(s) à offrir';
    } else {
      if (itemLabel) itemLabel.textContent = '\uD83C\uDF81 ' + (target.type === 'image' ? 'Image' : target.type === 'charm' ? 'Charme' : 'Thème') + ' : ' + target.label;
    }
    if (searchInput) searchInput.value = '';
    if (userList) userList.innerHTML = '<p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Tapez pour rechercher un utilisateur\u2026</p>';
    if (confirmBtn) { confirmBtn.disabled = true; confirmBtn.style.opacity = '.45'; }
    if (statusEl) statusEl.textContent = '';
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    setTimeout(function() { if (searchInput) searchInput.focus(); }, 50);
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    _giftTarget = null;
    _selectedUserId = null;
  }

  closeBtn && closeBtn.addEventListener('click', closeModal);
  cancelBtn && cancelBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && modal.style.display === 'flex') closeModal(); });

  function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function renderUsers(users) {
    if (!userList) return;
    userList.innerHTML = '';
    if (!users.length) {
      userList.innerHTML = '<p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Aucun utilisateur trouv\u00e9</p>';
      return;
    }
    users.forEach(function(u) {
      var row = document.createElement('button');
      row.type = 'button';
      row.style.cssText = 'width:100%;text-align:left;background:rgba(255,255,255,.05);border:1.5px solid transparent;border-radius:7px;padding:.45rem .75rem;color:#f1f5f9;font-size:.85rem;cursor:pointer;transition:background .12s,border-color .12s;display:flex;align-items:center;gap:.5rem';
      row.innerHTML = '<span style="font-weight:600">' + escHtml(u.username) + '</span>'
        + (u.email ? '<span style="color:#64748b;font-size:.78rem">' + escHtml(u.email) + '</span>' : '');
      row.dataset.userId = u.id;
      row.addEventListener('click', function() {
        userList.querySelectorAll('button').forEach(function(b) { b.style.borderColor = 'transparent'; b.style.background = 'rgba(255,255,255,.05)'; });
        row.style.borderColor = '#fbbf24';
        row.style.background = 'rgba(251,191,36,.12)';
        _selectedUserId = u.id;
        if (confirmBtn) { confirmBtn.disabled = false; confirmBtn.style.opacity = '1'; }
      });
      userList.appendChild(row);
    });
  }

  searchInput && searchInput.addEventListener('input', function() {
    var q = searchInput.value.trim();
    clearTimeout(_searchTimeout);
    if (!q) {
      if (userList) userList.innerHTML = '<p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Tapez pour rechercher un utilisateur\u2026</p>';
      return;
    }
    _searchTimeout = setTimeout(function() {
      fetch('/admin/users-for-gift?q=' + encodeURIComponent(q))
        .then(function(r) { return r.json(); })
        .then(function(d) { renderUsers(d.users || []); })
        .catch(function() {});
    }, 300);
  });

  confirmBtn && confirmBtn.addEventListener('click', function() {
    if (!_selectedUserId || !_giftTarget) return;
    confirmBtn.disabled = true;
    var body = { targetUserId: _selectedUserId };
    if (_giftTarget.items) {
      // Bulk gift
      body.items = _giftTarget.items.map(function(i) { return { type: i.type, id: i.id }; });
    } else {
      body.type = _giftTarget.type;
      if (_giftTarget.type === 'image') body.imageId = _giftTarget.id;
      else body.charmId = _giftTarget.id;
    }
    fetch('/admin/recompenses/gift', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) {
        if (statusEl) { statusEl.textContent = '\u2713 Cadeau envoy\u00e9 !'; statusEl.style.color = '#4ade80'; }
        setTimeout(closeModal, 1500);
      } else {
        if (statusEl) { statusEl.textContent = '\u2717 ' + (d.error || 'Erreur'); statusEl.style.color = '#f87171'; }
        confirmBtn.disabled = false;
        confirmBtn.style.opacity = '1';
      }
    }).catch(function() {
      if (statusEl) { statusEl.textContent = '\u2717 Erreur r\u00e9seau'; statusEl.style.color = '#f87171'; }
      confirmBtn.disabled = false;
      confirmBtn.style.opacity = '1';
    });
  });

  window._adminOpenGiftModal = openModal;
})();
</script>

<!-- ── Spéciaux JS (Jokers & Pièces) ── -->
<script>
(function() {
  function makeUserSearchWidget(searchInputId, resultsId, selectedId, btnId, onSelect) {
    var searchInput = document.getElementById(searchInputId);
    var resultsDiv  = document.getElementById(resultsId);
    var selectedDiv = document.getElementById(selectedId);
    var btn         = document.getElementById(btnId);
    var selectedUserId = null;
    var _debounce = null;

    function showResults(users) {
      resultsDiv.innerHTML = '';
      if (!users.length) { resultsDiv.style.display = 'none'; return; }
      resultsDiv.style.display = 'flex';
      users.forEach(function(u) {
        var row = document.createElement('div');
        row.textContent = u.displayName + ' (' + u.username + ')';
        row.style.cssText = 'padding:.3rem .5rem;cursor:pointer;border-radius:4px;font-size:.82rem;color:#e2e8f0';
        row.addEventListener('mouseenter', function() { row.style.background='rgba(255,255,255,.07)'; });
        row.addEventListener('mouseleave', function() { row.style.background=''; });
        row.addEventListener('click', function() {
          selectedUserId = u.id;
          searchInput.value = u.displayName + ' (' + u.username + ')';
          resultsDiv.style.display = 'none';
          selectedDiv.textContent = 'S\u00e9lectionn\u00e9 : ' + u.displayName;
          selectedDiv.style.display = 'block';
          btn.disabled = false; btn.style.opacity = '1';
          if (onSelect) onSelect(u);
        });
        resultsDiv.appendChild(row);
      });
    }

    searchInput && searchInput.addEventListener('input', function() {
      clearTimeout(_debounce);
      var q = searchInput.value.trim();
      if (q.length < 2) { resultsDiv.style.display = 'none'; return; }
      _debounce = setTimeout(function() {
        fetch('/admin/users-for-gift?q=' + encodeURIComponent(q))
          .then(function(r) { return r.json(); })
          .then(function(d) { showResults(d.users || []); })
          .catch(function() {});
      }, 300);
    });

    return { getSelectedUserId: function() { return selectedUserId; }, reset: function() { selectedUserId = null; btn.disabled = true; btn.style.opacity = '.5'; selectedDiv.style.display = 'none'; searchInput.value = ''; } };
  }

  // Joker
  var jokerWidget = makeUserSearchWidget('joker-user-search', 'joker-user-results', 'joker-selected-user', 'joker-gift-btn');
  var jokerBtn    = document.getElementById('joker-gift-btn');
  var jokerStatus = document.getElementById('joker-gift-status');
  jokerBtn && jokerBtn.addEventListener('click', async function() {
    var userId = jokerWidget.getSelectedUserId();
    var type   = document.getElementById('joker-type-select').value;
    if (!userId) return;
    jokerBtn.disabled = true;
    try {
      var r = await fetch('/admin/recompenses/gift-joker', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetUserId: userId, jokerType: type }),
      });
      var d = await r.json();
      if (d.ok) {
        jokerStatus.textContent = '\u2713 Joker envoy\u00e9 \u00e0 ' + d.username;
        jokerStatus.style.color = '#4ade80';
        jokerWidget.reset();
      } else {
        jokerStatus.textContent = '\u2717 ' + (d.error || 'Erreur');
        jokerStatus.style.color = '#f87171';
        jokerBtn.disabled = false;
      }
    } catch(e) {
      jokerStatus.textContent = '\u2717 Erreur r\u00e9seau';
      jokerStatus.style.color = '#f87171';
      jokerBtn.disabled = false;
    }
  });

  // Pièces
  var coinsWidget = makeUserSearchWidget('coins-user-search', 'coins-user-results', 'coins-selected-user', 'coins-gift-btn');
  var coinsBtn    = document.getElementById('coins-gift-btn');
  var coinsStatus = document.getElementById('coins-gift-status');
  coinsBtn && coinsBtn.addEventListener('click', async function() {
    var userId = coinsWidget.getSelectedUserId();
    var amount = parseInt(document.getElementById('coins-amount-input').value, 10) || 0;
    if (!userId || amount <= 0) return;
    coinsBtn.disabled = true;
    try {
      var r = await fetch('/admin/recompenses/gift-coins', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetUserId: userId, amount: amount }),
      });
      var d = await r.json();
      if (d.ok) {
        coinsStatus.textContent = '\u2713 ' + amount + '\u202fP envoy\u00e9(es) \u00e0 ' + d.username;
        coinsStatus.style.color = '#4ade80';
        coinsWidget.reset();
      } else {
        coinsStatus.textContent = '\u2717 ' + (d.error || 'Erreur');
        coinsStatus.style.color = '#f87171';
        coinsBtn.disabled = false;
      }
    } catch(e) {
      coinsStatus.textContent = '\u2717 Erreur r\u00e9seau';
      coinsStatus.style.color = '#f87171';
      coinsBtn.disabled = false;
    }
  });
})();
</script>

<!-- ── Cartes Codex JS ── -->
<script>
(function() {
  const RARITY_COLORS = { common:'#94a3b8', rare:'#60a5fa', epic:'#a78bfa', legendary:'#fbbf24', mythic:'#f87171' };
  const cardItems = Array.from(document.querySelectorAll('.card-wiki-item'));

  // Filter by rarity
  const cardFilterBar = document.getElementById('card-filter-bar');
  cardFilterBar && cardFilterBar.addEventListener('click', function(e) {
    const btn = e.target.closest('.ari-filter-btn'); if (!btn) return;
    cardFilterBar.querySelectorAll('.ari-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    applyCardFilters();
  });

  // Search by title/category
  const searchInput = document.getElementById('card-search-input');
  searchInput && searchInput.addEventListener('input', applyCardFilters);

  function applyCardFilters() {
    const activeFilter = cardFilterBar ? cardFilterBar.querySelector('.ari-filter-btn.active') : null;
    const rarityFilter = activeFilter ? activeFilter.dataset.filter : 'all';
    const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
    cardItems.forEach(c => {
      const rarityMatch = rarityFilter === 'all' || c.dataset.rarity === rarityFilter;
      const textMatch = !q || c.dataset.cat.toLowerCase().includes(q) || c.querySelector('[style*="font-size:.8rem"]').textContent.toLowerCase().includes(q);
      c.hidden = !(rarityMatch && textMatch);
    });
  }

  // Rarity change
  document.querySelectorAll('.js-card-rarity').forEach(function(sel) {
    sel.addEventListener('change', async function() {
      const cardId = sel.dataset.cardId;
      const rarity = sel.value;
      const item = sel.closest('.card-wiki-item');
      if (item) item.dataset.rarity = rarity;
      const statusEl = sel.parentElement.querySelector('.js-card-save-status');
      sel.style.color = RARITY_COLORS[rarity] || '#94a3b8';
      sel.style.borderColor = RARITY_COLORS[rarity] || 'rgba(255,255,255,.2)';
      if (statusEl) { statusEl.textContent = '…'; statusEl.style.color = '#94a3b8'; }
      try {
        const r = await fetch('/admin/recompenses/cards/' + cardId + '/rarity', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rarity }),
        });
        const json = await r.json();
        if (statusEl) {
          statusEl.textContent = json.ok ? '✓' : '✗';
          statusEl.style.color = json.ok ? '#4ade80' : '#f87171';
          setTimeout(function() { if (statusEl) statusEl.textContent = '\u00a0'; }, 1500);
        }
      } catch(e) { if (statusEl) { statusEl.textContent = '✗'; statusEl.style.color = '#f87171'; } }
    });
  });

  // Summary auto-save
  const _summaryTimers = {};
  document.querySelectorAll('.js-card-summary').forEach(function(ta) {
    ta.addEventListener('input', function() {
      const cardId = ta.dataset.cardId;
      const statusEl = ta.parentElement.querySelector('.js-card-save-status');
      clearTimeout(_summaryTimers[cardId]);
      if (statusEl) { statusEl.textContent = '…'; statusEl.style.color = '#94a3b8'; }
      _summaryTimers[cardId] = setTimeout(async function() {
        try {
          const r = await fetch('/admin/recompenses/cards/' + cardId + '/summary', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ summary: ta.value }),
          });
          const json = await r.json();
          if (statusEl) {
            statusEl.textContent = json.ok ? '✓ Enregistré' : '✗ Erreur';
            statusEl.style.color = json.ok ? '#4ade80' : '#f87171';
            setTimeout(function() { if (statusEl) statusEl.textContent = '\u00a0'; }, 2000);
          }
        } catch(e) { if (statusEl) { statusEl.textContent = '✗'; statusEl.style.color = '#f87171'; } }
      }, 700);
    });
  });
})();
</script>

