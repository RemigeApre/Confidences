<%- include('partials/head', { title: 'Admin : Objets', extraCss: ['admin.css'] }) %>

<style>
/* ── Images grid ── */
.ari-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(96px,1fr)); gap:.5rem; margin-top:.75rem; }
.ari-card { position:relative; border-radius:8px; overflow:hidden; cursor:pointer; border:2px solid transparent; transition:border-color .15s, transform .12s; aspect-ratio:1; background:#0f172a; }
.ari-card:hover { transform:scale(1.03); border-color:rgba(255,255,255,.3); }
.ari-card img { width:100%; height:100%; object-fit:cover; display:block; }
.ari-card-rarity { position:absolute; bottom:0; left:0; right:0; font-size:.6rem; font-weight:700; text-align:center; padding:.12rem; letter-spacing:.04em; text-transform:uppercase; }
.ari-card[data-rarity="common"]    .ari-card-rarity { background:rgba(0,0,0,.6); color:#94a3b8; }
.ari-card[data-rarity="rare"]      .ari-card-rarity { background:rgba(37,99,235,.7); color:#bfdbfe; }
.ari-card[data-rarity="epic"]      .ari-card-rarity { background:rgba(109,40,217,.7); color:#ddd6fe; }
.ari-card[data-rarity="legendary"] .ari-card-rarity { background:rgba(180,83,9,.75); color:#fde68a; }
.ari-card[data-rarity="mythic"]    .ari-card-rarity { background:rgba(185,28,28,.75); color:#fca5a5; }

/* ── Zoom overlay ── */
.ari-zoom-overlay { position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.85); display:flex; align-items:center; justify-content:center; }
.ari-zoom-overlay[hidden] { display:none; }
.ari-zoom-box { position:relative; background:#1e293b; border-radius:14px; padding:1.5rem; width:min(95vw,780px); display:flex; gap:1.5rem; flex-wrap:wrap; align-items:flex-start; }
.ari-zoom-img-wrap { flex:1; min-width:200px; max-width:360px; }
.ari-zoom-img-wrap img { width:100%; border-radius:8px; object-fit:contain; max-height:420px; }
.ari-zoom-side { flex:1; min-width:180px; display:flex; flex-direction:column; gap:1rem; }
.ari-zoom-title { font-weight:700; font-size:1rem; color:#f1f5f9; margin:0; }
.ari-zoom-subtitle { font-size:.78rem; color:#64748b; margin:.15rem 0 0; }
.ari-profile-preview { width:72px; height:72px; border-radius:50%; overflow:hidden; border:3px solid rgba(255,255,255,.15); flex-shrink:0; }
.ari-profile-preview img { width:100%; height:100%; object-fit:cover; }
.ari-rarity-btns { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.25rem; }
.ari-rarity-btn { border:2px solid; border-radius:6px; padding:.3rem .65rem; font-size:.75rem; font-weight:700; cursor:pointer; background:transparent; transition:background .12s, color .12s; text-transform:uppercase; letter-spacing:.04em; }
.ari-rarity-btn[data-rarity="common"]    { border-color:#94a3b8; color:#94a3b8; }
.ari-rarity-btn[data-rarity="rare"]      { border-color:#60a5fa; color:#60a5fa; }
.ari-rarity-btn[data-rarity="epic"]      { border-color:#a78bfa; color:#a78bfa; }
.ari-rarity-btn[data-rarity="legendary"]{ border-color:#fbbf24; color:#fbbf24; }
.ari-rarity-btn[data-rarity="mythic"]    { border-color:#f87171; color:#f87171; }
.ari-rarity-btn.active[data-rarity="common"]    { background:#94a3b8; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="rare"]      { background:#60a5fa; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="epic"]      { background:#a78bfa; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="legendary"] { background:#fbbf24; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="mythic"]    { background:#f87171; color:#0f172a; }
.ari-nav-btns { display:flex; gap:.5rem; }
.ari-nav-btn { width:40px; height:40px; border-radius:8px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18); color:#f1f5f9; cursor:pointer; font-size:1.1rem; display:flex; align-items:center; justify-content:center; transition:background .12s; }
.ari-nav-btn:hover { background:rgba(255,255,255,.18); }
.ari-zoom-close { position:absolute; top:.6rem; right:.8rem; background:none; border:none; color:#f87171; cursor:pointer; padding:.25rem; line-height:0; }
.ari-zoom-close:hover { color:#ef4444; }
.ari-save-status { font-size:.78rem; height:1.2em; transition:opacity .3s; }
.ari-filter-bar { display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:.75rem; }
.ari-filter-btn { border:1px solid rgba(255,255,255,.2); background:rgba(255,255,255,.05); color:#94a3b8; border-radius:5px; padding:.3rem .65rem; font-size:.75rem; font-weight:600; cursor:pointer; text-transform:uppercase; transition:background .12s; }
.ari-filter-btn.active, .ari-filter-btn:hover { background:rgba(255,255,255,.15); color:#f1f5f9; }

/* ── Charm / theme rarity select ── */
.charm-rarity-select {
  background:#1e293b; border:1px solid rgba(255,255,255,.2);
  color:#f1f5f9; border-radius:6px; padding:.3rem .5rem; font-size:.75rem;
  font-weight:700; cursor:pointer; width:100%; margin-top:.35rem;
  text-transform:uppercase; letter-spacing:.04em;
  transition:border-color .15s;
}
.charm-rarity-select option { background:#1e293b; color:#f1f5f9; }
.charm-rarity-select:focus { outline:none; border-color:rgba(255,255,255,.4); }
.charm-rarity-select.no-arrow {
  appearance:none; -webkit-appearance:none;
  text-align:center; text-align-last:center;
  padding-left:.5rem;
}

/* ── Section switching ── */
.obj-section { display:none; }
.obj-section.active { display:block; }

/* ── Sidebar nav links ── */
.obj-nav-link {
  display:flex; align-items:center; gap:.6rem;
  padding:.5rem .75rem; border-radius:7px; text-decoration:none;
  font-size:.875rem; font-weight:600; transition:background .15s;
  color:#94a3b8; cursor:pointer; border:none; background:none; width:100%;
  text-align:left;
}
.obj-nav-link:hover { background:rgba(255,255,255,.07); }
.obj-nav-link.active { background:rgba(248,113,113,.18); color:#fca5a5; }
.obj-nav-count { margin-left:auto; font-size:.7rem; font-weight:500; opacity:.6; }
</style>

<div class="admin-topbar">
  <a href="/admin" class="admin-topbar-back">&#8592; Retour</a>
  <span class="admin-topbar-title"><%= config.title %> &mdash; Objets</span>
</div>

<div style="display:flex;min-height:calc(100vh - 52px)">

  <%/* ── Sidebar ── */%>
  <nav style="width:200px;min-width:180px;background:rgba(255,255,255,.035);border-right:1px solid rgba(255,255,255,.08);padding:1.5rem .75rem;display:flex;flex-direction:column;gap:.25rem;flex-shrink:0">

    <button class="obj-nav-link" data-section="images">
      <span style="font-size:1.1rem">&#128247;</span> Image
      <span class="obj-nav-count"><%= images.length %></span>
    </button>

    <button class="obj-nav-link" data-section="charms">
      <span style="font-size:1.1rem">&#10022;</span> Charmes
      <span class="obj-nav-count"><%= charms.length %></span>
    </button>

    <button class="obj-nav-link" data-section="themes">
      <span style="font-size:1.1rem">&#127912;</span> Th&egrave;mes
      <span class="obj-nav-count"><%= (themeDefs || []).filter(function(t){ return !t.always; }).length %></span>
    </button>

    <div style="height:1px;background:rgba(255,255,255,.07);margin:.75rem .25rem"></div>
    <p style="font-size:.7rem;font-weight:700;color:#64748b;letter-spacing:.09em;text-transform:uppercase;margin:0 0 .6rem .5rem">Configuration</p>

    <button class="obj-nav-link" data-section="config">
      <span style="font-size:1.1rem">&#9881;</span> Raretés
    </button>
  </nav>

  <%/* ── Main content ── */%>
  <main style="flex:1;padding:2rem;overflow:auto">

    <%/* ── Images de profil ── */%>
    <div class="obj-section" data-section="images">
      <div class="ari-filter-bar" id="ari-filter-bar">
        <button class="ari-filter-btn active" data-filter="all">Tout</button>
        <button class="ari-filter-btn" data-filter="common">Commun</button>
        <button class="ari-filter-btn" data-filter="rare">Rare</button>
        <button class="ari-filter-btn" data-filter="epic">&Eacute;pique</button>
        <button class="ari-filter-btn" data-filter="legendary">L&eacute;g.</button>
        <button class="ari-filter-btn" data-filter="mythic">Mythique</button>
      </div>

      <div class="ari-grid" id="ari-grid">
        <% images.forEach(function(img, idx) { %>
        <div class="ari-card" data-id="<%= img.id %>" data-rarity="<%= img.rarity %>" data-idx="<%= idx %>" tabindex="0" role="button" aria-label="<%= img.title || 'Image ' + img.id %>">
          <% if (img.thumb) { %>
            <img src="<%= img.thumb %>" alt="<%= img.title || '' %>" loading="lazy">
          <% } else { %>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#475569;font-size:1.8rem">&#128247;</div>
          <% } %>
          <div class="ari-card-rarity"><%= img.rarity %></div>
        </div>
        <% }) %>
      </div>
    </div>

    <%/* ── Charmes ── */%>
    <div class="obj-section" data-section="charms">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:.65rem">
        <% charms.forEach(function(charm) { %>
        <%
          var rarityColor = charm.rarity === 'mythic' ? '#f87171' : charm.rarity === 'legendary' ? '#fbbf24' : charm.rarity === 'epic' ? '#a78bfa' : charm.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
        %>
        <div class="ari-charm-card" data-charm-id="<%= charm.id %>" style="background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);border-radius:10px;padding:.85rem .65rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.3rem">
          <div style="font-size:1.6rem;line-height:1;filter:drop-shadow(0 0 5px <%= rarityColor %>66)">
            <%= charm.symbol %><% if (charm.symbol_empty) { %><span style="opacity:.35;font-size:1.1rem"> <%= charm.symbol_empty %></span><% } %>
          </div>
          <strong style="font-size:.85rem;color:#f1f5f9"><%= charm.label %></strong>
          <code style="font-size:.65rem;color:#475569"><%= charm.key %></code>
          <select class="charm-rarity-select js-charm-rarity" data-charm-id="<%= charm.id %>"
                  style="border-color:<%= rarityColor %>; color:<%= rarityColor %>">
            <% ['common','rare','epic','legendary','mythic'].forEach(function(r) { %>
              <option value="<%= r %>"<%= charm.rarity === r ? ' selected' : '' %>>
                <%= { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[r] %>
              </option>
            <% }) %>
          </select>
          <span class="ari-charm-save-status" style="font-size:.7rem;height:.9em;color:#4ade80;display:block">&nbsp;</span>
          <button class="js-admin-gift-charm" data-charm-id="<%= charm.id %>" data-charm-label="<%= charm.label %>"
            style="width:100%;background:rgba(251,191,36,.08);border:1.5px solid rgba(251,191,36,.4);color:#fbbf24;border-radius:5px;padding:.28rem .5rem;font-size:.72rem;font-weight:700;cursor:pointer;transition:background .12s"
            onmouseover="this.style.background='rgba(251,191,36,.18)'" onmouseout="this.style.background='rgba(251,191,36,.08)'">
            &#127873; Offrir
          </button>
        </div>
        <% }) %>
      </div>
    </div>

    <%/* ── Thèmes ── */%>
    <div class="obj-section" data-section="themes">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:.65rem">
        <% (themeDefs || []).filter(function(t) { return !t.always; }).forEach(function(t) { %>
        <%
          var themeColors = { rouge:'hsl(355,55%,32%)', vert:'hsl(148,42%,28%)', violet:'hsl(270,58%,32%)', bleu:'hsl(212,65%,32%)', rose:'hsl(330,58%,32%)' };
          var swatchColor = themeColors[t.key] || '#333';
          var rarityColor = t.rarity === 'mythic' ? '#f87171' : t.rarity === 'legendary' ? '#fbbf24' : t.rarity === 'epic' ? '#a78bfa' : t.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
        %>
        <div style="background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);border-radius:10px;padding:.85rem .65rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.35rem">
          <div style="width:3rem;height:3rem;border-radius:50%;background:<%= swatchColor %>;border:2px solid rgba(255,255,255,.2);margin:0 auto"></div>
          <div style="font-size:.85rem;font-weight:700;color:#f1f5f9"><%= t.label %></div>
          <select class="charm-rarity-select no-arrow js-theme-rarity" data-theme-key="<%= t.key %>"
                  style="border-color:<%= rarityColor %>; color:<%= rarityColor %>">
            <option value="common"    <%= t.rarity === 'common'    ? 'selected' : '' %>>Commun</option>
            <option value="rare"      <%= t.rarity === 'rare'      ? 'selected' : '' %>>Rare</option>
            <option value="epic"      <%= t.rarity === 'epic'      ? 'selected' : '' %>>Épique</option>
            <option value="legendary" <%= t.rarity === 'legendary' ? 'selected' : '' %>>Légendaire</option>
            <option value="mythic"    <%= t.rarity === 'mythic'    ? 'selected' : '' %>>Mythique</option>
          </select>
          <span class="js-theme-save-status" style="font-size:.7rem;height:.9em;color:#4ade80;display:block">&nbsp;</span>
        </div>
        <% }); %>
      </div>
    </div>

    <%/* ── Configuration raretés ── */%>
    <div class="obj-section" data-section="config">
      <form method="POST" action="/admin/recompenses/config">
        <h2 style="font-size:1rem;font-weight:700;color:#e2e8f0;margin:0 0 1rem;text-transform:uppercase;letter-spacing:.06em">Configuration des raretés</h2>

        <div style="overflow-x:auto">
          <table style="width:100%;border-collapse:collapse;font-size:.88rem">
            <thead>
              <tr style="color:#94a3b8;text-align:left">
                <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08)">Rareté</th>
                <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08);text-align:center">% drop</th>
                <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08);text-align:center">Prix achat &#127481;</th>
                <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08);text-align:center">Prix revente &#127481;</th>
              </tr>
            </thead>
            <tbody>
              <%
                var tiers = [
                  { key: 'common',    label: 'Commun',     color: '#94a3b8' },
                  { key: 'rare',      label: 'Rare',        color: '#60a5fa' },
                  { key: 'epic',      label: 'Épique',      color: '#a78bfa' },
                  { key: 'legendary', label: 'Légendaire',  color: '#fbbf24' },
                  { key: 'mythic',    label: 'Mythique',    color: '#f87171' },
                ];
              %>
              <% tiers.forEach(function(tier) { %>
              <tr style="border-bottom:1px solid rgba(255,255,255,.05)">
                <td style="padding:.6rem .75rem">
                  <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:<%= tier.color %>;margin-right:.5rem"></span>
                  <strong style="color:<%= tier.color %>"><%= tier.label %></strong>
                </td>
                <td style="padding:.6rem .75rem;text-align:center">
                  <input type="number" name="weight_<%= tier.key %>" value="<%= lootboxConfig.weights[tier.key] %>" min="0" max="100" step="1"
                    style="width:60px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:5px;color:#f1f5f9;padding:.3rem .5rem;text-align:center;font-size:.88rem">
                </td>
                <td style="padding:.6rem .75rem;text-align:center">
                  <input type="number" name="buy_<%= tier.key %>" value="<%= lootboxConfig.buyPrices[tier.key] %>" min="0" step="1"
                    style="width:70px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:5px;color:#f1f5f9;padding:.3rem .5rem;text-align:center;font-size:.88rem">
                </td>
                <td style="padding:.6rem .75rem;text-align:center">
                  <input type="number" name="sell_<%= tier.key %>" value="<%= lootboxConfig.sellPrices[tier.key] %>" min="0" step="1"
                    style="width:70px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:5px;color:#f1f5f9;padding:.3rem .5rem;text-align:center;font-size:.88rem">
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <p style="font-size:.78rem;color:#64748b;margin:.75rem 0 1rem">Les % de drop n'ont pas besoin de totaliser 100 — ils sont utilisés comme poids relatifs.</p>

        <button type="submit" style="background:#f87171;border:none;color:#fff;padding:.55rem 1.4rem;border-radius:7px;font-weight:600;font-size:.9rem;cursor:pointer;transition:background .15s"
          onmouseover="this.style.background='#ef4444'"
          onmouseout="this.style.background='#f87171'">
          Enregistrer
        </button>
      </form>
    </div>

  </main>
</div>

<!-- Zoom overlay images -->
<div class="ari-zoom-overlay" id="ariZoom" hidden>
  <div class="ari-zoom-box">
    <button class="ari-zoom-close" id="ariZoomClose" aria-label="Fermer">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="ari-zoom-img-wrap"><img id="ariZoomImg" src="" alt=""></div>
    <div class="ari-zoom-side">
      <div>
        <p class="ari-zoom-title" id="ariZoomTitle">—</p>
        <p class="ari-zoom-subtitle" id="ariZoomSubtitle">id: —</p>
      </div>
      <div>
        <p style="font-size:.78rem;color:#94a3b8;margin:0 0 .4rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em">Aperçu icône profil</p>
        <div class="ari-profile-preview"><img id="ariProfilePreview" src="" alt=""></div>
      </div>
      <div>
        <p style="font-size:.78rem;color:#94a3b8;margin:0 0 .5rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em">Rareté</p>
        <div class="ari-rarity-btns" id="ariRarityBtns">
          <button class="ari-rarity-btn" data-rarity="common">Commun</button>
          <button class="ari-rarity-btn" data-rarity="rare">Rare</button>
          <button class="ari-rarity-btn" data-rarity="epic">&Eacute;pique</button>
          <button class="ari-rarity-btn" data-rarity="legendary">L&eacute;gendaire</button>
          <button class="ari-rarity-btn" data-rarity="mythic">Mythique</button>
        </div>
        <p class="ari-save-status" id="ariSaveStatus" style="color:#4ade80;margin:.4rem 0 0">&nbsp;</p>
      </div>
      <div>
        <button id="ariGiftBtn" style="width:100%;background:rgba(251,191,36,.1);border:1.5px solid rgba(251,191,36,.5);color:#fbbf24;border-radius:7px;padding:.4rem .75rem;font-size:.82rem;font-weight:700;cursor:pointer;transition:background .12s"
          onmouseover="this.style.background='rgba(251,191,36,.2)'" onmouseout="this.style.background='rgba(251,191,36,.1)'">
          &#127873; Offrir cette image
        </button>
      </div>
      <div class="ari-nav-btns" style="margin-top:auto">
        <button class="ari-nav-btn" id="ariNavPrev" title="Précédent"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
        <button class="ari-nav-btn" id="ariNavNext" title="Suivant"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
        <span id="ariNavCount" style="font-size:.78rem;color:#64748b;align-self:center;margin-left:.25rem"></span>
      </div>
    </div>
  </div>
</div>

<!-- ── Section switching ── -->
<script>
(function() {
  var links = document.querySelectorAll('.obj-nav-link[data-section]');
  var sections = document.querySelectorAll('.obj-section[data-section]');
  var VALID = ['images','charms','themes','config'];

  function activate(key) {
    links.forEach(function(l) { l.classList.toggle('active', l.dataset.section === key); });
    sections.forEach(function(s) { s.classList.toggle('active', s.dataset.section === key); });
    history.replaceState(null, '', location.pathname + '#' + key);
  }

  links.forEach(function(l) {
    l.addEventListener('click', function() { activate(l.dataset.section); });
  });

  var hash = location.hash.replace('#', '');
  activate(VALID.includes(hash) ? hash : 'images');
})();
</script>

<!-- ── Images JS ── -->
<script>
(function() {
  const cards = Array.from(document.querySelectorAll('.ari-card'));
  const data = cards.map(c => ({
    id: Number(c.dataset.id), rarity: c.dataset.rarity || 'common',
    title: c.getAttribute('aria-label') || '',
    thumb: c.querySelector('img') ? c.querySelector('img').src : '',
  }));
  let visibleIdxs = data.map((_, i) => i);
  let zoomIdx = 0;

  const filterBar = document.getElementById('ari-filter-bar');
  filterBar && filterBar.addEventListener('click', function(e) {
    const btn = e.target.closest('.ari-filter-btn'); if (!btn) return;
    filterBar.querySelectorAll('.ari-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    visibleIdxs = [];
    cards.forEach((c, i) => { const show = f === 'all' || c.dataset.rarity === f; c.hidden = !show; if (show) visibleIdxs.push(i); });
  });

  const overlay = document.getElementById('ariZoom');
  const zoomImg = document.getElementById('ariZoomImg');
  const profilePreview = document.getElementById('ariProfilePreview');
  const zoomTitle = document.getElementById('ariZoomTitle');
  const zoomSubtitle = document.getElementById('ariZoomSubtitle');
  const rarityBtns = document.querySelectorAll('#ariRarityBtns .ari-rarity-btn');
  const saveStatus = document.getElementById('ariSaveStatus');
  const navCount = document.getElementById('ariNavCount');

  function openZoom(vi) { zoomIdx = vi; renderZoom(); overlay.hidden = false; document.body.style.overflow = 'hidden'; }
  function renderZoom() {
    const d = data[visibleIdxs[zoomIdx]]; if (!d) return;
    zoomImg.src = d.thumb || ''; profilePreview.src = d.thumb || '';
    zoomTitle.textContent = d.title || ('Image #' + d.id);
    zoomSubtitle.textContent = 'id: ' + d.id;
    navCount.textContent = (zoomIdx + 1) + ' / ' + visibleIdxs.length;
    saveStatus.textContent = '\u00a0';
    rarityBtns.forEach(b => b.classList.toggle('active', b.dataset.rarity === d.rarity));
  }
  function closeZoom() { overlay.hidden = true; document.body.style.overflow = ''; }
  function navigate(delta) { const n = zoomIdx + delta; if (n >= 0 && n < visibleIdxs.length) { zoomIdx = n; renderZoom(); } }

  cards.forEach((c, i) => {
    c.addEventListener('click', () => { const vi = visibleIdxs.indexOf(i); if (vi !== -1) openZoom(vi); });
    c.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); const vi = visibleIdxs.indexOf(i); if (vi !== -1) openZoom(vi); } });
  });

  document.getElementById('ariZoomClose').addEventListener('click', closeZoom);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeZoom(); });
  document.getElementById('ariNavPrev').addEventListener('click', () => navigate(-1));
  document.getElementById('ariNavNext').addEventListener('click', () => navigate(1));
  const giftBtn = document.getElementById('ariGiftBtn');
  giftBtn && giftBtn.addEventListener('click', function() {
    const d = data[visibleIdxs[zoomIdx]];
    if (!d || !window._adminOpenGiftModal) return;
    window._adminOpenGiftModal({ type: 'image', id: d.id, label: d.title || ('Image #' + d.id) });
  });
  document.addEventListener('keydown', function(e) {
    if (!overlay || overlay.hidden) return;
    if (e.key === 'Escape') closeZoom();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });

  rarityBtns.forEach(btn => {
    btn.addEventListener('click', async function() {
      const dataIdx = visibleIdxs[zoomIdx]; if (dataIdx === undefined) return;
      const d = data[dataIdx]; const rarity = btn.dataset.rarity;
      saveStatus.textContent = 'Enregistrement…'; saveStatus.style.color = '#94a3b8';
      try {
        const r = await fetch('/admin/recompenses/images-profil/' + d.id + '/rarity', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rarity }),
        });
        const json = await r.json();
        if (json.ok) {
          d.rarity = rarity;
          const card = cards[dataIdx]; card.dataset.rarity = rarity; card.querySelector('.ari-card-rarity').textContent = rarity;
          rarityBtns.forEach(b => b.classList.toggle('active', b.dataset.rarity === rarity));
          saveStatus.textContent = '✓ Enregistré'; saveStatus.style.color = '#4ade80';
          const activeFilter = document.querySelector('.ari-filter-btn.active');
          if (activeFilter && activeFilter.dataset.filter !== 'all' && activeFilter.dataset.filter !== rarity) {
            card.hidden = true; visibleIdxs = visibleIdxs.filter(vi => vi !== dataIdx);
            if (!visibleIdxs.length) { closeZoom(); return; }
            zoomIdx = Math.min(zoomIdx, visibleIdxs.length - 1); renderZoom();
          }
        } else { saveStatus.textContent = '✗ Erreur'; saveStatus.style.color = '#f87171'; }
      } catch (err) { saveStatus.textContent = '✗ Erreur réseau'; saveStatus.style.color = '#f87171'; }
    });
  });
})();
</script>

<!-- ── Charmes JS ── -->
<script>
(function() {
  const RARITY_COLORS = { common:'#94a3b8', rare:'#60a5fa', epic:'#a78bfa', legendary:'#fbbf24', mythic:'#f87171' };
  document.querySelectorAll('.js-admin-gift-charm').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (window._adminOpenGiftModal) {
        window._adminOpenGiftModal({ type: 'charm', id: parseInt(btn.dataset.charmId), label: btn.dataset.charmLabel });
      }
    });
  });

  document.querySelectorAll('.js-charm-rarity').forEach(function(sel) {
    sel.addEventListener('change', async function() {
      const charmId = sel.dataset.charmId;
      const rarity  = sel.value;
      const statusEl = sel.closest('.ari-charm-card').querySelector('.ari-charm-save-status');
      if (statusEl) { statusEl.textContent = '…'; statusEl.style.color = '#94a3b8'; }
      sel.style.color = RARITY_COLORS[rarity] || '#94a3b8';
      sel.style.borderColor = RARITY_COLORS[rarity] || 'rgba(255,255,255,.2)';
      try {
        const r = await fetch('/admin/recompenses/charms/' + charmId + '/rarity', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rarity }),
        });
        const json = await r.json();
        if (statusEl) { statusEl.textContent = json.ok ? '✓' : '✗'; statusEl.style.color = json.ok ? '#4ade80' : '#f87171'; }
        setTimeout(function() { if (statusEl) statusEl.textContent = '\u00a0'; }, 1500);
      } catch (e) { if (statusEl) { statusEl.textContent = '✗'; statusEl.style.color = '#f87171'; } }
    });
  });
})();
</script>

<!-- ── Thèmes JS ── -->
<script>
(function() {
  const RARITY_COLORS = { common:'#94a3b8', rare:'#60a5fa', epic:'#a78bfa', legendary:'#fbbf24', mythic:'#f87171' };
  document.querySelectorAll('.js-theme-rarity').forEach(function(sel) {
    sel.addEventListener('change', async function() {
      var key = sel.dataset.themeKey;
      var rarity = sel.value;
      var statusEl = sel.parentElement.querySelector('.js-theme-save-status');
      sel.style.color = RARITY_COLORS[rarity] || '#94a3b8';
      sel.style.borderColor = RARITY_COLORS[rarity] || 'rgba(255,255,255,.2)';
      if (statusEl) { statusEl.textContent = '…'; statusEl.style.color = '#94a3b8'; }
      try {
        var r = await fetch('/admin/recompenses/themes/' + key + '/rarity', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rarity: rarity }),
        });
        var json = await r.json();
        if (statusEl) {
          statusEl.textContent = json.ok ? '✓ Enregistré' : '✗ Erreur';
          statusEl.style.color = json.ok ? '#4ade80' : '#f87171';
          setTimeout(function() { statusEl.textContent = '\u00a0'; }, 1500);
        }
      } catch (e) {
        if (statusEl) { statusEl.textContent = '✗'; statusEl.style.color = '#f87171'; }
      }
    });
  });
})();
</script>

<!-- ── Modal offrir ── -->
<div id="adminGiftModal" style="position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.85);display:none;align-items:center;justify-content:center">
  <div style="background:#1e293b;border-radius:14px;padding:1.5rem;width:min(95vw,420px);display:flex;flex-direction:column;gap:.85rem;max-height:90vh;overflow:hidden">
    <div style="display:flex;align-items:center;justify-content:space-between">
      <h3 style="margin:0;font-size:.95rem;font-weight:700;color:#f1f5f9">Offrir à un utilisateur</h3>
      <button id="adminGiftClose" style="background:none;border:none;color:#f87171;cursor:pointer;padding:.25rem;line-height:0">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p id="adminGiftItemLabel" style="margin:0;font-size:.82rem;color:#94a3b8;background:rgba(255,255,255,.05);padding:.5rem .75rem;border-radius:6px"></p>
    <input id="adminGiftSearch" type="text" placeholder="Rechercher un utilisateur…" autocomplete="off"
      style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:7px;color:#f1f5f9;padding:.5rem .75rem;font-size:.88rem;outline:none">
    <div id="adminGiftUserList" style="min-height:60px;max-height:200px;overflow-y:auto;display:flex;flex-direction:column;gap:.3rem">
      <p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Tapez pour rechercher un utilisateur…</p>
    </div>
    <div style="display:flex;gap:.5rem;justify-content:flex-end;align-items:center">
      <span id="adminGiftStatus" style="flex:1;font-size:.78rem;color:#4ade80;min-height:1em"></span>
      <button id="adminGiftCancel" style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);color:#94a3b8;border-radius:7px;padding:.4rem .9rem;font-size:.85rem;cursor:pointer">Annuler</button>
      <button id="adminGiftConfirm" disabled style="background:#fbbf24;border:none;color:#0f172a;border-radius:7px;padding:.4rem .9rem;font-size:.85rem;font-weight:700;cursor:pointer;opacity:.45">Offrir</button>
    </div>
  </div>
</div>

<script>
(function() {
  var modal = document.getElementById('adminGiftModal');
  var closeBtn = document.getElementById('adminGiftClose');
  var cancelBtn = document.getElementById('adminGiftCancel');
  var confirmBtn = document.getElementById('adminGiftConfirm');
  var searchInput = document.getElementById('adminGiftSearch');
  var userList = document.getElementById('adminGiftUserList');
  var itemLabel = document.getElementById('adminGiftItemLabel');
  var statusEl = document.getElementById('adminGiftStatus');
  if (!modal) return;

  var _giftTarget = null;
  var _selectedUserId = null;
  var _searchTimeout = null;

  function openModal(target) {
    _giftTarget = target;
    _selectedUserId = null;
    if (itemLabel) itemLabel.textContent = '\uD83C\uDF81 ' + (target.type === 'image' ? 'Image' : 'Charme') + ' : ' + target.label;
    if (searchInput) searchInput.value = '';
    if (userList) userList.innerHTML = '<p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Tapez pour rechercher un utilisateur\u2026</p>';
    if (confirmBtn) { confirmBtn.disabled = true; confirmBtn.style.opacity = '.45'; }
    if (statusEl) statusEl.textContent = '';
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    setTimeout(function() { if (searchInput) searchInput.focus(); }, 50);
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    _giftTarget = null;
    _selectedUserId = null;
  }

  closeBtn && closeBtn.addEventListener('click', closeModal);
  cancelBtn && cancelBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && modal.style.display === 'flex') closeModal(); });

  function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function renderUsers(users) {
    if (!userList) return;
    userList.innerHTML = '';
    if (!users.length) {
      userList.innerHTML = '<p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Aucun utilisateur trouv\u00e9</p>';
      return;
    }
    users.forEach(function(u) {
      var row = document.createElement('button');
      row.type = 'button';
      row.style.cssText = 'width:100%;text-align:left;background:rgba(255,255,255,.05);border:1.5px solid transparent;border-radius:7px;padding:.45rem .75rem;color:#f1f5f9;font-size:.85rem;cursor:pointer;transition:background .12s,border-color .12s;display:flex;align-items:center;gap:.5rem';
      row.innerHTML = '<span style="font-weight:600">' + escHtml(u.username) + '</span>'
        + (u.email ? '<span style="color:#64748b;font-size:.78rem">' + escHtml(u.email) + '</span>' : '');
      row.dataset.userId = u.id;
      row.addEventListener('click', function() {
        userList.querySelectorAll('button').forEach(function(b) { b.style.borderColor = 'transparent'; b.style.background = 'rgba(255,255,255,.05)'; });
        row.style.borderColor = '#fbbf24';
        row.style.background = 'rgba(251,191,36,.12)';
        _selectedUserId = u.id;
        if (confirmBtn) { confirmBtn.disabled = false; confirmBtn.style.opacity = '1'; }
      });
      userList.appendChild(row);
    });
  }

  searchInput && searchInput.addEventListener('input', function() {
    var q = searchInput.value.trim();
    clearTimeout(_searchTimeout);
    if (!q) {
      if (userList) userList.innerHTML = '<p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Tapez pour rechercher un utilisateur\u2026</p>';
      return;
    }
    _searchTimeout = setTimeout(function() {
      fetch('/admin/users-for-gift?q=' + encodeURIComponent(q))
        .then(function(r) { return r.json(); })
        .then(function(d) { renderUsers(d.users || []); })
        .catch(function() {});
    }, 300);
  });

  confirmBtn && confirmBtn.addEventListener('click', function() {
    if (!_selectedUserId || !_giftTarget) return;
    confirmBtn.disabled = true;
    var body = { targetUserId: _selectedUserId, type: _giftTarget.type };
    if (_giftTarget.type === 'image') body.imageId = _giftTarget.id;
    else body.charmId = _giftTarget.id;
    fetch('/admin/recompenses/gift', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) {
        if (statusEl) { statusEl.textContent = '\u2713 Cadeau envoy\u00e9 !'; statusEl.style.color = '#4ade80'; }
        setTimeout(closeModal, 1500);
      } else {
        if (statusEl) { statusEl.textContent = '\u2717 ' + (d.error || 'Erreur'); statusEl.style.color = '#f87171'; }
        confirmBtn.disabled = false;
        confirmBtn.style.opacity = '1';
      }
    }).catch(function() {
      if (statusEl) { statusEl.textContent = '\u2717 Erreur r\u00e9seau'; statusEl.style.color = '#f87171'; }
      confirmBtn.disabled = false;
      confirmBtn.style.opacity = '1';
    });
  });

  window._adminOpenGiftModal = openModal;
})();
</script>

