            <select class="charm-rarity-select no-arrow js-theme-rarity" data-theme-key="<%= t.key %>"
                    style="border-color:<%= rarityColor %>; color:<%= rarityColor %>">
              <option value="common"    <%= t.rarity === 'common'    ? 'selected' : '' %>>Commun</option>
              <option value="rare"      <%= t.rarity === 'rare'      ? 'selected' : '' %>>Rare</option>
