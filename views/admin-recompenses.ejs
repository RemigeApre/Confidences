<!-- ── Section switching ── -->
<script>
(function() {
  var links = document.querySelectorAll('.obj-nav-link[data-section]');
  var sections = document.querySelectorAll('.obj-section[data-section]');
  var VALID = ['accueil','images','charms','themes','speciaux','cartes'];

  function activate(key) {
    links.forEach(function(l) { l.classList.toggle('active', l.dataset.section === key); });
    sections.forEach(function(s) { s.classList.toggle('active', s.dataset.section === key); });
    history.replaceState(null, '', location.pathname + '#' + key);
  }

  links.forEach(function(l) {
    l.addEventListener('click', function() { activate(l.dataset.section); });
  });

  // Accueil "goto" buttons
  document.querySelectorAll('.js-goto-section').forEach(function(btn) {
    btn.addEventListener('click', function() { activate(btn.dataset.section); });
  });

  var hash = location.hash.replace('#', '');
  activate(VALID.includes(hash) ? hash : 'accueil');
})();
</script>

<!-- ── Images JS ── -->
<script>
(function() {
  const cards = Array.from(document.querySelectorAll('.ari-card'));
  const data = cards.map(c => ({
    id: Number(c.dataset.id), rarity: c.dataset.rarity || 'common',
    title: c.dataset.title || '',
    thumb: c.querySelector('img') ? c.querySelector('img').src : '',
  }));
  let visibleIdxs = data.map((_, i) => i);
  let zoomIdx = 0;

  const filterBar = document.getElementById('ari-filter-bar');
  filterBar && filterBar.addEventListener('click', function(e) {
    const btn = e.target.closest('.ari-filter-btn'); if (!btn) return;
    filterBar.querySelectorAll('.ari-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    visibleIdxs = [];
    cards.forEach((c, i) => { const show = f === 'all' || c.dataset.rarity === f; c.hidden = !show; if (show) visibleIdxs.push(i); });
  });

  const overlay = document.getElementById('ariZoom');
  const zoomImg = document.getElementById('ariZoomImg');
  const profilePreview = document.getElementById('ariProfilePreview');
  const zoomSubtitle = document.getElementById('ariZoomSubtitle');
  const titleInput = document.getElementById('ariZoomTitleInput');
  const titleStatus = document.getElementById('ariTitleStatus');
  const rarityBtns = document.querySelectorAll('#ariRarityBtns .ari-rarity-btn');
  const saveStatus = document.getElementById('ariSaveStatus');
  const navCount = document.getElementById('ariNavCount');

  function openZoom(vi) { zoomIdx = vi; renderZoom(); overlay.hidden = false; document.body.style.overflow = 'hidden'; }
  function renderZoom() {
    const d = data[visibleIdxs[zoomIdx]]; if (!d) return;
    zoomImg.src = d.thumb || ''; profilePreview.src = d.thumb || '';
    if (titleInput) { titleInput.value = d.title || ''; }
    if (titleStatus) titleStatus.textContent = '\u00a0';
    zoomSubtitle.textContent = 'id: ' + d.id;
    navCount.textContent = (zoomIdx + 1) + ' / ' + visibleIdxs.length;
    saveStatus.textContent = '\u00a0';
    rarityBtns.forEach(b => b.classList.toggle('active', b.dataset.rarity === d.rarity));
  }
  function closeZoom() { overlay.hidden = true; document.body.style.overflow = ''; }
  function navigate(delta) { const n = zoomIdx + delta; if (n >= 0 && n < visibleIdxs.length) { zoomIdx = n; renderZoom(); } }

  const imageSection = document.querySelector('.obj-section[data-section="images"]');
  cards.forEach((c, i) => {
    c.addEventListener('click', () => {
      if (imageSection && imageSection.classList.contains('obj-sel-mode')) {
        c.classList.toggle('obj-selected');
        updateSelBar();
        return;
      }
      const vi = visibleIdxs.indexOf(i); if (vi !== -1) openZoom(vi);
    });
    c.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); const vi = visibleIdxs.indexOf(i); if (vi !== -1) openZoom(vi); } });
  });

  document.getElementById('ariZoomClose').addEventListener('click', closeZoom);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeZoom(); });
  document.getElementById('ariNavPrev').addEventListener('click', () => navigate(-1));
  document.getElementById('ariNavNext').addEventListener('click', () => navigate(1));
  const giftBtn = document.getElementById('ariGiftBtn');
  giftBtn && giftBtn.addEventListener('click', function() {
    const d = data[visibleIdxs[zoomIdx]];
    if (!d || !window._adminOpenGiftModal) return;
    window._adminOpenGiftModal({ type: 'image', id: d.id, label: d.title || ('Image #' + d.id) });
  });
  document.addEventListener('keydown', function(e) {
    if (!overlay || overlay.hidden) return;
    if (e.key === 'Escape') closeZoom();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });

  rarityBtns.forEach(btn => {
    btn.addEventListener('click', async function() {
      const dataIdx = visibleIdxs[zoomIdx]; if (dataIdx === undefined) return;
      const d = data[dataIdx]; const rarity = btn.dataset.rarity;
      saveStatus.textContent = 'Enregistrement…'; saveStatus.style.color = '#94a3b8';
      try {
        const r = await fetch('/admin/recompenses/images-profil/' + d.id + '/rarity', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rarity }),
        });
        const json = await r.json();
        if (json.ok) {
          d.rarity = rarity;
          const card = cards[dataIdx]; card.dataset.rarity = rarity; card.querySelector('.ari-card-rarity').textContent = rarity;
          rarityBtns.forEach(b => b.classList.toggle('active', b.dataset.rarity === rarity));
          saveStatus.textContent = '✓ Enregistré'; saveStatus.style.color = '#4ade80';
          const activeFilter = document.querySelector('.ari-filter-btn.active');
          if (activeFilter && activeFilter.dataset.filter !== 'all' && activeFilter.dataset.filter !== rarity) {
            card.hidden = true; visibleIdxs = visibleIdxs.filter(vi => vi !== dataIdx);
            if (!visibleIdxs.length) { closeZoom(); return; }
            zoomIdx = Math.min(zoomIdx, visibleIdxs.length - 1); renderZoom();
          }
        } else { saveStatus.textContent = '✗ Erreur'; saveStatus.style.color = '#f87171'; }
      } catch (err) { saveStatus.textContent = '✗ Erreur réseau'; saveStatus.style.color = '#f87171'; }
    });
  });

  // Title save
  let _titleSaveTimer = null;
  titleInput && titleInput.addEventListener('input', function() {
    clearTimeout(_titleSaveTimer);
    if (titleStatus) { titleStatus.textContent = '…'; titleStatus.style.color = '#94a3b8'; }
    _titleSaveTimer = setTimeout(async function() {
      const dataIdx = visibleIdxs[zoomIdx]; if (dataIdx === undefined) return;
      const d = data[dataIdx];
      const newTitle = titleInput.value.trim();
      try {
        const r = await fetch('/admin/recompenses/images-profil/' + d.id + '/title', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title: newTitle }),
        });
        const json = await r.json();
        if (json.ok) {
          d.title = newTitle;
          const card = cards[dataIdx];
          if (card) { card.dataset.title = newTitle; card.setAttribute('aria-label', newTitle || ('Image #' + d.id)); }
          if (titleStatus) { titleStatus.textContent = '\u2713 Enregistr\u00e9'; titleStatus.style.color = '#4ade80'; }
        } else { if (titleStatus) { titleStatus.textContent = '\u2717 Erreur'; titleStatus.style.color = '#f87171'; } }
      } catch(e) { if (titleStatus) { titleStatus.textContent = '\u2717 Erreur r\u00e9seau'; titleStatus.style.color = '#f87171'; } }
    }, 700);
  });

  // Selection bar helpers for images
  function updateSelBar() {
    const selected = document.querySelectorAll('.obj-section[data-section="images"] .obj-selected');
    const bar = document.getElementById('objSelBar');
    const countEl = document.getElementById('objSelCount');
    if (countEl) countEl.textContent = selected.length + ' sélectionné(s)';
    if (bar) bar.hidden = selected.length === 0;
  }
  window._imagesUpdateSelBar = updateSelBar;
})();
</script>

<!-- ── Charmes JS ── -->
<script>
(function() {
  const RARITY_COLORS = { common:'#94a3b8', rare:'#60a5fa', epic:'#a78bfa', legendary:'#fbbf24', mythic:'#f87171' };

  // Charm filter bar
  const charmFilterBar = document.getElementById('charm-filter-bar');
  const charmCards = Array.from(document.querySelectorAll('.ari-charm-card'));
  charmFilterBar && charmFilterBar.addEventListener('click', function(e) {
    const btn = e.target.closest('.ari-filter-btn'); if (!btn) return;
    charmFilterBar.querySelectorAll('.ari-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    charmCards.forEach(c => { c.hidden = !(f === 'all' || c.dataset.rarity === f); });
  });

  document.querySelectorAll('.js-admin-gift-charm').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (window._adminOpenGiftModal) {
        window._adminOpenGiftModal({ type: 'charm', id: parseInt(btn.dataset.charmId), label: btn.dataset.charmLabel });
      }
    });
  });

  document.querySelectorAll('.js-charm-rarity').forEach(function(sel) {
    sel.addEventListener('change', async function() {
      const charmId = sel.dataset.charmId;
      const rarity  = sel.value;
      const statusEl = sel.closest('.ari-charm-card').querySelector('.ari-charm-save-status');
      // Update data-rarity for filter
      sel.closest('.ari-charm-card').dataset.rarity = rarity;
      if (statusEl) { statusEl.textContent = '…'; statusEl.style.color = '#94a3b8'; }
      sel.style.color = RARITY_COLORS[rarity] || '#94a3b8';
      sel.style.borderColor = RARITY_COLORS[rarity] || 'rgba(255,255,255,.2)';
      try {
        const r = await fetch('/admin/recompenses/charms/' + charmId + '/rarity', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rarity }),
        });
        const json = await r.json();
        if (statusEl) { statusEl.textContent = json.ok ? '✓' : '✗'; statusEl.style.color = json.ok ? '#4ade80' : '#f87171'; }
        setTimeout(function() { if (statusEl) statusEl.textContent = '\u00a0'; }, 1500);
      } catch (e) { if (statusEl) { statusEl.textContent = '✗'; statusEl.style.color = '#f87171'; } }
    });
  });

  // Selection for charm cards
  const charmSection = document.querySelector('.obj-section[data-section="charms"]');
  charmCards.forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (!charmSection || !charmSection.classList.contains('obj-sel-mode')) return;
      if (e.target.closest('select') || e.target.closest('button')) return;
      card.classList.toggle('obj-selected');
      window._charmsUpdateSelBar && window._charmsUpdateSelBar();
    });
  });

  function updateSelBar() {
    const selected = document.querySelectorAll('.obj-section[data-section="charms"] .obj-selected');
    const bar = document.getElementById('objSelBar');
    const countEl = document.getElementById('objSelCount');
    if (countEl) countEl.textContent = selected.length + ' sélectionné(s)';
    if (bar) bar.hidden = selected.length === 0;
  }
  window._charmsUpdateSelBar = updateSelBar;
})();
</script>

<!-- ── Thèmes JS ── -->
<script>
(function() {
  const RARITY_COLORS = { common:'#94a3b8', rare:'#60a5fa', epic:'#a78bfa', legendary:'#fbbf24', mythic:'#f87171' };

  // Theme filter bar
  const themeFilterBar = document.getElementById('theme-filter-bar');
  const themeCards = Array.from(document.querySelectorAll('.obj-theme-selcard'));
  themeFilterBar && themeFilterBar.addEventListener('click', function(e) {
    const btn = e.target.closest('.ari-filter-btn'); if (!btn) return;
    themeFilterBar.querySelectorAll('.ari-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    themeCards.forEach(c => {
      const rarity = c.dataset.rarity;
      const always = c.dataset.always === '1';
      const show = f === 'all' || (!always && rarity === f);
      c.hidden = !show;
    });
  });

  document.querySelectorAll('.js-theme-rarity').forEach(function(sel) {
    sel.addEventListener('change', async function() {
      var key = sel.dataset.themeKey;
      var rarity = sel.value;
      var card = sel.closest('.obj-theme-selcard');
      if (card) card.dataset.rarity = rarity;
      var statusEl = sel.parentElement.querySelector('.js-theme-save-status');
      sel.style.color = RARITY_COLORS[rarity] || '#94a3b8';
      sel.style.borderColor = RARITY_COLORS[rarity] || 'rgba(255,255,255,.2)';
      if (statusEl) { statusEl.textContent = '…'; statusEl.style.color = '#94a3b8'; }
      try {
        var r = await fetch('/admin/recompenses/themes/' + key + '/rarity', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rarity: rarity }),
        });
        var json = await r.json();
        if (statusEl) {
          statusEl.textContent = json.ok ? '✓ Enregistré' : '✗ Erreur';
          statusEl.style.color = json.ok ? '#4ade80' : '#f87171';
          setTimeout(function() { statusEl.textContent = '\u00a0'; }, 1500);
        }
      } catch (e) {
        if (statusEl) { statusEl.textContent = '✗'; statusEl.style.color = '#f87171'; }
      }
    });
  });

  // Selection for theme cards
  const themeSection = document.querySelector('.obj-section[data-section="themes"]');
  themeCards.forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (!themeSection || !themeSection.classList.contains('obj-sel-mode')) return;
      if (e.target.closest('select') || e.target.closest('button')) return;
      card.classList.toggle('obj-selected');
      window._themesUpdateSelBar && window._themesUpdateSelBar();
    });
