    <%/* ── Cartes Personnages ── */%>
    <div class="obj-section" data-section="personnages">
      <%
        var _pcParodySet = {}; (personnageCards||[]).forEach(function(pc){ if(pc.parody) _pcParodySet[pc.parody]=1; });
        var _pcParodies = Object.keys(_pcParodySet).sort();
        var _pcNatures = [];
        var _pcNatSet = {}; (personnageCards||[]).forEach(function(pc){ if(pc.nature && !_pcNatSet[pc.nature]){ _pcNatSet[pc.nature]=1; _pcNatures.push(pc.nature); } });
        _pcNatures.sort();
        var _pcNatLabels = { humain:'Humain', monstre:'Monstre', animal:'Animal', pokemon:'Pokémon', autre:'Autre' };
      %>
