      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:.65rem" id="theme-grid">
        <% (themeDefs || []).forEach(function(t) { %>
        <%
          var themeColors = { rouge:'hsl(355,55%,32%)', vert:'hsl(148,42%,28%)', violet:'hsl(270,58%,32%)', bleu:'hsl(212,65%,32%)', rose:'hsl(330,58%,32%)' };
          var swatchColor = themeColors[t.key] || '#333';
          var rarityColor = t.rarity === 'mythic' ? '#f87171' : t.rarity === 'legendary' ? '#fbbf24' : t.rarity === 'epic' ? '#a78bfa' : t.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
        %>
        <div class="obj-theme-selcard" data-theme-key="<%= t.key %>" data-rarity="<%= t.rarity || '' %>" data-always="<%= t.always ? '1' : '0' %>" style="background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);border-radius:10px;padding:.85rem .65rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.35rem">
          <div style="width:3rem;height:3rem;border-radius:50%;background:<%= swatchColor %>;border:2px solid rgba(255,255,255,.2);margin:0 auto"></div>
          <div style="font-size:.85rem;font-weight:700;color:#f1f5f9"><%= t.label %></div>
          <% if (t.always) { %>
            <span class="obj-always-badge">Toujours disponible</span>
