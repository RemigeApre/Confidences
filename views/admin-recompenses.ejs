               id: pc.id, title: pc.title, description: pc.description,
               thumb: pc.thumb ? thumbUrl(pc.thumb) : null,
               nature: pc.nature, parody: pc.parody, gender: pc.gender,
               vitesse: pc.vitesse, defense: pc.defense, domSub: pc.domSub, orientation: pc.orientation,
               pv: pc.pv, passif: pc.passif, affinites: pc.affinites,
               actionPrelimName: pc.actionPrelimName, actionPrelimPower: pc.actionPrelimPower, actionPrelimEffet: pc.actionPrelimEffet,
               actionActeName: pc.actionActeName, actionActePower: pc.actionActePower, actionActeEffet: pc.actionActeEffet,
               actionFinitionName: pc.actionFinitionName, actionFinitionPower: pc.actionFinitionPower, actionFinitionEffet: pc.actionFinitionEffet,
