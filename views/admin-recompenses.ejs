        <div class="card-wiki-item" data-card-id="<%= wc.id %>" data-rarity="<%= wc.cardRarity %>" data-cat="<%= wc.category %>"
          style="background:rgba(255,255,255,.04);border:1.5px solid rgba(255,255,255,.08);border-radius:10px;overflow:hidden;display:flex;flex-direction:column">
          <% if (wc.thumb) { %>
          <div style="height:80px;overflow:hidden;flex-shrink:0">
            <img src="<%= wc.thumb %>" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
          </div>
          <% } else { %>
          <div style="height:80px;background:#0f172a;display:flex;align-items:center;justify-content:center;font-size:1.6rem;flex-shrink:0">&#127183;</div>
          <% } %>
