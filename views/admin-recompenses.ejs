          <option value="all">Tous</option>
          <option value="base">Deck de base</option>
          <option value="combat">Combat uniquement</option>
          <option value="ultra">Ultra</option>
        </select>
        <% if (_pcNatures.length > 1) { %>
        <select id="pc-nature-sel" class="admin-filter-select">
          <option value="all">Toutes natures</option>
          <% _pcNatures.forEach(function(nat) { %><option value="<%= nat %>"><%= _pcNatLabels[nat] || nat %></option><% }) %>
        </select>
        <% } %>
        <% if (_pcParodies.length > 1) { %>
        <select id="pc-parody-sel" class="admin-filter-select">
          <option value="all">Tous univers</option>
          <% _pcParodies.forEach(function(par) { %><option value="<%= par %>"><%= par %></option><% }) %>
