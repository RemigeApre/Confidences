            <select class="charm-rarity-select no-arrow js-card-rarity" data-card-id="<%= wc.id %>"
                    style="border-color:<%= wcRarityColor %>;color:<%= wcRarityColor %>">
              <% ['common','rare','epic','legendary','mythic'].forEach(function(r) { %>
                <option value="<%= r %>"<%= wc.cardRarity === r ? ' selected' : '' %>>
                  <%= { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' }[r] %>
                </option>
              <% }) %>
            </select>
            <textarea class="js-card-summary" data-card-id="<%= wc.id %>" rows="2"
              placeholder="Résumé (dos de carte)…"
              style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#cbd5e1;border-radius:5px;padding:.3rem .45rem;font-size:.72rem;resize:vertical;outline:none;font-family:inherit"><%= wc.cardSummary || '' %></textarea>
            <span class="js-card-save-status" style="font-size:.68rem;height:.85em;color:#4ade80;display:block">&nbsp;</span>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

  </main>
</div>

