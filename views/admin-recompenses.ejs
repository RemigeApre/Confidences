        <% (wikiCards || []).forEach(function(wc) { %>
        <%
          var wcRarityColor = wc.cardRarity === 'mythic' ? '#f87171' : wc.cardRarity === 'legendary' ? '#fbbf24' : wc.cardRarity === 'epic' ? '#a78bfa' : wc.cardRarity === 'rare' ? '#60a5fa' : '#94a3b8';
