        <%
          var _pcRL = { common:'Commun', rare:'Rare', epic:'Épique', legendary:'Légendaire', mythic:'Mythique' };
          var _pcRarityLabel = _pcRL[pc.cardRarity] || pc.cardRarity;
          var _pcCatLabel = [pc.parody, pc.nature && pc.nature !== 'humain' ? (_pcNatLabels[pc.nature] || pc.nature) : ''].filter(Boolean).join(' · ');
          var _pcDs = pc.domSub || 0;
          var _pcDsLabel = _pcDs < -15 ? 'Soumis' : _pcDs > 15 ? 'Dominant' : 'Switch';
