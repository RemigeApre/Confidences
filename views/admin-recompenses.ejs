<!-- ── Selection mode JS ── -->
<script>
(function() {
  var _currentSection = null;
  var _currentAction = null;
  var bar = document.getElementById('objSelBar');
  var confirmBtn = document.getElementById('objSelConfirm');
  var cancelBtn = document.getElementById('objSelCancel');
  var countEl = document.getElementById('objSelCount');

  document.querySelectorAll('.js-sel-mode').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var action = btn.dataset.action;
      var sectionKey = btn.dataset.section;
      var section = document.querySelector('.obj-section[data-section="' + sectionKey + '"]');
      if (!section) return;

      // Exit previous sel mode if any
      exitSelMode();

      _currentSection = sectionKey;
      _currentAction = action;
      section.classList.add('obj-sel-mode');
      section.dataset.selAction = action;

      // Configure bar confirm button
      if (confirmBtn) {
        confirmBtn.dataset.action = action;
        confirmBtn.textContent = action === 'delete' ? 'Supprimer' : 'Offrir à\u2026';
      }
      if (bar) bar.hidden = true; // hidden until items selected
    });
  });

  function getSelectedItems() {
    if (!_currentSection) return [];
    var items = [];
    if (_currentSection === 'images') {
      document.querySelectorAll('.obj-section[data-section="images"] .ari-card.obj-selected').forEach(function(c) {
        items.push({ type: 'image', id: Number(c.dataset.id), label: c.getAttribute('aria-label') || ('Image #' + c.dataset.id) });
      });
    } else if (_currentSection === 'charms') {
      document.querySelectorAll('.obj-section[data-section="charms"] .ari-charm-card.obj-selected').forEach(function(c) {
        var label = c.querySelector('strong') ? c.querySelector('strong').textContent : ('Charme #' + c.dataset.charmId);
        items.push({ type: 'charm', id: Number(c.dataset.charmId), label: label });
      });
    } else if (_currentSection === 'themes') {
      document.querySelectorAll('.obj-section[data-section="themes"] .obj-theme-selcard.obj-selected').forEach(function(c) {
        var label = c.querySelector('div[style*="font-size:.85rem"]') ? c.querySelector('div[style*="font-size:.85rem"]').textContent.trim() : c.dataset.themeKey;
        items.push({ type: 'theme', id: c.dataset.themeKey, label: label });
      });
    }
    return items;
  }

  function updateBarCount() {
    var items = getSelectedItems();
    if (countEl) countEl.textContent = items.length + ' sélectionné(s)';
    if (bar) bar.hidden = items.length === 0;
  }
  window._selModeUpdateCount = updateBarCount;

  // Patch the individual section updaters to also update bar count properly
  window._imagesUpdateSelBar = updateBarCount;
  window._charmsUpdateSelBar = updateBarCount;
  window._themesUpdateSelBar = updateBarCount;

  function exitSelMode() {
    if (_currentSection) {
      var s = document.querySelector('.obj-section[data-section="' + _currentSection + '"]');
      if (s) {
        s.classList.remove('obj-sel-mode');
        delete s.dataset.selAction;
        s.querySelectorAll('.obj-selected').forEach(function(el) { el.classList.remove('obj-selected'); });
      }
    }
    _currentSection = null;
    _currentAction = null;
    if (bar) bar.hidden = true;
  }

  cancelBtn && cancelBtn.addEventListener('click', exitSelMode);

  confirmBtn && confirmBtn.addEventListener('click', async function() {
    var items = getSelectedItems();
    if (!items.length) return;
    if (_currentAction === 'delete') {
      if (!confirm('Supprimer ' + items.length + ' élément(s) ? Cette action est irréversible.')) return;
      var ids = items.map(function(i) { return i.id; });
      var endpoint = _currentSection === 'images'
        ? '/admin/recompenses/images-profil/bulk-delete'
        : '/admin/recompenses/charms/bulk-delete';
      try {
        var r = await fetch(endpoint, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: ids }),
        });
        var json = await r.json();
        if (json.ok) {
          // Remove deleted cards from DOM
          if (_currentSection === 'images') {
            document.querySelectorAll('.obj-section[data-section="images"] .ari-card.obj-selected').forEach(function(c) { c.remove(); });
          } else if (_currentSection === 'charms') {
            document.querySelectorAll('.obj-section[data-section="charms"] .ari-charm-card.obj-selected').forEach(function(c) { c.remove(); });
          }
          exitSelMode();
        } else {
          alert('Erreur lors de la suppression.');
        }
      } catch (e) {
        alert('Erreur réseau.');
      }
    } else {
      // Gift action
      if (window._adminOpenGiftModal) {
        window._adminOpenGiftModal({ items: items });
      }
    }
  });
})();
</script>

<!-- ── Modal offrir ── -->
<div id="adminGiftModal" style="position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.85);display:none;align-items:center;justify-content:center">
  <div style="background:#1e293b;border-radius:14px;padding:1.5rem;width:min(95vw,420px);display:flex;flex-direction:column;gap:.85rem;max-height:90vh;overflow:hidden">
    <div style="display:flex;align-items:center;justify-content:space-between">
      <h3 style="margin:0;font-size:.95rem;font-weight:700;color:#f1f5f9">Offrir à un utilisateur</h3>
      <button id="adminGiftClose" style="background:none;border:none;color:#f87171;cursor:pointer;padding:.25rem;line-height:0">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p id="adminGiftItemLabel" style="margin:0;font-size:.82rem;color:#94a3b8;background:rgba(255,255,255,.05);padding:.5rem .75rem;border-radius:6px"></p>
    <input id="adminGiftSearch" type="text" placeholder="Rechercher un utilisateur…" autocomplete="off"
      style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:7px;color:#f1f5f9;padding:.5rem .75rem;font-size:.88rem;outline:none">
    <div id="adminGiftUserList" style="min-height:60px;max-height:200px;overflow-y:auto;display:flex;flex-direction:column;gap:.3rem">
      <p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Tapez pour rechercher un utilisateur…</p>
    </div>
    <div style="display:flex;gap:.5rem;justify-content:flex-end;align-items:center">
      <span id="adminGiftStatus" style="flex:1;font-size:.78rem;color:#4ade80;min-height:1em"></span>
      <button id="adminGiftCancel" style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);color:#94a3b8;border-radius:7px;padding:.4rem .9rem;font-size:.85rem;cursor:pointer">Annuler</button>
      <button id="adminGiftConfirm" disabled style="background:#fbbf24;border:none;color:#0f172a;border-radius:7px;padding:.4rem .9rem;font-size:.85rem;font-weight:700;cursor:pointer;opacity:.45">Offrir</button>
    </div>
  </div>
</div>

<script>
(function() {
  var modal = document.getElementById('adminGiftModal');
  var closeBtn = document.getElementById('adminGiftClose');
  var cancelBtn = document.getElementById('adminGiftCancel');
  var confirmBtn = document.getElementById('adminGiftConfirm');
  var searchInput = document.getElementById('adminGiftSearch');
  var userList = document.getElementById('adminGiftUserList');
  var itemLabel = document.getElementById('adminGiftItemLabel');
  var statusEl = document.getElementById('adminGiftStatus');
  if (!modal) return;

  var _giftTarget = null;
  var _selectedUserId = null;
  var _searchTimeout = null;

  function openModal(target) {
    _giftTarget = target;
    _selectedUserId = null;
    if (target.items) {
      if (itemLabel) itemLabel.textContent = '\uD83C\uDF81 ' + target.items.length + ' objet(s) à offrir';
    } else {
      if (itemLabel) itemLabel.textContent = '\uD83C\uDF81 ' + (target.type === 'image' ? 'Image' : target.type === 'charm' ? 'Charme' : 'Thème') + ' : ' + target.label;
    }
    if (searchInput) searchInput.value = '';
    if (userList) userList.innerHTML = '<p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Tapez pour rechercher un utilisateur\u2026</p>';
    if (confirmBtn) { confirmBtn.disabled = true; confirmBtn.style.opacity = '.45'; }
    if (statusEl) statusEl.textContent = '';
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    setTimeout(function() { if (searchInput) searchInput.focus(); }, 50);
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    _giftTarget = null;
    _selectedUserId = null;
  }

  closeBtn && closeBtn.addEventListener('click', closeModal);
  cancelBtn && cancelBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && modal.style.display === 'flex') closeModal(); });

  function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function renderUsers(users) {
    if (!userList) return;
    userList.innerHTML = '';
    if (!users.length) {
      userList.innerHTML = '<p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Aucun utilisateur trouv\u00e9</p>';
      return;
    }
    users.forEach(function(u) {
      var row = document.createElement('button');
      row.type = 'button';
      row.style.cssText = 'width:100%;text-align:left;background:rgba(255,255,255,.05);border:1.5px solid transparent;border-radius:7px;padding:.45rem .75rem;color:#f1f5f9;font-size:.85rem;cursor:pointer;transition:background .12s,border-color .12s;display:flex;align-items:center;gap:.5rem';
      row.innerHTML = '<span style="font-weight:600">' + escHtml(u.username) + '</span>'
        + (u.email ? '<span style="color:#64748b;font-size:.78rem">' + escHtml(u.email) + '</span>' : '');
      row.dataset.userId = u.id;
      row.addEventListener('click', function() {
        userList.querySelectorAll('button').forEach(function(b) { b.style.borderColor = 'transparent'; b.style.background = 'rgba(255,255,255,.05)'; });
        row.style.borderColor = '#fbbf24';
        row.style.background = 'rgba(251,191,36,.12)';
        _selectedUserId = u.id;
        if (confirmBtn) { confirmBtn.disabled = false; confirmBtn.style.opacity = '1'; }
      });
      userList.appendChild(row);
    });
  }

  searchInput && searchInput.addEventListener('input', function() {
    var q = searchInput.value.trim();
    clearTimeout(_searchTimeout);
    if (!q) {
      if (userList) userList.innerHTML = '<p style="color:#64748b;font-size:.82rem;text-align:center;margin:.75rem 0">Tapez pour rechercher un utilisateur\u2026</p>';
      return;
    }
    _searchTimeout = setTimeout(function() {
      fetch('/admin/users-for-gift?q=' + encodeURIComponent(q))
        .then(function(r) { return r.json(); })
        .then(function(d) { renderUsers(d.users || []); })
        .catch(function() {});
    }, 300);
  });

  confirmBtn && confirmBtn.addEventListener('click', function() {
    if (!_selectedUserId || !_giftTarget) return;
    confirmBtn.disabled = true;
    var body = { targetUserId: _selectedUserId };
    if (_giftTarget.items) {
      // Bulk gift
      body.items = _giftTarget.items.map(function(i) { return { type: i.type, id: i.id }; });
    } else {
      body.type = _giftTarget.type;
      if (_giftTarget.type === 'image') body.imageId = _giftTarget.id;
      else body.charmId = _giftTarget.id;
    }
    fetch('/admin/recompenses/gift', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) {
        if (statusEl) { statusEl.textContent = '\u2713 Cadeau envoy\u00e9 !'; statusEl.style.color = '#4ade80'; }
        setTimeout(closeModal, 1500);
      } else {
        if (statusEl) { statusEl.textContent = '\u2717 ' + (d.error || 'Erreur'); statusEl.style.color = '#f87171'; }
        confirmBtn.disabled = false;
        confirmBtn.style.opacity = '1';
      }
    }).catch(function() {
      if (statusEl) { statusEl.textContent = '\u2717 Erreur r\u00e9seau'; statusEl.style.color = '#f87171'; }
      confirmBtn.disabled = false;
      confirmBtn.style.opacity = '1';
    });
  });

  window._adminOpenGiftModal = openModal;
})();
</script>

<!-- ── Spéciaux JS (Jokers & Pièces) ── -->
<script>
(function() {
  function makeUserSearchWidget(searchInputId, resultsId, selectedId, btnId, onSelect) {
    var searchInput = document.getElementById(searchInputId);
    var resultsDiv  = document.getElementById(resultsId);
    var selectedDiv = document.getElementById(selectedId);
    var btn         = document.getElementById(btnId);
    var selectedUserId = null;
    var _debounce = null;

    function showResults(users) {
      resultsDiv.innerHTML = '';
      if (!users.length) { resultsDiv.style.display = 'none'; return; }
      resultsDiv.style.display = 'flex';
      users.forEach(function(u) {
        var row = document.createElement('div');
        row.textContent = u.displayName + ' (' + u.username + ')';
        row.style.cssText = 'padding:.3rem .5rem;cursor:pointer;border-radius:4px;font-size:.82rem;color:#e2e8f0';
        row.addEventListener('mouseenter', function() { row.style.background='rgba(255,255,255,.07)'; });
        row.addEventListener('mouseleave', function() { row.style.background=''; });
        row.addEventListener('click', function() {
          selectedUserId = u.id;
          searchInput.value = u.displayName + ' (' + u.username + ')';
          resultsDiv.style.display = 'none';
          selectedDiv.textContent = 'S\u00e9lectionn\u00e9 : ' + u.displayName;
          selectedDiv.style.display = 'block';
          btn.disabled = false; btn.style.opacity = '1';
          if (onSelect) onSelect(u);
        });
        resultsDiv.appendChild(row);
      });
    }

    searchInput && searchInput.addEventListener('input', function() {
      clearTimeout(_debounce);
      var q = searchInput.value.trim();
      if (q.length < 2) { resultsDiv.style.display = 'none'; return; }
      _debounce = setTimeout(function() {
        fetch('/admin/users-for-gift?q=' + encodeURIComponent(q))
          .then(function(r) { return r.json(); })
          .then(function(d) { showResults(d.users || []); })
          .catch(function() {});
      }, 300);
    });

    return { getSelectedUserId: function() { return selectedUserId; }, reset: function() { selectedUserId = null; btn.disabled = true; btn.style.opacity = '.5'; selectedDiv.style.display = 'none'; searchInput.value = ''; } };
  }

  // Joker
  var jokerWidget = makeUserSearchWidget('joker-user-search', 'joker-user-results', 'joker-selected-user', 'joker-gift-btn');
  var jokerBtn    = document.getElementById('joker-gift-btn');
  var jokerStatus = document.getElementById('joker-gift-status');
  jokerBtn && jokerBtn.addEventListener('click', async function() {
    var userId = jokerWidget.getSelectedUserId();
    var type   = document.getElementById('joker-type-select').value;
    if (!userId) return;
    jokerBtn.disabled = true;
    try {
      var r = await fetch('/admin/recompenses/gift-joker', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetUserId: userId, jokerType: type }),
      });
      var d = await r.json();
      if (d.ok) {
        jokerStatus.textContent = '\u2713 Joker envoy\u00e9 \u00e0 ' + d.username;
        jokerStatus.style.color = '#4ade80';
        jokerWidget.reset();
      } else {
        jokerStatus.textContent = '\u2717 ' + (d.error || 'Erreur');
        jokerStatus.style.color = '#f87171';
        jokerBtn.disabled = false;
      }
    } catch(e) {
      jokerStatus.textContent = '\u2717 Erreur r\u00e9seau';
      jokerStatus.style.color = '#f87171';
      jokerBtn.disabled = false;
    }
  });

  // Pièces
  var coinsWidget = makeUserSearchWidget('coins-user-search', 'coins-user-results', 'coins-selected-user', 'coins-gift-btn');
  var coinsBtn    = document.getElementById('coins-gift-btn');
  var coinsStatus = document.getElementById('coins-gift-status');
  coinsBtn && coinsBtn.addEventListener('click', async function() {
    var userId = coinsWidget.getSelectedUserId();
    var amount = parseInt(document.getElementById('coins-amount-input').value, 10) || 0;
    if (!userId || amount <= 0) return;
    coinsBtn.disabled = true;
    try {
      var r = await fetch('/admin/recompenses/gift-coins', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetUserId: userId, amount: amount }),
      });
      var d = await r.json();
      if (d.ok) {
        coinsStatus.textContent = '\u2713 ' + amount + '\u202fP envoy\u00e9(es) \u00e0 ' + d.username;
        coinsStatus.style.color = '#4ade80';
        coinsWidget.reset();
      } else {
        coinsStatus.textContent = '\u2717 ' + (d.error || 'Erreur');
        coinsStatus.style.color = '#f87171';
        coinsBtn.disabled = false;
      }
    } catch(e) {
      coinsStatus.textContent = '\u2717 Erreur r\u00e9seau';
      coinsStatus.style.color = '#f87171';
      coinsBtn.disabled = false;
    }
  });
})();
</script>

<!-- ── Cartes Codex JS ── -->
<script>
(function() {
  const RARITY_COLORS = { common:'#94a3b8', rare:'#60a5fa', epic:'#a78bfa', legendary:'#fbbf24', mythic:'#f87171' };
  const cardItems = Array.from(document.querySelectorAll('.card-wiki-item'));

  // Filter selects
  const cardFilterSel = document.getElementById('card-filter-sel');
  const cardCatFilterSel = document.getElementById('card-cat-filter-sel');
  const searchInput = document.getElementById('card-search-input');
  cardFilterSel && cardFilterSel.addEventListener('change', applyCardFilters);
  cardCatFilterSel && cardCatFilterSel.addEventListener('change', applyCardFilters);
  searchInput && searchInput.addEventListener('input', applyCardFilters);

  function applyCardFilters() {
    const rarityFilter = cardFilterSel ? cardFilterSel.value : 'all';
    const catFilter = cardCatFilterSel ? cardCatFilterSel.value : 'all';
    const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
    cardItems.forEach(c => {
      const rarityMatch = rarityFilter === 'all' || c.dataset.rarity === rarityFilter;
      const catMatch = catFilter === 'all' || c.dataset.cat === catFilter;
      const textMatch = !q || c.dataset.cat.toLowerCase().includes(q) || c.querySelector('[style*="font-size:.8rem"]').textContent.toLowerCase().includes(q);
      c.hidden = !(rarityMatch && catMatch && textMatch);
    });
  }

  // Rarity change
  document.querySelectorAll('.js-card-rarity').forEach(function(sel) {
    sel.addEventListener('change', async function() {
      const cardId = sel.dataset.cardId;
      const rarity = sel.value;
      const item = sel.closest('.card-wiki-item');
      if (item) item.dataset.rarity = rarity;
      const statusEl = sel.parentElement.querySelector('.js-card-save-status');
      sel.style.color = RARITY_COLORS[rarity] || '#94a3b8';
      sel.style.borderColor = RARITY_COLORS[rarity] || 'rgba(255,255,255,.2)';
      if (statusEl) { statusEl.textContent = '…'; statusEl.style.color = '#94a3b8'; }
      try {
        const r = await fetch('/admin/recompenses/cards/' + cardId + '/rarity', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rarity }),
        });
        const json = await r.json();
        if (statusEl) {
          statusEl.textContent = json.ok ? '✓' : '✗';
          statusEl.style.color = json.ok ? '#4ade80' : '#f87171';
          setTimeout(function() { if (statusEl) statusEl.textContent = '\u00a0'; }, 1500);
        }
      } catch(e) { if (statusEl) { statusEl.textContent = '✗'; statusEl.style.color = '#f87171'; } }
    });
  });

  // Summary auto-save
  const _summaryTimers = {};
  document.querySelectorAll('.js-card-summary').forEach(function(ta) {
    ta.addEventListener('input', function() {
      const cardId = ta.dataset.cardId;
      const statusEl = ta.parentElement.querySelector('.js-card-save-status');
      clearTimeout(_summaryTimers[cardId]);
      if (statusEl) { statusEl.textContent = '…'; statusEl.style.color = '#94a3b8'; }
      _summaryTimers[cardId] = setTimeout(async function() {
        try {
          const r = await fetch('/admin/recompenses/cards/' + cardId + '/summary', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ summary: ta.value }),
          });
          const json = await r.json();
          if (statusEl) {
            statusEl.textContent = json.ok ? '✓ Enregistré' : '✗ Erreur';
            statusEl.style.color = json.ok ? '#4ade80' : '#f87171';
            setTimeout(function() { if (statusEl) statusEl.textContent = '\u00a0'; }, 2000);
          }
        } catch(e) { if (statusEl) { statusEl.textContent = '✗'; statusEl.style.color = '#f87171'; } }
      }, 700);
    });
  });

  // ── Déclinaisons (variants) ──
  document.querySelectorAll('.js-variants-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const body = btn.closest('.js-variants-wrap').querySelector('.js-variants-body');
      if (!body) return;
      const open = body.style.display !== 'none';
      body.style.display = open ? 'none' : 'block';
      btn.querySelector('span').textContent = open ? '▶' : '▼';
    });
  });

  function bindVariantRow(row) {
    const vid = row.dataset.variantId;
    const saveBtn = row.querySelector('.js-variant-save');
    const delBtn  = row.querySelector('.js-variant-delete');
    const statusEl = row.querySelector('.js-variant-status');
    const raritySel = row.querySelector('.js-variant-rarity');

    raritySel && raritySel.addEventListener('change', function() {
      raritySel.style.color = RARITY_COLORS[raritySel.value] || '#94a3b8';
      raritySel.style.borderColor = RARITY_COLORS[raritySel.value] || 'rgba(255,255,255,.2)';
    });

    saveBtn && saveBtn.addEventListener('click', async function() {
      const title   = row.querySelector('.js-variant-title').value.trim();
      const rarity  = raritySel ? raritySel.value : 'rare';
      const summary = row.querySelector('.js-variant-summary').value.trim();
      if (!title) return;
      statusEl.textContent = '…'; statusEl.style.color = '#94a3b8';
      try {
        await fetch('/admin/recompenses/card-variants/' + vid + '/title',   { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ title }) });
        await fetch('/admin/recompenses/card-variants/' + vid + '/rarity',  { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ rarity }) });
        await fetch('/admin/recompenses/card-variants/' + vid + '/summary', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ summary: summary || null }) });
        statusEl.textContent = '✓'; statusEl.style.color = '#4ade80';
        setTimeout(function(){ statusEl.textContent = ''; }, 1500);
      } catch(e) { statusEl.textContent = '✗'; statusEl.style.color = '#f87171'; }
    });

    delBtn && delBtn.addEventListener('click', async function() {
      if (!confirm('Supprimer cette déclinaison ?')) return;
      try {
        const r = await fetch('/admin/recompenses/card-variants/' + vid + '/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body: '{}' });
        const d = await r.json();
        if (d.ok) {
          row.remove();
          const wrap = document.querySelector('.js-variants-toggle[data-card-id="' + row.closest('[data-card-id]').dataset.cardId + '"]');
          if (wrap) {
            const cnt = wrap.querySelector('.js-variant-count');
            if (cnt) cnt.textContent = parseInt(cnt.textContent, 10) - 1;
          }
        }
      } catch(e) {}
    });
  }

  document.querySelectorAll('.js-variant-row').forEach(bindVariantRow);

  document.querySelectorAll('.js-add-variant-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const cardId = btn.dataset.cardId;
      const form   = btn.closest('.js-add-variant-form');
      const titleInput = form.querySelector('.js-new-variant-title');
      const title = (titleInput ? titleInput.value : '').trim();
      if (!title) { titleInput && titleInput.focus(); return; }
      try {
        const r = await fetch('/admin/recompenses/cards/' + cardId + '/variants', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, rarity: 'rare', summary: null }),
        });
        const d = await r.json();
        if (!d.ok) return;
        const v = d.variant;
        const variantsBody = btn.closest('.js-variants-body');
        const rowHtml = `<div class="js-variant-row" data-variant-id="${v.id}"
          style="background:rgba(0,0,0,.2);border-radius:6px;padding:.4rem .5rem;margin-bottom:.3rem;display:flex;flex-direction:column;gap:.25rem">
          <input type="text" class="js-variant-title" value="${v.title.replace(/"/g,'&quot;')}"
            style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#f1f5f9;border-radius:4px;padding:.25rem .4rem;font-size:.72rem;font-family:inherit;outline:none;width:100%">
          <select class="charm-rarity-select no-arrow js-variant-rarity" style="border-color:#60a5fa;color:#60a5fa">
            <option value="common">Commun</option>
            <option value="rare" selected>Rare</option>
            <option value="epic">Épique</option>
            <option value="legendary">Légendaire</option>
            <option value="mythic">Mythique</option>
          </select>
          <textarea class="js-variant-summary" rows="2" placeholder="Résumé…"
            style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#cbd5e1;border-radius:4px;padding:.25rem .4rem;font-size:.72rem;resize:vertical;outline:none;font-family:inherit"></textarea>
          <div style="display:flex;gap:.3rem;align-items:center">
            <button class="js-variant-save" style="background:#1e40af;border:none;color:#fff;font-size:.65rem;padding:.2rem .45rem;border-radius:4px;cursor:pointer">Sauver</button>
            <button class="js-variant-delete" style="background:#7f1d1d;border:none;color:#fca5a5;font-size:.65rem;padding:.2rem .45rem;border-radius:4px;cursor:pointer">Suppr.</button>
            <span class="js-variant-status" style="font-size:.65rem;color:#4ade80"></span>
          </div>
        </div>`;
        const tmp = document.createElement('div'); tmp.innerHTML = rowHtml;
        const newRow = tmp.firstElementChild;
        variantsBody.insertBefore(newRow, form);
        bindVariantRow(newRow);
        titleInput.value = '';
        const toggleBtn = variantsBody.closest('.js-variants-wrap').querySelector('.js-variants-toggle');
        if (toggleBtn) {
          const cnt = toggleBtn.querySelector('.js-variant-count');
          if (cnt) cnt.textContent = parseInt(cnt.textContent, 10) + 1;
        }
      } catch(e) {}
    });
  });
})();
</script>

<!-- ── Cartes Personnages JS ── -->
<script>
(function() {
  const RARITY_COLORS = { common:'#94a3b8', rare:'#60a5fa', epic:'#a78bfa', legendary:'#fbbf24', mythic:'#f87171' };
  const pcItems = Array.from(document.querySelectorAll('#pc-grid .pc-card-tile'));

  const pcDeckSel    = document.getElementById('pc-deck-sel');
  const pcNatureSel  = document.getElementById('pc-nature-sel');
  const pcParodySel  = document.getElementById('pc-parody-sel');
  pcDeckSel    && pcDeckSel.addEventListener('change', applyPcFilters);
  pcNatureSel  && pcNatureSel.addEventListener('change', applyPcFilters);
  pcParodySel  && pcParodySel.addEventListener('change', applyPcFilters);

  function applyPcFilters() {
    const deck = pcDeckSel ? pcDeckSel.value : 'all';
    const nat  = pcNatureSel ? pcNatureSel.value : 'all';
    const par  = pcParodySel ? pcParodySel.value : 'all';
    const q = (document.getElementById('pc-search-input') || {}).value;
    const ql = q ? q.trim().toLowerCase() : '';
    pcItems.forEach(c => {
      const deckMatch = deck === 'all' || c.dataset.deck === deck;
      const natMatch  = nat === 'all' || c.dataset.nat === nat;
      const parMatch  = par === 'all' || c.dataset.parody === par;
      const nameEl = c.querySelector('.pc-admin-card-name');
      const textMatch = !ql || (nameEl && nameEl.textContent.toLowerCase().includes(ql));
      c.hidden = !(deckMatch && natMatch && parMatch && textMatch);
    });
  }

  const pcSearch = document.getElementById('pc-search-input');
  pcSearch && pcSearch.addEventListener('input', applyPcFilters);

  // ── Modal ──
  const modal            = document.getElementById('pcModal');
  const modalImg         = document.getElementById('pcModalImg');
  const modalImgPh       = document.getElementById('pcModalImgPlaceholder');
  const modalName        = document.getElementById('pcModalName');
  const modalTags        = document.getElementById('pcModalTags');
  const modalDesc        = document.getElementById('pcModalDesc');
  const modalStatsStatus = document.getElementById('pcModalStatsStatus');
  const pcSelStatut      = document.getElementById('pcSelStatut');
  const pcSelVisibilite  = document.getElementById('pcSelVisibilite');
  let activePcId = null;

  const passifDescs = <%- JSON.stringify(Object.fromEntries(passifs.map(p => [p.id, p.desc || '']))) %>;
  let currentAffinites = [];

  function renderAffinites() {
    const wrap = document.getElementById('pcAffinitesWrap');
    wrap.innerHTML = '';
    currentAffinites.forEach(function(tag, i) {
      const chip = document.createElement('span');
      chip.className = 'pc-affinite-chip';
      chip.innerHTML = tag + ' <button class="pc-affinite-chip-del" data-i="' + i + '" type="button">&#10005;</button>';
      chip.querySelector('.pc-affinite-chip-del').addEventListener('click', function() {
        currentAffinites.splice(i, 1); renderAffinites();
      });
      wrap.appendChild(chip);
    });
  }

  document.getElementById('pcAffiniteAdd').addEventListener('click', function() {
    const inp = document.getElementById('pcAffiniteInput');
    const val = inp.value.trim();
    if (val && !currentAffinites.includes(val)) { currentAffinites.push(val); renderAffinites(); }
    inp.value = '';
  });
  document.getElementById('pcAffiniteInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); document.getElementById('pcAffiniteAdd').click(); }
  });

  document.getElementById('pcSelPassif').addEventListener('change', function() {
    document.getElementById('pcPassifDesc').textContent = passifDescs[this.value] || '\u00a0';
  });

  function openPcModal(tile) {
    let pc;
    try { pc = JSON.parse(tile.dataset.pc); } catch(e) { return; }
    activePcId = pc.id;

    if (pc.thumb) {
      modalImg.src = pc.thumb; modalImg.style.display = 'block';
      modalImgPh.style.display = 'none';
    } else {
      modalImg.style.display = 'none'; modalImgPh.style.display = 'flex';
    }

    modalName.textContent = pc.title;
    const tags = [pc.parody, pc.nature && pc.nature !== 'humain' ? pc.nature : ''].filter(Boolean);
    modalTags.textContent = tags.join(' · ');

    if (pcSelStatut)     pcSelStatut.value     = (pc.isBaseDeck != null ? pc.isBaseDeck : 1) ? 'base' : 'gagner';
    if (pcSelVisibilite) pcSelVisibilite.value  = pc.isUltra ? 'ultra' : 'normal';

    modalDesc.value = pc.description || '';

    document.getElementById('pcStatVitesse').value     = pc.vitesse  != null ? pc.vitesse  : 5;
    document.getElementById('pcStatDefense').value     = pc.defense  != null ? pc.defense  : 5;
    document.getElementById('pcStatDomSub').value      = pc.domSub   != null ? pc.domSub   : 0;
    document.getElementById('pcStatOrientation').value = pc.orientation || 'bi';
    document.getElementById('pcStatPv').value          = pc.pv != null ? pc.pv : 100;
    document.getElementById('pcStat_prelim_name').value    = pc.actionPrelimName    || '';
    document.getElementById('pcStat_prelim_power').value   = pc.actionPrelimPower   != null ? pc.actionPrelimPower   : 3;
    document.getElementById('pcStat_prelim_effet').value   = pc.actionPrelimEffet   || '';
    document.getElementById('pcStat_acte_name').value      = pc.actionActeName      || '';
    document.getElementById('pcStat_acte_power').value     = pc.actionActePower     != null ? pc.actionActePower     : 7;
    document.getElementById('pcStat_acte_effet').value     = pc.actionActeEffet     || '';
    document.getElementById('pcStat_finition_name').value  = pc.actionFinitionName  || '';
    document.getElementById('pcStat_finition_power').value = pc.actionFinitionPower != null ? pc.actionFinitionPower : 20;
    document.getElementById('pcStat_finition_effet').value = pc.actionFinitionEffet || '';

    const passifSel = document.getElementById('pcSelPassif');
    passifSel.value = pc.passif || '';
    document.getElementById('pcPassifDesc').textContent = passifDescs[passifSel.value] || '\u00a0';

    currentAffinites = Array.isArray(pc.affinites) ? pc.affinites.slice() : [];
    renderAffinites();
    document.getElementById('pcAffiniteInput').value = '';

    modalStatsStatus.textContent = '';
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closePcModal() {
    modal.hidden = true; document.body.style.overflow = ''; activePcId = null;
  }

  // Flip
  document.querySelectorAll('.js-coffre-card-flip-admin').forEach(function(wrap) {
    wrap.addEventListener('click', function(e) {
      if (e.target.closest('.js-pc-open-modal')) return;
      wrap.classList.toggle('flipped');
    });
  });

  // Edit button
  document.querySelectorAll('.js-pc-open-modal').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const tile = btn.closest('.pc-card-tile');
      if (tile) openPcModal(tile);
    });
  });

  document.querySelector('.js-pc-modal-close').addEventListener('click', closePcModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closePcModal(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !modal.hidden) closePcModal(); });


  // Bouton unique — tout enregistrer
  document.querySelector('.js-pc-modal-stats-save').addEventListener('click', async function() {
    if (!activePcId) return;
    const statut = pcSelStatut ? pcSelStatut.value : 'base';
    const visib  = pcSelVisibilite ? pcSelVisibilite.value : 'normal';
    const flags  = { isBaseDeck: statut === 'base' ? 1 : 0, isUltra: visib === 'ultra' ? 1 : 0 };
    const description = modalDesc.value.trim();
    const statsPayload = {
      vitesse:             document.getElementById('pcStatVitesse').value,
      defense:             document.getElementById('pcStatDefense').value,
      domSub:              document.getElementById('pcStatDomSub').value,
      orientation:         document.getElementById('pcStatOrientation').value,
      pv:                  document.getElementById('pcStatPv').value,
      passif:              document.getElementById('pcSelPassif').value,
      affinites:           currentAffinites,
      actionPrelimName:    document.getElementById('pcStat_prelim_name').value,
      actionPrelimPower:   document.getElementById('pcStat_prelim_power').value,
      actionPrelimEffet:   document.getElementById('pcStat_prelim_effet').value,
      actionActeName:      document.getElementById('pcStat_acte_name').value,
      actionActePower:     document.getElementById('pcStat_acte_power').value,
      actionActeEffet:     document.getElementById('pcStat_acte_effet').value,
      actionFinitionName:  document.getElementById('pcStat_finition_name').value,
      actionFinitionPower: document.getElementById('pcStat_finition_power').value,
      actionFinitionEffet: document.getElementById('pcStat_finition_effet').value,
    };
    modalStatsStatus.textContent = '…'; modalStatsStatus.style.color = '#94a3b8';
    try {
      const base = '/admin/recompenses/personnages/' + activePcId;
      const opts = (body) => ({ method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
      const [r1, r2, r3] = await Promise.all([
        fetch(base + '/flags',       opts(flags)),
        fetch(base + '/description', opts({ description })),
        fetch(base + '/stats',       opts(statsPayload)),
      ]);
      const [d1, d2, d3] = await Promise.all([r1.json(), r2.json(), r3.json()]);
      const ok = d1.ok && d2.ok && d3.ok;
      // Mettre à jour le dataset de la tuile
      const tile = document.querySelector('.pc-card-tile[data-card-id="' + activePcId + '"]');
      if (tile && ok) {
        let pc; try { pc = JSON.parse(tile.dataset.pc); } catch(_) { pc = {}; }
        Object.assign(pc, flags, { description }, {
          vitesse: +statsPayload.vitesse, defense: +statsPayload.defense,
          domSub: +statsPayload.domSub, orientation: statsPayload.orientation,
          pv: +statsPayload.pv,
          passif: statsPayload.passif, affinites: statsPayload.affinites,
          actionPrelimName: statsPayload.actionPrelimName, actionPrelimPower: +statsPayload.actionPrelimPower, actionPrelimEffet: statsPayload.actionPrelimEffet,
          actionActeName: statsPayload.actionActeName, actionActePower: +statsPayload.actionActePower, actionActeEffet: statsPayload.actionActeEffet,
          actionFinitionName: statsPayload.actionFinitionName, actionFinitionPower: +statsPayload.actionFinitionPower, actionFinitionEffet: statsPayload.actionFinitionEffet,
        });
        tile.dataset.pc = JSON.stringify(pc);
        // Mettre à jour data-deck sur la tuile
        tile.dataset.deck = flags.isUltra ? 'ultra' : flags.isBaseDeck ? 'base' : 'combat';
        // Badge ultra
        const ultraBadge = tile.querySelector('.pc-admin-ultra-badge');
        if (flags.isUltra && !ultraBadge) {
          const badge = document.createElement('span');
          badge.className = 'pc-admin-ultra-badge'; badge.textContent = 'ULTRA';
          tile.querySelector('.lb-codex-flip-front').appendChild(badge);
        } else if (!flags.isUltra && ultraBadge) { ultraBadge.remove(); }
        // Mettre à jour la description dans le footer de la carte
        const quoteEl = tile.querySelector('.pc-gwent-quote');
        if (description && !quoteEl) {
          const q = document.createElement('span'); q.className = 'pc-gwent-quote'; q.textContent = description;
          tile.querySelector('.pc-gwent-footer').appendChild(q);
        } else if (quoteEl) { quoteEl.textContent = description; quoteEl.hidden = !description; }
      }
      modalStatsStatus.textContent = ok ? '✓ Enregistré' : '✗ Erreur';
      modalStatsStatus.style.color = ok ? '#4ade80' : '#f87171';
      setTimeout(function() { modalStatsStatus.textContent = ''; }, 2000);
    } catch(e) { modalStatsStatus.textContent = '✗ Erreur réseau'; modalStatsStatus.style.color = '#f87171'; }
  });
})();
</script>

