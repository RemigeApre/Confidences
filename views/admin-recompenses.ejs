<%- include('partials/head', { title: 'Admin : Récompenses', extraCss: ['admin.css'] }) %>

<div class="admin-topbar">
  <a href="/admin" class="admin-topbar-back">&#8592; Retour</a>
  <span class="admin-topbar-title"><%= config.title %> &mdash; R&eacute;compenses</span>
</div>

<% var section = locals.section || 'images'; %>

<div style="display:flex;min-height:calc(100vh - 52px)">

  <%/* ── Sidebar ── */%>
  <nav style="width:200px;min-width:180px;background:rgba(255,255,255,.035);border-right:1px solid rgba(255,255,255,.08);padding:1.5rem .75rem;display:flex;flex-direction:column;gap:.25rem;flex-shrink:0">
    <p style="font-size:.7rem;font-weight:700;color:#64748b;letter-spacing:.09em;text-transform:uppercase;margin:0 0 .6rem .5rem">Récompenses</p>

    <a href="/admin/recompenses?section=images" style="display:flex;align-items:center;gap:.6rem;padding:.5rem .75rem;border-radius:7px;text-decoration:none;font-size:.875rem;font-weight:600;transition:background .15s;<%= section==='images' ? 'background:rgba(248,113,113,.18);color:#fca5a5' : 'color:#94a3b8' %>"
      onmouseover="if('<%= section %>'!=='images')this.style.background='rgba(255,255,255,.07)'"
      onmouseout="if('<%= section %>'!=='images')this.style.background=''"
    >
      <span style="font-size:1.1rem">&#128247;</span> Images de profil
    </a>

    <a href="/admin/recompenses?section=charms" style="display:flex;align-items:center;gap:.6rem;padding:.5rem .75rem;border-radius:7px;text-decoration:none;font-size:.875rem;font-weight:600;transition:background .15s;<%= section==='charms' ? 'background:rgba(248,113,113,.18);color:#fca5a5' : 'color:#94a3b8' %>"
      onmouseover="if('<%= section %>'!=='charms')this.style.background='rgba(255,255,255,.07)'"
      onmouseout="if('<%= section %>'!=='charms')this.style.background=''"
    >
      <span style="font-size:1.1rem">&#10022;</span> Charmes
    </a>

    <div style="height:1px;background:rgba(255,255,255,.07);margin:.75rem .25rem"></div>
    <p style="font-size:.7rem;font-weight:700;color:#64748b;letter-spacing:.09em;text-transform:uppercase;margin:0 0 .6rem .5rem">Configuration</p>

    <a href="/admin/recompenses?section=config" style="display:flex;align-items:center;gap:.6rem;padding:.5rem .75rem;border-radius:7px;text-decoration:none;font-size:.875rem;font-weight:600;transition:background .15s;<%= section==='config' ? 'background:rgba(248,113,113,.18);color:#fca5a5' : 'color:#94a3b8' %>"
      onmouseover="if('<%= section %>'!=='config')this.style.background='rgba(255,255,255,.07)'"
      onmouseout="if('<%= section %>'!=='config')this.style.background=''"
    >
      <span style="font-size:1.1rem">&#9881;</span> Raretés
    </a>
  </nav>

  <%/* ── Main content ── */%>
  <main style="flex:1;padding:2rem;max-width:860px">

    <% if (section === 'images') { %>
    <%/* ── Images de profil ── */%>
    <h2 style="font-size:1rem;font-weight:700;color:#e2e8f0;margin:0 0 1.25rem;text-transform:uppercase;letter-spacing:.06em">Images de profil</h2>
    <p style="color:#94a3b8;font-size:.9rem;margin:0 0 1.5rem">Gérez les raretés de toutes les images pouvant être gagnées en lootbox.</p>
    <a href="/admin/recompenses/images-profil" style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(248,113,113,.15);border:1px solid rgba(248,113,113,.35);color:#fca5a5;padding:.55rem 1.25rem;border-radius:8px;text-decoration:none;font-size:.9rem;font-weight:600;transition:background .15s"
      onmouseover="this.style.background='rgba(248,113,113,.25)'"
      onmouseout="this.style.background='rgba(248,113,113,.15)'"
    >
      &#128247; Gérer les images de profil
    </a>
    <% } %>

    <% if (section === 'charms') { %>
    <%/* ── Charmes ── */%>
    <h2 style="font-size:1rem;font-weight:700;color:#e2e8f0;margin:0 0 1.25rem;text-transform:uppercase;letter-spacing:.06em">Charmes</h2>
    <p style="color:#94a3b8;font-size:.9rem;margin:0 0 1.5rem">Les charmes sont des icônes légendaires que les joueurs peuvent équiper à la place des étoiles.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:.75rem">
      <% charms.forEach(function(charm) { %>
      <%
        var rarityColor = charm.rarity === 'mythic' ? '#f87171' : charm.rarity === 'legendary' ? '#fbbf24' : charm.rarity === 'epic' ? '#a78bfa' : charm.rarity === 'rare' ? '#60a5fa' : '#94a3b8';
        var rarityLabel = charm.rarity === 'mythic' ? 'Mythique' : charm.rarity === 'legendary' ? 'Légendaire' : charm.rarity === 'epic' ? 'Épique' : charm.rarity === 'rare' ? 'Rare' : 'Commun';
      %>
      <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:1rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.5rem">
        <span style="font-size:2rem;line-height:1"><%= charm.symbol %></span>
        <strong style="color:#f1f5f9;font-size:.9rem"><%= charm.label %></strong>
        <span style="font-size:.72rem;font-weight:700;color:<%= rarityColor %>;background:rgba(0,0,0,.25);border:1px solid <%= rarityColor %>40;border-radius:4px;padding:.15rem .5rem;text-transform:uppercase;letter-spacing:.06em"><%= rarityLabel %></span>
        <code style="font-size:.7rem;color:#64748b;font-family:monospace"><%= charm.key %></code>
      </div>
      <% }); %>
    </div>

    <% if (!charms.length) { %>
    <p style="color:#64748b;font-style:italic">Aucun charme enregistré.</p>
    <% } %>
    <% } %>

    <% if (section === 'config') { %>
    <%/* ── Configuration raretés ── */%>
    <form method="POST" action="/admin/recompenses/config">
      <h2 style="font-size:1rem;font-weight:700;color:#e2e8f0;margin:0 0 1rem;text-transform:uppercase;letter-spacing:.06em">Configuration des raretés</h2>

      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:.88rem">
          <thead>
            <tr style="color:#94a3b8;text-align:left">
              <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08)">Rareté</th>
              <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08);text-align:center">% drop</th>
              <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08);text-align:center">Prix achat &#127481;</th>
              <th style="padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.08);text-align:center">Prix revente &#127481;</th>
            </tr>
          </thead>
          <tbody>
            <%
              var tiers = [
                { key: 'common',    label: 'Commun',     color: '#94a3b8' },
                { key: 'rare',      label: 'Rare',        color: '#60a5fa' },
                { key: 'epic',      label: 'Épique',      color: '#a78bfa' },
                { key: 'legendary', label: 'Légendaire',  color: '#fbbf24' },
                { key: 'mythic',    label: 'Mythique',    color: '#f87171' },
              ];
            %>
            <% tiers.forEach(function(tier) { %>
            <tr style="border-bottom:1px solid rgba(255,255,255,.05)">
              <td style="padding:.6rem .75rem">
                <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:<%= tier.color %>;margin-right:.5rem"></span>
                <strong style="color:<%= tier.color %>"><%= tier.label %></strong>
              </td>
              <td style="padding:.6rem .75rem;text-align:center">
                <input type="number" name="weight_<%= tier.key %>" value="<%= lootboxConfig.weights[tier.key] %>" min="0" max="100" step="1"
                  style="width:60px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:5px;color:#f1f5f9;padding:.3rem .5rem;text-align:center;font-size:.88rem">
              </td>
              <td style="padding:.6rem .75rem;text-align:center">
                <input type="number" name="buy_<%= tier.key %>" value="<%= lootboxConfig.buyPrices[tier.key] %>" min="0" step="1"
                  style="width:70px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:5px;color:#f1f5f9;padding:.3rem .5rem;text-align:center;font-size:.88rem">
              </td>
              <td style="padding:.6rem .75rem;text-align:center">
                <input type="number" name="sell_<%= tier.key %>" value="<%= lootboxConfig.sellPrices[tier.key] %>" min="0" step="1"
                  style="width:70px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:5px;color:#f1f5f9;padding:.3rem .5rem;text-align:center;font-size:.88rem">
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <p style="font-size:.78rem;color:#64748b;margin:.75rem 0 1rem">Les % de drop n'ont pas besoin de totaliser 100 — ils sont utilisés comme poids relatifs.</p>

      <button type="submit" style="background:#f87171;border:none;color:#fff;padding:.55rem 1.4rem;border-radius:7px;font-weight:600;font-size:.9rem;cursor:pointer;transition:background .15s"
        onmouseover="this.style.background='#ef4444'"
        onmouseout="this.style.background='#f87171'"
      >
        Enregistrer
      </button>
    </form>
    <% } %>

  </main>
</div>

<%- include('partials/foot') %>
