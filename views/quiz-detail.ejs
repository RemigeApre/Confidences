<%- include('partials/head', { title: quiz.title }) %>
<main class="container wide">
  <%- include('partials/top-nav', { config: config, navTitle: quiz.title, navBack: '/quizz' }) %>

  <% if (locals.completed && !stepData) { %>
    <%# ── Écran de fin ───────────────────────────────────────────────── %>
    <div class="quiz-done-wrap">
      <p class="quiz-done-thanks">Merci d&rsquo;avoir terminé <strong><%= quiz.title %></strong>&nbsp;!</p>
      <p class="quiz-done-hint">Pensez à faire les autres quizz disponibles.</p>
      <% if (locals.firstCompletion) { %>
        <p class="quiz-done-lootbox">&#127381; C&rsquo;est votre premi&egrave;re compl&eacute;tion&nbsp;&mdash; un coffre vous attend dans votre profil&nbsp;!</p>
      <% } %>
      <a href="/quizz" class="quiz-done-back">Voir les quizz</a>
    </div>

  <% } else if (!steps.length || !stepData) { %>
    <%# ── Quizz vide ─────────────────────────────────────────────────── %>
    <div class="quiz-detail-wrap">
      <h1 class="quiz-detail-title"><%= quiz.title %></h1>
      <% if (quiz.description) { %><p class="quiz-detail-desc"><%= quiz.description %></p><% } %>
      <p class="quiz-hub-empty">Ce quizz n'a pas encore de questions.</p>
    </div>

  <% } else { %>
    <%
      /* ── Helpers ──────────────────────────────────────────────────── */
      function toRoman(n) {
        var vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
        var syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
        var r = '';
        for (var i = 0; i < vals.length; i++) { while (n >= vals[i]) { r += syms[i]; n -= vals[i]; } }
        return r;
      }

      var GRAD_LEVELS_MAP = {
        'default': [
          { k: '1', l: 'Pas du tout',  col: 'hsl(0,72%,55%)'   },
          { k: '2', l: 'Un peu',       col: 'hsl(25,80%,55%)'  },
          { k: '3', l: 'Neutre',       col: 'hsl(50,78%,52%)'  },
          { k: '4', l: 'Beaucoup',     col: 'hsl(90,60%,48%)'  },
          { k: '5', l: 'Énormément',   col: 'hsl(140,55%,46%)' }
        ],
        'gout': [
          { k: '1', l: 'Déteste',   col: 'hsl(0,72%,55%)'   },
          { k: '2', l: 'Aime pas',  col: 'hsl(25,80%,55%)'  },
          { k: '3', l: 'Neutre',    col: 'hsl(50,78%,52%)'  },
          { k: '4', l: 'Aime',      col: 'hsl(90,60%,48%)'  },
          { k: '5', l: 'Adore',     col: 'hsl(140,55%,46%)' }
        ],
        'pratique': [
          { k: '1', l: 'Jamais',       col: 'hsl(0,72%,55%)'   },
          { k: '2', l: 'Une fois',     col: 'hsl(25,80%,55%)'  },
          { k: '3', l: 'Rarement',     col: 'hsl(50,78%,52%)'  },
          { k: '4', l: 'Occasionnel',  col: 'hsl(90,60%,48%)'  },
          { k: '5', l: 'Souvent',      col: 'hsl(140,55%,46%)' }
        ],
        'excitation': [
          { k: '1', l: 'Jamais pensé', col: 'hsl(0,72%,55%)'   },
          { k: '2', l: 'Non',          col: 'hsl(25,80%,55%)'  },
          { k: '3', l: 'À réfléchir',  col: 'hsl(50,78%,52%)'  },
          { k: '4', l: 'Excitant',     col: 'hsl(90,60%,48%)'  },
          { k: '5', l: 'Très excitant',col: 'hsl(140,55%,46%)' }
        ]
      };
      var GRAD_LEVELS = GRAD_LEVELS_MAP['default']; // fallback, overridden per question
      var isLastStep = stepIdx >= steps.length - 1;
    %>

    <%- include('partials/mobile-filter-toggle') %>

    <%# ─── VOLET GAUCHE : titre + frise chronologique verticale des étapes ─── %>
    <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
      <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer">&times;</button>
      <div class="wiki-chapter-hero">
        <div class="wiki-chapter-hero-top">
          <span></span>
          <h1 class="wiki-chapter-hero-title"><%= quiz.title %></h1>
          <span></span>
        </div>
      </div>
      <div class="wiki-sidebar-body">
        <% if (steps.length > 1) { %>
        <div class="quiz-timeline">
          <%
            var _progPartCounter = 0;
            steps.forEach(function(s, i) {
              var _progLabel;
              if (s.part) { _progPartCounter++; _progLabel = toRoman(_progPartCounter); }
              else { _progLabel = '·'; }
          %>
            <a href="/quizz/<%= quiz.id %>?step=<%= i %>"
              class="quiz-timeline-step<%= i === stepIdx ? ' quiz-timeline-step--active' : '' %><%= i < stepIdx ? ' quiz-timeline-step--done' : '' %>"
              title="<%= s.part ? s.part.title : quiz.title %>">
              <span class="quiz-timeline-dot"><%- i < stepIdx ? '&#10003;' : _progLabel %></span>
              <span class="quiz-timeline-label"><%= s.part ? s.part.title : quiz.title %></span>
            </a>
          <% }) %>
        </div>
        <% } %>
      </div>
    </aside>

    <%# ─── COLONNE PRINCIPALE : étape courante ────────────────────────────── %>
    <div class="quiz-detail-wrap">
      <%# ── En-tête étape : le titre de partie ("I - ...") est retiré ici,
          déjà donné par la frise du volet gauche — seule l'étape sans
          partie garde le titre du quizz + sa description. ────────────── %>
      <% if (!stepData.part) { %>
        <h1 class="quiz-detail-title"><%= quiz.title %></h1>
        <% if (quiz.description) { %><p class="quiz-detail-desc"><%= quiz.description %></p><% } %>
      <% } %>

      <%# ── Encart d'usage (collapsible, fermé en localStorage) ──────── %>
      <details class="quiz-usage-panel" id="quiz-usage-panel">
        <summary class="quiz-usage-summary">
          <span class="quiz-usage-title">Comment répondre&nbsp;?</span>
          <span class="quiz-usage-toggle-icon" aria-hidden="true">&#9660;</span>
        </summary>
        <div class="quiz-usage-body">
          <div class="quiz-usage-row">
            <span class="quiz-q-tendency quiz-q-tendency--positive" aria-hidden="true">&#9650;</span>
            <span><strong>Triangle vert</strong> : question positive : ce que vous aimez / fantasmez.</span>
          </div>
          <div class="quiz-usage-row">
            <span class="quiz-q-tendency quiz-q-tendency--negative" aria-hidden="true">&#9660;</span>
            <span><strong>Triangle rouge</strong> : question négative : ce que vous n'aimez pas.</span>
          </div>
          <div class="quiz-usage-row">
            <span class="quiz-usage-demo-btn quiz-usage-demo-btn--practiced" aria-hidden="true">&#10003;</span>
            <span><strong>Pratiqué</strong> : vous l&rsquo;avez déjà vécu dans la réalité.</span>
          </div>
          <div class="quiz-usage-row">
            <span class="quiz-usage-demo-btn quiz-usage-demo-btn--interested" aria-hidden="true">&#10024;</span>
            <span><strong>Intéressé</strong> : met cet élément en avant et permet de voir du contenu lié suggéré.</span>
          </div>
        </div>
      </details>

      <%# ── Questions de l'étape ──────────────────────────────────────── %>
      <% if (!currentUser) { %>
      <p class="quiz-anon-notice">Vos réponses sont sauvegardées sur cet appareil. <a href="/admin/login?next=/quizz/<%= quiz.id %>">Connectez-vous</a> pour les conserver dans votre profil.</p>
      <% } %>
      <form method="POST" action="/quizz/<%= quiz.id %>/answer" class="quiz-answer-form">
        <input type="hidden" name="_step" value="<%= stepIdx %>" />

        <% stepData.questions.forEach(function(q, qi) {
          var savedAns = answers[q.id];
          var hasSideAnswer = q.has_sides && savedAns && typeof savedAns === 'object' && savedAns.side;
          // null tant que la personne n'a pas choisi de perspective : les
          // réponses give/receive restent cachées et les 3 boutons de choix
          // affichés, plutôt qu'un "Les deux" par défaut qui montrait tout
          // de suite les deux jeux de réponses.
          var savedSide    = hasSideAnswer ? savedAns.side : null;
          var savedGive    = (q.has_sides && savedAns && typeof savedAns === 'object') ? savedAns.give    : savedAns;
          var savedReceive = (q.has_sides && savedAns && typeof savedAns === 'object') ? savedAns.receive : null;
          var qNum = qi + 1;
          // Croix "effacer ma réponse" : masquée tant qu'il n'y a rien à
          // effacer — pour une question Donner/Subir, dès que la perspective
          // est choisie ; sinon, dès qu'une vraie réponse existe déjà.
          var hasAnyAnswer = q.has_sides
            ? !!savedSide
            : (savedAns !== undefined && savedAns !== null && savedAns !== '' && !(Array.isArray(savedAns) && savedAns.length === 0));

          /* ── Render gradient bar ────────────────────────────────────── */
          function renderGradBar(name, savedVal, levels) {
            levels = levels || GRAD_LEVELS_MAP['default'];
            var initVal = parseInt(savedVal, 10) || 0;
            var initPct = initVal > 0 ? ((initVal - 1) / 4 * 100) : -1;
            var html = '<div class="quiz-grad-bar" data-name="' + name + '">';
            html += '<div class="quiz-grad-track"><div class="quiz-grad-fill" style="width:' + (initPct >= 0 ? (100 - initPct) : 100) + '%"></div></div>';
            html += '<div class="quiz-grad-jalons">';
            levels.forEach(function(lvl) {
              var active = initVal >= parseInt(lvl.k);
              html += '<label class="quiz-grad-jal' + (active ? ' quiz-grad-jal--active' : '') + '" style="--jcol:' + lvl.col + '">'
                + '<input type="radio" name="' + name + '" value="' + lvl.k + '"' + (savedVal == lvl.k ? ' checked' : '') + ' />'
                + '<span class="quiz-grad-jal-dot"></span>'
                + '<span class="quiz-grad-jal-lbl">' + lvl.l + '</span>'
                + '</label>';
            });
            html += '</div></div>';
            return html;
          }

          /* ── Render inputs (tous types, avec suffixe pour has_sides) ── */
          var qLevels = GRAD_LEVELS_MAP[q.subtype] || GRAD_LEVELS_MAP['default'];
          function renderInputs(suffix, savedVal) {
            var name = suffix ? 'q_' + q.id + '_' + suffix : 'q_' + q.id;
            var html = '';
            if (q.type === 'gradient') {
              html = renderGradBar(name, savedVal, qLevels);
            } else if (q.type === 'visual') {
              html += '<div class="quiz-visual-list">';
              q.options.forEach(function(opt, oi) {
                html += '<label class="quiz-visual-opt' + (String(savedVal) == String(oi) ? ' quiz-visual-opt--checked' : '') + '">'
                  + '<input type="radio" name="' + name + '" value="' + oi + '"' + (String(savedVal) == String(oi) ? ' checked' : '') + ' />'
                  + '<span>' + opt + '</span></label>';
              });
              html += '</div>';
            } else if (q.type === 'points') {
              var total = parseInt(q.subtype, 10) || 10;
              var savedObj = (savedVal && typeof savedVal === 'object') ? savedVal : {};
              var suffix2 = suffix ? '-' + suffix : '';
              html += '<p class="quiz-points-total">Répartir <span class="quiz-points-remaining" id="qpoints-remaining-' + q.id + suffix2 + '">' + total + '</span> / ' + total + ' points</p>';
              html += '<div class="quiz-points-list">';
              q.options.forEach(function(opt, oi) {
                var v = parseInt(savedObj[String(oi)], 10) || 0;
                html += '<div class="quiz-points-row">'
                  + '<span class="quiz-points-label">' + opt + '</span>'
                  + '<div class="quiz-points-controls">'
                  + '<button type="button" class="quiz-points-btn quiz-points-dec" data-qid="' + q.id + '" data-oi="' + oi + '" data-total="' + total + '" data-suffix="' + (suffix || '') + '">&#8722;</button>'
                  + '<span class="quiz-points-val" id="qpval-' + q.id + '-' + oi + suffix2 + '">' + v + '</span>'
                  + '<button type="button" class="quiz-points-btn quiz-points-inc" data-qid="' + q.id + '" data-oi="' + oi + '" data-total="' + total + '" data-suffix="' + (suffix || '') + '">+</button>'
                  + '<input type="hidden" name="' + name + '_' + oi + '" id="qpinp-' + q.id + '-' + oi + suffix2 + '" value="' + v + '" />'
                  + '</div></div>';
              });
              html += '</div>';
            } else if (q.type === 'single') {
              html += '<div class="quiz-choice-list">';
              q.options.forEach(function(opt, oi) {
                html += '<label class="quiz-choice-opt"><input type="radio" name="' + name + '" value="' + oi + '"'
                  + (String(savedVal) == String(oi) ? ' checked' : '') + ' /><span>' + opt + '</span></label>';
              });
              html += '</div>';
            } else if (q.type === 'multiple') {
              html += '<div class="quiz-choice-list">';
              q.options.forEach(function(opt, oi) {
                var checked = Array.isArray(savedVal) && savedVal.indexOf(String(oi)) !== -1;
                html += '<label class="quiz-choice-opt"><input type="checkbox" name="' + name + '_' + oi + '" value="' + oi + '"'
                  + (checked ? ' checked' : '') + ' /><span>' + opt + '</span></label>';
              });
              html += '</div>';
            } else if (q.type === 'ranking') {
              var rankOrder = (Array.isArray(savedVal) && savedVal.length)
                ? savedVal.map(Number) : q.options.map(function(_, i){ return i; });
              var rankKey = suffix ? q.id + '-' + suffix : q.id;
              html += '<div class="quiz-rank-list" id="qrank-' + rankKey + '">';
              rankOrder.forEach(function(idx) {
                if (!q.options[idx]) return;
                html += '<div class="quiz-rank-item" draggable="true" data-idx="' + idx + '">'
                  + '<span class="quiz-rank-handle">&#11835;</span><span class="quiz-rank-label">' + q.options[idx] + '</span></div>';
              });
              html += '</div>';
              html += '<input type="hidden" name="' + name + '_rank" id="qrank-input-' + rankKey + '" value="' + rankOrder.join(',') + '" />';
            }
            return html;
          }
        %>

          <div class="quiz-q-block" id="qblock-<%= q.id %>" data-qid="<%= q.id %>" data-qtype="<%= q.type %>">
            <div class="quiz-q-header">
              <span class="quiz-q-num"><%= qNum %></span>
              <p class="quiz-q-text"><%= q.text %></p>
              <% if (q.tendency === 'positive') { %><span class="quiz-q-tendency quiz-q-tendency--positive" title="Tendance positive (aimer)">&#9650;</span><% } %>
              <% if (q.tendency === 'negative') { %><span class="quiz-q-tendency quiz-q-tendency--negative" title="Tendance négative (ne pas aimer)">&#9660;</span><% } %>
              <% if (q.wiki_link_id) { %><a href="/wiki/<%= q.wiki_link_id %>" target="_blank" rel="noopener" class="quiz-q-wiki-btn" title="Voir la page Codex">&#63;</a><% } %>
              <%# Croix unique pour effacer la réponse — sur la même ligne
                  que la question, juste derrière — jamais dupliquée avec un
                  bouton "changer de perspective". ── %>
              <button type="button" class="quiz-sides-reset<%= hasAnyAnswer ? '' : ' quiz-sides-reset--hidden' %>" id="qclear-<%= q.id %>" data-qid="<%= q.id %>" title="Effacer ma r&eacute;ponse" aria-label="Effacer ma r&eacute;ponse">&times;</button>
            </div>

            <% if (q.has_sides) { %>
              <div class="quiz-sides-picker<%= savedSide ? ' quiz-sides-picker--hidden' : '' %>" id="qsidespicker-<%= q.id %>">
                <button type="button" class="quiz-sides-btn" data-qid="<%= q.id %>" data-side="give">Donner</button>
                <button type="button" class="quiz-sides-btn quiz-sides-btn--both" data-qid="<%= q.id %>" data-side="both">Les deux</button>
                <button type="button" class="quiz-sides-btn" data-qid="<%= q.id %>" data-side="receive">Recevoir</button>
                <button type="button" class="quiz-sides-btn quiz-sides-btn--observe" data-qid="<%= q.id %>" data-side="observe">Observer</button>
              </div>
              <input type="hidden" name="q_<%= q.id %>_side" id="qside-input-<%= q.id %>" value="<%= savedSide || '' %>" />
            <% } %>

            <% if (!q.has_sides) { %>
              <%- renderInputs(null, savedAns) %>
            <% } else { %>
              <div class="quiz-side-row quiz-side-row--give<%= (!savedSide || savedSide === 'receive' || savedSide === 'observe') ? ' quiz-side-row--hidden' : '' %>" id="qside-give-<%= q.id %>">
                <span class="quiz-side-label">Donner</span>
                <%- renderInputs('give', savedGive) %>
              </div>
              <div class="quiz-side-row quiz-side-row--receive<%= (!savedSide || savedSide === 'give' || savedSide === 'observe') ? ' quiz-side-row--hidden' : '' %>" id="qside-receive-<%= q.id %>">
                <span class="quiz-side-label">Recevoir</span>
                <%- renderInputs('receive', savedReceive) %>
              </div>
            <% } %>

            <%# ── Je ne sais pas ────────────────────────────────────────── %>
            <button type="button"
              class="quiz-dont-know-btn<%= savedAns === '?' ? ' quiz-dont-know-btn--active' : '' %>"
              id="qdontknow-<%= q.id %>" data-qid="<%= q.id %>">
              ? Je ne sais pas
            </button>
            <% if (savedAns === '?') { %>
            <input type="hidden" name="q_<%= q.id %>" id="qdontknow-input-<%= q.id %>" value="?" />
            <% } %>

            <%# ── Boutons Pratiqué / Intéressé ─────────────────────────── %>
            <% if (q.type !== 'ranking' && q.type !== 'points') { %>
            <div class="quiz-q-flags">
              <button type="button"
                class="quiz-flag-btn quiz-flag-btn--practiced<%= (flags && flags.practiced && flags.practiced[q.id]) ? ' quiz-flag-btn--on' : '' %>"
                data-qid="<%= q.id %>" data-flag="practiced"
                title="Marquer comme déjà pratiqué">
                <span class="quiz-flag-icon">&#10003;</span> Pratiqué
              </button>
              <button type="button"
                class="quiz-flag-btn quiz-flag-btn--interested<%= (flags && flags.interested && flags.interested[q.id]) ? ' quiz-flag-btn--on' : '' %>"
                data-qid="<%= q.id %>" data-flag="interested"
                title="Marquer comme intéressant">
                <span class="quiz-flag-icon">&#10024;</span> Intéressé
              </button>
            </div>
            <% } %>
          </div>

        <% }) %>

        <div class="quiz-step-actions">
          <% if (stepIdx > 0) { %>
            <a href="/quizz/<%= quiz.id %>?step=<%= stepIdx - 1 %>" class="quiz-step-prev">&#8592; Précédent</a>
          <% } %>
          <% if (isLastStep) { %>
            <button type="submit" name="complete" value="1" class="wf-save-btn" style="position:static">Terminer le quizz</button>
          <% } else { %>
            <button type="submit" name="complete" value="0" class="quiz-step-next">Suivant &#8594;</button>
          <% } %>
        </div>
      </form>
    </div>
  <% } %>

  <% if (currentUser && currentUser.isAdmin) { %>
    <a href="/quizz/<%= quiz.id %>/edit" class="quiz-admin-edit-fab" title="Modifier le quizz">&#9998;</a>
  <% } %>

  <script>
  (function() {
    /* ── Croix "effacer ma réponse" : une seule par question, centrée sous
       la réponse — n'apparaît qu'une fois qu'il y a vraiment quelque chose à
       effacer (voir hasAnyAnswer côté serveur pour l'état initial). ────── */
    function revealClearBtn(qid) {
      var btn = document.getElementById('qclear-' + qid);
      if (btn) btn.classList.remove('quiz-sides-reset--hidden');
    }

    /* ── localStorage pour les visiteurs sans compte ───────────────────── */
    var isLoggedIn = <%- currentUser ? 'true' : 'false' %>;
    var LS_KEY = 'qz_<%= quiz.id %>';
    function lsLoad() { try { return JSON.parse(localStorage.getItem(LS_KEY) || '{}'); } catch(e) { return {}; } }
    function lsSave(d) { try { localStorage.setItem(LS_KEY, JSON.stringify(d)); } catch(e) {} }

    // Lit la valeur courante d'une question depuis le DOM (format identique à la BDD)
    function collectInputVal(block, name, qtype) {
      if (qtype === 'gradient' || qtype === 'single' || qtype === 'visual') {
        var r = block.querySelector('input[name="' + name + '"]:checked');
        return r ? r.value : undefined;
      }
      if (qtype === 'multiple') {
        var vals = [];
        block.querySelectorAll('input[type="checkbox"]').forEach(function(cb) {
          if (cb.name.indexOf(name + '_') === 0 && cb.checked) vals.push(cb.value);
        });
        return vals;
      }
      if (qtype === 'ranking') {
        var hidden = document.getElementById('qrank-input-' + name.replace(/^q_/, ''));
        return hidden ? hidden.value.split(',').filter(Boolean).map(Number) : [];
      }
      if (qtype === 'points') {
        var pts = {};
        block.querySelectorAll('input[id^="qpinp-"]').forEach(function(el) {
          if (el.name && el.name.indexOf(name + '_') === 0) {
            pts[el.name.slice(name.length + 1)] = parseInt(el.value, 10) || 0;
          }
        });
        return pts;
      }
      return undefined;
    }
    function collectQAnswer(qid, qtype, hasSides) {
      var block = document.getElementById('qblock-' + qid);
      if (!block) return undefined;
      var dkInput = document.getElementById('qdontknow-input-' + qid);
      if (dkInput && dkInput.value === '?') return '?';
      if (hasSides) {
        var sideInput = document.getElementById('qside-input-' + qid);
        var side = sideInput ? sideInput.value : '';
        if (!side) return undefined;
        var obj = { side: side };
        if (side !== 'receive' && side !== 'observe') obj.give = collectInputVal(block, 'q_' + qid + '_give', qtype);
        if (side !== 'give'    && side !== 'observe') obj.receive = collectInputVal(block, 'q_' + qid + '_receive', qtype);
        return obj;
      }
      return collectInputVal(block, 'q_' + qid, qtype);
    }

    // Applique une valeur stockée aux inputs du DOM
    function applyInputs(block, name, qtype, value) {
      if (value === undefined || value === null) return;
      if (qtype === 'gradient' || qtype === 'single' || qtype === 'visual') {
        var inp = block.querySelector('input[name="' + name + '"][value="' + value + '"]');
        if (inp) { inp.checked = true; inp.dispatchEvent(new Event('change', { bubbles: true })); }
      } else if (qtype === 'multiple') {
        if (!Array.isArray(value)) return;
        value.forEach(function(v) {
          var cb = block.querySelector('input[name="' + name + '_' + v + '"]');
          if (cb) cb.checked = true;
        });
      } else if (qtype === 'ranking') {
        var listKey = name.replace(/^q_/, '');
        var list = document.getElementById('qrank-' + listKey);
        var hidden = document.getElementById('qrank-input-' + listKey);
        if (list && Array.isArray(value)) {
          value.forEach(function(idx) {
            var item = list.querySelector('[data-idx="' + idx + '"]');
            if (item) list.appendChild(item);
          });
          if (hidden) hidden.value = value.join(',');
        }
      } else if (qtype === 'points' && value && typeof value === 'object') {
        var qidPart = name.replace(/^q_/, '').replace(/_give$/, '').replace(/_receive$/, '');
        var sfx = /_give$/.test(name) ? '-give' : /_receive$/.test(name) ? '-receive' : '';
        Object.keys(value).forEach(function(oi) {
          var inpEl = document.getElementById('qpinp-' + qidPart + '-' + oi + sfx);
          var valEl = document.getElementById('qpval-' + qidPart + '-' + oi + sfx);
          var v = parseInt(value[oi], 10) || 0;
          if (inpEl) inpEl.value = v;
          if (valEl) valEl.textContent = v;
        });
      }
    }
    function restoreAnonymousAnswers() {
      var stored = lsLoad();
      if (!Object.keys(stored).length) return;
      document.querySelectorAll('.quiz-q-block').forEach(function(block) {
        var qid = block.dataset.qid;
        var qtype = block.dataset.qtype;
        var hasSides = !!document.getElementById('qsidespicker-' + qid);
        var value = stored[String(qid)];
        if (value === undefined) return;
        if (value === '?') {
          var dkBtn = document.getElementById('qdontknow-' + qid);
          if (dkBtn && !dkBtn.classList.contains('quiz-dont-know-btn--active')) dkBtn.click();
          return;
        }
        if (hasSides && value && typeof value === 'object' && value.side) {
          selectSide(qid, value.side);
          if (value.give !== undefined)    applyInputs(block, 'q_' + qid + '_give',    qtype, value.give);
          if (value.receive !== undefined) applyInputs(block, 'q_' + qid + '_receive', qtype, value.receive);
          revealClearBtn(qid);
          return;
        }
        applyInputs(block, 'q_' + qid, qtype, value);
        revealClearBtn(qid);
      });
    }

    /* ── Sauvegarde auto, dès qu'une question a une réponse — sinon une
       réponse n'était écrite en base qu'en cliquant "Suivant"/"Terminer",
       et se perdait si la personne devait s'arrêter avant. ────────────── */
    var autosaveTimers = {};
    function autosaveQuestion(qid) {
      clearTimeout(autosaveTimers[qid]);
      autosaveTimers[qid] = setTimeout(function() {
        var block = document.getElementById('qblock-' + qid);
        if (!block) return;
        if (!isLoggedIn) {
          var val = collectQAnswer(qid, block.dataset.qtype, !!document.getElementById('qsidespicker-' + qid));
          if (val !== undefined) { var s = lsLoad(); s[String(qid)] = val; lsSave(s); }
          return;
        }
        var re = new RegExp('^q_' + qid + '(_|$)');
        var params = new URLSearchParams();
        block.querySelectorAll('input[name]').forEach(function(el) {
          if (!re.test(el.name)) return;
          if ((el.type === 'radio' || el.type === 'checkbox') && !el.checked) return;
          params.append(el.name, el.value);
        });
        fetch('/quizz/<%= quiz.id %>/questions/' + qid + '/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params.toString()
        }).catch(function() {});
      }, 250);
    }

    var quizAnswerForm = document.querySelector('.quiz-answer-form');
    if (quizAnswerForm) {
      quizAnswerForm.addEventListener('change', function(e) {
        if (!e.target.matches('input[type="radio"], input[type="checkbox"]')) return;
        var block = e.target.closest('.quiz-q-block');
        if (block) {
          var qid = block.dataset.qid;
          // Clear "je ne sais pas" if active
          var dkBtn = document.getElementById('qdontknow-' + qid);
          if (dkBtn && dkBtn.classList.contains('quiz-dont-know-btn--active')) {
            dkBtn.classList.remove('quiz-dont-know-btn--active');
            var dkInput = document.getElementById('qdontknow-input-' + qid);
            if (dkInput) dkInput.remove();
          }
          revealClearBtn(qid);
          autosaveQuestion(qid);
        }
      });
    }

    /* ── Gradient bar ────────────────────────────────────────────────────── */
    document.querySelectorAll('.quiz-grad-bar').forEach(function(bar) {
      var fill    = bar.querySelector('.quiz-grad-fill');
      var jalons  = bar.querySelectorAll('.quiz-grad-jal');
      var radios  = bar.querySelectorAll('input[type="radio"]');

      function setVal(val) {
        var pct = val > 0 ? ((val - 1) / 4 * 100) : -1;
        fill.style.width = (pct >= 0 ? (100 - pct) : 100) + '%';
        jalons.forEach(function(jal, i) {
          jal.classList.toggle('quiz-grad-jal--active', (i + 1) <= val);
        });
      }

      radios.forEach(function(r) {
        r.addEventListener('change', function() { setVal(parseInt(r.value, 10)); });
      });
    });

    /* ── Ranking drag & drop ─────────────────────────────────────────────── */
    document.querySelectorAll('.quiz-rank-list').forEach(function(list) {
      var key     = list.id.replace('qrank-', '');
      var rankQid = key.split('-')[0];
      var hidden  = document.getElementById('qrank-input-' + key);
      var dragging = null, indicator = null;
      function getInd() {
        if (!indicator) { indicator = document.createElement('div'); indicator.className = 'qe-drop-indicator'; }
        return indicator;
      }
      function updateHidden() {
        if (hidden) hidden.value = Array.from(list.querySelectorAll('.quiz-rank-item')).map(function(el) { return el.dataset.idx; }).join(',');
      }
      function afterEl(y) {
        return Array.from(list.querySelectorAll('.quiz-rank-item:not(.qe-q-dragging)')).reduce(function(c, el) {
          var b = el.getBoundingClientRect(), off = y - b.top - b.height / 2;
          return (off < 0 && off > c.off) ? { off: off, el: el } : c;
        }, { off: -Infinity, el: null }).el;
      }
      list.querySelectorAll('.quiz-rank-item').forEach(function(item) {
        item.addEventListener('dragstart', function(e) { dragging = item; item.classList.add('qe-q-dragging'); e.dataTransfer.effectAllowed = 'move'; });
        item.addEventListener('dragend',   function()  { item.classList.remove('qe-q-dragging'); if (indicator && indicator.parentNode) indicator.remove(); dragging = null; updateHidden(); revealClearBtn(rankQid); autosaveQuestion(rankQid); });
      });
      list.addEventListener('dragover', function(e) { e.preventDefault(); var after = afterEl(e.clientY), ind = getInd(); if (!after) list.appendChild(ind); else list.insertBefore(ind, after); });
      list.addEventListener('drop',     function(e) { e.preventDefault(); if (indicator && indicator.parentNode) indicator.remove(); if (!dragging) return; var after = afterEl(e.clientY); if (!after) list.appendChild(dragging); else list.insertBefore(dragging, after); updateHidden(); });
    });

    /* ── Donner / Subir : 3 boutons, la croix du bas fait tout le reste ──── */
    function selectSide(qid, side) {
      var hiddenSide = document.getElementById('qside-input-' + qid);
      var giveRow    = document.getElementById('qside-give-' + qid);
      var receiveRow = document.getElementById('qside-receive-' + qid);
      var picker     = document.getElementById('qsidespicker-' + qid);
      if (hiddenSide) hiddenSide.value = side;
      if (giveRow)    giveRow.classList.toggle('quiz-side-row--hidden',    side === 'receive' || side === 'observe');
      if (receiveRow) receiveRow.classList.toggle('quiz-side-row--hidden', side === 'give'    || side === 'observe');
      if (picker)     picker.classList.add('quiz-sides-picker--hidden');
      revealClearBtn(qid);
    }
    // Ramène juste le sélecteur de perspective à son état initial (utilisé
    // par la croix unique ci-dessous) — ne touche pas au serveur, voir
    // resetQuestionBlock pour l'effacement complet.
    function resetSide(qid) {
      var hiddenSide = document.getElementById('qside-input-' + qid);
      var giveRow    = document.getElementById('qside-give-' + qid);
      var receiveRow = document.getElementById('qside-receive-' + qid);
      var picker     = document.getElementById('qsidespicker-' + qid);
      if (hiddenSide) hiddenSide.value = '';
      if (giveRow)    giveRow.classList.add('quiz-side-row--hidden');
      if (receiveRow) receiveRow.classList.add('quiz-side-row--hidden');
      if (picker)     picker.classList.remove('quiz-sides-picker--hidden');
    }
    document.querySelectorAll('.quiz-sides-btn').forEach(function(btn) {
      btn.addEventListener('click', function() { selectSide(btn.dataset.qid, btn.dataset.side); });
    });

    /* ── Encart d'usage : mémorise l'état ouvert/fermé ─────────────────────── */
    (function () {
      var panel = document.getElementById('quiz-usage-panel');
      if (!panel) return;
      var KEY = 'quiz-usage-open';
      // Par défaut ouvert la première fois, fermé si l'utilisateur l'a déjà refermé
      var stored = localStorage.getItem(KEY);
      panel.open = stored !== '0';
      panel.addEventListener('toggle', function () {
        try { localStorage.setItem(KEY, panel.open ? '1' : '0'); } catch (_) {}
      });
    })();

    /* ── Boutons Pratiqué / Intéressé ───────────────────────────────────────── */
    document.querySelectorAll('.quiz-flag-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var qid  = btn.dataset.qid;
        var flag = btn.dataset.flag;
        var isOn = btn.classList.contains('quiz-flag-btn--on');
        var newVal = isOn ? 0 : 1;

        // Mise à jour optimiste immédiate
        btn.classList.toggle('quiz-flag-btn--on', !!newVal);
        btn.disabled = true;

        fetch('/quizz/<%= quiz.id %>/questions/' + qid + '/flag', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ flag: flag, value: newVal })
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d.ok) {
              // Annuler l'optimiste si erreur serveur
              btn.classList.toggle('quiz-flag-btn--on', isOn);
            }
          })
          .catch(function () {
            btn.classList.toggle('quiz-flag-btn--on', isOn);
          })
          .finally(function () { btn.disabled = false; });
      });
    });

    /* ── Effacer ma réponse (croix rouge unique, centrée) ─────────────────── */
    function resetQuestionBlock(qid) {
      var block = document.getElementById('qblock-' + qid);
      if (!block) return;
      block.querySelectorAll('input[type="radio"], input[type="checkbox"]').forEach(function(el) { el.checked = false; });
      block.querySelectorAll('.quiz-grad-bar').forEach(function(bar) {
        var fill = bar.querySelector('.quiz-grad-fill');
        if (fill) { fill.style.width = '100%'; }
        bar.querySelectorAll('.quiz-grad-jal').forEach(function(jal) { jal.classList.remove('quiz-grad-jal--active'); });
      });
      block.querySelectorAll('.quiz-rank-list').forEach(function(list) {
        var items = Array.from(list.querySelectorAll('.quiz-rank-item'));
        items.sort(function(a, b) { return Number(a.dataset.idx) - Number(b.dataset.idx); });
        items.forEach(function(item) { list.appendChild(item); });
        var hidden = document.getElementById('qrank-input-' + list.id.replace('qrank-', ''));
        if (hidden) hidden.value = items.map(function(el) { return el.dataset.idx; }).join(',');
      });
      if (document.getElementById('qsidespicker-' + qid)) resetSide(qid);
      var clearBtn = document.getElementById('qclear-' + qid);
      if (clearBtn) clearBtn.classList.add('quiz-sides-reset--hidden');
      // Clear "je ne sais pas"
      var dkBtn = document.getElementById('qdontknow-' + qid);
      if (dkBtn) dkBtn.classList.remove('quiz-dont-know-btn--active');
      var dkInput = document.getElementById('qdontknow-input-' + qid);
      if (dkInput) dkInput.remove();
      // Reset points distribution
      block.querySelectorAll('.quiz-points-val').forEach(function(el) { el.textContent = '0'; });
      block.querySelectorAll('input[id^="qpinp-"]').forEach(function(el) { el.value = '0'; });
      block.querySelectorAll('.quiz-points-remaining').forEach(function(el) {
        var total = parseInt(el.closest('.quiz-points-total') && el.closest('[data-qtype]') ? 0 : 0, 10);
        // Just reset display; autosave will handle actual values
      });
      // Reset visual choice checked state
      block.querySelectorAll('.quiz-visual-opt').forEach(function(opt) { opt.classList.remove('quiz-visual-opt--checked'); });
    }
    document.querySelectorAll('.quiz-sides-reset').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var qid = btn.dataset.qid;
        clearTimeout(autosaveTimers[qid]);
        if (!isLoggedIn) {
          var s = lsLoad(); delete s[String(qid)]; lsSave(s);
          resetQuestionBlock(qid);
          return;
        }
        fetch('/quizz/<%= quiz.id %>/questions/' + qid + '/clear-answer', { method: 'POST' })
          .then(function() { resetQuestionBlock(qid); })
          .catch(function() {});
      });
    });

    /* ── Visual choice: toggle checked class ─────────────────────────────── */
    document.querySelectorAll('.quiz-visual-opt input[type="radio"]').forEach(function(inp) {
      inp.addEventListener('change', function() {
        var list = inp.closest('.quiz-visual-list');
        if (list) {
          list.querySelectorAll('.quiz-visual-opt').forEach(function(opt) {
            opt.classList.toggle('quiz-visual-opt--checked', opt.querySelector('input') === inp);
          });
        }
      });
    });

    /* ── Points distribution: +/- buttons ───────────────────────────────── */
    document.querySelectorAll('.quiz-points-list').forEach(function(list) {
      var block = list.closest('.quiz-q-block');
      var qid = block ? block.dataset.qid : null;
      function getTotal(btn) { return parseInt(btn.dataset.total, 10) || 10; }
      function getSuffix(btn) { return btn.dataset.suffix ? '-' + btn.dataset.suffix : ''; }
      function calcUsed(qidVal, sfx) {
        var used = 0;
        list.querySelectorAll('.quiz-points-val').forEach(function(el) { used += parseInt(el.textContent, 10) || 0; });
        return used;
      }
      function updateRemaining(qidVal, sfx, total) {
        var remainEl = document.getElementById('qpoints-remaining-' + qidVal + sfx);
        if (remainEl) remainEl.textContent = total - calcUsed(qidVal, sfx);
      }
      list.querySelectorAll('.quiz-points-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var total = getTotal(btn);
          var sfx = getSuffix(btn);
          var oi = btn.dataset.oi;
          var valEl = document.getElementById('qpval-' + btn.dataset.qid + '-' + oi + sfx);
          var inpEl = document.getElementById('qpinp-' + btn.dataset.qid + '-' + oi + sfx);
          if (!valEl || !inpEl) return;
          var cur = parseInt(valEl.textContent, 10) || 0;
          var used = calcUsed(btn.dataset.qid, sfx);
          var newVal;
          if (btn.classList.contains('quiz-points-inc')) {
            if (used >= total) return;
            newVal = cur + 1;
          } else {
            if (cur <= 0) return;
            newVal = cur - 1;
          }
          valEl.textContent = newVal;
          inpEl.value = newVal;
          updateRemaining(btn.dataset.qid, sfx, total);
          if (qid) { revealClearBtn(qid); autosaveQuestion(qid); }
        });
      });
    });

    /* ── Je ne sais pas ─────────────────────────────────────────────────── */
    document.querySelectorAll('.quiz-dont-know-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var qid = btn.dataset.qid;
        var block = document.getElementById('qblock-' + qid);
        var isActive = btn.classList.contains('quiz-dont-know-btn--active');
        if (isActive) {
          btn.classList.remove('quiz-dont-know-btn--active');
          var dkInput = document.getElementById('qdontknow-input-' + qid);
          if (dkInput) dkInput.remove();
          autosaveQuestion(qid);
        } else {
          btn.classList.add('quiz-dont-know-btn--active');
          block.querySelectorAll('input[type="radio"], input[type="checkbox"]').forEach(function(inp) {
            inp.checked = false;
          });
          var existing = document.getElementById('qdontknow-input-' + qid);
          if (!existing) {
            existing = document.createElement('input');
            existing.type = 'hidden';
            existing.name = 'q_' + qid;
            existing.id = 'qdontknow-input-' + qid;
            block.appendChild(existing);
          }
          existing.value = '?';
          revealClearBtn(qid);
          autosaveQuestion(qid);
        }
      });
    });

    /* ── Anonyme : restauration localStorage + intercepteur de navigation ─ */
    if (!isLoggedIn) {
      restoreAnonymousAnswers();
      if (quizAnswerForm) {
        quizAnswerForm.addEventListener('submit', function(e) {
          e.preventDefault();
          // Sauvegarder toutes les réponses visibles avant de naviguer
          var stored = lsLoad();
          document.querySelectorAll('.quiz-q-block').forEach(function(block) {
            var qid = block.dataset.qid;
            var val = collectQAnswer(qid, block.dataset.qtype, !!document.getElementById('qsidespicker-' + qid));
            if (val !== undefined) stored[String(qid)] = val;
          });
          lsSave(stored);
          var totalSteps = <%= steps.length %>;
          var stepInput  = quizAnswerForm.querySelector('[name="_step"]');
          var step       = stepInput ? parseInt(stepInput.value, 10) : 0;
          var isComplete = e.submitter ? e.submitter.value === '1' : false;
          if (isComplete || step >= totalSteps - 1) {
            window.location.href = '/quizz/<%= quiz.id %>?step=done';
          } else {
            window.location.href = '/quizz/<%= quiz.id %>?step=' + (step + 1);
          }
        });
      }
    }
  })();
  </script>
</main>
<%- include('partials/foot') %>
