<%- include('partials/head', { title: quiz.title }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config, navTitle: 'Quizz', navBack: '/quizz' }) %>

  <a href="/quizz" class="wf-back-btn">← Retour</a>

  <div class="quiz-detail-wrap">
    <h1 class="quiz-detail-title"><%= quiz.title %></h1>
    <% if (quiz.description) { %><p class="quiz-detail-desc"><%= quiz.description %></p><% } %>
    <% if (completed) { %><p class="quiz-detail-done-badge">✓ Complété</p><% } %>

    <% if (!questions.length) { %>
      <p class="quiz-hub-empty">Ce quizz n'a pas encore de questions.</p>
    <% } else { %>
    <form method="POST" action="/quizz/<%= quiz.id %>/answer" class="quiz-answer-form">

      <%
        // Grouper les questions par partie
        var GRAD_LEVELS = [
          {k:'1',l:'Pas du tout'},
          {k:'2',l:'Un peu'},
          {k:'3',l:'Neutre'},
          {k:'4',l:'Beaucoup'},
          {k:'5',l:'Énormément'}
        ];

        // Questions sans partie d'abord (part_id null), puis par partie dans l'ordre
        var partIds = [];
        questions.forEach(function(q) {
          if (q.part_id && partIds.indexOf(q.part_id) === -1) partIds.push(q.part_id);
        });

        var unassigned = questions.filter(function(q) { return !q.part_id; });
        var qIndex = 0;

        function renderQuestion(q) { /* handled inline below */ }
      %>

      <% if (unassigned.length) { %>
        <% unassigned.forEach(function(q) { qIndex++; %>
          <div class="quiz-q-block">
            <p class="quiz-q-text"><span class="quiz-q-num"><%= qIndex %></span><%= q.text %></p>
            <% if (q.type === 'gradient') { %>
              <div class="quiz-gradient-row">
                <% GRAD_LEVELS.forEach(function(lvl) { %>
                  <label class="quiz-grad-opt">
                    <input type="radio" name="q_<%= q.id %>" value="<%= lvl.k %>" <%= (answers[q.id] == lvl.k) ? 'checked' : '' %> />
                    <span class="quiz-grad-label"><%= lvl.l %></span>
                  </label>
                <% }) %>
              </div>
            <% } else if (q.type === 'single') { %>
              <div class="quiz-choice-list">
                <% q.options.forEach(function(opt, oi) { %>
                  <label class="quiz-choice-opt">
                    <input type="radio" name="q_<%= q.id %>" value="<%= oi %>" <%= (String(answers[q.id]) == String(oi)) ? 'checked' : '' %> />
                    <span><%= opt %></span>
                  </label>
                <% }) %>
              </div>
            <% } else if (q.type === 'multiple') { %>
              <div class="quiz-choice-list">
                <% q.options.forEach(function(opt, oi) { %>
                  <label class="quiz-choice-opt">
                    <input type="checkbox" name="q_<%= q.id %>_<%= oi %>" value="<%= oi %>"
                      <%= (Array.isArray(answers[q.id]) && answers[q.id].indexOf(String(oi)) !== -1) ? 'checked' : '' %> />
                    <span><%= opt %></span>
                  </label>
                <% }) %>
              </div>
            <% } else if (q.type === 'ranking') { %>
              <%
                var rankOrder = (Array.isArray(answers[q.id]) && answers[q.id].length)
                  ? answers[q.id].map(Number)
                  : q.options.map(function(_, i){ return i; });
              %>
              <div class="quiz-rank-list" id="qrank-<%= q.id %>">
                <% rankOrder.forEach(function(idx) { if (!q.options[idx]) return; %>
                  <div class="quiz-rank-item" draggable="true" data-idx="<%= idx %>">
                    <span class="quiz-rank-handle">&#11835;</span>
                    <span class="quiz-rank-label"><%= q.options[idx] %></span>
                  </div>
                <% }) %>
              </div>
              <input type="hidden" name="q_<%= q.id %>_rank"
                id="qrank-input-<%= q.id %>" value="<%= rankOrder.join(',') %>" />
            <% } %>
          </div>
        <% }) %>
      <% } %>

      <% parts.forEach(function(part) {
        var partQs = questions.filter(function(q) { return q.part_id === part.id; });
        if (!partQs.length) return;
      %>
        <h2 class="quiz-part-heading"><%= part.title %></h2>
        <% partQs.forEach(function(q) { qIndex++; %>
          <div class="quiz-q-block">
            <p class="quiz-q-text"><span class="quiz-q-num"><%= qIndex %></span><%= q.text %></p>
            <% if (q.type === 'gradient') { %>
              <div class="quiz-gradient-row">
                <% GRAD_LEVELS.forEach(function(lvl) { %>
                  <label class="quiz-grad-opt">
                    <input type="radio" name="q_<%= q.id %>" value="<%= lvl.k %>" <%= (answers[q.id] == lvl.k) ? 'checked' : '' %> />
                    <span class="quiz-grad-label"><%= lvl.l %></span>
                  </label>
                <% }) %>
              </div>
            <% } else if (q.type === 'single') { %>
              <div class="quiz-choice-list">
                <% q.options.forEach(function(opt, oi) { %>
                  <label class="quiz-choice-opt">
                    <input type="radio" name="q_<%= q.id %>" value="<%= oi %>" <%= (String(answers[q.id]) == String(oi)) ? 'checked' : '' %> />
                    <span><%= opt %></span>
                  </label>
                <% }) %>
              </div>
            <% } else if (q.type === 'multiple') { %>
              <div class="quiz-choice-list">
                <% q.options.forEach(function(opt, oi) { %>
                  <label class="quiz-choice-opt">
                    <input type="checkbox" name="q_<%= q.id %>_<%= oi %>" value="<%= oi %>"
                      <%= (Array.isArray(answers[q.id]) && answers[q.id].indexOf(String(oi)) !== -1) ? 'checked' : '' %> />
                    <span><%= opt %></span>
                  </label>
                <% }) %>
              </div>
            <% } else if (q.type === 'ranking') { %>
              <%
                var rankOrder = (Array.isArray(answers[q.id]) && answers[q.id].length)
                  ? answers[q.id].map(Number)
                  : q.options.map(function(_, i){ return i; });
              %>
              <div class="quiz-rank-list" id="qrank-<%= q.id %>">
                <% rankOrder.forEach(function(idx) { if (!q.options[idx]) return; %>
                  <div class="quiz-rank-item" draggable="true" data-idx="<%= idx %>">
                    <span class="quiz-rank-handle">&#11835;</span>
                    <span class="quiz-rank-label"><%= q.options[idx] %></span>
                  </div>
                <% }) %>
              </div>
              <input type="hidden" name="q_<%= q.id %>_rank"
                id="qrank-input-<%= q.id %>" value="<%= rankOrder.join(',') %>" />
            <% } %>
          </div>
        <% }) %>
      <% }) %>

      <div class="quiz-answer-actions">
        <button type="submit" name="complete" value="0" class="wf-cancel-link" style="border:1px solid var(--border);padding:.5rem 1rem;border-radius:8px">Sauvegarder</button>
        <button type="submit" name="complete" value="1" class="wf-save-btn" style="position:static">Terminer le quizz</button>
      </div>
    </form>
    <% } %>

    <% if (currentUser && currentUser.isAdmin) { %>
      <div style="margin-top:1.5rem;text-align:center">
        <a href="/quizz/<%= quiz.id %>/edit" class="wiki-edit-icon-btn">✎</a>
      </div>
    <% } %>
  </div>
<script>
(function() {
  document.querySelectorAll('.quiz-rank-list').forEach(function(list) {
    var qid = list.id.replace('qrank-', '');
    var hidden = document.getElementById('qrank-input-' + qid);
    var dragging = null;
    var indicator = null;

    function getInd() {
      if (!indicator) { indicator = document.createElement('div'); indicator.className = 'qe-drop-indicator'; }
      return indicator;
    }
    function updateHidden() {
      var order = Array.from(list.querySelectorAll('.quiz-rank-item')).map(function(el) { return el.dataset.idx; });
      if (hidden) hidden.value = order.join(',');
    }
    function afterEl(y) {
      return Array.from(list.querySelectorAll('.quiz-rank-item:not(.qe-q-dragging)')).reduce(function(c, el) {
        var b = el.getBoundingClientRect(), off = y - b.top - b.height / 2;
        return (off < 0 && off > c.off) ? { off: off, el: el } : c;
      }, { off: -Infinity, el: null }).el;
    }
    list.querySelectorAll('.quiz-rank-item').forEach(function(item) {
      item.addEventListener('dragstart', function(e) {
        dragging = item; item.classList.add('qe-q-dragging');
        e.dataTransfer.effectAllowed = 'move';
      });
      item.addEventListener('dragend', function() {
        item.classList.remove('qe-q-dragging');
        if (indicator && indicator.parentNode) indicator.remove();
        dragging = null; updateHidden();
      });
    });
    list.addEventListener('dragover', function(e) {
      e.preventDefault();
      var after = afterEl(e.clientY), ind = getInd();
      if (!after) list.appendChild(ind); else list.insertBefore(ind, after);
    });
    list.addEventListener('drop', function(e) {
      e.preventDefault();
      if (indicator && indicator.parentNode) indicator.remove();
      if (!dragging) return;
      var after = afterEl(e.clientY);
      if (!after) list.appendChild(dragging); else list.insertBefore(dragging, after);
      updateHidden();
    });
  });
})();
</script>
</main>
<%- include('partials/foot') %>
