<%- include('partials/head', { title: quiz.title }) %>
<main class="container wide">
  <%- include('partials/top-nav', { config: config, navTitle: quiz.title, navBack: '/quizz' }) %>

  <% if (locals.completed && !stepData) { %>
    <%# ── Écran de fin ───────────────────────────────────────────────── %>
    <div class="quiz-detail-wrap">
      <div class="quiz-done-screen">
        <div class="quiz-done-check">&#10003;</div>
        <h1 class="quiz-detail-title"><%= quiz.title %></h1>
        <p class="quiz-done-msg">Quizz complété&nbsp;!</p>
        <a href="/quizz" class="wf-save-btn" style="position:static;display:inline-block;margin-top:1rem">Retour aux quizz</a>
      </div>
    </div>

  <% } else if (!steps.length || !stepData) { %>
    <%# ── Quizz vide ─────────────────────────────────────────────────── %>
    <div class="quiz-detail-wrap">
      <h1 class="quiz-detail-title"><%= quiz.title %></h1>
      <% if (quiz.description) { %><p class="quiz-detail-desc"><%= quiz.description %></p><% } %>
      <p class="quiz-hub-empty">Ce quizz n'a pas encore de questions.</p>
    </div>

  <% } else { %>
    <%
      /* ── Helpers ──────────────────────────────────────────────────── */
      function toRoman(n) {
        var vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
        var syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
        var r = '';
        for (var i = 0; i < vals.length; i++) { while (n >= vals[i]) { r += syms[i]; n -= vals[i]; } }
        return r;
      }

      var GRAD_LEVELS = [
        { k: '1', l: 'Pas du tout',  col: 'hsl(0,72%,55%)'   },
        { k: '2', l: 'Un peu',       col: 'hsl(25,80%,55%)'  },
        { k: '3', l: 'Neutre',       col: 'hsl(50,78%,52%)'  },
        { k: '4', l: 'Beaucoup',     col: 'hsl(90,60%,48%)'  },
        { k: '5', l: 'Énormément',   col: 'hsl(140,55%,46%)' }
      ];
      var isLastStep = stepIdx >= steps.length - 1;
    %>

    <%- include('partials/mobile-filter-toggle') %>

    <%# ─── VOLET GAUCHE : titre + frise chronologique verticale des étapes ─── %>
    <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
      <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer">&times;</button>
      <div class="wiki-chapter-hero">
        <div class="wiki-chapter-hero-top">
          <span></span>
          <h1 class="wiki-chapter-hero-title"><%= quiz.title %></h1>
          <span></span>
        </div>
      </div>
      <div class="wiki-sidebar-body">
        <% if (steps.length > 1) { %>
        <div class="quiz-timeline">
          <%
            var _progPartCounter = 0;
            steps.forEach(function(s, i) {
              var _progLabel;
              if (s.part) { _progPartCounter++; _progLabel = toRoman(_progPartCounter); }
              else { _progLabel = '·'; }
          %>
            <a href="/quizz/<%= quiz.id %>?step=<%= i %>"
              class="quiz-timeline-step<%= i === stepIdx ? ' quiz-timeline-step--active' : '' %><%= i < stepIdx ? ' quiz-timeline-step--done' : '' %>"
              title="<%= s.part ? s.part.title : quiz.title %>">
              <span class="quiz-timeline-dot"><%= i < stepIdx ? '&#10003;' : _progLabel %></span>
              <span class="quiz-timeline-label"><%= s.part ? s.part.title : quiz.title %></span>
            </a>
          <% }) %>
        </div>
        <% } %>
      </div>
    </aside>

    <%# ─── COLONNE PRINCIPALE : étape courante ────────────────────────────── %>
    <div class="quiz-detail-wrap">
      <%# ── En-tête étape : le titre de partie ("I - ...") est retiré ici,
          déjà donné par la frise du volet gauche — seule l'étape sans
          partie garde le titre du quizz + sa description. ────────────── %>
      <% if (!stepData.part) { %>
        <h1 class="quiz-detail-title"><%= quiz.title %></h1>
        <% if (quiz.description) { %><p class="quiz-detail-desc"><%= quiz.description %></p><% } %>
      <% } %>

      <%# ── Questions de l'étape ──────────────────────────────────────── %>
      <form method="POST" action="/quizz/<%= quiz.id %>/answer" class="quiz-answer-form">
        <input type="hidden" name="_step" value="<%= stepIdx %>" />

        <% stepData.questions.forEach(function(q, qi) {
          var savedAns = answers[q.id];
          var hasSideAnswer = q.has_sides && savedAns && typeof savedAns === 'object' && savedAns.side;
          // null tant que la personne n'a pas choisi de perspective : les
          // réponses give/receive restent cachées et les 3 boutons de choix
          // affichés, plutôt qu'un "Les deux" par défaut qui montrait tout
          // de suite les deux jeux de réponses.
          var savedSide    = hasSideAnswer ? savedAns.side : null;
          var savedGive    = (q.has_sides && savedAns && typeof savedAns === 'object') ? savedAns.give    : savedAns;
          var savedReceive = (q.has_sides && savedAns && typeof savedAns === 'object') ? savedAns.receive : null;
          var qNum = qi + 1;
          // Croix "effacer ma réponse" : masquée tant qu'il n'y a rien à
          // effacer — pour une question Donner/Subir, dès que la perspective
          // est choisie ; sinon, dès qu'une vraie réponse existe déjà.
          var hasAnyAnswer = q.has_sides
            ? !!savedSide
            : (savedAns !== undefined && savedAns !== null && savedAns !== '' && !(Array.isArray(savedAns) && savedAns.length === 0));

          /* ── Render gradient bar ────────────────────────────────────── */
          function renderGradBar(name, savedVal) {
            var initVal = parseInt(savedVal, 10) || 0;
            var initPct = initVal > 0 ? ((initVal - 1) / 4 * 100) : -1;
            var html = '<div class="quiz-grad-bar" data-name="' + name + '">';
            html += '<div class="quiz-grad-track"><div class="quiz-grad-fill" style="width:' + (initPct >= 0 ? initPct : 0) + '%;opacity:' + (initPct >= 0 ? 1 : 0) + '"></div></div>';
            html += '<div class="quiz-grad-jalons">';
            GRAD_LEVELS.forEach(function(lvl) {
              var active = initVal >= parseInt(lvl.k);
              html += '<label class="quiz-grad-jal' + (active ? ' quiz-grad-jal--active' : '') + '" style="--jcol:' + lvl.col + '">'
                + '<input type="radio" name="' + name + '" value="' + lvl.k + '"' + (savedVal == lvl.k ? ' checked' : '') + ' />'
                + '<span class="quiz-grad-jal-dot"></span>'
                + '<span class="quiz-grad-jal-lbl">' + lvl.l + '</span>'
                + '</label>';
            });
            html += '</div></div>';
            return html;
          }

          /* ── Render inputs (tous types, avec suffixe pour has_sides) ── */
          function renderInputs(suffix, savedVal) {
            var name = suffix ? 'q_' + q.id + '_' + suffix : 'q_' + q.id;
            var html = '';
            if (q.type === 'gradient') {
              html = renderGradBar(name, savedVal);
            } else if (q.type === 'single') {
              html += '<div class="quiz-choice-list">';
              q.options.forEach(function(opt, oi) {
                html += '<label class="quiz-choice-opt"><input type="radio" name="' + name + '" value="' + oi + '"'
                  + (String(savedVal) == String(oi) ? ' checked' : '') + ' /><span>' + opt + '</span></label>';
              });
              html += '</div>';
            } else if (q.type === 'multiple') {
              html += '<div class="quiz-choice-list">';
              q.options.forEach(function(opt, oi) {
                var checked = Array.isArray(savedVal) && savedVal.indexOf(String(oi)) !== -1;
                html += '<label class="quiz-choice-opt"><input type="checkbox" name="' + name + '_' + oi + '" value="' + oi + '"'
                  + (checked ? ' checked' : '') + ' /><span>' + opt + '</span></label>';
              });
              html += '</div>';
            } else if (q.type === 'ranking') {
              var rankOrder = (Array.isArray(savedVal) && savedVal.length)
                ? savedVal.map(Number) : q.options.map(function(_, i){ return i; });
              var rankKey = suffix ? q.id + '-' + suffix : q.id;
              html += '<div class="quiz-rank-list" id="qrank-' + rankKey + '">';
              rankOrder.forEach(function(idx) {
                if (!q.options[idx]) return;
                html += '<div class="quiz-rank-item" draggable="true" data-idx="' + idx + '">'
                  + '<span class="quiz-rank-handle">&#11835;</span><span class="quiz-rank-label">' + q.options[idx] + '</span></div>';
              });
              html += '</div>';
              html += '<input type="hidden" name="' + name + '_rank" id="qrank-input-' + rankKey + '" value="' + rankOrder.join(',') + '" />';
            }
            return html;
          }
        %>

          <div class="quiz-q-block" id="qblock-<%= q.id %>" data-qid="<%= q.id %>">
            <div class="quiz-q-header">
              <span class="quiz-q-num"><%= qNum %></span>
              <p class="quiz-q-text"><%= q.text %></p>
            </div>

            <% if (q.has_sides) { %>
              <div class="quiz-sides-picker<%= savedSide ? ' quiz-sides-picker--hidden' : '' %>" id="qsidespicker-<%= q.id %>">
                <button type="button" class="quiz-sides-btn" data-qid="<%= q.id %>" data-side="give">Donner</button>
                <button type="button" class="quiz-sides-btn quiz-sides-btn--both" data-qid="<%= q.id %>" data-side="both">Les deux</button>
                <button type="button" class="quiz-sides-btn" data-qid="<%= q.id %>" data-side="receive">Recevoir</button>
              </div>
              <input type="hidden" name="q_<%= q.id %>_side" id="qside-input-<%= q.id %>" value="<%= savedSide || '' %>" />
            <% } %>

            <% if (!q.has_sides) { %>
              <%- renderInputs(null, savedAns) %>
            <% } else { %>
              <div class="quiz-side-row quiz-side-row--give<%= (!savedSide || savedSide === 'receive') ? ' quiz-side-row--hidden' : '' %>" id="qside-give-<%= q.id %>">
                <span class="quiz-side-label">Donner</span>
                <%- renderInputs('give', savedGive) %>
              </div>
              <div class="quiz-side-row quiz-side-row--receive<%= (!savedSide || savedSide === 'give') ? ' quiz-side-row--hidden' : '' %>" id="qside-receive-<%= q.id %>">
                <span class="quiz-side-label">Recevoir</span>
                <%- renderInputs('receive', savedReceive) %>
              </div>
            <% } %>

            <%# Croix unique pour effacer la réponse — une seule, centrée,
                jamais dupliquée avec un bouton "changer de perspective". ── %>
            <div class="quiz-q-clear-row">
              <button type="button" class="quiz-sides-reset<%= hasAnyAnswer ? '' : ' quiz-sides-reset--hidden' %>" id="qclear-<%= q.id %>" data-qid="<%= q.id %>" title="Effacer ma r&eacute;ponse" aria-label="Effacer ma r&eacute;ponse">&times;</button>
            </div>
          </div>

        <% }) %>

        <div class="quiz-step-actions">
          <% if (stepIdx > 0) { %>
            <a href="/quizz/<%= quiz.id %>?step=<%= stepIdx - 1 %>" class="quiz-step-prev">&#8592; Précédent</a>
          <% } else { %>
            <span></span>
          <% } %>
          <% if (isLastStep) { %>
            <button type="submit" name="complete" value="1" class="wf-save-btn" style="position:static">Terminer le quizz</button>
          <% } else { %>
            <button type="submit" name="complete" value="0" class="quiz-step-next">Suivant &#8594;</button>
          <% } %>
        </div>
      </form>
    </div>
  <% } %>

  <% if (currentUser && currentUser.isAdmin) { %>
    <a href="/quizz/<%= quiz.id %>/edit" class="quiz-admin-edit-fab" title="Modifier le quizz">&#9998;</a>
  <% } %>

  <script>
  (function() {
    /* ── Croix "effacer ma réponse" : une seule par question, centrée sous
       la réponse — n'apparaît qu'une fois qu'il y a vraiment quelque chose à
       effacer (voir hasAnyAnswer côté serveur pour l'état initial). ────── */
    function revealClearBtn(qid) {
      var btn = document.getElementById('qclear-' + qid);
      if (btn) btn.classList.remove('quiz-sides-reset--hidden');
    }
    var quizAnswerForm = document.querySelector('.quiz-answer-form');
    if (quizAnswerForm) {
      quizAnswerForm.addEventListener('change', function(e) {
        if (!e.target.matches('input[type="radio"], input[type="checkbox"]')) return;
        var block = e.target.closest('.quiz-q-block');
        if (block) revealClearBtn(block.dataset.qid);
      });
    }

    /* ── Gradient bar ────────────────────────────────────────────────────── */
    document.querySelectorAll('.quiz-grad-bar').forEach(function(bar) {
      var fill    = bar.querySelector('.quiz-grad-fill');
      var jalons  = bar.querySelectorAll('.quiz-grad-jal');
      var radios  = bar.querySelectorAll('input[type="radio"]');

      function setVal(val) {
        var pct = val > 0 ? ((val - 1) / 4 * 100) : 0;
        fill.style.width   = pct + '%';
        fill.style.opacity = val > 0 ? '1' : '0';
        jalons.forEach(function(jal, i) {
          jal.classList.toggle('quiz-grad-jal--active', (i + 1) <= val);
        });
      }

      radios.forEach(function(r) {
        r.addEventListener('change', function() { setVal(parseInt(r.value, 10)); });
      });
    });

    /* ── Ranking drag & drop ─────────────────────────────────────────────── */
    document.querySelectorAll('.quiz-rank-list').forEach(function(list) {
      var key     = list.id.replace('qrank-', '');
      var rankQid = key.split('-')[0];
      var hidden  = document.getElementById('qrank-input-' + key);
      var dragging = null, indicator = null;
      function getInd() {
        if (!indicator) { indicator = document.createElement('div'); indicator.className = 'qe-drop-indicator'; }
        return indicator;
      }
      function updateHidden() {
        if (hidden) hidden.value = Array.from(list.querySelectorAll('.quiz-rank-item')).map(function(el) { return el.dataset.idx; }).join(',');
      }
      function afterEl(y) {
        return Array.from(list.querySelectorAll('.quiz-rank-item:not(.qe-q-dragging)')).reduce(function(c, el) {
          var b = el.getBoundingClientRect(), off = y - b.top - b.height / 2;
          return (off < 0 && off > c.off) ? { off: off, el: el } : c;
        }, { off: -Infinity, el: null }).el;
      }
      list.querySelectorAll('.quiz-rank-item').forEach(function(item) {
        item.addEventListener('dragstart', function(e) { dragging = item; item.classList.add('qe-q-dragging'); e.dataTransfer.effectAllowed = 'move'; });
        item.addEventListener('dragend',   function()  { item.classList.remove('qe-q-dragging'); if (indicator && indicator.parentNode) indicator.remove(); dragging = null; updateHidden(); revealClearBtn(rankQid); });
      });
      list.addEventListener('dragover', function(e) { e.preventDefault(); var after = afterEl(e.clientY), ind = getInd(); if (!after) list.appendChild(ind); else list.insertBefore(ind, after); });
      list.addEventListener('drop',     function(e) { e.preventDefault(); if (indicator && indicator.parentNode) indicator.remove(); if (!dragging) return; var after = afterEl(e.clientY); if (!after) list.appendChild(dragging); else list.insertBefore(dragging, after); updateHidden(); });
    });

    /* ── Donner / Subir : 3 boutons, la croix du bas fait tout le reste ──── */
    function selectSide(qid, side) {
      var hiddenSide = document.getElementById('qside-input-' + qid);
      var giveRow    = document.getElementById('qside-give-' + qid);
      var receiveRow = document.getElementById('qside-receive-' + qid);
      var picker     = document.getElementById('qsidespicker-' + qid);
      if (hiddenSide) hiddenSide.value = side;
      if (giveRow)    giveRow.classList.toggle('quiz-side-row--hidden',    side === 'receive');
      if (receiveRow) receiveRow.classList.toggle('quiz-side-row--hidden', side === 'give');
      if (picker)     picker.classList.add('quiz-sides-picker--hidden');
      revealClearBtn(qid);
    }
    // Ramène juste le sélecteur de perspective à son état initial (utilisé
    // par la croix unique ci-dessous) — ne touche pas au serveur, voir
    // resetQuestionBlock pour l'effacement complet.
    function resetSide(qid) {
      var hiddenSide = document.getElementById('qside-input-' + qid);
      var giveRow    = document.getElementById('qside-give-' + qid);
      var receiveRow = document.getElementById('qside-receive-' + qid);
      var picker     = document.getElementById('qsidespicker-' + qid);
      if (hiddenSide) hiddenSide.value = '';
      if (giveRow)    giveRow.classList.add('quiz-side-row--hidden');
      if (receiveRow) receiveRow.classList.add('quiz-side-row--hidden');
      if (picker)     picker.classList.remove('quiz-sides-picker--hidden');
    }
    document.querySelectorAll('.quiz-sides-btn').forEach(function(btn) {
      btn.addEventListener('click', function() { selectSide(btn.dataset.qid, btn.dataset.side); });
    });

    /* ── Effacer ma réponse (croix rouge unique, centrée) ─────────────────── */
    function resetQuestionBlock(qid) {
      var block = document.getElementById('qblock-' + qid);
      if (!block) return;
      block.querySelectorAll('input[type="radio"], input[type="checkbox"]').forEach(function(el) { el.checked = false; });
      block.querySelectorAll('.quiz-grad-bar').forEach(function(bar) {
        var fill = bar.querySelector('.quiz-grad-fill');
        if (fill) { fill.style.width = '0%'; fill.style.opacity = '0'; }
        bar.querySelectorAll('.quiz-grad-jal').forEach(function(jal) { jal.classList.remove('quiz-grad-jal--active'); });
      });
      block.querySelectorAll('.quiz-rank-list').forEach(function(list) {
        var items = Array.from(list.querySelectorAll('.quiz-rank-item'));
        items.sort(function(a, b) { return Number(a.dataset.idx) - Number(b.dataset.idx); });
        items.forEach(function(item) { list.appendChild(item); });
        var hidden = document.getElementById('qrank-input-' + list.id.replace('qrank-', ''));
        if (hidden) hidden.value = items.map(function(el) { return el.dataset.idx; }).join(',');
      });
      if (document.getElementById('qsidespicker-' + qid)) resetSide(qid);
      var clearBtn = document.getElementById('qclear-' + qid);
      if (clearBtn) clearBtn.classList.add('quiz-sides-reset--hidden');
    }
    document.querySelectorAll('.quiz-sides-reset').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var qid = btn.dataset.qid;
        fetch('/quizz/<%= quiz.id %>/questions/' + qid + '/clear-answer', { method: 'POST' })
          .then(function() { resetQuestionBlock(qid); })
          .catch(function() {});
      });
    });
  })();
  </script>
</main>
<%- include('partials/foot') %>
