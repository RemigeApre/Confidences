<%- include('partials/head', { title: nouvelle ? 'Modifier : ' + nouvelle.title : 'Nouvelle histoire' }) %>
<main class="container" style="max-width: 860px; margin: 0 auto">
  <%- include('partials/top-nav', { config: config, navTitle: nouvelle ? nouvelle.title : 'Nouvelle histoire', navBack: nouvelle && nouvelle.serie_id ? '/nouvelles/series/' + nouvelle.serie_id : '/nouvelles' }) %>

  <a href="<%= nouvelle && nouvelle.serie_id ? '/nouvelles/series/' + nouvelle.serie_id : '/nouvelles' %>" class="wf-back-btn">&#8592; Retour</a>
  <div class="wf-actions-right">
    <button type="submit" form="nv-form" class="wf-save-btn">Enregistrer</button>
  </div>
  <% if (nouvelle) { %>
  <form method="POST" action="/nouvelles/<%= nouvelle.id %>/delete" class="wf-delete-form-fixed"
    onsubmit="return confirm('Supprimer cette nouvelle d\u00e9finitivement ?')">
    <button type="submit" class="wf-delete-btn-fixed" title="Supprimer la nouvelle">&#128465;</button>
  </form>
  <% } %>

  <div class="nv-form-wrap">
    <form method="POST" action="<%= nouvelle ? '/nouvelles/' + nouvelle.id + '/update' : '/nouvelles/new' %>"
      class="nv-form" id="nv-form">

      <div class="ef-block">

      <input type="text" name="title" class="nv-form-title-input" required maxlength="300"
        value="<%= nouvelle ? nouvelle.title : '' %>" placeholder="Titre de la nouvelle…" />

      <div class="nv-form-meta-row">
        <input type="text" name="author" class="wf-orce-name-input" maxlength="200"
          value="<%= nouvelle ? nouvelle.author : '' %>" placeholder="Protagoniste…" style="flex:1" />

        <select name="category" class="wf-orce-name-input" style="flex:0 0 auto">
          <option value="">— Catégorie —</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c.key %>" <%= nouvelle && nouvelle.category === c.key ? 'selected' : '' %>><%= c.label %></option>
          <% }) %>
        </select>

        <select name="stage" class="wf-orce-name-input" style="flex:0 0 auto">
          <% (stages || []).forEach(function(s) { %>
            <option value="<%= s.key %>" <%= (nouvelle ? nouvelle.stage : 'brouillon') === s.key ? 'selected' : '' %>><%= s.label %></option>
          <% }) %>
        </select>

        <label class="wiki-display-opt-label" title="Masqué même pour les stades publics">
          <input type="checkbox" name="hidden" value="1" hidden
            <%= nouvelle && nouvelle.hidden ? 'checked' : '' %> />
          <span class="wiki-display-opt-track"></span>
          <span class="wiki-display-opt-text">Masqué</span>
        </label>

        <label class="wiki-display-opt-label">
          <input type="checkbox" name="featured" value="1" hidden
            <%= nouvelle && nouvelle.featured ? 'checked' : '' %> />
          <span class="wiki-display-opt-track"></span>
          <span class="wiki-display-opt-text">Mise en avant</span>
        </label>
      </div>

      <% if (series && series.length) { %>
      <div class="nv-form-serie-row">
        <select name="serie_id" class="wf-orce-name-input" id="nv-serie-select" style="flex:1">
          <option value="">— Aucune série (standalone) —</option>
          <% series.forEach(function(s) {
            var selected = (nouvelle && nouvelle.serie_id === s.id) || (preSerieId === s.id);
          %>
            <option value="<%= s.id %>" <%= selected ? 'selected' : '' %>><%= s.title %></option>
          <% }) %>
        </select>
        <div class="nv-form-serie-order" id="nv-serie-order-wrap">
          <input type="number" name="serie_order" id="nv-serie-order"
            class="wf-orce-name-input" min="1" style="width:90px"
            value="<%= nouvelle && nouvelle.serie_order ? nouvelle.serie_order : '' %>"
            placeholder="Ch. n°" />
        </div>
      </div>
      <% } %>

      <textarea name="summary" class="wf-stats-note-input" rows="2" maxlength="500"
        placeholder="Résumé / accroche (max 500 caractères)…"
        style="resize:vertical"><%= nouvelle ? nouvelle.summary : '' %></textarea>

      <% if (protagonistes && protagonistes.length) { %>
      <div class="nv-form-prot-row">
        <span class="nv-form-prot-label">Protagonistes :</span>
        <div class="nv-form-prot-chips">
          <% protagonistes.forEach(function(p) {
            var checked = nouvelle && nouvelle.protagoniste_ids && nouvelle.protagoniste_ids.indexOf(p.id) !== -1;
          %>
            <label class="nv-form-prot-chip">
              <input type="checkbox" name="protagoniste_ids" value="<%= p.id %>" <%= checked ? 'checked' : '' %> />
              <span><%= p.name %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <% } %>

      <%# ── Tags ──────────────────────────────────────────────────────────── %>
      <% if (allTags && allTags.length) { %>
        <script id="nv-all-tags" type="application/json"><%- JSON.stringify(allTags) %></script>
      <% } %>
      <div class="wiki-tags-widget">
        <div class="wiki-tags-board">
          <input type="text" class="wiki-tags-typing" placeholder="Ajouter un tag…" autocomplete="off" />
        </div>
        <input type="hidden" name="tags" class="wiki-tags-hidden"
          value="<%= nouvelle && nouvelle.tags ? nouvelle.tags.join(', ') : '' %>" />
        <% if (allTags && allTags.length) { %>
          <div class="wiki-tag-suggestions">
            <% allTags.slice(0, 20).forEach(function(t) { %>
              <button type="button" class="wiki-tag-suggest-chip" data-tag="<%= t %>"><%= t %></button>
            <% }) %>
          </div>
          <div id="nv-content-tags" class="nv-content-tags" hidden>
            <p class="nv-content-tags-label">Détectés dans le texte</p>
            <div class="nv-content-tag-list"></div>
          </div>
        <% } %>
      </div>

      </div><%# /ef-block meta %>

      <%# ── BLOC ORIGINES ── %>
      <div class="ef-block ef-block--origins">
      <div class="ef-block-label">Origines</div>

      <%# ── Parodie ─────────────────────────────────────────────────────────── %>
      <%- include('partials/parody-input', {
            idPrefix:  'nvf',
            mainValue: nouvelle ? nouvelle.parody    : '',
            subValue:  nouvelle ? nouvelle.subParody : '',
            mainPh:    'Parodie (ex\u00a0: Pok\u00e9mon)\u2026'
          }) %>

      </div><%# /ef-block origines %>

      <div class="nv-wordcount-bar">
        <span class="nv-wc-label" id="nv-wc">0 mot</span>
        <span class="nv-wc-time" id="nv-wc-time">~0 min</span>
      </div>

      <textarea name="content" class="nv-form-content" id="nv-content" rows="30"
        placeholder="Écrivez votre nouvelle ici…"
        style="resize:vertical"><%= nouvelle ? nouvelle.content : '' %></textarea>

      <div class="wiki-form-actions wf-mobile-actions">
        <button type="submit">Enregistrer</button>
      </div>
    </form>
  </div>


  <script>
  (function () {

    // ── 1. Compteur de mots ───────────────────────────────────────────────────
    var content = document.getElementById('nv-content');
    var wcEl    = document.getElementById('nv-wc');
    var wtEl    = document.getElementById('nv-wc-time');
    function updateWc() {
      var n = content.value.trim().split(/\s+/).filter(Boolean).length;
      wcEl.textContent = n.toLocaleString('fr-FR') + ' mot' + (n !== 1 ? 's' : '');
      wtEl.textContent = '~' + Math.max(1, Math.round(n / 200)) + ' min';
    }
    content.addEventListener('input', updateWc);
    updateWc();

    // ── 2. Sélecteur de série → affiche/masque le n° de chapitre ─────────────
    var serieSelect = document.getElementById('nv-serie-select');
    var orderWrap   = document.getElementById('nv-serie-order-wrap');
    if (serieSelect && orderWrap) {
      function toggleOrder() { orderWrap.style.display = serieSelect.value ? 'flex' : 'none'; }
      serieSelect.addEventListener('change', toggleOrder);
      toggleOrder();
    }

    // ── 3. Widget tags ────────────────────────────────────────────────────────
    var board      = document.querySelector('.wiki-tags-board');
    var typer      = document.querySelector('.wiki-tags-typing');
    var hidden     = document.querySelector('.wiki-tags-hidden');
    var suggestBox = document.querySelector('.wiki-tag-suggestions');
    if (!board || !typer || !hidden) return;

    // Zone chips au-dessus du champ
    var chipsArea = document.querySelector('.wiki-tags-chips');
    if (!chipsArea) {
      chipsArea = document.createElement('div');
      chipsArea.className = 'wiki-tags-chips';
      board.parentNode.insertBefore(chipsArea, board);
    }

    // Liste complète des tags disponibles (JSON embarqué ou chips rendus)
    var allAvail = (function () {
      var el = document.getElementById('nv-all-tags');
      if (el) { try { return JSON.parse(el.textContent); } catch (_) {} }
      var arr = [];
      if (suggestBox) suggestBox.querySelectorAll('[data-tag]').forEach(function (c) { arr.push(c.dataset.tag); });
      return arr;
    })();

    var tags = (hidden.value || '').split(/[,;]+/).map(function (t) { return t.trim(); }).filter(Boolean);

    function findTag(t)   { return tags.indexOf(t) !== -1; }
    function syncHidden() { hidden.value = tags.join(', '); }

    function renderBoard() {
      chipsArea.querySelectorAll('.wiki-chip').forEach(function (c) { c.remove(); });
      tags.forEach(function (t) {
        var chip = document.createElement('span');
        chip.className = 'link-tag-pill wiki-chip';
        chip.style.cssText = 'background:hsl(340,50%,38%);color:#fff;cursor:pointer;margin:2px 3px 2px 0;display:inline-flex;align-items:center;padding:2px 8px;border-radius:20px;font-size:.75rem';
        chip.textContent = t;
        chip.title = 'Cliquer pour retirer';
        chip.addEventListener('click', function () { removeTag(t); });
        chipsArea.appendChild(chip);
      });
      syncHidden();
      syncSuggest();
      syncContentTags();
    }

    function syncSuggest() {
      if (!suggestBox) return;
      suggestBox.querySelectorAll('.wiki-tag-suggest-chip').forEach(function (chip) {
        var isSelected = findTag(chip.dataset.tag);
        chip.classList.toggle('active', isSelected);
        chip.hidden = isSelected;
      });
    }

    function addTag(t) {
      t = t.trim();
      if (t && !findTag(t)) { tags.push(t); renderBoard(); }
    }
    function removeTag(t) {
      tags = tags.filter(function (x) { return x !== t; });
      renderBoard();
    }

    // Chips de suggestions statiques
    if (suggestBox) {
      suggestBox.querySelectorAll('.wiki-tag-suggest-chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          findTag(chip.dataset.tag) ? removeTag(chip.dataset.tag) : addTag(chip.dataset.tag);
        });
      });
    }

    // Autocomplete dropdown
    var acDrop = document.createElement('ul');
    acDrop.className = 'wiki-tag-autocomplete';
    acDrop.hidden = true;
    board.parentNode.insertBefore(acDrop, board.nextSibling);
    var acSel = -1;

    function clearAc() { while (acDrop.firstChild) acDrop.removeChild(acDrop.firstChild); }
    function closeAc() { acDrop.hidden = true; clearAc(); acSel = -1; }

    function showAc(q) {
      q = (q || '').trim().toLowerCase();
      if (!q) { closeAc(); return; }
      var matches = allAvail.filter(function (t) {
        return t.toLowerCase().indexOf(q) !== -1 && !findTag(t);
      }).slice(0, 9);
      if (!matches.length) { closeAc(); return; }
      clearAc(); acSel = -1;
      matches.forEach(function (t) {
        var li = document.createElement('li');
        li.className = 'wiki-tag-ac-item';
        li.textContent = t;
        li.addEventListener('mousedown', function (e) {
          e.preventDefault(); addTag(t); typer.value = ''; closeAc(); typer.focus();
        });
        acDrop.appendChild(li);
      });
      acDrop.hidden = false;
    }

    typer.addEventListener('input', function () {
      showAc(typer.value);
      if (suggestBox) {
        var q = typer.value.trim().toLowerCase();
        suggestBox.querySelectorAll('.wiki-tag-suggest-chip').forEach(function (chip) {
          chip.hidden = q.length > 0 && chip.dataset.tag.toLowerCase().indexOf(q) === -1;
        });
      }
    });

    typer.addEventListener('blur', function () {
      if (typer.value.trim()) { addTag(typer.value.trim()); typer.value = ''; }
      setTimeout(closeAc, 160);
    });

    board.addEventListener('click', function (e) { if (e.target === board) typer.focus(); });

    typer.addEventListener('keydown', function (e) {
      // Validation du tag saisi
      if (e.key === 'Enter' || e.key === ',' || e.key === ';') {
        e.preventDefault();
        var val = typer.value.trim();
        if (val) { addTag(val); typer.value = ''; closeAc(); }
        return;
      }
      if (e.key === 'Backspace' && !typer.value && tags.length) {
        removeTag(tags[tags.length - 1]); return;
      }
      // Navigation dans l'autocomplete
      if (acDrop.hidden) return;
      var items = acDrop.querySelectorAll('.wiki-tag-ac-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        acSel = Math.min(acSel + 1, items.length - 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        acSel = Math.max(acSel - 1, 0);
      } else if ((e.key === 'Enter' || e.key === 'Tab') && acSel >= 0 && items[acSel]) {
        e.preventDefault(); e.stopImmediatePropagation();
        addTag(items[acSel].textContent); typer.value = ''; closeAc(); return;
      } else if (e.key === 'Escape') {
        closeAc(); return;
      }
      items.forEach(function (li, i) { li.classList.toggle('selected', i === acSel); });
    }, true);

    renderBoard();

    // ── 4. Suggestions de tags depuis le contenu du texte ─────────────────────
    var contentTagsEl  = document.getElementById('nv-content-tags');
    var contentTagList = contentTagsEl ? contentTagsEl.querySelector('.nv-content-tag-list') : null;

    function normalize(s) {
      return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9 ]/g, ' ');
    }

    function syncContentTags() {
      if (!contentTagsEl || !contentTagList || !allAvail.length) return;
      var text = normalize(content.value);
      var found = allAvail.filter(function (tag) {
        return !findTag(tag) && text.indexOf(normalize(tag)) !== -1;
      });
      if (!found.length) { contentTagsEl.hidden = true; return; }
      contentTagsEl.hidden = false;
      while (contentTagList.firstChild) contentTagList.removeChild(contentTagList.firstChild);
      found.slice(0, 18).forEach(function (tag) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'wiki-tag-suggest-chip';
        btn.dataset.tag = tag;
        btn.textContent = tag;
        btn.addEventListener('click', function () { addTag(tag); });
        contentTagList.appendChild(btn);
      });
    }

    var contentTimer;
    content.addEventListener('input', function () {
      clearTimeout(contentTimer);
      contentTimer = setTimeout(syncContentTags, 600);
    });
    syncContentTags(); // analyse initiale (si on édite une nouvelle existante)

  })();
  </script>

</main>
<%- include('partials/foot') %>
