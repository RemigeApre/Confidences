<%- include('partials/head', { title: 'Admin : ' + detail.user.displayName + ' : Images', extraCss: ['admin.css'] }) %>

<%- include('partials/admin-nav') %>

<div class="aud-layout">
  <%- include('partials/admin-user-nav', { detail: detail, roleHue: roleHue }) %>

  <main class="aud-content">

    <div class="aud-section-header">
      <h2 class="aud-section-title">Notes &amp; favoris images (<%= items.length %>)</h2>
    </div>

    <div class="aud-card-grid" id="aud-images-items">
      <% if (!items.length) { %>
        <p class="admin-muted">Aucune note ni favori image.</p>
      <% } %>
      <% items.forEach(function(img) { %>
        <div class="aud-grant-wrap" data-full-src="<%= (img.imagePaths && img.imagePaths[0]) || '' %>" data-img-title="<%= (img.title || '').replace(/"/g,'&quot;') %>">
          <%- include('partials/admin-content-card', {
            href: '/galerie/' + img.id + '/edit',
            coverImg: (img.imagePaths && img.imagePaths[0]) || img.filename,
            title: img.title || 'Sans titre',
            viewCount: undefined,
            rating: img.rating || 0,
            flame: !!img.flame,
            placeholderIcon: '&#128247;',
          }) %>
          <% var _owned = ownedImageIds.has(img.id); %>
          <form method="POST" action="/ponhgup/utilisateur/<%= detail.user.id %>/grant-image" class="aud-grant-form">
            <input type="hidden" name="imageId" value="<%= img.id %>">
            <button type="submit" class="aud-grant-btn<%= _owned ? ' aud-grant-btn--owned' : '' %>"
                    title="<%= _owned ? 'Déjà dans le coffre' : 'Donner cette image au coffre' %>"
                    <%= _owned ? 'disabled' : '' %>>
              <%= _owned ? 'Déjà obtenue' : 'Donner' %>
            </button>
          </form>
        </div>
      <% }) %>
    </div>

    <% if (topViews.length) { %>
      <div class="aud-section-header" id="aud-images-views-header" hidden>
        <h2 class="aud-section-title">Images les plus visit&eacute;es</h2>
      </div>
      <div class="aud-card-grid" id="aud-images-views" hidden>
        <% topViews.forEach(function(img) { %>
          <div data-full-src="<%= (img.imagePaths && img.imagePaths[0]) || '' %>" data-img-title="<%= (img.title || '').replace(/"/g,'&quot;') %>">
            <%- include('partials/admin-content-card', {
              href: '/galerie/' + img.id + '/edit',
              coverImg: (img.imagePaths && img.imagePaths[0]) || img.filename,
              title: img.title || 'Sans titre',
              viewCount: img.viewCount,
              rating: img.rating || 0,
              flame: !!img.flame,
              placeholderIcon: '&#128247;',
            }) %>
          </div>
        <% }) %>
      </div>
      <button type="button" class="aud-view-toggle" id="aud-images-toggle-views">
        <span aria-hidden="true">&#128065;</span>
        <span id="aud-images-toggle-label">Voir les vues</span>
      </button>
    <% } %>

  </main>
</div>

<%# ── Lightbox admin (simple : image + fermer) ── %>
<div class="adm-img-lb" id="adm-img-lb" hidden>
  <button class="adm-img-lb-close" id="adm-img-lb-close" aria-label="Fermer">&#215;</button>
  <img class="adm-img-lb-img" id="adm-img-lb-img" src="" alt="" />
  <div class="adm-img-lb-title" id="adm-img-lb-title"></div>
</div>

<script nonce="<%= nonce %>">
(function () {
  // ── Lightbox ──────────────────────────────────────────────────────────────
  var aLb     = document.getElementById('adm-img-lb');
  var aLbImg  = document.getElementById('adm-img-lb-img');
  var aLbTtl  = document.getElementById('adm-img-lb-title');
  var aLbClose= document.getElementById('adm-img-lb-close');

  function aLbOpen(src, title) {
    aLbImg.src = src;
    aLbImg.alt = title || '';
    aLbTtl.textContent = title || '';
    aLb.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function aLbCloseF() {
    aLb.hidden = true;
    aLbImg.src = '';
    document.body.style.overflow = '';
  }

  if (aLb) {
    aLbClose.addEventListener('click', aLbCloseF);
    aLb.addEventListener('click', function(e) { if (e.target === aLb) aLbCloseF(); });
    document.addEventListener('keydown', function(e) { if (!aLb.hidden && e.key === 'Escape') aLbCloseF(); });

    document.addEventListener('click', function(e) {
      var card = e.target.closest('.aud-card');
      if (!card) return;
      var wrap = card.closest('[data-full-src]');
      if (!wrap || !wrap.dataset.fullSrc) return;
      e.preventDefault();
      aLbOpen(wrap.dataset.fullSrc, wrap.dataset.imgTitle);
    });
  }

  // ── Toggle vues ───────────────────────────────────────────────────────────
  var btn = document.getElementById("aud-images-toggle-views");
  if (!btn) return;
  var items = document.getElementById("aud-images-items");
  var viewsHeader = document.getElementById("aud-images-views-header");
  var views = document.getElementById("aud-images-views");
  var label = document.getElementById("aud-images-toggle-label");
  var showingViews = false;
  btn.addEventListener("click", function () {
    showingViews = !showingViews;
    items.hidden = showingViews;
    viewsHeader.hidden = !showingViews;
    views.hidden = !showingViews;
    label.textContent = showingViews ? "Voir notes & favoris" : "Voir les vues";
  });
})();
</script>
<%- include('partials/foot') %>
