<%- include('partials/head', { title: 'Profil : Identité' }) %>
<main class="container wide profil-page gallery-has-sidebar">
  <%- include('partials/top-nav', { config: config }) %>

  <%- include('partials/profil-nav', { roleHue: roleHue }) %>

  <div class="profil-subpage profil-subpage--wide">

    <% if (error) { %><p class="profil-msg profil-msg-error"><%= error %></p><% } %>
    <% if (notice) { %><p class="profil-msg profil-msg-ok"><%= notice %></p><% } %>

    <form method="POST" action="/favoris/identite">

      <section class="profil-panel">
        <div class="profil-panel-grid">
          <label class="profil-field">
            <span class="profil-field-label">Pseudo</span>
            <input type="text" name="display_name" value="<%= user.displayName %>" required autocomplete="off" class="profil-field-input" />
          </label>

          <label class="profil-field">
            <span class="profil-field-label">Sexe</span>
            <div class="profil-field-with-icon">
              <span class="profil-sexe-icon" id="sexe-icon" aria-hidden="true"></span>
              <select name="sexe" id="sexe-select" class="profil-select">
                <option value="" <%= user.sexe === '' ? 'selected' : '' %>>Non pr&eacute;cis&eacute;</option>
                <option value="femme" <%= user.sexe === 'femme' ? 'selected' : '' %>>Femme</option>
                <option value="homme" <%= user.sexe === 'homme' ? 'selected' : '' %>>Homme</option>
                <option value="autre" <%= user.sexe === 'autre' ? 'selected' : '' %>>Autre</option>
              </select>
            </div>
          </label>

          <label class="profil-field">
            <span class="profil-field-label">Ann&eacute;e de naissance</span>
            <input type="text" value="<%= user.birthYear || 'Non renseign&eacute;e' %>" disabled class="profil-field-input" />
          </label>
        </div>

        <% if (identityLockedUntilLabel) { %>
          <p class="profil-identite-lock-note">Pseudo, sexe et orientation&nbsp;: un seul changement par semaine. Prochain changement possible le <%= identityLockedUntilLabel %>.</p>
        <% } %>

        <div class="profil-panel-grid">
          <label class="profil-field">
            <span class="profil-field-label">Adresse mail</span>
            <input type="email" name="email" id="identite-email-input" data-original="<%= user.email || '' %>" value="<%= user.email || '' %>" placeholder="facultatif" autocomplete="off" class="profil-field-input" />
          </label>

          <label class="profil-field">
            <span class="profil-field-label">Orientation</span>
            <select name="orientation" class="profil-select">
              <option value="" <%= !user.orientation ? 'selected' : '' %>>Non pr&eacute;cis&eacute;e</option>
              <option value="hetero" <%= user.orientation === 'hetero' ? 'selected' : '' %>>H&eacute;t&eacute;ro</option>
              <option value="gay" <%= user.orientation === 'gay' ? 'selected' : '' %>>Gay</option>
              <option value="bi" <%= user.orientation === 'bi' ? 'selected' : '' %>>Bi</option>
            </select>
          </label>
        </div>

        <label class="profil-field" id="identite-email-password-row" hidden>
          <span class="profil-field-label">Mot de passe actuel</span>
          <input type="password" name="email_password" autocomplete="current-password" class="profil-field-input" />
          <span class="profil-card-desc">Requis pour confirmer le changement d&rsquo;adresse mail. Un mail pr&eacute;viendra l&rsquo;ancienne adresse.</span>
        </label>

        <div class="profil-identite-submit">
          <button type="submit" class="profil-btn-primary">Enregistrer</button>
        </div>
      </section>
    </form>

    <section class="profil-panel">
      <h2 class="profil-panel-title">Pages li&eacute;es</h2>
      <div class="profil-panel-grid profil-panel-grid--2col">
        <div class="profil-card">
          <span class="profil-card-head">Mot de passe</span>
          <p class="profil-card-desc">Changez le mot de passe de votre compte.</p>
          <a href="/favoris/mot-de-passe" class="profil-card-btn">Changer &rarr;</a>
        </div>

        <div class="profil-card">
          <span class="profil-card-head">Historique</span>
          <p class="profil-card-desc">Vos consultations r&eacute;centes (codex, images, BD).</p>
          <a href="/favoris/historique" class="profil-card-btn">Voir &rarr;</a>
        </div>

        <div class="profil-card">
          <span class="profil-card-head">&Agrave; lire plus tard</span>
          <p class="profil-card-desc">Les pages du codex mises de c&ocirc;t&eacute; pour plus tard.</p>
          <a href="/favoris/a-lire-plus-tard" class="profil-card-btn">Voir &rarr;</a>
        </div>

        <% if (currentUser.isAdmin) { %>
        <div class="profil-card">
          <span class="profil-card-head">Journal technique</span>
          <p class="profil-card-desc">Historique des connexions et &eacute;v&eacute;nements de s&eacute;curit&eacute;.</p>
          <a href="/favoris/journal" class="profil-card-btn">Voir &rarr;</a>
        </div>
        <% } %>
      </div>
    </section>

  </div>

</main>

<script nonce="<%= nonce %>">
(function () {
  var emailInput = document.getElementById("identite-email-input");
  var pwdRow = document.getElementById("identite-email-password-row");
  if (emailInput && pwdRow) {
    var original = emailInput.dataset.original || "";
    function sync() {
      pwdRow.hidden = emailInput.value.trim() === original;
    }
    sync();
    emailInput.addEventListener("input", sync);
  }

  var sexeSelect = document.getElementById("sexe-select");
  var sexeIcon = document.getElementById("sexe-icon");
  if (sexeSelect && sexeIcon) {
    var SEXE_ICONS = {
      "":      { symbol: "?", cls: "" },
      femme:   { symbol: "♀", cls: "profil-sexe-icon--femme" },
      homme:   { symbol: "♂", cls: "profil-sexe-icon--homme" },
      autre:   { symbol: "⚧", cls: "profil-sexe-icon--autre" }
    };
    function syncSexe() {
      var info = SEXE_ICONS[sexeSelect.value] || SEXE_ICONS[""];
      sexeIcon.textContent = info.symbol;
      sexeIcon.className = "profil-sexe-icon" + (info.cls ? " " + info.cls : "");
    }
    syncSexe();
    sexeSelect.addEventListener("change", syncSexe);
  }
})();
</script>

<%- include('partials/foot') %>
