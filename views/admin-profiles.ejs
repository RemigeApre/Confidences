<%- include('partials/head', { title: 'Admin : Profils' }) %>
<main class="container wide">
  <div class="admin-header">
    <h1>G&eacute;rer les profils</h1>
    <a href="/admin" class="link-button">&larr; Retour au panneau admin</a>
  </div>

  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr><th>Profil</th><th>Identifiant</th><th>R&ocirc;le</th><th>Nouveau mot de passe</th></tr>
      </thead>
      <tbody>
        <% users.forEach(function (u) { %>
          <tr>
            <td><%= u.displayName %></td>
            <td><%= u.username %></td>
            <td><%= u.isAdmin ? "Admin" : "Profil" %></td>
            <td>
              <form method="POST" action="/admin/profils/<%= u.id %>/password" class="admin-inline-form">
                <input type="password" name="password" placeholder="nouveau mot de passe" required />
                <button type="submit" class="link-button">R&eacute;initialiser</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="result-section">
    <h2>Nouveau profil</h2>
    <form method="POST" action="/admin/profils" class="admin-new-profile-form">
      <input type="text" name="display_name" placeholder="Nom affich&eacute; (ex: Manon)" required />
      <input type="text" name="username" placeholder="identifiant de connexion" required autocomplete="off" />
      <input type="password" name="password" placeholder="mot de passe" required />
      <label class="chip-option">
        <input type="checkbox" name="is_admin" />
        <span>Acc&egrave;s admin (peut g&eacute;rer les profils)</span>
      </label>
      <button type="submit">Cr&eacute;er le profil</button>
    </form>
  </div>
</main>
<%- include('partials/foot') %>
