<%- include('partials/head', { title: 'Admin : ' + detail.user.displayName + ' : Quizz', extraCss: ['admin.css'] }) %>

<%- include('partials/admin-nav') %>

<div class="aud-layout">
  <%- include('partials/admin-user-nav', { detail: detail, roleHue: roleHue }) %>

  <main class="aud-content">

    <% if (!attempt || !liveScores) { %>
      <p class="admin-muted" style="margin-top:2rem">Aucune r&eacute;ponse enregistr&eacute;e.</p>
    <% } else { %>

    <%
      /* ── helpers ── */
      function pct(sc) { return sc ? sc.percentage : 0; }

      function barColor(p) {
        if (p >= 70) return '#4ade80';
        if (p >= 40) return '#facc15';
        return '#94a3b8';
      }

      /* Score global (toutes sections matrix) */
      var totalRaw = 0, totalMax = 0;
      matrixSections.forEach(function(s) {
        var sc = liveScores.sections[s.key];
        if (sc) { totalRaw += sc.raw; totalMax += sc.max; }
      });
      var globalPct = totalMax ? Math.round(totalRaw / totalMax * 1000) / 10 : 0;

      /* Section profil corps */
      var corpsSection = config.sections.find(function(s) { return s.type === 'profile'; });
      var corpsScore = corpsSection ? liveScores.sections[corpsSection.key] : null;
    %>

    <%# ── Score global ── %>
    <div class="qz-global">
      <div class="qz-global-ring" style="--p:<%= globalPct %>">
        <svg viewBox="0 0 36 36">
          <circle class="qz-ring-bg" cx="18" cy="18" r="15.9" fill="none" stroke-width="2.5"/>
          <circle class="qz-ring-fill" cx="18" cy="18" r="15.9" fill="none" stroke-width="2.5"
            stroke-dasharray="<%= (globalPct * 100 / 100).toFixed(1) %> 100"
            stroke="<%= barColor(globalPct) %>"
            transform="rotate(-90 18 18)"
            stroke-linecap="round"/>
        </svg>
        <span class="qz-global-pct"><%= globalPct %>%</span>
      </div>
      <div class="qz-global-body">
        <div class="qz-global-label">Score global</div>
        <div class="qz-global-sub">Derni&egrave;re modification : <%= new Date(attempt.updatedAt).toLocaleString('fr-FR') %></div>
        <a href="/ponhgup/live/<%= detail.user.id %>" class="qz-detail-link">D&eacute;tail complet &rsaquo;</a>
      </div>
      <% if (detail.user.ultraMode === 'visible') { %>
        <span class="qz-ultra-badge">Ultra : affiché</span>
      <% } %>
    </div>

    <%# ── Barres par section matrix ── %>
    <div class="qz-sections">
      <% matrixSections.forEach(function(s) { %>
        <% var sc = liveScores.sections[s.key]; if (!sc) return; %>
        <% var p = sc.percentage; %>
        <div class="qz-section-row">
          <span class="qz-section-title"><%= s.title %></span>
          <div class="qz-bar-wrap">
            <div class="qz-bar-fill" style="width:<%= p %>%;background:<%= barColor(p) %>"></div>
          </div>
          <span class="qz-section-pct" style="color:<%= barColor(p) %>"><%= p %>%</span>
        </div>

        <%# Rankings de cette section %>
        <% if (s.rankings && s.rankings.length) { %>
          <% s.rankings.forEach(function(r) { %>
            <% var items = sc.rankings && sc.rankings[r.id]; %>
            <% if (items && items.length) { %>
            <div class="qz-sub-row">
              <span class="qz-sub-label"><%= r.title || r.id %></span>
              <div class="qz-chips">
                <% items.slice(0, 5).forEach(function(it, i) { %>
                  <span class="qz-chip<%= i === 0 ? ' qz-chip--top' : '' %>"><%= it %></span>
                <% }) %>
              </div>
            </div>
            <% } %>
          <% }) %>
        <% } %>

        <%# Spectrums de cette section %>
        <% if (s.spectrums && s.spectrums.length) { %>
          <% s.spectrums.forEach(function(sp) { %>
            <% var val = sc.spectrums && sc.spectrums[sp.id]; %>
            <% if (val) { %>
            <div class="qz-sub-row">
              <span class="qz-sub-label"><%= sp.title || sp.id %></span>
              <span class="qz-spectrum-val"><%= val %></span>
            </div>
            <% } %>
          <% }) %>
        <% } %>

        <%# Multiselects de cette section %>
        <% if (s.multiselects && s.multiselects.length) { %>
          <% s.multiselects.forEach(function(ms) { %>
            <% var vals = sc.multiselects && sc.multiselects[ms.id]; %>
            <% if (vals && vals.length) { %>
            <div class="qz-sub-row">
              <span class="qz-sub-label"><%= ms.title || ms.id %></span>
              <div class="qz-chips">
                <% vals.forEach(function(v) { %><span class="qz-chip"><%= v %></span><% }) %>
              </div>
            </div>
            <% } %>
          <% }) %>
        <% } %>

      <% }) %>
    </div>

    <%# ── Section profil corps ── %>
    <% if (corpsScore && corpsSection) { %>
    <div class="qz-profile-block">
      <div class="qz-profile-title">Profil / corps</div>
      <div class="qz-profile-grid">
        <% corpsSection.fields.forEach(function(f) { %>
          <% var val = corpsScore.fields && corpsScore.fields[f.id]; %>
          <% if (val) { %>
          <div class="qz-profile-cell">
            <span class="qz-profile-key"><%= f.id %></span>
            <span class="qz-profile-val"><%= val %></span>
          </div>
          <% } %>
        <% }) %>
      </div>
      <% if (corpsSection.rankings) { %>
        <% corpsSection.rankings.forEach(function(r) { %>
          <% var items = corpsScore.rankings && corpsScore.rankings[r.id]; %>
          <% if (items && items.length) { %>
          <div class="qz-sub-row" style="margin-top:.5rem">
            <span class="qz-sub-label"><%= r.title || r.id %></span>
            <div class="qz-chips">
              <% items.slice(0,5).forEach(function(it,i){ %>
                <span class="qz-chip<%= i===0?' qz-chip--top':'' %>"><%= it %></span>
              <% }) %>
            </div>
          </div>
          <% } %>
        <% }) %>
      <% } %>
    </div>
    <% } %>

    <%# ── Lootboxes ── %>
    <div class="qz-lootbox-block">
      <span class="qz-lootbox-count"><%= lootboxCount %></span>
      <span class="qz-lootbox-label">lootbox<%= lootboxCount > 1 ? 'es' : '' %> en attente</span>
      <form method="POST" action="/ponhgup/profils/<%= detail.user.id %>/grant-lootbox" class="qz-lootbox-form">
        <input type="number" name="count" value="1" min="1" max="20" class="admin-input admin-input--sm" />
        <button type="submit" class="admin-btn-primary">Accorder</button>
      </form>
      <form method="POST" action="/ponhgup/profils/<%= detail.user.id %>/reset-progress"
        onsubmit="return confirm('Remettre à zéro les pièces, le coffre et les compteurs de <%= detail.user.displayName %> ?')">
        <button type="submit" class="admin-btn-danger" style="font-size:.8rem">RAZ (pièces + coffre)</button>
      </form>
    </div>

    <% } %>

  </main>
</div>
<%- include('partials/foot') %>
