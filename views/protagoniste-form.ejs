<%- include('partials/head', { title: protagoniste ? 'Modifier : ' + protagoniste.name : 'Nouveau personnage' }) %>
<main class="container" style="max-width: 720px; margin: 0 auto">
  <%- include('partials/top-nav', { config: config, navTitle: protagoniste ? protagoniste.name : 'Nouveau personnage', navBack: protagoniste ? '/protagonistes/' + protagoniste.id : '/protagonistes' }) %>

  <a href="<%= protagoniste ? '/protagonistes/' + protagoniste.id : '/protagonistes' %>" class="wf-back-btn">&#8592; Retour</a>
  <div class="wf-actions-right">
    <button type="submit" form="prot-form" class="wf-save-btn">Enregistrer</button>
  </div>
  <% if (protagoniste) { %>
  <form method="POST" action="/protagonistes/<%= protagoniste.id %>/delete" class="wf-delete-form-fixed"
    onsubmit="return confirm('Supprimer ce personnage d\u00e9finitivement ?')">
    <button type="submit" class="wf-delete-btn-fixed" title="Supprimer le personnage">&#128465;</button>
  </form>
  <% } %>

  <div class="nv-form-wrap">
    <form method="POST" action="<%= protagoniste ? '/protagonistes/' + protagoniste.id + '/update' : '/protagonistes/new' %>"
      class="nv-form" id="prot-form" data-no-enter-submit enctype="multipart/form-data">

      <input type="text" name="name" class="nv-form-title-input" required maxlength="200"
        value="<%= protagoniste ? protagoniste.name : '' %>" placeholder="Nom du personnage…" />

      <%# ── Image du personnage ── %>
      <div class="prot-form-img-section prot-form-img-section--centered">
        <div class="prot-form-field-label">Photo / Illustration</div>
        <div class="prot-form-img-wrap" id="prot-img-wrap">
          <% if (protagoniste && protagoniste.image_path) { %>
            <div class="prot-form-img-holder" id="prot-img-holder">
              <img src="<%= protagoniste.image_path %>" alt="Image actuelle" class="prot-form-img-thumb" id="prot-img-thumb" />
              <button type="button" class="prot-form-img-remove-btn" id="prot-img-remove-btn" title="Supprimer l'image" aria-label="Supprimer l'image">&times;</button>
              <input type="hidden" name="remove_image" id="prot-remove-hidden" value="" />
            </div>
          <% } else { %>
            <div class="prot-form-img-holder" id="prot-img-holder" style="display:none">
              <img src="" alt="Aperçu" class="prot-form-img-thumb" id="prot-img-thumb" />
              <button type="button" class="prot-form-img-remove-btn" id="prot-img-remove-btn" title="Supprimer l'image" aria-label="Supprimer l'image">&times;</button>
              <input type="hidden" name="remove_image" id="prot-remove-hidden" value="" />
            </div>
          <% } %>
          <label class="prot-form-img-pick" id="prot-img-pick-btn">
            <input type="file" name="character_image" accept="image/*" id="prot-img-input" style="display:none" />
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            <span id="prot-img-pick-label">Choisir une image…</span>
          </label>
        </div>
      </div>

      <%# ── Genre — boutons radio ── %>
      <div class="prot-form-field-group">
        <div class="prot-form-field-label">Genre</div>
        <div class="prot-gender-btns">
          <%
            var genderOpts = [
              { value: 'femme', label: 'Femme' },
              { value: 'homme', label: 'Homme' },
              { value: 'autre', label: 'Autre' }
            ];
            var currentGender = protagoniste ? (protagoniste.gender || 'autre') : 'autre';
          %>
          <% genderOpts.forEach(function(opt) { %>
            <label class="prot-gender-btn prot-gender-btn--<%= opt.value || 'none' %><%= currentGender === opt.value ? ' active' : '' %>">
              <input type="radio" name="gender" value="<%= opt.value %>" <%= currentGender === opt.value ? 'checked' : '' %> style="display:none" />
              <% if (opt.value === 'femme') { %>
                <svg class="prot-gender-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5"/><line x1="12" y1="14" x2="12" y2="22"/><line x1="9" y1="19" x2="15" y2="19"/></svg>
              <% } else if (opt.value === 'homme') { %>
                <svg class="prot-gender-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="14" r="5"/><line x1="14.35" y1="9.65" x2="21" y2="3"/><polyline points="16 3 21 3 21 8"/></svg>
              <% } else if (opt.value === 'autre') { %>
                <svg class="prot-gender-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="17" x2="12" y2="22"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="19" y1="5" x2="16" y2="8"/><polyline points="17 4 20 4 20 7"/></svg>
              <% } %>
              <%= opt.label %>
            </label>
          <% }) %>
        </div>
      </div>

      <%# ── Classification Ultra / Irréaliste ── %>
      <div class="prot-form-field-group">
        <div class="prot-form-field-label">Classification <span style="font-weight:400;font-size:.75rem;opacity:.6">(détermine la visibilité selon préférences)</span></div>
        <input type="hidden" name="special" id="prot-special-hidden" value="<%= protagoniste ? (protagoniste.special || '') : '' %>" />
        <div class="prot-special-btns">
          <button type="button" class="prot-special-btn<%= (!protagoniste || !protagoniste.special) ? ' active' : '' %>" data-val="">Normal</button>
          <button type="button" class="prot-special-btn prot-special-btn--ultra<%= (protagoniste && protagoniste.special === 'ultra') ? ' active' : '' %>" data-val="ultra">Ultra</button>
          <button type="button" class="prot-special-btn prot-special-btn--irrealiste<%= (protagoniste && protagoniste.special === 'irrealiste') ? ' active' : '' %>" data-val="irrealiste">Irréaliste</button>
        </div>
      </div>

      <%# ── Nature — select élégant ── %>
      <div class="prot-form-field-group">
        <label class="prot-form-field-label" for="prot-nature">Nature</label>
        <select name="nature" id="prot-nature" class="prot-form-select-elegant">
          <option value="">— non définie —</option>
          <option value="humain"  <%= protagoniste && protagoniste.nature === 'humain'  ? 'selected' : '' %>>Humain</option>
          <option value="monstre" <%= protagoniste && protagoniste.nature === 'monstre' ? 'selected' : '' %>>Monstre</option>
          <option value="animal"  <%= protagoniste && protagoniste.nature === 'animal'  ? 'selected' : '' %>>Animal</option>
          <option value="pokemon" <%= protagoniste && protagoniste.nature === 'pokemon' ? 'selected' : '' %>>Pokémon</option>
          <option value="autre"   <%= protagoniste && protagoniste.nature === 'autre'   ? 'selected' : '' %>>Autre</option>
        </select>
      </div>

      <%# ── Évolutions (Pokémon / nature évolutive) ── %>
      <div class="prot-form-field-group prot-evo-section" id="prot-evo-section">
        <div class="prot-form-field-label">Chaîne d'évolution <span style="font-weight:400;font-size:.75rem;opacity:.6">(formes précédentes, dans l'ordre)</span></div>
        <input type="hidden" name="evolutions" id="prot-evo-hidden"
          value="<%= protagoniste && protagoniste.evolutions ? JSON.stringify(protagoniste.evolutions) : '[]' %>" />
        <div class="prot-evo-chain" id="prot-evo-chain">
          <%
            var evols = (protagoniste && protagoniste.evolutions) ? protagoniste.evolutions : [];
            evols.forEach(function(evo, i) {
          %>
            <div class="prot-evo-entry" data-idx="<%= i %>">
              <input type="text" class="prot-evo-inp lbep-input" value="<%= evo %>" placeholder="Forme précédente…" maxlength="100" />
              <button type="button" class="prot-evo-btn prot-evo-up" title="Monter">↑</button>
              <button type="button" class="prot-evo-btn prot-evo-down" title="Descendre">↓</button>
              <button type="button" class="prot-evo-btn prot-evo-remove" title="Supprimer">×</button>
            </div>
          <% }) %>
        </div>
        <div class="prot-evo-final">
          <span class="prot-evo-arrow">→</span>
          <span class="prot-evo-final-name"><%= protagoniste ? protagoniste.name : '(forme finale)' %></span>
          <span style="font-size:.7rem;opacity:.5;margin-left:.4rem">forme principale</span>
        </div>
        <button type="button" class="prot-evo-add-btn" id="prot-evo-add">+ Ajouter une forme précédente</button>
      </div>

      <textarea name="description" class="nv-form-content" rows="10"
        placeholder="Description, traits de caractère, apparence…"
        style="resize:vertical"><%= protagoniste ? protagoniste.description : '' %></textarea>

      <%# ── Parodie / Univers ── %>
      <%- include('partials/parody-input', {
            idPrefix:  'protf',
            mainValue: protagoniste ? protagoniste.parody    : '',
            subValue:  protagoniste ? protagoniste.sub_parody : '',
            mainPh:    'Univers (ex\u00a0: Pok\u00e9mon)\u2026'
          }) %>

      <%# ── Tags ── %>
      <% if (allTags && allTags.length) { %>
        <script id="prot-all-tags" type="application/json"><%- JSON.stringify(allTags) %></script>
      <% } %>
      <div class="wiki-tags-widget">
        <div class="wiki-tags-board">
          <input type="text" class="wiki-tags-typing" placeholder="Ajouter un tag…" autocomplete="off" />
        </div>
        <input type="hidden" name="tags" class="wiki-tags-hidden"
          value="<%= protagoniste && protagoniste.tags ? protagoniste.tags.join(', ') : '' %>" />
        <% if (allTags && allTags.length) { %>
          <div class="wiki-tag-suggestions">
            <% allTags.slice(0, 20).forEach(function(t) { %>
              <button type="button" class="wiki-tag-suggest-chip" data-tag="<%= t %>"><%= t %></button>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="wiki-form-actions wf-mobile-actions">
        <button type="submit">Enregistrer</button>
      </div>
    </form>
  </div>

  <script>
  (function() {
    // ── Image : preview + croix ──
    var imgInput   = document.getElementById('prot-img-input');
    var imgThumb   = document.getElementById('prot-img-thumb');
    var imgHolder  = document.getElementById('prot-img-holder');
    var removeBtn  = document.getElementById('prot-img-remove-btn');
    var removeHid  = document.getElementById('prot-remove-hidden');
    var pickBtn    = document.getElementById('prot-img-pick-btn');
    var pickLabel  = document.getElementById('prot-img-pick-label');

    // Sync initial visibility
    if (imgHolder && imgHolder.style.display !== 'none' && pickBtn) pickBtn.hidden = true;

    if (imgInput) {
      imgInput.addEventListener('change', function() {
        var file = imgInput.files[0];
        if (!file) return;
        imgThumb.src = URL.createObjectURL(file);
        imgHolder.style.display = '';
        if (removeHid) removeHid.value = '';
        if (pickBtn) pickBtn.hidden = true;
      });
    }
    if (removeBtn) {
      removeBtn.addEventListener('click', function() {
        imgHolder.style.display = 'none';
        imgThumb.src = '';
        if (removeHid) removeHid.value = '1';
        if (imgInput) imgInput.value = '';
        if (pickBtn) pickBtn.hidden = false;
      });
    }

    // ── Genre : boutons radio ──
    document.querySelectorAll('.prot-gender-btns .prot-gender-btn').forEach(function(lbl) {
      lbl.addEventListener('click', function() {
        document.querySelectorAll('.prot-gender-btns .prot-gender-btn').forEach(function(b) { b.classList.remove('active'); });
        lbl.classList.add('active');
      });
    });

    // ── Tags widget ──
    document.querySelectorAll('.wiki-tags-widget').forEach(function(widget) {
      var board      = widget.querySelector('.wiki-tags-board');
      var typer      = widget.querySelector('.wiki-tags-typing');
      var hidden     = widget.querySelector('.wiki-tags-hidden');
      var suggestBox = widget.querySelector('.wiki-tag-suggestions');
      if (!board || !typer || !hidden) return;
      var tags = (hidden.value || '').split(/[,;]+/).map(function(t){ return t.trim(); }).filter(Boolean);
      function findTag(t) { return tags.indexOf(t) !== -1; }
      function syncHidden() { hidden.value = tags.join(', '); }
      function syncSuggest() {
        if (!suggestBox) return;
        suggestBox.querySelectorAll('.wiki-tag-suggest-chip').forEach(function(c){
          var isSelected = findTag(c.dataset.tag);
          c.classList.toggle('active', isSelected);
          c.hidden = isSelected;
        });
      }
      var chipsArea = widget.querySelector('.wiki-tags-chips');
      if (!chipsArea) {
        chipsArea = document.createElement('div');
        chipsArea.className = 'wiki-tags-chips';
        board.parentNode.insertBefore(chipsArea, board);
      }
      function renderBoard() {
        chipsArea.querySelectorAll('.wiki-chip').forEach(function(c){ c.remove(); });
        tags.forEach(function(t) {
          var chip = document.createElement('span');
          chip.className = 'link-tag-pill wiki-chip';
          chip.style.cssText = 'background:hsl(340,50%,38%);color:#fff;cursor:pointer;margin:2px 3px 2px 0;display:inline-flex;align-items:center;padding:2px 8px;border-radius:20px;font-size:.75rem';
          chip.textContent = t;
          chip.title = 'Cliquer pour retirer';
          chip.addEventListener('click', function(){ tags = tags.filter(function(x){ return x !== t; }); syncHidden(); renderBoard(); syncSuggest(); });
          chipsArea.appendChild(chip);
        });
        syncHidden(); syncSuggest();
      }
      function addTag(t) { t = t.trim(); if (t && !findTag(t)) { tags.push(t); renderBoard(); } }
      function removeTag(t) { tags = tags.filter(function(x){ return x !== t; }); syncHidden(); renderBoard(); syncSuggest(); }
      typer.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ',' || e.key === ';') { e.preventDefault(); if (typer.value.trim()) { addTag(typer.value.trim()); typer.value = ''; closeAc(); } }
        else if (e.key === 'Backspace' && !typer.value && tags.length) removeTag(tags[tags.length - 1]);
      });
      typer.addEventListener('blur', function() { if (typer.value.trim()) { addTag(typer.value.trim()); typer.value = ''; } setTimeout(closeAc, 160); });
      board.addEventListener('click', function(e) { if (e.target === board) typer.focus(); });
      if (suggestBox) suggestBox.querySelectorAll('.wiki-tag-suggest-chip').forEach(function(chip) {
        chip.addEventListener('click', function() { if (!findTag(chip.dataset.tag)) addTag(chip.dataset.tag); else removeTag(chip.dataset.tag); });
      });
      var allAvail = (function(){ var el = document.getElementById('prot-all-tags'); if (el) { try { return JSON.parse(el.textContent); } catch(_){} } return []; })();
      var acDrop = document.createElement('ul'); acDrop.className = 'wiki-tag-autocomplete'; acDrop.hidden = true;
      board.parentNode.insertBefore(acDrop, board.nextSibling);
      var acSel = -1;
      function clearAcDrop() { while(acDrop.firstChild) acDrop.removeChild(acDrop.firstChild); }
      function closeAc() { acDrop.hidden = true; clearAcDrop(); acSel = -1; }
      function showAc(q) {
        q = (q||'').trim().toLowerCase(); if (!q) { closeAc(); return; }
        var m = allAvail.filter(function(t){ return t.toLowerCase().indexOf(q) !== -1 && !findTag(t); }).slice(0,9);
        if (!m.length) { closeAc(); return; }
        clearAcDrop(); acSel = -1;
        m.forEach(function(t){ var li = document.createElement('li'); li.className='wiki-tag-ac-item'; li.textContent=t; li.addEventListener('mousedown',function(e){ e.preventDefault(); addTag(t); typer.value=''; closeAc(); typer.focus(); }); acDrop.appendChild(li); });
        acDrop.hidden = false;
      }
      typer.addEventListener('input', function() {
        showAc(typer.value);
        if (suggestBox) { var q = typer.value.trim().toLowerCase(); suggestBox.querySelectorAll('.wiki-tag-suggest-chip').forEach(function(c){ c.hidden = q.length > 0 && c.dataset.tag.toLowerCase().indexOf(q) === -1; }); }
      });
      typer.addEventListener('keydown', function(e) {
        if (acDrop.hidden) return;
        var items = acDrop.querySelectorAll('.wiki-tag-ac-item');
        if (e.key==='ArrowDown'){ e.preventDefault(); acSel=Math.min(acSel+1,items.length-1); items.forEach(function(li,i){ li.classList.toggle('selected',i===acSel); }); }
        else if (e.key==='ArrowUp'){ e.preventDefault(); acSel=Math.max(acSel-1,0); items.forEach(function(li,i){ li.classList.toggle('selected',i===acSel); }); }
        else if ((e.key==='Enter'||e.key==='Tab') && acSel>=0 && items[acSel]){ e.preventDefault(); e.stopImmediatePropagation(); addTag(items[acSel].textContent); typer.value=''; closeAc(); }
        else if (e.key==='Escape') closeAc();
      }, true);
      renderBoard();
    });
  })();

  // ── Évolutions ──
  (function() {
    var chain   = document.getElementById('prot-evo-chain');
    var hidden  = document.getElementById('prot-evo-hidden');
    var addBtn  = document.getElementById('prot-evo-add');
    if (!chain || !hidden || !addBtn) return;

    function syncHidden() {
      var vals = Array.from(chain.querySelectorAll('.prot-evo-inp')).map(function(i) { return i.value.trim(); }).filter(Boolean);
      hidden.value = JSON.stringify(vals);
    }

    function makeEntry(val) {
      var row = document.createElement('div');
      row.className = 'prot-evo-entry';
      var inp = document.createElement('input');
      inp.type = 'text'; inp.className = 'prot-evo-inp lbep-input';
      inp.value = val || ''; inp.placeholder = 'Forme précédente…'; inp.maxLength = 100;
      inp.addEventListener('input', syncHidden);
      var upBtn = document.createElement('button'); upBtn.type = 'button'; upBtn.className = 'prot-evo-btn prot-evo-up'; upBtn.title = 'Monter'; upBtn.textContent = '↑';
      var dnBtn = document.createElement('button'); dnBtn.type = 'button'; dnBtn.className = 'prot-evo-btn prot-evo-down'; dnBtn.title = 'Descendre'; dnBtn.textContent = '↓';
      var rmBtn = document.createElement('button'); rmBtn.type = 'button'; rmBtn.className = 'prot-evo-btn prot-evo-remove'; rmBtn.title = 'Supprimer'; rmBtn.textContent = '×';
      upBtn.addEventListener('click', function() { var prev = row.previousElementSibling; if (prev && prev.classList.contains('prot-evo-entry')) { chain.insertBefore(row, prev); syncHidden(); } });
      dnBtn.addEventListener('click', function() { var next = row.nextElementSibling; if (next && next.classList.contains('prot-evo-entry')) { chain.insertBefore(next, row); syncHidden(); } });
      rmBtn.addEventListener('click', function() { row.remove(); syncHidden(); });
      row.appendChild(inp); row.appendChild(upBtn); row.appendChild(dnBtn); row.appendChild(rmBtn);
      return row;
    }

    // Wire existing entries rendered server-side
    chain.querySelectorAll('.prot-evo-entry').forEach(function(row) {
      var inp = row.querySelector('.prot-evo-inp');
      var upBtn = row.querySelector('.prot-evo-up');
      var dnBtn = row.querySelector('.prot-evo-down');
      var rmBtn = row.querySelector('.prot-evo-remove');
      if (inp) inp.addEventListener('input', syncHidden);
      if (upBtn) upBtn.addEventListener('click', function() { var prev = row.previousElementSibling; if (prev && prev.classList.contains('prot-evo-entry')) { chain.insertBefore(row, prev); syncHidden(); } });
      if (dnBtn) dnBtn.addEventListener('click', function() { var next = row.nextElementSibling; if (next && next.classList.contains('prot-evo-entry')) { chain.insertBefore(next, row); syncHidden(); } });
      if (rmBtn) rmBtn.addEventListener('click', function() { row.remove(); syncHidden(); });
    });

    addBtn.addEventListener('click', function() {
      chain.appendChild(makeEntry(''));
      var newInp = chain.lastElementChild.querySelector('.prot-evo-inp');
      if (newInp) newInp.focus();
    });
  })();
  // ── Classification (special) ──
  var specialHidden = document.getElementById('prot-special-hidden');
  document.querySelectorAll('.prot-special-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.prot-special-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      if (specialHidden) specialHidden.value = btn.dataset.val || '';
    });
  });
  </script>

</main>
<%- include('partials/foot') %>
