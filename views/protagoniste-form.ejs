<%- include('partials/head', { title: protagoniste ? 'Modifier : ' + protagoniste.name : 'Nouveau personnage' }) %>
<%
  var _isEn   = locals.editLang === 'en';
  var _trans  = locals.translations || {};
  var _races  = races || [];
  var _curRaceId    = protagoniste ? (protagoniste.race_id || '') : '';
  var _curClanId    = protagoniste ? (protagoniste.clan_id || '') : '';
  var _curRaceClans = _races.find(function(r){ return String(r.id) === String(_curRaceId); });
  var evols   = (protagoniste && protagoniste.evolutions) ? protagoniste.evolutions : [];
  // evols est maintenant [{name, linked_id}] grâce à parseEvolutions
  var genderOpts = [
    { value: 'femme', label: 'Femme' },
    { value: 'homme', label: 'Homme' },
    { value: 'autre', label: 'Autre' }
  ];
  var currentGender = protagoniste ? (protagoniste.gender || '') : '';
  var _hasParody = protagoniste && (protagoniste.parody || protagoniste.sub_parody);
  var _evoEnInit = evols.map(function(_,i){ return _trans['evo_'+i+'_en'] || ''; });
  // Valeurs initiales selon la langue d'édition
  var _vPrenom = _isEn ? (_trans.prenom || '') : (protagoniste ? (protagoniste.prenom || '') : '');
  var _vNom    = _isEn ? (_trans.nom    || '') : (protagoniste ? (protagoniste.nom    || '') : '');
  var _vDesc   = _isEn ? (_trans.description || '') : (protagoniste ? (protagoniste.description || '') : '');
  var _vDescPhys  = _isEn ? (_trans.description_physique || '') : (protagoniste ? (protagoniste.description_physique || '') : '');
  var _vDescOeuvre = _isEn ? (_trans.description_oeuvre || '') : (protagoniste ? (protagoniste.description_oeuvre || '') : '');
%>
<main class="container wide">
  <%- include('partials/top-nav', { config: config, navTitle: protagoniste ? protagoniste.name : 'Nouveau personnage', navBack: protagoniste ? '/protagonistes/' + protagoniste.id : '/protagonistes' }) %>

  <% if (protagoniste) { %>
  <form method="POST" action="/protagonistes/<%= protagoniste.id %>/delete" id="prot-delete-form"
    onsubmit="return confirm('Supprimer ce personnage d\u00e9finitivement ?')"></form>
  <% } %>

  <form method="POST" action="<%= protagoniste ? '/protagonistes/' + protagoniste.id + '/update' : '/protagonistes/new' %>"
    class="nv-form" id="prot-form" data-no-enter-submit enctype="multipart/form-data">

    <%# Toujours présents — valeurs gérées par JS pour le switch FR/EN sans rechargement %>
    <input type="hidden" name="_editLang" id="prot-editlang-hidden" value="<%= _isEn ? 'en' : '' %>" />
    <input type="hidden" name="evolutions_en" id="prot-evo-en-hidden"
      value="<%- JSON.stringify(_evoEnInit) %>" />

    <%# ── VOLET GAUCHE FIXE ── %>
    <aside class="prot-edit-sidebar" id="prot-edit-sidebar">
      <div class="prot-edit-sidebar-inner">

        <div class="prot-sb-back-wrap">
          <a href="<%= protagoniste ? '/protagonistes/' + protagoniste.id : '/protagonistes' %>" class="prot-sb-back-btn">Retour</a>
        </div>

        <%# Genre %>
        <div class="prot-sb-section">
          <div class="prot-gender-btns prot-gender-btns--icon">
            <% genderOpts.forEach(function(opt) { %>
            <label class="prot-gender-btn prot-gender-btn--<%= opt.value %><%= currentGender === opt.value ? ' active' : '' %>" title="<%= opt.label %>">
              <input type="radio" name="gender" value="<%= opt.value %>" <%= currentGender === opt.value ? 'checked' : '' %> style="display:none" />
              <% if (opt.value === 'femme') { %>
              <svg class="prot-gender-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5"/><line x1="12" y1="14" x2="12" y2="22"/><line x1="9" y1="19" x2="15" y2="19"/></svg>
              <% } else if (opt.value === 'homme') { %>
              <svg class="prot-gender-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="14" r="5"/><line x1="14.35" y1="9.65" x2="21" y2="3"/><polyline points="16 3 21 3 21 8"/></svg>
              <% } else { %>
              <svg class="prot-gender-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="17" x2="12" y2="22"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="19" y1="5" x2="16" y2="8"/><polyline points="17 4 20 4 20 7"/></svg>
              <% } %>
            </label>
            <% }) %>
          </div>
        </div>

        <%# Classification %>
        <div class="prot-sb-section">
          <input type="hidden" name="special" id="prot-special-hidden" value="<%= protagoniste ? (protagoniste.special || '') : '' %>" />
          <div class="prot-special-btns prot-special-btns--center">
            <button type="button" class="prot-special-btn prot-special-btn--ultra<%= (protagoniste && protagoniste.special === 'ultra') ? ' active' : '' %>" data-val="ultra">Ultra</button>
            <button type="button" class="prot-special-btn prot-special-btn--irrealiste<%= (protagoniste && protagoniste.special === 'irrealiste') ? ' active' : '' %>" data-val="irrealiste">Irr&eacute;aliste</button>
          </div>
        </div>

        <%# Nature + Espèce — même ligne %>
        <div class="prot-sb-section prot-sb-section--row">
          <select name="nature" id="prot-nature" class="prot-form-select-elegant prot-form-select-elegant--sm">
            <option value="">Nature</option>
            <option value="humain"  data-fr-label="Humain"  data-en-label="Human"   <%= protagoniste && protagoniste.nature === 'humain'  ? 'selected' : '' %>><%= _isEn ? 'Human'   : 'Humain'  %></option>
            <option value="monstre" data-fr-label="Monstre" data-en-label="Monster" <%= protagoniste && protagoniste.nature === 'monstre' ? 'selected' : '' %>><%= _isEn ? 'Monster' : 'Monstre' %></option>
            <option value="animal"  data-fr-label="Animal"  data-en-label="Animal"  <%= protagoniste && protagoniste.nature === 'animal'  ? 'selected' : '' %>>Animal</option>
            <option value="autre"   data-fr-label="Autre"   data-en-label="Other"   <%= protagoniste && protagoniste.nature === 'autre'   ? 'selected' : '' %>><%= _isEn ? 'Other'   : 'Autre'   %></option>
          </select>
          <select name="race_id" id="prot-race" class="prot-form-select-elegant prot-form-select-elegant--sm">
            <option value="__add__">+ G&eacute;rer les esp&egrave;ces</option>
            <option value="">— aucune —</option>
            <% _races.forEach(function(r) { %>
              <option value="<%= r.id %>" <%= String(_curRaceId) === String(r.id) ? 'selected' : '' %>><%= r.icon ? r.icon + ' ' : '' %><%= r.name %></option>
            <% }) %>
          </select>
        </div>

        <%# Âge + Orientation — même ligne %>
        <div class="prot-sb-section prot-sb-section--row">
          <input type="number" name="age" id="prot-age"
            class="prot-form-select-elegant prot-form-select-elegant--sm"
            min="18" max="999" step="1"
            value="<%= protagoniste && protagoniste.age ? protagoniste.age : '' %>"
            data-placeholder-fr="Âge" data-placeholder-en="Age"
            placeholder="<%= _isEn ? 'Age' : '\u00c2ge' %>" />
          <select name="orientation" id="prot-orientation" class="prot-form-select-elegant prot-form-select-elegant--sm">
            <option value="">Orientation</option>
            <option value="hetero"  data-fr-label="Hétéro"        data-en-label="Hetero"          <%= protagoniste && protagoniste.orientation === 'hetero' ? 'selected' : '' %>><%= _isEn ? 'Hetero'         : 'H\u00e9t\u00e9ro'       %></option>
            <option value="homo"    data-fr-label="Gay"           data-en-label="Gay"             <%= protagoniste && protagoniste.orientation === 'homo'   ? 'selected' : '' %>>Gay</option>
            <option value="bi"      data-fr-label="Bi &amp; curieux" data-en-label="Bi &amp; curious" <%= protagoniste && protagoniste.orientation === 'bi'     ? 'selected' : '' %>><%= _isEn ? 'Bi &amp; curious' : 'Bi &amp; curieux' %></option>
            <option value="autre"   data-fr-label="Autre"         data-en-label="Other"           <%= protagoniste && protagoniste.orientation === 'autre'  ? 'selected' : '' %>><%= _isEn ? 'Other'          : 'Autre'           %></option>
          </select>
        </div>

        <%# Clan %>
        <div class="prot-sb-section" id="prot-clan-group"
          style="<%= (!_curRaceId || !_curRaceClans || !_curRaceClans.clans || !_curRaceClans.clans.length) ? 'display:none' : '' %>">
          <select name="clan_id" id="prot-clan" class="prot-form-select-elegant prot-form-select-elegant--sm">
            <option value="">Clan</option>
            <% if (_curRaceClans && _curRaceClans.clans) { _curRaceClans.clans.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= String(_curClanId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% }); } %>
          </select>
        </div>

        <%# Panneau gestion des races %>
        <div id="prot-race-panel" style="display:none" class="prot-race-panel">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.65rem">
            <span style="font-size:.62rem;font-weight:700;color:#a5b4fc;text-transform:uppercase;letter-spacing:.06em">Races</span>
            <button type="button" id="prot-race-panel-close" style="background:none;border:none;color:#64748b;cursor:pointer;font-size:.95rem;line-height:1;padding:0">&times;</button>
          </div>
          <div style="background:rgba(99,102,241,.07);border:1px solid rgba(99,102,241,.18);border-radius:6px;padding:.5rem .55rem;margin-bottom:.6rem">
            <div style="font-size:.62rem;color:#818cf8;font-weight:600;margin-bottom:.35rem">Nouvelle race</div>
            <div style="display:flex;gap:.3rem;align-items:center;flex-wrap:wrap">
              <input type="text" id="rp-new-race-name" placeholder="Nom…"
                style="flex:1;min-width:60px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:#f1f5f9;border-radius:5px;padding:.2rem .4rem;font-size:.72rem;outline:none;font-family:inherit">
              <input type="text" id="rp-new-race-icon" placeholder="😈" title="Emoji"
                style="width:34px;text-align:center;font-size:.95rem;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:#f1f5f9;border-radius:5px;padding:.2rem 0;outline:none">
              <input type="color" id="rp-new-race-color" value="#6366f1" title="Couleur"
                style="width:24px;height:24px;border:none;background:none;cursor:pointer;padding:0;flex-shrink:0">
              <button type="button" id="rp-create-race-btn"
                style="background:#4f46e5;border:none;color:#fff;font-size:.68rem;padding:.2rem .55rem;border-radius:5px;cursor:pointer;white-space:nowrap">Cr&eacute;er</button>
            </div>
            <span id="rp-create-race-status" style="font-size:.62rem;color:#4ade80;display:block;height:.75em;margin-top:.2rem"></span>
          </div>
          <div id="rp-race-list" style="display:flex;flex-direction:column;gap:.45rem">
            <% if (!_races.length) { %>
              <p style="font-size:.68rem;color:#475569;font-style:italic;margin:0">Aucune race.</p>
            <% } %>
            <% _races.forEach(function(r) { %>
            <div class="rp-race-item" data-race-id="<%= r.id %>"
              style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:6px;padding:.4rem .5rem">
              <div style="display:flex;align-items:center;gap:.35rem;margin-bottom:.3rem">
                <span style="width:7px;height:7px;border-radius:50%;background:<%= r.color || '#6366f1' %>;flex-shrink:0"></span>
                <span style="font-size:.75rem;font-weight:700;color:#e2e8f0;flex:1"><%= r.icon ? r.icon + ' ' : '' %><%= r.name %></span>
                <button type="button" class="rp-delete-race-btn"
                  style="background:none;border:none;color:#ef4444;font-size:.7rem;cursor:pointer;padding:0" title="Supprimer">&#128465;</button>
              </div>
              <div class="rp-clan-list" style="display:flex;flex-wrap:wrap;gap:.2rem;margin-bottom:.3rem">
                <% (r.clans||[]).forEach(function(c) { %>
                  <span class="rp-clan-tag" data-clan-id="<%= c.id %>"
                    style="display:inline-flex;align-items:center;gap:.18rem;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:.08rem .4rem;font-size:.65rem;color:#cbd5e1">
                    <%= c.name %>
                    <button type="button" class="rp-delete-clan-btn" style="background:none;border:none;color:#f87171;cursor:pointer;padding:0;font-size:.75rem;line-height:1">&times;</button>
                  </span>
                <% }) %>
                <% if (!(r.clans||[]).length) { %><span style="font-size:.62rem;color:#475569;font-style:italic">Aucun clan</span><% } %>
              </div>
              <div style="display:flex;gap:.25rem;align-items:center">
                <input type="text" class="rp-new-clan-name" placeholder="+ Clan"
                  style="flex:1;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#f1f5f9;border-radius:4px;padding:.15rem .35rem;font-size:.68rem;outline:none;font-family:inherit">
                <button type="button" class="rp-add-clan-btn"
                  style="background:none;border:1px solid rgba(255,255,255,.14);color:#94a3b8;font-size:.62rem;padding:.15rem .35rem;border-radius:4px;cursor:pointer;white-space:nowrap">+ Clan</button>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

        <%# Évolution — section repliable %>
        <details class="prot-sb-details"<% if (evols.length) { %> open<% } %>>
          <summary class="prot-sb-details-summary" data-fr-label="Évolution" data-en-label="Evolution"><%= _isEn ? 'Evolution' : '\u00c9volution' %></summary>
          <div class="prot-sb-details-body">
            <input type="hidden" name="evolutions" id="prot-evo-hidden"
              value="<%- JSON.stringify(evols) %>" />
            <div class="prot-evo-chain" id="prot-evo-chain">
              <% evols.forEach(function(evo, i) { %>
                <div class="prot-evo-entry" data-idx="<%= i %>" data-linked="<%= evo.linked_id || '' %>">
                  <input type="text" class="prot-evo-inp lbep-input" value="<%= evo.name %>"
                    placeholder="Nom\u2026" maxlength="100"
                    <% if (_isEn || evo.linked_id) { %> disabled<% } %> />
                  <span class="prot-evo-fr-ctl"<% if (_isEn) { %> hidden<% } %>>
                    <% if (evo.linked_id && protagoniste) { %>
                      <button type="button" class="prot-evo-btn prot-evo-edit-sheet" title="Éditer la fiche" data-child-id="<%= evo.linked_id %>" data-parent-id="<%= protagoniste.id %>">&#9998;</button>
                    <% } else { %>
                      <button type="button" class="prot-evo-btn prot-evo-link-sheet" title="Créer une fiche complète">&#9783;</button>
                    <% } %>
                    <button type="button" class="prot-evo-btn prot-evo-up" title="Monter">&uarr;</button>
                    <button type="button" class="prot-evo-btn prot-evo-down" title="Descendre">&darr;</button>
                    <button type="button" class="prot-evo-btn prot-evo-remove" title="Supprimer">&times;</button>
                  </span>
                  <% if (evo.linked_id) { %>
                    <span class="prot-evo-linked-badge">fiche</span>
                  <% } %>
                  <input type="text" class="prot-evo-en-inp lbep-input"
                    value="<%= _trans['evo_' + i + '_en'] || '' %>" placeholder="English name\u2026" maxlength="100"<% if (!_isEn) { %> hidden<% } %> />
                </div>
              <% }) %>
            </div>
            <div class="prot-evo-final">
              <span class="prot-evo-arrow">&rarr;</span>
              <span class="prot-evo-final-name"><%= protagoniste ? protagoniste.name : '(forme finale)' %></span>
            </div>
            <button type="button" class="prot-evo-add-btn" id="prot-evo-add"<% if (_isEn) { %> hidden<% } %>>+ Ajouter</button>
          </div>
        </details>

        <%# Parodies — section repliable %>
        <details class="prot-sb-details"<% if (_hasParody) { %> open<% } %>>
          <summary class="prot-sb-details-summary">Parodies</summary>
          <div class="prot-sb-details-body">
            <%- include('partials/parody-input', {
                  idPrefix:  'protf',
                  mainValue: protagoniste ? protagoniste.parody    : '',
                  subValue:  protagoniste ? protagoniste.sub_parody : '',
                  mainPh:    'Univers (ex\u00a0: Pok\u00e9mon)\u2026'
                }) %>
          </div>
        </details>

        <%# Tags %>
        <div class="prot-sb-section">
          <% if (allTags && allTags.length) { %>
            <script id="prot-all-tags" type="application/json"><%- JSON.stringify(allTags) %></script>
          <% } %>
          <div class="wiki-tags-widget">
            <div class="wiki-tags-board">
              <input type="text" class="wiki-tags-typing" placeholder="Tag&hellip;" autocomplete="off" />
            </div>
            <input type="hidden" name="tags" class="wiki-tags-hidden"
              value="<%= protagoniste && protagoniste.tags ? protagoniste.tags.join(', ') : '' %>" />
            <% if (allTags && allTags.length) { %>
              <div class="wiki-tag-suggestions">
                <% allTags.slice(0, 20).forEach(function(t) { %>
                  <button type="button" class="wiki-tag-suggest-chip" data-tag="<%= t %>"><%= t %></button>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

      </div><%# /prot-edit-sidebar-inner %>

      <% if (protagoniste) { %>
      <div class="prot-sb-footer">
        <button type="submit" form="prot-delete-form" class="prot-sb-delete-bottom">Supprimer</button>
        <% if (protagoniste.parent_id) { %>
          <button type="button" class="prot-sb-detach-btn" id="prot-detach-btn">Diviser</button>
        <% } else { %>
          <button type="button" class="prot-sb-include-btn" id="prot-include-btn">Inclure</button>
        <% } %>
      </div>
      <% } %>
    </aside>

    <%# ── CONTENU CENTRAL ── %>
    <div class="wf-actions-right">
      <% if (protagoniste) { %>
      <div class="prot-publish-row">
        <button type="button" id="prot-publish-btn"
          class="prot-publish-btn<%= _trans.published_en === '1' ? ' prot-publish-btn--on' : '' %>">
          <%- _trans.published_en === '1' ? 'Publi&eacute;' : '&Agrave; publier' %>
        </button>
        <input type="hidden" name="published_en" id="prot-publish-hidden"
          value="<%= _trans.published_en === '1' ? '1' : '' %>" />
      </div>
      <% } %>
      <div class="prot-save-row">
        <% if (protagoniste) { %>
        <%- include('partials/lang-toggle', { editLang: locals.editLang || 'fr', editUrl: '/protagonistes/' + protagoniste.id + '/edit' }) %>
        <% } %>
        <button type="submit" class="wf-save-btn">Enregistrer</button>
      </div>
    </div>

    <div class="nv-form-wrap">

      <%# Ligne 1 : Prénom + Nom %>
      <div class="prot-name-row">
        <input type="text" name="prenom" class="nv-form-title-input prot-prenom-inp" maxlength="200"
          data-fr-val="<%= protagoniste ? (protagoniste.prenom || '') : '' %>"
          data-en-val="<%= _trans.prenom || '' %>"
          value="<%= _vPrenom %>"
          placeholder="<%= _isEn ? 'First name\u2026' : 'Pr\u00e9nom\u2026' %>" />
        <input type="text" name="nom" class="prot-nom-inp" maxlength="200"
          data-fr-val="<%= protagoniste ? (protagoniste.nom || '') : '' %>"
          data-en-val="<%= _trans.nom || '' %>"
          value="<%= _vNom %>"
          placeholder="<%= _isEn ? 'Last name\u2026' : 'Nom\u2026' %>" />
      </div>

      <%# Ligne 2 : Image de profil + Description physique %>
      <div class="prot-img-desc-row">
        <div class="prot-img-col" id="prot-img-section">
          <div class="prot-form-img-wrap" id="prot-img-wrap">
            <% if (protagoniste && protagoniste.image_path) { %>
              <div class="prot-form-img-holder" id="prot-img-holder">
                <img src="<%= protagoniste.image_path %>" alt="Image actuelle" class="prot-form-img-thumb" id="prot-img-thumb" />
                <button type="button" class="prot-form-img-remove-btn" id="prot-img-remove-btn" title="Supprimer l'image" aria-label="Supprimer l'image">&times;</button>
                <input type="hidden" name="remove_image" id="prot-remove-hidden" value="" />
              </div>
            <% } else { %>
              <div class="prot-form-img-holder" id="prot-img-holder" style="display:none">
                <img src="" alt="Aper&ccedil;u" class="prot-form-img-thumb" id="prot-img-thumb" />
                <button type="button" class="prot-form-img-remove-btn" id="prot-img-remove-btn" title="Supprimer l'image" aria-label="Supprimer l'image">&times;</button>
                <input type="hidden" name="remove_image" id="prot-remove-hidden" value="" />
              </div>
            <% } %>
            <label class="prot-form-img-pick" id="prot-img-pick-btn">
              <input type="file" name="character_image" accept="image/*" id="prot-img-input" style="display:none" />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <span id="prot-img-pick-label">Image&hellip;</span>
            </label>
          </div>
        </div>
        <textarea name="description_physique" class="prot-desc-field"
          data-fr-val="<%= protagoniste ? (protagoniste.description_physique || '') : '' %>"
          data-en-val="<%= _trans.description_physique || '' %>"
          data-placeholder-fr="Description physique, apparence…"
          data-placeholder-en="Physical description…"
          placeholder="<%= _isEn ? 'Physical description\u2026' : 'Description physique, apparence\u2026' %>"
          rows="6" style="resize:vertical"><%= _vDescPhys %></textarea>
      </div>

      <%# Ligne 3 : Description générale %>
      <textarea name="description" class="prot-desc-field nv-form-content"
        data-fr-val="<%= protagoniste ? (protagoniste.description || '') : '' %>"
        data-en-val="<%= _trans.description || '' %>"
        data-placeholder-fr="Description générale, personnalité, traits de caractère…"
        data-placeholder-en="General description, personality…"
        placeholder="<%= _isEn ? 'General description, personality\u2026' : 'Description g\u00e9n\u00e9rale, personnalit\u00e9, traits de caract\u00e8re\u2026' %>"
        rows="6" style="resize:vertical"><%= _vDesc %></textarea>

      <%# Ligne 4 : Oeuvre et apparitions %>
      <textarea name="description_oeuvre" class="prot-desc-field"
        data-fr-val="<%= protagoniste ? (protagoniste.description_oeuvre || '') : '' %>"
        data-en-val="<%= _trans.description_oeuvre || '' %>"
        data-placeholder-fr="Oeuvre d'origine, apparitions, rôle dans le récit…"
        data-placeholder-en="Original work, appearances, role…"
        placeholder="<%= _isEn ? 'Original work, appearances, role\u2026' : 'Oeuvre d\u2019origine, apparitions, r\u00f4le dans le r\u00e9cit\u2026' %>"
        rows="5" style="resize:vertical"><%= _vDescOeuvre %></textarea>

      <div class="wiki-form-actions wf-mobile-actions">
        <button type="submit">Enregistrer</button>
      </div>
    </div><%# /nv-form-wrap %>

  </form>

  <script nonce="<%= nonce %>">
  (function() {
    // ── Switch FR/EN sans rechargement ──────────────────────────────────────
    var _editLangHid = document.getElementById('prot-editlang-hidden');

    function switchLang(lang) {
      var isEn = lang === 'en';
      var prevIsEn = _editLangHid ? _editLangHid.value === 'en' : false;

      // Sauvegarder + permuter toutes les valeurs taggées data-fr-val / data-en-val
      document.querySelectorAll('[data-fr-val]').forEach(function(el) {
        // Sauvegarder la valeur actuelle dans l'attribut de la langue courante
        if (prevIsEn) el.dataset.enVal = el.value;
        else          el.dataset.frVal = el.value;
        // Charger la valeur de la nouvelle langue
        el.value = isEn ? (el.dataset.enVal || '') : (el.dataset.frVal || '');
      });

      // Mettre à jour le champ caché _editLang
      if (_editLangHid) _editLangHid.value = isEn ? 'en' : '';

      // Labels d'interface (options selects, summary…)
      document.querySelectorAll('[data-fr-label]').forEach(function(el) {
        if (el.children.length) return;
        el.textContent = isEn ? (el.dataset.enLabel || el.textContent) : (el.dataset.frLabel || el.textContent);
      });

      // Placeholders
      document.querySelectorAll('[data-placeholder-fr]').forEach(function(el) {
        el.placeholder = isEn ? (el.dataset.placeholderEn || '') : (el.dataset.placeholderFr || '');
      });

      // Évolution : basculer contrôles FR ↔ EN
      document.querySelectorAll('.prot-evo-fr-ctl').forEach(function(el) { el.hidden = isEn; });
      document.querySelectorAll('.prot-evo-en-inp').forEach(function(el) { el.hidden = !isEn; });
      document.querySelectorAll('.prot-evo-inp').forEach(function(el) { el.disabled = isEn; });
      var addEvoBtn = document.getElementById('prot-evo-add');
      if (addEvoBtn) addEvoBtn.hidden = isEn;

      // Sync evolutions_en caché
      var hiddenEn = document.getElementById('prot-evo-en-hidden');
      if (hiddenEn) hiddenEn.value = JSON.stringify(
        Array.from(document.querySelectorAll('.prot-evo-en-inp')).map(function(i){ return i.value.trim(); })
      );

      // Mettre à jour le toggle actif
      document.querySelectorAll('.wf-lang-btn').forEach(function(btn) {
        btn.classList.toggle('active', btn.textContent.trim().toLowerCase() === lang);
      });

      // URL sans rechargement
      var url = window.location.pathname;
      history.replaceState({ lang: lang }, '', isEn ? url + '?editLang=en' : url);
    }

    // Intercepter les clics sur le lang-toggle
    document.querySelectorAll('.wf-lang-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        switchLang(btn.textContent.trim().toLowerCase());
      });
    });

    // ── Publish toggle ──────────────────────────────────────────────────────
    var publishBtn = document.getElementById('prot-publish-btn');
    var publishHid = document.getElementById('prot-publish-hidden');
    if (publishBtn && publishHid) {
      publishBtn.addEventListener('click', function() {
        var on = publishHid.value === '1';
        publishHid.value = on ? '' : '1';
        publishBtn.classList.toggle('prot-publish-btn--on', !on);
        publishBtn.innerHTML = on ? '&Agrave; publier' : 'Publi&eacute;';
      });
    }

    // ── Image : preview + croix ──────────────────────────────────────────────
    var imgInput  = document.getElementById('prot-img-input');
    var imgThumb  = document.getElementById('prot-img-thumb');
    var imgHolder = document.getElementById('prot-img-holder');
    var removeBtn = document.getElementById('prot-img-remove-btn');
    var removeHid = document.getElementById('prot-remove-hidden');
    var pickBtn   = document.getElementById('prot-img-pick-btn');
    if (imgHolder && imgHolder.style.display !== 'none' && pickBtn) pickBtn.hidden = true;
    if (imgInput) {
      imgInput.addEventListener('change', function() {
        var file = imgInput.files[0]; if (!file) return;
        imgThumb.src = URL.createObjectURL(file); imgHolder.style.display = '';
        if (removeHid) removeHid.value = ''; if (pickBtn) pickBtn.hidden = true;
      });
    }
    if (removeBtn) {
      removeBtn.addEventListener('click', function() {
        imgHolder.style.display = 'none'; imgThumb.src = '';
        if (removeHid) removeHid.value = '1'; if (imgInput) imgInput.value = ''; if (pickBtn) pickBtn.hidden = false;
      });
    }

    // ── Genre ───────────────────────────────────────────────────────────────
    document.querySelectorAll('.prot-gender-btns .prot-gender-btn').forEach(function(lbl) {
      lbl.addEventListener('click', function() {
        document.querySelectorAll('.prot-gender-btns .prot-gender-btn').forEach(function(b) { b.classList.remove('active'); });
        lbl.classList.add('active');
      });
    });

    // ── Classification — toggle ─────────────────────────────────────────────
    var specialHidden = document.getElementById('prot-special-hidden');
    document.querySelectorAll('.prot-special-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var wasActive = btn.classList.contains('active');
        document.querySelectorAll('.prot-special-btn').forEach(function(b) { b.classList.remove('active'); });
        if (!wasActive) btn.classList.add('active');
        if (specialHidden) specialHidden.value = wasActive ? '' : (btn.dataset.val || '');
      });
    });

    // ── Âge : min 18 ────────────────────────────────────────────────────────
    var ageInput = document.getElementById('prot-age');
    if (ageInput) {
      ageInput.addEventListener('blur', function() {
        var v = parseInt(ageInput.value, 10);
        if (!isNaN(v) && v > 0 && v < 18) ageInput.value = 18;
      });
    }

    // ── Évolutions ──────────────────────────────────────────────────────────
    var _syncEvoHidden = null;

    // ── Évolution : créer une fiche complète ────────────────────────────────
    function createLinkedSheet(row, parentId, name) {
      if (!parentId) return;
      var inp = row.querySelector('.prot-evo-inp');
      var sheetName = (name || (inp ? inp.value.trim() : '')) || 'Évolution';
      fetch('/protagonistes/' + parentId + '/evo-sheet/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: sheetName }),
      })
      .then(function(r){ return r.json(); })
      .then(function(d) {
        if (!d.ok) { alert('Erreur : ' + (d.error || 'inconnue')); return; }
        row.dataset.linked = d.id;
        if (inp) { inp.value = d.name; inp.disabled = true; }
        // Remplace le bouton link par le bouton edit
        var frCtl = row.querySelector('.prot-evo-fr-ctl');
        var linkBtn = frCtl ? frCtl.querySelector('.prot-evo-link-sheet') : null;
        if (linkBtn && frCtl) {
          var editBtn = document.createElement('button');
          editBtn.type = 'button'; editBtn.className = 'prot-evo-btn prot-evo-edit-sheet';
          editBtn.title = 'Éditer la fiche'; editBtn.innerHTML = '&#9998;';
          editBtn.dataset.childId = d.id;
          editBtn.dataset.parentId = parentId;
          editBtn.addEventListener('click', function() { openEvoSheet(parentId, d.id, row); });
          frCtl.replaceChild(editBtn, linkBtn);
          var badge = document.createElement('span');
          badge.className = 'prot-evo-linked-badge'; badge.textContent = 'fiche';
          frCtl.appendChild(badge);
        }
        if (_syncEvoHidden) _syncEvoHidden();
        openEvoSheet(parentId, d.id, row);
      });
    }

    // ── Évolution : ouvrir la dialog fiche ──────────────────────────────────
    var _evoSheetDialog = document.getElementById('evo-sheet-dialog');
    var _evoSheetRow = null;
    var _evoSheetChildId = null;
    var _evoSheetParentId = null;
    var _evoSdLang = 'fr';
    var _evoSdData = null;

    function openEvoSheet(parentId, childId, row) {
      if (!_evoSheetDialog) return;
      _evoSheetRow = row;
      _evoSheetChildId = childId;
      _evoSheetParentId = parentId;
      _evoSdLang = 'fr';
      var frBtn = document.getElementById('evo-sd-btn-fr');
      var enBtn = document.getElementById('evo-sd-btn-en');
      if (frBtn) { frBtn.classList.add('active'); }
      if (enBtn) { enBtn.classList.remove('active'); }
      fetch('/protagonistes/' + parentId + '/evo-sheet/' + childId)
      .then(function(r){ return r.json(); })
      .then(function(d) {
        if (!d.ok) { alert('Erreur chargement'); return; }
        _evoSdData = d;
        populateEvoDialog(d.child, d.translations, 'fr');
        _evoSheetDialog.showModal();
      });
    }

    function populateEvoDialog(child, trans, lang) {
      var isEn = lang === 'en';
      var t = trans || {};
      var titleEl = document.getElementById('evo-sd-title');
      if (titleEl) titleEl.textContent = child.name || 'Évolution';
      var prenom = isEn ? (t.prenom || '') : (child.prenom || '');
      var nom    = isEn ? (t.nom    || '') : (child.nom    || '');
      var prenomEl = document.getElementById('evo-sd-prenom');
      var nomEl    = document.getElementById('evo-sd-nom');
      if (prenomEl) { prenomEl.value = prenom; prenomEl.dataset.frVal = child.prenom || ''; prenomEl.dataset.enVal = t.prenom || ''; }
      if (nomEl)    { nomEl.value    = nom;    nomEl.dataset.frVal    = child.nom    || ''; nomEl.dataset.enVal    = t.nom    || ''; }
      var descEl      = document.getElementById('evo-sd-desc');
      var descPhysEl  = document.getElementById('evo-sd-desc-phys');
      var descOeuvEl  = document.getElementById('evo-sd-desc-oeuvre');
      if (descEl)     { descEl.value     = isEn ? (t.description || '') : (child.description || ''); descEl.dataset.frVal = child.description || ''; descEl.dataset.enVal = t.description || ''; }
      if (descPhysEl) { descPhysEl.value = isEn ? (t.description_physique || '') : (child.description_physique || ''); descPhysEl.dataset.frVal = child.description_physique || ''; descPhysEl.dataset.enVal = t.description_physique || ''; }
      if (descOeuvEl) { descOeuvEl.value = isEn ? (t.description_oeuvre || '') : (child.description_oeuvre || ''); descOeuvEl.dataset.frVal = child.description_oeuvre || ''; descOeuvEl.dataset.enVal = t.description_oeuvre || ''; }
      document.querySelectorAll('#evo-sheet-dialog .prot-gender-btn').forEach(function(lbl) {
        var radio = lbl.querySelector('.evo-sd-gender-radio');
        var isActive = radio && radio.value === (child.gender || '');
        lbl.classList.toggle('active', isActive);
      });
      var genderHid = document.getElementById('evo-sd-gender-hid');
      if (genderHid) genderHid.value = child.gender || '';
      var specialHid = document.getElementById('evo-sd-special-hid');
      if (specialHid) specialHid.value = child.special || '';
      document.querySelectorAll('#evo-sheet-dialog .prot-special-btn').forEach(function(btn) {
        btn.classList.toggle('active', btn.dataset.val === (child.special || ''));
      });
      var natureEl = document.getElementById('evo-sd-nature');
      if (natureEl) natureEl.value = child.nature || '';
      var ageEl = document.getElementById('evo-sd-age');
      if (ageEl) ageEl.value = child.age || '';
      var oriEl = document.getElementById('evo-sd-orientation');
      if (oriEl) oriEl.value = child.orientation || '';
      var holder = document.getElementById('evo-sd-img-holder');
      var thumb  = document.getElementById('evo-sd-img-thumb');
      if (holder && thumb) {
        if (child.image_path) {
          thumb.src = child.image_path;
          holder.style.display = '';
          var pickBtn = document.getElementById('evo-sd-img-pick');
          if (pickBtn) pickBtn.hidden = true;
        } else {
          holder.style.display = 'none';
          thumb.src = '';
          var pickBtn2 = document.getElementById('evo-sd-img-pick');
          if (pickBtn2) pickBtn2.hidden = false;
        }
      }
      var removeHid = document.getElementById('evo-sd-remove-img-hid');
      if (removeHid) removeHid.value = '';
      var fileInp = document.getElementById('evo-sd-img-input');
      if (fileInp) fileInp.value = '';
    }

    // ── Dialog FR/EN ────────────────────────────────────────────────────────
    var evoSdFrBtn = document.getElementById('evo-sd-btn-fr');
    var evoSdEnBtn = document.getElementById('evo-sd-btn-en');

    function evoSdSwitchLang(lang) {
      var isEn = lang === 'en';
      document.querySelectorAll('#evo-sheet-dialog [data-fr-val]').forEach(function(el) {
        if (_evoSdLang === 'en') el.dataset.enVal = el.value;
        else                     el.dataset.frVal = el.value;
        el.value = isEn ? (el.dataset.enVal || '') : (el.dataset.frVal || '');
      });
      _evoSdLang = lang;
      if (evoSdFrBtn) evoSdFrBtn.classList.toggle('active', !isEn);
      if (evoSdEnBtn) evoSdEnBtn.classList.toggle('active', isEn);
    }

    if (evoSdFrBtn) evoSdFrBtn.addEventListener('click', function() { evoSdSwitchLang('fr'); });
    if (evoSdEnBtn) evoSdEnBtn.addEventListener('click', function() { evoSdSwitchLang('en'); });

    // ── Dialog close ──────────────────────────────────────────────────────
    var evoSdCloseBtn = document.getElementById('evo-sd-close');
    if (evoSdCloseBtn) evoSdCloseBtn.addEventListener('click', function() {
      if (_evoSheetDialog) _evoSheetDialog.close();
    });
    if (_evoSheetDialog) {
      _evoSheetDialog.addEventListener('click', function(e) {
        if (e.target === _evoSheetDialog) _evoSheetDialog.close();
      });
    }

    // ── Dialog image ──────────────────────────────────────────────────────
    var evoSdImgInput  = document.getElementById('evo-sd-img-input');
    var evoSdImgHolder = document.getElementById('evo-sd-img-holder');
    var evoSdImgThumb  = document.getElementById('evo-sd-img-thumb');
    var evoSdImgRemove = document.getElementById('evo-sd-img-remove');
    var evoSdImgPick   = document.getElementById('evo-sd-img-pick');
    var evoSdRemoveHid = document.getElementById('evo-sd-remove-img-hid');
    if (evoSdImgInput) {
      evoSdImgInput.addEventListener('change', function() {
        var file = evoSdImgInput.files[0]; if (!file) return;
        evoSdImgThumb.src = URL.createObjectURL(file);
        evoSdImgHolder.style.display = '';
        if (evoSdImgPick) evoSdImgPick.hidden = true;
        if (evoSdRemoveHid) evoSdRemoveHid.value = '';
      });
    }
    if (evoSdImgRemove) {
      evoSdImgRemove.addEventListener('click', function() {
        evoSdImgHolder.style.display = 'none';
        evoSdImgThumb.src = '';
        if (evoSdRemoveHid) evoSdRemoveHid.value = '1';
        if (evoSdImgInput) evoSdImgInput.value = '';
        if (evoSdImgPick) evoSdImgPick.hidden = false;
      });
    }

    // ── Dialog gender ────────────────────────────────────────────────────
    document.querySelectorAll('#evo-sheet-dialog .prot-gender-btn').forEach(function(lbl) {
      lbl.addEventListener('click', function() {
        document.querySelectorAll('#evo-sheet-dialog .prot-gender-btn').forEach(function(b) { b.classList.remove('active'); });
        lbl.classList.add('active');
        var radio = lbl.querySelector('.evo-sd-gender-radio');
        var genderHid = document.getElementById('evo-sd-gender-hid');
        if (genderHid && radio) genderHid.value = radio.value;
      });
    });

    // ── Dialog special ───────────────────────────────────────────────────
    document.querySelectorAll('#evo-sheet-dialog .prot-special-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var wasActive = btn.classList.contains('active');
        document.querySelectorAll('#evo-sheet-dialog .prot-special-btn').forEach(function(b) { b.classList.remove('active'); });
        if (!wasActive) btn.classList.add('active');
        var specialHid = document.getElementById('evo-sd-special-hid');
        if (specialHid) specialHid.value = wasActive ? '' : (btn.dataset.val || '');
      });
    });

    // ── Dialog save ──────────────────────────────────────────────────────
    var evoSdSaveBtn = document.getElementById('evo-sd-save');
    var evoSdStatus  = document.getElementById('evo-sd-status');
    if (evoSdSaveBtn) {
      evoSdSaveBtn.addEventListener('click', function() {
        if (!_evoSheetChildId || !_evoSheetParentId) return;
        if (_evoSdLang === 'en') {
          document.querySelectorAll('#evo-sheet-dialog [data-fr-val]').forEach(function(el) { el.dataset.enVal = el.value; });
        } else {
          document.querySelectorAll('#evo-sheet-dialog [data-fr-val]').forEach(function(el) { el.dataset.frVal = el.value; });
        }

        var fd = new FormData();
        fd.append('_editLang', _evoSdLang);
        fd.append('prenom',   _evoSdLang === 'en' ? (document.getElementById('evo-sd-prenom').dataset.enVal || '') : (document.getElementById('evo-sd-prenom').dataset.frVal || document.getElementById('evo-sd-prenom').value || ''));
        fd.append('nom',      _evoSdLang === 'en' ? (document.getElementById('evo-sd-nom').dataset.enVal    || '') : (document.getElementById('evo-sd-nom').dataset.frVal    || document.getElementById('evo-sd-nom').value    || ''));
        fd.append('description',          _evoSdLang === 'en' ? (document.getElementById('evo-sd-desc').dataset.enVal       || '') : (document.getElementById('evo-sd-desc').dataset.frVal       || ''));
        fd.append('description_physique', _evoSdLang === 'en' ? (document.getElementById('evo-sd-desc-phys').dataset.enVal  || '') : (document.getElementById('evo-sd-desc-phys').dataset.frVal  || ''));
        fd.append('description_oeuvre',   _evoSdLang === 'en' ? (document.getElementById('evo-sd-desc-oeuvre').dataset.enVal|| '') : (document.getElementById('evo-sd-desc-oeuvre').dataset.frVal|| ''));
        fd.append('gender',      document.getElementById('evo-sd-gender-hid').value || '');
        fd.append('special',     document.getElementById('evo-sd-special-hid').value || '');
        fd.append('nature',      document.getElementById('evo-sd-nature').value || '');
        fd.append('age',         document.getElementById('evo-sd-age').value || '');
        fd.append('orientation', document.getElementById('evo-sd-orientation').value || '');
        fd.append('remove_image', document.getElementById('evo-sd-remove-img-hid').value || '');
        var fileInp = document.getElementById('evo-sd-img-input');
        if (fileInp && fileInp.files[0]) fd.append('character_image', fileInp.files[0]);

        evoSdSaveBtn.disabled = true;
        if (evoSdStatus) evoSdStatus.textContent = '…';

        fetch('/protagonistes/' + _evoSheetParentId + '/evo-sheet/' + _evoSheetChildId + '/save', {
          method: 'POST',
          body: fd,
        })
        .then(function(r){ return r.json(); })
        .then(function(d) {
          evoSdSaveBtn.disabled = false;
          if (!d.ok) { if (evoSdStatus) evoSdStatus.textContent = 'Erreur'; return; }
          if (evoSdStatus) { evoSdStatus.textContent = 'Enregistré'; setTimeout(function(){ evoSdStatus.textContent=''; }, 2000); }
          if (d.lang === 'fr' && _evoSheetRow) {
            var inp = _evoSheetRow.querySelector('.prot-evo-inp');
            if (inp) inp.value = d.name;
            var titleEl = document.getElementById('evo-sd-title');
            if (titleEl) titleEl.textContent = d.name;
            if (_syncEvoHidden) _syncEvoHidden();
          }
        })
        .catch(function() { evoSdSaveBtn.disabled = false; if (evoSdStatus) evoSdStatus.textContent = 'Erreur réseau'; });
      });
    }

    (function() {
      var chain    = document.getElementById('prot-evo-chain');
      var hidden   = document.getElementById('prot-evo-hidden');
      var hiddenEn = document.getElementById('prot-evo-en-hidden');
      if (!chain || !hidden) return;

      function isEnMode() { return _editLangHid ? _editLangHid.value === 'en' : false; }

      function syncHidden() {
        var items = Array.from(chain.querySelectorAll('.prot-evo-entry')).map(function(row) {
          var inp = row.querySelector('.prot-evo-inp');
          var name = inp ? inp.value.trim() : '';
          var linkedId = row.dataset.linked ? Number(row.dataset.linked) : null;
          return { name: linkedId ? (inp ? inp.value.trim() : '') : name, linked_id: linkedId || null };
        }).filter(function(o) { return o.name || o.linked_id; });
        hidden.value = JSON.stringify(items);
      }
      _syncEvoHidden = syncHidden;

      function syncEnHidden() {
        if (!hiddenEn) return;
        hiddenEn.value = JSON.stringify(
          Array.from(chain.querySelectorAll('.prot-evo-en-inp')).map(function(i){ return i.value.trim(); })
        );
      }

      // Wiring sur les entrées existantes
      chain.querySelectorAll('.prot-evo-entry').forEach(function(row) {
        var inp   = row.querySelector('.prot-evo-inp');
        var enInp = row.querySelector('.prot-evo-en-inp');
        var upBtn = row.querySelector('.prot-evo-up');
        var dnBtn = row.querySelector('.prot-evo-down');
        var rmBtn = row.querySelector('.prot-evo-remove');
        if (inp)   inp.addEventListener('input', syncHidden);
        if (enInp) enInp.addEventListener('input', syncEnHidden);
        if (upBtn) upBtn.addEventListener('click', function(){ var p=row.previousElementSibling; if(p&&p.classList.contains('prot-evo-entry')){chain.insertBefore(row,p);syncHidden();} });
        if (dnBtn) dnBtn.addEventListener('click', function(){ var n=row.nextElementSibling; if(n&&n.classList.contains('prot-evo-entry')){chain.insertBefore(n,row);syncHidden();} });
        if (rmBtn) rmBtn.addEventListener('click', function(){ row.remove(); syncHidden(); });
        var editBtn = row.querySelector('.prot-evo-edit-sheet');
        if (editBtn) editBtn.addEventListener('click', function() {
          var parentId = Number(editBtn.dataset.parentId);
          var childId = Number(editBtn.dataset.childId);
          openEvoSheet(parentId, childId, row);
        });
        var linkBtn = row.querySelector('.prot-evo-link-sheet');
        if (linkBtn) {
          var linkedRow = row;
          linkBtn.addEventListener('click', function() {
            var parentId = <%- protagoniste ? protagoniste.id : 'null' %>;
            var inp2 = linkedRow.querySelector('.prot-evo-inp');
            createLinkedSheet(linkedRow, parentId, inp2 ? inp2.value.trim() : '');
          });
        }
      });

      function makeEntry(item) {
        var name = (item && item.name) || '';
        var linkedId = (item && item.linked_id) || null;
        var enMode = isEnMode();
        var parentId = <%- protagoniste ? protagoniste.id : 'null' %>;

        var row = document.createElement('div');
        row.className = 'prot-evo-entry';
        if (linkedId) row.dataset.linked = linkedId;

        var inp = document.createElement('input');
        inp.type='text'; inp.className='prot-evo-inp lbep-input';
        inp.value = name; inp.placeholder = 'Nom\u2026'; inp.maxLength = 100;
        if (enMode || linkedId) inp.disabled = true;
        inp.addEventListener('input', syncHidden);

        var frCtl = document.createElement('span');
        frCtl.className = 'prot-evo-fr-ctl';
        if (enMode) frCtl.hidden = true;

        if (linkedId && parentId) {
          var editBtn = document.createElement('button');
          editBtn.type='button'; editBtn.className='prot-evo-btn prot-evo-edit-sheet';
          editBtn.title='Éditer la fiche'; editBtn.innerHTML='&#9998;';
          editBtn.dataset.childId = linkedId;
          editBtn.dataset.parentId = parentId;
          editBtn.addEventListener('click', function() { openEvoSheet(parentId, linkedId, row); });
          frCtl.appendChild(editBtn);
        } else {
          var linkBtn = document.createElement('button');
          linkBtn.type='button'; linkBtn.className='prot-evo-btn prot-evo-link-sheet';
          linkBtn.title='Créer une fiche complète'; linkBtn.innerHTML='&#9783;';
          linkBtn.addEventListener('click', function() { createLinkedSheet(row, parentId, name); });
          frCtl.appendChild(linkBtn);
        }

        var upBtn = document.createElement('button'); upBtn.type='button'; upBtn.className='prot-evo-btn prot-evo-up'; upBtn.title='Monter'; upBtn.textContent='\u2191';
        var dnBtn = document.createElement('button'); dnBtn.type='button'; dnBtn.className='prot-evo-btn prot-evo-down'; dnBtn.title='Descendre'; dnBtn.textContent='\u2193';
        var rmBtn = document.createElement('button'); rmBtn.type='button'; rmBtn.className='prot-evo-btn prot-evo-remove'; rmBtn.title='Supprimer'; rmBtn.textContent='\xd7';
        upBtn.addEventListener('click', function(){ var p=row.previousElementSibling; if(p&&p.classList.contains('prot-evo-entry')){chain.insertBefore(row,p);syncHidden();} });
        dnBtn.addEventListener('click', function(){ var n=row.nextElementSibling; if(n&&n.classList.contains('prot-evo-entry')){chain.insertBefore(n,row);syncHidden();} });
        rmBtn.addEventListener('click', function(){ row.remove(); syncHidden(); });
        frCtl.appendChild(upBtn); frCtl.appendChild(dnBtn); frCtl.appendChild(rmBtn);

        if (linkedId) {
          var badge = document.createElement('span');
          badge.className = 'prot-evo-linked-badge';
          badge.textContent = 'fiche';
          frCtl.appendChild(badge);
        }

        var enInp = document.createElement('input'); enInp.type='text'; enInp.className='prot-evo-en-inp lbep-input';
        enInp.value=''; enInp.placeholder='English name\u2026'; enInp.maxLength=100;
        if (!enMode) enInp.hidden = true;
        enInp.addEventListener('input', syncEnHidden);

        row.appendChild(inp); row.appendChild(frCtl); row.appendChild(enInp);
        return row;
      }

      var addBtn = document.getElementById('prot-evo-add');
      if (addBtn) addBtn.addEventListener('click', function(){
        chain.appendChild(makeEntry(null));
        var ni = chain.lastElementChild.querySelector('.prot-evo-inp');
        if (ni) ni.focus();
      });

      syncHidden(); syncEnHidden();
    })();

    // ── Tags widget ──────────────────────────────────────────────────────────
    document.querySelectorAll('.wiki-tags-widget').forEach(function(widget) {
      var board=widget.querySelector('.wiki-tags-board'), typer=widget.querySelector('.wiki-tags-typing'), hidden=widget.querySelector('.wiki-tags-hidden'), suggestBox=widget.querySelector('.wiki-tag-suggestions');
      if(!board||!typer||!hidden) return;
      var tags=(hidden.value||'').split(/[,;]+/).map(function(t){return t.trim();}).filter(Boolean);
      function findTag(t){return tags.indexOf(t)!==-1;}
      function syncHidden(){hidden.value=tags.join(', ');}
      function syncSuggest(){if(!suggestBox)return;suggestBox.querySelectorAll('.wiki-tag-suggest-chip').forEach(function(c){var s=findTag(c.dataset.tag);c.classList.toggle('active',s);c.hidden=s;});}
      var chipsArea=widget.querySelector('.wiki-tags-chips');
      if(!chipsArea){chipsArea=document.createElement('div');chipsArea.className='wiki-tags-chips';board.parentNode.insertBefore(chipsArea,board);}
      function renderBoard(){chipsArea.querySelectorAll('.wiki-chip').forEach(function(c){c.remove();});tags.forEach(function(t){var chip=document.createElement('span');chip.className='link-tag-pill wiki-chip';chip.style.cssText='background:hsl(340,50%,38%);color:#fff;cursor:pointer;margin:2px 3px 2px 0;display:inline-flex;align-items:center;padding:2px 8px;border-radius:20px;font-size:.75rem';chip.textContent=t;chip.title='Cliquer pour retirer';chip.addEventListener('click',function(){tags=tags.filter(function(x){return x!==t;});syncHidden();renderBoard();syncSuggest();});chipsArea.appendChild(chip);});syncHidden();syncSuggest();}
      function addTag(t){t=t.trim();if(t&&!findTag(t)){tags.push(t);renderBoard();}}
      function removeTag(t){tags=tags.filter(function(x){return x!==t;});syncHidden();renderBoard();syncSuggest();}
      typer.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===','||e.key===';'){e.preventDefault();if(typer.value.trim()){addTag(typer.value.trim());typer.value='';closeAc();}}else if(e.key==='Backspace'&&!typer.value&&tags.length)removeTag(tags[tags.length-1]);});
      typer.addEventListener('blur',function(){if(typer.value.trim()){addTag(typer.value.trim());typer.value='';}setTimeout(closeAc,160);});
      board.addEventListener('click',function(e){if(e.target===board)typer.focus();});
      if(suggestBox)suggestBox.querySelectorAll('.wiki-tag-suggest-chip').forEach(function(chip){chip.addEventListener('click',function(){if(!findTag(chip.dataset.tag))addTag(chip.dataset.tag);else removeTag(chip.dataset.tag);});});
      var allAvail=(function(){var el=document.getElementById('prot-all-tags');if(el){try{return JSON.parse(el.textContent);}catch(_){}}return[];})();
      var acDrop=document.createElement('ul');acDrop.className='wiki-tag-autocomplete';acDrop.hidden=true;board.parentNode.insertBefore(acDrop,board.nextSibling);
      var acSel=-1;
      function clearAcDrop(){while(acDrop.firstChild)acDrop.removeChild(acDrop.firstChild);}
      function closeAc(){acDrop.hidden=true;clearAcDrop();acSel=-1;}
      function showAc(q){q=(q||'').trim().toLowerCase();if(!q){closeAc();return;}var m=allAvail.filter(function(t){return t.toLowerCase().indexOf(q)!==-1&&!findTag(t);}).slice(0,9);if(!m.length){closeAc();return;}clearAcDrop();acSel=-1;m.forEach(function(t){var li=document.createElement('li');li.className='wiki-tag-ac-item';li.textContent=t;li.addEventListener('mousedown',function(e){e.preventDefault();addTag(t);typer.value='';closeAc();typer.focus();});acDrop.appendChild(li);});acDrop.hidden=false;}
      typer.addEventListener('input',function(){showAc(typer.value);if(suggestBox){var q=typer.value.trim().toLowerCase();suggestBox.querySelectorAll('.wiki-tag-suggest-chip').forEach(function(c){c.hidden=q.length>0&&c.dataset.tag.toLowerCase().indexOf(q)===-1;});}});
      typer.addEventListener('keydown',function(e){if(acDrop.hidden)return;var items=acDrop.querySelectorAll('.wiki-tag-ac-item');if(e.key==='ArrowDown'){e.preventDefault();acSel=Math.min(acSel+1,items.length-1);items.forEach(function(li,i){li.classList.toggle('selected',i===acSel);});}else if(e.key==='ArrowUp'){e.preventDefault();acSel=Math.max(acSel-1,0);items.forEach(function(li,i){li.classList.toggle('selected',i===acSel);});}else if((e.key==='Enter'||e.key==='Tab')&&acSel>=0&&items[acSel]){e.preventDefault();e.stopImmediatePropagation();addTag(items[acSel].textContent);typer.value='';closeAc();}else if(e.key==='Escape')closeAc();},true);
      renderBoard();
    });

    // ── Panneau gestion des races ────────────────────────────────────────────
    var raceManageBtn=document.getElementById('prot-race-manage-btn'), racePanel=document.getElementById('prot-race-panel'), racePanelClose=document.getElementById('prot-race-panel-close'), raceSelect=document.getElementById('prot-race');
    if(raceManageBtn&&racePanel){
      raceManageBtn.addEventListener('click',function(){racePanel.style.display=racePanel.style.display==='none'?'block':'none';});
      racePanelClose.addEventListener('click',function(){racePanel.style.display='none';});
      document.getElementById('rp-create-race-btn').addEventListener('click',function(){
        var name=document.getElementById('rp-new-race-name').value.trim(), icon=document.getElementById('rp-new-race-icon').value.trim(), color=document.getElementById('rp-new-race-color').value, status=document.getElementById('rp-create-race-status');
        if(!name){document.getElementById('rp-new-race-name').focus();return;}
        fetch('/admin/races',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name,icon:icon,color:color})}).then(function(r){return r.json();}).then(function(d){
          if(!d.ok){if(status)status.textContent='Erreur';return;}
          var opt=document.createElement('option');opt.value=d.id;opt.textContent=(icon?icon+' ':'')+name;raceSelect.appendChild(opt);raceSelect.value=d.id;raceSelect.dispatchEvent(new Event('change'));
          appendRpRaceItem(d.id,name,icon,color);document.getElementById('rp-new-race-name').value='';document.getElementById('rp-new-race-icon').value='';
          if(status){status.textContent='Cr\u00e9\u00e9';setTimeout(function(){status.textContent='';},2000);}
        });
      });
      document.getElementById('rp-race-list').addEventListener('click',function(e){
        if(e.target.closest('.rp-delete-race-btn')){var item=e.target.closest('.rp-race-item'),raceId=item.dataset.raceId,raceName=item.querySelector('span[style*="font-weight"]').textContent.trim();if(!confirm('Supprimer "'+raceName+'" ?'))return;fetch('/admin/races/'+raceId,{method:'DELETE'}).then(function(r){return r.json();}).then(function(d){if(!d.ok)return;item.remove();var opt=raceSelect.querySelector('option[value="'+raceId+'"]');if(opt)opt.remove();if(raceSelect.value===raceId){raceSelect.value='';raceSelect.dispatchEvent(new Event('change'));}});return;}
        if(e.target.closest('.rp-delete-clan-btn')){var tag=e.target.closest('.rp-clan-tag'),clanId=tag.dataset.clanId;if(!confirm('Supprimer ce clan ?'))return;fetch('/admin/clans/'+clanId,{method:'DELETE'}).then(function(r){return r.json();}).then(function(d){if(d.ok){tag.remove();var cs=document.getElementById('prot-clan');if(cs){var co=cs.querySelector('option[value="'+clanId+'"]');if(co)co.remove();}}});return;}
        if(e.target.closest('.rp-add-clan-btn')){var item2=e.target.closest('.rp-race-item'),raceId2=item2.dataset.raceId,inp2=item2.querySelector('.rp-new-clan-name'),clanName=inp2.value.trim();if(!clanName){inp2.focus();return;}fetch('/admin/races/'+raceId2+'/clans',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:clanName})}).then(function(r){return r.json();}).then(function(d){if(!d.ok)return;var cl=item2.querySelector('.rp-clan-list');var no=cl.querySelector('span[style*="italic"]');if(no)no.remove();var t2=document.createElement('span');t2.className='rp-clan-tag';t2.dataset.clanId=d.id;t2.style.cssText='display:inline-flex;align-items:center;gap:.18rem;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:.08rem .4rem;font-size:.65rem;color:#cbd5e1';var lb=document.createTextNode(clanName+' ');var db=document.createElement('button');db.type='button';db.className='rp-delete-clan-btn';db.style.cssText='background:none;border:none;color:#f87171;cursor:pointer;padding:0;font-size:.75rem;line-height:1';db.textContent='\xd7';t2.appendChild(lb);t2.appendChild(db);cl.insertBefore(t2,null);inp2.value='';if(raceSelect.value===raceId2){var cs2=document.getElementById('prot-clan');if(cs2){var no2=document.createElement('option');no2.value=d.id;no2.textContent=clanName;cs2.appendChild(no2);document.getElementById('prot-clan-group').style.display='';}}});}
      });
    }
    function appendRpRaceItem(id,name,icon,color){var list=document.getElementById('rp-race-list');var empty=list.querySelector('p[style*="italic"]');if(empty)empty.remove();var div=document.createElement('div');div.className='rp-race-item';div.dataset.raceId=id;div.style.cssText='background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:6px;padding:.4rem .5rem';div.innerHTML='<div style="display:flex;align-items:center;gap:.35rem;margin-bottom:.3rem"><span style="width:7px;height:7px;border-radius:50%;background:'+color+';flex-shrink:0"></span><span style="font-size:.75rem;font-weight:700;color:#e2e8f0;flex:1">'+(icon?icon+' ':'')+name+'</span><button type="button" class="rp-delete-race-btn" style="background:none;border:none;color:#ef4444;font-size:.7rem;cursor:pointer;padding:0" title="Supprimer">&#128465;</button></div><div class="rp-clan-list" style="display:flex;flex-wrap:wrap;gap:.2rem;margin-bottom:.3rem"><span style="font-size:.62rem;color:#475569;font-style:italic">Aucun clan</span></div><div style="display:flex;gap:.25rem;align-items:center"><input type="text" class="rp-new-clan-name" placeholder="+ Clan" style="flex:1;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#f1f5f9;border-radius:4px;padding:.15rem .35rem;font-size:.68rem;outline:none;font-family:inherit"><button type="button" class="rp-add-clan-btn" style="background:none;border:1px solid rgba(255,255,255,.14);color:#94a3b8;font-size:.62rem;padding:.15rem .35rem;border-radius:4px;cursor:pointer;white-space:nowrap">+ Clan</button></div>';list.appendChild(div);}

    // ── Race → clans dynamiques + "+" option ────────────────────────────────
    var clanGroup=document.getElementById('prot-clan-group'),clanSelect=document.getElementById('prot-clan');
    var _prevRaceVal = raceSelect ? raceSelect.value : '';
    if(raceSelect){
      raceSelect.addEventListener('change',function(){
        if(raceSelect.value === '__add__') {
          raceSelect.value = _prevRaceVal; // revenir à la valeur précédente
          if(racePanel) racePanel.style.display = racePanel.style.display === 'none' ? 'block' : 'none';
          updateSelectColor(raceSelect);
          return;
        }
        _prevRaceVal = raceSelect.value;
        updateSelectColor(raceSelect);
        var raceId=raceSelect.value;
        if(!raceId){clanGroup.style.display='none';clanSelect.innerHTML='<option value="">Clan</option>';return;}
        fetch('/protagonistes/api/races/'+raceId+'/clans').then(function(r){return r.json();}).then(function(data){
          var clans=data.clans||[];while(clanSelect.options.length>0)clanSelect.remove(0);
          var def=document.createElement('option');def.value='';def.textContent='Clan';clanSelect.appendChild(def);
          clans.forEach(function(c){var opt=document.createElement('option');opt.value=c.id;opt.textContent=c.name;clanSelect.appendChild(opt);});
          clanGroup.style.display=clans.length?'':'none';
          updateSelectColor(clanSelect);
        });
      });
    }

    // ── Couleur des selects : muted si vide, blanc si valeur choisie ─────────
    function updateSelectColor(sel) {
      if (!sel) return;
      sel.classList.toggle('prot-select--has-value', !!(sel.value && sel.value !== '__add__'));
    }
    document.querySelectorAll('.prot-edit-sidebar select').forEach(function(sel) {
      updateSelectColor(sel);
      sel.addEventListener('change', function() { updateSelectColor(sel); });
    });
  })();
  </script>

</main>
