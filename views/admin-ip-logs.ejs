<%- include('partials/head', { title: 'Admin : IP Logs', extraCss: ['admin.css'] }) %>

<style>
.ipl-wrap{padding:1.25rem 1.5rem 5rem;max-width:960px;margin:0 auto}
.ipl-toolbar{display:flex;align-items:center;gap:.75rem;margin-bottom:1.5rem;flex-wrap:wrap}
.ipl-h1{font-size:1rem;font-weight:700;color:#e2e8f0;margin:0;flex:1}
.ipl-range-btn{font-size:.72rem;padding:.25rem .6rem;border-radius:6px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.05);color:rgba(255,255,255,.55);cursor:pointer;text-decoration:none;transition:background .1s,color .1s}
.ipl-range-btn:hover,.ipl-range-btn.active{background:rgba(255,255,255,.1);color:#e2e8f0}
.ipl-empty{color:rgba(255,255,255,.3);font-size:.9rem;text-align:center;padding:3rem 0}
.ipl-table{width:100%;border-collapse:collapse}
.ipl-table th{font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.35);border-bottom:1px solid rgba(255,255,255,.07);padding:.4rem .6rem;text-align:left;white-space:nowrap}
.ipl-table td{padding:.45rem .6rem;border-bottom:1px solid rgba(255,255,255,.04);font-size:.8rem;color:rgba(255,255,255,.65);vertical-align:middle}
.ipl-table tr:hover td{background:rgba(255,255,255,.025)}
.ipl-ip{font-family:monospace;font-size:.82rem;color:#7dd3fc;font-weight:600}
.ipl-ip a{color:inherit;text-decoration:none}
.ipl-ip a:hover{text-decoration:underline}
.ipl-geo{display:flex;align-items:center;gap:.35rem;white-space:nowrap}
.ipl-flag{font-size:1rem;line-height:1}
.ipl-country{font-size:.75rem;color:rgba(255,255,255,.5)}
.ipl-city{font-size:.7rem;color:rgba(255,255,255,.3)}
.ipl-hits{font-weight:700;color:#e2e8f0}
.ipl-paths{font-size:.72rem;color:rgba(255,255,255,.35)}
.ipl-user-badge{font-size:.68rem;padding:.1rem .4rem;border-radius:10px;background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.2);color:#c4b5fd;white-space:nowrap}
.ipl-anon{font-size:.7rem;color:rgba(255,255,255,.25)}
.ipl-time{font-size:.72rem;color:rgba(255,255,255,.35);white-space:nowrap}
.ipl-ua{max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.7rem;color:rgba(255,255,255,.3)}
.ipl-new{display:inline-block;width:6px;height:6px;border-radius:50%;background:#4ade80;margin-right:.3rem;vertical-align:middle}
</style>

<div class="admin-topbar">
  <a href="/admin#tab-log" class="admin-topbar-back">&#8592; Retour</a>
  <span class="admin-topbar-title"><%= config.title %></span>
</div>

<div class="ipl-wrap">
  <div class="ipl-toolbar">
    <h1 class="ipl-h1">IP Logger &mdash; <%= logs.length %> adresse<%= logs.length !== 1 ? 's' : '' %></h1>
    <% [6, 24, 48, 168, 336, 720].forEach(function(h) { %>
      <a href="/admin/ip-logs?h=<%= h %>" class="ipl-range-btn<%= hours === h ? ' active' : '' %>">
        <%= h < 24 ? h + 'h' : (h < 168 ? (h/24) + 'j' : (h/168) + 'sem') %>
      </a>
    <% }) %>
  </div>

  <% if (!logs.length) { %>
    <p class="ipl-empty">Aucune activit&eacute; enregistr&eacute;e sur cette p&eacute;riode.</p>
  <% } else { %>
  <table class="ipl-table" id="ipl-table">
    <thead>
      <tr>
        <th>IP</th>
        <th>Pays</th>
        <th>Visites</th>
        <th>Pages</th>
        <th>Profil</th>
        <th>Derni&egrave;re activit&eacute;</th>
        <th>UA</th>
      </tr>
    </thead>
    <tbody>
      <% logs.forEach(function(row) {
           var isRecent = (Date.now() - new Date(row.last_seen).getTime()) < 30 * 60 * 1000;
           var fmtTime = function(iso) {
             var d = new Date(iso), diff = Date.now() - d.getTime();
             if (diff < 60000) return 'à l\'instant';
             if (diff < 3600000) return Math.floor(diff/60000) + ' min';
             if (diff < 86400000) return Math.floor(diff/3600000) + 'h';
             return d.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit' }) + ' ' + d.toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' });
           };
      %>
      <tr data-ip="<%= row.ip %>">
        <td class="ipl-ip">
          <% if (isRecent) { %><span class="ipl-new" title="Actif r&eacute;cemment"></span><% } %>
          <a href="/admin/ip-logs/<%= encodeURIComponent(row.ip) %>"><%= row.ip %></a>
        </td>
        <td>
          <div class="ipl-geo">
            <span class="ipl-flag" data-geo-flag="<%= row.ip %>">…</span>
            <div>
              <div class="ipl-country" data-geo-country="<%= row.ip %>">…</div>
              <div class="ipl-city" data-geo-city="<%= row.ip %>"></div>
            </div>
          </div>
        </td>
        <td class="ipl-hits"><%= row.hits %></td>
        <td class="ipl-paths"><%= row.path_count %> page<%= row.path_count !== 1 ? 's' : '' %></td>
        <td>
          <% if (row.user_id) { %>
            <span class="ipl-user-badge">Connect&eacute; #<%= row.user_id %></span>
          <% } else { %>
            <span class="ipl-anon">Anonyme</span>
          <% } %>
        </td>
        <td class="ipl-time"><%= fmtTime(row.last_seen) %></td>
        <td class="ipl-ua" title="<%= row.user_agent %>"><%= row.user_agent %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<script nonce="<%= nonce %>">
(function() {
  // Charge la géolocalisation pour chaque IP visible
  var done = new Set();
  function loadGeo(ip) {
    if (done.has(ip)) return;
    done.add(ip);
    fetch('/admin/ip-geo?ip=' + encodeURIComponent(ip))
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var flag = countryCodeToFlag(d.countryCode || '');
        document.querySelectorAll('[data-geo-flag="' + CSS.escape(ip) + '"]').forEach(function(el) { el.textContent = flag || '🌍'; });
        document.querySelectorAll('[data-geo-country="' + CSS.escape(ip) + '"]').forEach(function(el) { el.textContent = d.country || '?'; });
        document.querySelectorAll('[data-geo-city="' + CSS.escape(ip) + '"]').forEach(function(el) { el.textContent = d.city || ''; });
      })
      .catch(function() {
        document.querySelectorAll('[data-geo-flag="' + CSS.escape(ip) + '"]').forEach(function(el) { el.textContent = '🌍'; });
        document.querySelectorAll('[data-geo-country="' + CSS.escape(ip) + '"]').forEach(function(el) { el.textContent = '?'; });
      });
  }
  function countryCodeToFlag(code) {
    if (!code || code.length !== 2) return '';
    var c = code.toUpperCase();
    return String.fromCodePoint(c.charCodeAt(0) + 127397) + String.fromCodePoint(c.charCodeAt(1) + 127397);
  }

  // Charge par batch de 5 pour ne pas saturer ip-api.com (45 req/min)
  var rows = Array.from(document.querySelectorAll('[data-ip]'));
  var idx = 0;
  function nextBatch() {
    var batch = rows.slice(idx, idx + 5);
    if (!batch.length) return;
    idx += 5;
    batch.forEach(function(r) { loadGeo(r.dataset.ip); });
    if (idx < rows.length) setTimeout(nextBatch, 1400); // ~3.5 req/s < 45/min
  }
  nextBatch();
})();
</script>

<%- include('partials/foot') %>
