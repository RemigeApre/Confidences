<%- include('partials/head', { title: 'Admin : IP Logs', extraCss: ['admin.css'] }) %>

<style>
/* ── Layout ─────────────────────────────────────────────────────────────── */
.ipl-sidebar{position:fixed;left:0;top:var(--topnav-height);bottom:0;width:calc((100vw - 1060px)/2);min-width:210px;max-width:320px;display:flex;flex-direction:column;background:linear-gradient(180deg,#1a1a2e 0%,#141420 100%);border-right:1px solid rgba(255,255,255,.07);overflow-y:auto;z-index:5;padding:1.25rem 1rem 3rem}
.ipl-wrap{padding:1.25rem 1.5rem 5rem;max-width:1060px;margin:0 auto}
/* ── Sidebar content ─────────────────────────────────────────────────────── */
.ipl-sb-title{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.3);margin:0 0 .6rem}
.ipl-sb-section{margin-bottom:1.4rem}
.ipl-range-btn{display:block;width:100%;text-align:left;font-size:.78rem;padding:.35rem .6rem;border-radius:6px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:rgba(255,255,255,.5);cursor:pointer;text-decoration:none;transition:background .1s,color .1s;margin-bottom:.3rem}
.ipl-range-btn:hover,.ipl-range-btn.active{background:rgba(255,255,255,.1);color:#e2e8f0;border-color:rgba(255,255,255,.18)}
.ipl-filter-btn{display:flex;align-items:center;gap:.5rem;width:100%;text-align:left;font-size:.78rem;padding:.35rem .6rem;border-radius:6px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:rgba(255,255,255,.5);cursor:pointer;transition:background .1s,color .1s;margin-bottom:.3rem}
.ipl-filter-btn:hover{background:rgba(255,255,255,.08);color:#e2e8f0}
.ipl-filter-btn.active{background:rgba(99,179,237,.12);border-color:rgba(99,179,237,.3);color:#7dd3fc}
.ipl-filter-btn .ipl-type{font-size:.6rem;padding:.1rem .4rem}
.ipl-country-select{width:100%;font-size:.78rem;padding:.35rem .5rem;border-radius:6px;border:1px solid rgba(255,255,255,.1);background:#1e1e2e;color:#e2e8f0;cursor:pointer;outline:none}
.ipl-sb-count{font-size:.68rem;color:rgba(255,255,255,.3);margin-top:.5rem}
/* ── Toolbar ─────────────────────────────────────────────────────────────── */
.ipl-toolbar{display:flex;align-items:center;gap:.75rem;margin-bottom:1.5rem;flex-wrap:wrap}
.ipl-h1{font-size:1rem;font-weight:700;color:#e2e8f0;margin:0;flex:1}
/* ── Table ───────────────────────────────────────────────────────────────── */
.ipl-empty{color:rgba(255,255,255,.3);font-size:.9rem;text-align:center;padding:3rem 0}
.ipl-table{width:100%;border-collapse:collapse}
.ipl-table th{border-bottom:1px solid rgba(255,255,255,.07);padding:.45rem .6rem;text-align:center;white-space:nowrap}
.ipl-sort-btn{background:none;border:none;cursor:pointer;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.45);padding:0;display:inline-flex;align-items:center;gap:.3rem;transition:color .1s}
.ipl-sort-btn:hover{color:#e2e8f0}
.ipl-sort-btn.active{color:#7dd3fc}
.ipl-sort-arrow{font-size:.6rem;opacity:.5}
.ipl-sort-btn.active .ipl-sort-arrow{opacity:1}
.ipl-table th.no-sort{font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.35)}
.ipl-table td{padding:.42rem .6rem;border-bottom:1px solid rgba(255,255,255,.04);font-size:.78rem;color:rgba(255,255,255,.65);vertical-align:middle;text-align:center}
.ipl-table td.ipl-ip,.ipl-table td.ipl-model-cell,.ipl-table td.ipl-isp-cell,.ipl-table td.ipl-ua{text-align:left}
.ipl-table tr:hover td{background:rgba(255,255,255,.025)}
/* ── Type badges ─────────────────────────────────────────────────────────── */
.ipl-type{display:inline-flex;align-items:center;gap:.28rem;font-size:.66rem;font-weight:700;padding:.15rem .5rem;border-radius:10px;white-space:nowrap}
.ipl-type--strange{background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.35);color:#fca5a5}
.ipl-type--scraper{background:rgba(251,146,60,.12);border:1px solid rgba(251,146,60,.3);color:#fdba74}
.ipl-type--legit{background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);color:#86efac}
.ipl-type--human{background:rgba(99,179,237,.1);border:1px solid rgba(99,179,237,.25);color:#7dd3fc}
.ipl-type--confirmed{background:rgba(167,139,250,.13);border:1px solid rgba(167,139,250,.3);color:#c4b5fd}
/* ── Row tinting ─────────────────────────────────────────────────────────── */
.ipl-row--strange td{background:rgba(239,68,68,.03)}
.ipl-row--scraper td{background:rgba(251,146,60,.025)}
.ipl-row--hidden{display:none}
/* ── Cells ───────────────────────────────────────────────────────────────── */
.ipl-ip{font-family:monospace;font-size:.8rem;color:#7dd3fc;font-weight:600;white-space:nowrap}
.ipl-ip a{color:inherit;text-decoration:none}
.ipl-ip a:hover{text-decoration:underline}
.ipl-geo{display:flex;align-items:center;justify-content:center;white-space:nowrap;cursor:default}
.ipl-flag{font-size:1.1rem;line-height:1}
.ipl-dot-unknown{display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;cursor:default}
.ipl-hits{font-weight:700;color:#e2e8f0}
.ipl-paths{font-size:.7rem;color:rgba(255,255,255,.35)}
.ipl-user-badge{font-size:.66rem;padding:.1rem .38rem;border-radius:10px;background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.2);color:#c4b5fd;white-space:nowrap}
.ipl-anon{font-size:.68rem;color:rgba(255,255,255,.22)}
.ipl-time{font-size:.7rem;color:rgba(255,255,255,.35);white-space:nowrap}
.ipl-ua{max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.65rem;color:rgba(255,255,255,.28)}
.ipl-model{font-size:.72rem;color:rgba(255,255,255,.5);white-space:nowrap}
.ipl-isp{font-size:.7rem;color:rgba(255,255,255,.4);white-space:nowrap}
.ipl-new{display:inline-block;width:6px;height:6px;border-radius:50%;background:#4ade80;margin-right:.3rem;vertical-align:middle}
.ipl-origin{font-size:.7rem;color:rgba(255,255,255,.45);max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ipl-lang{font-size:.72rem;color:rgba(255,255,255,.5);font-variant:small-caps;letter-spacing:.04em}
.ipl-type--manual{outline:2px solid rgba(255,255,255,.3);outline-offset:1px}
.ipl-analysed-badge{display:inline-block;width:.5rem;height:.5rem;border-radius:50%;background:#4ade80;margin-left:.35rem;vertical-align:middle;flex-shrink:0}
.ipl-row--analysed td{opacity:.6}
</style>

<div class="admin-topbar">
  <a href="/ponhgup#tab-log" class="admin-topbar-back">&#8592; Retour</a>
  <span class="admin-topbar-title"><%= config.title %></span>
</div>

<!-- Sidebar gauche : filtres -->
<aside class="ipl-sidebar">
  <div class="ipl-sb-section">
    <p class="ipl-sb-title">P&eacute;riode</p>
    <% [6, 24, 48, 168, 336, 720].forEach(function(h) { %>
      <a href="/ponhgup/ip-logs?h=<%= h %>" class="ipl-range-btn<%= hours === h ? ' active' : '' %>">
        <%= h < 24 ? h + 'h' : (h < 168 ? (h/24) + 'j' : (h/168).toFixed(2).replace(/\.?0+$/,'') + 'sem') %>
      </a>
    <% }) %>
  </div>

  <div class="ipl-sb-section">
    <p class="ipl-sb-title">Type</p>
    <button class="ipl-filter-btn active" data-filter="all">Tous</button>
    <button class="ipl-filter-btn" data-filter="confirmed"><span class="ipl-type ipl-type--confirmed">★ Utilisateur</span></button>
    <button class="ipl-filter-btn" data-filter="human"><span class="ipl-type ipl-type--human">● Visiteur</span></button>
    <button class="ipl-filter-btn" data-filter="legit"><span class="ipl-type ipl-type--legit">✓ Bot l&eacute;gitime</span></button>
    <button class="ipl-filter-btn" data-filter="scraper"><span class="ipl-type ipl-type--scraper">⚡ Scraper</span></button>
    <button class="ipl-filter-btn" data-filter="strange"><span class="ipl-type ipl-type--strange">⚠ IP &Eacute;trange</span></button>
  </div>

  <div class="ipl-sb-section" id="ipl-country-group" style="display:none">
    <p class="ipl-sb-title">Pays</p>
    <select id="ipl-country-select" class="ipl-country-select">
      <option value="">Tous les pays</option>
    </select>
  </div>

  <p class="ipl-sb-count"><span id="ipl-count"><%= logs.length %></span> adresse<%= logs.length !== 1 ? 's' : '' %></p>
</aside>

<div class="ipl-wrap">
  <div class="ipl-toolbar">
    <h1 class="ipl-h1">IP Logger</h1>
  </div>

  <% if (!logs.length) { %>
    <p class="ipl-empty">Aucune activit&eacute; enregistr&eacute;e sur cette p&eacute;riode.</p>
  <% } else { %>
  <table class="ipl-table" id="ipl-table">
    <thead>
      <tr>
        <th><button class="ipl-sort-btn" data-sort="ip">IP <span class="ipl-sort-arrow"></span></button></th>
        <th><button class="ipl-sort-btn" data-sort="type">Type <span class="ipl-sort-arrow"></span></button></th>
        <th class="no-sort">Appareil</th>
        <th class="no-sort">FAI</th>
        <th class="no-sort">Origine</th>
        <th class="no-sort">Langue</th>
        <th><button class="ipl-sort-btn" data-sort="country">Pays <span class="ipl-sort-arrow"></span></button></th>
        <th><button class="ipl-sort-btn" data-sort="hits">Visites <span class="ipl-sort-arrow"></span></button></th>
        <th><button class="ipl-sort-btn" data-sort="pages">Pages <span class="ipl-sort-arrow"></span></button></th>
        <th class="no-sort">Profil</th>
        <th><button class="ipl-sort-btn active" data-sort="recent">Activit&eacute; <span class="ipl-sort-arrow">▼</span></button></th>
        <th class="no-sort">UA</th>
      </tr>
    </thead>
    <tbody id="ipl-tbody">
      <% logs.forEach(function(row) {
           var isRecent = (Date.now() - new Date(row.last_seen).getTime()) < 30 * 60 * 1000;
           var fmtTime = function(iso) {
             var d = new Date(iso), diff = Date.now() - d.getTime();
             if (diff < 60000) return 'à l\'instant';
             if (diff < 3600000) return Math.floor(diff/60000) + ' min';
             if (diff < 86400000) return Math.floor(diff/3600000) + 'h';
             return d.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit' }) + ' ' + d.toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' });
           };
      %>
      <tr class="ipl-row" data-ip="<%= row.ip %>" data-ua="<%= (row.user_agent || '').replace(/"/g,'&quot;') %>" data-hits="<%= row.hits %>" data-userid="<%= row.user_id || '' %>" data-username="<%= (row.user_display_name || '').replace(/"/g,'&quot;') %>" data-lastseen="<%= row.last_seen %>" data-manualtype="<%= row.manual_type || '' %>" data-analysed="<%= row.analysed ? '1' : '' %>">
        <td class="ipl-ip">
          <a href="/ponhgup/ip-logs/<%= encodeURIComponent(row.ip) %>"><%= row.ip %></a>
        </td>
        <td class="ipl-type-cell">…</td>
        <td class="ipl-model-cell ipl-model">…</td>
        <td class="ipl-isp-cell ipl-isp" data-geo-isp="<%= row.ip %>">…</td>
        <%
          var _ref = row.referer || '';
          var _refLabel = '';
          if (_ref) {
            try {
              var _u = new URL(_ref);
              _refLabel = _u.hostname.replace(/^www\./, '');
            } catch(e) { _refLabel = _ref.slice(0, 30); }
          }
          var _lang = (row.accept_language || '').split(',')[0].split(';')[0].trim().slice(0, 5);
        %>
        <td class="ipl-origin" title="<%= _ref %>"><%= _refLabel || '<span class="ipl-anon">direct</span>' %></td>
        <td class="ipl-lang"><%= _lang || '' %></td>
        <td class="ipl-geo-cell" data-geo-ip="<%= row.ip %>">
          <div class="ipl-geo"><span style="color:rgba(255,255,255,.15);font-size:.65rem">…</span></div>
        </td>
        <td class="ipl-hits"><%= row.hits %></td>
        <td class="ipl-paths"><%= row.path_count %> page<%= row.path_count !== 1 ? 's' : '' %></td>
        <td>
          <% if (row.user_id) { %>
            <span class="ipl-user-badge"><%= row.user_display_name || ('#' + row.user_id) %></span>
          <% } else { %>
            <span class="ipl-anon">Anonyme</span>
          <% } %>
        </td>
        <td class="ipl-time"><% if (isRecent) { %><span class="ipl-new" title="Actif r&eacute;cemment"></span><% } %><%= fmtTime(row.last_seen) %></td>
        <td class="ipl-ua" title="<%= row.user_agent %>"><%= row.user_agent %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<script nonce="<%= nonce %>">
(function () {

  // ── 1. Classification UA ──────────────────────────────────────────────────

  function classifyUA(ua, hits, hours, hasUserId) {
    var u = (ua || '').toLowerCase();

    // Utilisateur authentifié : priorité absolue
    if (hasUserId) return 'confirmed';

    // Bots légitimes déclarés
    var legitPatterns = [
      'censysinspect', 'palo alto networks', 'cortex xpanse',
      'modatscanner', 'modat.io', 'visionheight', 'visionheight.com/scan',
      'internetmeasurement', 'googlebot', 'bingbot', 'ahrefsbot',
      'semrushbot', 'duckduckbot', 'yandexbot', 'facebookexternalhit',
      'twitterbot', 'linkedinbot', 'uptimerobot', 'pingdom'
    ];
    for (var i = 0; i < legitPatterns.length; i++) {
      if (u.indexOf(legitPatterns[i]) !== -1) return 'legit';
    }

    // Scrapers / scripts évidents (UA déclaré)
    if (/^curl\//.test(u) || /^wget\//.test(u) || /^python\//.test(u) ||
        u.indexOf('aiohttp') !== -1 || u.indexOf('httpx') !== -1 ||
        u.indexOf('scrapy') !== -1 || u.indexOf('go-http-client') !== -1 ||
        u.indexOf('java/') !== -1 || u.indexOf('libwww-perl') !== -1 ||
        u === '' || u === '-') return 'scraper';

    // Taux de visite anormal avec UA navigateur générique = scraper masqué
    var hitsPerHour = hours > 0 ? hits / hours : hits;
    var isMobile = /mobile|iphone|ipad|android|tablet|touch/.test(u);
    var isDesktopBrowser = /mozilla\/5\.0/.test(u) && !isMobile;
    if (isDesktopBrowser && hitsPerHour > 10) return 'scraper';

    // IP Étrange : UA obsolète/falsifié
    if (/android [123]\.\d/.test(u)) return 'strange';
    if (/chrome\/[1-5]\d\./.test(u) && !/chromium/.test(u)) return 'strange';
    if (/edg\/[1-8]\d\./.test(u) && parseInt(u.match(/edg\/(\d+)/)[1]) < 44) return 'strange';
    if (/iphone os [1-9]_/.test(u) && /iphone os [1-9][^0-9_]/.test(u)) return 'strange';
    var chromeMatch = u.match(/chrome\/(\d+)\./);
    if (chromeMatch && parseInt(chromeMatch[1]) > 150) return 'strange';

    return 'human';
  }

  function typeLabel(type) {
    if (type === 'strange')   return '<span class="ipl-type ipl-type--strange">⚠ IP Étrange</span>';
    if (type === 'scraper')   return '<span class="ipl-type ipl-type--scraper">⚡ Scraper</span>';
    if (type === 'legit')     return '<span class="ipl-type ipl-type--legit">✓ Bot Légitime</span>';
    if (type === 'confirmed') return '<span class="ipl-type ipl-type--confirmed">★ Utilisateur</span>';
    return '<span class="ipl-type ipl-type--human">● Visiteur</span>';
  }

  function typeOrder(type) {
    return { strange: 0, scraper: 1, legit: 2, human: 3, confirmed: 4 }[type] ?? 5;
  }

  // ── 2. Déduction appareil depuis UA ──────────────────────────────────────

  function parseDevice(ua) {
    var u = ua || '';

    // Scripts / outils
    if (/^curl\//i.test(u))    return 'curl (outil ligne de commande)';
    if (/^wget\//i.test(u))    return 'wget (outil ligne de commande)';
    if (/^python\//i.test(u) || /aiohttp/i.test(u)) return 'Script Python (serveur)';
    if (/^go-http/i.test(u))   return 'Script Go (serveur)';

    // Bots connus
    if (/CensysInspect/i.test(u))       return 'Serveur Censys (scanner)';
    if (/palo alto/i.test(u))           return 'Serveur Palo Alto (scanner)';
    if (/ModatScanner/i.test(u))        return 'Serveur Modat (scanner)';
    if (/visionheight/i.test(u))        return 'Serveur VisionHeight (scanner)';
    if (/InternetMeasurement/i.test(u)) return 'Serveur recherche réseau';
    if (/Googlebot/i.test(u))           return 'Serveur Google (bot)';

    // iOS / iPhone
    var iosMatch = u.match(/iPhone(?:.*?)OS ([\d_]+)/i);
    if (iosMatch) {
      var iosVer = iosMatch[1].replace(/_/g, '.');
      var iosMaj = parseInt(iosVer);
      var model = iosMaj >= 17 ? 'iPhone 15/16' : iosMaj >= 15 ? 'iPhone 12-14' : iosMaj >= 13 ? 'iPhone X-11' : 'iPhone (ancien)';
      return model + ' — iOS ' + iosVer;
    }

    // iPad
    if (/iPad/i.test(u)) return 'iPad — iOS ' + ((u.match(/OS ([\d_]+)/i) || [])[1] || '?').replace(/_/g,'.');

    // Android
    var androidMatch = u.match(/Android ([\d.]+)/i);
    if (androidMatch) {
      var av = parseFloat(androidMatch[1]);
      if (av < 4) return 'Android ' + androidMatch[1] + ' — UA FALSIFIÉ (version impossible)';
      var phoneMatch = u.match(/;\s*([A-Z][A-Z0-9\s\-]+(?:Build|; ))/i);
      return 'Smartphone Android ' + androidMatch[1] + (phoneMatch ? ' (' + phoneMatch[1].replace(/Build.*/,'').trim() + ')' : '');
    }

    // Mac desktop
    if (/Macintosh.*Intel Mac OS X ([\d_]+)/i.test(u)) {
      var macVer = (u.match(/Mac OS X ([\d_]+)/i) || [])[1] || '';
      return 'Mac (Intel) — macOS ' + macVer.replace(/_/g,'.');
    }
    if (/Macintosh.*Mac OS X/i.test(u)) return 'Mac — macOS (ARM possible)';

    // Windows
    var winMatch = u.match(/Windows NT ([\d.]+)/i);
    if (winMatch) {
      var wv = winMatch[1];
      var wname = wv === '10.0' ? 'Windows 10/11' : wv === '6.3' ? 'Windows 8.1' : wv === '6.1' ? 'Windows 7' : 'Windows NT ' + wv;
      return 'PC — ' + wname;
    }

    // Linux générique
    if (/Linux x86_64/i.test(u)) return 'Serveur Linux x86_64';
    if (/Linux/i.test(u))        return 'Linux (appareil inconnu)';

    return 'Inconnu';
  }

  // ── 3. FAI estimé depuis IP ───────────────────────────────────────────────

  function estimateISP(ip) {
    var parts = ip.split('.').map(Number);
    var a = parts[0], b = parts[1];

    // AWS
    if (a === 3)   return 'Amazon AWS';
    if (a === 18)  return 'Amazon AWS';
    if (a === 52)  return 'Amazon AWS';
    if (a === 54)  return 'Amazon AWS';
    if (a === 34 || a === 35) return 'Google Cloud';
    if (a === 104 && b >= 154 && b <= 199) return 'Google Cloud';
    if (a === 167 && b === 172) return 'DigitalOcean';
    if (a === 161 && b === 35)  return 'DigitalOcean';
    if (a === 137 && b === 184) return 'DigitalOcean';
    if (a === 47)  return 'Alibaba Cloud';
    if (a === 185 && b === 218) return 'Hébergeur EU (inconnu)';
    if (a === 66  && b === 132) return 'Censys Inc.';
    if (a === 205 && b === 210) return 'Palo Alto Networks';
    if (a === 195 && b === 96)  return 'RIPE NCC / Recherche';
    if (a === 195 && b === 182) return 'Inconnu';
    if (a === 31  && b === 14)  return 'OVH / Hébergeur FR';
    if (a === 86)  return 'Orange France';
    if (a === 90)  return 'Orange France';
    if (a === 88)  return 'SFR';
    if (a === 109) return 'SFR';
    if (a === 78)  return 'Bouygues / Free';
    if (a === 82)  return 'Free';
    if (a === 91)  return 'Hébergeur EU';
    if (a === 176) return 'OVH';
    if (a === 178) return 'OVH';
    return '—';
  }

  // ── 4. Populate rows ─────────────────────────────────────────────────────

  var IPL_HOURS = <%= hours %>;
  var rows = Array.from(document.querySelectorAll('.ipl-row'));

  rows.forEach(function(row) {
    var ua         = row.dataset.ua || '';
    var ip         = row.dataset.ip || '';
    var hits       = parseInt(row.dataset.hits) || 0;
    var hasUserId  = !!row.dataset.userid;
    var manualType = row.dataset.manualtype || '';
    var analysed   = !!row.dataset.analysed;

    var type    = manualType || classifyUA(ua, hits, IPL_HOURS, hasUserId);
    var isManual = !!manualType;
    row.classList.add('ipl-row--' + type);
    if (analysed) row.classList.add('ipl-row--analysed');
    row.dataset.type      = type;
    row.dataset.typeOrder = typeOrder(type);

    var typeCell = row.querySelector('.ipl-type-cell');
    typeCell.innerHTML = typeLabel(type);
    if (isManual) typeCell.querySelector('.ipl-type').classList.add('ipl-type--manual');
    if (analysed) {
      var dot = document.createElement('span');
      dot.className = 'ipl-analysed-badge';
      dot.title = 'Analysé';
      typeCell.appendChild(dot);
    }
    row.querySelector('.ipl-model-cell').textContent = parseDevice(ua);
    row.querySelector('.ipl-isp-cell').textContent  = estimateISP(ip);
  });

  // ── 5. Tri & filtre ──────────────────────────────────────────────────────

  var tbody         = document.getElementById('ipl-tbody');
  var currentSort   = 'recent';
  var currentDir    = -1; // -1 = desc (défaut : plus récent en haut)
  var currentFilter = 'all';
  var currentCountry = '';

  function applySort(key, dir) {
    if (!tbody) return;
    var sorted = rows.slice().sort(function(a, b) {
      var va, vb;
      if (key === 'ip')      { va = a.dataset.ip;                       vb = b.dataset.ip; }
      else if (key === 'type')    { va = parseInt(a.dataset.typeOrder);  vb = parseInt(b.dataset.typeOrder); }
      else if (key === 'hits')    { va = parseInt(a.dataset.hits);       vb = parseInt(b.dataset.hits); }
      else if (key === 'pages')   { va = parseInt(a.querySelector('.ipl-paths') ? a.querySelector('.ipl-paths').textContent : 0); vb = parseInt(b.querySelector('.ipl-paths') ? b.querySelector('.ipl-paths').textContent : 0); }
      else if (key === 'country') { va = a.dataset.country || '';        vb = b.dataset.country || ''; }
      else                        { va = a.dataset.lastseen || '';       vb = b.dataset.lastseen || ''; }
      if (va < vb) return -dir;
      if (va > vb) return  dir;
      return 0;
    });
    sorted.forEach(function(r) { tbody.appendChild(r); });
  }

  function updateSortIndicators(activeKey, dir) {
    document.querySelectorAll('.ipl-sort-btn').forEach(function(btn) {
      var isActive = btn.dataset.sort === activeKey;
      btn.classList.toggle('active', isActive);
      var arrow = btn.querySelector('.ipl-sort-arrow');
      if (arrow) arrow.textContent = isActive ? (dir > 0 ? '▲' : '▼') : '';
    });
  }

  function applyVisibility() {
    rows.forEach(function(r) {
      var typeOk    = currentFilter === 'all' || r.dataset.type === currentFilter;
      var countryOk = !currentCountry || r.dataset.country === currentCountry;
      r.classList.toggle('ipl-row--hidden', !(typeOk && countryOk));
    });
    var visible = rows.filter(function(r) { return !r.classList.contains('ipl-row--hidden'); }).length;
    var counter = document.getElementById('ipl-count');
    if (counter) counter.textContent = visible;
  }

  // Tri par clic sur header
  document.querySelectorAll('.ipl-sort-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var key = btn.dataset.sort;
      if (key === currentSort) {
        currentDir = -currentDir; // inverser
      } else {
        currentSort = key;
        currentDir  = key === 'recent' || key === 'hits' || key === 'pages' ? -1 : 1;
      }
      applySort(currentSort, currentDir);
      updateSortIndicators(currentSort, currentDir);
    });
  });

  // Filtre par type (sidebar)
  document.querySelectorAll('[data-filter]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      currentFilter = btn.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      applyVisibility();
    });
  });

  // Appliquer tri initial
  applySort(currentSort, currentDir);
  updateSortIndicators(currentSort, currentDir);

  // ── 6. Géolocalisation ───────────────────────────────────────────────────

  var _dispNames = null;
  try { _dispNames = new Intl.DisplayNames(['fr'], { type: 'region' }); } catch(_) {}

  function countryName(code) {
    if (!code) return '';
    try { return _dispNames ? _dispNames.of(code.toUpperCase()) : code.toUpperCase(); } catch(_) { return code.toUpperCase(); }
  }

  // Index ip → cellule geo pour mise à jour rapide
  var geoCells = {};
  document.querySelectorAll('.ipl-geo-cell').forEach(function(cell) {
    geoCells[cell.dataset.geoIp] = cell;
  });

  var countriesSet = new Set();

  var done = new Set();
  function loadGeo(ip) {
    if (done.has(ip)) return;
    done.add(ip);
    fetch('/ponhgup/ip-geo?ip=' + encodeURIComponent(ip))
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var cell = geoCells[ip];
        var row  = cell ? cell.closest('tr') : null;
        if (!cell) return;

        var geo = cell.querySelector('.ipl-geo');
        geo.innerHTML = '';

        if (d.unknown) {
          var dot = document.createElement('span');
          dot.className = 'ipl-dot-unknown';
          dot.title = 'Inconnu';
          geo.appendChild(dot);
          if (row) row.dataset.country = '';
          return;
        }

        var code  = (d.countryCode || '').toUpperCase();
        var name  = countryName(code);
        var parts = [name, d.region, d.city].filter(Boolean);
        var tip   = parts.join(' · ') || code;

        if (code && code.length === 2) {
          var img = document.createElement('img');
          img.src    = 'https://flagcdn.com/24x18/' + code.toLowerCase() + '.png';
          img.width  = 24;
          img.height = 18;
          img.alt    = code;
          img.title  = tip;
          img.style.cssText = 'display:block;border-radius:2px';
          geo.appendChild(img);
        } else {
          var dot = document.createElement('span');
          dot.className = 'ipl-dot-unknown';
          dot.title = tip || 'Inconnu';
          geo.appendChild(dot);
        }

        if (row) {
          row.dataset.country = code;
          if (code) {
            countriesSet.add(code + '|' + name);
            rebuildCountrySelect();
          }
        }
      })
      .catch(function() {
        var cell = geoCells[ip];
        if (cell) cell.querySelector('.ipl-geo').innerHTML = '<span class="ipl-dot-unknown" title="Inconnu"></span>';
      });
  }

  // Filtre pays
  var countrySelect = document.getElementById('ipl-country-select');
  var countryGroup  = document.getElementById('ipl-country-group');
  var currentCountry = '';

  function rebuildCountrySelect() {
    if (!countrySelect) return;
    var current = countrySelect.value;
    var sorted  = Array.from(countriesSet).sort(function(a,b){ return a.split('|')[1].localeCompare(b.split('|')[1],'fr'); });
    while (countrySelect.firstChild) countrySelect.removeChild(countrySelect.firstChild);
    var allOpt = document.createElement('option');
    allOpt.value = '';
    allOpt.textContent = 'Tous';
    countrySelect.appendChild(allOpt);
    sorted.forEach(function(entry) {
      var parts = entry.split('|');
      var opt   = document.createElement('option');
      opt.value = parts[0];
      opt.textContent = parts[0] + ' – ' + parts[1];
      if (parts[0] === current) opt.selected = true;
      countrySelect.appendChild(opt);
    });
    if (countryGroup && sorted.length > 1) countryGroup.style.display = '';
  }

  if (countrySelect) {
    countrySelect.addEventListener('change', function() {
      currentCountry = countrySelect.value;
      applyVisibility();
    });
  }

  var idx = 0;
  function nextBatch() {
    var batch = rows.slice(idx, idx + 8);
    if (!batch.length) return;
    idx += 8;
    batch.forEach(function(r) { loadGeo(r.dataset.ip); });
    if (idx < rows.length) setTimeout(nextBatch, 400);
  }
  nextBatch();

})();
</script>

