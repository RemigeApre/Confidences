<%- include('partials/head', { title: 'Test de personnalité' }) %>
<main class="container" style="--ch-hue: 270">
  <%- include('partials/top-nav', { config: config, navTitle: 'Test de personnalité', navBack: '/quizz' }) %>

  <div class="pqt-wrap">
    <h1 class="pqt-title">Test de personnalité</h1>
    <p class="pqt-desc">
      Découvrez votre profil intime en cinq dimensions : rythme, moteur, nouveauté, scénario et plaisir.
      Chaque réponse révèle une facette de votre façon de vivre le désir.
      <a href="/quizz/profil/personnalites" class="pqt-pers-inline-link">Découvrir les 32 personnalités&nbsp;›</a>
    </p>

    <div class="pqt-cards">
      <% types.forEach(function(t) { %>
      <% var attempts = attemptsMap[t.id] || []; %>
      <% var last = attempts[0] || null; %>
      <a href="/quizz/profil/<%= t.slug %>" class="pqt-card<%= last ? ' pqt-card--done' : '' %>">
        <% if (last) { %><span class="pqt-card-done-badge">&#10003;</span><% } %>
        <div class="pqt-card-info">
          <p class="pqt-card-name"><%= t.name %></p>
          <% if (t.description) { %>
          <p class="pqt-card-desc"><%= t.description %></p>
          <% } %>
          <% if (last) { %>
          <p class="pqt-card-last"><%= last.result_archetype %> (<%= last.result_code %>-<%= last.result_position %>)</p>
          <% } %>
        </div>
        <% if (last) { %>
        <span class="pqt-card-code"><%= last.result_code %></span>
        <% } %>
        <span class="pqt-card-btn"><%= last ? 'Repasser' : 'Commencer' %></span>
      </a>
      <% }) %>
      <% if (!types.length) { %>
      <p style="color:var(--muted)">Aucun test disponible pour le moment.</p>
      <% } %>
    </div>
  </div>

  <%- include('partials/foot') %>
</main>
