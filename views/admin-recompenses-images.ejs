<%- include('partials/head', { title: 'Admin : Images de profil', extraCss: ['admin.css'] }) %>

<style>
.ari-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(110px,1fr)); gap:.6rem; margin-top:1rem; }
.ari-card { position:relative; border-radius:8px; overflow:hidden; cursor:pointer; border:2px solid transparent; transition:border-color .15s, transform .12s; aspect-ratio:1; background:#0f172a; }
.ari-card:hover { transform:scale(1.03); border-color:rgba(255,255,255,.3); }
.ari-card img { width:100%; height:100%; object-fit:cover; display:block; }
.ari-card-rarity { position:absolute; bottom:0; left:0; right:0; font-size:.65rem; font-weight:700; text-align:center; padding:.15rem; letter-spacing:.04em; text-transform:uppercase; }
.ari-card[data-rarity="common"]    .ari-card-rarity { background:rgba(0,0,0,.6); color:#94a3b8; }
.ari-card[data-rarity="rare"]      .ari-card-rarity { background:rgba(37,99,235,.7); color:#bfdbfe; }
.ari-card[data-rarity="epic"]      .ari-card-rarity { background:rgba(109,40,217,.7); color:#ddd6fe; }
.ari-card[data-rarity="legendary"] .ari-card-rarity { background:rgba(180,83,9,.75); color:#fde68a; }
.ari-card[data-rarity="mythic"]    .ari-card-rarity { background:rgba(185,28,28,.75); color:#fca5a5; }

/* Zoom overlay */
.ari-zoom-overlay { position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.85); display:flex; align-items:center; justify-content:center; }
.ari-zoom-overlay[hidden] { display:none; }
.ari-zoom-box { position:relative; background:#1e293b; border-radius:14px; padding:1.5rem; width:min(95vw,780px); display:flex; gap:1.5rem; flex-wrap:wrap; align-items:flex-start; }
.ari-zoom-img-wrap { flex:1; min-width:200px; max-width:360px; }
.ari-zoom-img-wrap img { width:100%; border-radius:8px; object-fit:contain; max-height:420px; }
.ari-zoom-side { flex:1; min-width:180px; display:flex; flex-direction:column; gap:1rem; }
.ari-zoom-title { font-weight:700; font-size:1rem; color:#f1f5f9; margin:0; }
.ari-zoom-subtitle { font-size:.78rem; color:#64748b; margin:.15rem 0 0; }

/* Profile preview circle */
.ari-profile-preview { width:72px; height:72px; border-radius:50%; overflow:hidden; border:3px solid rgba(255,255,255,.15); flex-shrink:0; }
.ari-profile-preview img { width:100%; height:100%; object-fit:cover; }

.ari-rarity-btns { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.25rem; }
.ari-rarity-btn { border:2px solid; border-radius:6px; padding:.3rem .65rem; font-size:.75rem; font-weight:700; cursor:pointer; background:transparent; transition:background .12s, color .12s; text-transform:uppercase; letter-spacing:.04em; }
.ari-rarity-btn[data-rarity="common"]    { border-color:#94a3b8; color:#94a3b8; }
.ari-rarity-btn[data-rarity="rare"]      { border-color:#60a5fa; color:#60a5fa; }
.ari-rarity-btn[data-rarity="epic"]      { border-color:#a78bfa; color:#a78bfa; }
.ari-rarity-btn[data-rarity="legendary"]{ border-color:#fbbf24; color:#fbbf24; }
.ari-rarity-btn[data-rarity="mythic"]    { border-color:#f87171; color:#f87171; }
.ari-rarity-btn.active[data-rarity="common"]    { background:#94a3b8; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="rare"]      { background:#60a5fa; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="epic"]      { background:#a78bfa; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="legendary"] { background:#fbbf24; color:#0f172a; }
.ari-rarity-btn.active[data-rarity="mythic"]    { background:#f87171; color:#0f172a; }

.ari-nav-btns { display:flex; gap:.5rem; }
.ari-nav-btn { width:40px; height:40px; border-radius:8px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18); color:#f1f5f9; cursor:pointer; font-size:1.1rem; display:flex; align-items:center; justify-content:center; transition:background .12s; }
.ari-nav-btn:hover { background:rgba(255,255,255,.18); }

.ari-zoom-close { position:absolute; top:.6rem; right:.8rem; background:none; border:none; color:#f87171; cursor:pointer; padding:.25rem; line-height:0; }
.ari-zoom-close:hover { color:#ef4444; }

.ari-save-status { font-size:.78rem; height:1.2em; transition:opacity .3s; }

/* Filter bar */
.ari-filter-bar { display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:.75rem; }
.ari-filter-btn { border:1px solid rgba(255,255,255,.2); background:rgba(255,255,255,.05); color:#94a3b8; border-radius:5px; padding:.3rem .65rem; font-size:.75rem; font-weight:600; cursor:pointer; text-transform:uppercase; transition:background .12s; }
.ari-filter-btn.active, .ari-filter-btn:hover { background:rgba(255,255,255,.15); color:#f1f5f9; }
</style>

<div class="admin-topbar">
  <a href="/admin/recompenses" class="admin-topbar-back">&#8592; R&eacute;compenses</a>
  <span class="admin-topbar-title"><%= config.title %> &mdash; Images de profil</span>
</div>

<main class="admin-main" style="max-width:1100px">

  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;margin-bottom:.5rem">
    <p style="color:#64748b;font-size:.85rem;margin:0"><%= images.length %> image(s) &mdash; cliquez pour d&eacute;finir la raret&eacute;</p>
    <div class="ari-filter-bar" id="ari-filter-bar">
      <button class="ari-filter-btn active" data-filter="all">Tout</button>
      <button class="ari-filter-btn" data-filter="common">Commun</button>
      <button class="ari-filter-btn" data-filter="rare">Rare</button>
      <button class="ari-filter-btn" data-filter="epic">&Eacute;pique</button>
      <button class="ari-filter-btn" data-filter="legendary">L&eacute;gendaire</button>
      <button class="ari-filter-btn" data-filter="mythic">Mythique</button>
    </div>
  </div>

  <div class="ari-grid" id="ari-grid">
    <% images.forEach(function(img, idx) { %>
    <div class="ari-card" data-id="<%= img.id %>" data-rarity="<%= img.rarity %>" data-idx="<%= idx %>" tabindex="0" role="button" aria-label="<%= img.title || 'Image ' + img.id %>">
      <% if (img.thumb) { %>
        <img src="<%= img.thumb %>" alt="<%= img.title || '' %>" loading="lazy">
      <% } else { %>
        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#475569;font-size:1.8rem">&#128247;</div>
      <% } %>
      <div class="ari-card-rarity"><%= img.rarity %></div>
    </div>
    <% }) %>
  </div>

</main>

<!-- Zoom overlay -->
<div class="ari-zoom-overlay" id="ariZoom" hidden>
  <div class="ari-zoom-box">
    <button class="ari-zoom-close" id="ariZoomClose" aria-label="Fermer">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div class="ari-zoom-img-wrap">
      <img id="ariZoomImg" src="" alt="">
    </div>

    <div class="ari-zoom-side">
      <div>
        <p class="ari-zoom-title" id="ariZoomTitle">—</p>
        <p class="ari-zoom-subtitle" id="ariZoomSubtitle">id: —</p>
      </div>

      <div>
        <p style="font-size:.78rem;color:#94a3b8;margin:0 0 .4rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em">Aperçu icône profil</p>
        <div class="ari-profile-preview">
          <img id="ariProfilePreview" src="" alt="">
        </div>
      </div>

      <div>
        <p style="font-size:.78rem;color:#94a3b8;margin:0 0 .5rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em">Rareté</p>
        <div class="ari-rarity-btns" id="ariRarityBtns">
          <button class="ari-rarity-btn" data-rarity="common">Commun</button>
          <button class="ari-rarity-btn" data-rarity="rare">Rare</button>
          <button class="ari-rarity-btn" data-rarity="epic">&Eacute;pique</button>
          <button class="ari-rarity-btn" data-rarity="legendary">L&eacute;gendaire</button>
          <button class="ari-rarity-btn" data-rarity="mythic">Mythique</button>
        </div>
        <p class="ari-save-status" id="ariSaveStatus" style="color:#4ade80;margin:.4rem 0 0">&nbsp;</p>
      </div>

      <div class="ari-nav-btns" style="margin-top:auto">
        <button class="ari-nav-btn" id="ariNavPrev" title="Pr&eacute;c&eacute;dent">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <button class="ari-nav-btn" id="ariNavNext" title="Suivant">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
        <span id="ariNavCount" style="font-size:.78rem;color:#64748b;align-self:center;margin-left:.25rem"></span>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= nonce %>">
(function() {
  // Build data array from server-rendered cards
  const cards = Array.from(document.querySelectorAll('.ari-card'));
  const data = cards.map(c => ({
    id:     Number(c.dataset.id),
    rarity: c.dataset.rarity || 'common',
    title:  c.getAttribute('aria-label') || '',
    thumb:  c.querySelector('img') ? c.querySelector('img').src : '',
  }));

  let visibleIdxs = data.map((_, i) => i); // indices currently shown by filter
  let zoomIdx = 0; // index in visibleIdxs

  // ── Filter ────────────────────────────────────────────────────────────────
  const filterBar = document.getElementById('ari-filter-bar');
  filterBar.addEventListener('click', function(e) {
    const btn = e.target.closest('.ari-filter-btn');
    if (!btn) return;
    filterBar.querySelectorAll('.ari-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    visibleIdxs = [];
    cards.forEach((c, i) => {
      const show = f === 'all' || c.dataset.rarity === f;
      c.hidden = !show;
      if (show) visibleIdxs.push(i);
    });
  });

  // ── Zoom ──────────────────────────────────────────────────────────────────
  const overlay = document.getElementById('ariZoom');
  const zoomImg = document.getElementById('ariZoomImg');
  const profilePreview = document.getElementById('ariProfilePreview');
  const zoomTitle = document.getElementById('ariZoomTitle');
  const zoomSubtitle = document.getElementById('ariZoomSubtitle');
  const rarityBtns = document.querySelectorAll('#ariRarityBtns .ari-rarity-btn');
  const saveStatus = document.getElementById('ariSaveStatus');
  const navCount = document.getElementById('ariNavCount');

  function openZoom(visIdx) {
    zoomIdx = visIdx;
    renderZoom();
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function renderZoom() {
    const dataIdx = visibleIdxs[zoomIdx];
    if (dataIdx === undefined) return;
    const d = data[dataIdx];
    zoomImg.src = d.thumb || '';
    profilePreview.src = d.thumb || '';
    zoomTitle.textContent = d.title || ('Image #' + d.id);
    zoomSubtitle.textContent = 'id: ' + d.id;
    navCount.textContent = (zoomIdx + 1) + ' / ' + visibleIdxs.length;
    saveStatus.textContent = '\u00a0';
    // Update rarity buttons
    rarityBtns.forEach(b => b.classList.toggle('active', b.dataset.rarity === d.rarity));
  }

  function closeZoom() {
    overlay.hidden = true;
    document.body.style.overflow = '';
  }

  function navigate(delta) {
    const next = zoomIdx + delta;
    if (next < 0 || next >= visibleIdxs.length) return;
    zoomIdx = next;
    renderZoom();
  }

  // Open on card click / Enter
  cards.forEach((c, i) => {
    c.addEventListener('click', () => {
      const vi = visibleIdxs.indexOf(i);
      if (vi !== -1) openZoom(vi);
    });
    c.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); const vi = visibleIdxs.indexOf(i); if (vi !== -1) openZoom(vi); } });
  });

  document.getElementById('ariZoomClose').addEventListener('click', closeZoom);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeZoom(); });
  document.getElementById('ariNavPrev').addEventListener('click', () => navigate(-1));
  document.getElementById('ariNavNext').addEventListener('click', () => navigate(1));

  document.addEventListener('keydown', function(e) {
    if (overlay.hidden) return;
    if (e.key === 'Escape')       closeZoom();
    if (e.key === 'ArrowLeft')    navigate(-1);
    if (e.key === 'ArrowRight')   navigate(1);
  });

  // ── Rarity save ───────────────────────────────────────────────────────────
  rarityBtns.forEach(btn => {
    btn.addEventListener('click', async function() {
      const dataIdx = visibleIdxs[zoomIdx];
      if (dataIdx === undefined) return;
      const d = data[dataIdx];
      const rarity = btn.dataset.rarity;
      saveStatus.textContent = 'Enregistrement…';
      saveStatus.style.color = '#94a3b8';
      try {
        const r = await fetch('/admin/recompenses/images-profil/' + d.id + '/rarity', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rarity }),
        });
        const json = await r.json();
        if (json.ok) {
          d.rarity = rarity;
          // Update card in grid
          const card = cards[dataIdx];
          card.dataset.rarity = rarity;
          card.querySelector('.ari-card-rarity').textContent = rarity;
          // Refresh rarity button highlight
          rarityBtns.forEach(b => b.classList.toggle('active', b.dataset.rarity === rarity));
          saveStatus.textContent = '✓ Enregistré';
          saveStatus.style.color = '#4ade80';
          // Re-apply filter
          const activeFilter = document.querySelector('.ari-filter-btn.active');
          if (activeFilter && activeFilter.dataset.filter !== 'all' && activeFilter.dataset.filter !== rarity) {
            // Card now hidden by filter — advance zoom
            card.hidden = true;
            visibleIdxs = visibleIdxs.filter(vi => vi !== dataIdx);
            if (visibleIdxs.length === 0) { closeZoom(); return; }
            zoomIdx = Math.min(zoomIdx, visibleIdxs.length - 1);
            renderZoom();
          }
        } else {
          saveStatus.textContent = '✗ Erreur';
          saveStatus.style.color = '#f87171';
        }
      } catch (err) {
        saveStatus.textContent = '✗ Erreur réseau';
        saveStatus.style.color = '#f87171';
      }
    });
  });
})();
</script>

<%- include('partials/foot') %>
