<%- include('partials/head', { title: 'Message — ' + partner.displayName }) %>
<main class="container narrow msg-thread-page">
  <%- include('partials/top-nav', { config: config }) %>

  <div class="msg-thread-header">
    <a href="/messages" class="msg-thread-back" aria-label="Retour aux messages">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </a>
    <div class="msg-thread-avatar" style="background:<%= partner.profileColor || '#6b7280' %>">
      <%= (partner.displayName || '?').charAt(0).toUpperCase() %>
    </div>
    <a href="/profil/<%= partner.username %>" class="msg-thread-name"><%= partner.displayName %></a>
    <a href="/messages/<%= partner.id %>/library" class="msg-thread-library-btn" title="Bibliothèque partagée" aria-label="Bibliothèque partagée">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/></svg>
    </a>
  </div>

  <div id="msg-state"
       data-conv-id="<%= conv.id %>"
       data-partner-id="<%= partner.id %>"
       data-my-id="<%= currentUser.id %>">
  </div>

  <%# Zone de messages -%>
  <div class="msg-thread-body" id="msg-thread-body">
    <button class="msg-load-more-btn" id="msg-load-more-btn" type="button" hidden>Charger plus</button>
    <div class="msg-thread-messages" id="msg-thread-messages">
      <% messages.forEach(function(m) { %>
      <article class="msg-bubble msg-bubble--<%= m.sender_id === currentUser.id ? 'me' : 'them' %>"
               data-id="<%= m.id %>">
        <div class="msg-bubble-inner">
          <div class="msg-bubble-text"><%- m.payload.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>') %></div>
          <% if (m.content_ref) { %>
            <div class="msg-bubble-ref" data-ref="<%= encodeURIComponent(m.content_ref) %>"></div>
          <% } %>
          <div class="msg-bubble-meta">
            <span class="msg-bubble-time"><%= new Date(m.created_at).toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'}) %></span>
            <button class="msg-bubble-delete" data-id="<%= m.id %>" type="button" aria-label="Supprimer" title="Supprimer">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="4" x2="4" y2="12"/><line x1="4" y1="4" x2="12" y2="12"/></svg>
            </button>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </div>

  <%# Zone de saisie -%>
  <form class="msg-compose" id="msg-compose" autocomplete="off">
    <textarea class="msg-compose-input" id="msg-compose-input"
              placeholder="Votre message…" rows="1" maxlength="4000"
              aria-label="Votre message"></textarea>
    <button class="msg-compose-send" type="submit" aria-label="Envoyer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </form>

</main>

<script nonce="<%= nonce %>">
(function () {
  'use strict';

  var state     = document.getElementById('msg-state').dataset;
  var convId    = parseInt(state.convId, 10);
  var partnerId = parseInt(state.partnerId, 10);
  var myId      = parseInt(state.myId, 10);

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Rendu des références de contenu ──────────────────────────────────────
  function renderContentRef(el, ref) {
    var typeLabel = { image: 'Image', bd: 'BD', wiki: 'Codex' }[ref.type] || ref.type;
    var href = ref.type === 'image' ? '/galerie/' + ref.id
             : ref.type === 'bd'    ? '/bd/' + ref.id
             : '/wiki/' + ref.id;
    el.innerHTML = '<a class="msg-ref-card" href="' + href + '">' +
      '<span class="msg-ref-type">' + typeLabel + '</span>' +
      '<span class="msg-ref-title">' + escHtml(ref.title || '') + '</span>' +
      '</a>';
  }

  document.querySelectorAll('.msg-bubble-ref[data-ref]').forEach(function (el) {
    try { renderContentRef(el, JSON.parse(decodeURIComponent(el.dataset.ref))); } catch (_) {}
  });

  // ── Envoi d'un message ───────────────────────────────────────────────────
  var compose = document.getElementById('msg-compose');
  var input   = document.getElementById('msg-compose-input');

  if (compose) {
    input.addEventListener('input', function () {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 160) + 'px';
    });

    compose.addEventListener('submit', async function (e) {
      e.preventDefault();
      var text = input.value.trim();
      if (!text) return;
      input.value = '';
      input.style.height = 'auto';
      try {
        var r = await fetch('/messages/' + partnerId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: text }),
        });
        var data = await r.json();
        if (data.ok) appendBubble(data.msgId, text, new Date().toISOString(), true);
      } catch (_) {}
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        compose.dispatchEvent(new Event('submit'));
      }
    });
  }

  function appendBubble(id, text, ts, isMe, contentRef) {
    var el = document.createElement('article');
    el.className = 'msg-bubble msg-bubble--' + (isMe ? 'me' : 'them');
    el.dataset.id = id;
    var refHtml = '';
    if (contentRef) {
      refHtml = '<div class="msg-bubble-ref"></div>';
    }
    el.innerHTML =
      '<div class="msg-bubble-inner">' +
        '<div class="msg-bubble-text">' + escHtml(text).replace(/\n/g, '<br>') + '</div>' +
        refHtml +
        '<div class="msg-bubble-meta">' +
          '<span class="msg-bubble-time">' + new Date(ts).toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'}) + '</span>' +
          '<button class="msg-bubble-delete" data-id="' + id + '" type="button" aria-label="Supprimer" title="Supprimer">' +
            '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="4" x2="4" y2="12"/><line x1="4" y1="4" x2="12" y2="12"/></svg>' +
          '</button>' +
        '</div>' +
      '</div>';
    if (contentRef) {
      try { renderContentRef(el.querySelector('.msg-bubble-ref'), contentRef); } catch (_) {}
    }
    var container = document.getElementById('msg-thread-messages');
    if (container) { container.appendChild(el); scrollToBottom(); }
  }

  // ── Suppression ──────────────────────────────────────────────────────────
  document.addEventListener('click', async function (e) {
    var btn = e.target.closest('.msg-bubble-delete');
    if (!btn) return;
    var id = parseInt(btn.dataset.id, 10);
    if (!id) return;
    var r = await fetch('/messages/msg/' + id, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
    var data = await r.json();
    if (data.ok) {
      var bubble = document.querySelector('.msg-bubble[data-id="' + id + '"]');
      if (bubble) bubble.remove();
    }
  });

  // ── SSE : réception de nouveaux messages ─────────────────────────────────
  var lastMsgId = 0;
  (function () {
    var last = document.querySelector('#msg-thread-messages .msg-bubble:last-child');
    if (last) lastMsgId = parseInt(last.dataset.id, 10) || 0;
  })();

  var evtSource = new EventSource('/messages/events');
  evtSource.addEventListener('message', function (e) {
    try {
      var d = JSON.parse(e.data);
      if (d.convId === convId) loadNewMessages();
    } catch (_) {}
  });

  async function loadNewMessages() {
    try {
      var r = await fetch('/messages/load-new/' + convId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ afterId: lastMsgId }),
      });
      var data = await r.json();
      if (!data.messages || !data.messages.length) return;
      for (var i = 0; i < data.messages.length; i++) {
        var m = data.messages[i];
        if (m.id <= lastMsgId) continue;
        lastMsgId = m.id;
        var ref = null;
        if (m.content_ref) { try { ref = JSON.parse(m.content_ref); } catch (_) {} }
        appendBubble(m.id, m.payload, m.created_at, m.sender_id === myId, ref);
      }
    } catch (_) {}
  }

  function scrollToBottom() {
    var body = document.getElementById('msg-thread-body');
    if (body) body.scrollTop = body.scrollHeight;
  }

  scrollToBottom();
})();
</script>

<%- include('partials/foot') %>
