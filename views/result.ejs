<%- include('partials/head', { title: 'Quizz : Résultat' }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>

  <h1><%= isFinal ? "Merci, voici ton resultat" : "Tes resultats jusqu'ici" %></h1>
  <% if (!isFinal) { %>
    <p class="intro">Le quiz n'est pas termine : voici les resultats bases sur ce que tu as deja rempli.</p>
  <% } %>

  <% config.sections.forEach(function (section) { %>
    <% var s = scores.sections[section.key]; %>
    <div class="result-section">
      <h2><%= section.title %></h2>

      <% if (s.type === "matrix") { %>
        <div class="result-row">
          <div class="result-label">
            <span>Score global</span>
            <span><%= s.percentage %>%</span>
          </div>
          <div class="bar"><div class="bar-fill" style="width: <%= s.percentage %>%"></div></div>
        </div>
        <% Object.keys(s.rankings || {}).forEach(function (rid) { %>
          <% if (s.rankings[rid].length) { %>
            <p class="ranking-result"><strong>Classement :</strong> <%= s.rankings[rid].join(" > ") %></p>
          <% } %>
        <% }) %>
        <% Object.keys(s.spectrums || {}).forEach(function (spid) { %>
          <% var sp = section.spectrums.find(function (x) { return x.id === spid; }); %>
          <p class="ranking-result"><strong><%= sp ? sp.label : spid %> :</strong> <%= s.spectrums[spid] %></p>
        <% }) %>
        <% Object.keys(s.multiselects || {}).forEach(function (msid) { %>
          <% if (s.multiselects[msid].length) { %>
            <% var ms = section.multiselects.find(function (x) { return x.id === msid; }); %>
            <p class="ranking-result"><strong><%= ms ? ms.label : msid %> :</strong> <%= s.multiselects[msid].join(", ") %></p>
          <% } %>
        <% }) %>

        <%
          var sectionData = (answers && answers[section.key]) || {};
          var matrix = sectionData.matrix || {};
          var rawItems = flattenItemsRaw(section);
          var answeredRows = [];
          rawItems.forEach(function (item) {
            if (item.variants) {
              item.variants.forEach(function (variantLabel) {
                var vKey = slugify(variantLabel);
                var levels = (matrix[item.id] && matrix[item.id][vKey]) || {};
                var parts = [];
                config.levels.forEach(function (lvl) {
                  var v = Number(levels[lvl.key]) || 1;
                  var scale = lvl.scaleLabels || config.scaleLabels;
                  if (v > 1) parts.push(lvl.label + " : " + scale[v - 1]);
                });
                if (parts.length) answeredRows.push({ item: item.text + " (" + variantLabel + ")", parts: parts.join(" · ") });
              });
            } else {
              var levels = matrix[item.id] || {};
              var parts = [];
              config.levels.forEach(function (lvl) {
                var v = Number(levels[lvl.key]) || 1;
                var scale = lvl.scaleLabels || config.scaleLabels;
                if (v > 1) parts.push(lvl.label + " : " + scale[v - 1]);
              });
              if (parts.length) answeredRows.push({ item: item.text, parts: parts.join(" · ") });
            }
          });
        %>
        <% if (answeredRows.length) { %>
          <details class="matrix-group">
            <summary><span class="group-title-text">Detail des reponses (<%= answeredRows.length %>)</span></summary>
            <ul class="answer-list">
              <% answeredRows.forEach(function (row) { %>
                <li><strong><%= row.item %></strong><br /><span><%= row.parts %></span></li>
              <% }) %>
            </ul>
          </details>
        <% } else { %>
          <p class="intro">Aucune reponse au-dessus de "Jamais" pour l'instant dans cette section.</p>
        <% } %>
      <% } else if (s.type === "profile") { %>
        <ul class="answer-list">
          <% section.fields.forEach(function (f) { %>
            <li><strong><%= f.label %></strong><br /><span><%= s.fields[f.id] %></span></li>
          <% }) %>
          <% Object.keys(s.rankings || {}).forEach(function (rid) { %>
            <li><strong>Classement</strong><br /><span><%= s.rankings[rid].join(" > ") %></span></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  <% }) %>

  <%
    var bookmarks = (answers && answers.__bookmarks) || { favorite: {} };
    function bookmarkRows(map) {
      var rows = [];
      Object.keys(map || {}).forEach(function (key) {
        if (!map[key]) return;
        var sepIdx = key.indexOf(":");
        var sectionKey = key.slice(0, sepIdx);
        var itemId = key.slice(sepIdx + 1);
        var sec = config.sections.find(function (s) { return s.key === sectionKey; });
        if (!sec) return;
        var its = flattenItemsRaw(sec);
        var match = its.find(function (it) { return it.id === itemId; });
        if (!match) return;
        rows.push({ label: match.text, sectionTitle: sec.title });
      });
      return rows;
    }
    var favoriteRows = bookmarkRows(bookmarks.favorite);
  %>
  <% if (favoriteRows.length) { %>
    <div class="result-section">
      <h2>Tes favoris (<%= favoriteRows.length %>)</h2>
      <ul class="answer-list">
        <% favoriteRows.forEach(function (row) { %>
          <li><span><%= row.label %> <em>(<%= row.sectionTitle %>)</em></span></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (isFinal) { %>
    <a class="link" href="/">Refaire le quiz</a>
  <% } else { %>
    <a class="link" href="/section/<%= resumeIdx %>">Continuer le quiz</a>
  <% } %>
</main>
<%- include('partials/foot') %>
