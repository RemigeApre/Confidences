<%- include('partials/head', { title: 'Roue du hasard' }) %>
<main class="container roue-page">
  <%- include('partials/top-nav', { config: config, navTitle: 'Roue du hasard', navTitleEn: 'Wheel of Fortune', navBack: '/wiki' }) %>

  <script nonce="<%= nonce %>">
    var ROUE_DATA = <%- JSON.stringify(byCategory) %>;
    var ROUE_CATS = <%- JSON.stringify(categories.map(function(c){ return { key: c.key, label: c.label, hue: c.hue }; })) %>;
  </script>

  <div class="roue-wrap">

    <%# ── Catégories ── %>
    <div class="roue-section">
      <p class="roue-label" data-fr="Catégories" data-en="Categories">Cat&eacute;gories</p>
      <div class="roue-chips" id="roue-chips">
        <% categories.forEach(function(c) { %>
          <button type="button" class="roue-chip" data-cat="<%= c.key %>">
            <%= c.label %><span class="roue-chip-count"><%= byCategory[c.key] ? byCategory[c.key].length : 0 %></span>
          </button>
        <% }) %>
      </div>
    </div>

    <%# ── Options ── %>
    <div class="roue-section roue-options">
      <div class="roue-option-group" id="roue-lieu-filter" hidden>
        <span class="roue-label">Lieux</span>
        <button type="button" class="roue-opt-btn" data-val="prive"  data-active="1">Priv&eacute;</button>
        <button type="button" class="roue-opt-btn" data-val="public" data-active="1">Public</button>
        <button type="button" class="roue-opt-btn" data-val="cache"  data-active="1">Cach&eacute;</button>
        <button type="button" class="roue-opt-btn" data-val=""       data-active="1">Non renseign&eacute;</button>
      </div>
      <div class="roue-option-group">
        <span class="roue-label">Contenu</span>
        <button type="button" class="roue-opt-btn" id="roue-toggle-ultra"      data-active="1">Ultra</button>
        <button type="button" class="roue-opt-btn" id="roue-toggle-irrealiste" data-active="1">Irr&eacute;aliste</button>
      </div>
    </div>

    <%# ── Bouton ── %>
    <div class="roue-action">
      <button type="button" class="roue-spin-btn" id="roue-spin-btn" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 2v6h-6"/><path d="M2.5 12a10 10 0 0 1 17.8-6.3L21.5 8"/><path d="M2.5 22v-6h6"/><path d="M21.5 12a10 10 0 0 1-17.8 6.3L2.5 16"/></svg>
        Lancer
      </button>
    </div>

    <%# ── Drums ── %>
    <div class="roue-drums" id="roue-drums" hidden></div>

    <%# ── Résultats ── %>
    <div class="roue-results" id="roue-results" hidden></div>

  </div>
</main>

<style>
.roue-page{padding-bottom:5rem}
.roue-wrap{max-width:720px;margin:0 auto;padding:1.5rem 1rem;display:flex;flex-direction:column;gap:1.75rem}

/* ── Label section ── */
.roue-label{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);margin:0 0 .6rem}

/* ── Section ── */
.roue-section{display:flex;flex-direction:column}

/* ── Chips catégories ── */
.roue-chips{display:flex;flex-wrap:wrap;gap:.4rem}
.roue-chip{
  display:inline-flex;align-items:center;gap:.45rem;
  padding:.38rem .8rem;border-radius:6px;cursor:pointer;
  border:1px solid rgba(255,255,255,.1);
  background:transparent;color:rgba(255,255,255,.45);
  font-size:.82rem;font-weight:600;
  transition:background .12s,border-color .12s,color .12s
}
.roue-chip:hover{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.2);color:rgba(255,255,255,.75)}
.roue-chip.active{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.3);color:#fff}
.roue-chip-count{font-size:.7rem;font-weight:400;opacity:.45}

/* ── Options ── */
.roue-options{gap:.75rem}
.roue-option-group{display:flex;align-items:center;flex-wrap:wrap;gap:.35rem}
.roue-option-group .roue-label{margin:0;margin-right:.25rem;flex-shrink:0;white-space:nowrap}
.roue-opt-btn{
  padding:.28rem .7rem;border-radius:5px;font-size:.76rem;font-weight:600;cursor:pointer;
  border:1px solid rgba(255,255,255,.1);background:transparent;
  color:rgba(255,255,255,.5);transition:color .12s,border-color .12s,opacity .12s
}
.roue-opt-btn:hover{border-color:rgba(255,255,255,.22);color:rgba(255,255,255,.8)}
.roue-opt-btn[data-active="0"]{opacity:.28;text-decoration:line-through}

/* ── Bouton Lancer ── */
.roue-action{display:flex;justify-content:flex-start}
.roue-spin-btn{
  display:inline-flex;align-items:center;gap:.55rem;
  padding:.6rem 1.6rem;border-radius:8px;cursor:pointer;
  border:1px solid rgba(255,255,255,.18);
  background:rgba(255,255,255,.08);color:#fff;
  font-size:.92rem;font-weight:700;
  transition:background .12s;letter-spacing:.02em
}
.roue-spin-btn:hover:not(:disabled){background:rgba(255,255,255,.13)}
.roue-spin-btn:disabled{opacity:.3;cursor:default}
.roue-spin-btn svg{width:16px;height:16px;flex-shrink:0}
.roue-spin-btn.spinning svg{animation:rspin .6s linear infinite}
@keyframes rspin{to{transform:rotate(360deg)}}

/* ── Drums ── */
.roue-drums{display:flex;flex-wrap:wrap;gap:.85rem}
.roue-drum{display:flex;flex-direction:column;gap:.4rem;min-width:150px;max-width:200px;flex:1}
.roue-drum-label{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
.roue-drum-window{
  width:100%;height:156px;overflow:hidden;position:relative;
  border:1px solid rgba(255,255,255,.1);border-radius:8px;
  background:rgba(255,255,255,.03)
}
.roue-drum-window::before,.roue-drum-window::after{
  content:'';position:absolute;left:0;right:0;height:52px;z-index:2;pointer-events:none
}
.roue-drum-window::before{top:0;background:linear-gradient(to bottom,rgba(14,16,22,1),transparent)}
.roue-drum-window::after{bottom:0;background:linear-gradient(to top,rgba(14,16,22,1),transparent)}
.roue-drum-cursor{
  position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);
  height:52px;z-index:1;pointer-events:none;
  border-top:1px solid rgba(255,255,255,.12);
  border-bottom:1px solid rgba(255,255,255,.12);
  background:rgba(255,255,255,.04)
}
.roue-drum-track{display:flex;flex-direction:column}
.roue-drum-item{
  height:52px;display:flex;align-items:center;justify-content:center;
  padding:0 .75rem;text-align:center;
  font-size:.8rem;font-weight:500;color:rgba(255,255,255,.55);
  line-height:1.3;flex-shrink:0
}

/* ── Résultats ── */
.roue-results{display:flex;flex-wrap:wrap;gap:.65rem;animation:rfadein .35s ease}
@keyframes rfadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.roue-result-card{
  display:flex;flex-direction:column;gap:.3rem;
  flex:1;min-width:140px;max-width:220px;
  padding:.85rem 1rem;border-radius:8px;text-decoration:none;
  border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);
  transition:background .12s,border-color .12s
}
.roue-result-card:hover{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.22)}
.roue-result-cat{font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.roue-result-title{font-size:.92rem;font-weight:700;color:#fff;line-height:1.3}

@media(max-width:640px){
  .roue-drum{min-width:130px}
}
</style>

<script nonce="<%= nonce %>">
(function () {
  'use strict';

  var activeCats      = [];
  var isSpinning      = false;
  var allowUltra      = true;
  var allowIrrealiste = true;
  var lieuActive      = { prive: true, public: true, cache: true, '': true };

  var spinBtn   = document.getElementById('roue-spin-btn');
  var drumsEl   = document.getElementById('roue-drums');
  var resultsEl = document.getElementById('roue-results');
  var lieuEl    = document.getElementById('roue-lieu-filter');

  // ── Options ─────────────────────────────────────────────────────────────
  document.getElementById('roue-toggle-ultra').addEventListener('click', function () {
    allowUltra = !allowUltra;
    this.dataset.active = allowUltra ? '1' : '0';
  });
  document.getElementById('roue-toggle-irrealiste').addEventListener('click', function () {
    allowIrrealiste = !allowIrrealiste;
    this.dataset.active = allowIrrealiste ? '1' : '0';
  });
  document.querySelectorAll('.roue-opt-btn[data-val]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var v = btn.dataset.val;
      lieuActive[v] = !lieuActive[v];
      btn.dataset.active = lieuActive[v] ? '1' : '0';
    });
  });

  // ── Filtre ───────────────────────────────────────────────────────────────
  function filteredItems(key) {
    return (ROUE_DATA[key] || []).filter(function (p) {
      if (p.special === 'ultra'      && !allowUltra)      return false;
      if (p.special === 'irrealiste' && !allowIrrealiste) return false;
      if (key === 'lieux' && !lieuActive[p.typeLieu || '']) return false;
      return true;
    });
  }

  // ── Chips ────────────────────────────────────────────────────────────────
  document.querySelectorAll('.roue-chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      var cat = chip.dataset.cat;
      var idx = activeCats.indexOf(cat);
      if (idx === -1) { activeCats.push(cat); chip.classList.add('active'); }
      else            { activeCats.splice(idx, 1); chip.classList.remove('active'); }
      spinBtn.disabled = activeCats.length === 0;
      lieuEl.hidden = activeCats.indexOf('lieux') === -1;
      rebuildDrums();
    });
  });

  // ── Drums ────────────────────────────────────────────────────────────────
  function rebuildDrums() {
    drumsEl.innerHTML = '';
    resultsEl.innerHTML = '';
    resultsEl.hidden = true;

    if (!activeCats.length) { drumsEl.hidden = true; return; }
    drumsEl.hidden = false;

    activeCats.forEach(function (key) {
      var cat   = ROUE_CATS.find(function (c) { return c.key === key; });
      var items = filteredItems(key);
      if (!items.length) return;

      var drum  = document.createElement('div');
      drum.className = 'roue-drum';

      var lbl = document.createElement('div');
      lbl.className = 'roue-drum-label';
      lbl.textContent = cat ? cat.label : key;
      drum.appendChild(lbl);

      var win = document.createElement('div');
      win.className = 'roue-drum-window';
      win.appendChild(Object.assign(document.createElement('div'), { className: 'roue-drum-cursor' }));

      var track = document.createElement('div');
      track.className = 'roue-drum-track';
      track.id = 'drum-' + key;

      for (var r = 0; r < 5; r++) {
        items.forEach(function (p) {
          var el = document.createElement('div');
          el.className = 'roue-drum-item';
          el.textContent = p.title;
          track.appendChild(el);
        });
      }

      win.appendChild(track);
      drum.appendChild(win);
      drumsEl.appendChild(drum);
    });
  }

  // ── Spin ─────────────────────────────────────────────────────────────────
  var ITEM_H = 52;

  spinBtn.addEventListener('click', function () {
    if (isSpinning || !activeCats.length) return;
    isSpinning = true;
    spinBtn.classList.add('spinning');
    spinBtn.disabled = true;
    resultsEl.hidden = true;
    resultsEl.innerHTML = '';

    var winners = {};

    activeCats.forEach(function (key, i) {
      var items = filteredItems(key);
      if (!items.length) return;

      var winIdx = Math.floor(Math.random() * items.length);
      winners[key] = items[winIdx];

      var track = document.getElementById('drum-' + key);
      if (!track) return;

      track.style.transition = 'none';
      track.style.transform  = 'translateY(0)';
      track.offsetHeight;

      var targetIdx = items.length * 3 + winIdx;
      var finalY    = -(targetIdx * ITEM_H) + 52;
      var delay     = i * 300;
      var duration  = 3000 + i * 300;

      setTimeout(function () {
        track.style.transition = 'transform ' + duration + 'ms cubic-bezier(0.17, 0.67, 0.12, 0.99)';
        track.style.transform  = 'translateY(' + finalY + 'px)';
      }, delay);
    });

    var total = 3000 + (activeCats.length - 1) * 600 + 500;
    setTimeout(function () {
      showResults(winners);
      isSpinning = false;
      spinBtn.classList.remove('spinning');
      spinBtn.disabled = false;
    }, total);
  });

  // ── Résultats ────────────────────────────────────────────────────────────
  function showResults(winners) {
    resultsEl.innerHTML = '';
    activeCats.forEach(function (key) {
      var item = winners[key];
      if (!item) return;
      var cat  = ROUE_CATS.find(function (c) { return c.key === key; });

      var card = document.createElement('a');
      card.className = 'roue-result-card';
      card.href = '/wiki/' + item.slug;

      var cl = document.createElement('div');
      cl.className = 'roue-result-cat';
      cl.textContent = cat ? cat.label : key;

      var tl = document.createElement('div');
      tl.className = 'roue-result-title';
      tl.textContent = item.title;

      card.appendChild(cl);
      card.appendChild(tl);
      resultsEl.appendChild(card);
    });
    resultsEl.hidden = false;
  }

})();
</script>

<%- include('partials/foot') %>
