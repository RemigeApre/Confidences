<%- include('partials/head', { title: 'Roue du hasard' }) %>

<script nonce="<%= nonce %>">
  var ROUE_DATA = <%- JSON.stringify(byCategory) %>;
  var ROUE_CATS = <%- JSON.stringify(categories.map(function(c){ return { key: c.key, label: c.label, hue: c.hue }; })) %>;
</script>

<div class="roue-layout">

  <%# ── Sidebar gauche ── %>
  <aside class="roue-sidebar">

    <div class="roue-sidebar-body">

      <p class="roue-sidebar-title">Roues</p>

      <nav class="roue-cat-list">
        <% categories.forEach(function(c) { %>
          <button type="button" class="roue-cat-btn" data-cat="<%= c.key %>" style="--ch:<%= c.hue %>">
            <span class="roue-cat-dot"></span>
            <span class="roue-cat-name"><%= c.label %></span>
            <span class="roue-cat-n"><%= byCategory[c.key] ? byCategory[c.key].length : 0 %></span>
          </button>
        <% }) %>
      </nav>

      <%# ── Paramètres ── %>
      <div class="roue-params" id="roue-params">

        <div class="roue-param-group" id="roue-param-lieu" hidden>
          <p class="roue-param-label">Type de lieu</p>
          <div class="roue-param-chips">
            <button type="button" class="roue-param-chip" data-lieu="prive"  data-active="1">Priv&eacute;</button>
            <button type="button" class="roue-param-chip" data-lieu="public" data-active="1">Public</button>
            <button type="button" class="roue-param-chip" data-lieu="cache"  data-active="1">Cach&eacute;</button>
            <button type="button" class="roue-param-chip" data-lieu=""       data-active="1">Non renseign&eacute;</button>
          </div>
        </div>

        <div class="roue-param-group">
          <p class="roue-param-label">Contenu</p>
          <div class="roue-param-chips">
            <button type="button" class="roue-param-chip" id="tog-ultra"      data-active="1">Ultra</button>
            <button type="button" class="roue-param-chip" id="tog-irrealiste" data-active="1">Irr&eacute;aliste</button>
          </div>
        </div>

      </div>

    </div>

    <%# ── Bouton Lancer ── %>
    <div class="roue-sidebar-foot">
      <button type="button" class="roue-spin-btn" id="roue-spin-btn" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 2v6h-6"/><path d="M2.5 12a10 10 0 0 1 17.8-6.3L21.5 8"/><path d="M2.5 22v-6h6"/><path d="M21.5 12a10 10 0 0 1-17.8 6.3L2.5 16"/></svg>
        Lancer
      </button>
    </div>

  </aside>

  <%# ── Zone principale ── %>
  <main class="roue-main">
    <%- include('partials/top-nav', { config: config, navTitle: 'Roue du hasard', navTitleEn: 'Wheel of Fortune', navBack: '/wiki' }) %>

    <div class="roue-stage" id="roue-stage">
      <div class="roue-drums" id="roue-drums"></div>
      <div class="roue-results" id="roue-results" hidden></div>
      <p class="roue-empty" id="roue-empty">S&eacute;lectionne au moins une cat&eacute;gorie pour commencer.</p>
    </div>
  </main>

</div>

<style>
/* ── Layout ── */
.roue-layout{display:flex;min-height:calc(100dvh - var(--topnav-height))}

/* ── Sidebar ── */
.roue-sidebar{
  width:210px;flex-shrink:0;
  display:flex;flex-direction:column;
  border-right:1px solid rgba(255,255,255,.08);
  position:sticky;top:0;height:100dvh;
  background:hsl(220,14%,9%)
}
.roue-sidebar-body{flex:1;overflow-y:auto;padding:.9rem .75rem;display:flex;flex-direction:column;gap:1.1rem}
.roue-sidebar-title{font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.3);margin:0}

/* ── Liste des catégories ── */
.roue-cat-list{display:flex;flex-direction:column;gap:.2rem}
.roue-cat-btn{
  display:flex;align-items:center;gap:.6rem;
  width:100%;padding:.42rem .6rem;border-radius:7px;cursor:pointer;
  border:1px solid transparent;background:transparent;
  text-align:left;transition:background .12s,border-color .12s;
  color:rgba(255,255,255,.45)
}
.roue-cat-btn:hover{background:rgba(255,255,255,.05);color:rgba(255,255,255,.75)}
.roue-cat-btn.active{
  background:hsl(var(--ch),28%,15%);
  border-color:hsl(var(--ch),40%,28%);
  color:hsl(var(--ch),55%,72%)
}
.roue-cat-dot{
  width:7px;height:7px;border-radius:50%;flex-shrink:0;
  background:rgba(255,255,255,.18);
  transition:background .12s
}
.roue-cat-btn.active .roue-cat-dot{background:hsl(var(--ch),55%,55%)}
.roue-cat-name{flex:1;font-size:.82rem;font-weight:600}
.roue-cat-n{font-size:.68rem;color:rgba(255,255,255,.25);font-weight:400}

/* ── Paramètres ── */
.roue-params{display:flex;flex-direction:column;gap:.85rem}
.roue-param-group{display:flex;flex-direction:column;gap:.4rem}
.roue-param-label{font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:rgba(255,255,255,.28);margin:0}
.roue-param-chips{display:flex;flex-wrap:wrap;gap:.3rem}
.roue-param-chip{
  padding:.25rem .6rem;border-radius:5px;font-size:.73rem;font-weight:600;cursor:pointer;
  border:1px solid rgba(255,255,255,.12);background:transparent;
  color:rgba(255,255,255,.5);transition:color .12s,border-color .12s,opacity .12s
}
.roue-param-chip:hover{color:rgba(255,255,255,.85);border-color:rgba(255,255,255,.25)}
.roue-param-chip[data-active="0"]{opacity:.25;text-decoration:line-through}

/* ── Bouton Lancer ── */
.roue-sidebar-foot{padding:.85rem .75rem;border-top:1px solid rgba(255,255,255,.07)}
.roue-spin-btn{
  width:100%;display:flex;align-items:center;justify-content:center;gap:.55rem;
  padding:.65rem 1rem;border-radius:8px;cursor:pointer;
  border:1px solid rgba(255,255,255,.18);
  background:rgba(255,255,255,.07);
  color:#fff;font-size:.9rem;font-weight:700;letter-spacing:.04em;
  transition:background .12s,border-color .12s
}
.roue-spin-btn:hover:not(:disabled){background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.28)}
.roue-spin-btn:disabled{opacity:.3;cursor:default}
.roue-spin-btn svg{width:15px;height:15px;flex-shrink:0}
.roue-spin-btn.spinning svg{animation:rspin .6s linear infinite}
@keyframes rspin{to{transform:rotate(360deg)}}

/* ── Zone principale ── */
.roue-main{flex:1;min-width:0;display:flex;flex-direction:column}
.roue-main>.top-nav-wrap,
.roue-main>header{flex-shrink:0}
.roue-stage{flex:1;padding:2rem 1.75rem;display:flex;flex-direction:column;gap:2rem}

/* ── Vide ── */
.roue-empty{color:rgba(255,255,255,.2);font-size:.85rem;margin:3rem auto;text-align:center}

/* ── Drums ── */
.roue-drums{display:flex;flex-wrap:wrap;gap:1rem}
.roue-drum{display:flex;flex-direction:column;gap:.5rem;min-width:155px;max-width:210px;flex:1}
.roue-drum-label{
  font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;
  color:hsl(var(--dh),45%,55%)
}
.roue-drum-window{
  width:100%;height:156px;overflow:hidden;position:relative;
  border:1px solid hsl(var(--dh),25%,22%);border-radius:8px;
  background:hsl(var(--dh),20%,9%)
}
.roue-drum-window::before,.roue-drum-window::after{
  content:'';position:absolute;left:0;right:0;height:52px;z-index:2;pointer-events:none
}
.roue-drum-window::before{top:0;background:linear-gradient(to bottom,hsl(var(--dh),20%,9%),transparent)}
.roue-drum-window::after{bottom:0;background:linear-gradient(to top,hsl(var(--dh),20%,9%),transparent)}
.roue-drum-cursor{
  position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);
  height:52px;z-index:1;pointer-events:none;
  border-top:1px solid hsl(var(--dh),35%,28%);
  border-bottom:1px solid hsl(var(--dh),35%,28%);
  background:hsl(var(--dh),25%,13%)
}
.roue-drum-track{display:flex;flex-direction:column}
.roue-drum-item{
  height:52px;display:flex;align-items:center;justify-content:center;
  padding:0 .75rem;text-align:center;
  font-size:.8rem;font-weight:500;color:hsl(var(--dh),20%,55%);
  line-height:1.3;flex-shrink:0
}

/* ── Résultats ── */
.roue-results{display:flex;flex-wrap:wrap;gap:.7rem;animation:rfadein .35s ease}
@keyframes rfadein{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
.roue-result-card{
  display:flex;flex-direction:column;gap:.3rem;
  flex:1;min-width:140px;max-width:220px;
  padding:.85rem 1rem;border-radius:8px;text-decoration:none;
  border:1px solid hsl(var(--dh),30%,22%);
  background:hsl(var(--dh),20%,11%);
  transition:background .12s,border-color .12s
}
.roue-result-card:hover{background:hsl(var(--dh),25%,15%);border-color:hsl(var(--dh),40%,32%)}
.roue-result-cat{font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:hsl(var(--dh),40%,50%)}
.roue-result-title{font-size:.92rem;font-weight:700;color:#fff;line-height:1.3}

/* ── Mobile ── */
@media(max-width:640px){
  .roue-sidebar{width:100%;height:auto;position:static;flex-direction:row;flex-wrap:wrap;border-right:none;border-bottom:1px solid rgba(255,255,255,.08)}
  .roue-sidebar-body{flex-direction:row;flex-wrap:wrap;padding:.65rem .75rem}
  .roue-cat-list{flex-direction:row;flex-wrap:wrap;gap:.3rem}
  .roue-cat-btn{width:auto;padding:.3rem .65rem}
  .roue-cat-n{display:none}
  .roue-sidebar-foot{padding:.65rem .75rem;border-top:none;border-left:1px solid rgba(255,255,255,.07)}
  .roue-spin-btn{width:auto;padding:.5rem 1.2rem}
  .roue-layout{flex-direction:column}
  .roue-stage{padding:1.25rem .9rem}
}
</style>

<script nonce="<%= nonce %>">
(function () {
  'use strict';

  var activeCats      = [];
  var isSpinning      = false;
  var allowUltra      = true;
  var allowIrrealiste = true;
  var lieuActive      = { prive: true, public: true, cache: true, '': true };

  var spinBtn    = document.getElementById('roue-spin-btn');
  var drumsEl    = document.getElementById('roue-drums');
  var resultsEl  = document.getElementById('roue-results');
  var emptyEl    = document.getElementById('roue-empty');
  var lieuGroup  = document.getElementById('roue-param-lieu');

  // ── Paramètres ──────────────────────────────────────────────────────────
  document.getElementById('tog-ultra').addEventListener('click', function () {
    allowUltra = !allowUltra;
    this.dataset.active = allowUltra ? '1' : '0';
  });
  document.getElementById('tog-irrealiste').addEventListener('click', function () {
    allowIrrealiste = !allowIrrealiste;
    this.dataset.active = allowIrrealiste ? '1' : '0';
  });
  document.querySelectorAll('.roue-param-chip[data-lieu]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var v = btn.dataset.lieu;
      lieuActive[v] = !lieuActive[v];
      btn.dataset.active = lieuActive[v] ? '1' : '0';
    });
  });

  // ── Filtre ───────────────────────────────────────────────────────────────
  function filteredItems(key) {
    return (ROUE_DATA[key] || []).filter(function (p) {
      if (p.special === 'ultra'      && !allowUltra)      return false;
      if (p.special === 'irrealiste' && !allowIrrealiste) return false;
      if (key === 'lieux' && !lieuActive[p.typeLieu || '']) return false;
      return true;
    });
  }

  // ── Chips catégories ─────────────────────────────────────────────────────
  document.querySelectorAll('.roue-cat-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var cat = btn.dataset.cat;
      var idx = activeCats.indexOf(cat);
      if (idx === -1) { activeCats.push(cat); btn.classList.add('active'); }
      else            { activeCats.splice(idx, 1); btn.classList.remove('active'); }
      spinBtn.disabled = !activeCats.length;
      lieuGroup.hidden = activeCats.indexOf('lieux') === -1;
      emptyEl.hidden   = activeCats.length > 0;
      rebuildDrums();
    });
  });

  // ── Drums ────────────────────────────────────────────────────────────────
  function rebuildDrums() {
    drumsEl.innerHTML = '';
    resultsEl.hidden  = true;
    resultsEl.innerHTML = '';

    activeCats.forEach(function (key) {
      var cat   = ROUE_CATS.find(function (c) { return c.key === key; });
      var items = filteredItems(key);
      if (!items.length) return;

      var drum = document.createElement('div');
      drum.className = 'roue-drum';
      drum.style.setProperty('--dh', cat ? cat.hue : 220);

      var lbl = document.createElement('div');
      lbl.className = 'roue-drum-label';
      lbl.textContent = cat ? cat.label : key;
      drum.appendChild(lbl);

      var win = document.createElement('div');
      win.className = 'roue-drum-window';
      win.appendChild(Object.assign(document.createElement('div'), { className: 'roue-drum-cursor' }));

      var track = document.createElement('div');
      track.className = 'roue-drum-track';
      track.id = 'drum-' + key;

      for (var r = 0; r < 5; r++) {
        items.forEach(function (p) {
          var el = document.createElement('div');
          el.className = 'roue-drum-item';
          el.textContent = p.title;
          track.appendChild(el);
        });
      }

      win.appendChild(track);
      drum.appendChild(win);
      drumsEl.appendChild(drum);
    });
  }

  // ── Spin ─────────────────────────────────────────────────────────────────
  var ITEM_H = 52;

  spinBtn.addEventListener('click', function () {
    if (isSpinning || !activeCats.length) return;
    isSpinning = true;
    spinBtn.classList.add('spinning');
    spinBtn.disabled = true;
    resultsEl.hidden = true;
    resultsEl.innerHTML = '';

    var winners = {};

    activeCats.forEach(function (key, i) {
      var items = filteredItems(key);
      if (!items.length) return;

      var winIdx    = Math.floor(Math.random() * items.length);
      winners[key]  = items[winIdx];

      var track = document.getElementById('drum-' + key);
      if (!track) return;

      track.style.transition = 'none';
      track.style.transform  = 'translateY(0)';
      track.offsetHeight;

      var targetIdx = items.length * 3 + winIdx;
      var finalY    = -(targetIdx * ITEM_H) + 52;
      var delay     = i * 300;
      var duration  = 3000 + i * 300;

      setTimeout(function () {
        track.style.transition = 'transform ' + duration + 'ms cubic-bezier(0.17, 0.67, 0.12, 0.99)';
        track.style.transform  = 'translateY(' + finalY + 'px)';
      }, delay);
    });

    var total = 3000 + (activeCats.length - 1) * 600 + 500;
    setTimeout(function () {
      showResults(winners);
      isSpinning = false;
      spinBtn.classList.remove('spinning');
      spinBtn.disabled = false;
    }, total);
  });

  // ── Résultats ────────────────────────────────────────────────────────────
  function showResults(winners) {
    resultsEl.innerHTML = '';
    activeCats.forEach(function (key) {
      var item = winners[key];
      if (!item) return;
      var cat = ROUE_CATS.find(function (c) { return c.key === key; });

      var card = document.createElement('a');
      card.className = 'roue-result-card';
      card.href = '/wiki/' + item.slug;
      card.style.setProperty('--dh', cat ? cat.hue : 220);

      var cl = document.createElement('div');
      cl.className = 'roue-result-cat';
      cl.textContent = cat ? cat.label : key;

      var tl = document.createElement('div');
      tl.className = 'roue-result-title';
      tl.textContent = item.title;

      card.appendChild(cl);
      card.appendChild(tl);
      resultsEl.appendChild(card);
    });
    resultsEl.hidden = false;
  }

  // Init
  emptyEl.hidden = false;

})();
</script>

<%- include('partials/foot') %>
