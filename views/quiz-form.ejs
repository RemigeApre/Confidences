<%- include('partials/head', { title: quiz ? 'Modifier ' + quiz.title : 'Nouveau quizz' }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config, navTitle: 'Quizz', navBack: '/quizz' }) %>

  <a href="/quizz" class="wf-back-btn">← Retour</a>

  <h1 class="wf-section-title" style="margin-top:3rem"><%= quiz ? 'Modifier le quizz' : 'Nouveau quizz' %></h1>

  <form method="POST" action="<%= quiz ? '/quizz/' + quiz.id + '/update' : '/quizz/new' %>" class="quiz-form">
    <div class="wf-stats-pct-row" style="flex-direction:column;gap:.5rem">
      <label class="wiki-meta-label">Titre</label>
      <input type="text" name="title" class="wf-orce-name-input" required maxlength="200" value="<%= quiz ? quiz.title : '' %>" placeholder="Titre du quizz…" />
    </div>
    <div class="wf-stats-pct-row" style="flex-direction:column;gap:.5rem;margin-top:.75rem">
      <label class="wiki-meta-label">Description</label>
      <textarea name="description" class="wf-stats-note-input" rows="3" placeholder="Description courte…" style="resize:vertical"><%= quiz ? quiz.description : '' %></textarea>
    </div>
    <% if (quiz) { %>
    <label class="wiki-display-opt-label" style="margin-top:.75rem">
      <input type="checkbox" name="featured" value="1" <%= quiz.featured ? 'checked' : '' %> hidden />
      <span class="wiki-display-opt-track"></span>
      <span class="wiki-display-opt-text">Mettre en avant</span>
    </label>
    <% } %>
    <div style="margin-top:1rem;display:flex;gap:.75rem;align-items:center">
      <button type="submit" class="wf-save-btn" style="position:static">Enregistrer</button>
      <% if (quiz) { %>
        <a href="/quizz/<%= quiz.id %>" class="wf-cancel-link">Voir le quizz</a>
        <form method="POST" action="/quizz/<%= quiz.id %>/delete" style="margin:0">
          <button type="submit" class="wf-delete-btn-fixed" style="position:static;font-size:.8rem" onclick="return confirm('Supprimer ce quizz ?')">🗑</button>
        </form>
      <% } %>
    </div>
  </form>

  <% if (quiz) { %>
  <div class="quiz-qlist" id="quiz-qlist">

    <%# ── Parties ─────────────────────────────────────────────────────── %>
    <div class="quiz-parts-section">
      <div class="quiz-parts-header">
        <h2 class="wf-section-title" style="margin:0">Parties</h2>
        <button type="button" id="qp-add-btn" class="wf-stats-pill">+ Nouvelle partie</button>
      </div>

      <div id="quiz-parts-list">
        <% parts.forEach(function(p) { %>
          <div class="quiz-part-item" data-id="<%= p.id %>">
            <span class="quiz-part-drag">⠿</span>
            <span class="quiz-part-title" data-id="<%= p.id %>"><%= p.title %></span>
            <button type="button" class="quiz-part-edit-btn" data-id="<%= p.id %>" title="Renommer">✎</button>
            <button type="button" class="quiz-part-del-btn" data-id="<%= p.id %>" title="Supprimer">✕</button>
          </div>
        <% }) %>
        <% if (!parts.length) { %>
          <p class="quiz-parts-empty" id="quiz-parts-empty">Aucune partie — les questions seront sans section.</p>
        <% } %>
      </div>

      <div id="qp-add-form" hidden style="margin-top:.6rem;display:flex;gap:.5rem">
        <input type="text" id="qp-title-input" class="wf-orce-name-input" placeholder="Nom de la partie…" maxlength="200" style="flex:1" />
        <button type="button" id="qp-confirm-btn" class="wf-save-btn" style="position:static;font-size:.82rem">Ajouter</button>
        <button type="button" id="qp-cancel-btn" class="wf-cancel-link">Annuler</button>
      </div>
    </div>

    <%# ── Questions ───────────────────────────────────────────────────── %>
    <h2 class="wf-section-title" style="margin-top:2rem">Questions (<span id="quiz-q-count"><%= questions.length %></span>)</h2>
    <div id="quiz-questions-container">
      <% questions.forEach(function(q, i) { %>
        <div class="quiz-qitem" data-id="<%= q.id %>">
          <span class="quiz-qitem-num"><%= i+1 %>.</span>
          <div class="quiz-qitem-body">
            <p class="quiz-qitem-text"><%= q.text %></p>
            <div class="quiz-qitem-meta">
              <span class="quiz-qitem-type quiz-qtype--<%= q.type %>"><%= q.type === 'gradient' ? 'Gradient' : q.type === 'single' ? 'Choix unique' : 'Choix multiple' %></span>
              <% if (q.part_id) {
                var qpart = parts.find(function(p){ return p.id === q.part_id; });
                if (qpart) { %>
                  <span class="quiz-qitem-part-badge"><%= qpart.title %></span>
              <% } } %>
            </div>
            <% if (q.options && q.options.length) { %>
              <div class="quiz-qitem-opts"><% q.options.forEach(function(o){ %><span class="quiz-qitem-opt"><%= o %></span><% }) %></div>
            <% } %>
          </div>
          <button type="button" class="quiz-qitem-del" data-id="<%= q.id %>">✕</button>
        </div>
      <% }) %>
    </div>

    <div class="quiz-qadd-panel" id="quiz-qadd-panel">
      <h3 class="wf-section-title" style="font-size:.85rem;margin:.75rem 0 .5rem">Nouvelle question</h3>
      <textarea id="qa-text" class="wf-stats-note-input" rows="2" placeholder="Texte de la question…" style="resize:vertical"></textarea>

      <% if (parts.length) { %>
      <div style="margin-top:.5rem">
        <label class="wiki-meta-label" style="font-size:.75rem;margin-bottom:.25rem">Partie (optionnel)</label>
        <select id="qa-part" class="wiki-sort-select" style="width:100%">
          <option value="">— Sans partie —</option>
          <% parts.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.title %></option>
          <% }) %>
        </select>
      </div>
      <% } %>

      <div class="quiz-qadd-type-row">
        <label class="chip-option quiz-type-chip quiz-type-chip--active" data-type="gradient">
          <input type="radio" name="qa-type" value="gradient" checked style="display:none" />
          <span>Gradient (pas du tout → énormément)</span>
        </label>
        <label class="chip-option quiz-type-chip" data-type="single">
          <input type="radio" name="qa-type" value="single" style="display:none" />
          <span>Réponse unique</span>
        </label>
        <label class="chip-option quiz-type-chip" data-type="multiple">
          <input type="radio" name="qa-type" value="multiple" style="display:none" />
          <span>Réponses multiples</span>
        </label>
      </div>
      <div id="qa-options-wrap" hidden>
        <div id="qa-options-list"></div>
        <button type="button" id="qa-add-option" class="wf-stats-pill" style="margin-top:.4rem;font-size:.78rem">+ Option</button>
      </div>
      <button type="button" id="qa-submit" class="wf-save-btn" style="position:static;margin-top:.75rem;font-size:.85rem">Ajouter la question</button>
    </div>
  </div>

  <script>
  (function() {
    var quizId = <%= quiz.id %>;
    var container = document.getElementById("quiz-questions-container");
    var qCount = document.getElementById("quiz-q-count");
    var qaText = document.getElementById("qa-text");
    var qaSubmit = document.getElementById("qa-submit");
    var qaOptionsWrap = document.getElementById("qa-options-wrap");
    var qaOptionsList = document.getElementById("qa-options-list");
    var qaAddOption = document.getElementById("qa-add-option");
    var qaPart = document.getElementById("qa-part");
    var typeChips = document.querySelectorAll(".quiz-type-chip");
    var currentType = "gradient";

    // ── Type chips ────────────────────────────────────────────────────────
    typeChips.forEach(function(chip) {
      chip.addEventListener("click", function() {
        typeChips.forEach(function(c) { c.classList.remove("quiz-type-chip--active"); });
        chip.classList.add("quiz-type-chip--active");
        chip.querySelector("input").checked = true;
        currentType = chip.dataset.type;
        qaOptionsWrap.hidden = (currentType === "gradient");
      });
    });

    qaAddOption.addEventListener("click", function() {
      var row = document.createElement("div");
      row.className = "quiz-option-row";
      var optInput = document.createElement("input");
      optInput.type = "text";
      optInput.className = "wf-orce-name-input";
      optInput.placeholder = "Option…";
      optInput.style.cssText = "flex:1;font-size:.82rem";
      var optDel = document.createElement("button");
      optDel.type = "button";
      optDel.className = "quiz-qitem-del";
      optDel.style.flexShrink = "0";
      optDel.textContent = "✕";
      optDel.addEventListener("click", function() { row.remove(); });
      row.appendChild(optInput);
      row.appendChild(optDel);
      qaOptionsList.appendChild(row);
    });

    // ── Ajouter une question ──────────────────────────────────────────────
    qaSubmit.addEventListener("click", function() {
      var text = (qaText.value || "").trim();
      if (!text) return;
      var options = [];
      if (currentType !== "gradient") {
        options = Array.from(qaOptionsList.querySelectorAll("input")).map(function(i) { return i.value.trim(); }).filter(Boolean);
      }
      var partId = qaPart ? (qaPart.value || null) : null;
      fetch("/quizz/" + quizId + "/questions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text: text, type: currentType, options: options, part_id: partId })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.ok) return;
        renderQuestions(data.questions);
        qaText.value = "";
        qaOptionsList.innerHTML = "";
      });
    });

    // ── Supprimer une question ────────────────────────────────────────────
    function deleteQuestion(id) {
      fetch("/quizz/" + quizId + "/questions/" + id + "/delete", { method: "POST", headers: { "Content-Type": "application/json" } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.ok) return;
        var el = container.querySelector("[data-id='" + id + "']");
        if (el) el.remove();
        updateCount();
      });
    }

    function updateCount() {
      if (qCount) qCount.textContent = container.querySelectorAll(".quiz-qitem").length;
    }

    var partTitles = {};
    document.querySelectorAll(".quiz-part-item").forEach(function(el) {
      partTitles[el.dataset.id] = el.querySelector(".quiz-part-title").textContent;
    });

    function renderQuestions(qs) {
      container.innerHTML = "";
      var typeLabels = { gradient: "Gradient", single: "Choix unique", multiple: "Choix multiple" };
      qs.forEach(function(q, i) {
        var div = document.createElement("div");
        div.className = "quiz-qitem";
        div.dataset.id = q.id;

        var numSpan = document.createElement("span");
        numSpan.className = "quiz-qitem-num";
        numSpan.textContent = (i + 1) + ".";

        var body = document.createElement("div");
        body.className = "quiz-qitem-body";

        var textP = document.createElement("p");
        textP.className = "quiz-qitem-text";
        textP.textContent = q.text;

        var meta = document.createElement("div");
        meta.className = "quiz-qitem-meta";

        var typeSpan = document.createElement("span");
        typeSpan.className = "quiz-qitem-type quiz-qtype--" + q.type;
        typeSpan.textContent = typeLabels[q.type] || q.type;
        meta.appendChild(typeSpan);

        if (q.part_id && partTitles[q.part_id]) {
          var badge = document.createElement("span");
          badge.className = "quiz-qitem-part-badge";
          badge.textContent = partTitles[q.part_id];
          meta.appendChild(badge);
        }

        body.appendChild(textP);
        body.appendChild(meta);

        if (q.options && q.options.length) {
          var optsDiv = document.createElement("div");
          optsDiv.className = "quiz-qitem-opts";
          q.options.forEach(function(o) {
            var s = document.createElement("span");
            s.className = "quiz-qitem-opt";
            s.textContent = o;
            optsDiv.appendChild(s);
          });
          body.appendChild(optsDiv);
        }

        var delBtn = document.createElement("button");
        delBtn.type = "button";
        delBtn.className = "quiz-qitem-del";
        delBtn.dataset.id = q.id;
        delBtn.textContent = "✕";
        delBtn.addEventListener("click", function() { deleteQuestion(q.id); });

        div.appendChild(numSpan);
        div.appendChild(body);
        div.appendChild(delBtn);
        container.appendChild(div);
      });
      updateCount();
    }

    container.addEventListener("click", function(e) {
      var btn = e.target.closest(".quiz-qitem-del");
      if (!btn || !btn.dataset.id) return;
      deleteQuestion(Number(btn.dataset.id));
    });

    // ── Parties ───────────────────────────────────────────────────────────
    var qpAddBtn   = document.getElementById("qp-add-btn");
    var qpAddForm  = document.getElementById("qp-add-form");
    var qpTitleInput = document.getElementById("qp-title-input");
    var qpConfirm  = document.getElementById("qp-confirm-btn");
    var qpCancel   = document.getElementById("qp-cancel-btn");
    var qpList     = document.getElementById("quiz-parts-list");
    var qpEmpty    = document.getElementById("quiz-parts-empty");

    if (qpAddBtn) {
      qpAddBtn.addEventListener("click", function() {
        qpAddForm.hidden = false;
        qpTitleInput.focus();
      });
      qpCancel.addEventListener("click", function() {
        qpAddForm.hidden = true;
        qpTitleInput.value = "";
      });
      qpConfirm.addEventListener("click", function() {
        var title = (qpTitleInput.value || "").trim();
        if (!title) return;
        fetch("/quizz/" + quizId + "/parts", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title: title })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) return;
          qpTitleInput.value = "";
          qpAddForm.hidden = true;
          renderParts(data.parts);
          // Ajouter l'option dans le select de questions
          if (qaPart) {
            var opt = document.createElement("option");
            opt.value = data.partId;
            opt.textContent = title;
            qaPart.appendChild(opt);
          }
        });
      });
    }

    function renderParts(parts) {
      qpList.innerHTML = "";
      if (!parts.length) {
        var p = document.createElement("p");
        p.className = "quiz-parts-empty";
        p.id = "quiz-parts-empty";
        p.textContent = "Aucune partie — les questions seront sans section.";
        qpList.appendChild(p);
        return;
      }
      parts.forEach(function(part) {
        partTitles[part.id] = part.title;
        var div = document.createElement("div");
        div.className = "quiz-part-item";
        div.dataset.id = part.id;

        var drag = document.createElement("span");
        drag.className = "quiz-part-drag";
        drag.textContent = "⠿";

        var titleSpan = document.createElement("span");
        titleSpan.className = "quiz-part-title";
        titleSpan.dataset.id = part.id;
        titleSpan.textContent = part.title;

        var editBtn = document.createElement("button");
        editBtn.type = "button";
        editBtn.className = "quiz-part-edit-btn";
        editBtn.dataset.id = part.id;
        editBtn.title = "Renommer";
        editBtn.textContent = "✎";

        var delBtn = document.createElement("button");
        delBtn.type = "button";
        delBtn.className = "quiz-part-del-btn";
        delBtn.dataset.id = part.id;
        delBtn.title = "Supprimer";
        delBtn.textContent = "✕";

        div.appendChild(drag);
        div.appendChild(titleSpan);
        div.appendChild(editBtn);
        div.appendChild(delBtn);
        qpList.appendChild(div);
      });
    }

    qpList.addEventListener("click", function(e) {
      var editBtn = e.target.closest(".quiz-part-edit-btn");
      var delBtn  = e.target.closest(".quiz-part-del-btn");

      if (editBtn) {
        var pid = editBtn.dataset.id;
        var titleSpan = qpList.querySelector(".quiz-part-title[data-id='" + pid + "']");
        var current = titleSpan.textContent;
        var newTitle = prompt("Renommer la partie :", current);
        if (!newTitle || !newTitle.trim() || newTitle.trim() === current) return;
        fetch("/quizz/" + quizId + "/parts/" + pid + "/update", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title: newTitle.trim() })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) return;
          titleSpan.textContent = newTitle.trim();
          partTitles[pid] = newTitle.trim();
          if (qaPart) {
            var opt = qaPart.querySelector("option[value='" + pid + "']");
            if (opt) opt.textContent = newTitle.trim();
          }
          // Mettre à jour les badges dans les questions
          document.querySelectorAll(".quiz-qitem-part-badge").forEach(function(b) {
            if (b.closest(".quiz-qitem") && b.closest(".quiz-qitem").dataset.partId == pid) {
              b.textContent = newTitle.trim();
            }
          });
        });
      }

      if (delBtn) {
        var pid = delBtn.dataset.id;
        if (!confirm("Supprimer cette partie ? Les questions associées resteront mais seront sans partie.")) return;
        fetch("/quizz/" + quizId + "/parts/" + pid + "/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) return;
          renderParts(data.parts);
          if (qaPart) {
            var opt = qaPart.querySelector("option[value='" + pid + "']");
            if (opt) opt.remove();
          }
        });
      }
    });
  })();
  </script>
  <% } %>
</main>
<%- include('partials/foot') %>
