<%- include('partials/head', { title: 'Admin : ' + detail.user.displayName, extraCss: ['admin.css'] }) %>

<%- include('partials/admin-nav') %>

<div class="aud-layout">
  <%- include('partials/admin-user-nav', { detail: detail, roleHue: roleHue }) %>

  <main class="aud-content">
    <%
      var u = detail.user;
      var now = Date.now();
      var lastActiveMs = u.lastActiveAt ? new Date(u.lastActiveAt).getTime()
                       : (u.lastLoginAt  ? new Date(u.lastLoginAt).getTime() : 0);
      var isOnline = lastActiveMs && (now - lastActiveMs) < 15 * 60 * 1000;

      function relTime(ms) {
        if (!ms) return 'jamais';
        var diff = now - ms;
        var s = Math.floor(diff / 1000);
        if (s < 60)       return s + 's';
        var m = Math.floor(diff / 60000);
        if (m < 60)       return m + ' min';
        var h = Math.floor(diff / 3600000);
        if (h < 24)       return h + 'h';
        var d = Math.floor(diff / 86400000);
        if (d < 7)        return d + 'j';
        return Math.floor(d / 7) + ' sem';
      }

      var SEXE_LABEL = { femme: 'Femme', homme: 'Homme', autre: 'Autre' };
      var ORI_LABEL  = { hetero: 'Hétéro', gay: 'Gay / Lesbienne', bi: 'Bisexuel·le' };

      function pingCls(label) {
        if (!label) return 'aud-type--nav';
        if (label.startsWith('Codex') || label.startsWith('Accueil Codex')) return 'aud-type--wiki';
        if (label.startsWith('Quiz'))  return 'aud-type--quiz';
        if (label.startsWith('BD'))    return 'aud-type--bd';
        if (label.startsWith('Image') || label.startsWith('Personnage') || label.startsWith('Carte') || label.startsWith('Parodie')) return 'aud-type--gallery';
        return 'aud-type--nav';
      }
      function pingTypeLabel(label) {
        if (!label) return 'Nav';
        if (label.startsWith('Codex') || label.startsWith('Accueil Codex')) return 'Codex';
        if (label.startsWith('Quiz'))  return 'Quiz';
        if (label.startsWith('BD'))    return 'BD';
        if (label.startsWith('Image') || label.startsWith('Personnage') || label.startsWith('Carte') || label.startsWith('Parodie')) return 'Image';
        return 'Nav';
      }
      function pingShortLabel(label) {
        if (!label) return label;
        return label.includes(' : ') ? label.split(' : ').slice(1).join(' : ') : label;
      }
    %>

    <%# ══════════════════════════════════════════
        BLOC IDENTITÉ
    ══════════════════════════════════════════ %>
    <div class="syn-hero">

      <div class="syn-hero-avatar">
        <% if (profileThumb) { %>
          <img src="<%= profileThumb %>" alt="" class="lq-img-ready" />
        <% } else { %>
          <span style="--avatar-color:<%= u.profileColor || '#6b7280' %>"><%= (u.displayName || '?').charAt(0).toUpperCase() %></span>
        <% } %>
        <% if (isOnline) { %><span class="syn-online-dot"></span><% } %>
      </div>

      <div class="syn-hero-body">
        <div class="syn-hero-name">
          <%= u.displayName %>
          <% if (u.isAdmin)  { %><span class="syn-badge syn-badge--admin">Admin</span><% } %>
          <% if (u.isTest)   { %><span class="syn-badge syn-badge--test">Test</span><% } %>
          <% if (u.accountStatus === 'restreint') { %><span class="syn-badge syn-badge--warn">Restreint</span><% } %>
          <% if (u.accountStatus === 'bloque')    { %><span class="syn-badge syn-badge--danger">Bloqu&eacute;</span><% } %>
        </div>

        <div class="syn-hero-meta">
          <% if (u.email) { %><span class="syn-meta-item"><%= u.email %></span><% } %>
          <% if (u.sexe)  { %><span class="syn-meta-item syn-meta-sep"><%= SEXE_LABEL[u.sexe] || u.sexe %></span><% } %>
          <% if (u.birthYear) { %><span class="syn-meta-item syn-meta-sep">Né en <%= u.birthYear %></span><% } %>
          <% if (u.orientation) { %><span class="syn-meta-item syn-meta-sep"><%= ORI_LABEL[u.orientation] || u.orientation %></span><% } %>
        </div>

        <div class="syn-hero-foot">
          <span class="syn-foot-item">Créé le <%= new Date(u.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) %></span>
          <% if (isOnline) { %>
            <span class="syn-foot-item syn-foot-online">En ligne maintenant</span>
          <% } else if (lastActiveMs) { %>
            <span class="syn-foot-item">Actif il y a <strong><%= relTime(lastActiveMs) %></strong></span>
          <% } %>
          <% if (u.ultraMode === 'visible') { %>
            <span class="syn-foot-item syn-foot-ultra">Ultra activé</span>
          <% } %>
          <% if (u.shareNotesWithAdmin) { %>
            <span class="syn-foot-item syn-foot-share">Partage ses notes</span>
          <% } %>
        </div>
      </div>

    </div>

    <%# ══════════════════════════════════════════
        GRILLE STATS
    ══════════════════════════════════════════ %>
    <div class="syn-stats">
      <div class="syn-stat syn-stat--accent">
        <span class="syn-stat-val"><%= lootboxCount %></span>
        <span class="syn-stat-key">Coffre</span>
      </div>
      <div class="syn-stat">
        <span class="syn-stat-val"><%= codexNotes %></span>
        <span class="syn-stat-key">Notes Codex</span>
      </div>
      <div class="syn-stat">
        <span class="syn-stat-val"><%= imagesNotees %></span>
        <span class="syn-stat-key">Notes Images</span>
      </div>
      <div class="syn-stat">
        <span class="syn-stat-val"><%= bdNotees %></span>
        <span class="syn-stat-key">Notes BD</span>
      </div>
      <div class="syn-stat">
        <span class="syn-stat-val"><%= histoiresNotees %></span>
        <span class="syn-stat-key">Notes Histoires</span>
      </div>
      <div class="syn-stat">
        <span class="syn-stat-val"><%= inviteCount %></span>
        <span class="syn-stat-key">Invités</span>
      </div>
    </div>

    <%# ══════════════════════════════════════════
        DEUX COLONNES : activité + connexions
    ══════════════════════════════════════════ %>
    <div class="syn-two-col">

      <%# ── Activité récente ── %>
      <% if (recentPings && recentPings.length) { %>
      <div class="syn-panel">
        <div class="syn-panel-hd">
          Activit&eacute; r&eacute;cente
          <a href="/ponhgup/utilisateur/<%= u.id %>/activite" class="syn-panel-more">Tout voir &rsaquo;</a>
        </div>
        <ul class="aud-activity-list">
          <% recentPings.forEach(function(p) {
               var lbl = p.label || '';
          %>
          <li class="aud-activity-row">
            <span class="aud-activity-type <%= pingCls(lbl) %>"><%= pingTypeLabel(lbl) %></span>
            <span class="aud-activity-title"><%= pingShortLabel(lbl) %></span>
            <span class="aud-activity-date"><%= new Date(p.at).toLocaleString('fr-FR') %></span>
          </li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <%# ── Dernières connexions ── %>
      <% if (connectionLogs && connectionLogs.length) { %>
      <div class="syn-panel">
        <div class="syn-panel-hd">
          Connexions
          <a href="/ponhgup/utilisateur/<%= u.id %>/connexions" class="syn-panel-more">Tout voir &rsaquo;</a>
        </div>
        <ul class="syn-conn-list">
          <% connectionLogs.forEach(function(c) { %>
          <li class="syn-conn-row">
            <span class="syn-conn-date"><%= new Date(c.createdAt).toLocaleString('fr-FR') %></span>
            <% if (c.ip) { %><span class="syn-conn-ip"><%= c.ip %></span><% } %>
          </li>
          <% }) %>
        </ul>
      </div>
      <% } %>

    </div>

  </main>
</div>
<%- include('partials/foot') %>
