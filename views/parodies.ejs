<%- include('partials/head', { title: 'Parodies' }) %>
<main class="container" style="max-width: 860px; margin: 0 auto">
  <%- include('partials/top-nav', { config: config, navTitle: 'Parodies', navBack: '/wiki' }) %>

  <div class="prot-header">
    <h1 class="prot-page-title">Parodies</h1>
    <p class="prot-page-sub">Œuvres parodiées dans le contenu du site</p>
  </div>

  <% if (!parodies.length) { %>
    <p class="nv-empty">Aucune parodie enregistrée pour le moment.</p>
  <% } else { %>
    <div class="parody-grid">
      <% parodies.forEach(function(item) { %>
        <div class="parody-card">
          <a href="/parodies/<%= encodeURIComponent(item.parody) %>" class="parody-card-name"><%= item.parody %></a>
          <div class="parody-card-counts">
            <% if (item.counts.gallery)      { %><span class="parody-count-chip">📷 <%= item.counts.gallery %></span><% } %>
            <% if (item.counts.bd)           { %><span class="parody-count-chip">📚 <%= item.counts.bd %></span><% } %>
            <% if (item.counts.nouvelles)    { %><span class="parody-count-chip">📝 <%= item.counts.nouvelles %></span><% } %>
            <% if (item.counts.wiki)         { %><span class="parody-count-chip">🔖 <%= item.counts.wiki %></span><% } %>
            <% if (item.counts.protagonistes){ %><span class="parody-count-chip">👤 <%= item.counts.protagonistes %></span><% } %>
          </div>
          <% if (item.subs && item.subs.length) { %>
          <ul class="parody-subs-list">
            <% item.subs.forEach(function(s) { %>
              <li>
                <a href="/parodies/<%= encodeURIComponent(item.parody) %>/<%= encodeURIComponent(s.sub) %>" class="parody-sub-link">
                  <span class="parody-sub-arrow">›</span> <%= s.sub %>
                  <span class="parody-sub-count"><%= s.counts.total %></span>
                </a>
              </li>
            <% }) %>
          </ul>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

</main>
<%- include('partials/foot') %>
