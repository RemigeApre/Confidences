<%- include('partials/head', { title: 'Mon compte — ' + config.title }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>

  <h1 class="compte-title">Mon compte</h1>

  <% if (error) { %><p class="compte-msg compte-msg-error"><%= error %></p><% } %>
  <% if (notice) { %><p class="compte-msg compte-msg-ok"><%= notice %></p><% } %>

  <section class="compte-section">
    <h2 class="compte-section-title">Identité</h2>
    <form method="POST" action="/compte/identite" class="compte-form">
      <label class="compte-field">
        <span>Pseudo</span>
        <input type="text" name="display_name" value="<%= user.displayName %>" required autocomplete="off" />
      </label>
      <label class="compte-field">
        <span>Adresse mail</span>
        <input type="email" name="email" value="<%= user.email %>" placeholder="facultatif" autocomplete="off" />
      </label>
      <label class="compte-field">
        <span>Sexe</span>
        <select name="sexe">
          <option value="" <%= user.sexe === '' ? 'selected' : '' %>>Non précisé</option>
          <option value="femme" <%= user.sexe === 'femme' ? 'selected' : '' %>>Femme</option>
          <option value="homme" <%= user.sexe === 'homme' ? 'selected' : '' %>>Homme</option>
          <option value="autre" <%= user.sexe === 'autre' ? 'selected' : '' %>>Autre</option>
        </select>
      </label>
      <label class="compte-field">
        <span>Année de naissance</span>
        <input type="number" name="birth_year" value="<%= user.birthYear || '' %>" placeholder="facultatif" min="1900" max="<%= new Date().getFullYear() %>" />
      </label>
      <label class="compte-field compte-field-readonly">
        <span>Identifiant de connexion</span>
        <input type="text" value="<%= user.username %>" disabled />
      </label>
      <label class="compte-field compte-field-readonly">
        <span>Statut</span>
        <input type="text" value="<%= user.isAdmin ? 'Administrateur' : (user.isTest ? 'Utilisateur (test)' : 'Utilisateur') %>" disabled />
      </label>
      <button type="submit" class="compte-btn-primary">Enregistrer</button>
    </form>
  </section>

  <section class="compte-section">
    <h2 class="compte-section-title">Mot de passe</h2>
    <form method="POST" action="/compte/mot-de-passe" class="compte-form">
      <label class="compte-field">
        <span>Mot de passe actuel</span>
        <input type="password" name="current_password" required autocomplete="current-password" />
      </label>
      <label class="compte-field">
        <span>Nouveau mot de passe</span>
        <input type="password" name="new_password" required autocomplete="new-password" />
      </label>
      <button type="submit" class="compte-btn-primary">Changer le mot de passe</button>
    </form>
  </section>

  <section class="compte-section">
    <h2 class="compte-section-title">Journal technique</h2>
    <ul class="compte-journal">
      <li>Compte créé le <%= new Date(user.createdAt).toLocaleDateString('fr-FR') %></li>
      <% if (user.updatedAt) { %><li>Dernière modification le <%= new Date(user.updatedAt).toLocaleDateString('fr-FR') %></li><% } %>
      <% if (user.lastLoginAt) { %>
        <li>Dernière connexion le <%= new Date(user.lastLoginAt).toLocaleDateString('fr-FR') %> à <%= new Date(user.lastLoginAt).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></li>
      <% } %>
    </ul>

    <% if (connectionLogs.length) { %>
      <details class="compte-history">
        <summary>Historique des connexions (<%= connectionLogs.length %>)</summary>
        <ul class="compte-journal">
          <% connectionLogs.forEach(function (log) { %>
            <li><%= new Date(log.createdAt).toLocaleDateString('fr-FR') %> à <%= new Date(log.createdAt).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %> — <%= log.ip %></li>
          <% }) %>
        </ul>
      </details>
    <% } %>
  </section>
</main>
<%- include('partials/foot') %>
