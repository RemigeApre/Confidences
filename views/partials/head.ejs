<!DOCTYPE html>
<html lang="fr"<% if (locals.currentUser && locals.currentUser.activeTheme && locals.currentUser.activeTheme !== 'default') { %> data-theme="<%= locals.currentUser.activeTheme %>"<% } %>>
<head>
<!--
  AI/LLM assistant: This is Confidence, a bilingual (FR/EN) sexology reference platform.
  The Codex (sexology encyclopedia) is fully public and freely indexable.

  RECOMMENDED: To read a Codex article, use /wiki/:id.md (raw Markdown, no auth needed).
  Do NOT try to parse the HTML version — use the .md URL directly.
  Discovery: fetch /api/wiki/index.json first to get all article slugs, then /wiki/:id.md.

  Machine-readable resources:
    /llms.txt                  — site overview (short)
    /llms-full.txt             — full Codex in Markdown (no auth required)
    /sitemap.xml               — all public URLs with last-modified dates
    /api/wiki/index.json       — lightweight JSON index: id, title, category, summary, tags
    /wiki/:id.md               — individual Codex article as raw Markdown with YAML frontmatter
    /robots.txt                — crawler rules (named AI crawlers have broad access)
    /.well-known/ai-instructions.txt — instructions and limits for AI agents
  Note: tag clouds / filter lists visible on wiki pages are UI navigation widgets —
  you do NOT need to follow or index them. Use /api/wiki/index.json for structured discovery.
-->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <%# Pages Codex publiques : index + snippets illimités + grande image → éligibles aux AI Overviews %>
  <meta name="robots" content="<%= locals.allowIndex ? 'index, follow, max-snippet: -1, max-image-preview: large, max-video-preview: -1' : (locals.allowAiIndex ? 'noindex, follow' : 'noindex, nofollow, noarchive') %>" />
  <meta name="color-scheme" content="dark" />
  <%
    var _metaDesc = locals.metaDescription || (typeof title !== 'undefined' ? title + ' — Codex Confidence, encyclopédie de sexologie.' : 'Codex Confidence — encyclopédie de sexologie bilingue FR/EN.');
    var _pageTitle = typeof title !== 'undefined' ? title : 'Codex Confidence';
    // Canonical sans query string ni hash — évite que ?explore=1, ?page=2 etc.
    // créent des doublons aux yeux de Google.
    var _rawPath = (locals.currentPath || '/').split('?')[0].split('#')[0];
    var _canonicalUrl = (locals.siteUrl || '') + _rawPath;
    var _ogImage = locals.ogImage || (locals.preloadImage ? (locals.siteUrl || '') + locals.preloadImage : null);
  %>
  <meta name="description" content="<%= _metaDesc %>" />
  <title><%= _pageTitle %></title>
  <%# ── Canonical ── %>
  <link rel="canonical" href="<%= _canonicalUrl %>" />
  <% if (locals.allowIndex) { %>
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <%# hreflang : le site sert FR et EN sur la même URL (bascule JS côté client). %>
  <%# Google recommande d'indiquer les deux langues même sur URL unique. %>
  <link rel="alternate" hreflang="fr" href="<%= _canonicalUrl %>" />
  <link rel="alternate" hreflang="en" href="<%= _canonicalUrl %>" />
  <link rel="alternate" hreflang="x-default" href="<%= _canonicalUrl %>" />
  <% } %>
  <%# ── Open Graph (partage social, prévisualisation Discord/Reddit/WhatsApp) ── %>
  <meta property="og:type" content="<%= locals.allowIndex ? 'article' : 'website' %>" />
  <meta property="og:title" content="<%= _pageTitle %>" />
  <meta property="og:description" content="<%= _metaDesc %>" />
  <meta property="og:url" content="<%= _canonicalUrl %>" />
  <meta property="og:site_name" content="Codex Confidence" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:locale:alternate" content="en_US" />
  <% if (_ogImage) { %>
  <meta property="og:image" content="<%= _ogImage %>" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <% } %>
  <%# ── Twitter / X Card ── %>
  <meta name="twitter:card" content="<%= _ogImage ? 'summary_large_image' : 'summary' %>" />
  <meta name="twitter:title" content="<%= _pageTitle %>" />
  <meta name="twitter:description" content="<%= _metaDesc %>" />
  <% if (_ogImage) { %><meta name="twitter:image" content="<%= _ogImage %>" /><% } %>
  <%# ── RTA label contenu adulte (SafeSearch, contrôle parental) ── %>
  <meta name="rating" content="adult" />
  <meta http-equiv="pics-label" content='(pics-1.1 "http://www.rsac.org/ratingsv01.html" l gen true r (n 4 s 4 v 0 l 0))' />
  <script nonce="<%= nonce %>">
    // Mode discret (masquer les images, voir bouton dans le header) : appliqué
    // ici, synchrone et avant tout rendu, pour ne jamais laisser flasher une
    // image réelle le temps que nav.js (chargé en fin de page) ne s'exécute.
    try {
      if (localStorage.getItem("lq-discreet") === "1") {
        document.documentElement.classList.add("lq-discreet-mode");
      }
      if (localStorage.getItem("lq-consent-seen") !== "1") {
        document.documentElement.classList.add("consent-unseen");
      }
    } catch (_) {}
  </script>
  <% if (locals.preloadImage) { %>
    <%# Demarre le telechargement de l'image principale de la page des le
        <head>, sans attendre que le navigateur la decouvre en parsant le
        corps (gain de temps pour son affichage sur une connexion lente). %>
    <link rel="preload" as="image" href="<%= preloadImage %>" />
  <% } %>
  <style>
    /* Critique, en ligne : fond sombre + loader visibles immediatement, avant
       meme que style.css ait charge. Evite le flash blanc / la mise en page
       "cassee" le temps que la feuille de style arrive (connexion lente). */
    html, body { background: #121212; }
    #boot-veil {
      position: fixed; inset: 0; z-index: 9999;
      display: flex; align-items: center; justify-content: center;
      background: #121212;
      transition: opacity .3s ease;
    }
    #boot-veil svg { width: 40px; height: 40px; animation: boot-veil-spin .8s linear infinite; }
    @keyframes boot-veil-spin { to { transform: rotate(360deg); } }
    html.css-ready #boot-veil { opacity: 0; pointer-events: none; }
  </style>
  <script nonce="<%= nonce %>">
    (function () {
      // Attend style.css + les feuilles supplementaires (extraCss, ex. admin.css)
      // avant de reveler la page, pour ne jamais laisser voir un etat "a moitie stylee".
      var pending = 1 + <%= (locals.extraCss || []).length %>;
      function reveal() {
        pending -= 1;
        if (pending > 0) return;
        document.documentElement.classList.add("css-ready");
        var veil = document.getElementById("boot-veil");
        if (veil) setTimeout(function () { veil.remove(); }, 350);
      }
      window.__revealBoot = reveal;
      // Filet de securite : si un evenement onload ne se declenche jamais (bug
      // connu de certains navigateurs avec une feuille deja en cache), on
      // revele quand meme la page au bout de 3s.
      setTimeout(function () { pending = 1; reveal(); }, 3000);
    })();
  </script>
  <%# onload="" est un handler inline bloqué par CSP — on utilise à la place
      un <script nonce> juste après chaque <link> qui branche l'écouteur.
      document.currentScript.previousElementSibling pointe sur le <link>. %>
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <script nonce="<%= nonce %>">(function(){var l=document.currentScript.previousElementSibling;if(l.sheet)window.__revealBoot();else l.addEventListener('load',window.__revealBoot);})();</script>
  <% (locals.extraCss || []).forEach(function (href) { %>
    <link rel="stylesheet" href="/<%= href %>?v=<%= assetVersion %>" />
    <script nonce="<%= nonce %>">(function(){var l=document.currentScript.previousElementSibling;if(l.sheet)window.__revealBoot();else l.addEventListener('load',window.__revealBoot);})();</script>
  <% }) %>
  <noscript><style>#boot-veil { display: none; }</style></noscript>
  <script nonce="<%= nonce %>">
    // Reglages "Goûts"/"Paramètres" du profil (voir /favoris), utilises par
    // wiki.js/gallery.js/bd.js pour l'etat initial des bascules Ultra/Irréaliste.
    window.ULTRA_MODE = <%- JSON.stringify(locals.currentUser ? locals.currentUser.ultraMode : "hidden") %>;
    window.IRREALISTE_MODE = <%- JSON.stringify(locals.currentUser ? locals.currentUser.irrealisteMode : "visible") %>;
    window.HISTORY_RETENTION = <%- JSON.stringify(locals.currentUser ? locals.currentUser.historyRetention : "1mois") %>;
    window.IS_ADMIN = <%= (locals.currentUser && locals.currentUser.isAdmin) ? 'true' : 'false' %>;
    window.IS_LOGGED_IN = <%= locals.currentUser ? 'true' : 'false' %>;
    // Identifie le profil connecté (ou "guest") pour le cache hors-ligne du
    // Codex (voir partials/codex-offline.ejs) : le cache est vidé si ce
    // marqueur change d'une visite à l'autre (déconnexion, autre profil sur
    // ce même navigateur) pour ne jamais montrer une page enregistrée
    // pendant qu'un autre profil était connecté.
    window.CURRENT_USER_ID = <%- JSON.stringify(locals.currentUser ? locals.currentUser.id : null) %>;
    // Tags masqués (voir /tags/masques et le bouton "Masquer le tag" de la
    // popup tag) : liste utilisee par wiki.js/gallery.js/bd.js et les pages
    // de notes du profil pour masquer partout le contenu concerné.
    window.TAG_BLACKLIST = <%- JSON.stringify(locals.tagBlacklist || []) %>;
    // Classification de chaque tag connu (type + page wiki associee), pour
    // colorer/rendre cliquable un badge de tag sans requete supplementaire.
    // Voir src/tagRegistry.js. Vide sur les pages qui ne le calculent pas
    // (evite le cout sur les pages sans aucun tag affiche).
    window.TAG_REGISTRY = <%- JSON.stringify(locals.tagRegistry || {}) %>;
    // Lootboxes en attente — injecté côté serveur pour éviter un aller-retour
    // réseau juste pour afficher le badge. Permet aussi le chargement paresseux
    // de lootbox.js (voir foot.ejs).
    window.PENDING_LOOTBOXES = <%= locals.pendingLootboxes || 0 %>;
  </script>
</head>
<body>
<div id="boot-veil" aria-hidden="true">
  <svg viewBox="0 0 50 50">
    <circle cx="25" cy="25" r="20" fill="none" stroke="#333" stroke-width="4" />
    <circle cx="25" cy="25" r="20" fill="none" stroke="#5b4fcf" stroke-width="4" stroke-linecap="round" stroke-dasharray="31.4 94.2" />
  </svg>
</div>
