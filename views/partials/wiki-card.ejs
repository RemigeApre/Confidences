<%
  var cat = categories.find(function (c) { return c.key === page.category; });
  var wcShowBadge = typeof showCategoryBadge !== 'undefined' ? showCategoryBadge : true;

  var wcHues = [cat ? cat.hue : 220].concat(
    (page.extraCategories || []).map(function (eck) {
      var ecat = categories.find(function (c) { return c.key === eck; });
      return ecat ? ecat.hue : 220;
    })
  ).slice(0, 3);
  var wcAccent;
  if (wcHues.length === 1) {
    wcAccent = 'hsl(' + wcHues[0] + ', 55%, 45%)';
  } else {
    var wcStep = 100 / wcHues.length;
    var wcStops = wcHues.map(function (h, i) {
      var from = Math.round(i * wcStep);
      var to   = Math.round((i + 1) * wcStep);
      return 'hsl(' + h + ', 55%, 45%) ' + from + '%, hsl(' + h + ', 55%, 45%) ' + to + '%';
    });
    wcAccent = 'linear-gradient(90deg, ' + wcStops.join(', ') + ')';
  }

  var wcDerived = ((page.meta && page.meta.termes_derives) || []).map(function (t) {
    return typeof t === 'string' ? { term: t, en: false } : t;
  });

  // Texte des variantes (noms + descriptions) pour la recherche côté client
  var wcVariantes = '';
  if (page.meta && Array.isArray(page.meta.variantes) && page.meta.variantes.length) {
    var vcParts = [];
    page.meta.variantes.forEach(function (v) {
      if (v.nom) vcParts.push(v.nom);
      if (v.description) vcParts.push(v.description.slice(0, 200));
      if (Array.isArray(v.variantes)) v.variantes.forEach(function (sv) {
        if (sv.nom) vcParts.push(sv.nom);
      });
    });
    wcVariantes = vcParts.join(' ').toLowerCase().replace(/"/g, '').replace(/\s+/g, ' ').slice(0, 600);
  }

  var wcExcerpt = '';
  if (!currentUser && page.content) {
    wcExcerpt = (page.content || '')
      .replace(/^#+\s+/gm, '').replace(/\*\*?|__?/g, '')
      .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
      .replace(/\n+/g, ' ').trim();
    if (wcExcerpt.length > 110) wcExcerpt = wcExcerpt.slice(0, 110) + '\u2026';
  }
%>
<a href="/wiki/<%= page.id %>" class="wiki-card"
  style="--card-hue: <%= cat ? cat.hue : 220 %>"
  data-category="<%= page.category %>"
  data-owned="<%= page.owned ? '1' : '0' %>"
  data-tags="<%= page.tags.join('|').toLowerCase() %>"
  data-title="<%= page.title.toLowerCase() %>"
  data-date="<%= new Date(page.updatedAt).getTime() %>"
  data-rating="<%= page.rating || 0 %>"
  data-flame="<%= page.flame ? '1' : '0' %>"
  data-interested="<%= page.interested ? '1' : '0' %>"
  data-derived="<%= wcDerived.map(function (t) { return t.term; }).join('|').toLowerCase() %>"
  data-content="<%= (page.content || '').toLowerCase().replace(/"/g,'').replace(/\s+/g,' ').slice(0, 400) %>"
  data-variantes="<%= wcVariantes %>"
  data-ultra="<%= page.tags.indexOf('ultra') !== -1 ? '1' : '0' %>"
  data-irrealiste="<%= (page.tags.indexOf('irréaliste') !== -1 || page.tags.indexOf('fantaisie') !== -1) ? '1' : '0' %>"
  <%
    var wcIsUltra      = page.tags.indexOf('ultra') !== -1;
    var wcIsIrrealiste = page.tags.indexOf('irréaliste') !== -1;
    var wcIsFantaisie  = page.tags.indexOf('fantaisie') !== -1;
    var wcBannerText   = '';
    var wcBannerMod    = '';
    if (wcIsUltra && (wcIsIrrealiste || wcIsFantaisie)) {
      wcBannerText = wcIsFantaisie ? 'Fantaisie & Ultra' : 'Ultra & Irr\u00e9aliste';
      wcBannerMod  = 'both';
    } else if (wcIsFantaisie) {
      wcBannerText = 'Fantaisie';   wcBannerMod = 'irrealiste';
    } else if (wcIsIrrealiste) {
      wcBannerText = 'Irr\u00e9aliste'; wcBannerMod = 'irrealiste';
    } else if (wcIsUltra) {
      wcBannerText = 'Ultra';       wcBannerMod = 'ultra';
    }
  %>
  data-extra-cats="<%= (page.extraCategories || []).join('|') %>"
  data-maturity="<%= page.maturity || 0 %>"
  data-sous-cat="<%= (page.meta && page.meta.sous_cat) || '' %>">

  <% if (page.imagePaths && page.imagePaths.length && currentUser) { %>
    <%# ── Carte AVEC image ───────────────────────────────────────────── %>
    <div class="wiki-card-image" data-images="<%= page.imagePaths.join('|') %>">
      <% if (wcBannerText) { %><span class="wiki-card-banner wiki-card-banner--<%= wcBannerMod %>"><%= wcBannerText %></span><% } %>
      <% if (currentUser && currentUser.isAdmin) { %><span class="wiki-maturity-badge" data-level="<%= page.maturity || 0 %>"><%= page.maturity || 0 %></span><% } %>
      <img src="<%= thumbUrl(page.imagePaths[0]) %>" data-src="<%= page.imagePaths[0] %>" alt="" class="wiki-card-img" loading="lazy" />
      <div class="wiki-card-overlay">
        <% if (wcShowBadge) { %><span class="wiki-category-badge" style="background: hsl(<%= cat ? cat.hue : 220 %>, 55%, 45%)"><%= cat ? cat.label : page.category %></span><% } %>
        <% if (currentUser) { %><span class="wiki-card-badges">
          <% if (page.rating) { %><span class="wiki-card-mini-stars"><% for (var si = 1; si <= 5; si++) { %><span class="wiki-card-star<%= si <= page.rating ? ' filled' : '' %>">&#9733;</span><% } %></span><% } %>
          <% if (page.owned) { %><span class="wiki-owned-badge" title="Possédé">&#9733;</span><% } %>
          <% if (page.flame) { %><span class="wiki-card-react-badge" title="J'adore">&#128293;</span><% } %>
          <% if (page.interested) { %><span class="wiki-card-react-badge" title="Ça m'intéresse">&#10024;</span><% } %>
        </span><% } %>
      </div>
    </div>
    <div class="wiki-card-body">
      <p class="wiki-card-title"><%= page.title %></p>
    </div>
    <span class="wiki-card-accent" style="background: <%= wcAccent %>"></span>

  <% } else { %>
    <%# ── Carte SANS image : placeholder géométrique ────────────────── %>
    <% var ph = cat ? cat.hue : 220; %>
    <div class="wiki-card-image">
      <% if (wcBannerText) { %><span class="wiki-card-banner wiki-card-banner--<%= wcBannerMod %>"><%= wcBannerText %></span><% } %>
      <% if (currentUser && currentUser.isAdmin) { %><span class="wiki-maturity-badge" data-level="<%= page.maturity || 0 %>"><%= page.maturity || 0 %></span><% } %>
      <svg class="wiki-card-placeholder-svg" viewBox="0 0 160 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id="rg-<%= page.id %>" cx="50%" cy="50%" r="65%">
            <stop offset="0%" stop-color="hsl(<%= ph %>,42%,26%)"/>
            <stop offset="100%" stop-color="hsl(<%= ph %>,32%,11%)"/>
          </radialGradient>
        </defs>
        <rect width="160" height="90" fill="url(#rg-<%= page.id %>)"/>
        <circle cx="80" cy="45" r="28" fill="none" stroke="hsl(<%= ph %>,58%,54%)" stroke-width="1.2" opacity="0.45"/>
        <circle cx="80" cy="45" r="16" fill="hsl(<%= ph %>,52%,34%)" opacity="0.35"/>
        <polygon points="80,24 99,57 61,57" fill="none" stroke="hsl(<%= ph %>,62%,60%)" stroke-width="1" opacity="0.5"/>
        <line x1="8" y1="45" x2="52" y2="45" stroke="hsl(<%= ph %>,38%,50%)" stroke-width="0.7" opacity="0.4"/>
        <line x1="108" y1="45" x2="152" y2="45" stroke="hsl(<%= ph %>,38%,50%)" stroke-width="0.7" opacity="0.4"/>
        <circle cx="80" cy="45" r="3" fill="hsl(<%= ph %>,70%,65%)" opacity="0.6"/>
      </svg>
      <div class="wiki-card-overlay">
        <% if (wcShowBadge) { %><span class="wiki-category-badge" style="background: hsl(<%= cat ? cat.hue : 220 %>, 55%, 45%)"><%= cat ? cat.label : page.category %></span><% } %>
        <% if (currentUser) { %><span class="wiki-card-badges">
          <% if (page.rating) { %><span class="wiki-card-mini-stars"><% for (var si2 = 1; si2 <= 5; si2++) { %><span class="wiki-card-star<%= si2 <= page.rating ? ' filled' : '' %>">&#9733;</span><% } %></span><% } %>
          <% if (page.owned) { %><span class="wiki-owned-badge" title="Possédé">&#9733;</span><% } %>
          <% if (page.flame) { %><span class="wiki-card-react-badge">&#128293;</span><% } %>
          <% if (page.interested) { %><span class="wiki-card-react-badge">&#10024;</span><% } %>
        </span><% } %>
      </div>
    </div>
    <div class="wiki-card-body">
      <p class="wiki-card-title"><%= page.title %></p>
    </div>
    <span class="wiki-card-accent" style="background: <%= wcAccent %>"></span>
  <% } %>
</a>
