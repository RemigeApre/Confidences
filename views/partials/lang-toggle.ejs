<%
  var _lt = locals.editLang || 'fr';
  var _ltUrl = locals.editUrl || '';
%>
<div class="wf-lang-toggle">
  <a href="<%= _ltUrl %>" class="wf-lang-btn<%= _lt === 'fr' ? ' active' : '' %>">FR</a>
  <a href="<%= _ltUrl %>?editLang=en" class="wf-lang-btn<%= _lt === 'en' ? ' active' : '' %>">EN</a>
</div>
