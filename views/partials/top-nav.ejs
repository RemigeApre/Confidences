<div class="top-nav">

  <%# ─── Mobile : retour + titre + burger (masqués sur desktop) ────────── %>
  <% if (locals.navBack) { %>
    <a href="<%= locals.navBack %>" class="nav-back-btn" aria-label="Retour">&#8592;</a>
  <% } else { %>
    <span class="nav-back-placeholder"></span>
  <% } %>
  <span class="top-nav-page-title"><%= locals.navTitle || config.title %></span>
  <button type="button" class="nav-burger" id="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="nav-drawer">
    &#9776;
  </button>

  <%# ─── Desktop : barre pleine largeur (masquée sur mobile) ──────────── %>
  <%
    var _path = locals.currentPath || "";
    var _onWiki    = _path.indexOf("/wiki") === 0 || _path.indexOf("/tags") === 0;
    var _onGalerie = _path.indexOf("/galerie") === 0 || _path.indexOf("/bd") === 0;
    var _onQuizz   = _path === "/" || _path.indexOf("/section") === 0 || _path.indexOf("/results") === 0;
  %>
  <div class="pc-nav" id="pc-nav">

    <a href="/" class="pc-nav-brand-link"><%= config.title %></a>

    <div class="pc-nav-links">
      <div class="pc-nav-item pc-has-drop">
        <a href="/wiki" class="pc-nav-link pc-nav-link--wiki<%= _onWiki ? ' pc-nav-link--active' : '' %>">Codex</a>
        <div class="pc-drop">
          <% (locals.wikiCategories || []).forEach(function(c) { %>
            <a href="/wiki/categorie/<%= c.key %>" class="pc-drop-link"><%= c.label %></a>
          <% }) %>
        </div>
      </div>
      <% if (currentUser) { %>
        <div class="pc-nav-item pc-has-drop">
          <a href="/galerie" class="pc-nav-link pc-nav-link--galerie<%= _onGalerie ? ' pc-nav-link--active' : '' %>">Galerie</a>
          <div class="pc-drop">
            <a href="/galerie" class="pc-drop-link">Galerie</a>
            <a href="/bd" class="pc-drop-link">BD</a>
          </div>
        </div>
        <div class="pc-nav-item pc-has-drop">
          <a href="/" class="pc-nav-link pc-nav-link--quizz<%= _onQuizz ? ' pc-nav-link--active' : '' %>">Quizz</a>
          <div class="pc-drop">
            <% (config.sections || []).forEach(function(s, i) { %>
              <a href="/section/<%= i %>" class="pc-drop-link">
                <span class="pc-drop-dot" style="background:<%= s.color || 'var(--accent)' %>"></span>
                <%= s.title %>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>

    <div class="pc-nav-actions">
        <details class="pc-consent-details pc-hover-menu">
          <summary class="pc-icon-btn pc-consent-btn" title="Rappel consentement" aria-label="Rappel sur le consentement">?</summary>
          <div class="pc-consent-panel">
            <p class="pc-consent-title">Consentement</p>
            <p>Un fantasme n&rsquo;est pas un accord. Une discussion n&rsquo;est pas un accord. Le consentement se donne librement, clairement, et il est r&eacute;vocable &agrave; tout moment par chacun des partenaires.</p>
            <p class="pc-consent-legal">Certains fantasmes abord&eacute;s sont ill&eacute;gaux dans leur pratique. Nous le rappelons sur les fiches individuelles. Nous soutenons le droit au fantasme, mais condamnons et d&eacute;courageons toute pratique ill&eacute;gale ou dangereuse.</p>
          </div>
        </details>
        <button type="button" class="pc-icon-btn pc-discreet-btn" id="pc-discreet-btn" aria-pressed="false" title="Masquer les images" aria-label="Masquer les images"><%- include('eye-icon') %></button>
        <div class="pc-search-inline" id="pc-search-inline">
          <button type="button" class="pc-icon-btn" id="pc-search-btn" aria-label="Rechercher sur tout le site" aria-expanded="false"><%- include('search-icon') %></button>
          <input type="search" id="pc-search-input" class="pc-search-inline-input" placeholder="Rechercher&hellip;" autocomplete="off" aria-label="Rechercher sur tout le site" />
          <div class="pc-search-results" id="pc-search-results" hidden></div>
        </div>
        <% if (currentUser) { %>
          <% var _roleClass = currentUser.isAdmin ? 'pc-key-admin' : (currentUser.isTest ? 'pc-key-test' : 'pc-key-user'); %>
          <div class="pc-nav-item pc-has-drop pc-hover-menu">
            <button type="button" class="pc-icon-btn <%= _roleClass %>" title="<%= currentUser.displayName %>"><%- include('key-icon') %></button>
            <div class="pc-drop pc-drop-right">
              <a href="/favoris" class="pc-drop-link">Profil</a>
              <% if (currentUser.isAdmin) { %>
                <a href="/admin" class="pc-drop-link">Admin</a>
              <% } %>
              <form method="POST" action="/admin/logout" style="margin:0">
                <button type="submit" class="pc-drop-link pc-drop-link-btn pc-drop-link--danger">D&eacute;connexion</button>
              </form>
            </div>
          </div>
        <% } else { %>
          <a href="/admin/login?next=<%= encodeURIComponent(locals.currentPath || '/') %>"
             class="pc-icon-btn" title="Connexion"><%- include('key-icon') %></a>
        <% } %>
      </div>

  </div>
</div>


<div class="nav-backdrop" id="nav-backdrop"></div>

<aside class="nav-drawer" id="nav-drawer" aria-hidden="true">
  <div class="nav-drawer-header">
    <button type="button" class="nav-drawer-close" id="nav-drawer-close" aria-label="Fermer">&#10005;</button>
    <a href="/" class="nav-drawer-home">Accueil</a>
  </div>

  <nav class="nav-drawer-body">
    <button type="button" class="nav-drawer-link nav-drawer-link-btn nav-drawer-discreet-btn" id="nav-drawer-discreet-btn" aria-pressed="false"><%- include('eye-icon') %> <span>Masquer les images</span></button>
    <a href="/wiki" class="nav-drawer-link">Codex</a>
    <% if (currentUser) { %>
      <a href="/galerie" class="nav-drawer-link">Galerie</a>
      <a href="/bd" class="nav-drawer-link">BD</a>
      <span class="nav-drawer-link nav-drawer-link-disabled" title="Bient&ocirc;t disponible">Liens</span>
      <a href="/favoris" class="nav-drawer-link">Mes favoris</a>

      <details class="nav-drawer-group" open>
        <summary class="nav-drawer-group-summary">Quizz</summary>
        <div class="nav-drawer-sublist">
          <% config.sections.forEach(function (s, i) { %>
            <a href="/section/<%= i %>" class="nav-drawer-link">
              <span class="nav-drawer-dot" style="background: <%= s.color || 'var(--accent)' %>"></span> <%= s.title %>
            </a>
          <% }) %>
        </div>
      </details>
    <% } %>
  </nav>

  <details class="nav-consent-details">
    <summary class="nav-consent-summary">? Consentement</summary>
    <div class="nav-consent-body">
      <p>Un fantasme n&rsquo;est pas un accord. Une discussion n&rsquo;est pas un accord. Le consentement se donne librement, clairement, et il est r&eacute;vocable &agrave; tout moment par chacun des partenaires.</p>
      <p>Certains fantasmes abord&eacute;s sont ill&eacute;gaux dans leur pratique. Nous le rappelons sur les fiches individuelles. Nous soutenons le droit au fantasme, mais condamnons et d&eacute;courageons toute pratique ill&eacute;gale ou dangereuse.</p>
    </div>
  </details>

  <div class="nav-drawer-footer">
    <% if (currentUser) { %>
      <a href="/favoris" class="nav-drawer-link">Profil</a>
      <% if (currentUser.isAdmin) { %>
        <a href="/admin" class="nav-drawer-link">Admin</a>
      <% } %>
      <form method="POST" action="/admin/logout" style="margin:0">
        <button type="submit" class="nav-drawer-link nav-drawer-link-btn nav-drawer-link--danger">D&eacute;connexion</button>
      </form>
    <% } else { %>
      <a href="/admin/login?next=<%= encodeURIComponent(locals.currentPath || '/') %>"
         class="nav-drawer-admin" title="Connexion">&#128273;</a>
    <% } %>
  </div>
</aside>
