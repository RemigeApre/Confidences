<div class="top-nav">

  <%# ─── Mobile : retour + titre + utilitaires (masqués sur desktop) ───── %>
  <% if (locals.navBack) { %>
    <a href="<%= locals.navBack %>" class="nav-back-btn" aria-label="Retour">&#8592;</a>
  <% } else { %>
    <span class="nav-back-placeholder"></span>
  <% } %>
  <span class="top-nav-page-title"><%= locals.navTitle || config.title %></span>
  <div class="nav-mobile-utils">
    <% if (currentUser) { %>
      <button type="button" class="nav-mobile-util-btn nav-mobile-discreet-btn" id="nav-mobile-discreet-btn" aria-pressed="false" title="Masquer les images" aria-label="Masquer les images"><%- include('eye-icon') %></button>
    <% } %>
    <details class="nav-mobile-consent">
      <summary class="nav-mobile-util-btn" title="Rappel consentement" aria-label="Rappel sur le consentement">?</summary>
      <div class="nav-mobile-consent-panel">
        <p class="pc-consent-title">Consentement</p>
        <p>Un fantasme n&rsquo;est pas un accord. Une discussion n&rsquo;est pas un accord. Le consentement se donne librement, clairement, et il est r&eacute;vocable &agrave; tout moment par chacun des partenaires.</p>
        <p class="pc-consent-legal">Certains fantasmes abord&eacute;s sont ill&eacute;gaux dans leur pratique. Nous le rappelons sur les fiches individuelles. Nous soutenons le droit au fantasme, mais condamnons et d&eacute;courageons toute pratique ill&eacute;gale ou dangereuse.</p>
        <p class="pc-consent-legal">Aucune photo de personne r&eacute;elle n&rsquo;est publi&eacute;e ici, par respect pour le consentement.</p>
      </div>
    </details>
  </div>

  <%# ─── Desktop : barre pleine largeur (masquée sur mobile) ──────────── %>
  <%
    var _path = locals.currentPath || "";
    var _onWiki    = _path.indexOf("/wiki") === 0;
    var _onGalerie = _path.indexOf("/galerie") === 0 || _path.indexOf("/bd") === 0 || _path.indexOf("/nouvelles") === 0 || _path.indexOf("/liens") === 0 || _path.indexOf("/parodies") === 0 || _path.indexOf("/tags") === 0 || _path.indexOf("/protagonistes") === 0;
    var _onNouvelles = _path.indexOf("/nouvelles") === 0;
    var _onQuizz   = _path.indexOf("/quizz") === 0;
    var _onCouple  = _path.indexOf("/couple") === 0;
    var _onJeu     = _path.indexOf("/jeu") === 0;
    var _onGalerieOnly = _path.indexOf("/galerie") === 0;
    var _onBd     = _path.indexOf("/bd") === 0;
    var _onProfil = _path.indexOf("/favoris") === 0;
  %>
  <div class="pc-nav" id="pc-nav">

    <a href="/" class="pc-nav-brand-link"><%= config.title %></a>

    <div class="pc-nav-links">
      <a href="/wiki" class="pc-nav-link pc-nav-link--wiki<%= _onWiki ? ' pc-nav-link--active' : '' %>">Codex</a>
      <% if (currentUser) { %>
        <div class="pc-nav-item pc-has-drop">
          <span class="pc-nav-link pc-nav-link--galerie pc-nav-link--label<%= _onGalerie ? ' pc-nav-link--active' : '' %>">Exploration</span>
          <div class="pc-drop">
            <a href="/galerie" class="pc-drop-link pc-drop-link--images">Images</a>
            <a href="/bd" class="pc-drop-link pc-drop-link--bd">BD</a>
            <% if (currentUser && currentUser.isAdmin) { %><a href="/nouvelles" class="pc-drop-link pc-drop-link--histoire">Histoire</a><% } %>
            <hr class="pc-drop-sep" />
            <a href="/tags" class="pc-drop-link pc-drop-link--labels">Labels</a>
            <a href="/parodies" class="pc-drop-link pc-drop-link--parodies">Parodies</a>
            <a href="/protagonistes" class="pc-drop-link pc-drop-link--prot">Personnages</a>
          </div>
        </div>
        <a href="/quizz" class="pc-nav-link pc-nav-link--quizz<%= _onQuizz ? ' pc-nav-link--active' : '' %>">Quizz</a>
        <a href="/jeu" class="pc-nav-link pc-nav-link--jeu<%= _onJeu ? ' pc-nav-link--active' : '' %>">Jeu<span class="lootbox-nav-badge" id="nav-jeu-badge" hidden></span></a>
      <% } %>
    </div>

    <div class="pc-nav-actions">
        <details class="pc-consent-details pc-hover-menu">
          <summary class="pc-icon-btn pc-consent-btn" title="Rappel consentement" aria-label="Rappel sur le consentement">?</summary>
          <div class="pc-consent-panel">
            <p class="pc-consent-title">Consentement</p>
            <p>Un fantasme n&rsquo;est pas un accord. Une discussion n&rsquo;est pas un accord. Le consentement se donne librement, clairement, et il est r&eacute;vocable &agrave; tout moment par chacun des partenaires.</p>
            <p class="pc-consent-legal">Certains fantasmes abord&eacute;s sont ill&eacute;gaux dans leur pratique. Nous le rappelons sur les fiches individuelles. Nous soutenons le droit au fantasme, mais condamnons et d&eacute;courageons toute pratique ill&eacute;gale ou dangereuse.</p>
            <p class="pc-consent-legal">Aucune photo de personne r&eacute;elle n&rsquo;est publi&eacute;e ici, par respect pour le consentement.</p>
          </div>
        </details>
        <% if (currentUser) { %>
        <button type="button" class="pc-icon-btn pc-discreet-btn" id="pc-discreet-btn" aria-pressed="false" title="Masquer les images" aria-label="Masquer les images"><%- include('eye-icon') %></button>
        <% } %>
        <% if (currentUser) { %>
        <div class="pc-nav-coins" title="Vos pi&egrave;ces">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="hsl(44,95%,55%)" stroke="hsl(44,70%,35%)" stroke-width="1.5"/><text x="10" y="14.5" text-anchor="middle" font-size="10" font-weight="bold" fill="hsl(44,40%,20%)">P</text></svg>
          <span class="pc-nav-coins-count"><%= currentUser.coins || 0 %></span>
        </div>
        <% } %>
        <% if (currentUser) { %>
          <% var _roleClass = currentUser.isAdmin ? 'pc-key-admin' : (currentUser.isTest ? 'pc-key-test' : 'pc-key-user'); %>
          <div class="pc-nav-item pc-has-drop pc-hover-menu">
            <button type="button" class="pc-icon-btn pc-avatar-btn <%= _roleClass %>" title="<%= currentUser.displayName %>"><%- include('profile-avatar') %></button>
            <div class="pc-drop pc-drop-right">
              <a href="/favoris" class="pc-drop-link">Profil</a>
              <% if (locals.partnerUser) { %>
                <a href="/couple" class="pc-drop-link">Profil de <%= partnerUser.displayName %></a>
              <% } %>
              <a href="/liens" class="pc-drop-link">Liens</a>
              <% if (currentUser.isAdmin) { %>
                <a href="/admin" class="pc-drop-link">Admin</a>
              <% } %>
              <form method="POST" action="/admin/logout" style="margin:0">
                <button type="submit" class="pc-drop-link pc-drop-link-btn pc-drop-link--danger">D&eacute;connexion</button>
              </form>
            </div>
          </div>
        <% } else { %>
          <a href="/admin/login?next=<%= encodeURIComponent(locals.currentPath || '/') %>"
             class="pc-icon-btn" title="Connexion"><%- include('key-icon') %></a>
        <% } %>
      </div>

  </div>
</div>

<%# ─── Barre de navigation mobile (bas d'écran, façon TikTok/Instagram) ──
    5 icônes : Codex | Images | Profil (centre) | Quizz | Menu burger
    Masquée sur desktop (la pc-nav ci-dessus prend le relais). ────────── %>
<%
  var _onMenu = _path === "/mobile-menu";
%>
<nav class="mobile-tabbar" aria-label="Navigation principale">

  <%# 1. Codex %>
  <a href="/wiki" class="mobile-tabbar-link<%= _onWiki ? ' active' : '' %>" aria-label="Codex" title="Codex">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9a2 2 0 0 1 2 2v16l-6.5-4.2L4 21V5a2 2 0 0 1 2-2Z"/></svg>
  </a>

  <%# 2. Images %>
  <% if (currentUser) { %>
    <a href="/galerie" class="mobile-tabbar-link<%= _onGalerieOnly ? ' active' : '' %>" aria-label="Images" title="Images">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
    </a>
  <% } else { %>
    <span class="mobile-tabbar-link mobile-tabbar-link--disabled" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
    </span>
  <% } %>

  <%# 3. Centre : Profil %>
  <% if (currentUser) { %>
    <a href="/favoris" class="mobile-tabbar-home mobile-tabbar-home--profile<%= _onProfil ? ' active' : '' %>" aria-label="Mon profil" title="Mon profil">
      <%- include('profile-avatar') %>
    </a>
  <% } else { %>
    <a href="/admin/login?next=<%= encodeURIComponent(locals.currentPath || '/') %>" class="mobile-tabbar-home" aria-label="Connexion" title="Connexion">
      <%- include('key-icon') %>
    </a>
  <% } %>

  <%# 4. Quizz %>
  <% if (currentUser) { %>
    <a href="/quizz" class="mobile-tabbar-link<%= _onQuizz ? ' active' : '' %>" aria-label="Quizz" title="Quizz">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><circle cx="12" cy="17" r=".5" fill="currentColor" stroke="none"/></svg>
    </a>
  <% } else { %>
    <span class="mobile-tabbar-link mobile-tabbar-link--disabled" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><circle cx="12" cy="17" r=".5" fill="currentColor" stroke="none"/></svg>
    </span>
  <% } %>

  <%# 5. Burger menu %>
  <a href="/mobile-menu" class="mobile-tabbar-link<%= _onMenu ? ' active' : '' %>" aria-label="Menu" title="Menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </a>

</nav>
