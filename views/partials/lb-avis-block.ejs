<%# ── Bloc avis du volet image (notation + j'adore/masquer/collection) ── %>
<div class="lb-avis-block" id="gallery-lb-actions" hidden>
  <div class="gallery-lb-rating" id="gallery-lb-rating">
    <% for (var _s = 1; _s <= 5; _s++) { %>
      <span class="gallery-star" data-val="<%= _s %>">&#9733;</span>
    <% } %>
  </div>
  <div class="lb-react-row">
    <button type="button" class="lb-react-icon-btn gallery-lb-collection-btn" id="gallery-lb-collection-btn"
      title="Ajouter &agrave; une collection" aria-label="Collection">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
    </button>
    <button type="button" class="lb-react-main-btn gallery-lb-fav-btn" id="gallery-lb-fav-btn" title="J&rsquo;adore">
      J&rsquo;adore
    </button>
    <button type="button" class="lb-react-icon-btn gallery-lb-hide-btn" id="gallery-lb-hide-btn"
      aria-label="Masquer">
      <span class="lbhb-eye-normal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </span>
      <span class="lbhb-eye-crossed" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
      </span>
      <span class="gallery-lb-hide-tooltip">Masquer le contenu</span>
    </button>
  </div>
  <%# Mode couple : révélé seulement une fois que le visiteur a lui-même noté %>
  <div class="wiki-partner-reveal" id="gallery-lb-partner-reveal"
    data-partner-name="<%= locals.partnerUser ? partnerUser.displayName : '' %>" hidden></div>
</div>
