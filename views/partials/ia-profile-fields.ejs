<div class="ia-form-row">
  <label class="admin-modal-field" style="flex:2">
    <span>Nom</span>
    <input type="text" name="name" required autocomplete="off" maxlength="80" />
  </label>
  <label class="admin-modal-field" style="flex:1">
    <span>Âge</span>
    <input type="text" name="age" placeholder="ex. 24" autocomplete="off" maxlength="20" />
  </label>
  <label class="admin-modal-field" style="flex:1">
    <span>Sexe</span>
    <select name="sexe" class="admin-modal-select">
      <option value="">—</option>
      <option value="femme">Femme</option>
      <option value="homme">Homme</option>
      <option value="non-binaire">Non-binaire</option>
    </select>
  </label>
</div>

<details class="ia-phys-details">
  <summary class="ia-phys-summary">Description physique</summary>
  <div class="ia-phys-body">

    <div class="ia-phys-group">
      <span class="ia-phys-group-label">Peau</span>
      <div class="ia-phys-row">
        <label class="admin-modal-field">
          <span>Couleur</span>
          <input type="text" name="phys_skin" placeholder="claire, mate, foncée, hâlée…" autocomplete="off" />
        </label>
      </div>
    </div>

    <div class="ia-phys-group">
      <span class="ia-phys-group-label">Cheveux</span>
      <div class="ia-phys-row">
        <label class="admin-modal-field">
          <span>Couleur</span>
          <input type="text" name="phys_hair_color" placeholder="bruns, blonds, roux…" autocomplete="off" />
        </label>
        <label class="admin-modal-field">
          <span>Longueur</span>
          <input type="text" name="phys_hair_length" placeholder="courts, mi-longs, longs…" autocomplete="off" />
        </label>
        <label class="admin-modal-field">
          <span>Style</span>
          <input type="text" name="phys_hair_style" placeholder="bouclés, lisses, ondulés…" autocomplete="off" />
        </label>
      </div>
    </div>

    <div class="ia-phys-group">
      <span class="ia-phys-group-label">Yeux</span>
      <div class="ia-phys-row">
        <label class="admin-modal-field">
          <span>Couleur</span>
          <input type="text" name="phys_eyes_color" placeholder="bleus, verts, noisette…" autocomplete="off" />
        </label>
        <label class="admin-modal-field">
          <span>Forme / style</span>
          <input type="text" name="phys_eyes_style" placeholder="en amande, grands, expressifs…" autocomplete="off" />
        </label>
      </div>
    </div>

    <div class="ia-phys-group">
      <span class="ia-phys-group-label">Silhouette</span>
      <div class="ia-phys-row">
        <label class="admin-modal-field">
          <span>Taille</span>
          <input type="text" name="phys_height" placeholder="1m65, grande, petite…" autocomplete="off" />
        </label>
        <label class="admin-modal-field">
          <span>Morphologie</span>
          <input type="text" name="phys_body" placeholder="mince, athlétique, pulpeuse…" autocomplete="off" />
        </label>
      </div>
    </div>

    <label class="admin-modal-field">
      <span>Particularités supplémentaires</span>
      <textarea name="phys_extras" rows="2" class="ia-desc-textarea"
        placeholder="tatouages, cicatrices, grain de beauté, fossettes, voix particulière…"></textarea>
    </label>

  </div>
</details>

<label class="admin-modal-field">
  <span>Personnalité / contexte</span>
  <textarea name="description" rows="4" class="ia-desc-textarea" placeholder="Caractère, histoire, particularités…"></textarea>
</label>
<label class="admin-modal-field">
  <span>Type de relation avec l'utilisateur</span>
  <input type="text" name="relation_type" placeholder="ex. amante, maîtresse, inconnue de passage…" autocomplete="off" maxlength="120" />
</label>

<fieldset class="ia-fantasmes-fieldset">
  <legend>Fantasmes / int&eacute;r&ecirc;ts (Codex)</legend>
  <% if (!fantasyWikiPages || !fantasyWikiPages.length) { %>
    <p style="font-size:.78rem;color:#fca5a5;opacity:.6;margin:.25rem 0">
      Aucune page Codex disponible pour l&apos;instant.
    </p>
  <% } else { %>
    <div class="ia-fant-search-wrap">
      <input type="text" class="ia-fant-search" placeholder="Filtrer…" autocomplete="off" />
    </div>
    <div class="ia-fant-items">
      <% fantasyWikiPages.forEach(function(wp) { %>
        <label class="ia-fant-item">
          <input type="checkbox" name="fantasmes" value="<%= wp.title %>" class="ia-fant-chk" />
          <span><%= wp.title %></span>
        </label>
      <% }) %>
    </div>
  <% } %>
</fieldset>
