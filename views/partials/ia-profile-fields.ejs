<%# ─────────────────────────────────────────────────────────────
    Identité
───────────────────────────────────────────────────────────── %>
<div class="ia-section-label">Identité</div>
<div class="ia-form-row">
  <label class="admin-modal-field" style="flex:2">
    <span>Nom</span>
    <input type="text" name="name" required autocomplete="off" maxlength="80"
      placeholder="Tu t'appelles [réponse]." />
  </label>
  <label class="admin-modal-field" style="flex:1">
    <span>Âge</span>
    <input type="text" name="age" autocomplete="off" maxlength="20"
      placeholder="…de [réponse] ans." />
  </label>
  <label class="admin-modal-field" style="flex:1">
    <span>Sexe</span>
    <select name="sexe" class="admin-modal-select">
      <option value="">—</option>
      <option value="femme">Femme</option>
      <option value="homme">Homme</option>
      <option value="non-binaire">Non-binaire</option>
    </select>
  </label>
</div>
<label class="admin-modal-field">
  <span>Relation avec l'utilisateur</span>
  <input type="text" name="relation_type" autocomplete="off" maxlength="160"
    placeholder="Sa relation avec l'utilisateur : [réponse]." />
</label>

<%# ─────────────────────────────────────────────────────────────
    Apparence physique
───────────────────────────────────────────────────────────── %>
<details class="ia-details-block">
  <summary class="ia-details-summary">Apparence physique</summary>
  <div class="ia-details-body">

    <div class="ia-phys-group">
      <span class="ia-phys-group-label">Peau</span>
      <div class="ia-phys-row">
        <label class="admin-modal-field">
          <span>Couleur / teint</span>
          <input type="text" name="phys_skin" autocomplete="off"
            placeholder="Elle a la peau [réponse]." />
        </label>
      </div>
    </div>

    <div class="ia-phys-group">
      <span class="ia-phys-group-label">Cheveux</span>
      <div class="ia-phys-row">
        <label class="admin-modal-field">
          <span>Couleur</span>
          <input type="text" name="phys_hair_color" autocomplete="off"
            placeholder="Ses cheveux sont [réponse]…" />
        </label>
        <label class="admin-modal-field">
          <span>Longueur</span>
          <input type="text" name="phys_hair_length" autocomplete="off"
            placeholder="…[réponse]…" />
        </label>
        <label class="admin-modal-field">
          <span>Style</span>
          <input type="text" name="phys_hair_style" autocomplete="off"
            placeholder="…et [réponse]." />
        </label>
      </div>
    </div>

    <div class="ia-phys-group">
      <span class="ia-phys-group-label">Yeux</span>
      <div class="ia-phys-row">
        <label class="admin-modal-field">
          <span>Couleur</span>
          <input type="text" name="phys_eyes_color" autocomplete="off"
            placeholder="Ses yeux sont [réponse]…" />
        </label>
        <label class="admin-modal-field">
          <span>Forme / style</span>
          <input type="text" name="phys_eyes_style" autocomplete="off"
            placeholder="…[réponse]." />
        </label>
      </div>
    </div>

    <div class="ia-phys-group">
      <span class="ia-phys-group-label">Silhouette</span>
      <div class="ia-phys-row">
        <label class="admin-modal-field">
          <span>Taille</span>
          <input type="text" name="phys_height" autocomplete="off"
            placeholder="Elle mesure [réponse]…" />
        </label>
        <label class="admin-modal-field">
          <span>Morphologie</span>
          <input type="text" name="phys_body" autocomplete="off"
            placeholder="…et a une silhouette [réponse]." />
        </label>
      </div>
    </div>

    <label class="admin-modal-field">
      <span>Particularités supplémentaires</span>
      <textarea name="phys_extras" rows="2" class="ia-desc-textarea"
        placeholder="[réponse] — ajouté tel quel à la description physique."></textarea>
    </label>

  </div>
</details>

<%# ─────────────────────────────────────────────────────────────
    Personnalité
───────────────────────────────────────────────────────────── %>
<div class="ia-section-label">Personnalité</div>
<label class="admin-modal-field">
  <textarea name="description" rows="5" class="ia-desc-textarea"
    placeholder="[réponse] — inséré tel quel comme paragraphe de personnalité."></textarea>
</label>

<%# ─────────────────────────────────────────────────────────────
    Sexualité
───────────────────────────────────────────────────────────── %>
<details class="ia-details-block">
  <summary class="ia-details-summary">Sexualité</summary>
  <div class="ia-details-body">

    <label class="admin-modal-field">
      <span>Fantasmes</span>
      <textarea name="sex_fantasmes" rows="3" class="ia-desc-textarea"
        placeholder="Ses fantasmes : [réponse]."></textarea>
    </label>

    <label class="admin-modal-field">
      <span>Déjà pratiqué</span>
      <textarea name="sex_practiced" rows="3" class="ia-desc-textarea"
        placeholder="Elle a déjà exploré : [réponse]."></textarea>
    </label>

    <label class="admin-modal-field">
      <span>Détails / précisions</span>
      <textarea name="sex_details" rows="3" class="ia-desc-textarea"
        placeholder="[réponse] — inséré tel quel dans le prompt."></textarea>
    </label>

  </div>
</details>

<%# ─────────────────────────────────────────────────────────────
    Intérêts / Codex
───────────────────────────────────────────────────────────── %>
<details class="ia-details-block">
  <summary class="ia-details-summary">Intérêts &amp; désirs (Codex)</summary>
  <div class="ia-details-body">
    <% if (!fantasyWikiPages || !fantasyWikiPages.length) { %>
      <p class="ia-empty-hint">Aucune page Codex disponible pour l&apos;instant.</p>
    <% } else { %>
      <div class="ia-fant-search-wrap">
        <input type="text" class="ia-fant-search" placeholder="Filtrer les pages…" autocomplete="off" />
      </div>
      <div class="ia-fant-items">
        <% fantasyWikiPages.forEach(function(wp) { %>
          <label class="ia-fant-item">
            <input type="checkbox" name="fantasmes" value="<%= wp.title %>" class="ia-fant-chk" />
            <span><%= wp.title %></span>
          </label>
        <% }) %>
      </div>
    <% } %>
  </div>
</details>

<%# ─────────────────────────────────────────────────────────────
    Aperçu du prompt (live)
───────────────────────────────────────────────────────────── %>
<div class="ia-preview-section">
  <div class="ia-preview-header">
    <span class="ia-preview-label">Aperçu du prompt</span>
    <div class="ia-preview-btns">
      <button type="button" class="ia-preview-copy-btn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        Copier
      </button>
      <button type="button" class="ia-preview-dl-btn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        .txt
      </button>
    </div>
  </div>
  <pre class="ia-preview-text">Remplis les champs ci-dessus…</pre>
</div>
