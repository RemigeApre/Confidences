<%
/*  Filtre parodies (sélection unique) — délègue à filter-chips.ejs.
 *  Paramètres : filterId, parodies, label?
 *  Événement : 'parodyfilter:change' → { filterId, active: '' | nom }
 */
  var _fid    = filterId;
  var _items  = parodies || [];
  var _label  = (typeof label !== 'undefined') ? label : 'Parodies';
%>
<%- include('filter-chips', {
      filterId:  _fid,
      items:     _items,
      itemKey:   'parody',
      chipClass: 'parody-chip',
      label:     _label,
      mode:      'single',
      eventName: 'parodyfilter:change'
    }) %>
