<%
/*  Partial : filtre de base — tri + affichage + type (ultra/irréaliste)
 *  La barre de recherche est rendue séparément via partials/search-bar.ejs.
 *
 *  Paramètres :
 *    searchId       {string}   ID du <input> recherche lié (pour dispatch)
 *    showSort       {boolean}  tri                         (défaut false)
 *    sortOptions    {Array}    [{value,label}]
 *    defaultSort    {string}                               (défaut 'date-desc')
 *    showDisplay    {boolean}  nombre de colonnes          (défaut false)
 *    displayOptions {Array}    [{value,label}]
 *    defaultDisplay {string}                               (défaut '3')
 *    showType       {boolean}  chips ultra/irréaliste      (défaut false)
 *    showObjet      {boolean}  chip Objets                 (défaut false)
 *
 *  Événement émis (bubbles) :
 *    'filterbase:change' → { search, sort, display,
 *                            types: { ultra, irrealiste, objet } }
 *
 *  Méthode DOM : block._reset()
 */
  var _sid     = searchId;
  var _bid     = _sid + '-base';
  var _srtId   = _sid + '-sort';
  var _dispId  = _sid + '-disp';
  var _srt     = (typeof showSort        !== 'undefined') ? showSort        : false;
  var _disp    = (typeof showDisplay     !== 'undefined') ? showDisplay     : false;
  var _type    = (typeof showType        !== 'undefined') ? showType        : false;
  var _objet   = (typeof showObjet       !== 'undefined') ? showObjet       : false;
  var _srtOpts = (typeof sortOptions     !== 'undefined') ? sortOptions     : [
    { value: 'date-desc',  label: 'Plus récent'  },
    { value: 'date-asc',   label: 'Plus ancien'  },
    { value: 'alpha-asc',  label: 'Alphabétique' },
    { value: 'random',     label: 'Aléatoire'    }
  ];
  var _defSrt  = (typeof defaultSort     !== 'undefined') ? defaultSort     : 'date-desc';
  var _dispOpts= (typeof displayOptions  !== 'undefined') ? displayOptions  : [
    { value: '2', label: '2 col.' },
    { value: '3', label: '3 col.' },
    { value: '4', label: '4 col.' }
  ];
  var _defDisp = (typeof defaultDisplay  !== 'undefined') ? defaultDisplay  : '3';
%>
<div class="filter-block filter-block--base" id="<%= _bid %>">

  <%# ── Tri + affichage ── %>
  <% if (_srt || _disp) { %>
  <div class="wiki-filter-section wiki-sort-cols-row">
    <% if (_srt) { %>
    <select id="<%= _srtId %>" class="wiki-sort-select" data-default="<%= _defSrt %>">
      <% _srtOpts.forEach(function(o) { %>
        <option value="<%= o.value %>"<%= o.value === _defSrt ? ' selected' : '' %>><%= o.label %></option>
      <% }) %>
    </select>
    <% } %>
    <% if (_disp) { %>
    <select id="<%= _dispId %>" class="wiki-sort-select" data-default="<%= _defDisp %>">
      <% _dispOpts.forEach(function(o) { %>
        <option value="<%= o.value %>"<%= o.value === _defDisp ? ' selected' : '' %>><%= o.label %></option>
      <% }) %>
    </select>
    <% } %>
  </div>
  <% } %>

  <%# ── Type (ultra / irréaliste / objets) ── %>
  <% if (_type) { %>
  <div class="wiki-filter-section wiki-filter-toggles">
    <button type="button" class="wiki-ultra-btn" data-type="ultra"      data-state="0">Ultra</button>
    <button type="button" class="wiki-ultra-btn" data-type="irrealiste" data-state="0">Irr&eacute;aliste</button>
    <% if (_objet) { %>
    <button type="button" class="wiki-ultra-btn" data-type="objet"      data-state="0">Objets</button>
    <% } %>
  </div>
  <% } %>

</div>

<script nonce="<%= nonce %>">
(function () {
  var block  = document.getElementById('<%= _bid %>');
  var input  = document.getElementById('<%= _sid %>');
  var clear  = document.getElementById('<%= _sid %>-clear');
  var sortEl = document.getElementById('<%= _srtId %>');
  var dispEl = document.getElementById('<%= _dispId %>');
  if (!block || !input) return;

  var _debounce;

  function getTypes() {
    var t = {};
    block.querySelectorAll('.wiki-ultra-btn[data-type]').forEach(function (btn) {
      t[btn.dataset.type] = Number(btn.dataset.state) || 0;
    });
    return t;
  }

  function dispatch() {
    block.dispatchEvent(new CustomEvent('filterbase:change', {
      bubbles: true,
      detail: {
        search:  input.value.trim(),
        sort:    sortEl ? sortEl.value : null,
        display: dispEl ? dispEl.value : null,
        types:   getTypes()
      }
    }));
  }

  // État initial des types depuis les préférences compte
  block.querySelectorAll('.wiki-ultra-btn[data-type]').forEach(function (btn) {
    var s = 0;
    if (btn.dataset.type === 'ultra'      && window.ULTRA_MODE      === 'hidden') s = 2;
    if (btn.dataset.type === 'irrealiste' && window.IRREALISTE_MODE === 'hidden') s = 2;
    _applyTypeState(btn, s);
  });

  function _applyTypeState(btn, s) {
    btn.dataset.state = String(s);
    // état 0 : neutre  → style normal wiki-ultra-btn
    // état 1 : inclure → vert (chip-include)
    // état 2 : masquer → actif Codex (wiki-ultra-btn.active, bleu sombre)
    btn.classList.toggle('chip-include', s === 1);
    btn.classList.toggle('active',       s === 2);
  }

  // Recherche
  input.addEventListener('input', function () {
    clear.hidden = !input.value;
    clearTimeout(_debounce);
    _debounce = setTimeout(dispatch, 220);
  });
  clear.addEventListener('click', function () {
    input.value = ''; clear.hidden = true; dispatch();
  });

  // Tri / Affichage
  if (sortEl) sortEl.addEventListener('change', dispatch);
  if (dispEl) dispEl.addEventListener('change', dispatch);

  // Type (3 états)
  block.querySelectorAll('.wiki-ultra-btn[data-type]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var s = ((Number(btn.dataset.state) || 0) + 1) % 3;
      _applyTypeState(btn, s);
      dispatch();
    });
  });

  // Réinitialisation
  block._reset = function () {
    input.value = ''; clear.hidden = true;
    if (sortEl) sortEl.value = sortEl.dataset.default || sortEl.options[0].value;
    if (dispEl) dispEl.value = dispEl.dataset.default || dispEl.options[0].value;
    block.querySelectorAll('.wiki-ultra-btn[data-type]').forEach(function (btn) {
      var s = 0;
      if (btn.dataset.type === 'ultra'      && window.ULTRA_MODE      === 'hidden') s = 2;
      if (btn.dataset.type === 'irrealiste' && window.IRREALISTE_MODE === 'hidden') s = 2;
      _applyTypeState(btn, s);
    });
    dispatch();
  };

  // Dispatch initial différé : garantit que les listeners de la page sont attachés
  setTimeout(dispatch, 0);
})();
</script>
