<%
/*  Partial : filtre de base (recherche + tri + affichage + type)
 *
 *  Paramètres :
 *    searchId      {string}   ID du champ recherche (requis)
 *    showSort      {boolean}  afficher le tri           (défaut false)
 *    sortOptions   {Array}    [{value,label}]           (défaut : date/alpha/aléatoire)
 *    defaultSort   {string}   valeur sélectionnée       (défaut 'date-desc')
 *    showDisplay   {boolean}  afficher nb de colonnes   (défaut false)
 *    displayOptions{Array}    [{value,label}]
 *    defaultDisplay{string}                             (défaut '3')
 *    showType      {boolean}  afficher ultra/irréaliste (défaut false)
 *    showObjet     {boolean}  ajouter bouton "Objets"   (défaut false)
 *
 *  Événement émis (bubbles) :
 *    'filterbase:change'  →  { search, sort, display, types:{ultra,irrealiste,objet} }
 *
 *  Méthode DOM :
 *    block._reset()  — réinitialise l'UI et dispatch l'événement
 */
  var _sid   = searchId;
  var _bid   = _sid + '-base';
  var _srtId = _sid + '-sort';
  var _dispId= _sid + '-disp';
  var _srt   = (typeof showSort      !== 'undefined') ? showSort      : false;
  var _disp  = (typeof showDisplay   !== 'undefined') ? showDisplay   : false;
  var _type  = (typeof showType      !== 'undefined') ? showType      : false;
  var _objet = (typeof showObjet     !== 'undefined') ? showObjet     : false;
  var _srtOpts = (typeof sortOptions !== 'undefined') ? sortOptions   : [
    { value: 'date-desc',  label: 'Plus récent'   },
    { value: 'date-asc',   label: 'Plus ancien'   },
    { value: 'alpha-asc',  label: 'Alphabétique'  },
    { value: 'random',     label: 'Aléatoire'     }
  ];
  var _defSrt  = (typeof defaultSort    !== 'undefined') ? defaultSort    : 'date-desc';
  var _dispOpts= (typeof displayOptions !== 'undefined') ? displayOptions : [
    { value: '2', label: '2 col.' },
    { value: '3', label: '3 col.' },
    { value: '4', label: '4 col.' }
  ];
  var _defDisp = (typeof defaultDisplay !== 'undefined') ? defaultDisplay : '3';
%>
<div class="filter-block filter-block--base" id="<%= _bid %>">
  <div class="wiki-filter-section">
    <div class="filter-base-search-wrap">
      <input type="search" id="<%= _sid %>" class="wiki-tag-search-input filter-base-search"
        placeholder="Rechercher…" autocomplete="off" />
      <button type="button" class="filter-base-clear" id="<%= _sid %>-clear"
        hidden aria-label="Effacer">×</button>
    </div>
  </div>

  <% if (_srt || _disp) { %>
  <div class="wiki-filter-section filter-base-row">
    <% if (_srt) { %>
    <select id="<%= _srtId %>" class="filter-base-select" data-default="<%= _defSrt %>">
      <% _srtOpts.forEach(function(o) { %>
        <option value="<%= o.value %>"<%= o.value === _defSrt ? ' selected' : '' %>><%= o.label %></option>
      <% }) %>
    </select>
    <% } %>
    <% if (_disp) { %>
    <select id="<%= _dispId %>" class="filter-base-select" data-default="<%= _defDisp %>">
      <% _dispOpts.forEach(function(o) { %>
        <option value="<%= o.value %>"<%= o.value === _defDisp ? ' selected' : '' %>><%= o.label %></option>
      <% }) %>
    </select>
    <% } %>
  </div>
  <% } %>

  <% if (_type) { %>
  <div class="wiki-filter-section filter-type-row">
    <button type="button" class="tag-chip filter-type-btn" data-type="ultra"      data-state="0">Ultra</button>
    <button type="button" class="tag-chip filter-type-btn" data-type="irrealiste" data-state="0">Irréaliste</button>
    <% if (_objet) { %>
    <button type="button" class="tag-chip filter-type-btn" data-type="objet"      data-state="0">Objets</button>
    <% } %>
  </div>
  <% } %>
</div>

<script>
(function () {
  var block  = document.getElementById('<%= _bid %>');
  var input  = document.getElementById('<%= _sid %>');
  var clear  = document.getElementById('<%= _sid %>-clear');
  var sortEl = document.getElementById('<%= _srtId %>');
  var dispEl = document.getElementById('<%= _dispId %>');
  if (!block || !input) return;

  var _debounce;

  function getTypes() {
    var t = {};
    block.querySelectorAll('.filter-type-btn').forEach(function (btn) {
      t[btn.dataset.type] = Number(btn.dataset.state) || 0;
    });
    return t;
  }

  function dispatch() {
    block.dispatchEvent(new CustomEvent('filterbase:change', {
      bubbles: true,
      detail: {
        search:  input.value.trim(),
        sort:    sortEl ? sortEl.value : null,
        display: dispEl ? dispEl.value : null,
        types:   getTypes()
      }
    }));
  }

  // Initialise les types depuis les préférences compte (window.ULTRA_MODE etc.)
  block.querySelectorAll('.filter-type-btn').forEach(function (btn) {
    var s = 0;
    if (btn.dataset.type === 'ultra'      && window.ULTRA_MODE      === 'hidden') s = 2;
    if (btn.dataset.type === 'irrealiste' && window.IRREALISTE_MODE === 'hidden') s = 2;
    btn.dataset.state = String(s);
    btn.classList.toggle('chip-include', s === 1);
    btn.classList.toggle('chip-exclude', s === 2);
  });

  // Recherche
  input.addEventListener('input', function () {
    clear.hidden = !input.value;
    clearTimeout(_debounce);
    _debounce = setTimeout(dispatch, 220);
  });
  clear.addEventListener('click', function () {
    input.value = ''; clear.hidden = true; dispatch();
  });

  // Tri / Affichage
  if (sortEl) sortEl.addEventListener('change', dispatch);
  if (dispEl) dispEl.addEventListener('change', dispatch);

  // Type (3 états)
  block.querySelectorAll('.filter-type-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var s = ((Number(btn.dataset.state) || 0) + 1) % 3;
      btn.dataset.state = String(s);
      btn.classList.toggle('chip-include', s === 1);
      btn.classList.toggle('chip-exclude', s === 2);
      dispatch();
    });
  });

  // Réinitialisation exposée sur l'élément block
  block._reset = function () {
    input.value = ''; clear.hidden = true;
    if (sortEl) sortEl.value = sortEl.dataset.default || sortEl.options[0].value;
    if (dispEl) dispEl.value = dispEl.dataset.default || dispEl.options[0].value;
    block.querySelectorAll('.filter-type-btn').forEach(function (btn) {
      var s = 0;
      if (btn.dataset.type === 'ultra'      && window.ULTRA_MODE      === 'hidden') s = 2;
      if (btn.dataset.type === 'irrealiste' && window.IRREALISTE_MODE === 'hidden') s = 2;
      btn.dataset.state = String(s);
      btn.classList.toggle('chip-include', s === 1);
      btn.classList.toggle('chip-exclude', s === 2);
    });
    dispatch();
  };

  // Dispatch initial différé : les <script> des partials s'exécutent avant
  // le script principal de la page — setTimeout(0) garantit que les listeners
  // sont attachés quand ce premier événement arrive.
  setTimeout(dispatch, 0);
})();
</script>
