<%
/*  Filtre tags (3 états include/exclude) — délègue à filter-chips.ejs.
 *  Paramètres : filterId, tags, label?, maxTags?, counts?
 *  Événement : 'tagfilter:change' → { filterId, included:[], excluded:[] }
 */
  var _fid   = filterId;
  var _items = tags || [];
  var _label = (typeof label   !== 'undefined') ? label   : 'Tags';
  var _max   = (typeof maxTags !== 'undefined') ? maxTags : 40;
  var _cnt   = (typeof counts  !== 'undefined') ? counts  : null;
%>
<%- include('filter-chips', {
      filterId:  _fid,
      items:     _items,
      itemKey:   'tag',
      chipClass: 'wiki-tag-chip',
      label:     _label,
      mode:      'multi',
      eventName: 'tagfilter:change',
      counts:    _cnt,
      maxItems:  _max
    }) %>
