<%
/*  Partial : filtre tags (3 états + recherche)
 *
 *  Paramètres :
 *    filterId    {string}  ID du conteneur (requis)
 *    tags        {Array}   liste de tags   (requis)
 *    label       {string}  libellé                   (défaut 'Tags')
 *    maxTags     {number}  limite d'affichage         (défaut 40)
 *    counts      {object}  { tag: count }             (optionnel)
 *    placeholder {string}  placeholder recherche      (défaut 'Chercher…')
 *
 *  Événement émis (bubbles) :
 *    'tagfilter:change'  →  { filterId, included:[], excluded:[] }
 *
 *  Méthode DOM :
 *    block._reset()
 */
  var _fid  = filterId;
  var _tags = tags || [];
  var _label= (typeof label       !== 'undefined') ? label       : 'Tags';
  var _max  = (typeof maxTags     !== 'undefined') ? maxTags     : 40;
  var _cnt  = (typeof counts      !== 'undefined') ? counts      : null;
  var _ph   = (typeof placeholder !== 'undefined') ? placeholder : 'Chercher…';
%>
<% if (_tags.length) { %>
<div class="filter-block filter-block--tags" id="<%= _fid %>-block">
  <div class="wiki-filter-section">
    <% if (_label) { %><p class="wiki-filter-label" style="text-align:center"><%= _label %></p><% } %>
    <input type="search" id="<%= _fid %>-search" class="wiki-tag-search-input"
      placeholder="<%= _ph %>" autocomplete="off" />
    <div class="wiki-tag-cloud" id="<%= _fid %>">
      <% _tags.slice(0, _max).forEach(function(t) { %>
        <button type="button" class="wiki-tag-chip" data-tag="<%= t %>" data-state="0">
          <span class="wtc-label"><%= t %></span><%
          if (_cnt && _cnt[t]) { %><span class="wtc-count"><%= _cnt[t] %></span><% } %>
        </button>
      <% }) %>
    </div>
  </div>
</div>

<script>
(function () {
  var block  = document.getElementById('<%= _fid %>-block');
  var cloud  = document.getElementById('<%= _fid %>');
  var search = document.getElementById('<%= _fid %>-search');
  if (!block || !cloud) return;

  function dispatch() {
    var included = [], excluded = [];
    cloud.querySelectorAll('.wiki-tag-chip').forEach(function (chip) {
      if (chip.dataset.state === '1') included.push(chip.dataset.tag);
      else if (chip.dataset.state === '2') excluded.push(chip.dataset.tag);
    });
    block.dispatchEvent(new CustomEvent('tagfilter:change', {
      bubbles: true,
      detail: { filterId: '<%= _fid %>', included: included, excluded: excluded }
    }));
  }

  cloud.addEventListener('click', function (e) {
    var chip = e.target.closest('.wiki-tag-chip');
    if (!chip) return;
    var s = ((Number(chip.dataset.state) || 0) + 1) % 3;
    chip.dataset.state = String(s);
    chip.classList.toggle('chip-include', s === 1);
    chip.classList.toggle('chip-exclude', s === 2);
    dispatch();
  });

  if (search) {
    search.addEventListener('input', function () {
      var q = search.value.trim().toLowerCase();
      cloud.querySelectorAll('.wiki-tag-chip').forEach(function (chip) {
        // Ne jamais masquer un chip actif (état ≠ 0)
        chip.hidden = chip.dataset.state === '0' && q.length > 0
          && chip.dataset.tag.toLowerCase().indexOf(q) === -1;
      });
    });
  }

  block._reset = function () {
    if (search) search.value = '';
    cloud.querySelectorAll('.wiki-tag-chip').forEach(function (chip) {
      chip.dataset.state = '0';
      chip.classList.remove('chip-include', 'chip-exclude');
      chip.hidden = false;
    });
    dispatch();
  };
})();
</script>
<% } %>
