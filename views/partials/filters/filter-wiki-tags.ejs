<%
/*  Partial HTML-only : nuage de tags du Codex (avec bouton "Plus" + lien "Tous").
 *  Aucun JS ici — wiki.js attache ses propres listeners sur ces IDs.
 *
 *  IDs fixes attendus par wiki.js :
 *    wiki-tag-search       input recherche dans les tags
 *    wiki-tag-filter       conteneur des chips
 *    wiki-tag-expand-btn   bouton ▾ Plus
 *    wiki-tag-all-link     lien "Tous les tags"
 *
 *  Paramètres :
 *    tags       {Array}   liste de tags      (requis)
 *    counts     {object}  { tag: nombre }    (optionnel)
 */
  var _tags  = (typeof tags   !== 'undefined') ? tags   : [];
  var _cnts  = (typeof counts !== 'undefined') ? counts : null;
%>
<% if (_tags.length) { %>
<div class="wiki-filter-section">
  <input type="search" id="wiki-tag-search" class="wiki-tag-search-input"
    placeholder="Chercher un tag" autocomplete="off" />
  <div class="wiki-tag-cloud" id="wiki-tag-filter">
    <% _tags.forEach(function(t) { %>
      <button type="button" class="wiki-tag-chip" data-tag="<%= t %>" data-state="0">
        <span class="wtc-label"><%= t %></span><%
        if (_cnts && _cnts[t]) { %><span class="wtc-count"><%= _cnts[t] %></span><% } %>
      </button>
    <% }) %>
  </div>
  <div class="wiki-tag-footer">
    <button type="button" id="wiki-tag-expand-btn" class="wiki-tag-expand-btn" hidden>&#9660; Plus</button>
    <a href="/tags" class="wiki-tag-all-link" id="wiki-tag-all-link" hidden>Tous les tags</a>
  </div>
</div>
<% } %>
