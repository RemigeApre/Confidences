<%
  /* ── Sélecteur de tags par catégorie (compact) ────────────────────────
     Remplace le champ libre (.wiki-tags-widget) pour Images/BD/Histoires.
     Un champ par catégorie (tags généraux + Femme/Homme/Vêtement/Position/
     Lieu/Objet), peu importe les sous-catégories — chaque champ est une
     simple petite board à puces + saisie, comme l'ancien champ libre.
     Attend en locals :
       currentTags : tableau de tags déjà présents (ultra/irréaliste/en
                     couleur déjà retirés par l'appelant, ce sont des
                     checkboxes séparées)
       groups      : résultat de db.getTagsGroupedByCategory()
     Le contrat de sortie ne change pas : un seul <input type="hidden"
     name="tags"> contenant une liste séparée par des virgules — les
     routes de sauvegarde (gallery.js/bd.js/nouvelles.js) n'ont donc
     rien à changer. ── */
  var ctwOrder = [
    ['femme',      'Femme'],
    ['homme',      'Homme'],
    ['vetement',   'Vêtement'],
    ['rapport',    'Position'],
    ['pointdevue', 'Point de vue'],
    ['lieu',       'Lieu'],
    ['esthetique', 'Esthétique'],
    ['objet',      'Objet'],
  ];

  // Tags déjà connus (rattachés à une des catégories ci-dessus, ou à
  // "autre") — tout le reste présent sur le contenu (ex. catégorie
  // "relation", ou tag jamais catégorisé) part dans "Tags généraux".
  var ctwAvailable = {};
  var ctwCurrentByCat = {};
  ctwOrder.forEach(function (pair) {
    var g = groups[pair[0]];
    ctwAvailable[pair[0]] = g ? g.tags.map(function (t) { return t.tag; }) : [];
  });
  var ctwKnown = {};
  ctwOrder.forEach(function (pair) {
    (ctwAvailable[pair[0]] || []).forEach(function (t) { ctwKnown[t] = pair[0]; });
  });
  ((groups.autre || {}).tags || []).forEach(function (t) { ctwKnown[t.tag] = 'autre'; });
  ctwAvailable.autre = ((groups.autre || {}).tags || []).map(function (t) { return t.tag; });

  (currentTags || []).forEach(function (t) {
    var cat = ctwKnown[t] || 'autre';
    if (!ctwCurrentByCat[cat]) ctwCurrentByCat[cat] = [];
    ctwCurrentByCat[cat].push(t);
  });
%>
<div class="cat-tags-widget">
  <input type="hidden" name="tags" class="ctw-hidden" value="<%= (currentTags || []).join(', ') %>" />

  <div class="ctw-toolbar">
    <button type="button" class="ctw-tool-btn ctw-copy-btn">Copier les tags</button>
    <button type="button" class="ctw-tool-btn ctw-import-btn">Importer</button>
  </div>

  <div class="ctw-field ctw-field--general" data-cat="autre">
    <label class="ctw-field-label">Tags g&eacute;n&eacute;raux</label>
    <div class="wiki-tags-board ctw-board">
      <div class="wiki-tags-chips"></div>
      <input type="text" class="wiki-tags-typing" placeholder="Ajouter&hellip;" autocomplete="off" />
    </div>
  </div>

  <% ctwOrder.forEach(function (pair) { %>
    <% var catKey = pair[0]; var catLabel = (groups[catKey] || {}).label || pair[1]; %>
    <div class="ctw-field" data-cat="<%= catKey %>">
      <label class="ctw-field-label"><%= catLabel %></label>
      <div class="wiki-tags-board ctw-board">
        <div class="wiki-tags-chips"></div>
        <input type="text" class="wiki-tags-typing" placeholder="Ajouter&hellip;" autocomplete="off" />
      </div>
    </div>
  <% }) %>

  <script type="application/json" class="ctw-data"><%- JSON.stringify({ available: ctwAvailable, current: ctwCurrentByCat, categoryOf: ctwKnown }) %></script>
</div>
