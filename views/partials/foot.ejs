%>
<% if (!currentUser.hideInviteCta && inviteToken && !_fabHidePath) { %>
<%# ── CTA flottant "Invitez vos amis" ────────────────────────────── %>
<button class="invite-cta-fab" id="invite-cta-fab" aria-label="Inviter des amis">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
  <span>Inviter</span>
</button>

<div class="invite-cta-backdrop" id="invite-cta-backdrop" hidden></div>
<div class="invite-cta-popup" id="invite-cta-popup" role="dialog" aria-modal="true" aria-label="Lien d'invitation" hidden>
  <button class="invite-cta-popup-close" id="invite-cta-close" aria-label="Fermer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <p class="invite-cta-popup-title">Invitez vos amis</p>
  <p class="invite-cta-popup-sub">Partagez ce lien pour qu'ils rejoignent le site.</p>
  <div class="invite-cta-link-row">
    <input class="invite-cta-link-input" id="invite-cta-link" type="text" readonly />
    <button class="invite-cta-copy-btn" id="invite-cta-copy">Copier</button>
  </div>
  <button class="invite-cta-disable-btn" id="invite-cta-disable">Ne plus afficher</button>
</div>

<script nonce="<%= nonce %>">
(function () {
  var fab      = document.getElementById('invite-cta-fab');
  var popup    = document.getElementById('invite-cta-popup');
  var backdrop = document.getElementById('invite-cta-backdrop');
  var closeBtn = document.getElementById('invite-cta-close');
  var copyBtn  = document.getElementById('invite-cta-copy');
  var linkInput = document.getElementById('invite-cta-link');
  var disableBtn = document.getElementById('invite-cta-disable');

  var token = <%- JSON.stringify(inviteToken) %>;
  var link  = window.location.origin + '/rejoindre/' + token;
  if (linkInput) linkInput.value = link;

  function openPopup() {
    popup.removeAttribute('hidden');
    backdrop.removeAttribute('hidden');
  }
  function closePopup() {
    popup.setAttribute('hidden', '');
    backdrop.setAttribute('hidden', '');
  }

  if (fab)      fab.addEventListener('click', openPopup);
  if (closeBtn) closeBtn.addEventListener('click', closePopup);
  if (backdrop) backdrop.addEventListener('click', closePopup);

  if (copyBtn && linkInput) {
    copyBtn.addEventListener('click', function () {
      linkInput.select();
      navigator.clipboard.writeText(link).catch(function () {});
      copyBtn.textContent = 'Copié !';
      setTimeout(function () { copyBtn.textContent = 'Copier'; }, 2000);
    });
  }

  if (disableBtn) {
    disableBtn.addEventListener('click', function () {
      fetch('/favoris/parametres', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hideInviteCta: true })
      }).catch(function () {});
      if (fab) fab.remove();
      closePopup();
    });
  }
})();
</script>
<% } %>

<% } %>

<%# ── Popup "Envoyer à un ami" (global, disponible sur toutes les pages) ── %>
<% if (currentUser && locals.inviteToken) { %>
<div class="share-popup-backdrop" id="share-popup-backdrop" hidden aria-hidden="true"></div>
<div class="share-popup" id="share-popup" hidden role="dialog" aria-modal="true" aria-label="Envoyer à un ami">
  <div class="share-popup-head">
    <span class="share-popup-title">Envoyer à</span>
    <button class="share-popup-close" id="share-popup-close" type="button" aria-label="Fermer">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="4" x2="4" y2="12"/><line x1="4" y1="4" x2="12" y2="12"/></svg>
    </button>
  </div>
  <div class="share-popup-ref-preview" id="share-popup-ref-preview"></div>
  <ul class="share-popup-friends" id="share-popup-friends"></ul>
  <p class="share-popup-status" id="share-popup-status" hidden></p>
</div>

<script nonce="<%= nonce %>">
// ── Popup de partage global ──────────────────────────────────────────────
(function () {
  'use strict';

  var _currentRef = null; // { type, id, title }
  var _friends = null;

  async function openSharePopup(ref) {
    _currentRef = ref;
    var backdrop = document.getElementById('share-popup-backdrop');
    var popup    = document.getElementById('share-popup');
    var preview  = document.getElementById('share-popup-ref-preview');
    var list     = document.getElementById('share-popup-friends');
    var status   = document.getElementById('share-popup-status');

    // Aperçu du contenu
    var typeLabel = { image: 'Image', bd: 'BD', wiki: 'Codex' }[ref.type] || ref.type;
    preview.innerHTML = '<span class="share-popup-ref-type">' + typeLabel + '</span>' +
                        '<span class="share-popup-ref-title">' + escHtml(ref.title || '') + '</span>';

    status.hidden = true;
    list.innerHTML = '<li class="share-popup-loading">Chargement\u2026</li>';
    backdrop.hidden = false;
    popup.hidden = false;

    // Charger amis si nécessaire
    if (!_friends) {
      var fr = await fetch('/messages/friends', { headers: { 'Accept': 'application/json' } });
      var fd = await fr.json();
      _friends = fd.friends;
    }

    list.innerHTML = '';
    if (!_friends || !_friends.length) {
      list.innerHTML = '<li class="share-popup-empty">Aucun ami pour l&rsquo;instant.</li>';
      return;
    }
    _friends.forEach(function (f) {
      var li = document.createElement('li');
      li.className = 'share-popup-friend';
      li.innerHTML =
        '<div class="share-popup-avatar" style="background:' + (f.profileColor || '#6b7280') + '">' +
          escHtml((f.displayName || '?').charAt(0).toUpperCase()) +
        '</div>' +
        '<span class="share-popup-fname">' + escHtml(f.displayName) + '</span>';
      li.addEventListener('click', function () { sendShare(f); });
      list.appendChild(li);
    });
  }

  async function sendShare(friend) {
    var status = document.getElementById('share-popup-status');
    var list   = document.getElementById('share-popup-friends');
    status.hidden = false;
    status.textContent = 'Envoi\u2026';
    list.querySelectorAll('.share-popup-friend').forEach(function (el) { el.style.pointerEvents = 'none'; });
    try {
      var r = await fetch('/messages/' + friend.id + '/share', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: _currentRef.type, id: _currentRef.id, title: _currentRef.title || '' }),
      });
      var d = await r.json();
      if (d.ok) {
        status.textContent = 'Envoy\u00e9 \u00e0 ' + friend.displayName + ' !';
        setTimeout(closeSharePopup, 1200);
      } else {
        status.textContent = 'Erreur lors de l\'envoi.';
        list.querySelectorAll('.share-popup-friend').forEach(function (el) { el.style.pointerEvents = ''; });
      }
    } catch (e) {
      status.textContent = 'Erreur.';
      list.querySelectorAll('.share-popup-friend').forEach(function (el) { el.style.pointerEvents = ''; });
    }
  }

  function closeSharePopup() {
    var backdrop = document.getElementById('share-popup-backdrop');
    var popup    = document.getElementById('share-popup');
    if (backdrop) backdrop.hidden = true;
    if (popup) popup.hidden = true;
  }

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // Fermeture
  document.getElementById('share-popup-close')?.addEventListener('click', closeSharePopup);
  document.getElementById('share-popup-backdrop')?.addEventListener('click', closeSharePopup);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeSharePopup(); });

  // ── API publique — appelée par les boutons de partage dans les pages ─────
  window.openSharePopup = openSharePopup;
})();
</script>
<% } %>

<% if (currentUser && locals.inviteToken) { %>
<script nonce="<%= nonce %>">
// Délégation des boutons .share-trigger-btn (wiki, bd — pas gallery qui gère seul)
document.addEventListener('click', function (e) {
  var btn = e.target.closest('.share-trigger-btn');
  if (!btn || !window.openSharePopup) return;
  window.openSharePopup({
    type:  btn.dataset.shareType,
    id:    Number(btn.dataset.shareId),
    title: btn.dataset.shareTitle || '',
  });
});
</script>
<% } %>

</body>
</html>
