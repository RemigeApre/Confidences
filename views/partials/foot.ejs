<script nonce="<%= nonce %>">
(function(){
  function getLang() { return localStorage.getItem('slang') === 'en' ? 'en' : 'fr'; }

  function applyLang(lang) {
    document.querySelectorAll('[data-fr]').forEach(function(el) {
      // Ne jamais écraser un élément qui a des enfants HTML (SVG, spans…)
      if (el.children.length) return;
      el.textContent = lang === 'en' ? el.dataset.en : el.dataset.fr;
    });
    document.querySelectorAll('[data-placeholder-fr]').forEach(function(el) {
      el.placeholder = lang === 'en' ? (el.dataset.placeholderEn || '') : el.dataset.placeholderFr;
    });
    document.documentElement.setAttribute('data-lang', lang);
  }

  applyLang(getLang());

  function toggleLang() {
    var next = getLang() === 'en' ? 'fr' : 'en';
    localStorage.setItem('slang', next);
    applyLang(next);
    fetch('/set-lang', {
      method: 'POST',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: 'lang=' + next
    });
  }

  var btn = document.getElementById('pc-lang-btn');
  if (btn) btn.addEventListener('click', toggleLang);

  document.querySelectorAll('[data-lang-toggle]').forEach(function(b) {
    b.addEventListener('click', toggleLang);
  });

  // Bouton filtre dans le header mobile : actif uniquement si la page a un sidebar filtre
  var mFilterHeader = document.getElementById('mobile-filter-toggle-header');
  if (mFilterHeader && document.getElementById('mobile-filter-sidebar')) {
    mFilterHeader.removeAttribute('hidden');
    // Délègue au bouton filtre original (déjà câblé dans nav.js)
    var origToggle = document.getElementById('mobile-filter-toggle');
    mFilterHeader.addEventListener('click', function() {
      if (origToggle) origToggle.click();
    });
  }
})();
</script>

<% if (currentUser) { %>
<%# ── Charme actif : injection du symbole pour JS ─────────────── %>
<% var _charmMap      = { star:'★', heart:'♥', diamond:'◆', bolt:'⚡', flower:'✿', sparkle:'✦', crown:'♛', clover:'♣', spade:'♠', drop:'▼', sun:'☀', square:'■', triangle:'▲', pentagon:'⬟', skull:'☠' }; %>
<% var _charmEmptyMap = { star:'☆', heart:'♡', diamond:'◇', bolt:'✧', flower:'✾', sparkle:'✧', crown:'♕', clover:'♧', spade:'♤', drop:'▽', sun:'☼', square:'□', triangle:'△', pentagon:'⬠', skull:'⊗' }; %>
<% var _charmSym      = _charmMap[currentUser.ratingCharm]      || null; %>
<% var _charmSymEmpty = _charmEmptyMap[currentUser.ratingCharm] || null; %>
<% if (_charmSym) { %>
<script nonce="<%= nonce %>">
window.RATING_CHARM = { key: <%- JSON.stringify(currentUser.ratingCharm) %>, symbol: <%- JSON.stringify(_charmSym) %>, symbolEmpty: <%- JSON.stringify(_charmSymEmpty) %> };
(function() {
  var sym  = window.RATING_CHARM.symbol;
  var symE = window.RATING_CHARM.symbolEmpty || sym;
  var SEL  = '.gallery-star,.bd-star,.wiki-star,.wiki-card-star,.bd-card-star';
  function patchStars() {
    document.querySelectorAll(SEL).forEach(function(el) {
      el.textContent = el.classList.contains('filled') ? sym : symE;
    });
  }
  // Observe future class changes (toggling filled/unfilled when user rates)
  document.addEventListener('click', function() {
    requestAnimationFrame(function() {
      document.querySelectorAll(SEL).forEach(function(el) {
        el.textContent = el.classList.contains('filled') ? sym : symE;
      });
    });
  }, true);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', patchStars);
  else patchStars();
})();
</script>
<% } %>
