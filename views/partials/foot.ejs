<script nonce="<%= nonce %>">
(function () {
  var fab = document.getElementById('msg-widget-fab');
  if (!fab) return;
  var panel       = document.getElementById('msg-widget-panel');
  var closeBtn    = document.getElementById('msg-widget-close');
  var backBtn     = document.getElementById('msg-widget-back');
  var expandBtn   = document.getElementById('msg-widget-expand');
  var titleEl     = document.getElementById('msg-widget-title');
  var list        = document.getElementById('msg-widget-list');
  var emptyMsg    = document.getElementById('msg-widget-empty');
  var threadView  = document.getElementById('msg-widget-thread');
  var compose     = document.getElementById('msg-widget-compose');
  var composeInput = document.getElementById('msg-widget-compose-input');
  var badge       = document.getElementById('msg-widget-fab-badge');

  var myId = <%- JSON.stringify(currentUser.id) %>;
  var activePartnerId = null;
  var pollTimer = null;
  var lastRenderedId = 0;

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function stopPolling() {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  }

  function updateBadge(n) {
    if (!badge) return;
    if (n > 0) { badge.textContent = n > 99 ? '99+' : String(n); badge.hidden = false; }
    else { badge.hidden = true; }
  }

  function showList() {
    stopPolling();
    activePartnerId = null;
    backBtn.hidden = true;
    expandBtn.setAttribute('href', '/messages');
    titleEl.textContent = 'Messages';
    threadView.hidden = true;
    compose.hidden = true;
    list.hidden = false;
    loadList();
  }

  async function loadList() {
    try {
      var r = await fetch('/messages/widget/list');
      var data = await r.json();
      renderList(data.convs || []);
    } catch (_) {}
  }

  function renderList(convs) {
    list.innerHTML = '';
    emptyMsg.hidden = !!convs.length;
    var totalUnread = 0;
    convs.forEach(function (c) {
      totalUnread += (c.unread || 0);
      var li = document.createElement('li');
      li.className = 'msg-widget-list-item';
      var avatarHtml = c.partnerAvatarThumb
        ? '<span class="msg-widget-avatar msg-widget-avatar--img"><img src="' + escHtml(c.partnerAvatarThumb) + '" alt=""></span>'
        : '<span class="msg-widget-avatar" style="background:' + escHtml(c.partnerColor || '#6b7280') + '">' + escHtml((c.partnerName || '?').charAt(0).toUpperCase()) + '</span>';
      li.innerHTML = avatarHtml +
        '<span class="msg-widget-list-name">' + escHtml(c.partnerName) + '</span>' +
        (c.unread > 0 ? '<span class="msg-widget-list-badge">' + c.unread + '</span>' : '');
      li.addEventListener('click', function () { openThread(c.partnerId, c.partnerName); });
      list.appendChild(li);
    });
    updateBadge(totalUnread);
  }

  async function openThread(partnerId, partnerName) {
    activePartnerId = partnerId;
    lastRenderedId = 0;
    backBtn.hidden = false;
    expandBtn.setAttribute('href', '/messages/' + partnerId);
    titleEl.textContent = partnerName || '…';
    list.hidden = true;
    threadView.hidden = false;
    compose.hidden = false;
    await loadThread();
    stopPolling();
    pollTimer = setInterval(loadThread, 5000);
  }

  async function loadThread() {
    if (!activePartnerId) return;
    try {
      var r = await fetch('/messages/widget/thread/' + activePartnerId);
      var data = await r.json();
      if (!data.messages) return;
      var lastId = data.messages.length ? data.messages[data.messages.length - 1].id : 0;
      if (lastId === lastRenderedId && threadView.childElementCount) return;
      lastRenderedId = lastId;
      threadView.innerHTML = '';
      data.messages.forEach(function (m) {
        var bubble = document.createElement('div');
        bubble.className = 'msg-widget-bubble ' + (m.senderId === myId ? 'msg-widget-bubble--me' : 'msg-widget-bubble--them');
        bubble.innerHTML = escHtml(m.text).replace(/\n/g, '<br>') + (m.reaction ? ' <span class="msg-widget-bubble-reaction">' + m.reaction + '</span>' : '');
        threadView.appendChild(bubble);
      });
      threadView.scrollTop = threadView.scrollHeight;
    } catch (_) {}
  }

  if (compose) {
    compose.addEventListener('submit', async function (e) {
      e.preventDefault();
      var text = composeInput.value.trim();
      if (!text || !activePartnerId) return;
      composeInput.value = '';
      try {
        await fetch('/messages/' + activePartnerId, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: text }),
        });
      } catch (_) {}
      lastRenderedId = 0;
      await loadThread();
    });
  }

  function openPanel() { panel.hidden = false; showList(); }
  function closePanel() { panel.hidden = true; stopPolling(); }

  fab.addEventListener('click', function () {
    if (panel.hidden) openPanel(); else closePanel();
  });
  if (closeBtn) closeBtn.addEventListener('click', closePanel);
  if (backBtn) backBtn.addEventListener('click', showList);

  document.addEventListener('click', function (e) {
    if (panel.hidden) return;
    if (panel.contains(e.target) || fab.contains(e.target)) return;
    closePanel();
  });
})();
</script>
<% } %>

<% } %>

