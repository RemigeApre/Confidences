<%# Bouton "Filtres" mobile : ouvre en tiroir depuis la gauche le volet
    filtre portant id="mobile-filter-sidebar" (une seule fois par page,
    jamais deux volets simultanés — voir wiki-index.ejs/wiki.ejs/gallery.ejs).
    Masqué sur desktop, où le volet reste fixe comme avant (voir style.css).
    Toggle générique dans public/nav.js. %>
<button type="button" class="mobile-filter-toggle" id="mobile-filter-toggle" aria-label="Ouvrir les filtres" aria-expanded="false" aria-controls="mobile-filter-sidebar">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
  <span>Filtres</span>
</button>
<div class="nav-backdrop" id="mobile-filter-backdrop"></div>
