<% if (!currentUser) { %>
<div id="age-gate-overlay" class="age-gate-overlay" aria-modal="true" role="dialog" aria-label="Avant d'entrer sur Confidences">
  <div class="age-gate-box">
    <button type="button" class="pc-lang-btn age-gate-lang-btn" data-lang-toggle title="Switch language" aria-label="Changer de langue">
      <svg class="flag-fr" width="22" height="15" viewBox="0 0 22 15" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="7" height="15" fill="#002395"/><rect x="7" width="8" height="15" fill="#fff"/><rect x="15" width="7" height="15" fill="#ED2939"/>
      </svg>
      <svg class="flag-en" width="22" height="15" viewBox="0 0 22 15" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="22" height="15" fill="#012169"/>
        <path d="M0,0 L22,15 M22,0 L0,15" stroke="#fff" stroke-width="3.2"/>
        <rect x="9.5" width="3" height="15" fill="#fff"/><rect y="6" width="22" height="3" fill="#fff"/>
        <rect x="10" width="2" height="15" fill="#C8102E"/><rect y="6.5" width="22" height="2" fill="#C8102E"/>
      </svg>
    </button>

    <div class="age-gate-slide" id="age-gate-slide-1" data-slide="1">
      <h2 class="age-gate-title" data-fr="La porte" data-en="The Door">La porte</h2>
      <p class="age-gate-body" data-fr="Confidences est un site exploratif sur la sexualit&eacute;&nbsp;: confirmez-vous &ecirc;tre majeur dans votre pays de r&eacute;sidence&nbsp;?" data-en="Confidences is an exploratory site about sexuality: do you confirm you are of legal age in your country of residence?">Confidences est un site exploratif sur la sexualit&eacute;&nbsp;: confirmez-vous &ecirc;tre majeur dans votre pays de r&eacute;sidence&nbsp;?</p>
      <% if (isFrenchVisitor) { %>
      <p class="age-gate-notice" data-fr="Si votre IP est localis&eacute;e en France, vous n&rsquo;aurez pas acc&egrave;s aux contenus explicites. Pour y avoir acc&egrave;s, un compte nominatif sera &agrave; faire cr&eacute;er, dans une proc&eacute;dure qui confirme votre &acirc;ge. Pour cela, votre pi&egrave;ce d&rsquo;identit&eacute; sera obligatoire. Nous en sommes d&eacute;sol&eacute;s." data-en="If your IP is located in France, you will not have access to explicit content. To gain access, a personal account will need to be created, through a procedure that confirms your age. Your ID document will be required for this. We're sorry about this.">Si votre IP est localis&eacute;e en France, vous n&rsquo;aurez pas acc&egrave;s aux contenus explicites. Pour y avoir acc&egrave;s, un compte nominatif sera &agrave; faire cr&eacute;er, dans une proc&eacute;dure qui confirme votre &acirc;ge. Pour cela, votre pi&egrave;ce d&rsquo;identit&eacute; sera obligatoire. Nous en sommes d&eacute;sol&eacute;s.</p>
      <% } %>
      <p class="age-gate-notice age-gate-notice--muted" data-fr="Sur les cookies&nbsp;: vos choix et r&eacute;ponses sur ces &eacute;crans sont enregistr&eacute;s via des cookies, uniquement pour adapter votre exp&eacute;rience sur le site. Rien d&rsquo;autre n&rsquo;en est fait." data-en="About cookies: your choices and answers on these screens are stored using cookies, solely to adapt your experience on the site. Nothing else is done with them.">Sur les cookies&nbsp;: vos choix et r&eacute;ponses sur ces &eacute;crans sont enregistr&eacute;s via des cookies, uniquement pour adapter votre exp&eacute;rience sur le site. Rien d&rsquo;autre n&rsquo;en est fait.</p>
      <div class="age-gate-actions">
        <button type="button" class="age-gate-btn age-gate-btn--no" id="age-gate-no" data-fr="Non, je quitte" data-en="No, I'm leaving">Non, je quitte</button>
        <button type="button" class="age-gate-btn age-gate-btn--yes" id="age-gate-yes" data-fr="Oui, et je suis d&rsquo;accord" data-en="Yes, and I agree">Oui, et je suis d&rsquo;accord</button>
      </div>
    </div>

    <div class="age-gate-slide" id="age-gate-slide-2" data-slide="2" hidden>
      <h2 class="age-gate-title" data-fr="Comprendre un fantasme" data-en="Understanding a fantasy">Comprendre un fantasme</h2>
      <p class="age-gate-body" data-fr="Pour aborder la sexualit&eacute; de mani&egrave;re saine, il est utile de distinguer ce que l&rsquo;on d&eacute;sire r&eacute;ellement de ce que l&rsquo;on fantasme. Confidences classe chaque fantasme en quatre cat&eacute;gories&nbsp;:" data-en="To approach sexuality in a healthy way, it helps to separate what you actually desire from what you merely fantasize about. Confidences classifies every fantasy into four categories:">Pour aborder la sexualit&eacute; de mani&egrave;re saine, il est utile de distinguer ce que l&rsquo;on d&eacute;sire r&eacute;ellement de ce que l&rsquo;on fantasme. Confidences classe chaque fantasme en quatre cat&eacute;gories&nbsp;:</p>
      <ul class="age-gate-cats">
        <li>
          <span class="age-gate-cats-num">I</span>
          <span class="age-gate-cats-text">
            <strong data-fr="Possible et consenti" data-en="Possible and consensual">Possible et consenti</strong>
            <span data-fr="&nbsp;: fait, ou &agrave; faire." data-en=": done, or to do.">&nbsp;: fait, ou &agrave; faire.</span>
          </span>
        </li>
        <li>
          <span class="age-gate-cats-num">II</span>
          <span class="age-gate-cats-text">
            <strong data-fr="Imaginaire" data-en="Imaginary">Imaginaire</strong>
            <span data-fr="&nbsp;: immoral, ill&eacute;gal, ou &agrave; ne pas faire." data-en=": immoral, illegal, or not to do.">&nbsp;: immoral, ill&eacute;gal, ou &agrave; ne pas faire.</span>
          </span>
        </li>
        <li>
          <span class="age-gate-cats-num">III</span>
          <span class="age-gate-cats-text">
            <strong data-fr="Impossible" data-en="Impossible">Impossible</strong>
            <span data-fr="&nbsp;: hors de la r&eacute;alit&eacute;." data-en=": outside of reality.">&nbsp;: hors de la r&eacute;alit&eacute;.</span>
          </span>
        </li>
        <li>
          <span class="age-gate-cats-num">IV</span>
          <span class="age-gate-cats-text">
            <strong data-fr="D&eacute;sint&eacute;r&ecirc;t" data-en="Disinterest">D&eacute;sint&eacute;r&ecirc;t</strong>
            <span data-fr="&nbsp;: n&rsquo;aime pas." data-en=": don't like.">&nbsp;: n&rsquo;aime pas.</span>
          </span>
        </li>
      </ul>
      <div class="age-gate-actions age-gate-actions--single">
        <button type="button" class="age-gate-btn age-gate-btn--yes" id="age-gate-continue-2" data-fr="Continuer" data-en="Continue">Continuer</button>
      </div>
    </div>

    <div class="age-gate-slide" id="age-gate-slide-3" data-slide="3" hidden>
      <h2 class="age-gate-title" data-fr="Nos r&egrave;gles" data-en="Our rules">Nos r&egrave;gles</h2>
      <ul class="age-gate-rules">
        <li data-fr="Aucun contenu p&eacute;dophile n&rsquo;est pr&eacute;sent&eacute; ici, sous quelque forme que ce soit." data-en="No content depicting minors is presented here, in any form whatsoever.">Aucun contenu p&eacute;dophile n&rsquo;est pr&eacute;sent&eacute; ici, sous quelque forme que ce soit.</li>
        <li data-fr="Aucune image de personne r&eacute;elle n&rsquo;est publi&eacute;e." data-en="No images of real people are published.">Aucune image de personne r&eacute;elle n&rsquo;est publi&eacute;e.</li>
        <li data-fr="Le consentement se donne librement et reste r&eacute;vocable &agrave; tout moment&nbsp;: un fantasme n&rsquo;est pas un accord." data-en="Consent is given freely and remains revocable at any time: a fantasy is not an agreement.">Le consentement se donne librement et reste r&eacute;vocable &agrave; tout moment&nbsp;: un fantasme n&rsquo;est pas un accord.</li>
        <li data-fr="L&rsquo;IA est une aide &agrave; la cr&eacute;ation. Les images suspect&eacute;es d&rsquo;avoir &eacute;t&eacute; cr&eacute;&eacute;es &agrave; partir d&rsquo;une personne r&eacute;elle (sans preuve) sont tagu&eacute;es et peuvent &ecirc;tre exclues&nbsp;; si une preuve est apport&eacute;e, l&rsquo;image est supprim&eacute;e du site." data-en="AI is a creative aid. Images suspected of being created from a real person (without proof) are tagged and may be excluded; if proof is provided, the image is removed from the site.">L&rsquo;IA est une aide &agrave; la cr&eacute;ation. Les images suspect&eacute;es d&rsquo;avoir &eacute;t&eacute; cr&eacute;&eacute;es &agrave; partir d&rsquo;une personne r&eacute;elle (sans preuve) sont tagu&eacute;es et peuvent &ecirc;tre exclues&nbsp;; si une preuve est apport&eacute;e, l&rsquo;image est supprim&eacute;e du site.</li>
        <li data-fr="Votre vie priv&eacute;e est centrale&nbsp;: vos donn&eacute;es ne sont ni revendues, ni partag&eacute;es." data-en="Your privacy is central: your data is never resold or shared.">Votre vie priv&eacute;e est centrale&nbsp;: vos donn&eacute;es ne sont ni revendues, ni partag&eacute;es.</li>
      </ul>
      <div class="age-gate-actions age-gate-actions--single">
        <button type="button" class="age-gate-btn age-gate-btn--yes" id="age-gate-continue-3" data-fr="Continuer" data-en="Continue">Continuer</button>
      </div>
    </div>

    <div class="age-gate-slide" id="age-gate-slide-4" data-slide="4" hidden>
      <h2 class="age-gate-title" data-fr="R&eacute;glages d&rsquo;affichage" data-en="Display settings">R&eacute;glages d&rsquo;affichage</h2>
      <p class="age-gate-body" data-fr="Confidences utilise deux marqueurs de contenu, Ultra et Irr&eacute;aliste. Choisissez comment les afficher&nbsp;: vous pourrez changer cela plus tard dans votre profil." data-en="Confidences uses two content markers, Ultra and Irrealistic. Choose how to display them: you'll be able to change this later in your profile.">Confidences utilise deux marqueurs de contenu, Ultra et Irr&eacute;aliste. Choisissez comment les afficher&nbsp;: vous pourrez changer cela plus tard dans votre profil.</p>

      <div class="age-gate-setting">
        <div class="age-gate-setting-label">
          <span data-fr="Ultra" data-en="Ultra">Ultra</span>
          <span class="profil-info-icon" tabindex="0" data-tip="Les contenus Ultra rassemblent les pratiques et fantasmes les plus extrêmes du codex." aria-label="Qu'est-ce qu'un contenu Ultra ?">!</span>
        </div>
        <div class="user-setting-options" id="age-gate-ultra-mode-options">
          <label class="user-setting-radio" data-val="hidden">
            <input type="radio" name="age-gate-ultra-mode" value="hidden" /> <span data-fr="Masqu&eacute; (bascule)" data-en="Hidden (toggle)">Masqu&eacute; (bascule)</span>
          </label>
          <label class="user-setting-radio" data-val="visible">
            <input type="radio" name="age-gate-ultra-mode" value="visible" /> <span data-fr="Visible" data-en="Visible">Visible</span>
          </label>
          <label class="user-setting-radio" data-val="off">
            <input type="radio" name="age-gate-ultra-mode" value="off" /> <span data-fr="D&eacute;sactiv&eacute;" data-en="Disabled">D&eacute;sactiv&eacute;</span>
          </label>
        </div>
      </div>

      <div class="age-gate-setting">
        <div class="age-gate-setting-label">
          <span data-fr="Irr&eacute;aliste" data-en="Irrealistic">Irr&eacute;aliste</span>
          <span class="profil-info-icon" tabindex="0" data-tip="Les contenus Irréaliste relèvent de scénarios impossibles : davantage le fantasme pur que le réalisable." aria-label="Qu'est-ce qu'un contenu Irréaliste ?">!</span>
        </div>
        <div class="user-setting-options" id="age-gate-irrealiste-mode-options">
          <label class="user-setting-radio" data-val="hidden">
            <input type="radio" name="age-gate-irrealiste-mode" value="hidden" /> <span data-fr="Masqu&eacute; (bascule)" data-en="Hidden (toggle)">Masqu&eacute; (bascule)</span>
          </label>
          <label class="user-setting-radio" data-val="visible">
            <input type="radio" name="age-gate-irrealiste-mode" value="visible" /> <span data-fr="Visible" data-en="Visible">Visible</span>
          </label>
          <label class="user-setting-radio" data-val="off">
            <input type="radio" name="age-gate-irrealiste-mode" value="off" /> <span data-fr="D&eacute;sactiv&eacute;" data-en="Disabled">D&eacute;sactiv&eacute;</span>
          </label>
        </div>
      </div>

      <div class="age-gate-actions age-gate-actions--single">
        <button type="button" class="age-gate-btn age-gate-btn--yes" id="age-gate-enter" data-fr="Entrer sur le site" data-en="Enter the site">Entrer sur le site</button>
      </div>
    </div>

  </div>
</div>
<script nonce="<%= nonce %>">
(function () {
  var overlay = document.getElementById("age-gate-overlay");
  if (!overlay) return;
  try {
    if (localStorage.getItem("lq-age-gate-seen") === "1") {
      overlay.remove();
      return;
    }
  } catch (_) {}

  var slides = {
    1: document.getElementById("age-gate-slide-1"),
    2: document.getElementById("age-gate-slide-2"),
    3: document.getElementById("age-gate-slide-3"),
    4: document.getElementById("age-gate-slide-4")
  };

  function goTo(n) {
    Object.keys(slides).forEach(function (k) {
      slides[k].hidden = Number(k) !== n;
    });
  }

  var ultraContainer = document.getElementById("age-gate-ultra-mode-options");
  var irrealisteContainer = document.getElementById("age-gate-irrealiste-mode-options");

  function wireRadioGroup(container, initial) {
    if (!container) return;
    var labels = Array.prototype.slice.call(container.querySelectorAll(".user-setting-radio"));
    function sync(val) {
      labels.forEach(function (lbl) { lbl.classList.toggle("active", lbl.dataset.val === val); });
    }
    sync(initial);
    labels.forEach(function (lbl) {
      var radio = lbl.querySelector("input");
      if (radio.value === initial) radio.checked = true;
      radio.addEventListener("change", function () {
        if (radio.checked) sync(radio.value);
      });
    });
  }
  wireRadioGroup(ultraContainer, "hidden");
  wireRadioGroup(irrealisteContainer, "visible");

  function radioValue(container, fallback) {
    var checked = container && container.querySelector("input:checked");
    return checked ? checked.value : fallback;
  }

  function finish() {
    try { localStorage.setItem("lq-age-gate-seen", "1"); } catch (_) {}
    var ultra = radioValue(ultraContainer, "hidden");
    var irrealiste = radioValue(irrealisteContainer, "visible");
    fetch("/set-special-modes", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: "ultraMode=" + encodeURIComponent(ultra) + "&irrealisteMode=" + encodeURIComponent(irrealiste)
    }).then(function () { window.location.reload(); })
      .catch(function () { window.location.reload(); });
  }

  document.getElementById("age-gate-no").addEventListener("click", function () {
    window.location.href = "https://www.google.com";
  });
  document.getElementById("age-gate-yes").addEventListener("click", function () { goTo(2); });
  document.getElementById("age-gate-continue-2").addEventListener("click", function () { goTo(3); });
  document.getElementById("age-gate-continue-3").addEventListener("click", function () { goTo(4); });
  document.getElementById("age-gate-enter").addEventListener("click", finish);
})();
</script>
<% } %>
