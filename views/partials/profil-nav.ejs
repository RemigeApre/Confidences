<%# Volet de navigation du profil :
    1. Coffre (lien direct)
    2. Activités <details> : Codex, Images, BD, Nouvelles, Historique, À lire
    3. Gestion   <details> : Paramètres, Identité, Mot de passe…
    4. Liens divers (couple, admin, déconnexion) %>
<aside class="wiki-cat-sidebar profil-nav-sidebar" style="--ch-hue: <%= roleHue %>">
  <div class="profil-nav-header">
    <a href="/favoris" class="profil-nav-name"><%= currentUser.displayName %></a>
  </div>
  <div class="wiki-sidebar-body">

    <%# ── 1. Coffre ── %>
    <%
      var _cofreOpen = currentPath === '/favoris/coffre' || currentPath.indexOf('/favoris/coffre') === 0;
      var _cofreView = locals.view || null;
    %>
    <details class="profil-nav-accordion"<%= _cofreOpen ? ' open' : '' %>>
      <summary class="profil-nav-accordion-title">
        <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="12" width="20" height="10" rx="2"/><path d="M2 12 Q2 6 12 6 Q22 6 22 12"/><rect x="9" y="9" width="6" height="5" rx="1.5"/><circle cx="12" cy="17" r="1.5"/></svg>
        Coffre
        <svg class="profil-nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <nav class="profil-nav-links profil-nav-links--sub">
        <a href="/favoris/coffre?view=images" class="profil-nav-link<%= _cofreOpen && _cofreView === 'images' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <span>Images</span>
          <% if (locals.coffreUnlocks !== undefined) { %><span class="profil-nav-count"><%= locals.coffreUnlocks %></span><% } %>
        </a>
        <a href="/favoris/coffre?view=charms" class="profil-nav-link<%= _cofreOpen && _cofreView === 'charms' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span>Charmes</span>
          <% if (locals.coffreCharms !== undefined) { %><span class="profil-nav-count"><%= locals.coffreCharms %></span><% } %>
        </a>
        <a href="/favoris/coffre?view=themes" class="profil-nav-link<%= _cofreOpen && _cofreView === 'themes' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          <span>Th&egrave;mes</span>
          <% if (locals.coffreThemes !== undefined) { %><span class="profil-nav-count"><%= locals.coffreThemes %></span><% } %>
        </a>
      </nav>
    </details>

    <%# ── 2. Activités ── %>
    <%
      var _actPaths = ['/favoris/notes/wiki','/favoris/notes/images','/favoris/collections','/favoris/notes/bd','/favoris/a-lire-plus-tard','/favoris/historique','/nouvelles'];
      var _actOpen = _actPaths.some(function(p){ return currentPath === p || currentPath.indexOf(p) === 0; });
    %>
    <details class="profil-nav-accordion"<%= _actOpen ? ' open' : '' %>>
      <summary class="profil-nav-accordion-title">
        <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Activit&eacute;s
        <svg class="profil-nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <nav class="profil-nav-links profil-nav-links--sub">
        <a href="/favoris/notes/wiki" class="profil-nav-link<%= currentPath === '/favoris/notes/wiki' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9a2 2 0 0 1 2 2v16l-6.5-4.2L4 21V5a2 2 0 0 1 2-2Z"/></svg>
          <span>Codex</span>
          <span class="profil-nav-count"><%= notesCounts.wiki %></span>
        </a>
        <a href="/favoris/notes/images" class="profil-nav-link<%= currentPath === '/favoris/notes/images' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <span>Images</span>
          <span class="profil-nav-count"><%= notesCounts.gallery %></span>
        </a>
        <a href="/favoris/collections" class="profil-nav-link profil-nav-sublink<%= currentPath.indexOf('/favoris/collections') === 0 ? ' active' : '' %>">
          <span>Mes collections</span>
        </a>
        <a href="/favoris/notes/bd" class="profil-nav-link<%= currentPath === '/favoris/notes/bd' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="13" height="13" rx="2"/><path d="M7 21h13a2 2 0 0 0 2-2V6"/></svg>
          <span>BD</span>
          <span class="profil-nav-count"><%= notesCounts.bd %></span>
        </a>
        <a href="/nouvelles" class="profil-nav-link<%= currentPath.indexOf('/nouvelles') === 0 ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/></svg>
          <span>Nouvelles</span>
        </a>
        <a href="/favoris/historique" class="profil-nav-link<%= currentPath === '/favoris/historique' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
          <span>Historique</span>
        </a>
        <a href="/favoris/a-lire-plus-tard" class="profil-nav-link<%= currentPath === '/favoris/a-lire-plus-tard' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4V3Z"/></svg>
          <span>&Agrave; lire plus tard</span>
        </a>
      </nav>
    </details>

    <%# ── 3. Gestion ── %>
    <%
      var _gestPaths = ['/favoris/parametres','/favoris/masques','/favoris/identite','/favoris/mot-de-passe','/favoris/journal'];
      var _gestOpen = _gestPaths.some(function(p){ return currentPath === p; });
    %>
    <details class="profil-nav-accordion"<%= _gestOpen ? ' open' : '' %>>
      <summary class="profil-nav-accordion-title">
        <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><circle cx="14" cy="7" r="2"/><line x1="4" y1="12" x2="20" y2="12"/><circle cx="8" cy="12" r="2"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="16" cy="17" r="2"/></svg>
        Gestion
        <svg class="profil-nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <nav class="profil-nav-links profil-nav-links--sub">
        <a href="/favoris/parametres" class="profil-nav-link<%= currentPath === '/favoris/parametres' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><circle cx="14" cy="7" r="2"/><line x1="4" y1="12" x2="20" y2="12"/><circle cx="8" cy="12" r="2"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="16" cy="17" r="2"/></svg>
          <span>Param&egrave;tres</span>
        </a>
        <a href="/favoris/masques" class="profil-nav-link profil-nav-sublink<%= currentPath === '/favoris/masques' ? ' active' : '' %>">
          <span>Contenus masqu&eacute;s</span>
        </a>
        <a href="/favoris/identite" class="profil-nav-link<%= currentPath === '/favoris/identite' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          <span>Identit&eacute;</span>
        </a>
        <a href="/favoris/mot-de-passe" class="profil-nav-link profil-nav-sublink<%= currentPath === '/favoris/mot-de-passe' ? ' active' : '' %>">
          <span>Mot de passe</span>
        </a>
        <% if (currentUser.isAdmin) { %>
          <a href="/favoris/journal" class="profil-nav-link profil-nav-sublink<%= currentPath === '/favoris/journal' ? ' active' : '' %>">
            <span>Journal technique</span>
          </a>
        <% } %>
      </nav>
    </details>

    <%# ── 4. Divers ── %>
    <nav class="profil-nav-links">
      <% if (locals.partnerUser) { %>
        <a href="/couple" class="profil-nav-link profil-nav-sublink<%= currentPath.indexOf('/couple') === 0 ? ' active' : '' %>">
          <span>Profil de <%= partnerUser.displayName %></span>
        </a>
      <% } %>
      <% if (currentUser.isAdmin) { %>
        <a href="/admin" class="profil-nav-link profil-nav-sublink">
          <span>Admin</span>
        </a>
      <% } %>
      <form method="POST" action="/admin/logout" class="profil-nav-logout-form">
        <button type="submit" class="profil-nav-link profil-nav-sublink profil-nav-link--danger">D&eacute;connexion</button>
      </form>
    </nav>

    <button type="button" class="profil-ultra-toggle wiki-filter-reset-btn" id="profil-ultra-toggle" aria-pressed="false" title="Masquer les contenus Ultra" aria-label="Masquer les contenus Ultra">Masquer Ultra</button>
  </div>
</aside>
