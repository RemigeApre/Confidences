<%# Volet de navigation du profil :
    1. Profil (lien direct, page pas encore réalisée)
    2. Coffre (lien direct, non réductible)
    3. Notes & favoris <details> : Codex, Images, BD, Nouvelles
    4. À lire plus tard (lien direct)
    5. Lien couple (si applicable)
    6. Bas de volet : icônes Paramètres/Identité + déconnexion %>
<aside class="wiki-cat-sidebar profil-nav-sidebar" style="--ch-hue: <%= roleHue %>">
  <div class="wiki-sidebar-body">

    <%# ── 1. Profil public ── %>
    <a href="/favoris/profil-public" class="profil-nav-big-title<%= currentPath === '/favoris/profil-public' ? ' active' : '' %>">
      Profil public
    </a>

    <%# ── 2. Coffre (non réductible) ── %>
    <% var _cofreView = locals.view || null; %>
    <div class="profil-nav-section-title">Coffre</div>
    <nav class="profil-nav-links profil-nav-links--sub">
      <a href="/favoris/coffre?view=images" class="profil-nav-link<%= _cofreView === 'images' ? ' active' : '' %>">
        <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        <span>Images</span>
        <% if (locals.coffreUnlocks !== undefined) { %><span class="profil-nav-count"><%= locals.coffreUnlocks %></span><% } %>
      </a>
      <a href="/favoris/coffre?view=charms" class="profil-nav-link<%= _cofreView === 'charms' ? ' active' : '' %>">
        <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span>Charmes</span>
        <% if (locals.coffreCharms !== undefined) { %><span class="profil-nav-count"><%= locals.coffreCharms %></span><% } %>
      </a>
      <a href="/favoris/coffre?view=themes" class="profil-nav-link<%= _cofreView === 'themes' ? ' active' : '' %>">
        <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
        <span>Th&egrave;mes</span>
        <% if (locals.coffreThemes !== undefined) { %><span class="profil-nav-count"><%= locals.coffreThemes %></span><% } %>
      </a>
    </nav>

    <%# ── 3. Notes & favoris ── %>
    <%
      var _actPaths = ['/favoris/notes/wiki','/favoris/notes/images','/favoris/collections','/favoris/notes/bd','/nouvelles'];
      var _actOpen = _actPaths.some(function(p){ return currentPath === p || currentPath.indexOf(p) === 0; });
    %>
    <details class="profil-nav-accordion"<%= _actOpen ? ' open' : '' %>>
      <summary class="profil-nav-big-title profil-nav-big-title--toggle">
        Notes &amp; favoris
        <svg class="profil-nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <nav class="profil-nav-links profil-nav-links--sub">
        <a href="/favoris/notes/wiki" class="profil-nav-link<%= currentPath === '/favoris/notes/wiki' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9a2 2 0 0 1 2 2v16l-6.5-4.2L4 21V5a2 2 0 0 1 2-2Z"/></svg>
          <span>Codex</span>
          <span class="profil-nav-count"><%= notesCounts.wiki %></span>
        </a>
        <a href="/favoris/notes/images" class="profil-nav-link<%= currentPath === '/favoris/notes/images' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <span>Images</span>
          <span class="profil-nav-count"><%= notesCounts.gallery %></span>
        </a>
        <a href="/favoris/notes/bd" class="profil-nav-link<%= currentPath === '/favoris/notes/bd' ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="13" height="13" rx="2"/><path d="M7 21h13a2 2 0 0 0 2-2V6"/></svg>
          <span>BD</span>
          <span class="profil-nav-count"><%= notesCounts.bd %></span>
        </a>
        <a href="/nouvelles" class="profil-nav-link<%= currentPath.indexOf('/nouvelles') === 0 ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/></svg>
          <span>Nouvelles</span>
        </a>
        <a href="/favoris/collections" class="profil-nav-link<%= currentPath.indexOf('/favoris/collections') === 0 ? ' active' : '' %>">
          <svg class="profil-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/></svg>
          <span>Mes collections</span>
        </a>
      </nav>
    </details>

    <%# ── 4. À lire plus tard ── %>
    <a href="/favoris/a-lire-plus-tard" class="profil-nav-big-title<%= currentPath === '/favoris/a-lire-plus-tard' ? ' active' : '' %>">&Agrave; lire plus tard</a>

    <%# ── 4b. Code invité ── %>
    <% if (locals.inviteToken) { %>
      <div class="profil-nav-invite-row">
        <button type="button" class="profil-nav-big-title profil-nav-big-title--invite" id="pn-invite-btn">
          Code invit&eacute;
        </button>
        <% if (locals.pendingInvitesCount > 0) { %>
          <a href="/favoris/invitations" class="profil-nav-invite-badge<%= currentPath === '/favoris/invitations' ? ' active' : '' %>" title="<%= locals.pendingInvitesCount %> inscription<%= locals.pendingInvitesCount > 1 ? 's' : '' %> en attente"><%= locals.pendingInvitesCount %></a>
        <% } %>
      </div>
    <% } %>

    <%# ── Modale code invité ── %>
    <% if (locals.inviteToken) { %>
    <div class="pn-invite-backdrop" id="pn-invite-backdrop" aria-hidden="true"></div>
    <div class="pn-invite-modal" id="pn-invite-modal" role="dialog" aria-modal="true" aria-label="Code invité" hidden>
      <div class="pn-invite-modal-inner">
        <button type="button" class="pn-invite-close" id="pn-invite-close" aria-label="Fermer">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="pn-invite-step" id="pn-invite-step-warn">
          <p class="pn-invite-warn-text">Assurez-vous de donner ce lien exclusivement &agrave; des personnes majeures.</p>
          <div class="pn-invite-warn-actions">
            <button type="button" class="pn-invite-btn-ok" id="pn-invite-confirm">D&rsquo;accord</button>
            <button type="button" class="pn-invite-btn-cancel" id="pn-invite-warn-cancel">Annuler</button>
          </div>
        </div>
        <div class="pn-invite-step" id="pn-invite-step-link" hidden>
          <p class="pn-invite-label">Lien d&rsquo;inscription</p>
          <div class="pn-invite-link-row">
            <input type="text" class="pn-invite-link-input" id="pn-invite-link-input" readonly value="" />
            <button type="button" class="pn-invite-copy-btn" id="pn-invite-copy" aria-label="Copier le lien">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
          <p class="pn-invite-hint">Envoyez ce lien &agrave; la personne. Elle devra s&rsquo;inscrire, et vous devrez valider son acc&egrave;s.</p>
        </div>
      </div>
    </div>
    <script nonce="<%= nonce %>">
    (function(){
      var inviteLink = window.location.origin + '/rejoindre/<%= inviteToken %>';
      var btn = document.getElementById('pn-invite-btn');
      var backdrop = document.getElementById('pn-invite-backdrop');
      var modal = document.getElementById('pn-invite-modal');
      var closeBtn = document.getElementById('pn-invite-close');
      var confirmBtn = document.getElementById('pn-invite-confirm');
      var warnCancelBtn = document.getElementById('pn-invite-warn-cancel');
      var stepWarn = document.getElementById('pn-invite-step-warn');
      var stepLink = document.getElementById('pn-invite-step-link');
      var linkInput = document.getElementById('pn-invite-link-input');
      var copyBtn = document.getElementById('pn-invite-copy');
      linkInput.value = inviteLink;
      function openModal() {
        stepWarn.hidden = false; stepLink.hidden = true;
        modal.hidden = false; backdrop.hidden = false;
        backdrop.setAttribute('aria-hidden','false');
        setTimeout(function(){ modal.classList.add('pn-invite-modal--visible'); backdrop.classList.add('pn-invite-backdrop--visible'); }, 10);
      }
      function closeModal() {
        modal.classList.remove('pn-invite-modal--visible');
        backdrop.classList.remove('pn-invite-backdrop--visible');
        setTimeout(function(){ modal.hidden=true; backdrop.hidden=true; backdrop.setAttribute('aria-hidden','true'); }, 220);
      }
      btn.addEventListener('click', openModal);
      closeBtn.addEventListener('click', closeModal);
      warnCancelBtn.addEventListener('click', closeModal);
      backdrop.addEventListener('click', closeModal);
      document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !modal.hidden) closeModal(); });
      confirmBtn.addEventListener('click', function(){
        stepWarn.hidden = true; stepLink.hidden = false;
      });
      copyBtn.addEventListener('click', function(){
        navigator.clipboard && navigator.clipboard.writeText(inviteLink).then(function(){
          copyBtn.classList.add('pn-invite-copy-btn--copied');
          setTimeout(function(){ copyBtn.classList.remove('pn-invite-copy-btn--copied'); }, 1500);
        }).catch(function(){ linkInput.select(); document.execCommand('copy'); });
      });
    })();
    </script>
    <% } %>

    <%# ── 5. Lien couple ── %>
    <% if (locals.partnerUser) { %>
      <a href="/couple" class="profil-nav-big-title<%= currentPath.indexOf('/couple') === 0 ? ' active' : '' %>">Partenaire</a>
    <% } %>

    <%# ── 6. Bas de volet : Paramètres / Identité / Déconnexion (icônes, même ligne) ── %>
    <form method="POST" action="/ponhgup/logout" id="profil-nav-logout-form" class="profil-nav-logout-form"></form>
    <div class="profil-nav-icon-row">
      <a href="/favoris/parametres" class="profil-nav-icon-btn profil-nav-icon-btn--accent<%= currentPath === '/favoris/parametres' ? ' active' : '' %>" title="Param&egrave;tres" aria-label="Param&egrave;tres">
        <svg class="profil-nav-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </a>
      <a href="/favoris/identite" class="profil-nav-icon-btn profil-nav-icon-btn--accent<%= currentPath === '/favoris/identite' ? ' active' : '' %>" title="Identit&eacute;" aria-label="Identit&eacute;">
        <svg class="profil-nav-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
      </a>
      <button type="submit" form="profil-nav-logout-form" class="profil-nav-icon-btn profil-nav-icon-btn--danger" title="D&eacute;connexion" aria-label="D&eacute;connexion">
        <svg class="profil-nav-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </button>
    </div>
  </div>
</aside>
