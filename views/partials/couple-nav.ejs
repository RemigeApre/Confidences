<%# Volet de navigation du mode couple.
    Attend : partner (contexte courant — peut être le partenaire ou soi-même).
    couplePartner et currentUser sont dans res.locals. %>
<%
  var _cp  = currentPath || '';
  var _onSelf = _cp.startsWith('/couple/mon-profil');
  var _hue = _onSelf ? 215 : 330;

  // Qui est en haut / en bas selon le contexte
  var _main   = _onSelf ? currentUser    : couplePartner;
  var _other  = _onSelf ? couplePartner  : currentUser;
  var _mainBase  = _onSelf ? '/couple/mon-profil' : '/couple';
  var _otherLink = _onSelf ? '/couple'            : '/couple/mon-profil';
  var _otherLabel = _onSelf ? couplePartner.displayName : 'Mon profil';

  var _CATS = [
    { key: 'objets',      label: 'Objets'      },
    { key: 'tenues',      label: 'Tenues'      },
    { key: 'position',    label: 'Positions'   },
    { key: 'lieux',       label: 'Lieux'       },
    { key: 'jeu_de_role', label: 'Scénarios'   },
    { key: 'pratique',    label: 'Pratiques'   },
    { key: 'partenaires', label: 'Partenaires' },
    { key: 'fantasmes',   label: 'Fantasmes'   },
    { key: 'autre',       label: 'Autre'       },
  ];
%>
<aside class="wiki-cat-sidebar profil-nav-sidebar" style="--ch-hue:<%= _hue %>">
  <div class="wiki-sidebar-body">

    <%# ─ En-tête section active ─ %>
    <a href="<%= _mainBase %>" class="cnav-partner-header">
      <div class="cnav-partner-avatar" style="<%= _main.profileColor ? 'background:' + _main.profileColor : '' %>">
        <%= (_main.displayName || '?').charAt(0).toUpperCase() %>
      </div>
      <span class="cnav-partner-name"><%= _main.displayName %></span>
    </a>

    <%# ─ Catégories section active ─ %>
    <div class="cnav-list">
      <% _CATS.forEach(function(cat) {
           var href = _mainBase + '/notes/' + cat.key;
      %>
        <a href="<%= href %>" class="cnav-btn<%= _cp === href ? ' active' : '' %>"><%= cat.label %></a>
      <% }) %>
      <a href="<%= _mainBase %>/medias" class="cnav-btn<%= _cp === _mainBase + '/medias' ? ' active' : '' %>">M&eacute;dias</a>
    </div>

    <%# ─ Switch vers l'autre contexte ─ %>
    <a href="<%= _otherLink %>" class="cnav-switch">
      <div class="cnav-switch-avatar" style="<%= _other.profileColor ? 'background:' + _other.profileColor : '' %>">
        <%= (_other.displayName || '?').charAt(0).toUpperCase() %>
      </div>
      <span><%= _otherLabel %></span>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" width="10" height="10" aria-hidden="true" style="margin-left:auto;opacity:.5"><polyline points="6 4 10 8 6 12"/></svg>
    </a>

  </div>
</aside>
