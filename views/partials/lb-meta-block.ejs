<%# ── Bloc méta du volet image (titre, parodies, auteur, protagonistes, tags) ── %>
<div class="lb-meta-block">
  <%# Bouton édition inline — affiché uniquement pour les admins sur desktop (géré par gallery.js) %>
  <button type="button" class="lb-inline-edit-btn" id="gallery-lb-inline-edit-btn"
          title="Modifier les métadonnées" aria-label="Modifier" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true">
      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
    </svg>
  </button>
  <h2 class="lb-meta-block__title" id="gallery-lb-title" hidden></h2>

  <div class="lb-meta-section" id="gallery-lb-meta-parody" hidden>
    <span class="lb-meta-label">Parodie</span>
    <div class="lb-meta-chips"></div>
  </div>

  <div class="lb-meta-section" id="gallery-lb-meta-author" hidden>
    <span class="lb-meta-label">Auteur</span>
    <div class="lb-meta-chips"></div>
  </div>

  <div class="lb-meta-section" id="gallery-lb-meta-protagonists" hidden>
    <span class="lb-meta-label">Personnages</span>
    <div class="lb-meta-chips"></div>
  </div>

  <div class="lb-meta-section" id="gallery-lb-meta-tags" hidden>
    <span class="lb-meta-label">Tags</span>
    <div class="gallery-lb-tags lb-meta-chips"></div>
  </div>

  <a class="gallery-lb-wiki-btn" href="" hidden></a>
</div>
