<%
  /* ── Detect active group from path ───────────────────────────── */
  var _path = locals.currentPath || '';
  var _activeGroup = 'users'; // default
  if (/^\/ponhgup\/recompenses/.test(_path)) {
    _activeGroup = 'recompenses';
  } else if (/^\/ponhgup\/(jeux|auteurs|races|codex-checklist)/.test(_path)) {
    _activeGroup = 'resources';
  } else if (/^\/ponhgup\/(ip-logs|utilisateur\/)/.test(_path)) {
    _activeGroup = 'users';
  } else if (/^\/ponhgup$/.test(_path)) {
    _activeGroup = 'users';
  }
%>
<nav class="adm-nav" id="adm-nav">

  <div class="adm-nav-top">
    <button class="adm-burger" id="adm-burger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <div class="adm-grps">
      <button class="adm-grp<%= _activeGroup==='users' ? ' active' : '' %>" data-grp="users">Utilisateurs</button>
      <button class="adm-grp<%= _activeGroup==='resources' ? ' active' : '' %>" data-grp="resources">Ressources</button>
      <button class="adm-grp<%= _activeGroup==='recompenses' ? ' active' : '' %>" data-grp="recompenses">R&eacute;compenses</button>
      <button class="adm-grp<%= _activeGroup==='versions' ? ' active' : '' %>" data-grp="versions">Versions</button>
      <button class="adm-grp<%= _activeGroup==='audit' ? ' active' : '' %>" data-grp="audit">Log admin</button>
    </div>
    <a href="/" class="adm-home">&#8617; Retour au site</a>
  </div>

  <%# ── Menu mobile (caché sur desktop, visible via burger) ── %>
  <div class="adm-mob-menu" id="adm-mob-menu" aria-hidden="true">
    <div class="adm-mob-section">
      <span class="adm-mob-section-label">Utilisateurs</span>
      <a class="adm-mob-link<%= _activeGroup==='users' ? ' adm-mob-link--active' : '' %>" href="/ponhgup">Gestion</a>
      <a class="adm-mob-link" href="/ponhgup#tab-demandes-compte">Demandes</a>
      <a class="adm-mob-link" href="/ponhgup#tab-log">Connexions</a>
      <a class="adm-mob-link" href="/ponhgup/ip-logs">IP Logs</a>
    </div>
    <div class="adm-mob-section">
      <span class="adm-mob-section-label">Ressources</span>
      <a class="adm-mob-link<%= _activeGroup==='resources' ? ' adm-mob-link--active' : '' %>" href="/ponhgup#tab-contenu">Contenu divers</a>
      <a class="adm-mob-link" href="/ponhgup/jeux">Jeux</a>
    </div>
    <div class="adm-mob-section">
      <span class="adm-mob-section-label">R&eacute;compenses</span>
      <a class="adm-mob-link<%= _activeGroup==='recompenses' ? ' adm-mob-link--active' : '' %>" href="/ponhgup/recompenses">Accueil</a>
      <a class="adm-mob-link" href="/ponhgup/recompenses#images">Images</a>
      <a class="adm-mob-link" href="/ponhgup/recompenses#charms">Charmes</a>
      <a class="adm-mob-link" href="/ponhgup/recompenses#themes">Th&egrave;mes</a>
      <a class="adm-mob-link" href="/ponhgup/recompenses#cartes">Cartes</a>
    </div>
    <div class="adm-mob-section">
      <span class="adm-mob-section-label">Suivi</span>
      <a class="adm-mob-link" href="/ponhgup#tab-changelog">Changelog</a>
      <a class="adm-mob-link" href="/ponhgup#tab-audit">Log admin</a>
    </div>
    <a href="/" class="adm-mob-home">&larr; Retour au site</a>
  </div>

  <div class="adm-sub<%= _activeGroup!=='users' ? ' adm-sub--off' : '' %>" data-grp-panel="users">
    <a class="adm-si" href="/ponhgup#tab-utilisateurs" data-tab="utilisateurs" data-si-id="utilisateurs">Gestion</a>
    <a class="adm-si" href="/ponhgup#tab-demandes-compte" data-tab="demandes-compte" data-si-id="demandes-compte">Demandes</a>
    <span class="adm-sep" aria-hidden="true"></span>
    <a class="adm-si" href="/ponhgup#tab-log" data-tab="log" data-log-panel="conn" data-si-id="log-conn">Connexions</a>
    <a class="adm-si" href="/ponhgup#tab-log" data-tab="log" data-log-panel="anon" data-si-id="log-anon">Activit&eacute;</a>
    <a class="adm-si<%= _path.startsWith('/ponhgup/ip-logs') ? ' active' : '' %>" href="/ponhgup/ip-logs">IP Logs</a>
  </div>

  <div class="adm-sub<%= _activeGroup!=='resources' ? ' adm-sub--off' : '' %>" data-grp-panel="resources">
    <a class="adm-si" href="/ponhgup#tab-contenu" data-tab="contenu">Contenu divers</a>
    <span class="adm-sep" aria-hidden="true"></span>
    <a class="adm-si<%= _path.startsWith('/ponhgup/jeux') ? ' active' : '' %>" href="/ponhgup/jeux">Jeux</a>
  </div>

  <div class="adm-sub<%= _activeGroup!=='recompenses' ? ' adm-sub--off' : '' %>" data-grp-panel="recompenses">
    <a class="adm-si" href="/ponhgup/recompenses" data-rec-tab="accueil">Accueil</a>
    <a class="adm-si" href="/ponhgup/recompenses#images" data-rec-tab="images">Images</a>
    <a class="adm-si" href="/ponhgup/recompenses#charms" data-rec-tab="charms">Charmes</a>
    <a class="adm-si" href="/ponhgup/recompenses#themes" data-rec-tab="themes">Th&egrave;mes</a>
    <a class="adm-si" href="/ponhgup/recompenses#cartes" data-rec-tab="cartes">Cartes</a>
  </div>

  <div class="adm-sub<%= _activeGroup!=='versions' ? ' adm-sub--off' : '' %>" data-grp-panel="versions">
    <a class="adm-si" href="/ponhgup#tab-changelog" data-tab="changelog" data-si-id="changelog">Changelog</a>
    <a class="adm-si" href="/ponhgup#tab-roadmap" data-tab="roadmap" data-si-id="roadmap">Roadmap</a>
  </div>

  <div class="adm-sub<%= _activeGroup!=='audit' ? ' adm-sub--off' : '' %>" data-grp-panel="audit">
    <a class="adm-si" href="/ponhgup#tab-audit" data-tab="audit" data-si-id="audit">Journal des actions</a>
  </div>

</nav>

<script nonce="<%= locals.nonce %>">
(function () {
  var nav = document.getElementById('adm-nav');
  if (!nav) return;

  /* ── Group first-page map ─────────────────────────── */
  var grpFirstUrl = {
    users:       '/ponhgup',
    resources:   '/ponhgup#tab-contenu',
    recompenses: '/ponhgup/recompenses',
    versions:    '/ponhgup#tab-changelog',
    audit:       '/ponhgup#tab-audit'
  };

  /* ── Groupes sans contenu sur le dashboard : toujours une vraie
     navigation (page à part), jamais un simple dépliage du sous-header. ── */
  var EXTERNAL_GROUPS = ['recompenses'];

  /* ── Dashboard tab interception ─────────────────── */
  var isDashboard = window.location.pathname === '/ponhgup';

  /* ── Group switching ──────────────────────────────── */
  nav.querySelectorAll('.adm-grp').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var grp = btn.dataset.grp;

      /* If not on dashboard, or the group lives on its own page,
         navigate to the group's first page */
      if (!isDashboard || EXTERNAL_GROUPS.indexOf(grp) !== -1) {
        window.location.href = grpFirstUrl[grp] || '/ponhgup';
        return;
      }

      nav.querySelectorAll('.adm-grp').forEach(function(b) {
        b.classList.toggle('active', b === btn);
      });
      nav.querySelectorAll('.adm-sub').forEach(function(panel) {
        panel.classList.toggle('adm-sub--off', panel.dataset.grpPanel !== grp);
      });
    });
  });

  function activateSi(siId) {
    nav.querySelectorAll('.adm-si[data-si-id]').forEach(function(s) {
      s.classList.toggle('active', s.dataset.siId === siId);
    });
  }

  window.admSwitchTab = function(tabId, logPanel) {
    var sections = document.querySelectorAll('.admin-tab-section');
    sections.forEach(function(s) { s.hidden = s.dataset.tab !== tabId; });
    if (logPanel) {
      var logBtn = document.querySelector('.log-nav-btn[data-panel="' + logPanel + '"]');
      if (logBtn) logBtn.click();
    }
    activateSi(logPanel ? tabId + '-' + logPanel : tabId);
    try { history.replaceState(null, '', '#tab-' + tabId + (logPanel ? '-' + logPanel : '')); } catch(_) {}
  };

  if (isDashboard) {
    nav.querySelectorAll('.adm-si[data-tab]').forEach(function(item) {
      item.addEventListener('click', function(e) {
        e.preventDefault();
        var tabId = item.dataset.tab;
        var logPanel = item.dataset.logPanel || null;

        /* activate the correct group visually */
        var panel = item.closest('.adm-sub');
        if (panel) {
          var grp = panel.dataset.grpPanel;
          nav.querySelectorAll('.adm-grp').forEach(function(b) {
            b.classList.toggle('active', b.dataset.grp === grp);
          });
          nav.querySelectorAll('.adm-sub').forEach(function(p) {
            p.classList.toggle('adm-sub--off', p.dataset.grpPanel !== grp);
          });
        }

        window.admSwitchTab(tabId, logPanel);
      });
    });

    /* ── Restore from URL hash (or default to Gestion) ────────── */
    (function() {
      var hash = location.hash.replace('#tab-', '');
      if (!hash) {
        activateSi('utilisateurs');
        return;
      }
      /* formats: "log-conn", "log-anon", "utilisateurs", etc. */
      var tabId = hash, logPanel = null;
      var logMatch = hash.match(/^log-(.+)$/);
      if (logMatch) { tabId = 'log'; logPanel = logMatch[1]; }
      var targetSi = nav.querySelector('.adm-si[data-tab="' + tabId + '"]');
      if (targetSi) targetSi.click();
      else {
        /* try direct section */
        var section = document.querySelector('.admin-tab-section[data-tab="' + tabId + '"]');
        if (section) window.admSwitchTab(tabId, logPanel);
      }
    })();
  }
  // ── Burger mobile ─────────────────────────────────────────────
  var burger = document.getElementById('adm-burger');
  var mobMenu = document.getElementById('adm-mob-menu');
  if (burger && mobMenu) {
    burger.addEventListener('click', function() {
      var open = nav.classList.toggle('adm-nav--mob-open');
      burger.setAttribute('aria-expanded', open);
      mobMenu.setAttribute('aria-hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    });
    // Fermer sur clic sur un lien du menu mobile
    mobMenu.addEventListener('click', function(e) {
      if (e.target.closest('a')) {
        nav.classList.remove('adm-nav--mob-open');
        burger.setAttribute('aria-expanded', 'false');
        mobMenu.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    });
  }
})();
</script>
