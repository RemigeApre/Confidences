<div class="tag-popup-overlay" id="tag-popup-overlay" hidden>
  <div class="tag-popup" role="dialog" aria-modal="true" aria-labelledby="tag-popup-title">
    <div class="tag-popup-header">
      <span class="tag-popup-title" id="tag-popup-title"></span>
      <button type="button" class="tag-popup-close" id="tag-popup-close" aria-label="Fermer">&times;</button>
    </div>
    <div class="tag-popup-body">
      <div class="tag-popup-pages" id="tag-popup-pages"></div>
      <div class="tag-popup-actions">
        <button type="button" class="tag-popup-action" id="tag-popup-gallery-btn" hidden></button>
        <button type="button" class="tag-popup-action" id="tag-popup-bd-btn" hidden></button>
      </div>
      <button type="button" class="tag-popup-action tag-popup-action--danger" id="tag-popup-blacklist-btn" hidden>Masquer le tag</button>
      <details class="tag-popup-admin" id="tag-popup-admin" hidden>
        <summary>&#9881;</summary>
        <div class="tag-popup-admin-body">
          <div class="tag-popup-admin-row">
            <input type="text" id="tag-popup-rename-input" autocomplete="off" />
            <button type="button" id="tag-popup-rename-btn" class="tag-popup-action">OK</button>
          </div>
          <div class="tag-popup-admin-row" id="tag-popup-type-btns">
            <button type="button" class="tag-chip" data-type="normal">Normal</button>
            <button type="button" class="tag-chip tags-type-ultra" data-type="ultra">Ultra</button>
            <button type="button" class="tag-chip tags-type-irrealiste" data-type="irrealiste">Irr&eacute;aliste</button>
          </div>
          <div class="tag-popup-admin-row">
            <select id="tag-popup-category-select" class="tag-popup-category-select">
              <option value="autre">Autre</option>
              <option value="femme">Femme</option>
              <option value="homme">Homme</option>
              <option value="rapport">Rapport</option>
              <option value="lieu">Lieu</option>
              <option value="relation">Relation</option>
              <option value="objet">Objet</option>
            </select>
            <button type="button" id="tag-popup-category-btn" class="tag-popup-action">Cat&eacute;gorie</button>
          </div>
          <div class="tag-popup-admin-row">
            <input type="text" id="tag-popup-parent-input" class="tag-popup-parent-input" autocomplete="off" placeholder="Tag principal&hellip;" />
            <button type="button" id="tag-popup-parent-btn" class="tag-popup-action">D&eacute;clinaison de</button>
          </div>
          <div class="tag-popup-admin-row" id="tag-popup-subcat-row" hidden>
            <select id="tag-popup-subcat-select" class="tag-popup-category-select">
              <option value="">— Non classé —</option>
              <option value="physique">Physique</option>
              <option value="fantastique">Fantastique et impossible</option>
              <option value="vetements">V&ecirc;tements</option>
              <option value="autre">Autre</option>
            </select>
            <button type="button" id="tag-popup-subcat-btn" class="tag-popup-action">Sous-cat.</button>
          </div>
          <p class="tag-popup-admin-feedback" id="tag-popup-admin-feedback"></p>
        </div>
      </details>
    </div>
  </div>
</div>
