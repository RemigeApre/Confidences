<%- include('partials/head', { title: 'BD : ' + (book ? 'Modifier ' + book.title : 'Nouvelle BD') }) %>
<main class="container wide bdf-has-right-sidebar">
  <%- include('partials/top-nav', { config: config }) %>
  <button type="button" class="mobile-filter-toggle bdf-options-toggle" id="mobile-filter-toggle" aria-label="Options" aria-expanded="false" aria-controls="mobile-filter-sidebar">&#9881; Options</button>
  <div class="nav-backdrop" id="mobile-filter-backdrop"></div>
  <a href="<%= book ? '/bd/' + book.id : '/bd' %>" class="wf-back-btn">&#8592; Retour</a>
  <button type="submit" form="bd-form" class="wf-save-btn bdf-save-fixed">Enregistrer</button>
  <% if (book) { %>
  <div class="wf-actions-right">
    <%- include('partials/lang-toggle', { editLang: locals.editLang || 'fr', editUrl: '/bd/' + book.id + '/edit' }) %>
  </div>
  <% } %>
  <% if (book) { %>
  <form method="POST" action="/bd/<%= book.id %>/delete" class="wf-delete-form-fixed"
    onsubmit="return confirm('Supprimer cette BD ?')">
    <button type="submit" class="wf-delete-btn-fixed" title="Supprimer la BD">&#128465;</button>
  </form>
  <% } %>


  <form method="POST" action="<%= book ? '/bd/' + book.id : '/bd' %>" enctype="multipart/form-data" class="bdf-form" id="bd-form" data-no-enter-submit>
    <% if (locals.editLang === 'en') { %><input type="hidden" name="_editLang" value="en" /><% } %>

    <%# ── COLONNE PRINCIPALE ───────────────────────────────────────── %>
    <div class="bdf-main">

      <% var _bdTitle = (locals.editLang === 'en') ? ((locals.translations || {}).title || '') : (book ? book.title : ''); %>
      <% var _bdDesc  = (locals.editLang === 'en') ? ((locals.translations || {}).description || '') : (book ? book.description : ''); %>

      <input type="text" name="title" class="wiki-title-input" required
        value="<%= _bdTitle %>" placeholder="<%= locals.editLang === 'en' && book ? book.title : 'Titre\u2026' %>" />

      <textarea name="description" class="wiki-textarea" rows="4"
        placeholder="<%= locals.editLang === 'en' && book ? book.description : 'Description (optionnel)\u2026' %>"><%= _bdDesc %></textarea>

      <% if (locals.editLang !== 'en') { %>
      <input type="text" name="author" class="wiki-input-sm" value="<%= book ? (book.author || '') : '' %>" placeholder="Auteur&hellip;" maxlength="200" />
      <% } %>

      <%# ── Chapitres & pages ── %>
      <div class="bdf-section bdf-chapters-outer">
        <div id="bdf-chapters-wrap">
          <%
            var _chGroups = [];
            if (locals.editLang !== 'en') {
              var _chs = book ? (book.chapters || []) : [];
              var _imgs = book ? (book.imagePaths || []) : [];
              if (_chs.length === 0) {
                _chGroups = [{ title: '', images: _imgs }];
              } else {
                for (var _ci = 0; _ci < _chs.length; _ci++) {
                  var _cStart = _chs[_ci].start;
                  var _cEnd = _ci + 1 < _chs.length ? _chs[_ci + 1].start : _imgs.length;
                  _chGroups.push({ title: _chs[_ci].title, images: _imgs.slice(_cStart, _cEnd) });
                }
              }
            }
          %>
          <% _chGroups.forEach(function(cg, ci) { %>
          <div class="bdf-ch-item" data-ch-idx="<%= ci %>">
            <div class="bdf-ch-head">
              <span class="bdf-ch-num">Chapitre <%= ci + 1 %></span>
              <input type="text" class="bdf-ch-title-inp" placeholder="Titre (optionnel)&hellip;" value="<%= cg.title %>" maxlength="120" />
              <% if (ci > 0) { %><button type="button" class="bdf-ch-remove-btn" title="Supprimer ce chapitre">&times;</button><% } %>
            </div>
            <div class="bd-sort-grid bdf-ch-grid">
              <% cg.images.forEach(function(src, i) { %>
                <div class="bd-sort-item" draggable="true" data-src="<%= src %>">
                  <div class="bd-sort-handle">&#8597;</div>
                  <img src="<%= thumbUrl(src) %>" alt="" class="bd-sort-img" loading="lazy" />
                  <span class="bd-sort-num"><%= i + 1 %></span>
                  <div class="bd-sort-move">
                    <button type="button" class="bd-sort-move-btn bd-sort-move-up" title="Haut">&#8593;</button>
                    <button type="button" class="bd-sort-move-btn bd-sort-move-down" title="Bas">&#8595;</button>
                  </div>
                  <label class="bd-sort-remove" title="Supprimer">
                    <input type="checkbox" name="remove_image" value="<%= src %>" class="bd-remove-cb" />
                    <span>&#215;</span>
                  </label>
                </div>
              <% }) %>
            </div>
            <div class="bdf-ch-previews"></div>
            <label class="wiki-image-add-label bdf-ch-add-label">
              <span>+ Pages</span>
              <input type="file" name="images" accept="image/*" multiple class="bdf-ch-file" />
            </label>
          </div>
          <% }) %>
        </div>
        <button type="button" class="bd-chapter-add-btn" id="bdf-add-chapter">+ Nouveau chapitre</button>
      </div>
      <input type="hidden" name="image_order" id="bd-image-order" value="" />
      <input type="hidden" name="chapters_json" id="bd-chapters-json" value="<%= JSON.stringify(book ? (book.chapters || []) : []) %>" />

      <div class="wiki-form-actions wf-mobile-actions">
        <button type="submit">Enregistrer</button>
      </div>
    </div><%# /bdf-main %>

    <%# ── VOLET LATÉRAL ────────────────────────────────────────────── %>
    <aside class="bdf-sidebar" id="mobile-filter-sidebar">
      <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer">&times;</button>

      <%# Catégories %>
      <% if (locals.editLang !== 'en') { %>
      <div class="bdf-sidebar-block">
        <p class="bdf-sidebar-label">Cat&eacute;gories</p>
        <div class="bdf-chips-grid">
          <% var bdCats = ['inconnu','groupe','monstre','pokémon','animaux','bdsm']; %>
          <% bdCats.forEach(function(cat) { %>
            <label class="chip-option">
              <input type="checkbox" name="categories" value="<%= cat %>"
                <%= (book && book.categories && book.categories.indexOf(cat) !== -1) ? 'checked' : '' %> />
              <span><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <% } %>

      <%# Langue %>
      <% if (locals.editLang !== 'en') { %>
      <div class="bdf-sidebar-block">
        <p class="bdf-sidebar-label">Langue</p>
        <div class="bdf-chips-wrap">
          <% var bdLangs = [['francais','<img src="https://flagcdn.com/20x15/fr.png" alt="" class="bd-flag-img"> Fran\u00e7ais'],['anglais','<img src="https://flagcdn.com/20x15/gb.png" alt="" class="bd-flag-img"> Anglais'],['japonais','<img src="https://flagcdn.com/20x15/jp.png" alt="" class="bd-flag-img"> Japonais'],['autre','\uD83C\uDF10 Autre']]; %>
          <% bdLangs.forEach(function(l) { %>
            <label class="chip-option">
              <input type="radio" name="langue" value="<%= l[0] %>" <%= (book && book.langue === l[0]) ? 'checked' : '' %> />
              <span><%- l[1] %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <% } %>

      <%# Flags %>
      <% if (locals.editLang !== 'en') { %>
      <div class="bdf-sidebar-block">
        <p class="bdf-sidebar-label">Flags</p>
        <div class="bdf-chips-wrap">
          <label class="chip-option wiki-owned-chip">
            <input type="checkbox" name="ultra"
              <%= (book && book.tags.some(function(t){ return t.toLowerCase() === 'ultra'; })) ? 'checked' : '' %> />
            <span>&#128274;&nbsp;Ultra</span>
          </label>
          <label class="chip-option">
            <input type="checkbox" name="couleur"
              <%= (book && book.tags.some(function(t){ return t.toLowerCase() === 'en couleur'; })) ? 'checked' : '' %> />
            <span>&#127775;&nbsp;En couleur</span>
          </label>
          <label class="chip-option">
            <input type="checkbox" name="irrealiste"
              <%= (book && book.tags.some(function(t){ return t.toLowerCase() === 'irréaliste'; })) ? 'checked' : '' %> />
            <span>Irr&eacute;aliste</span>
          </label>
        </div>
      </div>
      <% } %>

      <%# Tags %>
      <% if (locals.editLang !== 'en') { %>
      <div class="bdf-sidebar-block">
        <p class="bdf-sidebar-label">Tags</p>
        <div class="wiki-tags-widget">
          <div class="wiki-tags-board">
            <input type="text" class="wiki-tags-typing" placeholder="Tags&hellip;" autocomplete="off" />
          </div>
          <input type="hidden" name="tags" class="wiki-tags-hidden" value="<%= book ? book.tags.join(', ') : '' %>" />
        </div>
      </div>
      <% } %>

      <%# Parodie %>
      <% if (locals.editLang !== 'en') { %>
      <div class="bdf-sidebar-block">
        <p class="bdf-sidebar-label">Parodie</p>
        <%- include('partials/parody-input', {
              idPrefix:  'bdf',
              mainValue: book ? book.parody    : '',
              subValue:  book ? book.subParody : '',
              mainPh:    'Parodie (ex\u00a0: Pok\u00e9mon)\u2026'
            }) %>
      </div>
      <% } %>

      <%# Personnages %>
      <% if (locals.allProtagonists && allProtagonists.length && locals.editLang !== 'en') { %>
      <div class="bdf-sidebar-block">
        <p class="bdf-sidebar-label">Personnages</p>
        <div class="lbep-section" style="margin-top:0">
          <div class="lbep-chips" id="bdf-prot-chips">
            <% (book ? book.protagonistIds : []).forEach(function(pid) {
                 var p = allProtagonists.find(function(x){ return x.id === pid; });
                 if (p) { %>
              <span class="lbep-chip" data-prot-id="<%= p.id %>">
                <span><%= p.name %></span>
                <button type="button" class="lbep-chip-x">&times;</button>
              </span>
            <% } }) %>
          </div>
          <div style="position:relative">
            <input type="text" class="lbep-input" id="bdf-prot-inp" placeholder="Ajouter un personnage&hellip;" autocomplete="off" />
            <ul class="lbep-ac-drop" id="bdf-prot-drop" hidden></ul>
          </div>
          <div id="bdf-prot-hiddens"></div>
        </div>
      </div>
      <% } %>

    </aside><%# /bdf-sidebar %>

  </form>
</main>
<script nonce="<%= nonce %>">
window.BD_PROTAGONISTS = <%- JSON.stringify((locals.allProtagonists || []).reduce(function(m, p) { m[p.id] = p.name; return m; }, {})) %>;
window.BD_TOTAL_PAGES = <%= book ? (book.imagePaths ? book.imagePaths.length : 0) : 0 %>;
</script>
<script nonce="<%= nonce %>" src="/wiki.js?v=<%= assetVersion %>"></script>
<script nonce="<%= nonce %>" src="/bd.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
