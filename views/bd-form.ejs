<%- include('partials/head', { title: 'BD : ' + (book ? 'Modifier ' + book.title : 'Nouvelle BD') }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>
  <a href="<%= book ? '/bd/' + book.id : '/bd' %>" class="link-button">&larr; Retour</a>

  <h1 class="section-title-h1"><%= book ? 'Modifier' : 'Nouvelle BD' %></h1>

  <form method="POST" action="<%= book ? '/bd/' + book.id : '/bd' %>" enctype="multipart/form-data" class="wiki-form" id="bd-form">

    <input type="text" name="title" class="wiki-title-input" required
      value="<%= book ? book.title : '' %>" placeholder="Titre&hellip;" />

    <textarea name="description" class="wiki-textarea" rows="3"
      placeholder="Description (optionnel)&hellip;"><%= book ? book.description : '' %></textarea>

    <%# Tags %>
    <div class="wiki-tags-widget">
      <div class="wiki-tags-board">
        <input type="text" class="wiki-tags-typing" placeholder="Tags&hellip;" autocomplete="off" />
      </div>
      <input type="hidden" name="tags" class="wiki-tags-hidden" value="<%= book ? book.tags.join(', ') : '' %>" />
    </div>

    <%# Langue %>
    <div class="bd-form-chips">
      <span class="wiki-meta-label">Langue</span>
      <% var bdLangs = [['francais','🇫🇷 Français'],['anglais','🇬🇧 Anglais'],['japonais','🇯🇵 Japonais'],['autre','Autre']]; %>
      <% bdLangs.forEach(function(l) { %>
        <label class="chip-option">
          <input type="radio" name="langue" value="<%= l[0] %>" <%= (book && book.langue === l[0]) ? 'checked' : '' %> />
          <span><%= l[1] %></span>
        </label>
      <% }) %>
    </div>

    <%# Flags spéciaux %>
    <div class="bd-form-chips">
      <label class="chip-option wiki-owned-chip">
        <input type="checkbox" name="ultra" <%= (book && book.tags.some(function(t){ return t.toLowerCase() === 'ultra'; })) ? 'checked' : '' %> />
        <span>&#128274;&nbsp;Marquer Ultra</span>
      </label>
      <label class="chip-option">
        <input type="checkbox" name="couleur" <%= (book && book.tags.some(function(t){ return t.toLowerCase() === 'en couleur'; })) ? 'checked' : '' %> />
        <span>&#127775;&nbsp;En couleur</span>
      </label>
    </div>

    <%# Tri + images existantes %>
    <% if (book && book.imagePaths && book.imagePaths.length) { %>
      <div class="bd-form-section">
        <p class="wiki-meta-label">Pages (glisser pour r&eacute;ordonner)</p>
        <div class="bd-sort-grid" id="bd-sort-grid">
          <% book.imagePaths.forEach(function(src, i) { %>
            <div class="bd-sort-item" draggable="true" data-src="<%= src %>">
              <div class="bd-sort-handle">&#8597;</div>
              <img src="<%= thumbUrl(src) %>" alt="" class="bd-sort-img" loading="lazy" />
              <span class="bd-sort-num"><%= i + 1 %></span>
              <label class="bd-sort-remove" title="Supprimer cette page">
                <input type="checkbox" name="remove_image" value="<%= src %>" class="bd-remove-cb" />
                <span>&#215;</span>
              </label>
            </div>
          <% }) %>
        </div>
        <input type="hidden" name="image_order" id="bd-image-order" value="<%= book.imagePaths.join(',') %>" />
      </div>
    <% } else { %>
      <input type="hidden" name="image_order" id="bd-image-order" value="" />
    <% } %>

    <%# Nouvelles images %>
    <div class="bd-form-section">
      <label class="wiki-image-add-label">
        <span>+ Ajouter des pages</span>
        <input type="file" name="images" accept="image/*" multiple class="wiki-image-input" id="bd-file-input" />
      </label>
      <div class="bd-new-previews" id="bd-new-previews"></div>
    </div>

    <div class="wiki-form-actions">
      <button type="submit">Enregistrer</button>
      <% if (book) { %>
        <form method="POST" action="/bd/<%= book.id %>/delete" style="display:inline" onsubmit="return confirm('Supprimer cette BD ?')">
          <button type="submit" class="link-delete-btn-text">Supprimer</button>
        </form>
      <% } %>
    </div>
  </form>
</main>
<script src="/bd.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
