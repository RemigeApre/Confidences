<%
  var worldMap  = { 'DL': 'Eau', 'DP': 'Air', 'BL': 'Terre', 'BP': 'Feu' };
  var worldMeta = {
    'DL': { name: 'Eau',   tagline: 'Douceur et lien',        hue: 210 },
    'DP': { name: 'Air',   tagline: 'Douceur et sensation',   hue: 160 },
    'BL': { name: 'Terre', tagline: 'Intensité et lien',      hue: 35  },
    'BP': { name: 'Feu',   tagline: 'Intensité et sensation', hue: 15  }
  };
  var worldOrder = ['DL', 'DP', 'BL', 'BP'];

  var code        = attempt.result_code || '';
  var worldKey    = code.slice(0, 2);
  var world       = worldMap[worldKey] || (archetype && archetype.world) || '';
  var normalAxes  = axes.filter(function(a) { return !a.is_position; });
  var posAxes     = axes.filter(function(a) { return  a.is_position; });
  var archetypesList = typeof archetypes !== 'undefined' ? archetypes : [];

  function firstSentence(text) {
    if (!text) return '';
    var i = text.indexOf('. ');
    return i > 0 ? text.slice(0, i + 1) : text.slice(0, 140);
  }
%>
<%- include('partials/head', { title: (archetype ? archetype.name : code) + ' — ' + type.name }) %>
<%
  var wm = worldMeta[worldKey] || { hue: 270 };
  var wHue = wm.hue;
%>
<main class="container" style="--ch-hue: <%= wHue %>; --world-hue: <%= wHue %>">
  <%- include('partials/top-nav', { config: config, navTitle: type.name, navBack: '/quizz/profil' }) %>

  <div class="pqres-wrap">

    <%# ── Héro ── %>
    <div class="pqres-hero">
      <div class="pqres-code"><%= code %>&nbsp;&middot;&nbsp;<%= attempt.result_position %></div>
      <% if (world) { %><div class="pqres-world">Monde&nbsp;: <%= world %></div><% } %>
      <div class="pqres-archetype"><%= archetype ? archetype.name : code %></div>
      <% if (archetype && archetype.description) { %>
      <p class="pqres-desc"><%= archetype.description %></p>
      <% } %>
    </div>

    <%# ── Carte profil ── %>
    <div class="pqres-profile-card">
      <div class="pqres-profile-card-inner">
        <span class="pqres-profile-card-label">Mon profil</span>
        <span class="pqres-profile-card-code"><%= code %>-<%= attempt.result_position %></span>
        <span class="pqres-profile-card-name"><%= archetype ? archetype.name : '' %></span>
      </div>
      <button class="pqres-copy-btn" id="pqres-copy-btn" title="Copier mon code" aria-label="Copier mon code">⎘</button>
    </div>

    <%# ── Axes ── %>
    <div class="pqres-axes">
      <% normalAxes.forEach(function(axis) { %>
      <% var pct = scores[axis.slug] != null ? scores[axis.slug] : 0.5; %>
      <% var pctDisplay = Math.round(pct * 100); %>
      <% var pole1Dom = pct >= 0.5; %>
      <% var domLabel = pole1Dom ? axis.pole1_label : axis.pole2_label; %>
      <% var domPct   = pole1Dom ? pctDisplay : (100 - pctDisplay); %>
      <div class="pqres-axis">
        <div class="pqres-axis-header">
          <span class="pqres-axis-name"><%= axis.name %></span>
          <span class="pqres-axis-dominant"><%= domLabel %>&nbsp;<strong><%= domPct %>%</strong></span>
        </div>
        <div class="pqres-axis-bar-wrap">
          <span class="pqres-axis-pole<%= !pole1Dom ? ' pqres-axis-pole--faded' : '' %>"><%= axis.pole1_label %></span>
          <div class="pqres-axis-track">
            <div class="pqres-axis-fill" style="width:<%= pctDisplay %>%"></div>
          </div>
          <span class="pqres-axis-pole pqres-axis-pole--right<%= pole1Dom ? ' pqres-axis-pole--faded' : '' %>"><%= axis.pole2_label %></span>
        </div>
      </div>
      <% }) %>

      <% if (posAxes.length && scores['position_mener'] != null) { %>
      <%
        var menPct = Math.round(scores['position_mener'] * 100);
        var laiPct = Math.round(scores['position_laisser'] * 100);
      %>
      <div class="pqres-axis">
        <div class="pqres-axis-header">
          <span class="pqres-axis-name">Position</span>
        </div>
        <div class="pqres-axis-pos-row">
          <div class="pqres-axis-pos-item">
            <div class="pqres-axis-bar-wrap">
              <span class="pqres-axis-pole">Mener</span>
              <div class="pqres-axis-track">
                <div class="pqres-axis-fill" style="width:<%= menPct %>%"></div>
              </div>
              <span class="pqres-axis-pct"><%= menPct %>%</span>
            </div>
          </div>
          <div class="pqres-axis-pos-item">
            <div class="pqres-axis-bar-wrap">
              <span class="pqres-axis-pole">Se laisser mener</span>
              <div class="pqres-axis-track">
                <div class="pqres-axis-fill" style="width:<%= laiPct %>%"></div>
              </div>
              <span class="pqres-axis-pct"><%= laiPct %>%</span>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <%# ── Historique ── %>
    <% if (history && history.length > 1) { %>
    <div class="pqres-history">
      <p class="pqres-history-title">Historique</p>
      <div class="pqres-history-list">
        <% history.forEach(function(h) { %>
        <a href="/quizz/profil/<%= type.slug %>/result/<%= h.id %>" class="pqres-history-item">
          <span class="pqres-history-code"><%= h.result_code %>-<%= h.result_position %></span>
          <span class="pqres-history-arch"><%= h.result_archetype %></span>
          <span class="pqres-history-date"><%= h.created_at ? h.created_at.slice(0,10) : '' %></span>
        </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <%# ── Actions ── %>
    <div class="pqres-actions">
      <a href="/quizz/profil/<%= type.slug %>" class="pqt-card-btn" style="text-decoration:none">Repasser le test</a>
      <a href="/quizz/profil" class="pqtake-nav-btn" style="text-decoration:none">Retour aux profils</a>
    </div>

    <%# ── Volet archétypes ── %>
    <% if (archetypesList.length > 0) { %>
    <details class="pqres-arch-panel">
      <summary class="pqres-arch-panel-summary">
        <span class="pqres-arch-panel-title">Les 32 archétypes</span>
        <span class="pqres-arch-panel-hint">Explorer tous les profils</span>
        <span class="pqres-arch-panel-chevron">›</span>
      </summary>

      <div class="pqres-arch-panel-body">
        <p class="pqres-arch-panel-intro">
          Chaque monde regroupe huit êtres. Les profils <strong>Confort (C)</strong> sont des animaux réels,
          les profils <strong>Expérimental (E)</strong> des créatures de légende. Le code se lit
          Rythme&nbsp;· Moteur&nbsp;· Nouveauté&nbsp;· Scénario&nbsp;· Plaisir.
        </p>

        <% worldOrder.forEach(function(wk) { %>
        <% var wm = worldMeta[wk]; %>
        <% var worldArchs = archetypesList.filter(function(a){ return a.code && a.code.slice(0,2) === wk; }); %>
        <% var isMyWorld = code.slice(0,2) === wk; %>

        <details class="pqres-world-block" <%= isMyWorld ? 'open' : '' %>>
          <summary class="pqres-world-head">
            <span class="pqres-world-dot" style="background:hsl(<%= wm.hue %>,60%,55%)"></span>
            <span class="pqres-world-name">Monde&nbsp;<%= wm.name %></span>
            <span class="pqres-world-tagline"><%= wm.tagline %>&nbsp;&middot;&nbsp;<%= wk %></span>
            <span class="pqres-world-chevron">›</span>
          </summary>
          <div class="pqres-world-body">
            <% worldArchs.forEach(function(a) { %>
            <div class="pqres-arch-item<%= a.code === code ? ' is-mine' : '' %>">
              <div class="pqres-arch-code-col">
                <span class="pqres-arch-code"><%= a.code %></span>
              </div>
              <div class="pqres-arch-info">
                <div class="pqres-arch-name-row">
                  <span class="pqres-arch-name"><%= a.name %></span>
                  <% if (a.code === code) { %>
                  <span class="pqres-arch-mine-badge">Mon profil</span>
                  <% } %>
                </div>
                <% if (a.description) { %>
                <p class="pqres-arch-short"><%= firstSentence(a.description) %></p>
                <% } %>
              </div>
            </div>
            <% }); %>
          </div>
        </details>

        <% }); %>
      </div>
    </details>
    <% } %>

  </div>

  <%- include('partials/foot') %>
</main>
<script nonce="<%= nonce %>">
(function() {
  var copyBtn = document.getElementById('pqres-copy-btn');
  if (!copyBtn) return;
  var profileText = '<%= code %>-<%= attempt.result_position %><%= archetype ? " \u00b7 " + archetype.name : "" %>';
  copyBtn.addEventListener('click', function() {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(profileText).then(function() {
        copyBtn.textContent = '\u2713';
        setTimeout(function(){ copyBtn.textContent = '\u2398'; }, 1500);
      });
    }
  });
})();
</script>
