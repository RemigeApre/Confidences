<%
  var _base = locals.selfView ? '/couple/mon-profil' : '/couple';
  var _title = locals.selfView ? 'Mon profil' : ('Couple : ' + partner.displayName);
  var _navTitle = locals.selfView ? 'Mon profil' : partner.displayName;
%>
<%- include('partials/head', { title: _title }) %>
<main class="container wide gallery-has-sidebar profil-page">
  <%- include('partials/top-nav', { config: config, navTitle: _navTitle, navBack: locals.selfView ? '/couple' : '/favoris' }) %>

  <%- include('partials/couple-nav', { partner: partner }) %>

  <div class="profil-subpage profil-subpage--wide cpa-accueil-layout">

    <%# ─ Colonne principale : blocs ─ %>
    <div class="cpa-accueil-main">

      <% if (!blocks || !blocks.length) { %>
        <div class="profil-empty">
          <div class="profil-empty-icon">&#10024;</div>
          <% if (locals.selfView) { %>
            <p>Choisissez les blocs &agrave; afficher sur votre accueil.</p>
            <a href="/couple/mon-profil/accueil-config" class="cpa-config-link">Configurer l&rsquo;accueil</a>
          <% } else { %>
            <p><%= partner.displayName %> n&rsquo;a encore rien configur&eacute; ici.</p>
          <% } %>
        </div>
      <% } %>

      <% if (blocks) { blocks.forEach(function(block) { %>
        <% if (block.items && block.items.length) { %>
        <section class="cnw-section">
          <h2 class="cnw-section-title cnw-section-title--<%= block.type %>">
            <% if (block.type === 'flame') { %>
              <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15" aria-hidden="true"><path d="M12 2C9.86 5.72 8 8 8 11a4 4 0 0 0 8 0c0-1.5-.5-3-1-4.5C13.5 8 13 9 13 10.5a1.5 1.5 0 0 1-3 0C10 7 11.5 4.5 12 2z"/></svg>
            <% } else if (block.type === 'interested') { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <% } else if (block.type === 'practiced') { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <% } else if (block.type === 'rated') { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <% } else if (block.type === 'objets_wish') { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true"><path d="M20 12v10H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
            <% } else if (block.type === 'objets_have') { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/><path d="M8 7V5a2 2 0 0 0-4 0v2"/></svg>
            <% } %>
            <% if (block.type === 'interested') { %>
              Int&eacute;ress&eacute;<%= partner.sexe === 'femme' ? 'e' : '' %>
            <% } else { %>
              <%= block.label %>
            <% } %>
            <span class="cnw-count"><%= block.items.length %></span>
          </h2>
          <div class="cpa-strip-wrap">
            <div class="cpa-strip">
              <% block.items.slice(0, 12).forEach(function(page) { %>
                <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
              <% }) %>
            </div>
          </div>
        </section>
        <% } %>
      <% }); } %>

      <% if (locals.selfView) { %>
        <a href="/couple/mon-profil/accueil-config" class="cpa-config-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 10 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 5.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Configurer l&rsquo;accueil
        </a>
      <% } %>

    </div>

    <%# ─ Rail droit : tuiles catégories verticales ─ %>
    <nav class="cpa-cat-rail" aria-label="Cat&eacute;gories">
      <% categories.forEach(function(cat) {
           var c = catCounts[cat.key] || { total: 0, flame: 0 };
      %>
        <a href="<%= _base %>/notes/<%= cat.key %>"
           class="cpa-rail-tile<%= !c.total ? ' cpa-rail-tile--empty' : '' %>"
           style="--tile-hue:<%= cat.hue %>">
          <span class="cpa-rail-label"><%= cat.label %></span>
          <% if (c.total) { %><span class="cpa-rail-count"><%= c.total %></span><% } %>
        </a>
      <% }) %>
      <a href="<%= _base %>/medias"
         class="cpa-rail-tile<%= (!medias.images && !medias.bd) ? ' cpa-rail-tile--empty' : '' %>"
         style="--tile-hue:200">
        <span class="cpa-rail-label">M&eacute;dias</span>
        <% if (medias.images || medias.bd) { %><span class="cpa-rail-count"><%= medias.images + medias.bd %></span><% } %>
      </a>
    </nav>

  </div>

</main>
<%- include('partials/foot') %>
