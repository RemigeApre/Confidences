<%
  var _base = locals.selfView ? '/couple/mon-profil' : '/couple';
  var _title = locals.selfView ? 'Mon profil' : ('Couple : ' + partner.displayName);
  var _navTitle = locals.selfView ? 'Mon profil' : partner.displayName;
  var _hasAny = categories.some(function(c){ return catCounts[c.key] && catCounts[c.key].total > 0; }) || medias.images > 0 || medias.bd > 0;
%>
<%- include('partials/head', { title: _title }) %>
<main class="container wide gallery-has-sidebar profil-page">
  <%- include('partials/top-nav', { config: config, navTitle: _navTitle, navBack: locals.selfView ? '/couple' : '/favoris' }) %>

  <%- include('partials/couple-nav', { partner: partner }) %>

  <div class="profil-subpage profil-subpage--wide">

    <%# ─ Identité ─ %>
    <div class="cpa-hero">
      <div class="cpa-avatar" style="<%= partner.profileColor ? 'background:' + partner.profileColor : '' %>">
        <%= (partner.displayName || '?').charAt(0).toUpperCase() %>
      </div>
      <div class="cpa-hero-body">
        <h1 class="cpa-name"><%= partner.displayName %></h1>
        <p class="cpa-label"><%= locals.selfView ? 'Votre profil' : 'Votre partenaire' %></p>
      </div>
    </div>

    <%# ─ Tuiles catégories codex ─ %>
    <div class="cpa-cat-tiles">
      <% categories.forEach(function(cat) {
           var c = catCounts[cat.key] || { total: 0, flame: 0 };
      %>
        <a href="<%= _base %>/notes/<%= cat.key %>" class="cpa-cat-tile<%= !c.total ? ' cpa-cat-tile--empty' : '' %>" style="--tile-hue:<%= cat.hue %>">
          <span class="cpa-cat-tile-label"><%= cat.label %></span>
          <span class="cpa-cat-tile-count"><%= c.total %></span>
          <% if (c.flame) { %><span class="cpa-cat-tile-flame"><%= c.flame %> j&rsquo;adore</span><% } %>
        </a>
      <% }) %>

      <%# ─ Tuile Médias ─ %>
      <a href="<%= _base %>/medias" class="cpa-cat-tile cpa-cat-tile--medias<%= (!medias.images && !medias.bd) ? ' cpa-cat-tile--empty' : '' %>" style="--tile-hue:200">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        <span class="cpa-cat-tile-label">Médias</span>
        <span class="cpa-cat-tile-count"><%= medias.images + medias.bd %></span>
        <% if (medias.images && medias.bd) { %><span class="cpa-cat-tile-flame"><%= medias.images %> img · <%= medias.bd %> BD</span><% } %>
      </a>
    </div>

    <%# ─ Strip J'adore ─ %>
    <% if (flameWiki.length) { %>
    <section class="cpa-section">
      <div class="cpa-section-hd">
        <h2 class="cpa-section-title">
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M12 2C9.86 5.72 8 8 8 11a4 4 0 0 0 8 0c0-1.5-.5-3-1-4.5C13.5 8 13 9 13 10.5a1.5 1.5 0 0 1-3 0C10 7 11.5 4.5 12 2z"/></svg>
          J&rsquo;adore
        </h2>
      </div>
      <div class="cpa-strip-wrap">
        <div class="cpa-strip">
          <% flameWiki.forEach(function(page) { %>
            <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (!_hasAny) { %>
      <p class="cpa-empty"><%= partner.displayName %> n&rsquo;a encore rien not&eacute;.</p>
    <% } %>

  </div>

</main>
<%- include('partials/foot') %>
