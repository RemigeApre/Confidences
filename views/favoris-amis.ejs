<%- include('partials/head', { title: 'Amis' }) %>
<main class="container wide profil-page gallery-has-sidebar amis-page">
  <%- include('partials/top-nav', { config: config }) %>
  <%- include('partials/profil-nav', { roleHue: roleHue }) %>

  <%# ── Volet droit : liste des amis ───────────────────────────────── %>
  <aside class="amis-right-panel" id="amis-right-panel">
    <div class="amis-rp-head">
      <span class="amis-rp-title">
        Mes amis
        <% if (friends && friends.length) { %><span class="amis-rp-count"><%= friends.length %></span><% } %>
      </span>
      <div class="amis-rp-view-toggle">
        <button class="amis-rp-view-btn amis-rp-view-btn--active" id="amis-view-card" title="Vue carte" aria-label="Vue carte">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
        </button>
        <button class="amis-rp-view-btn" id="amis-view-list" title="Vue liste" aria-label="Vue liste">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="2" width="14" height="2" rx="1"/><rect x="1" y="7" width="14" height="2" rx="1"/><rect x="1" y="12" width="14" height="2" rx="1"/></svg>
        </button>
      </div>
    </div>

    <% if (!friends || !friends.length) { %>
      <p class="amis-rp-empty">Aucun ami pour l&rsquo;instant.</p>
    <% } else { %>
    <ul class="amis-rp-grid" id="amis-rp-grid">
      <% friends.forEach(function(f) { %>
      <li class="amis-rp-item<%= f.themeLight ? ' amis-rp-item--light' : '' %>" style="<%= f.themeBg ? 'background:'+f.themeBg+';border-color:'+f.themeBorder : '' %>">
        <% if (f.thumb) { %>
          <div class="amis-rp-avatar amis-rp-avatar--img" style="background-image:url('<%= f.thumb %>')"></div>
        <% } else { %>
          <div class="amis-rp-avatar" style="background:<%= f.profile_color || '#6b7280' %>"><%= (f.display_name || '?').charAt(0).toUpperCase() %></div>
        <% } %>
        <div class="amis-rp-item-info">
          <a href="/profil/<%= f.display_name || f.username %>" class="amis-rp-item-name"><%= f.display_name %></a>
          <span class="amis-rp-item-code">#<%= f.friend_code %></span>
        </div>
        <a href="/messages/<%= f.id %>" class="amis-rp-msg" title="Message" aria-label="Message">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </a>
        <form method="POST" action="/favoris/amis/<%= f.id %>/supprimer" class="amis-inline-form"
              onsubmit="return confirm('Retirer <%= f.display_name %> de vos amis ?')">
          <button class="amis-rp-remove" type="submit" title="Retirer" aria-label="Retirer <%= f.display_name %>">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="4" x2="4" y2="12"/><line x1="4" y1="4" x2="12" y2="12"/></svg>
          </button>
        </form>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </aside>

  <div class="profil-subpage amis-main-content">

    <%# ── Blocs invite : 3 cartes distinctes ── %>
    <div class="amis-cards-row">

      <%# Carte 1 : Lien d'invitation %>
      <div class="amis-card">
        <span class="amis-card-label">Lien d&rsquo;invitation</span>
        <div class="amis-link-row">
          <input class="amis-link-input" id="amis-inv-link" type="text" readonly />
          <button class="amis-link-copy-btn" id="amis-inv-copy" type="button">Copier</button>
        </div>
        <% if (inviteStats && inviteStats.total > 0) { %>
          <p class="amis-card-sub"><%= inviteStats.total %> personne<%= inviteStats.total > 1 ? 's ont' : ' a' %> rejoint via votre lien.</p>
        <% } %>
        <p class="amis-card-notice">+18&nbsp;ans uniquement. En partageant ce lien vous engagez votre responsabilit&eacute; quant &agrave; la majorit&eacute; de la personne invit&eacute;e.</p>
      </div>

      <%# Carte 2 : Mon code %>
      <div class="amis-card">
        <span class="amis-card-label">Mon code</span>
        <div class="amis-code-row">
          <span class="amis-code-display" id="amis-my-code"><%= currentUser.displayName %>#<%= friendCode %></span>
          <button class="amis-link-copy-btn" id="amis-code-copy-btn" type="button">Copier</button>
        </div>
        <p class="amis-card-sub">Communiquez ce code pour que quelqu&rsquo;un vous ajoute en ami.</p>
      </div>

      <%# Carte 3 : Ajouter par code %>
      <div class="amis-card">
        <span class="amis-card-label">Ajouter un ami</span>
        <form method="POST" action="/favoris/amis/demande" class="amis-add-form">
          <input class="amis-add-input" type="text" name="code" placeholder="pseudo#1234"
                 value="<%= searchQuery || '' %>" autocomplete="off" maxlength="80" autofocus />
          <button class="amis-add-btn" type="submit">Envoyer</button>
        </form>
        <% if (searchError) { %>
          <p class="amis-feedback amis-feedback--error"><%= searchError %></p>
        <% } %>
        <% if (searchResult) { %>
          <p class="amis-feedback amis-feedback--ok">
            <% if (searchResult.autoAccepted) { %>
              Vous &ecirc;tes amis avec <strong><%= searchResult.target.displayName %></strong>.
            <% } else { %>
              Demande envoy&eacute;e &agrave; <strong><%= searchResult.target.displayName %></strong>.
            <% } %>
          </p>
        <% } %>
      </div>

    </div>

    <%# ── Inscriptions à valider (FR) ── %>
    <% if (pendingInvites && pendingInvites.length) { %>
    <section class="amis-section">
      <h2 class="amis-section-title">
        Inscriptions &agrave; valider
        <span class="amis-count-badge"><%= pendingInvites.length %></span>
      </h2>
      <ul class="amis-list">
        <% pendingInvites.forEach(function(inv) { %>
        <li class="amis-row">
          <div class="amis-row-avatar" style="background:#6b7280"><%= (inv.display_name || '?').charAt(0).toUpperCase() %></div>
          <div class="amis-row-info">
            <span class="amis-row-name"><%= inv.display_name %></span>
            <span class="amis-row-code">@<%= inv.username %></span>
            <span class="amis-row-date"><%= new Date(inv.created_at).toLocaleDateString('fr-FR') %></span>
          </div>
          <div class="amis-row-actions">
            <form method="POST" action="/favoris/invitations/<%= inv.id %>/approve" class="amis-inline-form">
              <button class="amis-btn amis-btn--accept" type="submit">Valider</button>
            </form>
            <form method="POST" action="/favoris/invitations/<%= inv.id %>/refuse" class="amis-inline-form">
              <button class="amis-btn amis-btn--refuse" type="submit">Refuser</button>
            </form>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <%# ── Demandes reçues ── %>
    <% if (received && received.length) { %>
    <section class="amis-section">
      <h2 class="amis-section-title">
        Demandes re&ccedil;ues
        <span class="amis-count-badge"><%= received.length %></span>
      </h2>
      <ul class="amis-list">
        <% received.forEach(function(r) { %>
        <li class="amis-row">
          <% if (r.thumb) { %>
            <div class="amis-row-avatar amis-row-avatar--img" style="background-image:url('<%= r.thumb %>')"></div>
          <% } else { %>
            <div class="amis-row-avatar" style="background:<%= r.profile_color || '#6b7280' %>"><%= (r.display_name || '?').charAt(0).toUpperCase() %></div>
          <% } %>
          <div class="amis-row-info">
            <span class="amis-row-name"><%= r.display_name %></span>
            <span class="amis-row-code">#<%= r.friend_code %></span>
          </div>
          <div class="amis-row-actions">
            <form method="POST" action="/favoris/amis/<%= r.id %>/accepter" class="amis-inline-form">
              <button class="amis-btn amis-btn--accept" type="submit">Accepter</button>
            </form>
            <form method="POST" action="/favoris/amis/<%= r.id %>/refuser" class="amis-inline-form">
              <button class="amis-btn amis-btn--refuse" type="submit">Refuser</button>
            </form>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <%# ── Demandes envoyées ── %>
    <% if (sent && sent.length) { %>
    <section class="amis-section">
      <h2 class="amis-section-title">En attente de r&eacute;ponse</h2>
      <ul class="amis-list">
        <% sent.forEach(function(s) { %>
        <li class="amis-row">
          <% if (s.thumb) { %>
            <div class="amis-row-avatar amis-row-avatar--img" style="background-image:url('<%= s.thumb %>')"></div>
          <% } else { %>
            <div class="amis-row-avatar" style="background:<%= s.profile_color || '#6b7280' %>"><%= (s.display_name || '?').charAt(0).toUpperCase() %></div>
          <% } %>
          <div class="amis-row-info">
            <span class="amis-row-name"><%= s.display_name %></span>
            <span class="amis-row-code">#<%= s.friend_code %></span>
          </div>
          <span class="amis-row-status">En attente...</span>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

  </div>
</main>

<script nonce="<%= nonce %>">
(function () {
  function copyText(text, btn) {
    navigator.clipboard.writeText(text).catch(function () {});
    var orig = btn.textContent;
    btn.textContent = 'Copi\u00e9 !';
    setTimeout(function () { btn.textContent = orig; }, 2000);
  }

  var invLink  = window.location.origin + '/rejoindre/<%= locals.inviteToken || "" %>';
  var invInput = document.getElementById('amis-inv-link');
  var invCopy  = document.getElementById('amis-inv-copy');
  if (invInput) invInput.value = invLink;
  if (invCopy)  invCopy.addEventListener('click', function () { copyText(invLink, invCopy); });

  var codeEl   = document.getElementById('amis-my-code');
  var codeCopy = document.getElementById('amis-code-copy-btn');
  if (codeEl && codeCopy) {
    codeCopy.addEventListener('click', function () { copyText(codeEl.textContent.trim(), codeCopy); });
  }

  // Vue carte / liste
  var grid     = document.getElementById('amis-rp-grid');
  var btnCard  = document.getElementById('amis-view-card');
  var btnList  = document.getElementById('amis-view-list');
  var VIEW_KEY = 'amis-view';

  function applyView(v) {
    if (!grid) return;
    grid.classList.toggle('amis-rp-grid--list', v === 'list');
    if (btnCard) btnCard.classList.toggle('amis-rp-view-btn--active', v === 'card');
    if (btnList) btnList.classList.toggle('amis-rp-view-btn--active', v === 'list');
    localStorage.setItem(VIEW_KEY, v);
  }

  applyView(localStorage.getItem(VIEW_KEY) || 'card');
  if (btnCard) btnCard.addEventListener('click', function () { applyView('card'); });
  if (btnList) btnList.addEventListener('click', function () { applyView('list'); });
})();
</script>

<%- include('partials/foot') %>
