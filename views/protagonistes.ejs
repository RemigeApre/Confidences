<%- include('partials/head', { title: 'Personnages' }) %>
<main class="container wide gallery-has-sidebar" style="--ch-hue: 340">
  <%- include('partials/top-nav', { config: config, navTitle: 'Personnages', navTitleEn: 'Characters', navBack: '/' }) %>
  <%- include('partials/mobile-filter-toggle') %>

  <%# ── Volet gauche ──────────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer les filtres">&times;</button>
    <%- include('partials/sidebar-hero', { title: 'Personnages', titleEn: 'Characters', hue: 340, count: protagonistes.length, countId: 'prot-count-hero' }) %>

    <div class="wiki-sidebar-body">
      <div class="wiki-sidebar-filters">

        <%# Genre %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label" data-fr="Genre" data-en="Gender">Genre</span>
          <div class="links-filter" id="prot-gender-filter">
            <button type="button" class="tag-chip active" data-gender="" data-fr="Tous" data-en="All">Tous</button>
            <button type="button" class="tag-chip" data-gender="femme" data-fr="Femme" data-en="Female">Femme</button>
            <button type="button" class="tag-chip" data-gender="homme" data-fr="Homme" data-en="Male">Homme</button>
            <button type="button" class="tag-chip" data-gender="autre" data-fr="Autre" data-en="Other">Autre</button>
          </div>
        </div>

        <%# Nature %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label" data-fr="Nature" data-en="Nature">Nature</span>
          <div class="links-filter" id="prot-nature-filter">
            <button type="button" class="tag-chip active" data-nature="" data-fr="Toutes" data-en="All">Toutes</button>
            <button type="button" class="tag-chip" data-nature="humain" data-fr="Humain" data-en="Human">Humain</button>
            <button type="button" class="tag-chip" data-nature="monstre" data-fr="Monstre" data-en="Monster">Monstre</button>
            <button type="button" class="tag-chip" data-nature="animal" data-fr="Animal" data-en="Animal">Animal</button>
            <button type="button" class="tag-chip" data-nature="pokemon" data-fr="Pokémon" data-en="Pokémon">Pok&eacute;mon</button>
            <button type="button" class="tag-chip" data-nature="autre" data-fr="Autre" data-en="Other">Autre</button>
          </div>
        </div>

        <% if (races && races.length) { %>
        <%# Race / Espèce %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label" data-fr="Race / Espèce" data-en="Race / Species">Race / Esp&egrave;ce</span>
          <div class="links-filter" id="prot-race-filter">
            <button type="button" class="tag-chip active" data-race="">Toutes</button>
            <% races.forEach(function(r) { %>
              <button type="button" class="tag-chip" data-race="<%= r.id %>"
                style="<%= r.color ? '--chip-accent:' + r.color : '' %>">
                <%= r.icon ? r.icon + ' ' : '' %><%= r.name %>
              </button>
            <% }) %>
          </div>
        </div>
        <% } %>

        <% if (parodies && parodies.length) { %>
        <%# Univers %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label" data-fr="Univers" data-en="Universe">Univers</span>
          <div class="links-filter" id="prot-parody-filter">
            <button type="button" class="tag-chip active" data-parody="">Tous</button>
            <% parodies.forEach(function(par) { %>
              <button type="button" class="tag-chip" data-parody="<%= par %>"><%= par %></button>
            <% }) %>
          </div>
        </div>
        <% } %>

        <%# Ultra / Irréaliste %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label" data-fr="Contenu" data-en="Content">Contenu</span>
          <div class="links-filter">
            <button type="button" class="wiki-ultra-btn" id="prot-ultra-toggle" data-fr="Afficher Ultra" data-en="Show Ultra">Afficher Ultra</button>
            <button type="button" class="wiki-ultra-btn" id="prot-irrealiste-toggle" data-fr="Masquer Irréaliste" data-en="Hide Unrealistic">Masquer Irréaliste</button>
          </div>
        </div>

        <%# Versions liées %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label" data-fr="Versions" data-en="Versions">Versions</span>
          <div class="links-filter">
            <button type="button" class="wiki-ultra-btn" id="prot-children-toggle" data-fr="Afficher versions" data-en="Show versions">Afficher versions</button>
          </div>
        </div>

      </div>
    </div>
  </aside>

  <%# ── Grille principale ─────────────────────────────────────────────── %>
  <% if (!protagonistes.length) { %>
    <p class="nv-empty" data-fr="Aucun personnage pour le moment." data-en="No characters yet.">Aucun personnage pour le moment.</p>
  <% } else { %>
    <div class="prot-grid" id="prot-grid">
      <% protagonistes.forEach(function(p) { %>
        <% var _pSpecial = p.special || ''; %>
        <a href="/protagonistes/<%= p.id %>" class="prot-card"
          data-gender="<%= p.gender || '' %>"
          data-nature="<%= p.nature || '' %>"
          data-parody="<%= p.parody || '' %>"
          data-race="<%= p.race_id || '' %>"
          data-special="<%= _pSpecial %>"
          data-is-child="<%= p.parent_id ? '1' : '' %>">

          <% if (p.image_path) { %>
            <div class="prot-card-img-wrap">
              <% if (p.nature && p.nature !== 'humain') { %>
                <div class="prot-card-nature-banner prot-card-nature-banner--<%= p.nature %>"><%= p.nature === 'pokemon' ? 'Pok\u00e9mon' : p.nature %></div>
              <% } %>
              <% if (p.race_name) { %>
                <div class="prot-card-race-badge" style="<%= p.race_color ? 'background:' + p.race_color + '22;border-color:' + p.race_color + '66;color:' + p.race_color : '' %>">
                  <%= p.race_icon ? p.race_icon + ' ' : '' %><%= p.race_name %>
                </div>
              <% } %>
              <img src="<%= p.image_path %>" alt="<%= p.name %>" class="prot-card-img" loading="lazy" />
            </div>
          <% } else { %>
            <% if (p.nature && p.nature !== 'humain') { %>
              <div class="prot-card-nature-banner prot-card-nature-banner--<%= p.nature %>"><%= p.nature === 'pokemon' ? 'Pok\u00e9mon' : p.nature %></div>
            <% } %>
            <% if (p.race_name) { %>
              <div class="prot-card-race-badge" style="<%= p.race_color ? 'background:' + p.race_color + '22;border-color:' + p.race_color + '66;color:' + p.race_color : '' %>">
                <%= p.race_icon ? p.race_icon + ' ' : '' %><%= p.race_name %>
              </div>
            <% } %>
          <% } %>

          <div class="prot-card-body">
            <div class="prot-card-header">
              <% if (p.gender) { %>
                <span class="prot-card-gender-icon prot-card-gender-icon--<%= p.gender %>" aria-hidden="true">
                  <% if (p.gender === 'femme') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="5"/><line x1="12" y1="14" x2="12" y2="22"/><line x1="9" y1="19" x2="15" y2="19"/></svg>
                  <% } else if (p.gender === 'homme') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="14" r="5"/><line x1="14.35" y1="9.65" x2="21" y2="3"/><polyline points="16 3 21 3 21 8"/></svg>
                  <% } else { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="17" x2="12" y2="22"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="19" y1="5" x2="16" y2="8"/><polyline points="17 4 20 4 20 7"/></svg>
                  <% } %>
                </span>
              <% } %>
              <div class="prot-card-name<% if (p.gender) { %> prot-card-name--<%= p.gender %><% } %>"><%= p.name %></div>
            </div>
            <% if (p.description) { %>
              <p class="prot-card-desc"><%= p.description.slice(0, 80) %><%= p.description.length > 80 ? '\u2026' : '' %></p>
            <% } %>
          </div>

          <% if (currentUser && currentUser.isAdmin) { %>
            <a href="/protagonistes/<%= p.id %>/edit" class="prot-edit-btn" onclick="event.preventDefault();event.stopPropagation();location.href=this.href">&#9998;</a>
          <% } %>
        </a>
      <% }) %>
    </div>
    <p class="nv-empty" id="prot-no-results" hidden data-fr="Aucun personnage ne correspond aux filtres." data-en="No characters match the filters.">Aucun personnage ne correspond aux filtres.</p>
  <% } %>

  <% if (currentUser && currentUser.isAdmin) { %>
    <a href="/protagonistes/new" class="wiki-fab-add" title="Nouveau personnage">+</a>
  <% } %>
</main>

<script nonce="<%= nonce %>">
(function() {
  var grid = document.getElementById('prot-grid');
  if (!grid) return;
  var cards = Array.from(grid.querySelectorAll('.prot-card'));
  var noResults = document.getElementById('prot-no-results');
  var countEl = document.getElementById('prot-count-hero');

  var SS_KEY = 'prot-filters';
  var saved = (function() { try { return JSON.parse(sessionStorage.getItem(SS_KEY) || '{}'); } catch(_) { return {}; } })();

  var activeGender = saved.gender || '';
  var activeNature = saved.nature || '';
  var activeParody = saved.parody || '';
  var activeRace   = saved.race   || '';
  var hideUltra      = localStorage.getItem('gallery-hide-ultra') !== '0';
  var hideIrrealiste = localStorage.getItem('gallery-hide-irrealiste') === '1';
  var hideChildren   = localStorage.getItem('prot-hide-children') !== '0';

  function saveFilters() {
    try { sessionStorage.setItem(SS_KEY, JSON.stringify({ gender: activeGender, nature: activeNature, parody: activeParody, race: activeRace })); } catch(_) {}
  }

  function applyFilters() {
    var shown = 0;
    cards.forEach(function(c) {
      var ok = true;
      if (activeGender && c.dataset.gender !== activeGender) ok = false;
      if (activeNature && c.dataset.nature !== activeNature) ok = false;
      if (activeParody && c.dataset.parody !== activeParody) ok = false;
      if (activeRace   && c.dataset.race   !== activeRace)   ok = false;
      var sp = c.dataset.special || '';
      if (hideUltra && sp === 'ultra') ok = false;
      if (hideIrrealiste && sp === 'irrealiste') ok = false;
      if (hideChildren && c.dataset.isChild === '1') ok = false;
      c.hidden = !ok;
      if (ok) shown++;
    });
    if (noResults) noResults.hidden = shown > 0;
    if (countEl) countEl.textContent = shown;
  }

  function syncToggle(btn, hidden, labelHideFr, labelShowFr, labelHideEn, labelShowEn) {
    if (!btn) return;
    var isEn = localStorage.getItem('slang') === 'en';
    btn.dataset.fr = hidden ? labelShowFr : labelHideFr;
    btn.dataset.en = hidden ? labelShowEn : labelHideEn;
    btn.textContent = hidden ? (isEn ? labelShowEn : labelShowFr) : (isEn ? labelHideEn : labelHideFr);
    btn.classList.toggle('active', hidden);
  }

  var ultraToggle      = document.getElementById('prot-ultra-toggle');
  var irrealisteToggle = document.getElementById('prot-irrealiste-toggle');
  var childrenToggle   = document.getElementById('prot-children-toggle');

  syncToggle(ultraToggle,      hideUltra,      'Masquer Ultra',       'Afficher Ultra',       'Hide Ultra',        'Show Ultra');
  syncToggle(irrealisteToggle, hideIrrealiste, 'Masquer Irréaliste',  'Afficher Irréaliste',  'Hide Unrealistic',  'Show Unrealistic');
  syncToggle(childrenToggle,   hideChildren,   'Masquer versions',    'Afficher versions',    'Hide versions',     'Show versions');

  if (ultraToggle) {
    ultraToggle.addEventListener('click', function() {
      hideUltra = !hideUltra;
      localStorage.setItem('gallery-hide-ultra', hideUltra ? '1' : '0');
      syncToggle(ultraToggle, hideUltra, 'Masquer Ultra', 'Afficher Ultra', 'Hide Ultra', 'Show Ultra');
      applyFilters();
    });
  }
  if (irrealisteToggle) {
    irrealisteToggle.addEventListener('click', function() {
      hideIrrealiste = !hideIrrealiste;
      localStorage.setItem('gallery-hide-irrealiste', hideIrrealiste ? '1' : '0');
      syncToggle(irrealisteToggle, hideIrrealiste, 'Masquer Irréaliste', 'Afficher Irréaliste', 'Hide Unrealistic', 'Show Unrealistic');
      applyFilters();
    });
  }
  if (childrenToggle) {
    childrenToggle.addEventListener('click', function() {
      hideChildren = !hideChildren;
      localStorage.setItem('prot-hide-children', hideChildren ? '1' : '0');
      syncToggle(childrenToggle, hideChildren, 'Masquer versions', 'Afficher versions', 'Hide versions', 'Show versions');
      applyFilters();
    });
  }

  function wireChips(containerId, key, setter, currentVal) {
    var box = document.getElementById(containerId);
    if (!box) return;
    // Restaurer le chip actif
    if (currentVal) {
      var toActivate = box.querySelector('[data-' + key + '="' + currentVal + '"]');
      if (toActivate) {
        box.querySelectorAll('.tag-chip').forEach(function(b) { b.classList.remove('active'); });
        toActivate.classList.add('active');
      }
    }
    box.querySelectorAll('.tag-chip').forEach(function(btn) {
      btn.addEventListener('click', function() {
        box.querySelectorAll('.tag-chip').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        setter(btn.dataset[key] || '');
        saveFilters();
        applyFilters();
      });
    });
  }

  wireChips('prot-gender-filter', 'gender', function(v) { activeGender = v; }, activeGender);
  wireChips('prot-nature-filter', 'nature', function(v) { activeNature = v; }, activeNature);
  wireChips('prot-parody-filter', 'parody', function(v) { activeParody = v; }, activeParody);
  wireChips('prot-race-filter',   'race',   function(v) { activeRace   = v; }, activeRace);
  applyFilters();
})();
</script>

<%- include('partials/foot') %>
