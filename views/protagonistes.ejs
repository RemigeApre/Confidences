<%- include('partials/head', { title: 'Personnages' }) %>
<main class="container wide gallery-has-sidebar" style="--ch-hue: 340">
  <%- include('partials/top-nav', { config: config, navTitle: 'Personnages', navTitleEn: 'Characters', navBack: '/' }) %>
  <%- include('partials/mobile-filter-toggle') %>

  <%# ── Volet gauche ──────────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer les filtres">&times;</button>
    <%- include('partials/sidebar-hero', { title: 'Personnages', titleEn: 'Characters', hue: 340, count: protagonistes.length, countId: 'prot-count-hero' }) %>

    <div class="wiki-sidebar-body">
      <div class="wiki-sidebar-filters">

        <%# ── Boutons de contenu (en haut) ── %>
        <div class="prot-sf-top-btns">
          <button type="button" class="prot-sf-toggle-btn" id="prot-ultra-toggle">Ultra</button>
          <button type="button" class="prot-sf-toggle-btn" id="prot-irrealiste-toggle">Irr&eacute;aliste</button>
          <button type="button" class="prot-sf-variations-btn" id="prot-children-toggle">Variations</button>
        </div>

        <%# ── Genre : 3 icônes tristate ── %>
        <div class="prot-sf-section prot-sf-section--icons">
          <div class="prot-sf-gender-row" id="prot-gender-filter">
            <%# femme %>
            <button type="button" class="prot-sf-gender-btn" data-gender="femme" data-state="0" aria-label="Femme">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="5"/><line x1="12" y1="14" x2="12" y2="22"/><line x1="9" y1="19" x2="15" y2="19"/></svg>
            </button>
            <%# homme %>
            <button type="button" class="prot-sf-gender-btn" data-gender="homme" data-state="0" aria-label="Homme">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="14" r="5"/><line x1="14.35" y1="9.65" x2="21" y2="3"/><polyline points="16 3 21 3 21 8"/></svg>
            </button>
            <%# autre %>
            <button type="button" class="prot-sf-gender-btn" data-gender="autre" data-state="0" aria-label="Autre">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="17" x2="12" y2="22"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="19" y1="5" x2="16" y2="8"/><polyline points="17 4 20 4 20 7"/></svg>
            </button>
          </div>
        </div>

        <%# ── Nature : tristate chips ── %>
        <div class="prot-sf-section" id="prot-nature-filter">
          <button type="button" class="prot-sf-chip prot-sf-chip--tip" data-nature="humain" data-state="0" data-fr="Humanoïde" data-en="Humanoid" data-tooltip="Être ayant le physique d'un être humain et pouvant être confondu avec">Humanoïde</button>
          <button type="button" class="prot-sf-chip prot-sf-chip--tip" data-nature="monstre" data-state="0" data-fr="Monstre" data-en="Monster" data-tooltip="Créatures surréalistes">Monstre</button>
          <button type="button" class="prot-sf-chip prot-sf-chip--tip" data-nature="animal" data-state="0" data-fr="Animal" data-en="Animal" data-tooltip="Bêtes existant réellement autre que les humains">Animal</button>
          <button type="button" class="prot-sf-chip prot-sf-chip--tip" data-nature="autre" data-state="0" data-fr="Autre" data-en="Other" data-tooltip="Tout le reste ne rentrant pas dans les catégories précédentes">Autre</button>
        </div>

        <% if (races && races.length) { %>
        <%# ── Race / Espèce : tristate chips ── %>
        <div class="prot-sf-section" id="prot-race-filter">
          <% races.forEach(function(r) { %>
            <button type="button" class="prot-sf-chip" data-race="<%= r.id %>" data-nature="<%= r.nature || '' %>" data-state="0"
              style="<%= r.color ? '--chip-accent:' + r.color : '' %>">
              <%= r.icon ? r.icon + ' ' : '' %><%= r.name %>
            </button>
          <% }) %>
        </div>
        <% } %>

        <% if (parodies && parodies.length) { %>
        <%# ── Univers : top 5 + recherche ── %>
        <div class="prot-sf-section prot-sf-section--univers" id="prot-parody-section">
          <input type="search" class="prot-sf-search" id="prot-parody-search"
            placeholder="Univers…" autocomplete="off" />
          <div class="prot-sf-parody-list" id="prot-parody-filter">
            <% parodies.slice(0, 5).forEach(function(par) { %>
              <button type="button" class="prot-sf-parody-btn" data-parody="<%= par.name %>" data-state="0">
                <span class="prot-sf-parody-name"><%= par.name %></span>
                <span class="prot-sf-parody-count"><%= par.count %></span>
              </button>
            <% }) %>
          </div>
        </div>
        <% } %>

      </div>
    </div>
  </aside>

  <%# ── Grille principale ─────────────────────────────────────────────── %>
  <% if (!protagonistes.length) { %>
    <p class="nv-empty" data-fr="Aucun personnage pour le moment." data-en="No characters yet.">Aucun personnage pour le moment.</p>
  <% } else { %>
    <div class="prot-grid" id="prot-grid">
      <% protagonistes.forEach(function(p) { %>
        <% var _pSpecial = p.special || ''; %>
        <a href="/protagonistes/<%= p.id %>" class="prot-card"
          data-gender="<%= p.gender || '' %>"
          data-nature="<%= p.nature || '' %>"
          data-parody="<%= p.parody || '' %>"
          data-race="<%= p.race_id || '' %>"
          data-special="<%= _pSpecial %>"
          data-is-child="<%= p.parent_id ? '1' : '' %>">

          <% if (p.image_path) { %>
            <div class="prot-card-img-wrap">
              <% if (p.nature && p.nature !== 'humain') { %>
                <div class="prot-card-nature-banner prot-card-nature-banner--<%= p.nature %>"><%= p.nature === 'pokemon' ? 'Pok\u00e9mon' : p.nature %></div>
              <% } %>
              <% if (p.race_name) { %>
                <div class="prot-card-race-badge" style="<%= p.race_color ? 'background:' + p.race_color + '22;border-color:' + p.race_color + '66;color:' + p.race_color : '' %>">
                  <%= p.race_icon ? p.race_icon + ' ' : '' %><%= p.race_name %>
                </div>
              <% } %>
              <img src="<%= p.image_path %>" alt="<%= p.name %>" class="prot-card-img" loading="lazy" />
            </div>
          <% } else { %>
            <% if (p.nature && p.nature !== 'humain') { %>
              <div class="prot-card-nature-banner prot-card-nature-banner--<%= p.nature %>"><%= p.nature === 'pokemon' ? 'Pok\u00e9mon' : p.nature %></div>
            <% } %>
            <% if (p.race_name) { %>
              <div class="prot-card-race-badge" style="<%= p.race_color ? 'background:' + p.race_color + '22;border-color:' + p.race_color + '66;color:' + p.race_color : '' %>">
                <%= p.race_icon ? p.race_icon + ' ' : '' %><%= p.race_name %>
              </div>
            <% } %>
          <% } %>

          <div class="prot-card-body">
            <div class="prot-card-header">
              <% if (p.gender) { %>
                <span class="prot-card-gender-icon prot-card-gender-icon--<%= p.gender %>" aria-hidden="true">
                  <% if (p.gender === 'femme') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="5"/><line x1="12" y1="14" x2="12" y2="22"/><line x1="9" y1="19" x2="15" y2="19"/></svg>
                  <% } else if (p.gender === 'homme') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="14" r="5"/><line x1="14.35" y1="9.65" x2="21" y2="3"/><polyline points="16 3 21 3 21 8"/></svg>
                  <% } else { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="17" x2="12" y2="22"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="19" y1="5" x2="16" y2="8"/><polyline points="17 4 20 4 20 7"/></svg>
                  <% } %>
                </span>
              <% } %>
              <div class="prot-card-name<% if (p.gender) { %> prot-card-name--<%= p.gender %><% } %>"><%= p.name %></div>
            </div>
            <% var _dFr = p.description || ''; var _dEn = (descEn && descEn[p.id]) || ''; %>
            <% if (_dFr || _dEn) { %>
              <p class="prot-card-desc"
                data-fr="<%= _dFr.slice(0,80) %><%= _dFr.length > 80 ? '\u2026' : '' %>"
                <% if (_dEn) { %>data-en="<%= _dEn.slice(0,80) %><%= _dEn.length > 80 ? '\u2026' : '' %>"<% } %>><%= _dFr.slice(0,80) %><%= _dFr.length > 80 ? '\u2026' : '' %></p>
            <% } %>
          </div>

          <% if (currentUser && currentUser.isAdmin) { %>
            <a href="/protagonistes/<%= p.id %>/edit" class="prot-edit-btn" data-edit-link>&#9998;</a>
          <% } %>
        </a>
      <% }) %>
    </div>
    <p class="nv-empty" id="prot-no-results" hidden data-fr="Aucun personnage ne correspond aux filtres." data-en="No characters match the filters.">Aucun personnage ne correspond aux filtres.</p>
  <% } %>

  <% if (currentUser && currentUser.isAdmin) { %>
    <a href="/protagonistes/new" class="wiki-fab-add" title="Nouveau personnage">+</a>
  <% } %>
</main>

<script nonce="<%= nonce %>">
(function() {
  var grid = document.getElementById('prot-grid');
  if (!grid) return;
  var cards    = Array.from(grid.querySelectorAll('.prot-card'));
  var noResults = document.getElementById('prot-no-results');
  var countEl  = document.getElementById('prot-count-hero');

  // ── État tristate : 0 = neutre, 1 = inclus, -1 = exclu ──────────────
  var SS_KEY = 'prot-filters-v2';
  var saved = (function() { try { return JSON.parse(sessionStorage.getItem(SS_KEY) || '{}'); } catch(_) { return {}; } })();

  var genderState = saved.gender || {};  // { femme: 0|1|-1, ... }
  var natureState = saved.nature || {};
  var raceState   = saved.race   || {};
  var parodyState = saved.parody || {};  // { name: 0|1|-1 }

  var hideUltra      = localStorage.getItem('gallery-hide-ultra') !== '0';
  var hideIrrealiste = localStorage.getItem('gallery-hide-irrealiste') === '1';
  var hideChildren   = localStorage.getItem('prot-hide-children') !== '0';

  function saveFilters() {
    try { sessionStorage.setItem(SS_KEY, JSON.stringify({ gender: genderState, nature: natureState, race: raceState, parody: parodyState })); } catch(_) {}
  }

  // Logique tristate : si au moins un +1 → la carte doit correspondre à un +1
  // Si -1 → la carte ne doit pas correspondre
  function tristateMatch(state, cardVal) {
    var keys = Object.keys(state);
    var included = keys.filter(function(k) { return state[k] === 1; });
    var excluded = keys.filter(function(k) { return state[k] === -1; });
    if (excluded.indexOf(cardVal) !== -1) return false;
    if (included.length && included.indexOf(cardVal) === -1) return false;
    return true;
  }

  function applyFilters() {
    var shown = 0;
    cards.forEach(function(c) {
      var ok = true;
      if (!tristateMatch(genderState, c.dataset.gender || '')) ok = false;
      if (!tristateMatch(natureState, c.dataset.nature || '')) ok = false;
      if (!tristateMatch(raceState,   String(c.dataset.race || ''))) ok = false;
      if (!tristateMatch(parodyState, c.dataset.parody || '')) ok = false;
      var sp = c.dataset.special || '';
      if (hideUltra      && sp === 'ultra')       ok = false;
      if (hideIrrealiste && sp === 'irrealiste')  ok = false;
      if (hideChildren   && c.dataset.isChild === '1') ok = false;
      c.hidden = !ok;
      if (ok) shown++;
    });
    if (noResults) noResults.hidden = shown > 0;
    if (countEl)   countEl.textContent = shown;
  }

  // ── Wiring tristate générique ─────────────────────────────────────────
  // state : l'objet d'état (partagé par référence via getter/setter)
  function wireTristateGroup(containerEl, dataKey, getState, setState) {
    if (!containerEl) return;
    var btns = Array.from(containerEl.querySelectorAll('[data-' + dataKey + ']'));
    btns.forEach(function(btn) {
      var val = btn.dataset[dataKey];
      // Restaurer état sauvegardé
      var st = getState()[val] || 0;
      applyBtnState(btn, st, dataKey);

      btn.addEventListener('click', function() {
        var cur = getState()[val] || 0;
        var next = cur === 0 ? 1 : cur === 1 ? -1 : 0;
        var s = getState();
        s[val] = next;
        setState(s);
        applyBtnState(btn, next, dataKey);
        saveFilters();
        applyFilters();
      });
    });
  }

  function applyBtnState(btn, state, dataKey) {
    btn.dataset.state = state;
    btn.classList.remove('prot-sf-state-inc', 'prot-sf-state-exc');
    if (state === 1)  btn.classList.add('prot-sf-state-inc');
    if (state === -1) btn.classList.add('prot-sf-state-exc');
  }

  // Genre (boutons icônes)
  wireTristateGroup(
    document.getElementById('prot-gender-filter'), 'gender',
    function() { return genderState; },
    function(s) { genderState = s; }
  );

  // Nature
  wireTristateGroup(
    document.getElementById('prot-nature-filter'), 'nature',
    function() { return natureState; },
    function(s) { natureState = s; syncRaceChipsToNature(); }
  );

  // Race
  wireTristateGroup(
    document.getElementById('prot-race-filter'), 'race',
    function() { return raceState; },
    function(s) { raceState = s; }
  );

  // Masque les chips de race dont la nature ne correspond pas au filtre nature actif
  function syncRaceChipsToNature() {
    var raceSection = document.getElementById('prot-race-filter');
    if (!raceSection) return;
    var included = Object.keys(natureState).filter(function(k) { return natureState[k] === 1; });
    raceSection.querySelectorAll('[data-race]').forEach(function(btn) {
      var chipNature = btn.dataset.nature || '';
      // Toujours visible si : aucun filtre nature actif, OU chip sans nature associée, OU nature correspond
      var visible = !included.length || !chipNature || included.indexOf(chipNature) !== -1;
      btn.hidden = !visible;
      // Réinitialiser l'état du chip s'il devient invisible (évite les filtres fantômes)
      if (!visible && (raceState[btn.dataset.race] || 0) !== 0) {
        raceState[btn.dataset.race] = 0;
        applyBtnState(btn, 0, 'race');
        saveFilters();
        applyFilters();
      }
    });
  }

  // Appliquer au chargement si un filtre nature était sauvegardé
  syncRaceChipsToNature();

  // Univers (parody) — champ de recherche + top 5
  var parodyFilter = document.getElementById('prot-parody-filter');
  var parodySearch = document.getElementById('prot-parody-search');

  // Données complètes injectées côté serveur
  var allParodies = <%- JSON.stringify((parodies || []).map(function(p){ return { name: p.name || p, count: p.count || 0 }; })) %>;

  function renderParodyList(q) {
    if (!parodyFilter) return;
    var filtered = q
      ? allParodies.filter(function(p) { return p.name.toLowerCase().indexOf(q.toLowerCase()) !== -1; })
      : allParodies.slice(0, 5);
    parodyFilter.innerHTML = '';
    var frag = document.createDocumentFragment();
    filtered.slice(0, 10).forEach(function(par) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'prot-sf-parody-btn';
      btn.dataset.parody = par.name;
      var st = parodyState[par.name] || 0;
      btn.dataset.state = st;
      if (st === 1)  btn.classList.add('prot-sf-state-inc');
      if (st === -1) btn.classList.add('prot-sf-state-exc');
      var nameSpan = document.createElement('span');
      nameSpan.className = 'prot-sf-parody-name';
      nameSpan.textContent = par.name;
      btn.appendChild(nameSpan);
      if (par.count) {
        var countSpan = document.createElement('span');
        countSpan.className = 'prot-sf-parody-count';
        countSpan.textContent = par.count;
        btn.appendChild(countSpan);
      }
      btn.addEventListener('click', function() {
        var cur = parodyState[par.name] || 0;
        var next = cur === 0 ? 1 : cur === 1 ? -1 : 0;
        parodyState[par.name] = next;
        btn.dataset.state = next;
        btn.classList.remove('prot-sf-state-inc', 'prot-sf-state-exc');
        if (next === 1)  btn.classList.add('prot-sf-state-inc');
        if (next === -1) btn.classList.add('prot-sf-state-exc');
        saveFilters();
        applyFilters();
      });
      frag.appendChild(btn);
    });
    parodyFilter.appendChild(frag);
  }

  if (parodySearch) {
    parodySearch.addEventListener('input', function() { renderParodyList(parodySearch.value.trim()); });
  }
  renderParodyList('');

  // ── Boutons Ultra / Irréaliste / Variations ───────────────────────────
  var ultraToggle      = document.getElementById('prot-ultra-toggle');
  var irrealisteToggle = document.getElementById('prot-irrealiste-toggle');
  var childrenToggle   = document.getElementById('prot-children-toggle');

  function syncToggleBtn(btn, active) {
    if (!btn) return;
    btn.classList.toggle('prot-sf-toggle-btn--on', active);
  }

  syncToggleBtn(ultraToggle,      hideUltra);
  syncToggleBtn(irrealisteToggle, hideIrrealiste);
  // Variations : actif = les variantes sont VISIBLES (hideChildren = false)
  if (childrenToggle) childrenToggle.classList.toggle('prot-sf-variations-btn--on', !hideChildren);

  if (ultraToggle) {
    ultraToggle.addEventListener('click', function() {
      hideUltra = !hideUltra;
      localStorage.setItem('gallery-hide-ultra', hideUltra ? '1' : '0');
      syncToggleBtn(ultraToggle, hideUltra);
      applyFilters();
    });
  }
  if (irrealisteToggle) {
    irrealisteToggle.addEventListener('click', function() {
      hideIrrealiste = !hideIrrealiste;
      localStorage.setItem('gallery-hide-irrealiste', hideIrrealiste ? '1' : '0');
      syncToggleBtn(irrealisteToggle, hideIrrealiste);
      applyFilters();
    });
  }
  if (childrenToggle) {
    childrenToggle.addEventListener('click', function() {
      hideChildren = !hideChildren;
      localStorage.setItem('prot-hide-children', hideChildren ? '1' : '0');
      childrenToggle.classList.toggle('prot-sf-variations-btn--on', !hideChildren);
      applyFilters();
    });
  }

  applyFilters();

  // Boutons d'édition (nested link workaround via délégation)
  if (grid) {
    grid.addEventListener('click', function(e) {
      var editLink = e.target.closest('[data-edit-link]');
      if (!editLink) return;
      e.preventDefault();
      e.stopPropagation();
      location.href = editLink.href;
    });
  }
})();
</script>

<%- include('partials/foot') %>
