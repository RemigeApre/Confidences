<%- include('partials/head', { title: 'Personnages' }) %>
<main class="container wide gallery-has-sidebar" style="--ch-hue: 340">
  <%- include('partials/top-nav', { config: config, navTitle: 'Personnages', navBack: '/' }) %>
  <%- include('partials/mobile-filter-toggle') %>

  <%# ── Volet gauche ──────────────────────────────────────────────────── %>
  <aside class="wiki-cat-sidebar" id="mobile-filter-sidebar">
    <button type="button" class="mobile-filter-close" id="mobile-filter-close" aria-label="Fermer les filtres">&times;</button>
    <%- include('partials/sidebar-hero', { title: 'Personnages', hue: 340, count: protagonistes.length, countId: 'prot-count-hero' }) %>

    <div class="wiki-sidebar-body">
      <div class="wiki-sidebar-filters">

        <%# Genre %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label">Genre</span>
          <div class="links-filter" id="prot-gender-filter">
            <button type="button" class="tag-chip active" data-gender="">Tous</button>
            <button type="button" class="tag-chip" data-gender="femme">Femme</button>
            <button type="button" class="tag-chip" data-gender="homme">Homme</button>
            <button type="button" class="tag-chip" data-gender="autre">Autre</button>
          </div>
        </div>

        <%# Nature %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label">Nature</span>
          <div class="links-filter" id="prot-nature-filter">
            <button type="button" class="tag-chip active" data-nature="">Toutes</button>
            <button type="button" class="tag-chip" data-nature="humain">Humain</button>
            <button type="button" class="tag-chip" data-nature="monstre">Monstre</button>
            <button type="button" class="tag-chip" data-nature="animal">Animal</button>
            <button type="button" class="tag-chip" data-nature="pokemon">Pok&eacute;mon</button>
            <button type="button" class="tag-chip" data-nature="autre">Autre</button>
          </div>
        </div>

        <% if (parodies && parodies.length) { %>
        <%# Univers %>
        <div class="wiki-filter-section">
          <span class="wiki-filter-label">Univers</span>
          <div class="links-filter" id="prot-parody-filter">
            <button type="button" class="tag-chip active" data-parody="">Tous</button>
            <% parodies.forEach(function(par) { %>
              <button type="button" class="tag-chip" data-parody="<%= par %>"><%= par %></button>
            <% }) %>
          </div>
        </div>
        <% } %>

      </div>
    </div>
  </aside>

  <%# ── Grille principale ─────────────────────────────────────────────── %>
  <% if (!protagonistes.length) { %>
    <p class="nv-empty">Aucun personnage pour le moment.</p>
  <% } else { %>
    <div class="prot-grid" id="prot-grid">
      <% protagonistes.forEach(function(p) { %>
        <a href="/protagonistes/<%= p.id %>" class="prot-card"
          data-gender="<%= p.gender || '' %>"
          data-nature="<%= p.nature || '' %>"
          data-parody="<%= p.parody || '' %>">
          <% if (p.image_path) { %>
            <div class="prot-card-img-wrap">
              <img src="<%= p.image_path %>" alt="<%= p.name %>" class="prot-card-img" loading="lazy" />
            </div>
          <% } %>
          <div class="prot-card-body">
            <div class="prot-card-name"><%= p.name %></div>
            <% if (p.gender || p.nature) { %>
              <div class="prot-card-meta">
                <% if (p.gender) { %><span class="prot-badge prot-badge--<%= p.gender %>"><%= p.gender %></span><% } %>
                <% if (p.nature) { %><span class="prot-badge prot-badge--nature"><%= p.nature === 'pokemon' ? 'Pok\u00e9mon' : p.nature %></span><% } %>
              </div>
            <% } %>
            <% if (p.description) { %>
              <p class="prot-card-desc"><%= p.description.slice(0, 100) %><%= p.description.length > 100 ? '\u2026' : '' %></p>
            <% } %>
            <% if (p.tags && p.tags.length) { %>
              <div class="prot-card-tags">
                <% p.tags.slice(0, 4).forEach(function(t) { %><span class="prot-tag"><%= t %></span><% }) %>
              </div>
            <% } %>
          </div>
          <% if (currentUser && currentUser.isAdmin) { %>
            <a href="/protagonistes/<%= p.id %>/edit" class="prot-edit-btn" onclick="event.preventDefault();event.stopPropagation();location.href=this.href">&#9998;</a>
          <% } %>
        </a>
      <% }) %>
    </div>
    <p class="nv-empty" id="prot-no-results" hidden>Aucun personnage ne correspond aux filtres.</p>
  <% } %>

  <% if (currentUser && currentUser.isAdmin) { %>
    <a href="/protagonistes/new" class="wiki-fab-add" title="Nouveau personnage">+</a>
  <% } %>
</main>

<script>
(function() {
  var grid = document.getElementById('prot-grid');
  if (!grid) return;
  var cards = Array.from(grid.querySelectorAll('.prot-card'));
  var noResults = document.getElementById('prot-no-results');
  var countEl = document.getElementById('prot-count-hero');

  var activeGender = '';
  var activeNature = '';
  var activeParody = '';

  function applyFilters() {
    var shown = 0;
    cards.forEach(function(c) {
      var ok = true;
      if (activeGender && c.dataset.gender !== activeGender) ok = false;
      if (activeNature && c.dataset.nature !== activeNature) ok = false;
      if (activeParody && c.dataset.parody !== activeParody) ok = false;
      c.hidden = !ok;
      if (ok) shown++;
    });
    if (noResults) noResults.hidden = shown > 0;
    if (countEl) countEl.textContent = shown;
  }

  function wireChips(containerId, key, setter) {
    var box = document.getElementById(containerId);
    if (!box) return;
    box.querySelectorAll('.tag-chip').forEach(function(btn) {
      btn.addEventListener('click', function() {
        box.querySelectorAll('.tag-chip').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        setter(btn.dataset[key] || '');
        applyFilters();
      });
    });
  }

  wireChips('prot-gender-filter', 'gender', function(v) { activeGender = v; });
  wireChips('prot-nature-filter', 'nature', function(v) { activeNature = v; });
  wireChips('prot-parody-filter', 'parody', function(v) { activeParody = v; });
  applyFilters();
})();
</script>

<%- include('partials/foot') %>
