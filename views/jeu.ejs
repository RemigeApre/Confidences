<%- include('partials/head', { title: 'Jeu' }) %>
<%- include('partials/top-nav', { config: config, navTitle: 'Jeu' }) %>

<div class="jeu-viewport">

  <%# ── Bouton info (haut droite) ── %>
  <div class="jeu-top-btns">
  <button class="jeu-info-btn" id="jeu-info-btn" aria-label="Informations sur les récompenses" title="Informations sur les récompenses">
    <svg viewBox="0 0 100 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="6" y="44" width="88" height="32" rx="4" stroke="currentColor" stroke-width="3.5" fill="none"/>
      <path d="M6 46 Q6 18 50 18 Q94 18 94 46 Z" stroke="currentColor" stroke-width="3.5" fill="none"/>
      <rect x="4" y="42" width="92" height="7" rx="2.5" stroke="currentColor" stroke-width="2.5" fill="none"/>
      <rect x="40" y="42" width="20" height="13" rx="3" stroke="currentColor" stroke-width="2.5" fill="none"/>
      <path d="M44 42 Q44 35 50 35 Q56 35 56 42" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    </svg>
  </button>
  </div>

  <%# ── Grille de catégories ── %>
  <div class="jeu-categories">

    <button class="jeu-cat-btn jeu-cat-btn--arcade" id="jeu-arcade-btn" aria-label="Arcade">
      <span class="jeu-cat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="M8 12h2m-1-1v2M14 11h.01M16 13h.01"/></svg>
      </span>
      <span class="jeu-cat-name">Arcade</span>
      <span class="jeu-cat-sub">Memory &bull; et plus bient&ocirc;t</span>
    </button>

    <button class="jeu-cat-btn jeu-cat-btn--casino" id="jeu-casino-btn" aria-label="Casino">
      <span class="jeu-cat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="8" height="8" rx="1.5"/><rect x="14" y="2" width="8" height="8" rx="1.5"/><rect x="2" y="14" width="8" height="8" rx="1.5"/><rect x="14" y="14" width="8" height="8" rx="1.5"/><circle cx="6" cy="6" r="1.2" fill="currentColor"/><circle cx="18" cy="6" r="1.2" fill="currentColor"/><circle cx="18" cy="10" r="1.2" fill="currentColor"/><circle cx="6" cy="18" r="1.2" fill="currentColor"/><circle cx="18" cy="18" r="1.2" fill="currentColor"/></svg>
      </span>
      <span class="jeu-cat-name">Casino</span>
      <span class="jeu-cat-sub">Roue du hasard &bull; Slots</span>
    </button>

    <button class="jeu-cat-btn jeu-cat-btn--aventure" id="jeu-aventure-btn" aria-label="Aventure">
      <span class="jeu-cat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 10.5 L12 3 L9.5 10.5 L3 8 L7.5 14 L3 20 L12 17 L21 20 L16.5 14 L21 8 Z"/></svg>
      </span>
      <span class="jeu-cat-name">Aventure</span>
      <span class="jeu-cat-sub">Bient&ocirc;t disponible</span>
    </button>

  </div>

  <%# ── Lootbox (bas droite) ── %>
  <div class="jeu-lootbox-area" id="jeu-lootbox-area">
    <button class="jeu-lootbox-btn" id="jeu-lootbox-btn" aria-label="Ouvrir une lootbox" disabled>
      <%# Coffre SVG très graphique %>
      <svg class="jeu-chest-svg" viewBox="0 0 140 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="jbody" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="hsl(28,70%,36%)"/><stop offset="100%" stop-color="hsl(28,58%,20%)"/></linearGradient>
    <linearGradient id="jlid" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="hsl(28,68%,42%)"/><stop offset="100%" stop-color="hsl(28,60%,28%)"/></linearGradient>
    <linearGradient id="jgold" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="hsl(44,98%,66%)"/><stop offset="100%" stop-color="hsl(38,88%,42%)"/></linearGradient>
    <linearGradient id="jgem1" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="hsl(355,90%,72%)"/><stop offset="100%" stop-color="hsl(355,80%,48%)"/></linearGradient>
    <linearGradient id="jgem2" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="hsl(210,90%,72%)"/><stop offset="100%" stop-color="hsl(210,80%,48%)"/></linearGradient>
    <linearGradient id="jgem3" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="hsl(140,80%,62%)"/><stop offset="100%" stop-color="hsl(140,70%,38%)"/></linearGradient>
    <filter id="jglow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <ellipse cx="70" cy="106" rx="42" ry="5" fill="rgba(0,0,0,.35)"/>
  <rect x="10" y="58" width="120" height="44" rx="5" fill="url(#jbody)" stroke="hsl(38,80%,38%)" stroke-width="2.5"/>
  <line x1="11" y1="76" x2="129" y2="76" stroke="rgba(0,0,0,.25)" stroke-width="1.5"/>
  <line x1="11" y1="91" x2="129" y2="91" stroke="rgba(0,0,0,.25)" stroke-width="1.5"/>
  <path d="M10 60 Q10 28 70 28 Q130 28 130 60 Z" fill="url(#jlid)" stroke="hsl(38,80%,38%)" stroke-width="2.5"/>
  <path d="M22 52 Q38 34 70 32 Q102 34 118 52" fill="none" stroke="rgba(255,255,255,.16)" stroke-width="3.5" stroke-linecap="round"/>
  <rect x="8" y="56" width="124" height="9" rx="3.5" fill="url(#jgold)" stroke="hsl(38,72%,30%)" stroke-width="1.5"/>
  <rect x="62" y="57" width="16" height="44" fill="url(#jgold)" stroke="hsl(38,72%,30%)" stroke-width="1" opacity=".7"/>
  <rect x="8" y="56" width="124" height="9" rx="3.5" fill="url(#jgold)" stroke="hsl(38,72%,30%)" stroke-width="1.5"/>
  <rect x="18" y="54" width="16" height="14" rx="3" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1.5"/>
  <rect x="106" y="54" width="16" height="14" rx="3" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1.5"/>
  <rect x="8" y="58" width="10" height="44" rx="2" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1" opacity=".6"/>
  <rect x="122" y="58" width="10" height="44" rx="2" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1" opacity=".6"/>
  <circle cx="24" cy="72" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="116" cy="72" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="24" cy="87" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="116" cy="87" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="24" cy="100" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="116" cy="100" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <rect x="56" y="56" width="28" height="19" rx="4" fill="url(#jgold)" stroke="hsl(38,68%,28%)" stroke-width="1.5" filter="url(#jglow)"/>
  <path d="M62 56 Q62 46 70 46 Q78 46 78 56" fill="none" stroke="url(#jgold)" stroke-width="3.5" stroke-linecap="round"/>
  <circle cx="70" cy="66" r="4" fill="hsl(28,52%,18%)"/>
  <circle cx="70" cy="66" r="1.5" fill="hsl(38,80%,50%)"/>
  <polygon points="38,60 43,56 48,60 43,64" fill="url(#jgem1)" stroke="hsl(355,70%,38%)" stroke-width="1" filter="url(#jglow)"/>
  <polygon points="97,60 102,56 107,60 102,64" fill="url(#jgem2)" stroke="hsl(210,70%,38%)" stroke-width="1" filter="url(#jglow)"/>
  <polygon points="70,30 76,38 70,44 64,38" fill="url(#jgem3)" stroke="hsl(140,65%,30%)" stroke-width="1.2" filter="url(#jglow)"/>
  <polygon points="70,33 74,38 70,42 66,38" fill="rgba(255,255,255,.3)" stroke="none"/>
</svg>

      <span class="jeu-lootbox-count" id="jeu-lootbox-count" hidden></span>
      <span class="jeu-lootbox-label" id="jeu-lootbox-label">Aucune lootbox</span>
    </button>
  </div>

</div>

<%# ── Modal Arcade ── %>
<div class="arcade-overlay" id="arcade-modal" hidden aria-modal="true" role="dialog">
  <div class="arcade-modal">
    <div class="arcade-modal-header">
      <h2 class="arcade-modal-title">&#127918; Arcade</h2>
      <button class="arcade-close-btn" id="arcade-close-btn" aria-label="Fermer">&#10005;</button>
    </div>

    <%# ── Liste des jeux ── %>
    <div id="arcade-screen-games" class="arcade-screen">
      <div class="arcade-games-list">
        <div class="arcade-game-card">
          <span class="arcade-game-card-icon">&#127183;</span>
          <div class="arcade-game-card-info">
            <strong>Memory</strong>
            <span>Retrouvez les paires &bull; Toutes les 5&nbsp;niveaux &rarr; &#127873; lootbox</span>
          </div>
          <button class="arcade-game-play-btn" id="arcade-memory-play-btn">Jouer</button>
        </div>
      </div>
    </div>

    <%# ── Memory : reprise de partie ── %>
    <div id="arcade-screen-memory-resume" class="arcade-screen arcade-screen--result" hidden>
      <div class="arcade-result-icon">&#128190;</div>
      <h3 class="arcade-result-title">Partie sauvegard&eacute;e</h3>
      <div class="arcade-resume-info">
        <span>Niveau <strong id="resume-level">1</strong></span>
        <span>Score <strong id="resume-score">0</strong></span>
        <span id="resume-mode-label" class="arcade-resume-mode"></span>
      </div>
      <div class="arcade-result-footer">
        <button class="arcade-btn arcade-btn--ghost" id="arcade-resume-restart">Nouvelle partie</button>
        <button class="arcade-btn arcade-btn--primary" id="arcade-resume-continue">Reprendre &rarr;</button>
      </div>
    </div>

    <%# ── Memory : configuration ── %>
    <div id="arcade-screen-memory-setup" class="arcade-screen" hidden>
      <p class="arcade-section-title" id="arcade-setup-title">Memory &mdash; Configuration</p>

      <div class="arcade-setup-row">
        <label class="arcade-radio-label">
          <input type="radio" name="memory-mode" value="random" checked>
          <span>
            Images al&eacute;atoires
            <small>Selon vos filtres de contenu</small>
          </span>
        </label>
        <label class="arcade-radio-label">
          <input type="radio" name="memory-mode" value="tag">
          <span>
            Choisir un th&egrave;me
            <small>Toutes les images du th&egrave;me choisi</small>
          </span>
        </label>
      </div>

      <div id="arcade-tag-picker" class="arcade-tag-picker" hidden>
        <input type="text" id="arcade-tag-search" class="arcade-tag-search" placeholder="Rechercher un th&egrave;me&hellip;" autocomplete="off">
        <div id="arcade-tag-list" class="arcade-tag-list">
          <p style="color:#64748b;font-size:.82rem;text-align:center;margin:.5rem 0">Chargement&hellip;</p>
        </div>
      </div>

      <div class="arcade-setup-footer">
        <button class="arcade-btn arcade-btn--ghost" id="arcade-memory-setup-back">&larr; Retour</button>
        <button class="arcade-btn arcade-btn--primary" id="arcade-memory-start-btn">Commencer</button>
      </div>
    </div>

    <%# ── Memory : jeu ── %>
    <div id="arcade-screen-memory-game" class="arcade-screen arcade-screen--game" hidden>
      <div class="arcade-memory-hud">
        <div class="arcade-hud-item">
          <span class="arcade-hud-label">Niveau</span>
          <span class="arcade-hud-value" id="mem-level">1</span>
        </div>
        <div class="arcade-hud-item arcade-hud-item--timer">
          <span class="arcade-hud-label">Temps</span>
          <span class="arcade-hud-value" id="mem-timer">1:40</span>
        </div>
        <div class="arcade-hud-item">
          <span class="arcade-hud-label">Score</span>
          <span class="arcade-hud-value" id="mem-score">0</span>
        </div>
      </div>
      <div class="arcade-memory-grid" id="arcade-memory-grid"></div>
    </div>

    <%# ── Memory : victoire ── %>
    <div id="arcade-screen-memory-win" class="arcade-screen arcade-screen--result" hidden>
      <div class="arcade-result-icon">&#9989;</div>
      <h3 class="arcade-result-title">Niveau <span id="win-level">1</span> complet&eacute;&nbsp;!</h3>
      <div class="arcade-result-score">Score&nbsp;: <strong id="win-score">0</strong></div>
      <div id="win-lootbox" class="arcade-lootbox-reward" hidden>&#127873; <strong>+1&nbsp;lootbox</strong> d&eacute;bloqu&eacute;e&nbsp;!</div>
      <div class="arcade-result-footer arcade-result-footer--3col">
        <button class="arcade-btn arcade-btn--ghost" id="win-quit-btn">Quitter</button>
        <button class="arcade-btn arcade-btn--secondary" id="win-change-mode-btn">&#9881; Mode</button>
        <button class="arcade-btn arcade-btn--primary" id="win-next-btn">Niveau suivant &rarr;</button>
      </div>
    </div>

    <%# ── Memory : défaite ── %>
    <div id="arcade-screen-memory-lose" class="arcade-screen arcade-screen--result" hidden>
      <div class="arcade-result-icon">&#9201;</div>
      <h3 class="arcade-result-title">Temps &eacute;coul&eacute;&nbsp;!</h3>
      <div class="arcade-result-subtitle">Niveau <span id="lose-level">1</span></div>
      <div class="arcade-result-score">Score&nbsp;: <strong id="lose-score">0</strong></div>
      <div class="arcade-result-footer">
        <button class="arcade-btn arcade-btn--ghost" id="lose-quit-btn">Quitter</button>
        <button class="arcade-btn arcade-btn--primary" id="lose-retry-btn">Rejouer ce niveau</button>
      </div>
    </div>

  </div>
</div>

<%# ── Modal Casino ── %>
<div class="arcade-overlay" id="casino-modal" hidden aria-modal="true" role="dialog">
  <div class="arcade-modal">
    <div class="arcade-modal-header">
      <h2 class="arcade-modal-title">&#127920; Casino</h2>
      <button class="arcade-close-btn" id="casino-close-btn" aria-label="Fermer">&#10005;</button>
    </div>

    <%# ── Liste des jeux casino ── %>
    <div id="casino-screen-games" class="arcade-screen">
      <div class="arcade-games-list">
        <div class="arcade-game-card arcade-game-card--unavailable">
          <span class="arcade-game-card-icon">&#127744;</span>
          <div class="arcade-game-card-info">
            <strong>Roue du hasard</strong>
            <span>Tentez votre chance et gagnez des r&eacute;compenses</span>
          </div>
          <span class="arcade-unavailable-badge">Bient&ocirc;t</span>
        </div>
        <div class="arcade-game-card arcade-game-card--unavailable">
          <span class="arcade-game-card-icon">&#127921;</span>
          <div class="arcade-game-card-info">
            <strong>Slots</strong>
            <span>Machine &agrave; sous &mdash; alignez les symboles</span>
          </div>
          <span class="arcade-unavailable-badge">Bient&ocirc;t</span>
        </div>
        <div class="arcade-game-card">
          <span class="arcade-game-card-icon">&#10024;</span>
          <div class="arcade-game-card-info">
            <strong>Machine &agrave; charmes</strong>
            <span>3 symboles &mdash; 5&nbsp;% de chance &mdash; 4&nbsp;&#128B0; par partie</span>
          </div>
          <button class="arcade-game-play-btn" id="casino-charm-slots-open">Jouer</button>
        </div>
      </div>
    </div>

    <%# ── Machine à charmes : jeu ── %>
    <div id="casino-screen-charm-slots" class="arcade-screen" hidden>
      <div class="slots-header">
        <button class="arcade-btn arcade-btn--ghost slots-back-btn" id="charm-slots-back">&larr; Retour</button>
        <div class="slots-coins-display">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" style="width:14px;height:14px"><circle cx="10" cy="10" r="9" fill="hsl(44,95%,55%)" stroke="hsl(44,70%,35%)" stroke-width="1.5"/><text x="10" y="14.5" text-anchor="middle" font-size="10" font-weight="bold" fill="hsl(44,40%,20%)">P</text></svg>
          <span id="slots-coins"><%= currentUser.coins %></span>
          <span class="slots-coins-label">pi&egrave;ces</span>
        </div>
      </div>

      <div class="slots-cost-notice">Co&ucirc;t&nbsp;: <strong>4 pi&egrave;ces</strong> par tirage &mdash; Gain&nbsp;: charme al&eacute;atoire</div>

      <div class="slots-reels-wrap">
        <div class="slots-reels">
          <div class="slots-reel" id="slots-reel-0">&#9733;</div>
          <div class="slots-reel" id="slots-reel-1">&#9733;</div>
          <div class="slots-reel" id="slots-reel-2">&#9733;</div>
        </div>
        <div class="slots-win-flash" id="slots-win-flash" hidden></div>
      </div>

      <button class="slots-play-btn" id="charm-slots-play" disabled>
        &#127921; Jouer &mdash; 4&nbsp;pi&egrave;ces
      </button>

      <div class="slots-result" id="slots-result" hidden></div>
    </div>

  </div>
</div>

<%# ── Modal Aventure ── %>
<div class="arcade-overlay" id="aventure-modal" hidden aria-modal="true" role="dialog">
  <div class="arcade-modal">
    <div class="arcade-modal-header">
      <h2 class="arcade-modal-title">&#9876; Aventure</h2>
      <button class="arcade-close-btn" id="aventure-close-btn" aria-label="Fermer">&#10005;</button>
    </div>
    <div class="arcade-screen arcade-screen--result">
      <div class="arcade-result-icon">&#9876;</div>
      <h3 class="arcade-result-title">Bient&ocirc;t disponible</h3>
      <p style="color:#64748b;font-size:.9rem;text-align:center;margin:.5rem 0 1.5rem">
        Des jeux d&rsquo;aventure arrivent prochainement&hellip;
      </p>
    </div>
  </div>
</div>

<%# ── Popup info + paramètres lootbox ── %>
<div class="jeu-info-popover" id="jeu-info-popover" hidden aria-modal="true" role="dialog" aria-labelledby="jeu-info-title">
  <div class="jeu-info-inner">
    <div class="jeu-info-header">
      <p class="jeu-info-title" id="jeu-info-title">R&eacute;compenses des lootboxes</p>
      <button class="jeu-info-close" id="jeu-info-close" aria-label="Fermer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div>
      <p class="jeu-info-section-title">Niveaux de raret&eacute;</p>
      <ul class="jeu-info-rarity-list">
        <li class="jeu-info-rarity-item">
          <span class="jeu-info-rarity-name"><span class="jeu-info-rarity-dot" style="background:hsl(0,0%,60%)"></span>Commun</span>
          <span class="jeu-info-rarity-pct">50 %</span>
        </li>
        <li class="jeu-info-rarity-item">
          <span class="jeu-info-rarity-name"><span class="jeu-info-rarity-dot" style="background:hsl(210,80%,60%)"></span>Rare</span>
          <span class="jeu-info-rarity-pct">28 %</span>
        </li>
        <li class="jeu-info-rarity-item">
          <span class="jeu-info-rarity-name"><span class="jeu-info-rarity-dot" style="background:hsl(270,65%,65%)"></span>&Eacute;pique</span>
          <span class="jeu-info-rarity-pct">15 %</span>
        </li>
        <li class="jeu-info-rarity-item">
          <span class="jeu-info-rarity-name"><span class="jeu-info-rarity-dot" style="background:hsl(44,95%,55%)"></span>L&eacute;gendaire</span>
          <span class="jeu-info-rarity-pct">5 %</span>
        </li>
        <li class="jeu-info-rarity-item">
          <span class="jeu-info-rarity-name"><span class="jeu-info-rarity-dot" style="background:hsl(0,75%,55%)"></span>Mythique</span>
          <span class="jeu-info-rarity-pct">2 %</span>
        </li>
      </ul>
    </div>

    <div>
      <p class="jeu-info-section-title">Contenu autoris&eacute;</p>
      <label class="jeu-settings-toggle">
        <span class="jeu-settings-toggle-label">Images <strong>Irr&eacute;aliste</strong></span>
        <input type="checkbox" class="jeu-settings-checkbox" id="jeu-settings-irrealiste"
               <%- currentUser.lootboxAllowIrrealiste ? 'checked' : '' %>>
        <span class="jeu-settings-toggle-track"><span class="jeu-settings-toggle-thumb"></span></span>
      </label>
      <label class="jeu-settings-toggle">
        <span class="jeu-settings-toggle-label">Images <strong>Ultra</strong></span>
        <input type="checkbox" class="jeu-settings-checkbox" id="jeu-settings-ultra"
               <%- currentUser.lootboxAllowUltra ? 'checked' : '' %>>
        <span class="jeu-settings-toggle-track"><span class="jeu-settings-toggle-thumb"></span></span>
      </label>
    </div>
  </div>
</div>

<%- include('partials/foot') %>

<script>
(function () {
  var ultraChk      = document.getElementById('jeu-settings-ultra');
  var irrealisteChk = document.getElementById('jeu-settings-irrealiste');

  function saveSettings() {
    fetch('/lootbox/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        allowUltra:      ultraChk      ? ultraChk.checked      : false,
        allowIrrealiste: irrealisteChk ? irrealisteChk.checked : true,
      }),
    });
  }

  ultraChk      && ultraChk.addEventListener('change',      saveSettings);
  irrealisteChk && irrealisteChk.addEventListener('change', saveSettings);

  var infoBtn   = document.getElementById('jeu-info-btn');
  var infoPop   = document.getElementById('jeu-info-popover');
  var infoClose = document.getElementById('jeu-info-close');
  function openInfo()  { infoPop.removeAttribute('hidden'); infoClose.focus(); }
  function closeInfo() { infoPop.setAttribute('hidden', ''); infoBtn.focus(); }
  infoBtn   && infoBtn.addEventListener('click', openInfo);
  infoClose && infoClose.addEventListener('click', closeInfo);
  infoPop   && infoPop.addEventListener('click', function(e) {
    if (e.target === infoPop) closeInfo();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && infoPop && !infoPop.hidden) closeInfo();
  });
})();
</script>

<script>
/* ═══════════════════════════════════════════════════════════════════════════
   ARCADE — Memory
   ═══════════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var SAVE_KEY = 'arcade_memory_save';

  // ── DOM ─────────────────────────────────────────────────────────────────────
  var arcadeBtn        = document.getElementById('jeu-arcade-btn');
  var arcadeOverlay    = document.getElementById('arcade-modal');
  var arcadeCloseBtn   = document.getElementById('arcade-close-btn');
  var screenGames      = document.getElementById('arcade-screen-games');
  var screenResume     = document.getElementById('arcade-screen-memory-resume');
  var screenSetup      = document.getElementById('arcade-screen-memory-setup');
  var screenGame       = document.getElementById('arcade-screen-memory-game');
  var screenWin        = document.getElementById('arcade-screen-memory-win');
  var screenLose       = document.getElementById('arcade-screen-memory-lose');
  var memPlayBtn       = document.getElementById('arcade-memory-play-btn');
  var memStartBtn      = document.getElementById('arcade-memory-start-btn');
  var memSetupBack     = document.getElementById('arcade-memory-setup-back');
  var setupTitleEl     = document.getElementById('arcade-setup-title');
  var tagPickerEl      = document.getElementById('arcade-tag-picker');
  var tagSearchEl      = document.getElementById('arcade-tag-search');
  var tagListEl        = document.getElementById('arcade-tag-list');
  var memLevelEl       = document.getElementById('mem-level');
  var memTimerEl       = document.getElementById('mem-timer');
  var memScoreEl       = document.getElementById('mem-score');
  var memGrid          = document.getElementById('arcade-memory-grid');
  var winLevelEl       = document.getElementById('win-level');
  var winScoreEl       = document.getElementById('win-score');
  var winLootboxEl     = document.getElementById('win-lootbox');
  var winNextBtn       = document.getElementById('win-next-btn');
  var winChangeModeBtn = document.getElementById('win-change-mode-btn');
  var winQuitBtn       = document.getElementById('win-quit-btn');
  var loseLevelEl      = document.getElementById('lose-level');
  var loseScoreEl      = document.getElementById('lose-score');
  var loseRetryBtn     = document.getElementById('lose-retry-btn');
  var loseQuitBtn      = document.getElementById('lose-quit-btn');
  var resumeLevelEl    = document.getElementById('resume-level');
  var resumeScoreEl    = document.getElementById('resume-score');
  var resumeModeEl     = document.getElementById('resume-mode-label');
  var resumeRestartBtn = document.getElementById('arcade-resume-restart');
  var resumeContinueBtn= document.getElementById('arcade-resume-continue');

  if (!arcadeOverlay) return;

  // ── State ────────────────────────────────────────────────────────────────────
  var _level       = 1;
  var _totalScore  = 0;
  var _score       = 0;
  var _pairs       = 4;
  var _matched     = 0;
  var _flipped     = [];
  var _cards       = [];
  var _locked      = false;
  var _timer       = null;
  var _timeLeft    = 0;
  var _mode        = 'random';
  var _selectedTag = null;
  var _allTags     = [];
  var _tagSearchTimeout = null;
  var _midGame     = false; // true when changing mode between levels

  // ── Helpers ──────────────────────────────────────────────────────────────────
  var _SCREENS = [screenGames, screenResume, screenSetup, screenGame, screenWin, screenLose];
  function showScreen(el) {
    _SCREENS.forEach(function(s) { if (s) s.hidden = true; });
    if (el) el.hidden = false;
  }

  function pairsForLevel(lvl) {
    if (lvl <= 2) return 4;
    if (lvl <= 4) return 6;
    if (lvl <= 6) return 8;
    return 10;
  }

  function timeForPairs(p) { return 60 + p * 12; }

  function formatTime(s) {
    var m = Math.floor(s / 60), ss = s % 60;
    return m + ':' + (ss < 10 ? '0' : '') + ss;
  }



  // ── Save / restore progress ───────────────────────────────────────────────────
  function saveProgress() {
    var inGame = screenGame && !screenGame.hidden;
    var inLose = screenLose && !screenLose.hidden;
    var inWin  = screenWin  && !screenWin.hidden;
    // Sauvegarder dès qu'une partie est en cours, peu importe le niveau ou le score
    if (inGame || inLose || inWin) {
      try {
        localStorage.setItem(SAVE_KEY, JSON.stringify({
          level: _level, totalScore: _totalScore,
          mode: _mode, tag: _selectedTag || null,
        }));
      } catch (_e) {}
    }
  }

  // Sauvegarde aussi quand la page se ferme / rafraîchit
  window.addEventListener('beforeunload', saveProgress);

  function clearProgress() {
    try { localStorage.removeItem(SAVE_KEY); } catch (_) {}
  }

  function loadSave() {
    try { return JSON.parse(localStorage.getItem(SAVE_KEY) || 'null'); } catch (_) { return null; }
  }

  // ── Modal open/close ─────────────────────────────────────────────────────────
  function openArcade() {
    arcadeOverlay.hidden = false;
    document.body.style.overflow = 'hidden';
    showScreen(screenGames);
  }

  function closeArcade() {
    saveProgress();
    clearInterval(_timer);
    arcadeOverlay.hidden = true;
    document.body.style.overflow = '';
  }

  arcadeBtn      && arcadeBtn.addEventListener('click', openArcade);
  arcadeCloseBtn && arcadeCloseBtn.addEventListener('click', closeArcade);
  arcadeOverlay.addEventListener('click', function(e) { if (e.target === arcadeOverlay) closeArcade(); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && arcadeOverlay && !arcadeOverlay.hidden) closeArcade();
  });

  // ── Memory: play button → resume or setup ─────────────────────────────────────
  memPlayBtn && memPlayBtn.addEventListener('click', function() {
    var saved = loadSave();
    if (saved && (saved.level > 1 || (saved.totalScore || 0) > 0)) {
      if (resumeLevelEl) resumeLevelEl.textContent = saved.level;
      if (resumeScoreEl) resumeScoreEl.textContent = saved.totalScore || 0;
      if (resumeModeEl) resumeModeEl.textContent = saved.mode === 'tag' && saved.tag
        ? 'Th\u00e8me\u00a0: ' + saved.tag
        : 'Images al\u00e9atoires';
      showScreen(screenResume);
      loadTags();
    } else {
      startFreshSetup();
    }
  });

  resumeRestartBtn && resumeRestartBtn.addEventListener('click', function() {
    clearProgress();
    startFreshSetup();
  });

  resumeContinueBtn && resumeContinueBtn.addEventListener('click', function() {
    var saved = loadSave();
    if (!saved) { startFreshSetup(); return; }
    _level      = saved.level || 1;
    _totalScore = saved.totalScore || 0;
    _mode       = saved.mode || 'random';
    _selectedTag= saved.tag || null;
    clearProgress();
    startLevel(_level);
  });

  function startFreshSetup() {
    _level = 1; _totalScore = 0; _midGame = false;
    document.querySelectorAll('input[name="memory-mode"]').forEach(function(r) {
      if (r.value === 'random') r.checked = true;
    });
    _mode = 'random'; _selectedTag = null;
    if (tagPickerEl) tagPickerEl.hidden = true;
    if (setupTitleEl) setupTitleEl.textContent = 'Memory \u2014 Configuration';
    if (memStartBtn) memStartBtn.textContent = 'Commencer';
    if (memSetupBack) memSetupBack.textContent = '\u2190 Retour';
    showScreen(screenSetup);
    loadTags();
  }

  function loadTags() {
    fetch('/arcade/tags?min=8')
      .then(function(r) { return r.json(); })
      .then(function(d) { _allTags = d.tags || []; renderTagList(''); })
      .catch(function() {});
  }

  document.querySelectorAll('input[name="memory-mode"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      _mode = radio.value;
      if (tagPickerEl) tagPickerEl.hidden = _mode !== 'tag';
      if (_mode === 'random') _selectedTag = null;
    });
  });

  tagSearchEl && tagSearchEl.addEventListener('input', function() {
    clearTimeout(_tagSearchTimeout);
    var q = tagSearchEl.value.toLowerCase().trim();
    _tagSearchTimeout = setTimeout(function() { renderTagList(q); }, 200);
  });

  function renderTagList(filter) {
    if (!tagListEl) return;
    tagListEl.innerHTML = '';
    var list = _allTags.filter(function(t) {
      return !filter || t.tag.toLowerCase().includes(filter);
    }).slice(0, 40);
    if (!list.length) {
      tagListEl.innerHTML = '<p style="color:#64748b;font-size:.8rem;text-align:center;margin:.5rem 0">Aucun th\u00e8me disponible</p>';
      return;
    }
    list.forEach(function(t) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'arcade-tag-btn' + (_selectedTag === t.tag ? ' arcade-tag-btn--active' : '');
      btn.textContent = t.tag + ' (' + t.count + ')';
      btn.dataset.tag = t.tag;
      btn.addEventListener('click', function() {
        _selectedTag = t.tag;
        tagListEl.querySelectorAll('.arcade-tag-btn').forEach(function(b) {
          b.classList.toggle('arcade-tag-btn--active', b.dataset.tag === t.tag);
        });
      });
      tagListEl.appendChild(btn);
    });
  }

  memSetupBack && memSetupBack.addEventListener('click', function() {
    if (_midGame) { _midGame = false; showScreen(screenWin); }
    else showScreen(screenGames);
  });

  memStartBtn && memStartBtn.addEventListener('click', function() {
    if (_mode === 'tag' && !_selectedTag) {
      alert('Veuillez choisir un th\u00e8me.'); return;
    }
    var nextLvl = _midGame ? _level + 1 : _level;
    _midGame = false;
    startLevel(nextLvl);
  });

  // ── Win screen: change mode between levels ────────────────────────────────────
  winChangeModeBtn && winChangeModeBtn.addEventListener('click', function() {
    _midGame = true;
    // Pre-populate radios to current mode
    document.querySelectorAll('input[name="memory-mode"]').forEach(function(r) {
      r.checked = r.value === _mode;
    });
    if (tagPickerEl) tagPickerEl.hidden = _mode !== 'tag';
    if (setupTitleEl) setupTitleEl.textContent = 'Memory \u2014 Changer de mode';
    if (memStartBtn) memStartBtn.textContent = 'Continuer au niveau ' + (_level + 1);
    if (memSetupBack) memSetupBack.textContent = '\u2190 Annuler';
    showScreen(screenSetup);
  });

  // ── Level start ───────────────────────────────────────────────────────────────
  function startLevel(lvl) {
    _level = lvl;
    _score = 0;
    _matched = 0;
    _flipped = [];
    _locked = false;
    _pairs = pairsForLevel(lvl);
    _timeLeft = timeForPairs(_pairs);
    clearInterval(_timer);

    if (memLevelEl) memLevelEl.textContent = lvl;
    if (memScoreEl) memScoreEl.textContent = _totalScore;
    if (memTimerEl) { memTimerEl.textContent = formatTime(_timeLeft); memTimerEl.style.color = ''; }
    if (memGrid) {
      memGrid.innerHTML = '';
      var ph = document.createElement('div');
      ph.style.cssText = 'grid-column:1/-1;color:#64748b;text-align:center;padding:2rem;font-size:.9rem';
      ph.textContent = 'Chargement\u2026';
      memGrid.appendChild(ph);
    }
    showScreen(screenGame);

    var url = '/arcade/memory-images?count=' + _pairs;
    if (_mode === 'tag' && _selectedTag) url += '&tag=' + encodeURIComponent(_selectedTag);

    fetch(url)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var imgs = (d.images || []).slice(0, _pairs);
        if (imgs.length < 4) {
          alert('Pas assez d\'images disponibles pour ce th\u00e8me.');
          showScreen(screenGames); return;
        }
        if (imgs.length < _pairs) {
          _pairs = imgs.length;
          _timeLeft = timeForPairs(_pairs);
          if (_mode === 'tag') { _mode = 'random'; _selectedTag = null; }
        }
        buildCardGrid(imgs);
        startTimer();
      })
      .catch(function() {
        alert('Erreur lors du chargement des images.');
        showScreen(screenGames);
      });
  }

  // ── Card grid ─────────────────────────────────────────────────────────────────
  function buildCardGrid(images) {
    if (!memGrid) return;
    memGrid.innerHTML = '';

    var cardData = [];
    images.forEach(function(img, i) {
      cardData.push({ img: img, pairId: i });
      cardData.push({ img: img, pairId: i });
    });
    for (var i = cardData.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = cardData[i]; cardData[i] = cardData[j]; cardData[j] = tmp;
    }

    var cols = _pairs <= 4 ? 4 : (_pairs <= 6 ? 4 : (_pairs <= 8 ? 4 : 5));
    memGrid.style.gridTemplateColumns = 'repeat(' + cols + ', 1fr)';

    _cards = [];
    cardData.forEach(function(data, idx) {
      var card = document.createElement('div');
      card.className = 'mem-card';

      var inner = document.createElement('div');
      inner.className = 'mem-card-inner';

      var back = document.createElement('div');
      back.className = 'mem-card-back';
      var backIcon = document.createElement('span');
      backIcon.className = 'mem-card-back-icon';
      backIcon.textContent = '\u2605';
      back.appendChild(backIcon);

      var front = document.createElement('div');
      front.className = 'mem-card-front';
      var img = document.createElement('img');
      img.src = data.img.thumb;
      img.alt = data.img.title || '';
      img.loading = 'eager';
      front.appendChild(img);

      inner.appendChild(back);
      inner.appendChild(front);
      card.appendChild(inner);

      var capturedIdx = idx;
      card.addEventListener('click', function() { onCardClick(capturedIdx); });
      memGrid.appendChild(card);
      _cards.push({ el: card, pairId: data.pairId, matched: false, flipped: false });
    });
  }

  // ── Card logic ────────────────────────────────────────────────────────────────
  function onCardClick(idx) {
    var c = _cards[idx];
    if (_locked || !c || c.matched || c.flipped) return;
    c.flipped = true;
    c.el.classList.add('flipped');
    _flipped.push(idx);

    if (_flipped.length < 2) return;

    _locked = true;
    var a = _cards[_flipped[0]], b = _cards[_flipped[1]];

    if (a.pairId === b.pairId) {
      setTimeout(function() {
        a.matched = true; b.matched = true;
        a.el.classList.add('matched'); b.el.classList.add('matched');
        _matched++;
        var pts = 100 * _level;
        _score += pts; _totalScore += pts;
        if (memScoreEl) memScoreEl.textContent = _totalScore;
        _flipped = [];
        _locked = false;
        if (_matched >= _pairs) onLevelComplete();
      }, 350);
    } else {
      var penalty = Math.min(10, _totalScore);
      _totalScore = Math.max(0, _totalScore - penalty);
      if (memScoreEl) memScoreEl.textContent = _totalScore;
      setTimeout(function() {
        a.flipped = false; b.flipped = false;
        a.el.classList.remove('flipped'); b.el.classList.remove('flipped');
        _flipped = [];
        _locked = false;
      }, 850);
    }
  }

  // ── Timer ─────────────────────────────────────────────────────────────────────
  function startTimer() {
    clearInterval(_timer);
    _timer = setInterval(function() {
      _timeLeft--;
      if (memTimerEl) {
        memTimerEl.textContent = formatTime(_timeLeft);
        memTimerEl.style.color = _timeLeft <= 15 ? '#f87171' : '';
      }
      if (_timeLeft <= 0) { clearInterval(_timer); onTimerOut(); }
    }, 1000);
  }

  // ── Level complete ────────────────────────────────────────────────────────────
  function onLevelComplete() {
    clearInterval(_timer);
    _totalScore += _timeLeft * 5;

    fetch('/arcade/memory-complete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ level: _level, won: true, score: _totalScore }),
    })
      .then(function(r) { return r.json(); })
      .then(function(d) { showWinScreen(d.lootboxGranted); })
      .catch(function() { showWinScreen(false); });
  }

  function showWinScreen(lootboxGranted) {
    if (winLevelEl) winLevelEl.textContent = _level;
    if (winScoreEl) winScoreEl.textContent = _totalScore;
    if (winLootboxEl) winLootboxEl.hidden = !lootboxGranted;
    if (lootboxGranted) {
      // Synchronise le compteur lootbox dans lootbox.js (fix : _count était stale)
      if (typeof window._lbRefreshCount === 'function') window._lbRefreshCount();
    }
    showScreen(screenWin);
  }

  winNextBtn && winNextBtn.addEventListener('click', function() {
    _level++;
    startLevel(_level);
  });

  winQuitBtn && winQuitBtn.addEventListener('click', function() {
    clearProgress();
    showScreen(screenGames);
  });

  // ── Timer out ─────────────────────────────────────────────────────────────────
  function onTimerOut() {
    fetch('/arcade/memory-complete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ level: _level, won: false, score: _totalScore }),
    }).catch(function() {});
    if (loseLevelEl) loseLevelEl.textContent = _level;
    if (loseScoreEl) loseScoreEl.textContent = _totalScore;
    showScreen(screenLose);
  }

  loseRetryBtn && loseRetryBtn.addEventListener('click', function() {
    startLevel(_level);
  });

  loseQuitBtn && loseQuitBtn.addEventListener('click', function() {
    clearProgress();
    showScreen(screenGames);
  });
})();
</script>

<script>
/* ═══════════════════════════════════════════════════════════════════════════
   AVENTURE — modal simple
   ═══════════════════════════════════════════════════════════════════════════ */
(function () {
  var overlay  = document.getElementById('aventure-modal');
  var openBtn  = document.getElementById('jeu-aventure-btn');
  var closeBtn = document.getElementById('aventure-close-btn');
  if (!overlay) return;
  function open()  { overlay.hidden = false; document.body.style.overflow = 'hidden'; }
  function close() { overlay.hidden = true;  document.body.style.overflow = ''; }
  openBtn  && openBtn.addEventListener('click', open);
  closeBtn && closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !overlay.hidden) close(); });
})();
</script>

<script>
/* ═══════════════════════════════════════════════════════════════════════════
   CASINO — Machine à charmes
   ═══════════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var overlay         = document.getElementById('casino-modal');
  var closeBtn        = document.getElementById('casino-close-btn');
  var openBtn         = document.getElementById('jeu-casino-btn');
  var screenGames     = document.getElementById('casino-screen-games');
  var screenSlots     = document.getElementById('casino-screen-charm-slots');
  var slotsOpenBtn    = document.getElementById('casino-charm-slots-open');
  var slotsBackBtn    = document.getElementById('charm-slots-back');
  var slotsPlayBtn    = document.getElementById('charm-slots-play');
  var slotsCoinsEl    = document.getElementById('slots-coins');
  var slotsResultEl   = document.getElementById('slots-result');
  var slotsWinFlash   = document.getElementById('slots-win-flash');
  var reels           = [
    document.getElementById('slots-reel-0'),
    document.getElementById('slots-reel-1'),
    document.getElementById('slots-reel-2'),
  ];

  if (!overlay) return;

  var _charms      = [];
  var _coins       = parseInt((slotsCoinsEl && slotsCoinsEl.textContent) || '0', 10) || 0;
  var _spinning    = false;
  var _spinTimers  = [null, null, null];

  // ── Écrans ──────────────────────────────────────────────────────────────────
  function showScreen(el) {
    [screenGames, screenSlots].forEach(function(s) { if (s) s.hidden = true; });
    if (el) el.hidden = false;
  }

  // ── Ouverture / fermeture ────────────────────────────────────────────────────
  function openCasino() {
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    showScreen(screenGames);
  }
  function closeCasino() {
    overlay.hidden = true;
    document.body.style.overflow = '';
  }

  openBtn  && openBtn.addEventListener('click', openCasino);
  closeBtn && closeBtn.addEventListener('click', closeCasino);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeCasino(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !overlay.hidden) closeCasino(); });

  // ── Chargement des charmes ───────────────────────────────────────────────────
  function loadCharms(cb) {
    if (_charms.length) { cb(); return; }
    fetch('/arcade/charm-slots/info')
      .then(function(r) { return r.json(); })
      .then(function(d) { _charms = d.charms || []; cb(); })
      .catch(function() { cb(); });
  }

  // ── Ouvrir l'écran slots ─────────────────────────────────────────────────────
  slotsOpenBtn && slotsOpenBtn.addEventListener('click', function() {
    loadCharms(function() {
      showScreen(screenSlots);
      resetReels();
      if (slotsResultEl) slotsResultEl.hidden = true;
      if (slotsWinFlash) slotsWinFlash.hidden = true;
      updateCoinsUI();
    });
  });

  slotsBackBtn && slotsBackBtn.addEventListener('click', function() {
    showScreen(screenGames);
  });

  // ── Pièces ───────────────────────────────────────────────────────────────────
  function updateCoinsUI() {
    if (slotsCoinsEl) slotsCoinsEl.textContent = _coins;
    if (slotsPlayBtn) slotsPlayBtn.disabled = _spinning || _coins < 4;
  }

  // ── Animation rouleaux ───────────────────────────────────────────────────────
  function randomSymbol() {
    if (!_charms.length) return '\u2605';
    return _charms[Math.floor(Math.random() * _charms.length)].symbol;
  }

  function resetReels() {
    reels.forEach(function(r) {
      if (r) { r.textContent = randomSymbol(); r.classList.remove('spinning', 'reel-win'); }
    });
  }

  function startReelSpin(idx) {
    clearInterval(_spinTimers[idx]);
    var r = reels[idx];
    if (r) r.classList.add('spinning');
    _spinTimers[idx] = setInterval(function() {
      if (r) r.textContent = randomSymbol();
    }, 70);
  }

  function stopReel(idx, symbol, delay) {
    return new Promise(function(resolve) {
      setTimeout(function() {
        clearInterval(_spinTimers[idx]);
        var r = reels[idx];
        if (r) { r.textContent = symbol; r.classList.remove('spinning'); }
        resolve();
      }, delay);
    });
  }

  // ── Jouer ────────────────────────────────────────────────────────────────────
  slotsPlayBtn && slotsPlayBtn.addEventListener('click', function() {
    if (_spinning || _coins < 4) return;
    _spinning = true;
    if (slotsResultEl) slotsResultEl.hidden = true;
    if (slotsWinFlash) slotsWinFlash.hidden = true;
    reels.forEach(function(r) { if (r) r.classList.remove('reel-win'); });
    updateCoinsUI();

    // Lancer l'animation de tous les rouleaux
    [0, 1, 2].forEach(startReelSpin);

    fetch('/arcade/charm-slots', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({}),
    })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.ok) {
          [0, 1, 2].forEach(function(i) { clearInterval(_spinTimers[i]); });
          _spinning = false;
          if (d.error === 'not_enough_coins') _coins = 0;
          updateCoinsUI();
          showResultMessage(false, null);
          return;
        }

        var syms = d.symbols.map(function(s) { return s.symbol; });
        // Arrêt séquentiel des rouleaux
        Promise.all([
          stopReel(0, syms[0], 700),
          stopReel(1, syms[1], 1100),
          stopReel(2, syms[2], 1500),
        ]).then(function() {
          // Attendre la fin du dernier stop
          setTimeout(function() {
            _spinning = false;
            _coins = d.newCoins;
            updateCoinsUI();
            if (d.win) {
              reels.forEach(function(r) { if (r) r.classList.add('reel-win'); });
              if (slotsWinFlash) slotsWinFlash.hidden = false;
            }
            showResultMessage(d.win, d.reward);
          }, 200);
        });
      })
      .catch(function() {
        [0, 1, 2].forEach(function(i) { clearInterval(_spinTimers[i]); });
        _spinning = false;
        updateCoinsUI();
      });
  });

  // ── Afficher le résultat ─────────────────────────────────────────────────────
  function showResultMessage(win, reward) {
    if (!slotsResultEl) return;
    slotsResultEl.hidden = false;
    slotsResultEl.className = 'slots-result ' + (win ? 'slots-result--win' : 'slots-result--lose');
    slotsResultEl.textContent = '';

    if (win && reward) {
      var icon = document.createElement('span');
      icon.className = 'slots-reward-icon';
      icon.textContent = reward.charm.symbol;

      var line1 = document.createElement('strong');
      var line2 = document.createElement('span');

      if (reward.type === 'charm') {
        line1.textContent = '\uD83C\uDF89 ' + reward.charm.label + ' d\u00e9bloqu\u00e9\u00a0!';
        slotsResultEl.appendChild(icon);
        slotsResultEl.appendChild(line1);
      } else {
        line1.textContent = '\uD83C\uDF89 D\u00e9j\u00e0 poss\u00e9d\u00e9';
        line2.textContent = '+' + reward.coins + '\u00a0pi\u00e8ces compens\u00e9es';
        slotsResultEl.appendChild(icon);
        slotsResultEl.appendChild(line1);
        slotsResultEl.appendChild(document.createElement('br'));
        slotsResultEl.appendChild(line2);
      }
    } else {
      slotsResultEl.textContent = 'Pas de chance\u2026 r\u00e9essayez\u00a0!';
    }
  }
})();
</script>
