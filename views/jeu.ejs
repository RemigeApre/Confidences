<%- include('partials/head', { title: 'Jeu' }) %>
<%- include('partials/top-nav', { config: config, navTitle: 'Jeu' }) %>

<div class="jeu-viewport">

  <%# ── Engrenage paramètres (haut droite) ── %>
  <button class="jeu-settings-btn" id="jeu-settings-btn" aria-label="Paramètres des récompenses" title="Paramètres des récompenses">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3"/>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
    </svg>
  </button>

  <%# ── Contenu principal ── %>
  <div class="jeu-content">
    <h1 class="jeu-title">Jeu</h1>
    <p class="jeu-subtitle">D&rsquo;autres r&eacute;compenses arrivent bient&ocirc;t&hellip;</p>
  </div>

  <%# ── Lootbox (bas droite) ── %>
  <div class="jeu-lootbox-area" id="jeu-lootbox-area">
    <button class="jeu-lootbox-btn" id="jeu-lootbox-btn" aria-label="Ouvrir une lootbox" disabled>
      <%# Coffre SVG très graphique %>
      <svg class="jeu-chest-svg" viewBox="0 0 140 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="jbody" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="hsl(28,70%,36%)"/><stop offset="100%" stop-color="hsl(28,58%,20%)"/></linearGradient>
    <linearGradient id="jlid" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="hsl(28,68%,42%)"/><stop offset="100%" stop-color="hsl(28,60%,28%)"/></linearGradient>
    <linearGradient id="jgold" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="hsl(44,98%,66%)"/><stop offset="100%" stop-color="hsl(38,88%,42%)"/></linearGradient>
    <linearGradient id="jgem1" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="hsl(355,90%,72%)"/><stop offset="100%" stop-color="hsl(355,80%,48%)"/></linearGradient>
    <linearGradient id="jgem2" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="hsl(210,90%,72%)"/><stop offset="100%" stop-color="hsl(210,80%,48%)"/></linearGradient>
    <linearGradient id="jgem3" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="hsl(140,80%,62%)"/><stop offset="100%" stop-color="hsl(140,70%,38%)"/></linearGradient>
    <filter id="jglow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <!-- Ombre portée -->
  <ellipse cx="70" cy="106" rx="42" ry="5" fill="rgba(0,0,0,.35)"/>
  <!-- Corps -->
  <rect x="10" y="58" width="120" height="44" rx="5" fill="url(#jbody)" stroke="hsl(38,80%,38%)" stroke-width="2.5"/>
  <!-- Planches corps -->
  <line x1="11" y1="76" x2="129" y2="76" stroke="rgba(0,0,0,.25)" stroke-width="1.5"/>
  <line x1="11" y1="91" x2="129" y2="91" stroke="rgba(0,0,0,.25)" stroke-width="1.5"/>
  <!-- Couvercle arrondi -->
  <path d="M10 60 Q10 28 70 28 Q130 28 130 60 Z" fill="url(#jlid)" stroke="hsl(38,80%,38%)" stroke-width="2.5"/>
  <!-- Reflet couvercle -->
  <path d="M22 52 Q38 34 70 32 Q102 34 118 52" fill="none" stroke="rgba(255,255,255,.16)" stroke-width="3.5" stroke-linecap="round"/>
  <!-- Bande horizontale centrale (or) -->
  <rect x="8" y="56" width="124" height="9" rx="3.5" fill="url(#jgold)" stroke="hsl(38,72%,30%)" stroke-width="1.5"/>
  <!-- Bande verticale -->
  <rect x="62" y="57" width="16" height="44" fill="url(#jgold)" stroke="hsl(38,72%,30%)" stroke-width="1" opacity=".7"/>
  <rect x="8" y="56" width="124" height="9" rx="3.5" fill="url(#jgold)" stroke="hsl(38,72%,30%)" stroke-width="1.5"/>
  <!-- Charnières -->
  <rect x="18" y="54" width="16" height="14" rx="3" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1.5"/>
  <rect x="106" y="54" width="16" height="14" rx="3" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1.5"/>
  <!-- Coins renforcés -->
  <rect x="8" y="58" width="10" height="44" rx="2" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1" opacity=".6"/>
  <rect x="122" y="58" width="10" height="44" rx="2" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1" opacity=".6"/>
  <!-- Rivets corps -->
  <circle cx="24" cy="72" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="116" cy="72" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="24" cy="87" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="116" cy="87" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="24" cy="100" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="116" cy="100" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <!-- Cadenas central -->
  <rect x="56" y="56" width="28" height="19" rx="4" fill="url(#jgold)" stroke="hsl(38,68%,28%)" stroke-width="1.5" filter="url(#jglow)"/>
  <path d="M62 56 Q62 46 70 46 Q78 46 78 56" fill="none" stroke="url(#jgold)" stroke-width="3.5" stroke-linecap="round"/>
  <circle cx="70" cy="66" r="4" fill="hsl(28,52%,18%)"/>
  <circle cx="70" cy="66" r="1.5" fill="hsl(38,80%,50%)"/>
  <!-- Gemmes sur la bande centrale -->
  <polygon points="38,60 43,56 48,60 43,64" fill="url(#jgem1)" stroke="hsl(355,70%,38%)" stroke-width="1" filter="url(#jglow)"/>
  <polygon points="97,60 102,56 107,60 102,64" fill="url(#jgem2)" stroke="hsl(210,70%,38%)" stroke-width="1" filter="url(#jglow)"/>
  <!-- Gemme couvercle -->
  <polygon points="70,30 76,38 70,44 64,38" fill="url(#jgem3)" stroke="hsl(140,65%,30%)" stroke-width="1.2" filter="url(#jglow)"/>
  <polygon points="70,33 74,38 70,42 66,38" fill="rgba(255,255,255,.3)" stroke="none"/>
</svg>

      <span class="jeu-lootbox-count" id="jeu-lootbox-count" hidden></span>
      <span class="jeu-lootbox-label" id="jeu-lootbox-label">Aucune lootbox</span>
    </button>
  </div>

</div>

<%# ── Popover paramètres lootbox ── %>
<div class="jeu-settings-popover" id="jeu-settings-popover" role="dialog" aria-modal="true" aria-labelledby="jeu-settings-title" hidden>
  <div class="jeu-settings-popover-inner">
    <div class="jeu-settings-popover-header">
      <span class="jeu-settings-popover-title" id="jeu-settings-title">Récompenses des lootboxes</span>
      <button class="jeu-settings-close" id="jeu-settings-close" aria-label="Fermer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p class="jeu-settings-hint">Choisissez quels types d&rsquo;images peuvent appara&icirc;tre dans vos r&eacute;compenses.</p>
    <label class="jeu-settings-toggle">
      <span class="jeu-settings-toggle-label">Images <strong>Ultra</strong></span>
      <input type="checkbox" class="jeu-settings-checkbox" id="jeu-settings-ultra"
             <%- currentUser.lootboxAllowUltra ? 'checked' : '' %>>
      <span class="jeu-settings-toggle-track"><span class="jeu-settings-toggle-thumb"></span></span>
    </label>
    <label class="jeu-settings-toggle">
      <span class="jeu-settings-toggle-label">Images <strong>Irr&eacute;aliste</strong></span>
      <input type="checkbox" class="jeu-settings-checkbox" id="jeu-settings-irrealiste"
             <%- currentUser.lootboxAllowIrrealiste ? 'checked' : '' %>>
      <span class="jeu-settings-toggle-track"><span class="jeu-settings-toggle-thumb"></span></span>
    </label>
  </div>
</div>

<%- include('partials/foot') %>

<script>
(function () {
  var settingsBtn     = document.getElementById('jeu-settings-btn');
  var settingsPop     = document.getElementById('jeu-settings-popover');
  var settingsClose   = document.getElementById('jeu-settings-close');
  var ultraChk        = document.getElementById('jeu-settings-ultra');
  var irrealisteChk   = document.getElementById('jeu-settings-irrealiste');

  function openSettings() { settingsPop.hidden = false; settingsPop.removeAttribute('hidden'); settingsClose.focus(); }
  function closeSettings() { settingsPop.hidden = true; settingsPop.setAttribute('hidden', ''); settingsBtn.focus(); }

  settingsBtn   && settingsBtn.addEventListener('click', function() {
    if (settingsPop.hidden) openSettings(); else closeSettings();
  });
  settingsClose && settingsClose.addEventListener('click', closeSettings);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !settingsPop.hidden) closeSettings();
  });
  // Clic hors du popover le ferme
  document.addEventListener('click', function(e) {
    if (!settingsPop.hidden && !settingsPop.contains(e.target) && e.target !== settingsBtn && !settingsBtn.contains(e.target)) {
      closeSettings();
    }
  });

  function saveSettings() {
    fetch('/lootbox/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        allowUltra:      ultraChk      ? ultraChk.checked      : false,
        allowIrrealiste: irrealisteChk ? irrealisteChk.checked : true,
      }),
    });
  }

  ultraChk      && ultraChk.addEventListener('change',      saveSettings);
  irrealisteChk && irrealisteChk.addEventListener('change', saveSettings);
})();
</script>
