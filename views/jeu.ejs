<%- include('partials/head', { title: 'Jeu' }) %>
<%- include('partials/top-nav', { config: config, navTitle: 'Jeu' }) %>

<div class="jeu-viewport">

  <%# ── Vue accueil (catégories + lootbox) ── %>
  <div id="jeu-home-view">

    <%# ── Bouton info (haut droite) ── %>
    <div class="jeu-top-btns">
    <button class="jeu-info-btn" id="jeu-info-btn" aria-label="Informations sur les récompenses" title="Informations sur les récompenses">
      <svg viewBox="0 0 100 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="6" y="44" width="88" height="32" rx="4" stroke="currentColor" stroke-width="3.5" fill="none"/>
        <path d="M6 46 Q6 18 50 18 Q94 18 94 46 Z" stroke="currentColor" stroke-width="3.5" fill="none"/>
        <rect x="4" y="42" width="92" height="7" rx="2.5" stroke="currentColor" stroke-width="2.5" fill="none"/>
        <rect x="40" y="42" width="20" height="13" rx="3" stroke="currentColor" stroke-width="2.5" fill="none"/>
        <path d="M44 42 Q44 35 50 35 Q56 35 56 42" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      </svg>
    </button>
    </div>

    <%# ── Grille de catégories ── %>
    <div class="jeu-categories">

      <button class="jeu-cat-btn jeu-cat-btn--arcade" id="jeu-arcade-btn" aria-label="Arcade">
        <span class="jeu-cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="M8 12h2m-1-1v2M14 11h.01M16 13h.01"/></svg>
        </span>
        <span class="jeu-cat-name">Arcade</span>
      </button>

      <button class="jeu-cat-btn jeu-cat-btn--casino" id="jeu-casino-btn" aria-label="Casino">
        <span class="jeu-cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="8" height="8" rx="1.5"/><rect x="14" y="2" width="8" height="8" rx="1.5"/><rect x="2" y="14" width="8" height="8" rx="1.5"/><rect x="14" y="14" width="8" height="8" rx="1.5"/><circle cx="6" cy="6" r="1.2" fill="currentColor"/><circle cx="18" cy="6" r="1.2" fill="currentColor"/><circle cx="18" cy="10" r="1.2" fill="currentColor"/><circle cx="6" cy="18" r="1.2" fill="currentColor"/><circle cx="18" cy="18" r="1.2" fill="currentColor"/></svg>
        </span>
        <span class="jeu-cat-name">Casino</span>
      </button>

      <button class="jeu-cat-btn jeu-cat-btn--aventure" id="jeu-aventure-btn" aria-label="Aventure">
        <span class="jeu-cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 10.5 L12 3 L9.5 10.5 L3 8 L7.5 14 L3 20 L12 17 L21 20 L16.5 14 L21 8 Z"/></svg>
        </span>
        <span class="jeu-cat-name">Aventure</span>
      </button>

    </div>

  </div><%# /jeu-home-view %>

  <%# ── Lootbox (bas droite, toujours visible) ── %>
  <div class="jeu-lootbox-area" id="jeu-lootbox-area">
    <button class="jeu-lootbox-btn" id="jeu-lootbox-btn" aria-label="Ouvrir une lootbox" disabled>
      <%# Coffre SVG très graphique %>
      <svg class="jeu-chest-svg" viewBox="0 0 140 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="jbody" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="hsl(28,70%,36%)"/><stop offset="100%" stop-color="hsl(28,58%,20%)"/></linearGradient>
    <linearGradient id="jlid" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="hsl(28,68%,42%)"/><stop offset="100%" stop-color="hsl(28,60%,28%)"/></linearGradient>
    <linearGradient id="jgold" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="hsl(44,98%,66%)"/><stop offset="100%" stop-color="hsl(38,88%,42%)"/></linearGradient>
    <linearGradient id="jgem1" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="hsl(355,90%,72%)"/><stop offset="100%" stop-color="hsl(355,80%,48%)"/></linearGradient>
    <linearGradient id="jgem2" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="hsl(210,90%,72%)"/><stop offset="100%" stop-color="hsl(210,80%,48%)"/></linearGradient>
    <linearGradient id="jgem3" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="hsl(140,80%,62%)"/><stop offset="100%" stop-color="hsl(140,70%,38%)"/></linearGradient>
    <filter id="jglow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <ellipse cx="70" cy="106" rx="42" ry="5" fill="rgba(0,0,0,.35)"/>
  <rect x="10" y="58" width="120" height="44" rx="5" fill="url(#jbody)" stroke="hsl(38,80%,38%)" stroke-width="2.5"/>
  <line x1="11" y1="76" x2="129" y2="76" stroke="rgba(0,0,0,.25)" stroke-width="1.5"/>
  <line x1="11" y1="91" x2="129" y2="91" stroke="rgba(0,0,0,.25)" stroke-width="1.5"/>
  <path d="M10 60 Q10 28 70 28 Q130 28 130 60 Z" fill="url(#jlid)" stroke="hsl(38,80%,38%)" stroke-width="2.5"/>
  <path d="M22 52 Q38 34 70 32 Q102 34 118 52" fill="none" stroke="rgba(255,255,255,.16)" stroke-width="3.5" stroke-linecap="round"/>
  <rect x="8" y="56" width="124" height="9" rx="3.5" fill="url(#jgold)" stroke="hsl(38,72%,30%)" stroke-width="1.5"/>
  <rect x="62" y="57" width="16" height="44" fill="url(#jgold)" stroke="hsl(38,72%,30%)" stroke-width="1" opacity=".7"/>
  <rect x="8" y="56" width="124" height="9" rx="3.5" fill="url(#jgold)" stroke="hsl(38,72%,30%)" stroke-width="1.5"/>
  <rect x="18" y="54" width="16" height="14" rx="3" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1.5"/>
  <rect x="106" y="54" width="16" height="14" rx="3" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1.5"/>
  <rect x="8" y="58" width="10" height="44" rx="2" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1" opacity=".6"/>
  <rect x="122" y="58" width="10" height="44" rx="2" fill="url(#jgold)" stroke="hsl(38,70%,28%)" stroke-width="1" opacity=".6"/>
  <circle cx="24" cy="72" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="116" cy="72" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="24" cy="87" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="116" cy="87" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="24" cy="100" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <circle cx="116" cy="100" r="3.5" fill="url(#jgold)" stroke="hsl(38,65%,28%)" stroke-width="1"/>
  <rect x="56" y="56" width="28" height="19" rx="4" fill="url(#jgold)" stroke="hsl(38,68%,28%)" stroke-width="1.5" filter="url(#jglow)"/>
  <path d="M62 56 Q62 46 70 46 Q78 46 78 56" fill="none" stroke="url(#jgold)" stroke-width="3.5" stroke-linecap="round"/>
  <circle cx="70" cy="66" r="4" fill="hsl(28,52%,18%)"/>
  <circle cx="70" cy="66" r="1.5" fill="hsl(38,80%,50%)"/>
  <polygon points="38,60 43,56 48,60 43,64" fill="url(#jgem1)" stroke="hsl(355,70%,38%)" stroke-width="1" filter="url(#jglow)"/>
  <polygon points="97,60 102,56 107,60 102,64" fill="url(#jgem2)" stroke="hsl(210,70%,38%)" stroke-width="1" filter="url(#jglow)"/>
  <polygon points="70,30 76,38 70,44 64,38" fill="url(#jgem3)" stroke="hsl(140,65%,30%)" stroke-width="1.2" filter="url(#jglow)"/>
  <polygon points="70,33 74,38 70,42 66,38" fill="rgba(255,255,255,.3)" stroke="none"/>
</svg>

      <span class="jeu-lootbox-count" id="jeu-lootbox-count" hidden></span>
      <span class="jeu-lootbox-label" id="jeu-lootbox-label">Aucune lootbox</span>
    </button>
  </div>

  <%# ── Arcade en-page ── %>
  <div id="arcade-modal" class="arcade-inpage" hidden>
    <div class="arcade-modal">

      <%# ── En-tête page ── %>
      <div class="arcade-page-header">
        <button class="arcade-page-back" id="arcade-hdr-back-btn" aria-label="Retour">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        </button>
        <h1 class="arcade-page-title">Arcade</h1>
      </div>

    <%# ── Liste des jeux ── %>
    <div id="arcade-screen-games" class="arcade-screen arcade-screen--gamelist">

      <%# Volet gauche — filtres (vide pour l'instant) %>
      <aside class="arcade-sidebar">
        <p class="arcade-sidebar-title">Filtres</p>
      </aside>

      <%# Grille de jeux %>
      <div class="arcade-games-grid">

        <%# Memory %>
        <div class="ag-card ag-card--memory">
          <div class="ag-card-visual">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="2"  y="2"  width="9" height="9" rx="2.2"/>
              <rect x="13" y="2"  width="9" height="9" rx="2.2"/>
              <rect x="2"  y="13" width="9" height="9" rx="2.2"/>
              <rect x="13" y="13" width="9" height="9" rx="2.2"/>
            </svg>
          </div>
          <div class="ag-card-body">
            <div class="ag-card-head">
              <span class="ag-card-name">Memory</span>
              <span class="arcade-game-level-badge" id="arcade-memory-level-badge" hidden></span>
            </div>
            <p class="ag-card-desc">Retrouvez toutes les paires de cartes avant la fin du temps imparti.</p>
            <div class="ag-card-footer">
              <button class="ag-card-play" id="arcade-memory-play-btn">Jouer</button>
            </div>
          </div>
        </div>

        <%# Wordle %>
        <div class="ag-card ag-card--wordle">
          <div class="ag-card-visual">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3"   y="3"   width="5" height="5" rx="1.2"/>
              <rect x="9.5" y="3"   width="5" height="5" rx="1.2"/>
              <rect x="16"  y="3"   width="5" height="5" rx="1.2"/>
              <rect x="3"   y="9.5" width="5" height="5" rx="1.2"/>
              <rect x="9.5" y="9.5" width="5" height="5" rx="1.2" fill="currentColor" opacity=".4"/>
              <rect x="16"  y="9.5" width="5" height="5" rx="1.2"/>
              <rect x="3"   y="16"  width="5" height="5" rx="1.2"/>
              <rect x="9.5" y="16"  width="5" height="5" rx="1.2"/>
              <rect x="16"  y="16"  width="5" height="5" rx="1.2"/>
            </svg>
          </div>
          <div class="ag-card-body">
            <div class="ag-card-head">
              <span class="ag-card-name">Wordle</span>
            </div>
            <p class="ag-card-desc">Trouvez le mot du Codex en&nbsp;6 essais. Quotidien.</p>
            <div class="ag-card-footer">
              <button class="ag-card-play" id="arcade-wordle-play-btn">Jouer</button>
            </div>
          </div>
        </div>

        <%# Jeu de Cartes %>
        <div class="ag-card ag-card--cardgame">
          <div class="ag-card-visual ag-card-visual--cardgame">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="10" height="14" rx="2"/>
              <rect x="12" y="6" width="10" height="14" rx="2"/>
              <line x1="5" y1="9" x2="9" y2="9"/><line x1="5" y1="12" x2="9" y2="12"/>
            </svg>
          </div>
          <div class="ag-card-body">
            <div class="ag-card-head">
              <span class="ag-card-name">Jeu de Cartes</span>
              <span class="arcade-game-level-badge" id="arcade-cg-badge" hidden></span>
            </div>
            <p class="ag-card-desc">Affrontez un adversaire avec votre deck de cartes personnages.</p>
            <div class="ag-card-footer">
              <button class="ag-card-play" id="arcade-cg-play-btn">Jouer</button>
            </div>
          </div>
        </div>

      </div><%# /arcade-games-grid %>
    </div>

    <%# ── Memory : reprise de partie ── %>
    <div id="arcade-screen-memory-resume" class="arcade-screen arcade-screen--result" hidden>
      <button class="arcade-shop-corner-btn" id="resume-shop-btn" aria-label="Boutique" title="Boutique">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </button>
      <div class="arcade-resume-level-display">
        <span class="arcade-resume-level-num" id="resume-level">1</span>
        <span class="arcade-resume-level-label">niveau</span>
      </div>
      <span id="resume-mode-label" class="arcade-resume-mode"></span>
      <div class="arcade-result-footer" style="margin-top:1rem">
        <button class="arcade-btn arcade-btn--danger" id="arcade-resume-restart">Nouvelle partie</button>
        <button class="arcade-btn arcade-btn--success" id="arcade-resume-continue">Reprendre</button>
      </div>
      <p class="arcade-resume-warning">Nouvelle partie&nbsp;: votre progression actuelle sera perdue. Votre meilleur niveau et les r&eacute;compenses d&eacute;j&agrave; obtenues restent acquis.</p>
    </div>

    <%# ── Memory : configuration ── %>
    <div id="arcade-screen-memory-setup" class="arcade-screen" hidden>
      <p class="arcade-setup-title" id="arcade-setup-title">Choix de vos images</p>

      <div id="arcade-mode-btns" class="arcade-mode-btns">
        <button class="arcade-mode-btn" id="arcade-mode-random">
          <span class="arcade-mode-btn-label">Images al&eacute;atoires</span>
        </button>
        <button class="arcade-mode-btn" id="arcade-mode-tag">
          <span class="arcade-mode-btn-label">Choisir votre th&egrave;me</span>
        </button>
      </div>
      <div style="text-align:center;margin-top:.75rem">
        <button class="shop-open-btn" id="setup-shop-btn">&#127873; Boutique</button>
      </div>

      <div id="arcade-tag-picker" class="arcade-tag-picker" hidden>
        <input type="text" id="arcade-tag-search" class="arcade-tag-search" placeholder="Rechercher&hellip;" autocomplete="off">
        <div id="arcade-tag-list" class="arcade-tag-list">
          <p style="color:#64748b;font-size:.82rem;text-align:center;margin:.5rem 0">Chargement&hellip;</p>
        </div>
      </div>
    </div>

    <%# ── Memory : jeu ── %>
    <div id="arcade-screen-memory-game" class="arcade-screen arcade-screen--game" hidden>
      <div class="arcade-memory-hud">
        <div class="arcade-hud-item">
          <span class="arcade-hud-label">Niveau</span>
          <span class="arcade-hud-value" id="mem-level">1</span>
        </div>
        <div class="arcade-hud-item arcade-hud-item--timer">
          <span class="arcade-hud-label">Temps</span>
          <span class="arcade-hud-value" id="mem-timer">1:40</span>
        </div>
        <div class="arcade-hud-item arcade-hud-powerups">
          <button class="mem-power-btn" id="mem-boost-btn" title="Geler le timer 30 secondes">&#10052; 30s &bull; 5&#129689;</button>
          <button class="mem-power-btn" id="mem-reveal-btn" title="R&eacute;v&eacute;ler une paire">&#128269; &bull; 5&#129689;</button>
        </div>
        <div class="arcade-hud-item">
          <button class="mem-pause-btn" id="mem-pause-btn" aria-label="Pause">&#9646;&#9646;</button>
        </div>
      </div>
      <div class="arcade-memory-grid" id="arcade-memory-grid"></div>
    </div>

    <%# ── Memory : pause ── %>
    <div id="arcade-screen-memory-pause" class="arcade-screen arcade-screen--result" hidden>
      <h3 class="arcade-result-title">Pause</h3>
      <div class="arcade-pause-actions">
        <button class="arcade-btn arcade-btn--success" id="mem-pause-resume-btn">Reprendre</button>
        <button class="arcade-btn arcade-btn--ghost" id="mem-pause-shop-btn">&#127873; Boutique</button>
        <button class="arcade-btn arcade-btn--danger" id="mem-pause-quit-btn">Quitter</button>
      </div>
    </div>

    <%# ── Memory : boutique ── %>
    <div id="arcade-screen-memory-shop" class="arcade-screen" hidden>
      <div class="shop-header">
        <p class="arcade-setup-title" style="margin:0">Boutique</p>
        <span class="shop-coins-display">&#129689; <strong id="shop-coins">0</strong></span>
      </div>
      <div class="shop-preview-wrap">
        <div class="shop-preview-card" id="shop-preview-card">
          <span class="mem-card-back-icon" id="shop-preview-icon">&#9605;</span>
        </div>
        <p class="shop-preview-label">Aper&ccedil;u</p>
      </div>
      <div class="shop-section">
        <p class="shop-section-label">Ic&ocirc;ne du dos des cartes</p>
        <div class="shop-icon-grid" id="shop-icon-grid"></div>
      </div>
      <div class="shop-section">
        <p class="shop-section-label">Couleur des cartes</p>
        <div class="shop-color-grid" id="shop-color-grid"></div>
      </div>
    </div>

    <%# ── Memory : victoire ── %>
    <div id="arcade-screen-memory-win" class="arcade-screen arcade-screen--result" hidden>
      <h3 class="arcade-result-title arcade-result-title--victory">Victoire&nbsp;!</h3>
      <p class="arcade-result-subtitle">Niveau <span id="win-level">1</span> termin&eacute;</p>
      <div id="win-lootbox" class="arcade-lootbox-reward" hidden>&#127873; <strong>+1&nbsp;lootbox</strong> d&eacute;bloqu&eacute;e&nbsp;!</div>
      <div class="arcade-result-footer">
        <button class="arcade-btn arcade-btn--secondary" id="win-change-mode-btn">&#9881; Mode</button>
        <button class="arcade-btn arcade-btn--primary" id="win-next-btn">Niveau suivant</button>
      </div>
    </div>

    <%# ── Memory : défaite ── %>
    <div id="arcade-screen-memory-lose" class="arcade-screen arcade-screen--result" hidden>
      <div class="arcade-result-icon">&#9201;</div>
      <h3 class="arcade-result-title">Temps &eacute;coul&eacute;&nbsp;!</h3>
      <div class="arcade-result-subtitle">Niveau <span id="lose-level">1</span></div>
      <div class="arcade-result-score">Score&nbsp;: <strong id="lose-score">0</strong></div>
      <div class="arcade-result-footer">
        <button class="arcade-btn arcade-btn--ghost" id="lose-quit-btn">Quitter</button>
        <button class="arcade-btn arcade-btn--primary" id="lose-retry-btn">Rejouer ce niveau</button>
      </div>
    </div>

    <%# ── Mot du Codex (Wordle) ── %>
    <div id="arcade-screen-wordle" class="arcade-screen" hidden>
      <p class="wordle-date" id="wordle-date"></p>
      <div class="wordle-grid-wrap">
        <div class="wordle-grid" id="wordle-grid"></div>
      </div>
      <div class="wordle-message" id="wordle-message"></div>
      <div class="wordle-result" id="wordle-result" hidden></div>
    </div>

    <%# ── Jeu de Cartes — Sélection personnage ── %>
    <div id="arcade-screen-cg-pick" class="arcade-screen" hidden>
      <div class="cg-pick-wrap">
        <p class="cg-pick-title">Choisissez votre personnage</p>
        <p class="cg-pick-sub" id="cg-pick-sub">Chargement&hellip;</p>
        <div class="cg-pick-grid" id="cg-pick-grid"></div>
        <div class="cg-pick-footer">
          <button class="cg-btn cg-btn--primary" id="cg-start-btn" disabled>Commencer la partie</button>
        </div>
      </div>
    </div>

    <%# ── Jeu de Cartes — Plateau ── %>
    <div id="arcade-screen-cg-board" class="arcade-screen" hidden>
      <div class="cg-board">

        <%# Zone IA (haut) %>
        <div class="cg-zone cg-zone--ai">
          <div class="cg-player-header">
            <div class="cg-personnage-thumb-wrap">
              <img id="cg-ai-thumb" src="" alt="" class="cg-personnage-thumb" style="display:none">
              <span id="cg-ai-thumb-ph" class="cg-personnage-thumb-ph">&#128100;</span>
            </div>
            <div class="cg-player-info">
              <span class="cg-player-name" id="cg-ai-name">Adversaire</span>
              <div class="cg-extase-bar-wrap">
                <div class="cg-extase-bar"><div class="cg-extase-fill cg-extase-fill--ai" id="cg-ai-extase-fill" style="width:0%"></div></div>
                <span class="cg-extase-val" id="cg-ai-extase-val">0 / 100</span>
              </div>
            </div>
            <div class="cg-energy-display cg-energy-display--ai" id="cg-ai-energy">
              <span class="cg-energy-label">Énergie</span>
              <span class="cg-energy-val" id="cg-ai-energy-val">3</span>
            </div>
          </div>
          <div class="cg-terrain-row">
