<%# ── Modal Arcade ── %>
<div class="arcade-overlay" id="arcade-modal" hidden aria-modal="true" role="dialog">
  <div class="arcade-modal">
    <div class="arcade-modal-header">
      <h2 class="arcade-modal-title">&#127918; Arcade</h2>
      <button class="arcade-close-btn" id="arcade-close-btn" aria-label="Fermer">&#10005;</button>
    </div>

    <%# ── Liste des jeux ── %>
    <div id="arcade-screen-games" class="arcade-screen">
      <div class="arcade-games-list">
        <div class="arcade-game-card">
          <span class="arcade-game-card-icon">&#127183;</span>
          <div class="arcade-game-card-info">
            <strong>Memory</strong>
            <span>Retrouvez les paires &bull; Toutes les 5&nbsp;niveaux &rarr; &#127873; lootbox</span>
          </div>
          <button class="arcade-game-play-btn" id="arcade-memory-play-btn">Jouer</button>
        </div>
      </div>
    </div>

    <%# ── Memory : configuration ── %>
    <div id="arcade-screen-memory-setup" class="arcade-screen" hidden>
      <p class="arcade-section-title">Memory &mdash; Configuration</p>

      <div class="arcade-setup-row">
        <label class="arcade-radio-label">
          <input type="radio" name="memory-mode" value="random" checked>
          <span>
            Images al&eacute;atoires
            <small>Selon vos filtres de contenu</small>
          </span>
        </label>
        <label class="arcade-radio-label">
          <input type="radio" name="memory-mode" value="tag">
          <span>
            Choisir un th&egrave;me
            <small>Toutes les images du th&egrave;me choisi</small>
          </span>
        </label>
      </div>

      <div id="arcade-tag-picker" class="arcade-tag-picker" hidden>
        <input type="text" id="arcade-tag-search" class="arcade-tag-search" placeholder="Rechercher un th&egrave;me&hellip;" autocomplete="off">
        <div id="arcade-tag-list" class="arcade-tag-list">
          <p style="color:#64748b;font-size:.82rem;text-align:center;margin:.5rem 0">Chargement&hellip;</p>
        </div>
      </div>

      <div class="arcade-setup-footer">
        <button class="arcade-btn arcade-btn--ghost" id="arcade-memory-setup-back">&larr; Retour</button>
        <button class="arcade-btn arcade-btn--primary" id="arcade-memory-start-btn">Commencer</button>
      </div>
    </div>

    <%# ── Memory : jeu ── %>
    <div id="arcade-screen-memory-game" class="arcade-screen arcade-screen--game" hidden>
      <div class="arcade-memory-hud">
        <div class="arcade-hud-item">
          <span class="arcade-hud-label">Niveau</span>
          <span class="arcade-hud-value" id="mem-level">1</span>
        </div>
        <div class="arcade-hud-item arcade-hud-item--timer">
          <span class="arcade-hud-label">Temps</span>
          <span class="arcade-hud-value" id="mem-timer">1:40</span>
        </div>
        <div class="arcade-hud-item">
          <span class="arcade-hud-label">Score</span>
          <span class="arcade-hud-value" id="mem-score">0</span>
        </div>
      </div>
      <div class="arcade-memory-grid" id="arcade-memory-grid"></div>
    </div>

    <%# ── Memory : victoire ── %>
    <div id="arcade-screen-memory-win" class="arcade-screen arcade-screen--result" hidden>
      <div class="arcade-result-icon">&#9989;</div>
      <h3 class="arcade-result-title">Niveau <span id="win-level">1</span> complet&eacute;&nbsp;!</h3>
      <div class="arcade-result-score">Score&nbsp;: <strong id="win-score">0</strong></div>
      <div id="win-lootbox" class="arcade-lootbox-reward" hidden>&#127873; <strong>+1&nbsp;lootbox</strong> d&eacute;bloqu&eacute;e&nbsp;!</div>
      <div class="arcade-result-footer">
        <button class="arcade-btn arcade-btn--ghost" id="win-quit-btn">Quitter</button>
        <button class="arcade-btn arcade-btn--primary" id="win-next-btn">Niveau suivant &rarr;</button>
      </div>
    </div>

    <%# ── Memory : défaite ── %>
    <div id="arcade-screen-memory-lose" class="arcade-screen arcade-screen--result" hidden>
      <div class="arcade-result-icon">&#9201;</div>
      <h3 class="arcade-result-title">Temps &eacute;coul&eacute;&nbsp;!</h3>
      <div class="arcade-result-subtitle">Niveau <span id="lose-level">1</span></div>
      <div class="arcade-result-score">Score&nbsp;: <strong id="lose-score">0</strong></div>
      <div class="arcade-result-footer">
        <button class="arcade-btn arcade-btn--ghost" id="lose-quit-btn">Quitter</button>
        <button class="arcade-btn arcade-btn--primary" id="lose-retry-btn">Recommencer</button>
      </div>
    </div>

  </div>
</div>

<%# ── Popup info + paramètres lootbox ── %>
<div class="jeu-info-popover" id="jeu-info-popover" hidden aria-modal="true" role="dialog" aria-labelledby="jeu-info-title">
  <div class="jeu-info-inner">
    <div class="jeu-info-header">
      <p class="jeu-info-title" id="jeu-info-title">R&eacute;compenses des lootboxes</p>
      <button class="jeu-info-close" id="jeu-info-close" aria-label="Fermer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div>
      <p class="jeu-info-section-title">Niveaux de raret&eacute;</p>
      <ul class="jeu-info-rarity-list">
