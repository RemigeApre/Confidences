<script>
(function () {
  var ultraChk      = document.getElementById('jeu-settings-ultra');
  var irrealisteChk = document.getElementById('jeu-settings-irrealiste');

  function saveSettings() {
    fetch('/lootbox/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        allowUltra:      ultraChk      ? ultraChk.checked      : false,
        allowIrrealiste: irrealisteChk ? irrealisteChk.checked : true,
      }),
    });
  }

  ultraChk      && ultraChk.addEventListener('change',      saveSettings);
  irrealisteChk && irrealisteChk.addEventListener('change', saveSettings);

  var infoBtn   = document.getElementById('jeu-info-btn');
  var infoPop   = document.getElementById('jeu-info-popover');
  var infoClose = document.getElementById('jeu-info-close');
  function openInfo()  { infoPop.removeAttribute('hidden'); infoClose.focus(); }
  function closeInfo() { infoPop.setAttribute('hidden', ''); infoBtn.focus(); }
  infoBtn   && infoBtn.addEventListener('click', openInfo);
  infoClose && infoClose.addEventListener('click', closeInfo);
  infoPop   && infoPop.addEventListener('click', function(e) {
    if (e.target === infoPop) closeInfo();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && infoPop && !infoPop.hidden) closeInfo();
  });
})();
</script>

<script>
/* ═══════════════════════════════════════════════════════════════════════════
   ARCADE — Memory
   ═══════════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var SAVE_KEY = 'arcade_memory_save';

  // ── DOM ─────────────────────────────────────────────────────────────────────
  var arcadeBtn        = document.getElementById('jeu-arcade-btn');
  var arcadeOverlay    = document.getElementById('arcade-modal');
  var jeuHomeView      = document.getElementById('jeu-home-view');
  var screenGames      = document.getElementById('arcade-screen-games');
  var screenResume     = document.getElementById('arcade-screen-memory-resume');
  var screenSetup      = document.getElementById('arcade-screen-memory-setup');
  var screenGame       = document.getElementById('arcade-screen-memory-game');
  var screenWin        = document.getElementById('arcade-screen-memory-win');
  var screenLose       = document.getElementById('arcade-screen-memory-lose');
  var memPlayBtn       = document.getElementById('arcade-memory-play-btn');
  var modeRandomBtn    = document.getElementById('arcade-mode-random');
  var modeTagBtn       = document.getElementById('arcade-mode-tag');
  var modeBtnsEl       = document.getElementById('arcade-mode-btns');
  var setupTitleEl     = document.getElementById('arcade-setup-title');
  var tagPickerEl      = document.getElementById('arcade-tag-picker');
  var tagSearchEl      = document.getElementById('arcade-tag-search');
  var tagListEl        = document.getElementById('arcade-tag-list');
  var screenPause      = document.getElementById('arcade-screen-memory-pause');
  var screenShop       = document.getElementById('arcade-screen-memory-shop');
  var memPauseBtn      = document.getElementById('mem-pause-btn');
  var memBoostBtn      = document.getElementById('mem-boost-btn');
  var memRevealBtn     = document.getElementById('mem-reveal-btn');
  var pauseResumeBtn   = document.getElementById('mem-pause-resume-btn');
  var pauseShopBtn     = document.getElementById('mem-pause-shop-btn');
  var pauseQuitBtn     = document.getElementById('mem-pause-quit-btn');
  var setupShopBtn     = document.getElementById('setup-shop-btn');
  var resumeShopBtn    = document.getElementById('resume-shop-btn');
  var shopCoinsEl      = document.getElementById('shop-coins');
  var shopIconGrid     = document.getElementById('shop-icon-grid');
  var shopColorGrid    = document.getElementById('shop-color-grid');
  var memLevelEl       = document.getElementById('mem-level');
  var memTimerEl       = document.getElementById('mem-timer');
  var memScoreEl       = document.getElementById('mem-score');
  var memGrid          = document.getElementById('arcade-memory-grid');
  var winLevelEl       = document.getElementById('win-level');
  var winLootboxEl     = document.getElementById('win-lootbox');
  var winNextBtn       = document.getElementById('win-next-btn');
  var winChangeModeBtn = document.getElementById('win-change-mode-btn');
  var loseLevelEl      = document.getElementById('lose-level');
  var loseScoreEl      = document.getElementById('lose-score');
  var loseRetryBtn     = document.getElementById('lose-retry-btn');
  var loseQuitBtn      = document.getElementById('lose-quit-btn');
  var resumeLevelEl    = document.getElementById('resume-level');
  var resumeScoreEl    = document.getElementById('resume-score');
  var resumeModeEl     = document.getElementById('resume-mode-label');
  var resumeRestartBtn = document.getElementById('arcade-resume-restart');
  var resumeContinueBtn= document.getElementById('arcade-resume-continue');

  if (!arcadeOverlay) return;

  // ── State ────────────────────────────────────────────────────────────────────
  var _level       = 1;
  var _totalScore  = 0;
  var _score       = 0;
  var _pairs       = 4;
  var _matched     = 0;
  var _flipped     = [];
  var _cards       = [];
  var _locked      = false;
  var _timer       = null;
  var _timeLeft    = 0;
  var _mode        = 'random';
  var _selectedTag = null;
  var _allTags     = [];
  var _tagSearchTimeout = null;
  var _midGame     = false; // true when changing mode between levels
  var _inProgress  = false; // true as soon as a level has been started
  var _savedLevel  = 1;    // niveau à sauvegarder (= _level+1 après victoire)
  var _freezeTicks = 0;    // ticks restants de gel du timer
  var _shopCoins   = 0;    // local coin cache (synced from server)
  var _shopReturn  = null; // screen to return to after closing shop
  var _cardIcon    = '\u2605'; // current card back icon (symbol)
  var _cardColor   = 'default'; // current card back color key

  // Color definitions (client-side display)
  var MEMORY_COLORS = [
    { key: 'default', label: 'Nuit',      bg: '#1e293b', border: '#334155', price: 0 },
    { key: 'purple',  label: 'Violet',    bg: '#2d1654', border: '#6d28d9', price: 1 },
    { key: 'red',     label: 'Rubis',     bg: '#4c1111', border: '#991b1b', price: 1 },
    { key: 'forest',  label: 'For\u00eat', bg: '#0f3320', border: '#166534', price: 1 },
    { key: 'navy',    label: 'Marine',    bg: '#0f2447', border: '#1e40af', price: 1 },
    { key: 'slate',   label: 'Ardoise',   bg: '#1f2937', border: '#4b5563', price: 1 },
    { key: 'gold',    label: 'Or',        bg: '#2d1d00', border: '#b45309', price: 10 },
    { key: 'darkred', label: 'Cramoisi',  bg: '#2d0000', border: '#7f1d1d', price: 10 },
  ];

  // ── Helpers ──────────────────────────────────────────────────────────────────
  var _SCREENS = [screenGames, screenResume, screenSetup, screenGame, screenWin, screenLose,
    screenPause, screenShop, document.getElementById('arcade-screen-wordle')];
  var _arcadeHdrBack = document.getElementById('arcade-hdr-back-btn');
  function updateLevelBadge() {
    var badge = document.getElementById('arcade-memory-level-badge');
    if (!badge) return;
    var saved = loadSave();
    if (saved && saved.level > 1) {
      badge.textContent = 'Niveau\u00a0' + saved.level;
      badge.hidden = false;
    } else {
      badge.hidden = true;
    }
  }

  function showScreen(el) {
    if (el === screenGames) { saveProgress(); updateLevelBadge(); }
    _SCREENS.forEach(function(s) { if (s) s.hidden = true; });
    if (el) el.hidden = false;
    if (_arcadeHdrBack) _arcadeHdrBack.hidden = false; // toujours visible en mode in-page
  }
  _arcadeHdrBack && _arcadeHdrBack.addEventListener('click', function() {
    if (screenShop && !screenShop.hidden && _shopReturn) {
      var ret = _shopReturn; _shopReturn = null;
      showScreen(ret);
    } else if (screenGames && !screenGames.hidden) {
      closeArcade(); // sur la liste des jeux → retour aux catégories
    } else {
      showScreen(screenGames);
    }
  });

  // ── Boutique ─────────────────────────────────────────────────────────────────
  function openShop(returnScreen) {
    _shopReturn = returnScreen;
    showScreen(screenShop);
    // Affichage immédiat avec les données locales (évite l'écran vide)
    if (shopCoinsEl) shopCoinsEl.textContent = _shopCoins;
    renderShopIcons([], null);
    renderShopColors(['default'], _cardColor);
    applyCardStyle(); // initialise l'aperçu
    // Mise à jour depuis le serveur
    fetch('/arcade/memory/shop')
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(d) {
        if (!d.ok) { console.warn('memory/shop: ok false'); return; }
        _shopCoins = d.coins;
        if (shopCoinsEl) shopCoinsEl.textContent = _shopCoins;
        if (d.selectedColor) _cardColor = d.selectedColor;
        renderShopIcons(d.charms || [], d.selectedCharmId);
        renderShopColors(d.ownedColors || ['default'], d.selectedColor || 'default');
      })
      .catch(function(err) { console.error('memory/shop fetch:', err); });
  }

  function renderShopIcons(charms, selectedId) {
    if (!shopIconGrid) return;
    shopIconGrid.innerHTML = '';
    // Default: star (no charm)
    var starBtn = document.createElement('button');
    starBtn.className = 'shop-icon-btn' + (!selectedId ? ' shop-icon-btn--active' : '');
    starBtn.textContent = '\u2605';
    starBtn.title = '\u00c9toile (par d\u00e9faut)';
    starBtn.addEventListener('click', function() {
      _cardIcon = '\u2605';
      fetch('/arcade/memory/shop/icon', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ charmId: null }) });
      shopIconGrid.querySelectorAll('.shop-icon-btn').forEach(function(b) { b.classList.remove('shop-icon-btn--active'); });
      starBtn.classList.add('shop-icon-btn--active');
      applyCardStyle();
    });
    shopIconGrid.appendChild(starBtn);

    if (!charms.length) {
      var msg = document.createElement('p');
      msg.className = 'shop-empty';
      msg.textContent = 'Aucun charme disponible.';
      shopIconGrid.appendChild(msg);
      return;
    }
    charms.forEach(function(c) {
      var btn = document.createElement('button');
      var isOwned = !!c.owned;
      btn.className = 'shop-icon-btn'
        + (isOwned ? '' : ' shop-icon-btn--locked')
        + (isOwned && selectedId === c.id ? ' shop-icon-btn--active' : '');
      btn.title = isOwned ? c.label : c.label + ' \u2014 non poss\u00e9d\u00e9';
      btn.disabled = !isOwned;

      var sym = document.createElement('span');
      sym.textContent = c.symbol;
      btn.appendChild(sym);
      if (!isOwned) {
        var lock = document.createElement('span');
        lock.className = 'shop-icon-lock';
        lock.textContent = '\uD83D\uDD12';
        btn.appendChild(lock);
      }

      if (isOwned) {
        btn.addEventListener('click', function() {
          _cardIcon = c.symbol;
          fetch('/arcade/memory/shop/icon', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ charmId: c.id }) });
          shopIconGrid.querySelectorAll('.shop-icon-btn').forEach(function(b) { b.classList.remove('shop-icon-btn--active'); });
          btn.classList.add('shop-icon-btn--active');
          applyCardStyle();
        });
      }
      shopIconGrid.appendChild(btn);
    });
  }

  function renderShopColors(ownedColors, selectedColor) {
    if (!shopColorGrid) return;
    shopColorGrid.innerHTML = '';
    MEMORY_COLORS.forEach(function(c) {
      var owned = ownedColors.indexOf(c.key) !== -1;
      var btn = document.createElement('button');
      btn.className = 'shop-color-swatch' + (selectedColor === c.key ? ' shop-color-swatch--active' : '');
      btn.style.background = c.bg;
      btn.style.borderColor = c.border;
      btn.title = c.label + (owned ? '' : ' \u2014 ' + c.price + '\uD83E\uDE99');
      var label = document.createElement('span');
      label.className = 'shop-color-label';
      label.textContent = c.label;
      btn.appendChild(label);
      if (!owned) {
        var price = document.createElement('span');
        price.className = 'shop-color-price';
        price.textContent = c.price + '\uD83E\uDE99';
        btn.appendChild(price);
      }
      btn.addEventListener('click', function() {
        fetch('/arcade/memory/shop/color', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ colorKey: c.key }) })
          .then(function(r) { return r.json(); })
          .then(function(d) {
            if (!d.ok) { if (d.error === 'not_enough_coins') showShopMsg('Pas assez de pièces !'); return; }
            _cardColor = c.key;
            _shopCoins = d.newCoins;
            if (shopCoinsEl) shopCoinsEl.textContent = _shopCoins;
            if (!owned) {
              owned = true;
              price && price.remove();
              ownedColors.push(c.key);
            }
            shopColorGrid.querySelectorAll('.shop-color-swatch').forEach(function(b) { b.classList.remove('shop-color-swatch--active'); });
            btn.classList.add('shop-color-swatch--active');
            applyCardStyle();
          });
      });
      shopColorGrid.appendChild(btn);
    });
  }

  function showShopMsg(msg) {
    var el = shopColorGrid && shopColorGrid.parentElement;
    if (!el) return;
    var m = document.createElement('p');
    m.style.cssText = 'color:#f87171;font-size:.78rem;text-align:center;margin:.3rem 0 0';
    m.textContent = msg;
    el.appendChild(m);
    setTimeout(function() { m.remove(); }, 2000);
  }

  function applyCardStyle() {
    if (memGrid) {
      memGrid.dataset.color = _cardColor;
      memGrid.querySelectorAll('.mem-card-back-icon').forEach(function(el) { el.textContent = _cardIcon; });
    }
    // Aperçu boutique
    var previewCard = document.getElementById('shop-preview-card');
    var previewIcon = document.getElementById('shop-preview-icon');
    if (previewIcon) previewIcon.textContent = _cardIcon;
    if (previewCard) {
      var colorDef = MEMORY_COLORS.filter(function(c) { return c.key === _cardColor; })[0];
      if (colorDef) {
        previewCard.style.background = colorDef.bg;
        previewCard.style.borderColor = colorDef.border;
      }
    }
  }

  setupShopBtn  && setupShopBtn.addEventListener('click', function() { openShop(screenSetup); });
  resumeShopBtn && resumeShopBtn.addEventListener('click', function() { openShop(screenResume); });
  pauseShopBtn  && pauseShopBtn.addEventListener('click', function() { openShop(screenPause); });

  // ── Pause ─────────────────────────────────────────────────────────────────────
  memPauseBtn && memPauseBtn.addEventListener('click', function() {
    clearInterval(_timer);
    showScreen(screenPause);
  });
  pauseResumeBtn && pauseResumeBtn.addEventListener('click', function() {
    showScreen(screenGame);
    startTimer();
  });
  pauseQuitBtn && pauseQuitBtn.addEventListener('click', function() {
    clearInterval(_timer);
    showScreen(screenGames); // saveProgress() appelé dans showScreen
  });

  // ── Time boost ────────────────────────────────────────────────────────────────
  memBoostBtn && memBoostBtn.addEventListener('click', function() {
    if (_shopCoins < 5 || _freezeTicks > 0) return;
    fetch('/arcade/memory/time-boost', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.ok) return;
        _freezeTicks = 30;
        _shopCoins = d.newCoins;
      });
  });

  memRevealBtn && memRevealBtn.addEventListener('click', function() {
    if (_shopCoins < 5 || _locked) return;
    fetch('/arcade/memory/reveal', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.ok) return;
        _shopCoins = d.newCoins;
        // Trouver une paire non retournée/trouvée
        var byPair = {};
        _cards.forEach(function(c, i) {
          if (!c.matched && !c.flipped) {
            if (!byPair[c.pairId]) byPair[c.pairId] = [];
            byPair[c.pairId].push(i);
          }
        });
        var fullPairs = Object.keys(byPair).filter(function(k) { return byPair[k].length === 2; });
        if (!fullPairs.length) return;
        var pick = byPair[fullPairs[Math.floor(Math.random() * fullPairs.length)]];
        _locked = true;
        pick.forEach(function(idx) { _cards[idx].el.classList.add('flipped'); });
        setTimeout(function() {
          pick.forEach(function(idx) { _cards[idx].el.classList.remove('flipped'); });
          _locked = false;
        }, 1800);
      });
  });

  // ── Info tooltips ─────────────────────────────────────────────────────────────
  function initInfoTooltip(btnId, tooltipId) {
    var btn = document.getElementById(btnId);
    var tip = document.getElementById(tooltipId);
    if (!btn || !tip) return;
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = !tip.hidden;
      document.querySelectorAll('.arcade-info-tooltip').forEach(function(t) { t.hidden = true; });
      tip.hidden = isOpen;
    });
  }
  initInfoTooltip('arcade-memory-info-btn', 'arcade-memory-info-tooltip');
  initInfoTooltip('arcade-wordle-info-btn', 'arcade-wordle-info-tooltip');
  document.addEventListener('click', function() {
    document.querySelectorAll('.arcade-info-tooltip').forEach(function(t) { t.hidden = true; });
  });

  function pairsForLevel(lvl) {
    if (lvl <= 2) return 4;
    if (lvl <= 4) return 6;
    if (lvl <= 6) return 8;
    return 10;
  }

  function timeForPairs(p) { return 60 + p * 12; }

  function formatTime(s) {
    var m = Math.floor(s / 60), ss = s % 60;
    return m + ':' + (ss < 10 ? '0' : '') + ss;
  }



  // ── Save / restore progress ───────────────────────────────────────────────────
  // Utilise _inProgress plutôt que l'état des écrans : la navigation entre écrans
  // (ex. bouton ←) cache les écrans avant que closeArcade() appelle saveProgress(),
  // ce qui causait des sauvegardes manquées.
  function saveProgress() {
    if (!_inProgress) return;
    try {
      localStorage.setItem(SAVE_KEY, JSON.stringify({
        level: _savedLevel, totalScore: _totalScore,
        mode: _mode, tag: _selectedTag || null,
      }));
    } catch (_e) {}
  }

  // Sauvegarde aussi quand la page se ferme / rafraîchit
  window.addEventListener('beforeunload', saveProgress);

  function clearProgress() {
    _inProgress = false;
    try { localStorage.removeItem(SAVE_KEY); } catch (_) {}
  }

  function loadSave() {
    try { return JSON.parse(localStorage.getItem(SAVE_KEY) || 'null'); } catch (_) { return null; }
  }

  // ── Modal open/close ─────────────────────────────────────────────────────────
  function openArcade() {
    if (jeuHomeView) jeuHomeView.hidden = true;
    arcadeOverlay.hidden = false;
    showScreen(screenGames);
    // Pre-load card style preferences
    fetch('/arcade/memory/shop')
      .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function(d) {
        if (!d.ok) { console.warn('openArcade shop preload: ok false'); return; }
        _shopCoins = d.coins;
        _cardColor = d.selectedColor || 'default';
        if (d.selectedCharmId && d.charms) {
          var found = (d.charms || []).filter(function(c) { return c.id === d.selectedCharmId; })[0];
          if (found) _cardIcon = found.symbol;
        }
      }).catch(function(e) { console.error('openArcade shop preload:', e); });
  }

  function closeArcade() {
    saveProgress();
    clearInterval(_timer);
    arcadeOverlay.hidden = true;
    if (jeuHomeView) jeuHomeView.hidden = false;
  }

  arcadeBtn && arcadeBtn.addEventListener('click', openArcade);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && arcadeOverlay && !arcadeOverlay.hidden) closeArcade();
  });

  // ── Memory: play button → resume or setup ─────────────────────────────────────
  memPlayBtn && memPlayBtn.addEventListener('click', function() {
    var saved = loadSave();
    if (saved && (saved.level > 1 || (saved.totalScore || 0) > 0)) {
      if (resumeLevelEl) resumeLevelEl.textContent = saved.level;
      if (resumeScoreEl) resumeScoreEl.textContent = saved.totalScore || 0;
      if (resumeModeEl) resumeModeEl.textContent = saved.mode === 'tag' && saved.tag
        ? 'Th\u00e8me\u00a0: ' + saved.tag
        : 'Images al\u00e9atoires';
      showScreen(screenResume);
      loadTags();
    } else {
      startFreshSetup();
    }
  });

  resumeRestartBtn && resumeRestartBtn.addEventListener('click', function() {
    clearProgress();
    startFreshSetup();
  });

  resumeContinueBtn && resumeContinueBtn.addEventListener('click', function() {
    var saved = loadSave();
    if (!saved) { startFreshSetup(); return; }
    _level      = saved.level || 1;
    _totalScore = saved.totalScore || 0;
    _mode       = saved.mode || 'random';
    _selectedTag= saved.tag || null;
    clearProgress();
    startLevel(_level);
  });

  function startFreshSetup() {
    _level = 1; _totalScore = 0; _midGame = false;
    _mode = 'random'; _selectedTag = null;
    if (tagPickerEl) tagPickerEl.hidden = true;
    if (modeBtnsEl) modeBtnsEl.hidden = false;
    if (setupTitleEl) setupTitleEl.textContent = 'Choix de vos images';
    showScreen(screenSetup);
    loadTags();
  }

  function loadTags() {
    fetch('/arcade/tags?min=8')
      .then(function(r) { return r.json(); })
      .then(function(d) { _allTags = d.tags || []; renderTagList(''); })
      .catch(function() {});
  }

  // ── Mode selection ────────────────────────────────────────────────────────────
  modeRandomBtn && modeRandomBtn.addEventListener('click', function() {
    _mode = 'random'; _selectedTag = null;
    var nextLvl = _midGame ? _level + 1 : _level;
    _midGame = false;
    startLevel(nextLvl);
  });

  modeTagBtn && modeTagBtn.addEventListener('click', function() {
    _mode = 'tag'; _selectedTag = null;
    if (tagPickerEl) tagPickerEl.hidden = false;
    if (modeBtnsEl) modeBtnsEl.hidden = true;
    if (tagSearchEl) tagSearchEl.value = '';
    renderTagList('');
  });

  tagSearchEl && tagSearchEl.addEventListener('input', function() {
    clearTimeout(_tagSearchTimeout);
    var q = tagSearchEl.value.toLowerCase().trim();
    _tagSearchTimeout = setTimeout(function() { renderTagList(q); }, 200);
  });

  function renderTagList(filter) {
    if (!tagListEl) return;
    tagListEl.innerHTML = '';
    var list = _allTags.filter(function(t) {
      return !filter || t.tag.toLowerCase().includes(filter);
    }).slice(0, 40);
    if (!list.length) {
      tagListEl.innerHTML = '<p style="color:#64748b;font-size:.8rem;text-align:center;margin:.5rem 0">Aucun th\u00e8me disponible</p>';
      return;
    }
    list.forEach(function(t) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'arcade-tag-btn';
      btn.textContent = t.tag + ' (' + t.count + ')';
      btn.dataset.tag = t.tag;
      btn.addEventListener('click', function() {
        _selectedTag = t.tag;
        var nextLvl = _midGame ? _level + 1 : _level;
        _midGame = false;
        startLevel(nextLvl);
      });
      tagListEl.appendChild(btn);
    });
  }

  // ── Win screen: change mode between levels ────────────────────────────────────
  winChangeModeBtn && winChangeModeBtn.addEventListener('click', function() {
    _midGame = true;
    if (setupTitleEl) setupTitleEl.textContent = 'Changer de mode';
    if (tagPickerEl) tagPickerEl.hidden = true;
    if (modeBtnsEl) modeBtnsEl.hidden = false;
    showScreen(screenSetup);
  });

  // ── Level start ───────────────────────────────────────────────────────────────
  function startLevel(lvl) {
    _inProgress = true;
    _level = lvl;
    _savedLevel = lvl; // niveau de reprise = niveau en cours
    _score = 0;
    _matched = 0;
    _flipped = [];
    _locked = false;
    _pairs = pairsForLevel(lvl);
    _timeLeft = timeForPairs(_pairs);
    clearInterval(_timer);

    if (memLevelEl) memLevelEl.textContent = lvl;
    if (memScoreEl) memScoreEl.textContent = _totalScore;
    if (memTimerEl) { memTimerEl.textContent = formatTime(_timeLeft); memTimerEl.style.color = ''; }
    if (memGrid) {
      memGrid.innerHTML = '';
      var ph = document.createElement('div');
      ph.style.cssText = 'grid-column:1/-1;color:#64748b;text-align:center;padding:2rem;font-size:.9rem';
      ph.textContent = 'Chargement\u2026';
      memGrid.appendChild(ph);
    }
    showScreen(screenGame);

    var url = '/arcade/memory-images?count=' + _pairs;
    if (_mode === 'tag' && _selectedTag) url += '&tag=' + encodeURIComponent(_selectedTag);

    fetch(url)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var imgs = (d.images || []).slice(0, _pairs);
        if (imgs.length < 4) {
          alert('Pas assez d\'images disponibles pour ce th\u00e8me.');
          showScreen(screenGames); return;
        }
        if (imgs.length < _pairs) {
          _pairs = imgs.length;
          _timeLeft = timeForPairs(_pairs);
          if (_mode === 'tag') { _mode = 'random'; _selectedTag = null; }
        }
        buildCardGrid(imgs);
        startTimer();
      })
      .catch(function() {
        alert('Erreur lors du chargement des images.');
        showScreen(screenGames);
      });
  }

  // ── Card grid ─────────────────────────────────────────────────────────────────
  function buildCardGrid(images) {
    if (!memGrid) return;
    memGrid.innerHTML = '';

    var cardData = [];
    images.forEach(function(img, i) {
      cardData.push({ img: img, pairId: i });
      cardData.push({ img: img, pairId: i });
    });
    for (var i = cardData.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = cardData[i]; cardData[i] = cardData[j]; cardData[j] = tmp;
    }

    var cols = _pairs <= 4 ? 4 : (_pairs <= 6 ? 4 : (_pairs <= 8 ? 4 : 5));
    var rows = Math.ceil(cardData.length / cols);
    // Calcule la taille max qui tient en largeur ET en hauteur
    var hudEl = screenGame ? screenGame.querySelector('.arcade-memory-hud') : null;
    var gapPx  = 7;  // ~0.45rem
    var padPx  = 12; // ~0.75rem
    var availW = (screenGame ? screenGame.clientWidth  : window.innerWidth)  - padPx * 2 - gapPx * (cols - 1);
    var availH = (screenGame ? screenGame.clientHeight : window.innerHeight) - (hudEl ? hudEl.offsetHeight : 52) - padPx * 2 - gapPx * 2 - gapPx * (rows - 1);
    var sz = Math.max(Math.floor(Math.min(availW / cols, availH / rows)), 44);
    memGrid.style.gridTemplateColumns = 'repeat(' + cols + ', ' + sz + 'px)';
    memGrid.style.gridAutoRows = sz + 'px';

    _cards = [];
    cardData.forEach(function(data, idx) {
      var card = document.createElement('div');
      card.className = 'mem-card';

      var inner = document.createElement('div');
      inner.className = 'mem-card-inner';

      var back = document.createElement('div');
      back.className = 'mem-card-back';
      var backIcon = document.createElement('span');
      backIcon.className = 'mem-card-back-icon';
      backIcon.textContent = _cardIcon;
      back.appendChild(backIcon);

      var front = document.createElement('div');
      front.className = 'mem-card-front';
      var img = document.createElement('img');
      img.src = data.img.thumb;
      img.alt = data.img.title || '';
      img.loading = 'eager';
      front.appendChild(img);

      inner.appendChild(back);
      inner.appendChild(front);
      card.appendChild(inner);

      var capturedIdx = idx;
      card.addEventListener('click', function() { onCardClick(capturedIdx); });
      memGrid.appendChild(card);
      _cards.push({ el: card, pairId: data.pairId, matched: false, flipped: false });
    });
    memGrid.dataset.color = _cardColor;
  }

  // ── Card logic ────────────────────────────────────────────────────────────────
  function onCardClick(idx) {
    var c = _cards[idx];
    if (_locked || !c || c.matched || c.flipped) return;
    c.flipped = true;
    c.el.classList.add('flipped');
    _flipped.push(idx);

    if (_flipped.length < 2) return;

    _locked = true;
    var a = _cards[_flipped[0]], b = _cards[_flipped[1]];

    if (a.pairId === b.pairId) {
      setTimeout(function() {
        a.matched = true; b.matched = true;
        a.el.classList.add('matched'); b.el.classList.add('matched');
        _matched++;
        var pts = 100 * _level;
        _score += pts; _totalScore += pts;
        if (memScoreEl) memScoreEl.textContent = _totalScore;
        _flipped = [];
        _locked = false;
        if (_matched >= _pairs) onLevelComplete();
      }, 350);
    } else {
      var penalty = Math.min(10, _totalScore);
      _totalScore = Math.max(0, _totalScore - penalty);
      if (memScoreEl) memScoreEl.textContent = _totalScore;
      setTimeout(function() {
        a.flipped = false; b.flipped = false;
        a.el.classList.remove('flipped'); b.el.classList.remove('flipped');
        _flipped = [];
        _locked = false;
      }, 850);
    }
  }

  // ── Timer ─────────────────────────────────────────────────────────────────────
  function startTimer() {
    clearInterval(_timer);
    _timer = setInterval(function() {
      if (_freezeTicks > 0) {
        _freezeTicks--;
        if (memTimerEl) {
          memTimerEl.textContent = '\u2744 ' + formatTime(_timeLeft);
          memTimerEl.style.color = '#60a5fa';
        }
        return;
      }
      _timeLeft--;
      if (memTimerEl) {
        memTimerEl.textContent = formatTime(_timeLeft);
        memTimerEl.style.color = _timeLeft <= 15 ? '#f87171' : '';
      }
      if (_timeLeft <= 0) { clearInterval(_timer); onTimerOut(); }
    }, 1000);
  }

  // ── Level complete ────────────────────────────────────────────────────────────
  function onLevelComplete() {
    clearInterval(_timer);
    _totalScore += _timeLeft * 5;

    fetch('/arcade/memory-complete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ level: _level, won: true, score: _totalScore }),
    })
      .then(function(r) { return r.json(); })
      .then(function(d) { showWinScreen(d.lootboxGranted); })
      .catch(function() { showWinScreen(false); });
  }

  function showWinScreen(lootboxGranted) {
    if (winLevelEl) winLevelEl.textContent = _level;
    if (winLootboxEl) winLootboxEl.hidden = !lootboxGranted;
    if (lootboxGranted) {
      // Synchronise le compteur lootbox dans lootbox.js (fix : _count était stale)
      if (typeof window._lbRefreshCount === 'function') window._lbRefreshCount();
    }
    _savedLevel = _level + 1; // niveau suivant à reprendre
    saveProgress(); // sauvegarde immédiate après chaque niveau complété
    showScreen(screenWin);
  }

  winNextBtn && winNextBtn.addEventListener('click', function() {
    _level++;
    startLevel(_level);
  });

  // ── Timer out ─────────────────────────────────────────────────────────────────
  function onTimerOut() {
    fetch('/arcade/memory-complete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ level: _level, won: false, score: _totalScore }),
    }).catch(function() {});
    if (loseLevelEl) loseLevelEl.textContent = _level;
    if (loseScoreEl) loseScoreEl.textContent = _totalScore;
    saveProgress(); // sauvegarde le niveau en cours (perdu)
    showScreen(screenLose);
  }

  loseRetryBtn && loseRetryBtn.addEventListener('click', function() {
    startLevel(_level);
  });

  loseQuitBtn && loseQuitBtn.addEventListener('click', function() {
    showScreen(screenGames); // saveProgress() appelé dans showScreen
  });
})();
</script>

<script>
/* ═══════════════════════════════════════════════════════════════════════════
   MOT DU CODEX — Wordle
   ═══════════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var MAX_GUESSES = 6;
  var REWARDS_LABELS = ['5 coffres', '4 coffres', '3 coffres', '2 coffres', '1 coffre', ''];

  // DOM
  var arcadeOverlay   = document.getElementById('arcade-modal');
  var playBtn         = document.getElementById('arcade-wordle-play-btn');
  var backBtn         = document.getElementById('wordle-back-btn');
  var gridEl          = document.getElementById('wordle-grid');
  var msgEl           = document.getElementById('wordle-message');
  var kbEl            = document.getElementById('wordle-keyboard');
  var resultEl        = document.getElementById('wordle-result');
  var dateEl          = document.getElementById('wordle-date');
  var screenWordle    = document.getElementById('arcade-screen-wordle');

  if (!screenWordle) return;

  // State
  var _wordLength  = 5;
  var _currentRow  = 0;
  var _currentGuess= '';
  var _gameOver    = false;
  var _tiles       = [];     // 2D array [row][col]

  // ── Show screen (also manages header back button) ─────────────────────────
  var _allScreens  = document.querySelectorAll('#arcade-modal .arcade-screen');
  var _hdrBack     = document.getElementById('arcade-hdr-back-btn');
  var _screenGames = document.getElementById('arcade-screen-games');
  function showWordleScreen(el) {
    _allScreens.forEach(function(s) { s.hidden = true; });
    if (el) el.hidden = false;
    if (_hdrBack) _hdrBack.hidden = false; // toujours visible en mode in-page
  }

  // ── Open wordle ──────────────────────────────────────────────────────────
  playBtn && playBtn.addEventListener('click', function() { loadToday(); });

  // ── Load today's game ────────────────────────────────────────────────────
  function loadToday() {
    showWordleScreen(screenWordle);
    if (resultEl) { resultEl.hidden = true; resultEl.textContent = ''; }
    if (msgEl) { msgEl.textContent = 'Chargement\u2026'; msgEl.className = 'wordle-message'; }
    fetch('/arcade/wordle/today')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.ok) { if (msgEl) msgEl.textContent = 'Aucun mot disponible.'; return; }
        if (msgEl) msgEl.textContent = '';
        _wordLength   = d.wordLength;
        _currentRow   = d.guesses.length;
        _currentGuess = '';
        _gameOver     = d.gameOver;

        // Date display (centered)
        if (dateEl) dateEl.textContent = new Date().toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' });

        buildGrid();

        // Restore previous guesses
        d.guesses.forEach(function(g, row) {
          for (var col = 0; col < _wordLength; col++) {
            setTile(row, col, g.guess[col] || '', g.feedback[col] || 'absent', true);
          }
        });

        if (d.gameOver) {
          showResult(d.solved, d.word, d.sourceTitle, d.sourceId, 0, d.rewardGranted, d.currentStreak, d.bestStreak);
        } else {
          renderCurrentRow();
        }
      })
      .catch(function() { if (msgEl) msgEl.textContent = 'Erreur de chargement.'; });
  }

  // ── Build grid ───────────────────────────────────────────────────────────
  function buildGrid() {
    if (!gridEl) return;
    gridEl.innerHTML = '';
    gridEl.style.gridTemplateColumns = 'repeat(' + _wordLength + ', 1fr)';
    _tiles = [];
    for (var r = 0; r < MAX_GUESSES; r++) {
      _tiles[r] = [];
      for (var c = 0; c < _wordLength; c++) {
        var tile = document.createElement('div');
        tile.className = 'wordle-tile';
        gridEl.appendChild(tile);
        _tiles[r][c] = tile;
      }
    }
  }

  // ── Set tile ─────────────────────────────────────────────────────────────
  function setTile(row, col, letter, status, immediate) {
    var tile = _tiles[row] && _tiles[row][col];
    if (!tile) return;
    tile.textContent = letter.toUpperCase();
    tile.classList.remove('wordle-tile--cursor');
    if (status) {
      if (immediate) { tile.dataset.status = status; }
      else { setTimeout(function() { tile.dataset.status = status; }, col * 120); }
    } else {
      delete tile.dataset.status;
    }
  }

  // ── Current row rendering (with blinking cursor) ──────────────────────────
  function renderCurrentRow() {
    for (var c = 0; c < _wordLength; c++) {
      var tile = _tiles[_currentRow] && _tiles[_currentRow][c];
      if (!tile) continue;
      delete tile.dataset.status;
      if (c < _currentGuess.length) {
        tile.textContent = _currentGuess[c].toUpperCase();
        tile.classList.remove('wordle-tile--cursor');
        tile.classList.add('wordle-tile--filled');
      } else if (c === _currentGuess.length) {
        tile.textContent = '';
        tile.classList.remove('wordle-tile--filled');
        tile.classList.add('wordle-tile--cursor');
      } else {
        tile.textContent = '';
        tile.classList.remove('wordle-tile--filled', 'wordle-tile--cursor');
      }
    }
  }

  // ── Key handling ─────────────────────────────────────────────────────────
  document.addEventListener('keydown', function(e) {
    if (!arcadeOverlay || arcadeOverlay.hidden) return;
    if (!screenWordle || screenWordle.hidden) return;
    if (e.ctrlKey || e.altKey || e.metaKey) return;
    if (e.key === 'Enter') { submitGuess(); return; }
    if (e.key === 'Backspace') {
      if (_gameOver) return;
      if (_currentGuess.length > 0) { _currentGuess = _currentGuess.slice(0, -1); renderCurrentRow(); }
      return;
    }
    if (!_gameOver && /^[a-zA-Z]$/.test(e.key) && _currentGuess.length < _wordLength) {
      _currentGuess += e.key.toLowerCase();
      renderCurrentRow();
    }
  });

  // ── Submit guess ─────────────────────────────────────────────────────────
  function submitGuess() {
    if (_gameOver) return;
    if (_currentGuess.length !== _wordLength) { showMsg('Mot trop court\u00a0!', 'warn'); return; }
    fetch('/arcade/wordle/guess', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ guess: _currentGuess }),
    })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.ok) {
          if (d.error === 'wrong_length') showMsg('Longueur incorrecte.', 'warn');
          else showMsg('Erreur.', 'warn');
          return;
        }
        for (var c = 0; c < _wordLength; c++) {
          setTile(_currentRow, c, _currentGuess[c], d.feedback[c], false);
        }
        _currentRow++;
        _currentGuess = '';

        if (d.gameOver) {
          _gameOver = true;
          setTimeout(function() {
            showResult(d.solved, d.word, d.sourceTitle, d.sourceId, d.lootboxGranted, false, d.currentStreak, d.bestStreak);
            if (d.lootboxGranted > 0 && typeof window._lbRefreshCount === 'function') {
              window._lbRefreshCount();
            }
          }, _wordLength * 120 + 400);
        } else {
          if (msgEl) msgEl.textContent = '';
          renderCurrentRow();
        }
      })
      .catch(function() { showMsg('Erreur r\u00e9seau.', 'warn'); });
  }

  // ── Show message ─────────────────────────────────────────────────────────
  function showMsg(text, type) {
    if (!msgEl) return;
    msgEl.textContent = text;
    msgEl.className = 'wordle-message wordle-message--' + (type || 'info');
    setTimeout(function() { if (msgEl.textContent === text) msgEl.textContent = ''; }, 2000);
  }

  // ── Result panel ─────────────────────────────────────────────────────────
  // alreadyRewarded = true only when reloading a finished game (rewardGranted from server)
  function showResult(solved, word, sourceTitle, sourceId, lootboxGranted, alreadyRewarded, currentStreak, bestStreak) {
    if (!resultEl) return;
    resultEl.hidden = false;
    resultEl.textContent = '';
    resultEl.className = 'wordle-result ' + (solved ? 'wordle-result--win' : 'wordle-result--lose');

    if (solved) {
      var coffres = lootboxGranted > 0
        ? 'Victoire\u00a0! Vous obtenez ' + lootboxGranted + ' coffre' + (lootboxGranted > 1 ? 's' : '') + '.'
        : alreadyRewarded
          ? 'Vous avez d\u00e9j\u00e0 jou\u00e9 aujourd\u2019hui.'
          : 'Victoire\u00a0!';
      var winMsg = document.createElement('div');
      winMsg.className = 'wordle-result-reward';
      winMsg.textContent = coffres;
      resultEl.appendChild(winMsg);

      // Streak info
      if (currentStreak && currentStreak > 0) {
        var streakEl = document.createElement('div');
        streakEl.className = 'wordle-result-streak';
        var flame = currentStreak >= 3 ? ' \uD83D\uDD25' : '';
        streakEl.textContent = currentStreak + ' jour' + (currentStreak > 1 ? 's' : '') + ' de suite' + flame;
        if (bestStreak && bestStreak > currentStreak) {
          streakEl.textContent += ' \u2014 record\u00a0: ' + bestStreak;
        } else if (bestStreak && bestStreak === currentStreak && currentStreak > 1) {
          streakEl.textContent += ' \u2014 nouveau record\u00a0! \uD83C\uDFC6';
        }
        resultEl.appendChild(streakEl);
      }

      if (sourceTitle && sourceId) {
        var link = document.createElement('a');
        link.className = 'wordle-result-link';
        link.href = '/wiki/' + sourceId;
        link.textContent = 'Lire la page de ' + sourceTitle;
        resultEl.appendChild(link);
      }
    } else {
      var loseMsg = document.createElement('div');
      loseMsg.className = 'wordle-result-lose-text';
      loseMsg.textContent = 'Le mot \u00e9tait \u00ab\u00a0' + (word || '').toUpperCase() + '\u00a0\u00bb, retentez votre chance demain\u00a0!';
      resultEl.appendChild(loseMsg);
    }
  }
})();
</script>

<script>
/* ═══════════════════════════════════════════════════════════════════════════
   AVENTURE — modal simple
   ═══════════════════════════════════════════════════════════════════════════ */
(function () {
  var overlay  = document.getElementById('aventure-modal');
  var openBtn  = document.getElementById('jeu-aventure-btn');
  var closeBtn = document.getElementById('aventure-close-btn');
  if (!overlay) return;
  function open()  { overlay.hidden = false; document.body.style.overflow = 'hidden'; }
  function close() { overlay.hidden = true;  document.body.style.overflow = ''; }
  openBtn  && openBtn.addEventListener('click', open);
  closeBtn && closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !overlay.hidden) close(); });
})();
</script>

<script>
/* ═══════════════════════════════════════════════════════════════════════════
   CASINO — Machine à charmes
   ═══════════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var overlay         = document.getElementById('casino-modal');
  var closeBtn        = document.getElementById('casino-close-btn');
  var openBtn         = document.getElementById('jeu-casino-btn');
  var screenGames     = document.getElementById('casino-screen-games');
  var screenSlots     = document.getElementById('casino-screen-charm-slots');
  var slotsOpenBtn    = document.getElementById('casino-charm-slots-open');
  var slotsBackBtn    = document.getElementById('charm-slots-back');
  var slotsPlayBtn    = document.getElementById('charm-slots-play');
  var slotsCoinsEl    = document.getElementById('slots-coins');
  var slotsResultEl   = document.getElementById('slots-result');
  var slotsWinFlash   = document.getElementById('slots-win-flash');
  var reels           = [
    document.getElementById('slots-reel-0'),
    document.getElementById('slots-reel-1'),
    document.getElementById('slots-reel-2'),
  ];

  if (!overlay) return;

  var _charms      = [];
  var _coins       = parseInt((slotsCoinsEl && slotsCoinsEl.textContent) || '0', 10) || 0;
  var _spinning    = false;
  var _spinTimers  = [null, null, null];

  // ── Écrans ──────────────────────────────────────────────────────────────────
  var casinoHdrBack = document.getElementById('casino-hdr-back-btn');
  function showScreen(el) {
    [screenGames, screenSlots].forEach(function(s) { if (s) s.hidden = true; });
    if (el) el.hidden = false;
    if (casinoHdrBack) casinoHdrBack.hidden = (el === screenGames);
  }
  casinoHdrBack && casinoHdrBack.addEventListener('click', function() {
    showScreen(screenGames);
  });

  // ── Ouverture / fermeture ────────────────────────────────────────────────────
  function openCasino() {
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    showScreen(screenGames);
  }
  function closeCasino() {
    overlay.hidden = true;
    document.body.style.overflow = '';
  }

  openBtn  && openBtn.addEventListener('click', openCasino);
  closeBtn && closeBtn.addEventListener('click', closeCasino);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeCasino(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !overlay.hidden) closeCasino(); });

  // ── Chargement des charmes ───────────────────────────────────────────────────
  function loadCharms(cb) {
    if (_charms.length) { cb(); return; }
    fetch('/arcade/charm-slots/info')
      .then(function(r) { return r.json(); })
      .then(function(d) { _charms = d.charms || []; cb(); })
      .catch(function() { cb(); });
  }

  // ── Ouvrir l'écran slots ─────────────────────────────────────────────────────
  slotsOpenBtn && slotsOpenBtn.addEventListener('click', function() {
    loadCharms(function() {
      showScreen(screenSlots);
      resetReels();
      if (slotsResultEl) slotsResultEl.hidden = true;
      if (slotsWinFlash) slotsWinFlash.hidden = true;
      updateCoinsUI();
    });
  });

  slotsBackBtn && slotsBackBtn.addEventListener('click', function() {
    showScreen(screenGames);
  });

  // ── Pièces ───────────────────────────────────────────────────────────────────
  function updateCoinsUI() {
    if (slotsCoinsEl) slotsCoinsEl.textContent = _coins;
    if (slotsPlayBtn) slotsPlayBtn.disabled = _spinning || _coins < 4;
  }

  // ── Animation rouleaux ───────────────────────────────────────────────────────
  function randomSymbol() {
    if (!_charms.length) return '\u2605';
    return _charms[Math.floor(Math.random() * _charms.length)].symbol;
  }

  function resetReels() {
    reels.forEach(function(r) {
      if (r) { r.textContent = randomSymbol(); r.classList.remove('spinning', 'reel-win'); }
    });
  }

  function startReelSpin(idx) {
    clearInterval(_spinTimers[idx]);
    var r = reels[idx];
    if (r) r.classList.add('spinning');
    _spinTimers[idx] = setInterval(function() {
      if (r) r.textContent = randomSymbol();
    }, 70);
  }

  function stopReel(idx, symbol, delay) {
    return new Promise(function(resolve) {
      setTimeout(function() {
        clearInterval(_spinTimers[idx]);
        var r = reels[idx];
        if (r) { r.textContent = symbol; r.classList.remove('spinning'); }
        resolve();
      }, delay);
    });
  }

  // ── Jouer ────────────────────────────────────────────────────────────────────
  slotsPlayBtn && slotsPlayBtn.addEventListener('click', function() {
    if (_spinning || _coins < 4) return;
    _spinning = true;
    if (slotsResultEl) slotsResultEl.hidden = true;
    if (slotsWinFlash) slotsWinFlash.hidden = true;
    reels.forEach(function(r) { if (r) r.classList.remove('reel-win'); });
    updateCoinsUI();

    // Lancer l'animation de tous les rouleaux
    [0, 1, 2].forEach(startReelSpin);

    fetch('/arcade/charm-slots', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({}),
    })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.ok) {
          [0, 1, 2].forEach(function(i) { clearInterval(_spinTimers[i]); });
          _spinning = false;
          if (d.error === 'not_enough_coins') _coins = 0;
          updateCoinsUI();
          showResultMessage(false, null);
          return;
        }

        var syms = d.symbols.map(function(s) { return s.symbol; });
        // Arrêt séquentiel des rouleaux
        Promise.all([
          stopReel(0, syms[0], 700),
          stopReel(1, syms[1], 1100),
          stopReel(2, syms[2], 1500),
        ]).then(function() {
          // Attendre la fin du dernier stop
          setTimeout(function() {
            _spinning = false;
            _coins = d.newCoins;
            updateCoinsUI();
            if (d.win) {
              reels.forEach(function(r) { if (r) r.classList.add('reel-win'); });
              if (slotsWinFlash) slotsWinFlash.hidden = false;
            }
            showResultMessage(d.win, d.reward);
          }, 200);
        });
      })
      .catch(function() {
        [0, 1, 2].forEach(function(i) { clearInterval(_spinTimers[i]); });
        _spinning = false;
        updateCoinsUI();
      });
  });

  // ── Afficher le résultat ─────────────────────────────────────────────────────
  function showResultMessage(win, reward) {
    if (!slotsResultEl) return;
    slotsResultEl.hidden = false;
    slotsResultEl.className = 'slots-result ' + (win ? 'slots-result--win' : 'slots-result--lose');
    slotsResultEl.textContent = '';

    if (win && reward) {
      var icon = document.createElement('span');
      icon.className = 'slots-reward-icon';
      icon.textContent = reward.charm.symbol;

      var line1 = document.createElement('strong');
      var line2 = document.createElement('span');

      if (reward.type === 'charm') {
        line1.textContent = '\uD83C\uDF89 ' + reward.charm.label + ' d\u00e9bloqu\u00e9\u00a0!';
        slotsResultEl.appendChild(icon);
        slotsResultEl.appendChild(line1);
      } else {
        line1.textContent = '\uD83C\uDF89 D\u00e9j\u00e0 poss\u00e9d\u00e9';
        line2.textContent = '+' + reward.coins + '\u00a0pi\u00e8ces compens\u00e9es';
        slotsResultEl.appendChild(icon);
        slotsResultEl.appendChild(line1);
        slotsResultEl.appendChild(document.createElement('br'));
        slotsResultEl.appendChild(line2);
      }
    } else {
      slotsResultEl.textContent = 'Pas de chance\u2026 r\u00e9essayez\u00a0!';
    }
  }
})();
</script>
