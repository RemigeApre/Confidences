<%- include('partials/head', { title: 'Admin : IP ' + ip, extraCss: ['admin.css'] }) %>

<style>
.ipd-wrap{padding:1.25rem 1.5rem 5rem;max-width:900px;margin:0 auto}
/* ── Header ── */
.ipd-header{display:flex;align-items:center;gap:1rem;margin-bottom:1.75rem;flex-wrap:wrap}
.ipd-ip{font-family:monospace;font-size:1.3rem;font-weight:700;color:#7dd3fc}
/* ── Cards ── */
.ipd-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.85rem;margin-bottom:1.75rem}
.ipd-card{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:10px;padding:.9rem 1rem}
.ipd-card-title{font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.3);margin:0 0 .7rem}
.ipd-kv{display:flex;flex-direction:column;gap:.35rem}
.ipd-row{display:flex;align-items:baseline;gap:.5rem}
.ipd-label{font-size:.68rem;color:rgba(255,255,255,.3);white-space:nowrap;min-width:90px}
.ipd-val{font-size:.78rem;color:#e2e8f0;word-break:break-all}
.ipd-val.mono{font-family:monospace;font-size:.75rem}
.ipd-val.muted{color:rgba(255,255,255,.3);font-style:italic}
.ipd-flag-img{width:24px;height:18px;border-radius:2px;vertical-align:middle;margin-right:.4rem}
.ipd-dot-unknown{display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;vertical-align:middle;margin-right:.4rem}
/* ── Log list ── */
.ipd-section-title{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:rgba(255,255,255,.3);margin:.5rem 0 .75rem}
.ipd-empty{color:rgba(255,255,255,.3);font-size:.9rem;text-align:center;padding:3rem 0}
.ipd-list{display:flex;flex-direction:column;gap:.2rem}
.ipd-entry{display:flex;align-items:baseline;gap:.65rem;padding:.38rem .6rem;border-radius:7px;transition:background .1s}
.ipd-entry:hover{background:rgba(255,255,255,.025)}
.ipd-time{font-size:.75rem;color:rgba(255,255,255,.35);font-variant-numeric:tabular-nums;white-space:nowrap;min-width:7rem}
.ipd-path{font-size:.82rem;color:#e2e8f0;font-family:monospace}
.ipd-ref{font-size:.65rem;color:rgba(255,255,255,.25);font-family:monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:200px}
.ipd-user{font-size:.68rem;padding:.1rem .35rem;border-radius:10px;background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.2);color:#c4b5fd;margin-left:auto;white-space:nowrap}
.ipd-day{font-size:.72rem;font-weight:600;color:rgba(255,255,255,.35);text-transform:capitalize;letter-spacing:.04em;padding:.6rem .6rem .2rem;border-bottom:1px solid rgba(255,255,255,.06);margin-bottom:.2rem}
.ipd-copy-row{margin-left:auto;background:none;border:none;cursor:pointer;color:rgba(255,255,255,.2);font-size:.72rem;padding:.1rem .3rem;border-radius:4px;transition:color .1s,background .1s;flex-shrink:0}
.ipd-copy-row:hover{color:#7dd3fc;background:rgba(99,179,237,.1)}
.ipd-copy-row.copied{color:#4ade80}
.ipd-export-bar{display:flex;align-items:center;gap:.75rem;margin-top:1.5rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.07)}
.ipd-export-btn{display:inline-flex;align-items:center;gap:.4rem;font-size:.78rem;padding:.35rem .8rem;border-radius:7px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);color:rgba(255,255,255,.6);cursor:pointer;transition:background .1s,color .1s;text-decoration:none}
.ipd-export-btn:hover{background:rgba(255,255,255,.09);color:#e2e8f0}
/* ── Appareils ── */
.ipd-devices{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.75rem}
.ipd-device{display:flex;align-items:center;gap:.75rem;padding:.55rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.025)}
.ipd-device-key{font-family:monospace;font-size:.72rem;color:rgba(255,255,255,.35);flex-shrink:0}
.ipd-device-ua{font-size:.72rem;color:rgba(255,255,255,.55);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ipd-device-hits{font-size:.68rem;color:rgba(255,255,255,.3);white-space:nowrap}
.ipd-device-note-btn{font-size:.68rem;padding:.15rem .45rem;border-radius:5px;border:1px solid rgba(255,255,255,.1);background:none;color:rgba(255,255,255,.35);cursor:pointer;transition:color .1s,border-color .1s;white-space:nowrap}
.ipd-device-note-btn:hover{color:#c4b5fd;border-color:rgba(167,139,250,.3)}
/* ── Notes ── */
.ipd-notes{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.75rem}
.ipd-note{display:flex;align-items:flex-start;gap:.6rem;padding:.55rem .8rem;border-radius:8px;background:rgba(167,139,250,.06);border:1px solid rgba(167,139,250,.15)}
.ipd-note-device{font-family:monospace;font-size:.65rem;color:rgba(167,139,250,.5);white-space:nowrap}
.ipd-note-text{font-size:.8rem;color:#e2e8f0;flex:1;white-space:pre-wrap;word-break:break-word}
.ipd-note-time{font-size:.65rem;color:rgba(255,255,255,.25);white-space:nowrap}
.ipd-note-del{background:none;border:none;cursor:pointer;color:rgba(255,255,255,.2);font-size:.8rem;padding:0 .25rem;transition:color .1s}
.ipd-note-del:hover{color:#fca5a5}
.ipd-note-form{display:flex;flex-direction:column;gap:.5rem;padding:.75rem .85rem;border-radius:8px;border:1px dashed rgba(255,255,255,.1);background:rgba(255,255,255,.02)}
.ipd-note-textarea{width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:6px;color:#e2e8f0;font-size:.8rem;padding:.45rem .6rem;resize:vertical;min-height:60px;font-family:inherit}
.ipd-note-textarea:focus{outline:none;border-color:rgba(167,139,250,.4)}
.ipd-note-submit{align-self:flex-end;font-size:.75rem;padding:.3rem .8rem;border-radius:6px;border:1px solid rgba(167,139,250,.3);background:rgba(167,139,250,.1);color:#c4b5fd;cursor:pointer;transition:background .1s}
.ipd-note-submit:hover{background:rgba(167,139,250,.2)}
.ipd-copy-profile{font-size:.75rem;padding:.3rem .75rem;border-radius:7px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);color:rgba(255,255,255,.5);cursor:pointer;transition:background .1s,color .1s;margin-left:auto}
.ipd-copy-profile:hover{background:rgba(255,255,255,.09);color:#e2e8f0}
.ipd-copy-profile.copied{border-color:rgba(74,222,128,.3);color:#4ade80}
</style>

<div class="admin-topbar">
  <a href="/ponhgup/ip-logs" class="admin-topbar-back">&#8592; IP Logs</a>
  <span class="admin-topbar-title"><%= config.title %></span>
</div>

<%
  // Agréger les données de la première entrée pour les champs fixes
  var _first = detail[0] || {};
  var _lang  = (_first.accept_language || '').split(',')[0].split(';')[0].trim();
  var _secUA = _first.sec_ch_ua || '';
  var _secPlatform = (_first.sec_ch_ua_platform || '').replace(/^"|"$/g, '');
  // Referer le plus fréquent
  var _refCounts = {};
  detail.forEach(function(r) { if (r.referer) _refCounts[r.referer] = (_refCounts[r.referer] || 0) + 1; });
  var _topRef = Object.keys(_refCounts).sort(function(a,b){ return _refCounts[b]-_refCounts[a]; })[0] || '';
  var _topRefLabel = '';
  if (_topRef) {
    try { _topRefLabel = new URL(_topRef).hostname.replace(/^www\./, ''); } catch(e) { _topRefLabel = _topRef.slice(0,40); }
  }
%>

<div class="ipd-wrap">
  <div class="ipd-header">
    <span class="ipd-ip"><%= ip %></span>
    <span id="ipd-geo-summary" style="font-size:.85rem;color:rgba(255,255,255,.4)">…</span>
    <button class="ipd-copy-profile" id="ipd-copy-profile">&#10697; Copier le profil</button>
  </div>

  <div class="ipd-cards">

    <!-- Géolocalisation -->
    <div class="ipd-card">
      <p class="ipd-card-title">Localisation</p>
      <div class="ipd-kv" id="ipd-geo-card">
        <div class="ipd-row"><span class="ipd-label">Pays</span><span class="ipd-val" id="ipd-country">…</span></div>
        <div class="ipd-row"><span class="ipd-label">R&eacute;gion</span><span class="ipd-val" id="ipd-region">…</span></div>
        <div class="ipd-row"><span class="ipd-label">Ville</span><span class="ipd-val" id="ipd-city">…</span></div>
        <div class="ipd-row"><span class="ipd-label">Fuseau</span><span class="ipd-val" id="ipd-tz">…</span></div>
        <div class="ipd-row"><span class="ipd-label">Coordonn&eacute;es</span><span class="ipd-val mono" id="ipd-coords">…</span></div>
        <div class="ipd-row"><span class="ipd-label">Plage IP</span><span class="ipd-val mono" id="ipd-range" style="font-size:.68rem">…</span></div>
      </div>
    </div>

    <!-- Navigateur -->
    <div class="ipd-card">
      <p class="ipd-card-title">Navigateur / Syst&egrave;me</p>
      <div class="ipd-kv">
        <div class="ipd-row"><span class="ipd-label">User-Agent</span><span class="ipd-val mono" style="font-size:.65rem;color:rgba(255,255,255,.55)"><%= _first.user_agent || '' %></span></div>
        <% if (_secUA) { %>
        <div class="ipd-row"><span class="ipd-label">Navigateur</span><span class="ipd-val"><%= _secUA %></span></div>
        <% } %>
        <% if (_secPlatform) { %>
        <div class="ipd-row"><span class="ipd-label">OS</span><span class="ipd-val"><%= _secPlatform %></span></div>
        <% } %>
        <% if (_lang) { %>
        <div class="ipd-row"><span class="ipd-label">Langue</span><span class="ipd-val"><%= _lang %></span></div>
        <% } %>
      </div>
    </div>

    <!-- Origine -->
    <div class="ipd-card">
      <p class="ipd-card-title">Origine / Trafic</p>
      <div class="ipd-kv">
        <div class="ipd-row">
          <span class="ipd-label">Source</span>
          <% if (_topRefLabel) { %>
            <span class="ipd-val"><%= _topRefLabel %></span>
          <% } else { %>
            <span class="ipd-val muted">Accès direct</span>
          <% } %>
        </div>
        <% if (_topRef) { %>
        <div class="ipd-row"><span class="ipd-label">URL</span><span class="ipd-val mono" style="font-size:.65rem;color:rgba(255,255,255,.4)"><%= _topRef.slice(0, 80) %></span></div>
        <% } %>
        <div class="ipd-row"><span class="ipd-label">Pages visit&eacute;es</span><span class="ipd-val"><%= detail.length %></span></div>
        <div class="ipd-row">
          <span class="ipd-label">Profil</span>
          <% if (_first.user_id) { %>
            <span class="ipd-val" style="color:#c4b5fd">Connect&eacute; #<%= _first.user_id %></span>
          <% } else { %>
            <span class="ipd-val muted">Anonyme</span>
          <% } %>
        </div>
      </div>
    </div>

  </div>

  <!-- Appareils détectés -->
  <% if (devices && devices.length > 1) { %>
  <p class="ipd-section-title"><%= devices.length %> appareil<%= devices.length > 1 ? 's' : '' %> distincts sur cette IP</p>
  <div class="ipd-devices">
    <% devices.forEach(function(dev) { %>
    <div class="ipd-device">
      <span class="ipd-device-key">#<%= dev.device_key %></span>
      <span class="ipd-device-ua" title="<%= dev.user_agent %>"><%= dev.user_agent %></span>
      <span class="ipd-device-hits"><%= dev.hits %> requ&ecirc;tes</span>
      <button class="ipd-device-note-btn" data-dk="<%= dev.device_key %>">+ Note</button>
    </div>
    <% }) %>
  </div>
  <% } %>

  <!-- Notes -->
  <p class="ipd-section-title">Notes</p>
  <% if (notes && notes.length) { %>
  <div class="ipd-notes">
    <% notes.forEach(function(n) { %>
    <div class="ipd-note">
      <% if (n.device_key) { %><span class="ipd-note-device">#<%= n.device_key %></span><% } %>
      <span class="ipd-note-text"><%= n.note %></span>
      <span class="ipd-note-time"><%= new Date(n.created_at).toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit', year:'2-digit' }) %></span>
      <form method="POST" action="/ponhgup/ip-logs/<%= encodeURIComponent(ip) %>/notes/<%= n.id %>/delete" style="margin:0">
        <button type="submit" class="ipd-note-del" title="Supprimer">&#10005;</button>
      </form>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <p style="font-size:.78rem;color:rgba(255,255,255,.25);margin-bottom:1rem">Aucune note.</p>
  <% } %>

  <form method="POST" action="/ponhgup/ip-logs/<%= encodeURIComponent(ip) %>/notes" class="ipd-note-form" id="ipd-note-form">
    <textarea class="ipd-note-textarea" name="note" placeholder="Ajouter une note sur cette IP…" rows="2"></textarea>
    <input type="hidden" name="device_key" id="ipd-note-dk" value="">
    <button type="submit" class="ipd-note-submit">Enregistrer</button>
  </form>

  <!-- Historique de navigation -->
  <p class="ipd-section-title" style="margin-top:1.5rem">Historique de navigation</p>

  <% if (!detail.length) { %>
    <p class="ipd-empty">Aucun log pour cette IP.</p>
  <% } else { %>
    <%
      var _days2 = [], _dkeys2 = {};
      detail.forEach(function(r) {
        var d = new Date(r.created_at);
        var key = d.getFullYear() + '-' + d.getMonth() + '-' + d.getDate();
        if (!_dkeys2[key]) {
          _dkeys2[key] = { label: d.toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long' }), rows: [] };
          _days2.push(_dkeys2[key]);
        }
        _dkeys2[key].rows.push(r);
      });
    %>
    <div class="ipd-list">
      <% _days2.forEach(function(day) { %>
        <div class="ipd-day"><%= day.label %></div>
        <% day.rows.forEach(function(r) {
          var _rRef = r.referer || '';
          var _rRefLabel = '';
          if (_rRef) { try { _rRefLabel = new URL(_rRef).hostname.replace(/^www\./, ''); } catch(e) { _rRefLabel = _rRef.slice(0,30); } }
        %>
          <div class="ipd-entry"
            data-log-time="<%= r.created_at %>"
            data-log-path="<%= r.path %>"
            data-log-ref="<%= r.referer || '' %>"
            data-log-ua="<%= (r.user_agent || '').replace(/"/g, '&quot;') %>"
            data-log-user="<%= r.user_id || '' %>">
            <span class="ipd-time"><%= new Date(r.created_at).toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit', second:'2-digit' }) %></span>
            <% if (devices && devices.length > 1 && r.device_key) { %><span style="font-family:monospace;font-size:.62rem;color:rgba(255,255,255,.2);flex-shrink:0">#<%= r.device_key %></span><% } %>
            <span class="ipd-path"><%= r.path %></span>
            <% if (_rRefLabel) { %><span class="ipd-ref" title="<%= _rRef %>">&larr; <%= _rRefLabel %></span><% } %>
            <% if (r.user_id) { %><span class="ipd-user">Connect&eacute; #<%= r.user_id %></span><% } %>
            <button class="ipd-copy-row" title="Copier cette ligne">&#10697;</button>
          </div>
        <% }) %>
      <% }) %>
    </div>

    <div class="ipd-export-bar">
      <button class="ipd-export-btn" id="ipd-export-csv">&#8595; CSV</button>
      <button class="ipd-export-btn" id="ipd-export-json">&#8595; JSON</button>
      <button class="ipd-export-btn" id="ipd-export-txt">&#8595; Texte brut</button>
    </div>
  <% } %>
</div>

<script nonce="<%= nonce %>">
(function() {
  var ip = '<%- JSON.stringify(ip) %>';
  try { ip = JSON.parse(ip); } catch(_) {}

  var _dispNames = null;
  try { _dispNames = new Intl.DisplayNames(['fr'], { type: 'region' }); } catch(_) {}
  function countryName(code) {
    if (!code) return '';
    try { return _dispNames ? _dispNames.of(code.toUpperCase()) : code.toUpperCase(); } catch(_) { return code.toUpperCase(); }
  }

  fetch('/ponhgup/ip-geo?ip=' + encodeURIComponent(ip))
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var code = (d.countryCode || '').toUpperCase();
      var name = countryName(code);
      _geoData = Object.assign({}, d, { country: name });

      // Résumé header
      var summary = document.getElementById('ipd-geo-summary');
      if (summary) {
        if (d.unknown) {
          summary.textContent = 'Localisation inconnue';
        } else {
          var img = document.createElement('img');
          img.src = 'https://flagcdn.com/24x18/' + (d.countryCode || '') + '.png';
          img.width = 24; img.height = 18; img.alt = code;
          img.className = 'ipd-flag-img';
          while (summary.firstChild) summary.removeChild(summary.firstChild);
          summary.appendChild(img);
          summary.appendChild(document.createTextNode([name, d.region, d.city].filter(Boolean).join(' · ')));
        }
      }

      // Carte géo
      function set(id, val) {
        var el = document.getElementById(id);
        if (!el) return;
        if (val) { el.textContent = val; el.classList.remove('muted'); }
        else { el.textContent = '—'; el.classList.add('muted'); }
      }

      if (d.unknown) {
        ['ipd-country','ipd-region','ipd-city','ipd-tz','ipd-coords','ipd-range'].forEach(function(id) { set(id, ''); });
      } else {
        set('ipd-country',  name ? (name + (code ? ' (' + code + ')' : '')) : '');
        set('ipd-region',   d.region);
        set('ipd-city',     d.city);
        set('ipd-tz',       d.timezone);
        set('ipd-coords',   d.lat != null ? d.lat + ', ' + d.lon : '');
        set('ipd-range',    d.range);
      }
    })
    .catch(function() {
      var s = document.getElementById('ipd-geo-summary');
      if (s) s.textContent = 'Localisation indisponible';
    });
})();
</script>

<script nonce="<%= nonce %>">
(function() {
  var IP = <%- JSON.stringify(ip) %>;

  // ── Données statiques (côté serveur) pour la copie profil ────────────────
  var _profileData = {
    ip:          IP,
    ua:          <%- JSON.stringify((_first.user_agent || '')) %>,
    secChUa:     <%- JSON.stringify((_first.sec_ch_ua || '')) %>,
    secPlatform: <%- JSON.stringify(((_first.sec_ch_ua_platform || '').replace(/^"|"$/g, ''))) %>,
    lang:        <%- JSON.stringify(_lang) %>,
    topRef:      <%- JSON.stringify(_topRefLabel) %>,
    topRefUrl:   <%- JSON.stringify(_topRef) %>,
    pageCount:   <%= detail.length %>,
    userId:      <%- JSON.stringify(String(_first.user_id || '')) %>,
    devices: <%- JSON.stringify((devices || []).map(function(d) { return { key: d.device_key, ua: d.user_agent, hits: d.hits }; })) %>,
    notes:   <%- JSON.stringify((notes || []).map(function(n) { return { dk: n.device_key, text: n.note, at: n.created_at }; })) %>,
  };
  var _geoData = {}; // rempli par le fetch

  function buildProfileText() {
    var g = _geoData;
    var d = _profileData;
    var lines = [];

    lines.push('═══ Profil IP : ' + d.ip + ' ═══');
    lines.push('');

    lines.push('── Localisation');
    if (g.unknown) {
      lines.push('  Inconnue');
    } else {
      if (g.country) lines.push('  Pays     : ' + g.country + (g.countryCodeUpper ? ' (' + g.countryCodeUpper + ')' : ''));
      if (g.region)  lines.push('  Région   : ' + g.region);
      if (g.city)    lines.push('  Ville    : ' + g.city);
      if (g.timezone)lines.push('  Fuseau   : ' + g.timezone);
      if (g.lat != null) lines.push('  Coords   : ' + g.lat + ', ' + g.lon);
      if (g.range)   lines.push('  Plage IP : ' + g.range);
    }
    lines.push('');

    lines.push('── Navigateur / Système');
    if (d.secChUa)     lines.push('  Navigateur : ' + d.secChUa);
    if (d.secPlatform) lines.push('  OS         : ' + d.secPlatform);
    if (d.lang)        lines.push('  Langue     : ' + d.lang);
    if (d.ua)          lines.push('  User-Agent : ' + d.ua);
    lines.push('');

    lines.push('── Origine / Trafic');
    lines.push('  Source        : ' + (d.topRef || 'Accès direct'));
    if (d.topRefUrl)   lines.push('  URL origine   : ' + d.topRefUrl);
    lines.push('  Pages visitées: ' + d.pageCount);
    lines.push('  Profil        : ' + (d.userId ? 'Connecté #' + d.userId : 'Anonyme'));
    lines.push('');

    if (d.devices.length > 1) {
      lines.push('── Appareils distincts (' + d.devices.length + ')');
      d.devices.forEach(function(dev) {
        lines.push('  #' + dev.key + '  ' + dev.ua + '  (' + dev.hits + ' req.)');
      });
      lines.push('');
    }

    if (d.notes.length) {
      lines.push('── Notes');
      d.notes.forEach(function(n) {
        var prefix = n.dk ? '[#' + n.dk + '] ' : '';
        lines.push('  ' + prefix + n.text);
      });
      lines.push('');
    }

    lines.push('Exporté le ' + new Date().toLocaleString('fr-FR'));
    return lines.join('\n');
  }

  var _copyBtn = document.getElementById('ipd-copy-profile');
  if (_copyBtn) {
    _copyBtn.addEventListener('click', function() {
      navigator.clipboard.writeText(buildProfileText()).then(function() {
        _copyBtn.textContent = '✓ Copié';
        _copyBtn.classList.add('copied');
        setTimeout(function() {
          _copyBtn.textContent = '⎘ Copier le profil';
          _copyBtn.classList.remove('copied');
        }, 2000);
      });
    });
  }

  // ── Boutons "Note" sur appareil ─────────────────────────────────────────
  var _noteForm = document.getElementById('ipd-note-form');
  var _noteDk   = document.getElementById('ipd-note-dk');
  document.querySelectorAll('.ipd-device-note-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var dk = btn.dataset.dk || '';
      if (_noteDk) _noteDk.value = dk;
      if (_noteForm) {
        _noteForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
        var ta = _noteForm.querySelector('textarea');
        if (ta) { ta.placeholder = 'Note pour appareil #' + dk + '…'; ta.focus(); }
      }
    });
  });

  // ── Copie d'une ligne ─────────────────────────────────────────────────────
  function entryToText(el) {
    var t   = el.dataset.logTime  || '';
    var p   = el.dataset.logPath  || '';
    var ref = el.dataset.logRef   || '';
    var ua  = el.dataset.logUa    || '';
    var usr = el.dataset.logUser  || '';
    var parts = [t, IP, p];
    if (ref) parts.push('← ' + ref);
    if (usr) parts.push('user#' + usr);
    if (ua)  parts.push('[' + ua + ']');
    return parts.join('  ');
  }

  document.querySelectorAll('.ipd-copy-row').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var entry = btn.closest('.ipd-entry');
      if (!entry) return;
      navigator.clipboard.writeText(entryToText(entry)).then(function() {
        btn.textContent = '✓';
        btn.classList.add('copied');
        setTimeout(function() { btn.textContent = '⎘'; btn.classList.remove('copied'); }, 1500);
      });
    });
  });

  // ── Export ────────────────────────────────────────────────────────────────
  function collectEntries() {
    return Array.from(document.querySelectorAll('.ipd-entry[data-log-time]')).map(function(el) {
      return {
        time:    el.dataset.logTime,
        ip:      IP,
        path:    el.dataset.logPath,
        referer: el.dataset.logRef,
        user_id: el.dataset.logUser || null,
        ua:      el.dataset.logUa,
      };
    });
  }

  function download(filename, content, mime) {
    var blob = new Blob([content], { type: mime });
    var url  = URL.createObjectURL(blob);
    var a    = document.createElement('a');
    a.href     = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  var slug = IP.replace(/[^a-z0-9]/gi, '-');

  var btnCsv = document.getElementById('ipd-export-csv');
  if (btnCsv) btnCsv.addEventListener('click', function() {
    var rows = collectEntries();
    var header = 'time,ip,path,referer,user_id,user_agent\n';
    var lines  = rows.map(function(r) {
      return [r.time, r.ip, r.path, r.referer, r.user_id || '', r.ua]
        .map(function(v) { return '"' + String(v || '').replace(/"/g, '""') + '"'; })
        .join(',');
    });
    download('ip-logs-' + slug + '.csv', header + lines.join('\n'), 'text/csv;charset=utf-8');
  });

  var btnJson = document.getElementById('ipd-export-json');
  if (btnJson) btnJson.addEventListener('click', function() {
    download('ip-logs-' + slug + '.json', JSON.stringify(collectEntries(), null, 2), 'application/json');
  });

  var btnTxt = document.getElementById('ipd-export-txt');
  if (btnTxt) btnTxt.addEventListener('click', function() {
    var lines = Array.from(document.querySelectorAll('.ipd-entry[data-log-time]')).map(entryToText);
    download('ip-logs-' + slug + '.txt', lines.join('\n'), 'text/plain;charset=utf-8');
  });
})();
</script>

