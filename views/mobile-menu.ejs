<%- include('partials/head', { title: 'Menu' }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>

  <div class="mobile-menu-page">

    <% if (currentUser) { %>

      <%# ── Bloc identité ── %>
      <div class="mm-identity">
        <div class="mm-identity-avatar"><%- include('partials/profile-avatar') %></div>
        <div class="mm-identity-info">
          <span class="mm-identity-name"><%= currentUser.displayName %></span>
          <a href="/favoris" class="mm-identity-link">Voir mon profil →</a>
        </div>
      </div>

      <%# ── Navigation principale ── %>
      <nav class="mm-nav" aria-label="Menu principal">

        <a href="/bd" class="mm-item mm-item--bd">
          <span class="mm-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22V12h6v10"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/></svg>
          </span>
          <span class="mm-item-label">BD</span>
          <svg class="mm-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <% if (currentUser.isAdmin) { %>
          <a href="/nouvelles" class="mm-item mm-item--histoire">
            <span class="mm-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </span>
            <span class="mm-item-label">Histoire</span>
            <svg class="mm-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        <% } %>

        <%# Tags : groupe avec 3 sous-liens %>
        <div class="mm-group">
          <div class="mm-group-header mm-item--tags">
            <span class="mm-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            </span>
            <span class="mm-item-label">Tags</span>
          </div>
          <div class="mm-group-body">
            <a href="/tags" class="mm-subitem mm-subitem--labels">
              <span class="mm-subitem-dot"></span>Labels
            </a>
            <a href="/parodies" class="mm-subitem mm-subitem--parodies">
              <span class="mm-subitem-dot"></span>Parodies
            </a>
            <a href="/protagonistes" class="mm-subitem mm-subitem--prot">
              <span class="mm-subitem-dot"></span>Personnages
            </a>
          </div>
        </div>

        <% if (locals.partnerUser) { %>
          <a href="/couple" class="mm-item mm-item--couple">
            <span class="mm-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </span>
            <span class="mm-item-label">Profil de <%= partnerUser.displayName %></span>
            <svg class="mm-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        <% } %>

        <a href="/liens" class="mm-item mm-item--liens">
          <span class="mm-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </span>
          <span class="mm-item-label">Liens</span>
          <svg class="mm-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <% if (currentUser.isAdmin) { %>
          <a href="/admin" class="mm-item mm-item--admin">
            <span class="mm-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </span>
            <span class="mm-item-label">Administration</span>
            <svg class="mm-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        <% } %>

      </nav>

      <%# ── Déconnexion ── %>
      <form method="POST" action="/admin/logout" class="mm-logout-form">
        <button type="submit" class="mm-item mm-item--logout">
          <span class="mm-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </span>
          <span class="mm-item-label">D&eacute;connexion</span>
        </button>
      </form>

    <% } else { %>
      <div class="mm-identity mm-identity--guest">
        <p class="mm-guest-text">Connecte-toi pour acc&eacute;der au contenu.</p>
        <a href="/admin/login?next=/mobile-menu" class="mm-item mm-item--admin">
          <%- include('partials/key-icon') %>
          <span class="mm-item-label">Se connecter</span>
        </a>
      </div>
    <% } %>

  </div>

</main>
<%- include('partials/foot') %>
