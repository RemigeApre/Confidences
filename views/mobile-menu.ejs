<%- include('partials/head', { title: 'Menu' }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>

  <div class="mobile-menu-page">

    <% if (currentUser) { %>

      <a href="/bd" class="mobile-menu-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22V12h6v10"/><path d="M8 7h.01M12 7h.01M16 7h.01"/></svg>
        BD
      </a>

      <% if (currentUser.isAdmin) { %>
        <a href="/nouvelles" class="mobile-menu-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          Histoire
        </a>
      <% } %>

      <details class="mobile-menu-details">
        <summary class="mobile-menu-item mobile-menu-item--summary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          Tags
          <svg class="mobile-menu-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="mobile-menu-sub">
          <a href="/tags" class="mobile-menu-subitem">Labels</a>
          <a href="/parodies" class="mobile-menu-subitem">Parodies</a>
          <a href="/protagonistes" class="mobile-menu-subitem">Personnages</a>
        </div>
      </details>

      <% if (locals.partnerUser) { %>
        <a href="/couple" class="mobile-menu-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          Profil de <%= partnerUser.displayName %>
        </a>
      <% } %>

      <a href="/liens" class="mobile-menu-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        Liens
      </a>

      <% if (currentUser.isAdmin) { %>
        <a href="/admin" class="mobile-menu-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Admin
        </a>
      <% } %>

      <div class="mobile-menu-sep"></div>

      <form method="POST" action="/admin/logout">
        <button type="submit" class="mobile-menu-item mobile-menu-item--danger">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          D&eacute;connexion
        </button>
      </form>

    <% } else { %>
      <a href="/admin/login?next=/mobile-menu" class="mobile-menu-item">
        <%- include('partials/key-icon') %>
        Se connecter
      </a>
    <% } %>

  </div>

</main>
<%- include('partials/foot') %>
